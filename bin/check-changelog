#!/usr/bin/env ruby
# frozen_string_literal: true

# check-changelog -- structural gate on every changelog this repository tracks
# (T-115; the class it prevents is K-1015).
#
# WHY THIS EXISTS, and why the reason is stronger than the row that asked for it.
# A Keep-a-Changelog file has ONE subsection per kind per release: everything
# added since the last release goes under one `### Added`, everything fixed
# under one `### Fixed`. That is not decoration -- it is the only thing that
# makes the file readable as an answer to "what changed", because a reader who
# has found `### Fixed` stops looking. K-1015 found `kiosk-server/CHANGELOG.md`
# carrying SEVEN subsection headings for four kinds and merged them, and merged
# the one sibling that shared the shape.
#
# It came back in three days. MEASURED at head while this script was being
# written: `kiosk-redteam/CHANGELOG.md` carried `### Added` at line 7 AND at
# line 36 inside a single `## [Unreleased]`, because two later waves each opened
# a fresh `### Added` at the top of the file rather than appending to the one
# already there. Neither wave was careless in any way a reviewer could see -- a
# new heading at the top of a changelog looks exactly like the correct edit --
# and nothing anywhere asked the question. That is the whole argument for a
# gate rather than another repair wave, and the repair the gate demanded is in
# the same commit that introduced it.
#
# WHERE A CHANGELOG LINE GOES, which had to be settled before this script could
# enumerate anything (K-1159). Two of the eight demos ship a CHANGELOG.md and
# six do not, so "one line in the touched repository's CHANGELOG.md" resolved to
# a different file depending on which demo was edited, and nothing recorded
# which was intended. It is settled here, in the direction the evidence points:
#
#   * The REPOSITORY record is `CHANGELOG.md` at the root. A demo is a DIRECTORY
#     in this repository, not a repository and not a package, so a significant
#     change anywhere -- engine, gem, demo, deploy runbook -- gets its line
#     here. This is the target of the one-line rule, always.
#   * A GEM record is `<gem>/CHANGELOG.md`, and it is REQUIRED of every gem,
#     because it is not a courtesy: all fourteen gemspecs list `CHANGELOG.md` in
#     `spec.files` and set `metadata["changelog_uri"]` to it, so that file is
#     inside the published package and is what a reader who installed the gem
#     and never saw this repository has. A package with its own version needs
#     its own release record.
#   * A DEMO record is OPTIONAL and is declared. Two exist; they are kept
#     because this project does not rewrite published history, and they are
#     declared below with the reason, so a third cannot appear -- and neither of
#     the two can vanish -- without someone saying why.
#
# The three roles are DERIVED from the tree at run time, not listed: root, or a
# directory that ships a gemspec, or an entry in the manifest below. So the next
# gem does not have to be remembered, and a changelog that fits none of the
# three is a failure rather than a shrug.
#
# WHAT IT CHECKS. The arms enumerated below, over `git ls-files` in the
# repository this script lives in -- what ships is what git carries. STRUCTURE
# ONLY. Entry text, entry ordering, the order the kinds appear in, and the old
# ordinals inside entries are all deliberately out of scope: this repository
# keeps changelog entries' original numbers on purpose (K-646), and a gate that
# reflows prose would fight that decision.
#
#   CL-1  At most one subsection heading of each Keep-a-Changelog kind
#         (Added/Changed/Deprecated/Removed/Fixed/Security) per release section.
#   CL-2  At most one subsection heading of ANY other name per release section.
#         Same defect, one level out: `### Out of scope for first release` twice
#         splits a reader's answer exactly as `### Added` twice does.
#   CL-3  At most one release section of a given name per file.
#   CL-4  No subsection heading outside a release section. This one also keeps
#         the PARSER honest: a `###` with no `##` above it would otherwise be
#         silently ungrouped, and a heading nothing groups is a heading nothing
#         compares.
#   CL-5  Every tracked changelog is the repository record, a gem package
#         record, or a declared courtesy record.
#   CL-6  Every directory that ships a gemspec has a changelog, because that
#         file is inside the package it publishes.
#   CL-7  Every top-level entry of the REPOSITORY record opens with its ISO
#         date. This is the one arm that reads an entry, and it reads exactly
#         one thing about it: whether it says WHEN. Two entries had quietly
#         lost theirs among 459 that had one (K-1330). It is scoped to that
#         file on purpose: a gem record dates its RELEASE heading instead, and
#         the same rule on every bullet there would be wrong.
#         THE REPOSITORY RECORD IS NO LONGER A FLAT JOURNAL and this arm is
#         unchanged by that (T-223): its entries are grouped by the release
#         that carries them, and the two facts are different questions -- the
#         section says WHICH VERSION has a change, the date says WHEN it
#         landed and still orders the entries inside the section.
#
#   CL-11 A level-2 heading that is none of the three shapes a record may
#         carry: `[Unreleased]`, a version section `[MAJOR.MINOR.PATCH] --
#         YYYY-MM-DD`, or the one declared pre-grouping heading. A section
#         named for a MAJOR.MINOR alone, or carrying no date, is the whole
#         reason this arm exists: dates alone cannot answer "which version has
#         this change", and a two-number heading cannot either, because a
#         PATCH cut is a release here and has to be as visible as a MINOR one.
#   CL-12 A record with no `[Unreleased]` section, or with one that is not its
#         FIRST section. That section is where the next entry goes, and a
#         record that lacks it has no answer to "where do I write this" --
#         which is exactly how K-1015 grew a second `### Added` at the top of
#         a file that already had one.
#   CL-13 A top-level entry ABOVE the first section. Nothing groups it, so it
#         names no release; this is CL-4's defect one level out.
#
#   CL-8  A NEW entry is under 200 characters.
#   CL-9  A NEW entry runs to at most two sentences.
#   CL-10 A NEW entry does not revive a claim this repository has RETIRED.
#         The retired claims are declared in the RETIRED table below, each with
#         the ledger row that retired it, what is true instead, and the marker
#         an entry uses to name the claim in order to supersede it.
#
# THE RULE CL-8 AND CL-9 HOLD, in Phil's own words (2026-09-11), and it binds
# every `CHANGELOG.md` in this workspace -- root record and per-gem package
# record alike, no two-tier distinction:
#
#   "Keep the entries short, always under 200 characters and one-two sentences.
#    Only keep the essence of the change. git commit messages will keep the
#    details. In the CHANGELOG, only keep the essence."
#
# WHY THEY ARE SCOPED TO WHAT IS NEW, and it is the K-1097 property rather than
# a softening. The standing corpus is long and it is APPEND-ONLY: nothing
# already written may be edited, so a length gate over the whole file would be
# red on arrival and permanently unfixable, which is a gate someone switches
# off. So the two arms read only entries that are NEW against `BASELINE_REV`
# below -- the commit at which the rule took effect -- and everything at or
# before it is printed as a CENSUS that never reddens. The census is derived on
# every run, never typed here, so it cannot go stale.
#
# WHAT "NEW" MEANS, exactly. The baseline entry set is the UNION of the
# normalised text of every top-level entry in every `CHANGELOG.md` this
# repository tracked AT `BASELINE_REV`. A working-tree entry whose normalised
# text is not in that union is new. The union is taken across files rather than
# per file on purpose: moving an entry between changelogs, or renaming a gem
# directory, must not read as five hundred new entries. EDITING an existing
# entry DOES read as new, and that is intended -- a changelog is append-only,
# so an edit to a long historical entry is exactly the thing worth asking about.
#
# An entry is a TOP-LEVEL `- ` bullet, running from that bullet to the line
# before the next top-level bullet or the next ATX heading, with the leading
# `- ` dropped, wrapped lines joined by a single space and the ends stripped.
# That is the unit the umbrella constitution names.
#
# CL-10 RIDES THAT SAME BASELINE, and that is the whole reason it is here rather
# than in the spec file that owns the claim (K-1671). K-888 retired a sentence
# about `USER_CODE_ALPHABET` and pinned an anti-regrowth sweep in
# `kiosk-server/spec/kiosk/server/device_authorization_spec.rb`; that sweep globs
# `{lib,app}`, so it cannot see the `CHANGELOG.md` beside them -- the one file of
# that gem `spec.files` PACKAGES and an adopter installs. A verify wave measured
# it rather than reasoning about it: the retired sentence written back into a
# fresh Unreleased entry left the sweep at 48 examples 0 failures and all 27
# `bin/check-*` guards at exit 0. The sweep DECLINED to widen, and its stated
# reason -- an append-only file would redden on frozen history for ever -- is
# true of a WHOLE-FILE scan and only of that. The baseline tier is the shape
# that is not: it reads what is new and counts the rest.
#
# IF THE BASELINE COMMIT IS NOT IN THE CLONE the run FAILS and says so, naming
# the remedy. It does not skip: a skipped arm exits 0 and reads exactly like a
# clean tree, which is the failure this workspace distrusts most. CI checks out
# with `fetch-depth: 0` for that reason.
#
# WHAT IT CANNOT SEE, stated because an over-claimed gate is worse than none.
# Apart from the date, the length and the sentence count, it does not read an
# entry: an entry filed under the wrong kind, an entry that describes the
# change's content rather than its intent, a change that got no entry at all,
# and a duplicate entry under one correct heading are all invisible here. The
# sentence counter is a scan, not a parser -- it drops code spans, emphasis
# markers and dotted numbers first, and skips a period after a known
# abbreviation or a single-letter initial, but a sentence ending in some other
# dotted token will be miscounted. Two release sections whose names merely
# DIFFER (`## [0.2.0]` and `## [0.2]`) are two sections to this script, not a
# repeat. Headings inside fenced code blocks are skipped, and the fence tracker
# is a line scan: an unbalanced fence in a changelog will hide the headings
# after it. CL-10 knows only the claims the RETIRED table declares -- it cannot
# tell that a sentence has become false, only that a sentence somebody already
# retired has come back -- and its `correcting` marker is an OPT-OUT a writer
# can type: an entry carrying that marker is exempt whatever else it says.
# CL-11/CL-12/CL-13 are STRUCTURE too: they hold the shape of a section
# heading and where an entry sits, and they read neither the version nor the
# tree. That a section names a version this repository actually carries is
# `bin/check-version-parity`'s question, not this one, and an entry filed
# under the wrong release is invisible here.
#
# THE TWIN. `kiosk.tech/bin/check-changelog` holds CL-7/CL-8/CL-9 and
# CL-11/CL-12/CL-13 over that repository's single changelog. It is a different
# script with a different scope -- there are no packages there, and a release
# is a published skill cut rather than a tree event -- but the RULES the two
# share must not drift, so the blocks between the SHARED NEW-ENTRY RULE and
# SHARED RELEASE-SECTION RULE markers below are byte-identical in both, and the
# sibling script compares itself against this copy whenever `../reference` is
# beside it. CL-7/CL-8/CL-9 and CL-11/CL-12/CL-13 mean the same thing in both
# scripts; CL-10 does NOT -- here it is the RETIRED-claim arm, there it is the
# shared-block drift arm.
#
# USAGE
#   bin/check-changelog                 # check this repository, exit 0/1
#   bin/check-changelog --baseline REV  # treat REV as the rule's start instead
#   bin/check-changelog --self-test     # prove it is red on a plant of every arm
#
# Stdlib only: no bundle, no services, no database, no network.

require "open3"
require "fileutils"
require "rbconfig"
require "tmpdir"

SELF_PATH = File.realpath(__FILE__)
REPO      = File.dirname(File.dirname(SELF_PATH))

KINDS = %w[Added Changed Deprecated Removed Fixed Security].freeze

# The commit at which Phil's strong rule took effect in this repository.
# Everything at or before it is the standing backlog and is CENSUS ONLY; every
# entry added after it is held by CL-8 and CL-9. Move this only to record a
# NEW starting point that has been agreed, never to make a red run green.
BASELINE_REV = "4afc6cf1400583a4fa3e8a33fe06e64115c60605"

# >>> SHARED NEW-ENTRY RULE -- BEGIN
# Byte-identical to the block of the same name in the SIBLING repository's
# `bin/check-changelog`. The kiosk.tech copy compares itself against the
# reference copy whenever that sibling is beside it, so the two repositories
# cannot drift into two spellings of one rule. Edit both, or neither.
LENGTH_CAP   = 200 # characters; an entry must be UNDER this
SENTENCE_CAP = 2   # "one-two sentences"

# A period that ends one of these is not a sentence boundary.
ABBREVIATIONS = %w[e.g i.e etc vs cf al no approx Dr Mr Mrs Ms St Fig].freeze

Entry = Struct.new(:line, :text)

# An entry is a TOP-LEVEL `- ` bullet, running to the line before the next
# top-level bullet or the next ATX heading. Wrapped lines are joined with one
# space, the leading `- ` is dropped and the ends are stripped -- the unit the
# umbrella constitution names. Same fence tracker as `headings`, and the same
# honest limit: an unbalanced fence hides what follows it.
def full_entries(source)
  out   = []
  fence = nil
  cur   = nil
  source.each_line.map(&:chomp).each_with_index do |line, i|
    if (m = line.match(/\A {0,3}(`{3,}|~{3,})/))
      marker = m[1][0]
      if fence.nil?
        fence = marker
      elsif fence == marker
        fence = nil
      end
      cur[:body] << line if cur
      next
    end
    if fence
      cur[:body] << line if cur
      next
    end
    if line.start_with?("- ")
      out << cur if cur
      cur = { line: i + 1, body: [line] }
    elsif line.match?(/\A\#{1,6}[ \t]/)
      out << cur if cur
      cur = nil
    elsif cur
      cur[:body] << line
    end
  end
  out << cur if cur
  out.map { |e| Entry.new(e[:line], normalise_entry(e[:body])) }
end

def normalise_entry(body)
  body.join(" ").sub(/\A-[ \t]+/, "").gsub(/\s+/, " ").strip
end

# A scan, not a parser, and the header says so. Code spans, emphasis markers
# and dotted numbers go first, because `**a thing.**` and `0.4.12` are the two
# shapes that would otherwise decide this. Then every run of `.!?` that a
# space or the end of the entry follows counts, unless it closes a known
# abbreviation or a single-letter initial. An entry with no terminator at all
# is one sentence, not zero.
def sentence_count(text)
  t = text.gsub(/`[^`]*`/, " CODE ")
  t = t.gsub(/[*_]{1,3}/, "")
  t = t.gsub(/\d+(?:\.\d+)+/, "NUM")
  t = t.gsub("...", "…")
  n = 0
  t.scan(/[.!?]+["'»”)\]]*(?=\s|\z)/) do
    pre = Regexp.last_match.pre_match
    next if ABBREVIATIONS.any? { |a| pre.match?(/(?:\A|[^A-Za-z])#{Regexp.escape(a)}\z/i) }
    next if pre.match?(/(?:\A|\s)[A-Za-z]\z/)

    n += 1
  end
  n.zero? ? 1 : n
end
# <<< SHARED NEW-ENTRY RULE -- END

# >>> SHARED RELEASE-SECTION RULE -- BEGIN
# Byte-identical to the block of the same name in the SIBLING repository's
# `bin/check-changelog`, for the reason the block above is: one rule must not
# have two spellings. Edit both, or neither.
#
# The shapes a level-2 heading may take, and nothing else:
#
#   ## [Unreleased]                        where the next entry goes
#   ## [0.4.1] — 2026-09-24                a cut: the version AND the date it was cut
#   ## [skill 0.5.0] — 2026-09-25          the same, naming which artefact line was cut
#   ## [skill 0.5.0 · listener 0.5.1] — …  a cut that moved two of them at once
#   ## Before release sections             the entries written before this file grouped them
#
# THE VERSION IS THREE NUMBERS BECAUSE A PATCH CUT IS A RELEASE HERE. A heading
# naming a MAJOR.MINOR alone cannot say which version carries a patch-sized
# change, and saying that is the whole reason the sections exist -- a date could
# never say it, which is what this rule was written to fix. The date is required
# beside the version for the mirror reason: a version with no date says when
# nothing.
#
# THE LABEL IS WHAT A REPOSITORY PUBLISHING MORE THAN ONE VERSIONED LINE NEEDS.
# A bare version answers "which release has this" only where there is one line
# to be a release of; `kiosk.tech` publishes the skill cut and the pinned event
# listener on independent numbers, so a bare 0.5.0 there names two different
# files. Each repository's own CHANGELOG-RULE.md says which lines it has.
UNRELEASED_HEADING   = "[Unreleased]"
PRE_GROUPING_HEADING = "Before release sections"
# Either dash is accepted and the em dash is what to write: a writer copying the
# shape off an existing heading must not be refused over the hyphen that Keep a
# Changelog itself uses.
LABELLED_CUT    = /[a-z][a-z0-9-]*[ \t]+\d+\.\d+\.\d+/
RELEASE_HEADING = /\A\[(?:\d+\.\d+\.\d+|#{LABELLED_CUT}(?:[ \t]+·[ \t]+#{LABELLED_CUT})*)\]
                   [ \t]+(?:—|--?)[ \t]+\d{4}-\d{2}-\d{2}\z/x
# <<< SHARED RELEASE-SECTION RULE -- END

# >>> ARM TABLE -- BEGIN
#
# Every failure this gate can report is declared here with the shape that
# produces it, and `plant` is what the self-test does to a throwaway repository
# to make that arm fire. An arm without a way to demonstrate it cannot be added,
# which is the property that keeps the self-test from drifting into a subset.
ARMS = [
  {
    id: "CL-1",
    what: "a repeated Keep-a-Changelog subsection kind inside one release section",
    repair: "merge the two blocks under the first heading of that kind, keeping every entry",
    plant: lambda { |dir|
      write(dir, "kiosk-widget/CHANGELOG.md", <<~MD)
        # Changelog

        ## [Unreleased]

        ### Added

        - the first thing.

        ### Fixed

        - a thing that was wrong.

        ### Added

        - the second thing, filed where the first reader will never look.
      MD
    },
  },
  {
    id: "CL-2",
    what: "a repeated subsection heading inside one release section",
    repair: "merge the two blocks under the first heading with that name, keeping every entry",
    plant: lambda { |dir|
      write(dir, "kiosk-widget/CHANGELOG.md", <<~MD)
        # Changelog

        ## [Unreleased]

        ### Out of scope for first release

        - one thing deferred.

        ### Out of scope for first release

        - another thing deferred, in a second list nobody will find.
      MD
    },
  },
  {
    id: "CL-3",
    what: "a repeated release section in one file",
    repair: "merge the two sections, keeping every subsection and every entry",
    plant: lambda { |dir|
      write(dir, "kiosk-widget/CHANGELOG.md", <<~MD)
        # Changelog

        ## [Unreleased]

        ### Added

        - the first thing.

        ## [Unreleased]

        ### Fixed

        - a thing filed in a second copy of the same release.
      MD
    },
  },
  {
    id: "CL-4",
    what: "a subsection heading that no release section contains",
    repair: "put the subsection under the release section it belongs to",
    plant: lambda { |dir|
      write(dir, "kiosk-widget/CHANGELOG.md", <<~MD)
        # Changelog

        ### Added

        - an entry belonging to no release at all.

        ## [Unreleased]

        - a release with nothing under it.
      MD
    },
  },
  {
    id: "CL-5",
    what: "a tracked changelog that is neither the repository record, nor a gem package " \
          "record, nor a declared courtesy record",
    repair: "put the line in the repository record instead, or declare this file in the " \
            "COURTESY manifest with the reason it exists",
    plant: lambda { |dir|
      write(dir, "deploy/CHANGELOG.md", "# Changelog\n\n## [Unreleased]\n\n- a record nobody declared.\n")
    },
  },
  {
    id: "CL-7",
    what: "a top-level entry in the repository record that does not open with its ISO date",
    repair: "prefix the entry with the date the change landed, as `- YYYY-MM-DD: ` -- read it " \
            "off the commit that introduced the line (`git log -S`), never off today",
    plant: lambda { |dir|
      write(dir, "CHANGELOG.md", <<~MD)
        # Changelog

        The repository record, newest entry first.

        ## [Unreleased]

        - 2026-01-03: **a later thing.** Intent: it says why.
        - an entry that never says when it happened, filed above one that does.
        - 2026-01-02: **something changed.** Intent: it says why.
      MD
    },
  },
  {
    id: "CL-6",
    what: "a gem directory with no changelog, although its gemspec publishes one",
    repair: "add <gem>/CHANGELOG.md; it is inside the package and is what an installer reads",
    plant: lambda { |dir|
      write(dir, "kiosk-gadget/kiosk-gadget.gemspec", "Gem::Specification.new { |s| s.name = \"kiosk-gadget\" }\n")
    },
  },
  {
    id: "CL-8",
    what: "a NEW entry at or over #{LENGTH_CAP} characters",
    repair: "cut it to the essence -- under #{LENGTH_CAP} characters; the commit message and " \
            "the ledger row are where the details go",
    plant: lambda { |dir|
      write(dir, "CHANGELOG.md", <<~MD)
        # Changelog

        The repository record, newest entry first.

        ## [Unreleased]

        - 2026-01-04: #{"a very long single sentence about one small change " * 6}.
        #{BACKLOG_ENTRY}
      MD
    },
  },
  {
    id: "CL-9",
    what: "a NEW entry running past #{SENTENCE_CAP} sentences",
    repair: "say it in one or two sentences; the commit message and the ledger row are where " \
            "the rest goes",
    plant: lambda { |dir|
      write(dir, "CHANGELOG.md", <<~MD)
        # Changelog

        The repository record, newest entry first.

        ## [Unreleased]

        - 2026-01-05: One thing changed. A second sentence explains it. A third one runs on.
        #{BACKLOG_ENTRY}
      MD
    },
  },
  {
    id: "CL-10",
    what: "a NEW entry reviving a claim the RETIRED table records as retired",
    repair: "say what is true instead (the table's `says` line), or -- if the entry exists to " \
            "retire the claim -- name it as superseded, which is what the `correcting` marker " \
            "is for; never edit the frozen entry that carried it",
    plant: lambda { |dir|
      write(dir, "kiosk-widget/CHANGELOG.md", <<~MD)
        # Changelog

        ## [Unreleased]

        ### Changed

        - the user_code alphabet is 8-char Crockford (no 0/O/1/I/L/U), a claim retired long ago.

        ## [0.1.0] — 2026-01-01

        ### Added

        #{RETIRED_BACKLOG_ENTRY}
      MD
    },
  },
  {
    id: "CL-11",
    what: "a level-2 heading that is neither `[Unreleased]`, nor a version section " \
          "`[MAJOR.MINOR.PATCH] — YYYY-MM-DD`, nor `Before release sections`",
    repair: "name the section for the cut that carries it -- the version AND the date, as " \
            "`## [0.4.1] — 2026-09-24`; a MAJOR.MINOR alone cannot say which version has a " \
            "patch-sized change, which is what the sections are for",
    plant: lambda { |dir|
      write(dir, "kiosk-widget/CHANGELOG.md", <<~MD)
        # Changelog

        ## [Unreleased]

        ### Added

        - a thing filed under a section that names a series instead of a cut.

        ## [0.1]

        ### Fixed

        - a release nobody can match to a version this tree ever carried.
      MD
    },
  },
  {
    id: "CL-12",
    what: "a record whose first section is not `[Unreleased]`",
    repair: "open a `## [Unreleased]` section above every other section: it is where the next " \
            "entry goes, and a record without one has no answer to that question",
    plant: lambda { |dir|
      write(dir, "kiosk-widget/CHANGELOG.md", <<~MD)
        # Changelog

        ## [0.1.0] — 2026-01-01

        ### Added

        - a record that closed its last cut and never opened the next one.
      MD
    },
  },
  {
    id: "CL-13",
    what: "a top-level entry above the first section, which no release groups",
    repair: "move the entry inside `## [Unreleased]`, or inside the section that carries it",
    plant: lambda { |dir|
      write(dir, "CHANGELOG.md", <<~MD)
        # Changelog

        The repository record: one entry per significant change, newest first.

        - 2026-01-06: **an entry filed above every section.** Intent: nothing groups it.

        ## [Unreleased]

        - 2026-01-02: **something changed.** Intent: it says why.

        ## #{PRE_GROUPING_HEADING}

        #{BACKLOG_ENTRY}
      MD
    },
  },
].freeze
# <<< ARM TABLE -- END

# ── RETIRED CLAIMS ───────────────────────────────────────────────────────────
#
# CL-10's whole content: sentences this repository has retired, which may not
# come back in an entry written from now on. The header says why this rides the
# baseline; what belongs here is the shape of a record.
#
# EACH RECORD DECLARES ITS OWN ESCAPE, and it has to. A retired claim must stay
# NAMEABLE or nothing can supersede it -- the live entry that retires the one
# below quotes it in full, so a rule with no escape would redden on the repair
# for its own motivating defect. `correcting` is that escape: a marker a writer
# types on purpose and a reader sees in the same sentence. It is an OPT-OUT, and
# the header says so.
#
# `pattern` is held NON-VACUOUS by `--self-test`, which requires it to match a
# tracked line of this repository somewhere. A pattern that has stopped matching
# anything reads exactly like coverage while covering nothing -- the failure the
# sibling repository's `EARLIER_WIRES` rule carried for its whole existence.
RETIRED = [
  {
    ledger: "K-888",
    what: "the `user_code` alphabet called Crockford base32, or its space quoted as 32^8",
    says: "the alphabet is 31 characters and KEEPS U (only 0/1/I/L/O are dropped), " \
          "so the space is 31^8",
    pattern: %r{32\^8|32\*\*8|no 0/O/1/I/L/U|Crockford},
    correcting: /SUPERSEDES|NOT Crockford/,
  },
].freeze

# COURTESY MANIFEST. The two per-demo changelogs, each with the reason it is
# there, because an undeclared exemption is how a rule becomes a habit. Every
# run prints how many files each entry covered, so an entry that has stopped
# carrying weight is visible rather than assumed: a listed file that is no
# longer tracked reports 0 and fails.
COURTESY = [
  {
    path: "kiosk-demo-atablefor/CHANGELOG.md",
    why: "written when the demo was reshaped from a date-offset-seeded single restaurant into a " \
         "finite aggregator, before the rule above was settled. Kept rather than folded upward " \
         "because a changelog is an append-only record of the tree as it was, and deleting one " \
         "destroys that record to tidy a directory. It is NOT where a line about this demo goes.",
  },
  {
    path: "kiosk-demo-prove/CHANGELOG.md",
    why: "this demo is the odd one out by design -- an issuer that mounts none of the four verbs " \
         "and is not a Kiosk operator -- and its two entries are about the broker's own security " \
         "model rather than about this repository. Kept for the same append-only reason, and it " \
         "is likewise not the target of the one-line rule.",
  },
].freeze

def write(dir, rel, body)
  abs = File.join(dir, rel)
  FileUtils.mkdir_p(File.dirname(abs))
  File.write(abs, body)
end

# ── parsing ──────────────────────────────────────────────────────────────────

Heading = Struct.new(:level, :text, :line)

# Markdown ATX headings outside fenced code. The fence tracker remembers WHICH
# marker opened the fence so a `~~~` cannot close a ``` block; the header states
# that an unbalanced fence hides what follows it, which is the honest limit of a
# line scan.
def headings(path)
  out   = []
  fence = nil
  File.readlines(path, chomp: true).each_with_index do |line, i|
    if (m = line.match(/\A {0,3}(`{3,}|~{3,})/))
      marker = m[1][0]
      if fence.nil?
        fence = marker
      elsif fence == marker
        fence = nil
      end
      next
    end
    next if fence
    next unless (m = line.match(/\A(\#{1,6})[ \t]+(.+?)[ \t]*\z/))

    out << Heading.new(m[1].length, m[2].strip, i + 1)
  end
  out
end

# The TOP-LEVEL entries of a flat journal: lines that open a list item at column
# zero, outside fenced code. A nested bullet is indented and a continuation line
# is not a bullet at all, so neither is an entry. Same fence tracker as
# `headings`, and the same honest limit: an unbalanced fence hides what follows.
# (`Entry` is the struct declared in the SHARED NEW-ENTRY RULE block above.)

def top_level_entries(path)
  out   = []
  fence = nil
  File.readlines(path, chomp: true).each_with_index do |line, i|
    if (m = line.match(/\A {0,3}(`{3,}|~{3,})/))
      marker = m[1][0]
      if fence.nil?
        fence = marker
      elsif fence == marker
        fence = nil
      end
      next
    end
    next if fence
    next unless line.start_with?("- ")

    out << Entry.new(i + 1, line)
  end
  out
end

# `- YYYY-MM-DD: ` and nothing looser. A bare year, a `[2026-09-06]` bracket or a
# date in the middle of the sentence all fail: the point is that a reader scanning
# the left margin can order the file, and only the prefix does that.
DATED = /\A- \d{4}-\d{2}-\d{2}: /

def normalise_heading(text)
  text.downcase.gsub(/\s+/, " ").strip
end

def canonical_kind(text)
  KINDS.find { |k| normalise_heading(text) == k.downcase }
end

# ── the corpus ───────────────────────────────────────────────────────────────

def tracked(root, *pathspec)
  out, err, status = Open3.capture3("git", "-C", root, "ls-files", "-z", *pathspec)
  raise "git ls-files failed in #{root}: #{err}" unless status.success?

  out.split("\0").reject(&:empty?)
end

# The baseline entry set: the UNION of every top-level entry in every
# `CHANGELOG.md` this repository tracked at `rev`. Union rather than per-file,
# so moving an entry between changelogs or renaming a gem directory does not
# read as hundreds of new entries.
def baseline_of(root, rev)
  rev ||= BASELINE_REV
  _o, _e, st = Open3.capture3("git", "-C", root, "cat-file", "-e", "#{rev}^{commit}")
  return { rev: rev, missing: true, set: {}, files: 0 } unless st.success?

  out, err, s = Open3.capture3("git", "-C", root, "ls-tree", "-r", "-z", "--name-only", rev)
  raise "git ls-tree failed in #{root}: #{err}" unless s.success?

  paths = out.split("\u0000").reject(&:empty?).select { |p| File.basename(p) == "CHANGELOG.md" }
  set   = {}
  paths.each do |p|
    blob, _e2, s2 = Open3.capture3("git", "-C", root, "show", "#{rev}:#{p}")
    next unless s2.success?

    full_entries(blob).each { |e| set[e.text] = true }
  end
  { rev: rev, missing: false, set: set, files: paths.length }
end

# Does a RETIRED pattern describe prose that actually exists here? Every tracked
# file is read -- a retired claim can sit in a comment, a README or a fixture,
# and the question is about the repository rather than about changelogs. THIS
# FILE IS EXCLUDED, and that is the whole point: the table below quotes the
# vocabulary it forbids, so a self-reading walk would answer yes for any pattern
# at all and prove nothing. Undecodable bytes are scrubbed rather than skipped,
# so a file git calls binary still answers for the text it carries.
def pattern_occurs?(root, pattern)
  self_rel = SELF_PATH.delete_prefix("#{root}/")
  tracked(root).any? do |rel|
    next false if rel == self_rel

    abs = File.join(root, rel)
    next false unless File.file?(abs)

    File.binread(abs).force_encoding(Encoding::UTF_8).scrub("").match?(pattern)
  end
end

def corpus(root)
  changelogs = tracked(root, "*CHANGELOG.md")
  gem_dirs   = tracked(root, "*.gemspec").map { |p| File.dirname(p) }.uniq.sort
  [changelogs, gem_dirs]
end

def role_of(rel, gem_dirs, covered)
  return :repository if rel == "CHANGELOG.md"
  return :gem        if gem_dirs.include?(File.dirname(rel))

  entry = COURTESY.find { |c| c[:path] == rel }
  return nil unless entry

  covered[rel] += 1
  :courtesy
end

# ── scanning ─────────────────────────────────────────────────────────────────

def scan(root, baseline)
  findings   = []
  covered    = Hash.new(0)
  roles      = Hash.new(0)
  releases   = 0
  versioned  = 0
  unreleased = 0
  ungrouped  = 0
  subsects   = 0
  entries    = 0
  dated      = 0
  fresh      = 0
  backlog      = 0
  long_back    = 0
  multi_back   = 0
  retired_back = 0
  retired_seen = Hash.new(0)

  changelogs, gem_dirs = corpus(root)

  changelogs.each do |rel|
    role = role_of(rel, gem_dirs, covered)
    if role.nil?
      arm = arm_for("CL-5")
      findings << { path: rel, line: 1, id: arm[:id], what: arm[:what], repair: arm[:repair] }
      next
    end
    roles[role] += 1

    # CL-8 / CL-9 / CL-10 over every changelog, but only over entries that are
    # NEW against the baseline. The rest is counted and printed, never failed.
    full_entries(File.read(File.join(root, rel))).each do |e|
      revived = RETIRED.reject { |r| e.text.match?(r[:correcting]) }
                       .select  { |r| e.text.match?(r[:pattern]) }
      if baseline[:set].key?(e.text)
        backlog      += 1
        long_back    += 1 if e.text.length >= LENGTH_CAP
        multi_back   += 1 if sentence_count(e.text) > SENTENCE_CAP
        retired_back += revived.length
        revived.each { |r| retired_seen[r[:ledger]] += 1 }
        next
      end

      fresh += 1
      gist  = e.text.length > 64 ? "#{e.text[0, 64]}…" : e.text
      revived.each do |r|
        arm = arm_for("CL-10")
        findings << {
          path: rel, line: e.line, id: arm[:id], repair: arm[:repair],
          what: "new entry revives the claim #{r[:ledger]} retired -- #{r[:what]} -- " \
                "where #{r[:says]}: `#{gist}`",
        }
      end
      if e.text.length >= LENGTH_CAP
        arm = arm_for("CL-8")
        findings << {
          path: rel, line: e.line, id: arm[:id], repair: arm[:repair],
          what: "new entry is #{e.text.length} characters, cap #{LENGTH_CAP}: `#{gist}`",
        }
      end
      sentences = sentence_count(e.text)
      if sentences > SENTENCE_CAP
        arm = arm_for("CL-9")
        findings << {
          path: rel, line: e.line, id: arm[:id], repair: arm[:repair],
          what: "new entry runs to #{sentences} sentences, cap #{SENTENCE_CAP}: `#{gist}`",
        }
      end
    end

    # CL-7 is scoped to the repository record. A gem record dates its RELEASE
    # heading, not its bullets, so the same rule there would be simply wrong.
    if role == :repository
      top_level_entries(File.join(root, rel)).each do |e|
        entries += 1
        if e.text.match?(DATED)
          dated += 1
        else
          arm = arm_for("CL-7")
          findings << {
            path: rel, line: e.line, id: arm[:id], repair: arm[:repair],
            what: "entry opens `#{e.text[0, 60].strip}` with no `YYYY-MM-DD:` date",
          }
        end
      end
    end

    # WHERE THE NEXT ENTRY GOES is a property of the file, so it is read before the
    # walk rather than during it: the FIRST section has to be the open one.
    abs      = File.join(root, rel)
    hs       = headings(abs)
    first_h2 = hs.find { |h| h.level == 2 }

    if first_h2.nil? || first_h2.text != UNRELEASED_HEADING
      arm = arm_for("CL-12")
      findings << {
        path: rel, line: first_h2&.line || 1, id: arm[:id], repair: arm[:repair],
        what: if first_h2.nil?
                "no section at all, so there is nowhere for the next entry to go"
              else
                "the first section is `#{first_h2.text}`, not `#{UNRELEASED_HEADING}`"
              end,
      }
    else
      unreleased += 1
    end

    # An entry ABOVE the first section names no release. Scoped to a file that HAS
    # a section: one with none is CL-12's finding already, and reporting every
    # bullet of it a second time would bury that one line under the whole file.
    if first_h2
      top_level_entries(abs).each do |e|
        next if e.line > first_h2.line

        ungrouped += 1
        arm = arm_for("CL-13")
        findings << {
          path: rel, line: e.line, id: arm[:id], repair: arm[:repair],
          what: "entry `#{e.text[0, 58].strip}` sits above the first section",
        }
      end
    end

    release      = nil
    seen_release = {}
    seen_sub     = {}

    hs.each do |h|
      case h.level
      when 2
        releases += 1
        if h.text == UNRELEASED_HEADING || h.text == PRE_GROUPING_HEADING
          nil
        elsif h.text.match?(RELEASE_HEADING)
          versioned += 1
        else
          arm = arm_for("CL-11")
          findings << { path: rel, line: h.line, id: arm[:id], repair: arm[:repair],
                        what: "section `#{h.text}` is none of the three shapes a heading may take" }
        end
        key = normalise_heading(h.text)
        if seen_release.key?(key)
          arm = arm_for("CL-3")
          findings << {
            path: rel, line: h.line, id: arm[:id], repair: arm[:repair],
            what: "release section `#{h.text}` reopened; it is already open at line #{seen_release[key]}",
          }
        else
          seen_release[key] = h.line
        end
        release  = h.text
        seen_sub = {}
      when 3
        subsects += 1
        if release.nil?
          arm = arm_for("CL-4")
          findings << { path: rel, line: h.line, id: arm[:id], repair: arm[:repair],
                        what: "subsection `#{h.text}` sits above every release section" }
          next
        end

        key  = normalise_heading(h.text)
        kind = canonical_kind(h.text)
        if seen_sub.key?(key)
          arm = arm_for(kind ? "CL-1" : "CL-2")
          findings << {
            path: rel, line: h.line, id: arm[:id], repair: arm[:repair],
            what: "`### #{h.text}` appears twice under `## #{release}` " \
                  "(already at line #{seen_sub[key]})",
          }
        else
          seen_sub[key] = h.line
        end
      end
    end
  end

  gem_dirs.each do |dir|
    next if changelogs.include?(File.join(dir, "CHANGELOG.md"))

    arm = arm_for("CL-6")
    findings << { path: "#{dir}/CHANGELOG.md", line: 0, id: arm[:id], what: arm[:what],
                  repair: arm[:repair] }
  end

  COURTESY.each do |entry|
    next if covered[entry[:path]].positive?

    findings << {
      path: entry[:path], line: 0, id: "CL-5",
      what: "declared as a courtesy record, but git does not track it",
      repair: "drop the COURTESY entry if the file was removed on purpose, or restore the file",
    }
  end

  { findings: findings, covered: covered, roles: roles, files: changelogs.length,
    gems: gem_dirs.length, releases: releases, subsections: subsects,
    versioned: versioned, unreleased: unreleased, ungrouped: ungrouped,
    entries: entries, dated: dated, baseline: baseline[:rev],
    baseline_files: baseline[:files], baseline_set: baseline[:set].length,
    fresh: fresh, backlog: backlog, long_back: long_back, multi_back: multi_back,
    retired_back: retired_back, retired_seen: retired_seen }
end

def arm_for(id)
  ARMS.find { |a| a[:id] == id } || raise("unknown arm #{id}")
end

# ── modes ────────────────────────────────────────────────────────────────────

def report(result, quiet:)
  unless quiet
    r = result[:roles]
    puts "check-changelog: #{result[:files]} tracked changelog(s) -- " \
         "#{r[:repository]} repository record, #{r[:gem]} gem package record(s) " \
         "for #{result[:gems]} gem(s), #{r[:courtesy]} declared courtesy record(s)"
    puts "  #{result[:releases]} release section(s), #{result[:subsections]} subsection heading(s)"
    puts "  #{result[:versioned]} of those name a version and its date, " \
         "#{result[:unreleased]} record(s) open with `#{UNRELEASED_HEADING}`, " \
         "#{result[:ungrouped]} entry(ies) sit above a first section"
    puts "  #{result[:entries]} top-level entry(ies) in the repository record, " \
         "#{result[:dated]} carrying an ISO date"
    puts "  baseline #{result[:baseline][0, 12]} -- #{result[:baseline_set]} entry(ies) over " \
         "#{result[:baseline_files]} changelog(s) at that commit"
    puts "  #{result[:backlog]} entry(ies) at or before the baseline, #{result[:fresh]} new " \
         "since it; CL-8/CL-9/CL-10 read the new ones only"
    puts "  CENSUS, never failed: of the backlog, #{result[:long_back]} are #{LENGTH_CAP} " \
         "characters or longer and #{result[:multi_back]} run past #{SENTENCE_CAP} sentences"
    puts "  CENSUS, never failed: #{result[:retired_back]} backlog entry(ies) assert a RETIRED " \
         "claim (#{RETIRED.length} declared" \
         "#{RETIRED.map { |r| ", #{r[:ledger]} #{result[:retired_seen][r[:ledger]]}" }.join});" \
         " CL-10 reads the new entries only"
    COURTESY.each do |entry|
      puts format("  courtesy %-42s covered %d", entry[:path], result[:covered][entry[:path]])
    end
  end

  if result[:findings].empty?
    unless quiet
      puts
      puts "check-changelog: OK -- every release section answers each kind once and is named for " \
           "the cut it carries, every record opens with `#{UNRELEASED_HEADING}` and groups every " \
           "entry under a section, every tracked changelog has a declared role, every " \
           "repository-record entry says when, and every entry newer than the baseline is under " \
           "#{LENGTH_CAP} characters, at most #{SENTENCE_CAP} sentences, and free of every claim " \
           "the RETIRED table records."
      puts "(The standing backlog is counted above and never failed -- a changelog is " \
           "append-only. See the header for what this cannot see.)"
    end
    return 0
  end

  $stdout.flush
  warn ""
  warn "check-changelog: FAIL -- #{result[:findings].length} structural defect(s)."
  result[:findings].sort_by { |f| [f[:path], f[:line]] }.each do |f|
    where = f[:line].positive? ? "#{f[:path]}:#{f[:line]}" : f[:path]
    warn "  #{where}: [#{f[:id]}] #{f[:what]}"
    warn "      repair: #{f[:repair]}"
  end
  1
end

def run_check(quiet: false, baseline: nil)
  base = baseline_of(REPO, baseline)
  if base[:missing]
    warn "check-changelog: FAIL -- baseline commit #{base[:rev]} is not in this clone, so " \
         "CL-8/CL-9/CL-10 cannot tell a new entry from the standing backlog. It does not " \
         "skip: a skipped arm exits 0 and reads exactly like a clean tree."
    warn "      repair: fetch it (`git fetch --unshallow`, or check out with " \
         "`fetch-depth: 0`), or pass `--baseline <rev>` naming a commit this clone has"
    return 1
  end

  report(scan(REPO, base), quiet: quiet)
end

# ── self-test ────────────────────────────────────────────────────────────────
#
# PROVING NON-VACUITY IS HALF THE POINT. A corpus scan whose file set came out
# empty exits 0 and reads exactly like a clean repository. So this builds a
# throwaway repository carrying one of every shape that must stay GREEN, plants
# each arm's own example into it in turn, and asserts the guard goes red UNDER
# THAT ARM'S ID and names the file -- then that it comes back green when the
# plant is removed. Finally it measures the real tree, because a fixture proves
# the logic and says nothing about what this repository actually holds.

# >>> GREEN FIXTURES -- BEGIN
#
# Shapes that must NOT fire. Each is a real form that ships here today: the
# repository record with its open section, one cut naming a version and its date
# and the tail of entries written before the file grouped them, a full
# Keep-a-Changelog gem record with every kind once plus non-canonical
# subsections, a courtesy record, and -- the one that is not obvious -- a
# release section containing a FENCED BLOCK that itself contains headings,
# which a scan without a fence tracker reports as three repeats -- and, for
# CL-8/CL-9, a PRE-BASELINE entry that is long and runs to four sentences, and
# for CL-10 a PRE-BASELINE entry asserting a retired claim. Those last two are
# the K-1097 property under test: both are committed at the baseline, so both
# must be COUNTED and neither may ever be failed, and the plants below keep them
# in the file so the same run proves both halves at once.
BACKLOG_ENTRY = "- 2026-01-01: **a long entry from before the rule, kept exactly as written.** " \
                "It runs to several sentences and well past two hundred characters, which is " \
                "what the whole standing corpus looks like. It is history, so it is never " \
                "edited. The census counts it and no arm fails on it."

# The CL-10 half of the same property, and it is the one K-1671 is about: an
# entry that asserted a claim this repository has since retired, committed at
# the baseline. It must be COUNTED and never failed -- rewriting it is the one
# thing an append-only record forbids -- while the identical sentence in a new
# entry is red. Both halves are proved by the same run.
RETIRED_BACKLOG_ENTRY = "- the user_code alphabet is 8-char Crockford (no 0/O/1/I/L/U), " \
                        "written before that was retired and frozen ever since."

GREEN = {
  "CHANGELOG.md" => <<~MD,
    # Changelog

    Significant changes only: one line per change.

    ## [Unreleased]

    - 2026-01-02: **something changed.** Intent: it says why.

    ## [0.1.1] — 2026-01-02

    - 2026-01-02: **a patch cut is a release here.** Intent: as visible as a minor.

    ## #{PRE_GROUPING_HEADING}

    #{BACKLOG_ENTRY}
  MD
  "kiosk-widget/kiosk-widget.gemspec" => "Gem::Specification.new { |s| s.name = \"kiosk-widget\" }\n",
  "kiosk-widget/CHANGELOG.md" => <<~MD,
    # Changelog

    ## [Unreleased]

    ### Changed

    - one changed thing.

    ### Added

    - one added thing, and a fenced example that is not a heading:

      ```markdown
      ## [Unreleased]
      ### Added
      ### Added
      ```

    ### Deprecated

    - one deprecation.

    ### Removed

    - one removal.

    ### Fixed

    - one fix.

    ### Security

    - one security note.

    ### Out of scope for first release

    - one deferral.

    ## [0.1.0] — 2026-01-01

    ### Added

    - the same kind again, in a DIFFERENT release, which is the correct shape.

    #{RETIRED_BACKLOG_ENTRY}
  MD
  "kiosk-demo-atablefor/CHANGELOG.md" => "# Changelog\n\n## [Unreleased]\n\n- a courtesy record.\n",
  "kiosk-demo-prove/CHANGELOG.md" => "# Changelog\n\n## [Unreleased]\n\n- a courtesy record.\n",
}.freeze
# <<< GREEN FIXTURES -- END

def build_fixture(dir)
  FileUtils.mkdir_p(File.join(dir, "bin"))
  script = File.join(dir, "bin", File.basename(SELF_PATH))
  File.write(script, File.binread(SELF_PATH))
  File.chmod(0o755, script)
  GREEN.each { |rel, body| write(dir, rel, body) }
  _, err, st = Open3.capture3("git", "-C", dir, "init", "-q")
  raise "git init failed: #{err}" unless st.success?
end

def stage(dir)
  _, err, st = Open3.capture3("git", "-C", dir, "add", "-A")
  raise "git add failed: #{err}" unless st.success?
end

# The fixture needs a real BASELINE COMMIT, because "new" is defined against
# one. Everything in GREEN is committed here; every plant below is therefore
# working-tree-only and reads as new, which is exactly the arrangement the real
# repository is in.
def commit_fixture(dir)
  _, err, st = Open3.capture3("git", "-C", dir,
                              "-c", "user.email=fixture@example.invalid",
                              "-c", "user.name=fixture",
                              "commit", "-q", "--no-gpg-sign", "-m", "baseline")
  raise "git commit failed: #{err}" unless st.success?

  out, err2, st2 = Open3.capture3("git", "-C", dir, "rev-parse", "HEAD")
  raise "git rev-parse failed: #{err2}" unless st2.success?

  out.strip
end

def run_guard_in(dir, baseline = nil)
  args = baseline ? ["--baseline", baseline] : []
  Open3.capture3(RbConfig.ruby, File.join(dir, "bin", File.basename(SELF_PATH)), *args)
end

def self_test_fixture(failures)
  Dir.mktmpdir("check-changelog") do |dir|
    build_fixture(dir)
    stage(dir)
    base = commit_fixture(dir)

    out, err, st = run_guard_in(dir, base)
    if st.exitstatus.zero?
      puts "  green tree: exit 0 with every legitimate shape present -- OK"
    else
      failures << "the green fixture tree should exit 0; it exited #{st.exitstatus}\n#{out}#{err}"
    end
    unless out.include?("subsection heading(s)")
      failures << "the guard printed no subsection count, so non-vacuity cannot be read off it"
    end
    unless out.include?("carrying an ISO date")
      failures << "the guard printed no entry-date census, so CL-7's non-vacuity cannot be read off it"
    end

    # CL-11's GREEN side lives here rather than in the real tree, and deliberately:
    # a well-formed version section must pass, and this repository has not cut one
    # yet, so the fixture is the only place the shape can be proved at all.
    versioned = out[/(\d+) of those name a version and its date/, 1].to_i
    if versioned.positive?
      puts "  fixture: #{versioned} section(s) naming a version and its date, still exit 0 -- OK"
    else
      failures << "the fixture counted no version section, so CL-11's green side is proved by " \
                  "nothing:\n#{out}"
    end

    # THE BACKLOG PROPERTY, and it has to be proved rather than asserted: the
    # fixture holds a committed entry that is over both caps, the run above was
    # exit 0, and the census says it saw it. Without the census line the exit 0
    # would be indistinguishable from a corpus that had no long entry at all.
    census = out[/CENSUS, never failed: of the backlog, (\d+) are/, 1].to_i
    if census.positive?
      puts "  backlog: #{census} committed entry(ies) over the cap, still exit 0 -- OK"
    else
      failures << "the fixture's pre-baseline long entry was not counted, so the never-redden " \
                  "property is proved by nothing:\n#{out}"
    end

    # THE SAME PROPERTY FOR CL-10, and it is K-1671's whole subject: the fixture
    # holds a COMMITTED entry asserting a retired claim, the run above was exit
    # 0, and the census says it saw it. Without the count the exit 0 would be
    # indistinguishable from a fixture in which no retired claim ever appeared.
    retired_census = out[/CENSUS, never failed: (\d+) backlog entry\(ies\) assert a RETIRED/, 1].to_i
    if retired_census.positive?
      puts "  backlog: #{retired_census} committed entry(ies) assert a retired claim, " \
           "still exit 0 -- OK"
    else
      failures << "the fixture's pre-baseline retired-claim entry was not counted, so CL-10's " \
                  "never-redden property is proved by nothing:\n#{out}"
    end

    # AND THE BASELINE MUST NOT BE SKIPPABLE. A commit this clone does not have
    # has to be a RED run naming the remedy; a skip would exit 0 and read like a
    # clean tree, which is the failure this workspace distrusts most.
    outb, errb, stb = run_guard_in(dir, "0" * 40)
    combinedb = "#{outb}#{errb}"
    if stb.exitstatus.zero?
      failures << "an unresolvable baseline exited 0 -- the arms silently did not run"
    elsif !combinedb.include?("not in this clone")
      failures << "an unresolvable baseline failed without saying why:\n#{combinedb}"
    else
      puts "  unresolvable baseline: exit #{stb.exitstatus}, named with its remedy -- OK"
    end

    keep = GREEN.keys.to_h { |rel| [rel, File.binread(File.join(dir, rel))] }

    ARMS.each do |arm|
      arm[:plant].call(dir)
      stage(dir)
      out2, err2, st2 = run_guard_in(dir, base)
      combined = "#{out2}#{err2}"
      if st2.exitstatus.zero?
        failures << "planting #{arm[:id]} did not turn the guard red"
      elsif !combined.include?("[#{arm[:id]}]")
        failures << "#{arm[:id]}'s plant fired, but not under its own id:\n#{combined}"
      else
        puts "  plant #{arm[:id]}: exit #{st2.exitstatus}, reported by id -- OK"
      end

      # Restore from the bytes captured BEFORE the plant, and delete whatever the
      # plant created, rather than re-editing the fixture back into shape.
      Dir.glob(File.join(dir, "**", "*"), File::FNM_DOTMATCH).each do |abs|
        next unless File.file?(abs)

        rel = abs.delete_prefix("#{dir}/")
        next if rel.start_with?(".git/", "bin/")
        next if keep.key?(rel)

        File.delete(abs)
      end
      keep.each { |rel, body| File.write(File.join(dir, rel), body) }
      stage(dir)
    end

    # The one arm whose plant is a DELETION rather than an addition: a declared
    # courtesy record that git no longer tracks must fail, or the manifest is a
    # list of hopes.
    File.delete(File.join(dir, "kiosk-demo-prove/CHANGELOG.md"))
    stage(dir)
    out3, err3, st3 = run_guard_in(dir, base)
    combined3 = "#{out3}#{err3}"
    if st3.exitstatus.zero?
      failures << "removing a declared courtesy record did not turn the guard red"
    elsif !combined3.include?("kiosk-demo-prove/CHANGELOG.md")
      failures << "the missing courtesy record was not named:\n#{combined3}"
    else
      puts "  plant CL-5 (declared record deleted): exit #{st3.exitstatus}, named -- OK"
    end
    keep.each { |rel, body| write(dir, rel, body) }
    stage(dir)

    # CL-10's CONTROL, and a rule with no escape would have failed it. The
    # repair for the original defect is an entry that QUOTES the retired claim
    # in order to supersede it -- brand new, therefore inside CL-10's scope --
    # so the marker has to carry it back to green or the gate forbids its own
    # remedy. Same file, same release, one word of difference from the plant.
    corr = keep["kiosk-widget/CHANGELOG.md"].dup.force_encoding(Encoding::UTF_8).sub(
      "### Changed\n",
      "### Changed\n\n- **SUPERSEDES** the note that the user_code alphabet is " \
      "8-char Crockford (no 0/O/1/I/L/U); it keeps U and the space is 31^8.\n",
    )
    File.write(File.join(dir, "kiosk-widget/CHANGELOG.md"), corr)
    stage(dir)
    out5, err5, st5 = run_guard_in(dir, base)
    if st5.exitstatus.zero?
      puts "  control CL-10: a NEW entry superseding the claim by name stays green -- OK"
    else
      failures << "a new entry that names the retired claim in order to supersede it was " \
                  "failed, so the gate forbids its own repair:\n#{out5}#{err5}"
    end
    keep.each { |rel, body| write(dir, rel, body) }
    stage(dir)

    _, _, st4 = run_guard_in(dir, base)
    failures << "the fixture tree did not return to exit 0 after the plants" unless st4.exitstatus.zero?
  end
end

def run_self_test
  failures = []
  self_test_fixture(failures)

  base = baseline_of(REPO, nil)
  if base[:missing]
    failures << "the declared baseline #{base[:rev]} is not in this clone, so CL-8/CL-9/CL-10 " \
                "cannot run"
    result = scan(REPO, { rev: base[:rev], missing: true, set: {}, files: 0 })
  else
    result = scan(REPO, base)
  end
  if result[:files] < 10
    failures << "the real tree found #{result[:files]} changelog(s) -- the file set is empty or nearly so"
  end
  if result[:releases] < 10
    failures << "the real tree found #{result[:releases]} release section(s) -- the section arms are vacuous here"
  end
  if result[:subsections] < 20
    failures << "the real tree found #{result[:subsections]} subsection heading(s) -- the kind arms are vacuous here"
  end
  if result[:entries] < 100
    failures << "the real tree found #{result[:entries]} repository-record entry(ies) -- CL-7 is vacuous here"
  end
  # The count of VERSION sections is NOT asserted over the real tree, and that is
  # a measurement rather than an oversight: no cut has been made here yet, so it
  # is legitimately zero and an assertion would be red on arrival. The fixture
  # above is where CL-11's green side is proved. What holds here is the property
  # that does not wait for a release -- every record opens with its section.
  if result[:unreleased] < result[:files]
    failures << "#{result[:files] - result[:unreleased]} record(s) do not open with " \
                "`#{UNRELEASED_HEADING}`, so CL-12 is red over this repository"
  end
  if result[:backlog] < 100
    failures << "the real tree found #{result[:backlog]} pre-baseline entry(ies) -- the baseline " \
                "resolved to something that is not this repository's history"
  end
  if result[:long_back].zero?
    failures << "not one pre-baseline entry is at or over #{LENGTH_CAP} characters, so the census " \
                "tier is proving nothing here and CL-8 could be scoped to the whole file instead"
  end
  if result[:retired_back].zero?
    failures << "not one pre-baseline entry asserts a RETIRED claim, so CL-10's census tier is " \
                "proving nothing here and the arm could be scoped to the whole file instead"
  end
  vacuous = RETIRED.reject { |r| pattern_occurs?(REPO, r[:pattern]) }
  vacuous.each do |r|
    failures << "#{r[:ledger]}'s RETIRED pattern /#{r[:pattern].source}/ matches no tracked line " \
                "of this repository, so it covers nothing while reading exactly like coverage"
  end
  puts "  real tree: #{RETIRED.length} RETIRED claim(s) declared, each matching tracked prose " \
       "(#{result[:retired_back]} pre-baseline entry(ies) assert one, census only)"
  puts "  real tree: #{result[:files]} changelog(s), #{result[:releases]} release section(s), " \
       "#{result[:subsections]} subsection heading(s), #{result[:dated]} of " \
       "#{result[:entries]} repository entry(ies) dated -- non-vacuous"
  puts "  real tree: #{result[:versioned]} section(s) name a version and its date, " \
       "#{result[:unreleased]} of #{result[:files]} record(s) open with " \
       "`#{UNRELEASED_HEADING}`, #{result[:ungrouped]} entry(ies) above a first section"
  puts "  real tree: baseline #{result[:baseline][0, 12]}, #{result[:backlog]} entry(ies) at or " \
       "before it (#{result[:long_back]} over the length cap, #{result[:multi_back]} over the " \
       "sentence cap, all census only), #{result[:fresh]} newer and held"

  status = report(result, quiet: true)
  failures << "the guard is not green over this repository (exit #{status})" unless status.zero?
  puts "  real tree: check exits #{status}"

  if failures.empty?
    puts
    puts "check-changelog --self-test: OK -- red on a plant of every arm (CL-1..CL-13) and on " \
         "an unresolvable baseline, green on every legitimate shape including headings inside a " \
         "fence, an undated bullet in a GEM record, a committed entry over both caps, a " \
         "committed entry asserting a retired claim and a new entry superseding one by name, " \
         "and non-vacuous over this repository."
    return 0
  end

  $stdout.flush
  warn ""
  warn "check-changelog --self-test: FAIL"
  failures.each { |f| warn "  #{f}" }
  1
end

# ── entry point ──────────────────────────────────────────────────────────────

args     = ARGV.dup
baseline = nil
if (i = args.index("--baseline"))
  baseline = args[i + 1]
  args.slice!(i, 2)
  if baseline.nil? || baseline.empty?
    warn "usage: check-changelog [--baseline REV] [--self-test]"
    exit 2
  end
end

code =
  case args[0]
  when nil           then run_check(baseline: baseline)
  when "--self-test" then run_self_test
  else
    warn "usage: check-changelog [--baseline REV] [--self-test]"
    2
  end
exit code
