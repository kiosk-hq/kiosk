#!/usr/bin/env ruby
# frozen_string_literal: true

# check-changelog -- the structure of every tracked CHANGELOG.md (the CL-* arms
# below), plus the 200-character / two-sentence cap on entries newer than
# BASELINE_REV; older entries are only counted. The two SHARED blocks are
# byte-identical to kiosk.tech/bin/check-changelog.
# Usage: bin/check-changelog [--baseline REV] [--self-test]

require 'open3'
require 'fileutils'
require 'rbconfig'
require 'tmpdir'

SELF_PATH = File.realpath(__FILE__)
REPO      = File.dirname(SELF_PATH, 2)

KINDS = %w[Added Changed Deprecated Removed Fixed Security].freeze

# Entries present at this commit are the append-only backlog: counted, never failed.
BASELINE_REV = '4afc6cf1400583a4fa3e8a33fe06e64115c60605'

# >>> SHARED NEW-ENTRY RULE -- BEGIN
# Byte-identical to the block of the same name in the SIBLING repository's
# `bin/check-changelog`. The kiosk.tech copy compares itself against the
# reference copy whenever that sibling is beside it, so the two repositories
# cannot drift into two spellings of one rule. Edit both, or neither.
LENGTH_CAP   = 200 # characters; an entry must be UNDER this
SENTENCE_CAP = 2   # "one-two sentences"

# A period that ends one of these is not a sentence boundary.
ABBREVIATIONS = %w[e.g i.e etc vs cf al no approx Dr Mr Mrs Ms St Fig].freeze

Entry = Struct.new(:line, :text)

# An entry is a TOP-LEVEL `- ` bullet, running to the line before the next
# top-level bullet or the next ATX heading. Wrapped lines are joined with one
# space, the leading `- ` is dropped and the ends are stripped -- the unit the
# umbrella constitution names. Same fence tracker as `headings`, and the same
# honest limit: an unbalanced fence hides what follows it.
def full_entries(source)
  out = []
  cur = nil
  fence_marked(source.each_line.map(&:chomp)).each_with_index do |(line, code), i|
    cur = code ? add_to_entry(cur, line) : entry_step(out, cur, line, i + 1)
  end
  out << cur if cur
  out.map { |e| Entry.new(e[:line], normalise_entry(e[:body])) }
end

# Returns the entry that is open after `line`; a closed entry goes to `out`.
def entry_step(out, cur, line, number)
  if line.start_with?('- ')
    out << cur if cur
    { line: number, body: [line] }
  elsif line.match?(/\A\#{1,6}[ \t]/)
    out << cur if cur
    nil
  else
    add_to_entry(cur, line)
  end
end

def add_to_entry(cur, line)
  cur[:body] << line if cur
  cur
end

FENCE = /\A {0,3}(`{3,}|~{3,})/

# Pairs every line with true when it opens, closes or sits inside a fence.
def fence_marked(lines)
  fence = nil
  lines.map do |line|
    code  = !fence.nil? || line.match?(FENCE)
    fence = next_fence(fence, line)
    [line, code]
  end
end

def next_fence(fence, line)
  m = line.match(FENCE)
  return fence unless m
  return m[1][0] if fence.nil?

  fence == m[1][0] ? nil : fence
end

def normalise_entry(body)
  body.join(' ').sub(/\A-[ \t]+/, '').gsub(/\s+/, ' ').strip
end

# A scan, not a parser, and the header says so. Code spans, emphasis markers
# and dotted numbers go first, because `**a thing.**` and `0.4.12` are the two
# shapes that would otherwise decide this. Then every run of `.!?` that a
# space or the end of the entry follows counts, unless it closes a known
# abbreviation or a single-letter initial. An entry with no terminator at all
# is one sentence, not zero.
def sentence_count(text)
  n = 0
  sentence_scan_text(text).scan(/[.!?]+["'»”)\]]*(?=\s|\z)/) do
    n += 1 unless abbreviation_end?(Regexp.last_match.pre_match)
  end
  n.zero? ? 1 : n
end

def sentence_scan_text(text)
  t = text.gsub(/`[^`]*`/, ' CODE ')
  t = t.gsub(/[*_]{1,3}/, '')
  t = t.gsub(/\d+(?:\.\d+)+/, 'NUM')
  t.gsub('...', '…')
end

def abbreviation_end?(pre)
  ABBREVIATIONS.any? { |a| pre.match?(/(?:\A|[^A-Za-z])#{Regexp.escape(a)}\z/i) } ||
    pre.match?(/(?:\A|\s)[A-Za-z]\z/)
end
# <<< SHARED NEW-ENTRY RULE -- END

# >>> SHARED RELEASE-SECTION RULE -- BEGIN
# Byte-identical to the block of the same name in the SIBLING repository's
# `bin/check-changelog`, for the reason the block above is: one rule must not
# have two spellings. Edit both, or neither.
#
# The shapes a level-2 heading may take, and nothing else:
#
#   ## [Unreleased]                        where the next entry goes
#   ## [0.4.1] — 2026-09-24                a cut: the version AND the date it was cut
#   ## [skill 0.5.0] — 2026-09-25          the same, naming which artefact line was cut
#   ## [skill 0.5.0 · listener 0.5.1] — …  a cut that moved two of them at once
#   ## Before release sections             the entries written before this file grouped them
#
# THE VERSION IS THREE NUMBERS BECAUSE A PATCH CUT IS A RELEASE HERE. A heading
# naming a MAJOR.MINOR alone cannot say which version carries a patch-sized
# change, and saying that is the whole reason the sections exist -- a date could
# never say it, which is what this rule was written to fix. The date is required
# beside the version for the mirror reason: a version with no date says when
# nothing.
#
# THE LABEL IS WHAT A REPOSITORY PUBLISHING MORE THAN ONE VERSIONED LINE NEEDS.
# A bare version answers "which release has this" only where there is one line
# to be a release of; `kiosk.tech` publishes the skill cut and the pinned event
# listener on independent numbers, so a bare 0.5.0 there names two different
# files. Each repository's own CHANGELOG-RULE.md says which lines it has.
UNRELEASED_HEADING   = '[Unreleased]'
PRE_GROUPING_HEADING = 'Before release sections'
# Either dash is accepted and the em dash is what to write: a writer copying the
# shape off an existing heading must not be refused over the hyphen that Keep a
# Changelog itself uses.
LABELLED_CUT    = /[a-z][a-z0-9-]*[ \t]+\d+\.\d+\.\d+/
RELEASE_HEADING = /\A\[(?:\d+\.\d+\.\d+|#{LABELLED_CUT}(?:[ \t]+·[ \t]+#{LABELLED_CUT})*)\]
                   [ \t]+(?:—|--?)[ \t]+\d{4}-\d{2}-\d{2}\z/x
# <<< SHARED RELEASE-SECTION RULE -- END

ARMS = [
  {
    id: 'CL-1',
    what: 'a repeated Keep-a-Changelog subsection kind inside one release section',
    repair: 'merge the two blocks under the first heading of that kind, keeping every entry',
    plant: lambda { |dir|
      write(dir, 'kiosk-widget/CHANGELOG.md', <<~MD)
        # Changelog

        ## [Unreleased]

        ### Added

        - the first thing.

        ### Fixed

        - a thing that was wrong.

        ### Added

        - the second thing.
      MD
    }
  },
  {
    id: 'CL-2',
    what: 'a repeated subsection heading inside one release section',
    repair: 'merge the two blocks under the first heading with that name, keeping every entry',
    plant: lambda { |dir|
      write(dir, 'kiosk-widget/CHANGELOG.md', <<~MD)
        # Changelog

        ## [Unreleased]

        ### Out of scope for first release

        - one thing deferred.

        ### Out of scope for first release

        - another thing deferred.
      MD
    }
  },
  {
    id: 'CL-3',
    what: 'a repeated release section in one file',
    repair: 'merge the two sections, keeping every subsection and every entry',
    plant: lambda { |dir|
      write(dir, 'kiosk-widget/CHANGELOG.md', <<~MD)
        # Changelog

        ## [Unreleased]

        ### Added

        - the first thing.

        ## [Unreleased]

        ### Fixed

        - a thing filed in a second copy of the same release.
      MD
    }
  },
  {
    id: 'CL-4',
    what: 'a subsection heading that no release section contains',
    repair: 'put the subsection under the release section it belongs to',
    plant: lambda { |dir|
      write(dir, 'kiosk-widget/CHANGELOG.md', <<~MD)
        # Changelog

        ### Added

        - an entry belonging to no release at all.

        ## [Unreleased]

        - a release with nothing under it.
      MD
    }
  },
  {
    id: 'CL-5',
    what: 'a tracked changelog that is neither the repository record, nor a gem package ' \
          'record, nor a declared courtesy record',
    repair: 'put the line in the repository record instead, or declare this file in COURTESY with its reason',
    plant: lambda { |dir|
      write(dir, 'deploy/CHANGELOG.md', "# Changelog\n\n## [Unreleased]\n\n- a record nobody declared.\n")
    }
  },
  {
    id: 'CL-6',
    what: 'a gem directory with no changelog, although its gemspec publishes one',
    repair: 'add <gem>/CHANGELOG.md; it ships inside the package',
    plant: lambda { |dir|
      write(dir, 'kiosk-gadget/kiosk-gadget.gemspec', "Gem::Specification.new { |s| s.name = \"kiosk-gadget\" }\n")
    }
  },
  {
    id: 'CL-7',
    what: 'a top-level entry in the repository record that does not open with its ISO date',
    repair: 'prefix the entry with `- YYYY-MM-DD: `, the date of the commit that introduced it',
    plant: lambda { |dir|
      write(dir, 'CHANGELOG.md', <<~MD)
        # Changelog

        ## [Unreleased]

        - 2026-01-03: **a later thing.** Intent: it says why.
        - an entry that never says when it happened.
        - 2026-01-02: **something changed.** Intent: it says why.
      MD
    }
  },
  {
    id: 'CL-8',
    what: "a new entry at or over #{LENGTH_CAP} characters",
    repair: "cut it to the essence, under #{LENGTH_CAP} characters; details go in the commit message",
    plant: lambda { |dir|
      write(dir, 'CHANGELOG.md', <<~MD)
        # Changelog

        ## [Unreleased]

        - 2026-01-04: #{'a very long single sentence about one small change ' * 6}.
        #{BACKLOG_ENTRY}
      MD
    }
  },
  {
    id: 'CL-9',
    what: "a new entry running past #{SENTENCE_CAP} sentences",
    repair: 'say it in one or two sentences; details go in the commit message',
    plant: lambda { |dir|
      write(dir, 'CHANGELOG.md', <<~MD)
        # Changelog

        ## [Unreleased]

        - 2026-01-05: One thing changed. A second sentence explains it. A third one runs on.
        #{BACKLOG_ENTRY}
      MD
    }
  },
  {
    id: 'CL-11',
    what: 'a level-2 heading that is neither `[Unreleased]`, nor a version section ' \
          "`[MAJOR.MINOR.PATCH] — YYYY-MM-DD`, nor `#{PRE_GROUPING_HEADING}`",
    repair: 'name the section for the cut that carries it, version and date: `## [0.4.1] — 2026-09-24`',
    plant: lambda { |dir|
      write(dir, 'kiosk-widget/CHANGELOG.md', <<~MD)
        # Changelog

        ## [Unreleased]

        ### Added

        - a thing.

        ## [0.1]

        ### Fixed

        - a release named for a series instead of a cut.
      MD
    }
  },
  {
    id: 'CL-12',
    what: 'a record whose first section is not `[Unreleased]`',
    repair: 'open a `## [Unreleased]` section above every other section',
    plant: lambda { |dir|
      write(dir, 'kiosk-widget/CHANGELOG.md', <<~MD)
        # Changelog

        ## [0.1.0] — 2026-01-01

        ### Added

        - a record that never opened the next release.
      MD
    }
  },
  {
    id: 'CL-13',
    what: 'a top-level entry above the first section, which no release groups',
    repair: 'move the entry inside `## [Unreleased]`, or inside the section that carries it',
    plant: lambda { |dir|
      write(dir, 'CHANGELOG.md', <<~MD)
        # Changelog

        - 2026-01-06: **an entry filed above every section.**

        ## [Unreleased]

        - 2026-01-02: **something changed.** Intent: it says why.

        ## #{PRE_GROUPING_HEADING}

        #{BACKLOG_ENTRY}
      MD
    }
  }
].freeze

# Per-demo changelogs allowed beside the repository record, each with its reason.
COURTESY = [
  { path: 'kiosk-demo-atablefor/CHANGELOG.md',
    why: "kept as append-only history of the demo's reshape; new lines go to the repository record" },
  { path: 'kiosk-demo-prove/CHANGELOG.md',
    why: "kept as append-only history of the broker's security model; new lines go to the repository record" }
].freeze

def write(dir, rel, body)
  abs = File.join(dir, rel)
  FileUtils.mkdir_p(File.dirname(abs))
  File.write(abs, body)
end

Heading = Struct.new(:level, :text, :line)

# Yields [line, index] for every line outside fenced code.
def unfenced_lines(path)
  fence_marked(File.readlines(path, chomp: true)).each_with_index do |(line, code), i|
    yield line, i unless code
  end
end

def headings(path)
  out = []
  unfenced_lines(path) do |line, i|
    m = line.match(/\A(\#{1,6})[ \t]+(.+?)[ \t]*\z/)
    out << Heading.new(m[1].length, m[2].strip, i + 1) if m
  end
  out
end

def top_level_entries(path)
  out = []
  unfenced_lines(path) { |line, i| out << Entry.new(i + 1, line) if line.start_with?('- ') }
  out
end

DATED = /\A- \d{4}-\d{2}-\d{2}: /

def normalise_heading(text)
  text.downcase.gsub(/\s+/, ' ').strip
end

def tracked(root, *pathspec)
  out, err, status = Open3.capture3('git', '-C', root, 'ls-files', '-z', *pathspec)
  raise "git ls-files failed in #{root}: #{err}" unless status.success?

  out.split("\0").reject(&:empty?)
end

# Union of every top-level entry in every CHANGELOG.md at `rev`, so moving an entry
# between files does not make it new.
def baseline_of(root, rev)
  rev ||= BASELINE_REV
  _o, _e, st = Open3.capture3('git', '-C', root, 'cat-file', '-e', "#{rev}^{commit}")
  return { rev: rev, missing: true } unless st.success?

  { rev: rev, missing: false, set: baseline_set(root, rev) }
end

def baseline_set(root, rev)
  set = {}
  changelogs_at(root, rev).each do |p|
    blob, _e, st = Open3.capture3('git', '-C', root, 'show', "#{rev}:#{p}")
    full_entries(blob).each { |e| set[e.text] = true } if st.success?
  end
  set
end

def changelogs_at(root, rev)
  out, err, st = Open3.capture3('git', '-C', root, 'ls-tree', '-r', '-z', '--name-only', rev)
  raise "git ls-tree failed in #{root}: #{err}" unless st.success?

  out.split("\0").select { |p| File.basename(p) == 'CHANGELOG.md' }
end

def role_of(rel, gem_dirs)
  return :repository if rel == 'CHANGELOG.md'
  return :gem        if gem_dirs.include?(File.dirname(rel))

  :courtesy if COURTESY.any? { |c| c[:path] == rel }
end

# Runs every CL-* arm over the tracked changelogs of one tree.
class ChangelogScan
  # CL-1, CL-2, CL-3, CL-4 and CL-11 over the headings of one changelog.
  class SectionScan
    def initialize(stats, &add)
      @stats        = stats
      @add          = add
      @release      = nil
      @seen_release = {}
      @seen_sub     = {}
    end

    def run(heads)
      heads.each do |h|
        case h.level
        when 2 then check_release(h)
        when 3 then check_subsection(h)
        end
      end
    end

    private

    # CL-3: one release section per name.
    def check_release(head)
      @stats[:releases] += 1
      check_release_shape(head)
      key = normalise_heading(head.text)
      if @seen_release.key?(key)
        @add.call(head.line, 'CL-3', "release section `#{head.text}` reopened; already open at line #{@seen_release[key]}")
      else
        @seen_release[key] = head.line
      end
      @release  = head.text
      @seen_sub = {}
    end

    # CL-11: heading shape.
    def check_release_shape(head)
      if head.text.match?(RELEASE_HEADING)
        @stats[:versioned] += 1
      elsif ![UNRELEASED_HEADING, PRE_GROUPING_HEADING].include?(head.text)
        @add.call(head.line, 'CL-11', "section `#{head.text}` is none of the shapes a heading may take")
      end
    end

    # CL-4: every subsection sits under a release.
    def check_subsection(head)
      @stats[:subsections] += 1
      return @add.call(head.line, 'CL-4', "subsection `#{head.text}` sits above every release section") if @release.nil?

      key = normalise_heading(head.text)
      return check_repeated_subsection(head, key) if @seen_sub.key?(key)

      @seen_sub[key] = head.line
    end

    # CL-1 / CL-2: one subsection per name per release.
    def check_repeated_subsection(head, key)
      id = KINDS.any? { |k| key == k.downcase } ? 'CL-1' : 'CL-2'
      @add.call(head.line, id, "`### #{head.text}` appears twice under `## #{@release}` (already at line #{@seen_sub[key]})")
    end
  end

  def initialize(root, baseline)
    @root       = root
    @baseline   = baseline
    @findings   = []
    @stats      = Hash.new(0)
    @changelogs = tracked(root, '*CHANGELOG.md')
    @gem_dirs   = tracked(root, '*.gemspec').map { |p| File.dirname(p) }.uniq
  end

  def result
    @changelogs.each { |rel| check_file(rel) }
    check_gem_records
    check_courtesy
    @stats.merge(findings: @findings, files: @changelogs.length)
  end

  private

  def add(rel, line, id, what = nil)
    arm = ARMS.find { |a| a[:id] == id }
    @findings << { path: rel, line: line, id: id, what: what || arm[:what], repair: arm[:repair] }
  end

  def check_file(rel)
    role = role_of(rel, @gem_dirs)
    return add(rel, 1, 'CL-5') unless role

    @stats[role] += 1
    abs = File.join(@root, rel)
    check_new_entries(rel, File.read(abs))
    entries = top_level_entries(abs)
    check_dates(rel, entries) if role == :repository
    heads = headings(abs)
    check_first_section(rel, heads, entries)
    check_sections(rel, heads)
  end

  # CL-8 / CL-9: new entries only.
  def check_new_entries(rel, source)
    full_entries(source).each do |e|
      if @baseline[:set].key?(e.text)
        @stats[:backlog] += 1
      else
        @stats[:fresh] += 1
        check_caps(rel, e)
      end
    end
  end

  def check_caps(rel, entry)
    text = entry.text
    gist = text.length > 64 ? "#{text[0, 64]}…" : text
    add(rel, entry.line, 'CL-8', "new entry is #{text.length} characters, cap #{LENGTH_CAP}: `#{gist}`") if text.length >= LENGTH_CAP
    n = sentence_count(text)
    add(rel, entry.line, 'CL-9', "new entry runs to #{n} sentences, cap #{SENTENCE_CAP}: `#{gist}`") if n > SENTENCE_CAP
  end

  # CL-7: repository-record entries are dated; gem records date the release heading.
  def check_dates(rel, entries)
    entries.each do |e|
      @stats[:entries] += 1
      next @stats[:dated] += 1 if e.text.match?(DATED)

      add(rel, e.line, 'CL-7', "entry opens `#{e.text[0, 60].strip}` with no `YYYY-MM-DD:` date")
    end
  end

  # CL-12: the first section is `[Unreleased]`.
  def check_first_section(rel, heads, entries)
    first = heads.find { |h| h.level == 2 }
    return add(rel, 1, 'CL-12', 'no section at all, so there is nowhere for the next entry to go') if first.nil?

    add(rel, first.line, 'CL-12', "the first section is `#{first.text}`, not `#{UNRELEASED_HEADING}`") unless first.text == UNRELEASED_HEADING
    check_entries_above(rel, first, entries)
  end

  # CL-13: no entry above the first section.
  def check_entries_above(rel, first, entries)
    entries.each do |e|
      add(rel, e.line, 'CL-13', "entry `#{e.text[0, 58].strip}` sits above the first section") if e.line <= first.line
    end
  end

  def check_sections(rel, heads)
    SectionScan.new(@stats) { |line, id, what| add(rel, line, id, what) }.run(heads)
  end

  # CL-6: every gem ships a changelog.
  def check_gem_records
    @gem_dirs.each do |dir|
      path = File.join(dir, 'CHANGELOG.md')
      add(path, 0, 'CL-6') unless @changelogs.include?(path)
    end
  end

  # CL-5: every COURTESY entry is tracked.
  def check_courtesy
    COURTESY.each do |c|
      next if @changelogs.include?(c[:path])

      @findings << { path: c[:path], line: 0, id: 'CL-5', what: 'declared in COURTESY, but git does not track it',
                     repair: 'drop the COURTESY entry, or restore the file' }
    end
  end
end

def scan(root, baseline)
  ChangelogScan.new(root, baseline).result
end

def report(result, quiet:)
  print_summary(result) unless quiet
  if result[:findings].empty?
    puts 'check-changelog: OK' unless quiet
    return 0
  end

  print_findings(result[:findings])
  1
end

def print_summary(result)
  puts "check-changelog: #{result[:files]} changelog(s) -- #{result[:repository]} repository, " \
       "#{result[:gem]} gem, #{result[:courtesy]} courtesy; #{result[:releases]} release section(s), " \
       "#{result[:versioned]} versioned, #{result[:subsections]} subsection heading(s)"
  puts "  #{result[:dated]} of #{result[:entries]} repository-record entries dated; " \
       "#{result[:fresh]} new entries held to the caps, #{result[:backlog]} backlog entries not"
end

def print_findings(findings)
  $stdout.flush
  warn "check-changelog: FAIL -- #{findings.length} defect(s)."
  findings.sort_by { |f| [f[:path], f[:line]] }.each { |f| print_finding(f) }
end

def print_finding(finding)
  where = finding[:line].positive? ? "#{finding[:path]}:#{finding[:line]}" : finding[:path]
  warn "  #{where}: [#{finding[:id]}] #{finding[:what]}"
  warn "      repair: #{finding[:repair]}"
end

def run_check(baseline: nil)
  base = baseline_of(REPO, baseline)
  if base[:missing]
    warn "check-changelog: FAIL -- baseline commit #{base[:rev]} is not in this clone, so new " \
         'entries cannot be told from the backlog.'
    warn '      repair: fetch full history (`git fetch --unshallow`, or `fetch-depth: 0`), ' \
         'or pass `--baseline <rev>`'
    return 1
  end

  report(scan(REPO, base), quiet: false)
end

# ── self-test ────────────────────────────────────────────────────────────────

# A committed entry over both caps: counted as backlog, never failed.
BACKLOG_ENTRY = '- 2026-01-01: **a long entry from before the rule, kept exactly as written.** ' \
                'It runs to several sentences and well past two hundred characters, which is ' \
                'what the whole standing corpus looks like. It is history, so it is never ' \
                'edited. No arm fails on it.'

# Shapes that must stay green, including headings inside a fence.
GREEN = {
  'CHANGELOG.md' => <<~MD,
    # Changelog

    ## [Unreleased]

    - 2026-01-02: **something changed.** Intent: it says why.

    ## [0.1.1] — 2026-01-02

    - 2026-01-02: **a patch cut is a release here.**

    ## #{PRE_GROUPING_HEADING}

    #{BACKLOG_ENTRY}
  MD
  'kiosk-widget/kiosk-widget.gemspec' => "Gem::Specification.new { |s| s.name = \"kiosk-widget\" }\n",
  'kiosk-widget/CHANGELOG.md' => <<~MD,
    # Changelog

    ## [Unreleased]

    ### Changed

    - one changed thing.

    ### Added

    - one added thing, and a fenced example that is not a heading:

      ```markdown
      ## [Unreleased]
      ### Added
      ### Added
      ```

    ### Deprecated

    - one deprecation.

    ### Removed

    - one removal.

    ### Fixed

    - one fix.

    ### Security

    - one security note.

    ### Out of scope for first release

    - one deferral.

    ## [0.1.0] — 2026-01-01

    ### Added

    - the same kind again, in a different release.
  MD
  'kiosk-demo-atablefor/CHANGELOG.md' => "# Changelog\n\n## [Unreleased]\n\n- a courtesy record.\n",
  'kiosk-demo-prove/CHANGELOG.md' => "# Changelog\n\n## [Unreleased]\n\n- a courtesy record.\n"
}.freeze

def git!(dir, *args)
  out, err, st = Open3.capture3('git', '-C', dir, *args)
  raise "git #{args.first} failed: #{err}" unless st.success?

  out
end

def run_guard_in(dir, baseline)
  Open3.capture3(RbConfig.ruby, File.join(dir, 'bin', File.basename(SELF_PATH)), '--baseline', baseline)
end

# Stages the planted tree, runs the check, and restores the green tree.
def expect_red(failures, dir, base, label, needle)
  git!(dir, 'add', '-A')
  out, err, st = run_guard_in(dir, base)
  if st.exitstatus.zero?
    failures << "#{label} did not turn the check red"
  elsif !"#{out}#{err}".include?(needle)
    failures << "#{label} fired, but without `#{needle}`:\n#{out}#{err}"
  else
    puts "  #{label}: exit #{st.exitstatus} -- OK"
  end
  restore_fixture(dir)
end

def restore_fixture(dir)
  git!(dir, 'ls-files').split("\n").each do |rel|
    File.delete(File.join(dir, rel)) unless GREEN.key?(rel) || rel.start_with?('bin/')
  end
  GREEN.each { |rel, body| write(dir, rel, body) }
  git!(dir, 'add', '-A')
end

def build_fixture(dir)
  write(dir, "bin/#{File.basename(SELF_PATH)}", File.binread(SELF_PATH))
  GREEN.each { |rel, body| write(dir, rel, body) }
  git!(dir, 'init', '-q')
  git!(dir, 'add', '-A')
  git!(dir, '-c', 'user.email=fixture@example.invalid', '-c', 'user.name=fixture',
       'commit', '-q', '--no-gpg-sign', '-m', 'baseline')
  git!(dir, 'rev-parse', 'HEAD').strip
end

def expect_green_fixture(failures, dir, base)
  out, err, st = run_guard_in(dir, base)
  if st.exitstatus.zero? && out[/(\d+) versioned/, 1].to_i.positive?
    puts '  green tree (version sections, an over-cap backlog entry): exit 0 -- OK'
  else
    failures << 'the green fixture should exit 0 and count its version sections; ' \
                "it exited #{st.exitstatus}\n#{out}#{err}"
  end
end

def expect_missing_baseline(failures, dir)
  _, err, st = run_guard_in(dir, '0' * 40)
  if st.exitstatus.zero? || !err.include?('not in this clone')
    failures << "an unresolvable baseline must fail naming the remedy; it exited #{st.exitstatus}"
  else
    puts "  unresolvable baseline: exit #{st.exitstatus} -- OK"
  end
end

def plant_each_arm(failures, dir, base)
  ARMS.each do |arm|
    arm[:plant].call(dir)
    expect_red(failures, dir, base, "plant #{arm[:id]}", "[#{arm[:id]}]")
  end
  File.delete(File.join(dir, 'kiosk-demo-prove/CHANGELOG.md'))
  expect_red(failures, dir, base, 'plant CL-5 (declared record deleted)', 'kiosk-demo-prove/CHANGELOG.md')
end

def self_test_fixture(failures)
  Dir.mktmpdir('check-changelog') do |dir|
    base = build_fixture(dir)
    expect_green_fixture(failures, dir, base)
    expect_missing_baseline(failures, dir)
    plant_each_arm(failures, dir, base)
    _, _, st = run_guard_in(dir, base)
    failures << 'the fixture tree did not return to exit 0 after the plants' unless st.exitstatus.zero?
  end
end

# Minimum counts over this repository; below one, the arms have nothing to read.
REAL_TREE_FLOORS = { files: 10, releases: 10, subsections: 20, entries: 100, backlog: 100 }.freeze

def check_floors(failures, result)
  REAL_TREE_FLOORS.each do |key, floor|
    failures << "the real tree found only #{result[key]} #{key} (floor #{floor}) -- the arms are vacuous here" if result[key] < floor
  end
end

def check_real_tree(failures)
  base = baseline_of(REPO, nil)
  return failures << "the declared baseline #{base[:rev]} is not in this clone" if base[:missing]

  result = scan(REPO, base)
  check_floors(failures, result)
  status = report(result, quiet: true)
  failures << "the check is not green over this repository (exit #{status})" unless status.zero?
  puts "  real tree: #{result[:files]} changelogs, #{result[:releases]} release sections, " \
       "#{result[:entries]} repository entries, #{result[:backlog]} backlog; check exits #{status}"
end

def run_self_test
  failures = []
  self_test_fixture(failures)
  check_real_tree(failures)
  return self_test_ok if failures.empty?

  $stdout.flush
  warn 'check-changelog --self-test: FAIL'
  failures.each { |f| warn "  #{f}" }
  1
end

def self_test_ok
  puts 'check-changelog --self-test: OK'
  0
end

USAGE = 'usage: check-changelog [--baseline REV] [--self-test]'

args     = ARGV.dup
baseline = nil
if (i = args.index('--baseline'))
  baseline = args.slice!(i, 2)[1]
  abort USAGE if baseline.nil? || baseline.empty?
end

exit(case args
     when []              then run_check(baseline: baseline)
     when ['--self-test'] then run_self_test
     else
       warn USAGE
       2
     end)
