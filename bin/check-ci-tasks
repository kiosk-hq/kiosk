#!/usr/bin/env ruby
# frozen_string_literal: true

# CI task-coverage check: every demo rake task is either a gate CI runs or an
# opt-out with a reason, and every registered verb is named in its README.
#
# THE TWO NAMESPACES. A demo's rake tasks say what they are by their namespace:
#   * `check:<name>` ASSERTS. It exits non-zero when the property it names
#     breaks, so it is a gate whether or not a runner happens to run it.
#   * `demo:<name>` is for a person to run and read the output of — `demo:setup`
#     prepares the database, getgrocery's `demo:reconcile` reports on stuck
#     orders. Neither can go red, so neither is a gate.
#
# THE RULE IT ENFORCES. Every `check:` task must be exactly one of:
#   * run in CI — named in that demo's matrix `tasks:` list in
#     `.github/workflows/ci.yml`, or
#   * explicitly opted out — a key in that entry's `ungated:` map, whose value is
#     the REASON it is not a gate.
# A task in neither fails. So does an opt-out for a task that no longer exists,
# an opt-out with no reason, a task both listed and opted out, a `tasks:` entry
# the demo does not define, a demo directory with no matrix entry at all, and a
# `demo:` task in a `tasks:` list — nothing that cannot go red belongs in a gate
# list. `demo:setup` is the one task CI runs outside `tasks:`, from the job's own
# "Set up demo" step.
#
# THE HUMAN-READABLE HALF. `--write` regenerates a "Which of these run in CI"
# table inside the CI-TASKS markers in each demo's README — where the operator
# reading `rake check:foo` actually is, rather than in a workflow file they will
# never open. Without `--write` the same table is CHECKED, so an edit to ci.yml
# that does not refresh the READMEs fails here rather than rotting.
#
# AND IS IT DOCUMENTED? The generated table says whether CI runs a task; the
# README's own hand-written list says what the task PROVES, which cannot be
# generated. So this also asserts that every defined task is NAMED somewhere in
# its README outside the generated block — presence only, never the prose, and
# blind to which shape the demo documents tasks in. Same for every verb a demo
# registers: an assistant-callable verb its README never mentions fails here.
#
# THE PARSER'S OWN GUARD. The task inventory is derived statically (stdlib only,
# no bundle, ~0.1 s on a bare checkout). A static parser can go blind to a task
# defined in a shape it does not recognise, which fails OPEN — the exact failure
# mode this check exists to prevent. So `--verify-inventory <dir>` re-derives the
# same inventory from `bin/rails -AT` (Rake's own task table) and asserts the two
# agree. The demos job runs it for its own demo, where the bundle is already
# installed and it costs ~0.3 s.
#
# Usage:
#   bin/check-ci-tasks                        # check everything (no bundle needed)
#   bin/check-ci-tasks --write                # refresh the README tables
#   bin/check-ci-tasks --verify-inventory DIR # static inventory == `rails -AT`

require "yaml"
require "set"
require "shellwords"

# ── An argument this script does not implement is REFUSED, not ignored ───────
#
# K-1462: until this block existed the script ACCEPTED `--self-test`, ignored
# it, ran its ordinary check and exited 0 printing its ordinary success line —
# so a session could type the flag, read a green exit code and honestly record a
# self-test that never ran. That is the constitution's false-clean shape: the
# output is the answer to a different question from the one that was asked, and
# the exit code cannot say so. Whether this script SHOULD have a self-test is a
# separate judgement about what its subject is worth; what is settled is that
# the flag may never read as a pass. Refusing every argument it does not
# implement closes the class rather than the one flag, so a mistyped real flag
# is refused too.
#
# The runtime message names the mode `self-test` WITHOUT its two leading dashes
# on purpose. The tooling that watches these guards decides whether a script HAS
# that mode by looking for the literal flag outside a whole-line comment, and a
# script it reads as HAVING one is then required to exit 0 on it — which is the
# opposite of what this block is for. The unrecognised arguments are echoed
# back, so a reader who passed the flag still sees it named.
#
# `--verify-inventory` takes a demo directory, so its VALUE is consumed here and
# whatever it is left to the mode itself to judge — this block decides which
# FLAGS exist, never whether their arguments are good.
KNOWN_FLAGS      = ["--write"].freeze
KNOWN_VALUE_FLAGS = ["--verify-inventory"].freeze
unknown_args = []
remaining    = ARGV.dup
until remaining.empty?
  arg = remaining.shift
  if KNOWN_FLAGS.include?(arg)      then next
  elsif KNOWN_VALUE_FLAGS.include?(arg) then remaining.shift
  else unknown_args << arg
  end
end
unless unknown_args.empty?
  warn "check-ci-tasks: unrecognised argument(s): #{unknown_args.join(' ')}"
  warn "It takes #{(KNOWN_FLAGS + KNOWN_VALUE_FLAGS).join(', ')} and nothing else. In particular " \
       "it has no self-test mode, so that flag is refused here rather than silently performing " \
       "the ordinary check — an argument that does nothing must never exit 0."
  exit 2
end

ROOT     = File.expand_path("..", __dir__)
WORKFLOW = File.join(ROOT, ".github", "workflows", "ci.yml")
BEGIN_MARK = "<!-- CI-TASKS:BEGIN — generated by bin/check-ci-tasks --write; do not edit by hand -->"
END_MARK   = "<!-- CI-TASKS:END -->"

errors = []

# ── Static task inventory ────────────────────────────────────────────────────
#
# Every demo's tasks live in `lib/tasks/*.rake` as `task :name` / `task name: …`
# lines indented inside a column-0 `namespace :check do` or `namespace :demo do`
# block. Anything outside that shape (a nested namespace, a third namespace) is
# a HARD ERROR rather than a silent skip — see the parser guard note in the
# header.
NAMESPACES = %w[check demo].freeze
def demo_tasks(dir)
  names = []
  Dir[File.join(dir, "lib", "tasks", "*.rake")].sort.each do |file|
    namespace = nil
    File.readlines(file).each_with_index do |line, i|
      where = "#{file}:#{i + 1}"
      if (m = line.match(/^namespace\s+:(\w+)\s+do/))
        abort "#{where}: namespace :#{m[1]} — bin/check-ci-tasks understands only " \
              "#{NAMESPACES.map { |n| "`namespace :#{n}`" }.join(' and ')}" unless NAMESPACES.include?(m[1])

        namespace = m[1]
        next
      end
      abort "#{where}: nested namespace — bin/check-ci-tasks does not understand it" if line.match?(/^\s+namespace\s+:/)

      namespace = nil if line.start_with?("end")
      next unless namespace
      # `task :name`, `task name: :prereq`, `task "name"`, `task "name" => :prereq`.
      next unless (m = line.match(/^  task[\s(]+(?::(\w+)|(\w+):|["'](\w+)["'])/))

      names << "#{namespace}:#{m[1] || m[2] || m[3]}"
    end
  end
  names
end

# ── Static VERB inventory (K-987) ────────────────────────────────────────────
#
# Same disease as the task list above, one shelf over: getgrocery's README opened
# by naming three queries and three actions where the demo registers four and
# four, so `kyc_status` — the verb an assistant must poll to clear the alcohol
# gate — was undocumented in the demo's own README while `check:agecheck`
# asserted it. Nothing joined the prose to the registrations, so it rotted the
# moment a verb was added.
#
# A verb is `kind :query` / `kind :action` in `app/controllers/kiosk/*.rb`,
# followed by the `def <name>` the declaration decorates. A `kind` with no
# method after it is a HARD ERROR rather than a silent skip, for the same reason
# an unknown namespace shape is: a parser that fails open is worse than none.
def demo_verbs(dir)
  names = []
  Dir[File.join(dir, "app", "controllers", "kiosk", "*.rb")].sort.each do |file|
    lines = File.readlines(file, chomp: true)
    lines.each_with_index do |line, i|
      next unless line.match?(/^\s*kind :(?:query|action)\s*$/)

      method = lines[(i + 1)..].find { |l| l.match?(/^\s*def \w+/) }
      abort "#{file}:#{i + 1}: `kind` with no `def` after it — bin/check-ci-tasks cannot name this verb" if method.nil?

      names << method[/^\s*def (\w+)/, 1]
    end
  end
  names
end

# ── The workflow's own view ──────────────────────────────────────────────────
workflow = YAML.load_file(WORKFLOW)
entries  = workflow.dig("jobs", "demos", "strategy", "matrix", "include") or
  abort "check-ci-tasks: no jobs.demos.strategy.matrix.include in #{WORKFLOW}"

matrix = entries.to_h do |e|
  [e.fetch("demo"), { tasks: e.fetch("tasks").split, ungated: e["ungated"] || {} }]
end

on_disk = Dir[File.join(ROOT, "kiosk-demo-*")].select { |d| File.directory?(d) }.map { |d| File.basename(d) }.sort
(on_disk - matrix.keys).each { |d| errors << "#{d}: no entry in ci.yml's demos matrix — CI runs none of its tasks" }
(matrix.keys - on_disk).each { |d| errors << "ci.yml names demo #{d}, which is not a directory in this repo" }

# ── The one comparison this whole file exists for ────────────────────────────
tables = {}
defined_by_demo = {}
(matrix.keys & on_disk).sort.each do |demo|
  defined_tasks = demo_tasks(File.join(ROOT, demo))
  defined_by_demo[demo] = defined_tasks
  errors << "#{demo}: no check:/demo: tasks found in lib/tasks/*.rake" if defined_tasks.empty?

  ci      = matrix[demo][:tasks]
  ungated = matrix[demo][:ungated]
  # demo:setup is not in `tasks:` — the job's own "Set up demo" step runs it.
  gated   = Set.new(ci) << "demo:setup"

  ci.grep(/\Ademo:/) do |t|
    errors << "#{demo}: ci.yml runs `#{t}` as a gate, but a `demo:` task is one a person runs and " \
              "reads — it asserts nothing and cannot go red. Move it to `check:` or drop it from `tasks:`"
  end
  (defined_tasks.grep(/\Acheck:/) - gated.to_a - ungated.keys).each do |t|
    errors << "#{demo}: `#{t}` is defined but neither run in CI nor listed in the matrix entry's " \
              "`ungated:` map with a reason (ci.yml)"
  end
  (ci - defined_tasks).each { |t| errors << "#{demo}: ci.yml runs `#{t}`, which the demo does not define" }
  ungated.each do |t, reason|
    errors << "#{demo}: stale `ungated:` entry `#{t}` — the demo no longer defines it" unless defined_tasks.include?(t)
    errors << "#{demo}: `#{t}` is both run in CI and listed as ungated" if gated.include?(t)
    errors << "#{demo}: `ungated:` entry `#{t}` carries no reason" if reason.to_s.strip.empty?
  end

  rows = defined_tasks.map do |t|
    if t == "demo:setup"
      ["`#{t}`", "yes — the job's own setup step", ""]
    elsif t.start_with?("demo:")
      ["`#{t}`", "no", "not a gate — a person runs it and reads the output"]
    elsif gated.include?(t)
      ["`#{t}`", "yes", ""]
    else
      ["`#{t}`", "no", ungated[t].to_s.strip.gsub(/\s+/, " ")]
    end
  end
  tables[demo] = <<~MD.rstrip
    #{BEGIN_MARK}
    ### Which of these run in CI

    A `check:` task asserts and goes red; a `demo:` task is one a person runs and
    reads. `.github/workflows/ci.yml` runs the tasks marked **yes** on every push
    and pull request; the rest are local-only, for the reason given. This table is
    generated from the workflow by `bin/check-ci-tasks`, which fails the build when
    the workflow, this table and `lib/tasks/demo.rake` disagree — so a task that
    carries assertions cannot go ungated and unexplained.

    | Task | Runs in CI | Why not |
    |---|---|---|
    #{rows.map { |r| "| #{r.join(' | ')} |" }.join("\n")}
    #{END_MARK}
  MD
end

# ── The human-readable half ──────────────────────────────────────────────────
write = ARGV.include?("--write")
tables.each do |demo, table|
  path = File.join(ROOT, demo, "README.md")
  body = File.read(path)
  unless body.include?(BEGIN_MARK) && body.include?(END_MARK)
    errors << "#{demo}/README.md: no CI-TASKS block — add the marker pair where the task list is:\n" \
              "  #{BEGIN_MARK}\n  #{END_MARK}"
    next
  end
  current = body[/#{Regexp.escape(BEGIN_MARK)}.*?#{Regexp.escape(END_MARK)}/m]

  # ── Is the task DOCUMENTED at all? (K-621) ────────────────────────────────
  #
  # The generated table above answers "does CI run it". Every demo README also
  # carries a HAND-WRITTEN list answering the other half — what the task proves
  # — and that half cannot be generated, because only a human knows it. But the
  # hand list drifted: four demos had grown tasks nobody added to it, and once
  # the generated table landed directly beneath, each README visibly
  # contradicted itself (`check:rls | yes` in the table, no check:rls at all in
  # the prose above it, and no way for a reader to tell which is authoritative).
  #
  # So assert PRESENCE only, never the prose: every task the demo defines must
  # be named somewhere in its README outside the generated block. That is the
  # weakest check that makes "a task shipped undocumented" impossible, and it is
  # shape-agnostic on purpose — the eight READMEs document tasks as a markdown
  # table, an annotated `sh` block, or a `### heading (rake demo:x)` per task,
  # and all three shapes are fine. Abbreviated forms (`:walkthrough` after a
  # spelled-out `demo:setup`) do NOT count: a reader searching for the task name
  # must find it.
  prose = current ? body.sub(current, "") : body
  (defined_by_demo[demo] - ["demo:setup"]).each do |t|
    next if prose.match?(/#{Regexp.escape(t)}(?![\w])/)

    errors << "#{demo}/README.md: `#{t}` is defined in lib/tasks/*.rake but never named in the README " \
              "outside the generated CI-TASKS table — say what it proves in the hand-written task list"
  end

  # ── And is the VERB documented at all? (K-987) ────────────────────────────
  #
  # The same presence-only rule for the other inventory a demo README claims to
  # describe. getgrocery's opening sentence named three queries and three
  # actions against four and four; `kyc_status` appeared nowhere in the file.
  # Presence only, never the prose: a reader searching the README for a verb an
  # assistant can call must find it somewhere.
  demo_verbs(File.join(ROOT, demo)).each do |v|
    next if body.match?(/(?<![\w])#{Regexp.escape(v)}(?![\w])/)

    errors << "#{demo}/README.md: the verb `#{v}` is registered in app/controllers/kiosk/ but is never " \
              "named in the README — an assistant-callable verb the demo's own README does not mention"
  end

  next if current == table

  if write
    File.write(path, body.sub(current, table))
    warn "updated #{demo}/README.md"
  else
    errors << "#{demo}/README.md: the CI-TASKS table is stale — run `bin/check-ci-tasks --write`"
  end
end

# ── Parser guard: static inventory vs Rake's own table ───────────────────────
if (i = ARGV.index("--verify-inventory"))
  dir = ARGV[i + 1] or abort "check-ci-tasks: --verify-inventory needs a demo directory"
  demo = File.basename(dir.chomp("/"))
  static = demo_tasks(File.join(ROOT, demo)).sort
  # -A lists tasks with no `desc` too; a task hidden from `-T` is still a task.
  actual = `cd #{File.join(ROOT, demo).shellescape} && bin/rails -AT 2>/dev/null`
           .lines.filter_map { |l| l[/^\S+\s+((?:check|demo):\S+)/, 1] }.uniq.sort
  abort "check-ci-tasks: `bin/rails -AT` listed no check:/demo: tasks in #{demo} (bundle installed?)" if actual.empty?
  if static != actual
    errors << "#{demo}: the static task inventory disagrees with `bin/rails -AT` — " \
              "bin/check-ci-tasks parses lib/tasks/*.rake and missed a task shape.\n" \
              "  parsed:      #{static.join(' ')}\n  rake says:   #{actual.join(' ')}"
  end
end

if errors.empty?
  puts "check-ci-tasks: OK — every check: task is either run by CI or opted out with a reason, and every registered verb is named in its README" unless write
  exit 0
end

warn "\ncheck-ci-tasks FAILED:\n"
errors.each { |e| warn "  ✗ #{e}" }
warn "\nEvery `check:` task must be either in its matrix `tasks:` list in " \
     ".github/workflows/ci.yml or in that entry's `ungated:` map with the reason it is not a gate."
exit 1
