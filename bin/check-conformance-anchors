#!/usr/bin/env ruby
# frozen_string_literal: true

# check-conformance-anchors — the published conformance matrix cites this repo's
# tests by NAME, and this asserts every one of those names still exists here.
#
# WHY THIS EXISTS. The Kiosk conformance matrix maps each normative statement of
# the protocol to the test that covers it, and it names a test by the text of its
# `it` / `describe` / `context` label rather than by a line number — a line number
# rots on any insertion above it, silently, and a reader who follows one lands on
# an unrelated example and believes it. An anchor cannot rot that way. It fails
# only when the cited text is genuinely RENAMED, DELETED or DUPLICATED, which is
# exactly the event worth failing on.
#
# But it fails over THERE, in the matrix, and this repository is where the rename
# happens. So the anchors are published here as `spec/conformance-anchors.tsv`
# (path + anchor, nothing else) and gated on every push: renaming an example that
# is cited as evidence reddens the build that renamed it, in the same run,
# instead of quietly invalidating a citation nobody re-reads.
#
# THE RULE. Every anchor in the manifest must occur EXACTLY ONCE in the file
# beside it. Not "at least once": a copy-pasted example makes a citation
# ambiguous, and an ambiguous citation is a defect — a reader cannot tell which
# of two examples was meant.
#
# WHAT IT DELIBERATELY DOES NOT ASK is whether the example still ASSERTS the
# statement that cites it. An anchored test can be rewritten line by line, keep
# its label, and pass here forever. Whether the anchored CODE has moved is the
# sibling question, and `bin/check-conformance-drift` answers it — as a triage
# list for the next conformance sweep, not as a gate, for the reason its own
# header gives. Neither script judges the assertion; that is what a sweep is for.
#
# WHEN IT FAILS you have two honest repairs, and which one is right depends on
# what you were doing:
#   * the rename was incidental — put the label back, or
#   * the rename was the point — the citation that names it is updated where
#     the matrices live, and the manifest is re-exported from there.
# The manifest is GENERATED, and NOT by any command in this repository: there is
# nothing here to run after a hand-edit, so hand-editing it to make this pass
# only moves the failure to whoever re-exports it next — and leaves nothing on
# this side able to tell them.
#
# Usage: bin/check-conformance-anchors     # exits 0 clean, 1 on any mismatch

# ── An argument this script does not implement is REFUSED, not ignored ───────
#
# K-1462: until this block existed the script ACCEPTED `--self-test`, ignored
# it, ran its ordinary check and exited 0 printing its ordinary success line —
# so a session could type the flag, read a green exit code and honestly record a
# self-test that never ran. That is the constitution's false-clean shape: the
# output is the answer to a different question from the one that was asked, and
# the exit code cannot say so. Whether this script SHOULD have a self-test is a
# separate judgement about what its subject is worth; what is settled is that
# the flag may never read as a pass. Refusing every argument it does not
# implement closes the class rather than the one flag, so a mistyped real flag
# is refused too.
#
# The runtime message names the mode `self-test` WITHOUT its two leading dashes
# on purpose. The tooling that watches these guards decides whether a script HAS
# that mode by looking for the literal flag outside a whole-line comment, and a
# script it reads as HAVING one is then required to exit 0 on it — which is the
# opposite of what this block is for. The unrecognised arguments are echoed
# back, so a reader who passed the flag still sees it named.
KNOWN_ARGS = [].freeze
unless (unknown_args = ARGV - KNOWN_ARGS).empty?
  warn "check-conformance-anchors: unrecognised argument(s): #{unknown_args.join(' ')}"
  warn "It takes no arguments at all. In particular it has no self-test mode, so that flag is " \
       "refused here rather than silently performing the ordinary check — an argument that " \
       "does nothing must never exit 0."
  exit 2
end

ROOT     = File.expand_path("..", __dir__)
MANIFEST = File.join(ROOT, "spec", "conformance-anchors.tsv")

unless File.file?(MANIFEST)
  warn "check-conformance-anchors: missing #{MANIFEST}"
  exit 1
end

pairs = File.readlines(MANIFEST, chomp: true).filter_map do |line|
  next if line.start_with?("#") || line.strip.empty?

  rel, anchor = line.split("\t", 2)
  next if rel.nil? || anchor.nil? || anchor.empty?

  [rel, anchor]
end

if pairs.empty?
  warn "check-conformance-anchors: #{MANIFEST} lists no anchors — a manifest that checks nothing " \
       "reports success for checking nothing, which is the failure this file exists to prevent"
  exit 1
end

cache    = {}
failures = []

pairs.each do |rel, anchor|
  body = cache.fetch(rel) do
    path = File.join(ROOT, rel)
    cache[rel] = File.file?(path) ? File.readlines(path, chomp: true) : nil
  end

  if body.nil?
    failures << "#{rel}: no such file — the conformance matrix cites it"
    next
  end

  hits = body.each_index.select { |i| body[i].include?(anchor) }
  case hits.length
  when 1 then nil
  when 0 then failures << "#{rel}: anchor NOT FOUND — #{anchor.inspect}"
  else
    failures << "#{rel}: anchor is AMBIGUOUS (#{hits.length} matches, lines " \
                "#{hits.map { |i| i + 1 }.join(', ')}) — #{anchor.inspect}"
  end
end

if failures.empty?
  puts "check-conformance-anchors: OK — #{pairs.length} cited anchors across #{cache.size} files, " \
       "each occurring exactly once"
  exit 0
end

warn "\ncheck-conformance-anchors FAILED:\n"
failures.each { |f| warn "  x #{f}" }
warn "\nAn example cited as conformance evidence was renamed, removed or duplicated."
warn "Restore the label, or update the citation and regenerate spec/conformance-anchors.tsv."
exit 1
