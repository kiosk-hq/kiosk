# A unit is every `def` of a name or assignment to a constant, grown line by line until Ripper parses it.
FRAGMENT_START = /\A\s*(?:def\s+(?:self\.)?([a-z_][A-Za-z0-9_]*[?!=]?)|([A-Z][A-Za-z0-9_]*)\s*=[^=~>])/
FRAGMENT_MAX_LINES = 200

# Second handle: every bare method call or `self.x =` in a class or module body, by its head.
def class_macro_starts(node, out = [])
  return out unless node.is_a?(Array)

  if %i[class module].include?(node[0])
    class_body_statements(node).each { |stmt| class_body_macro(stmt, out) }
  else
    node.each { |child| class_macro_starts(child, out) if child.is_a?(Array) }
  end
  out
end

def class_body_statements(node)
  body = node.last
  body.is_a?(Array) && body[0] == :bodystmt ? (body[1] || []) : []
end

# Records the `[line index, name]` a class-body statement starts, then walks into it.
def class_body_macro(stmt, out)
  return unless stmt.is_a?(Array)

  head = macro_head(stmt)
  out << [head[2][0] - 1, head[1]] if head.is_a?(Array) && head[0] == :@ident
  target = self_assign_target(stmt)
  out << [target[2][0] - 1, "self.#{target[1]}"] if target
  class_macro_starts(stmt, out)
end

def macro_head(stmt)
  case stmt[0]
  when :command          then stmt[1]
  when :method_add_arg   then sexp_child(stmt[1], :fcall)
  when :method_add_block then sexp_child(stmt[1], :command)
  end
end

# The first child of `node` when it is a `type` node, or nil.
def sexp_child(node, type) = node.is_a?(Array) && node[0] == type ? node[1] : nil

# The identifier assigned in a `self.x = …` statement, or nil.
def self_assign_target(stmt)
  return unless stmt[0] == :assign

  field = stmt[1]
  return unless field.is_a?(Array) && field[0] == :field && self_ref?(field[1])

  field.last if field.last.is_a?(Array) && field.last[0] == :@ident
end

def self_ref?(node)
  node.is_a?(Array) && node[0] == :var_ref && node[1].is_a?(Array) && node[1][1] == 'self'
end

# => [line index => unit name, class-macro names, whether the file fails to parse]
def fragment_starts(src)
  sexp  = Ripper.sexp(src)
  macro = sexp ? class_macro_starts(sexp).to_h : {}
  defs  = definition_starts(src)
  [macro.merge(defs), macro.except(*defs.keys).values.uniq, sexp.nil?]
end

def definition_starts(src)
  src.lines.each_with_index.filter_map do |line, i|
    m = line.match(FRAGMENT_START)
    [i, m[1] || m[2]] if m
  end.to_h
end

# => [units, unreadable, dsl_names]
def fragment_units(path)
  src = File.read(path)
  starts, dsl_names, unparsable = fragment_starts(src)
  unreadable = unparsable ? ['the file itself'] : []
  [collect_units(src.lines, starts, unreadable), unreadable, dsl_names]
end

# Unit name => its source; a start that never parses goes to `unreadable`.
def collect_units(lines, starts, unreadable)
  units = Hash.new { |h, k| h[k] = +'' }
  starts.keys.sort.each do |i|
    unit = parsable_unit(lines, i)
    unit ? units[starts[i]] << unit : unreadable << "#{starts[i]} (line #{i + 1})"
  end
  units.to_h
end

# The shortest run of lines from index `start` that parses, within FRAGMENT_MAX_LINES.
def parsable_unit(lines, start)
  (start...[start + FRAGMENT_MAX_LINES, lines.size].min).lazy
                                                        .map { |j| lines[start..j].join }
                                                        .find { |cand| !Ripper.sexp(cand).nil? }
end

per_demo_paths = COPIES.select { |_rel, e| e[:rule] == :per_demo }.keys
(per_demo_paths - FRAGMENT_PATHS - FRAGMENT_EXCLUDED.keys).sort.each do |rel|
  errors << "#{rel}: declared `:per_demo` in COPIES but named neither in FRAGMENT_PATHS nor in FRAGMENT_EXCLUDED."
end
FRAGMENT_EXCLUDED.each do |rel, why|
  errors << "#{rel}: FRAGMENT_EXCLUDED entry carries no reason." if why.to_s.strip.empty?
  if FRAGMENT_PATHS.include?(rel)
    errors << "#{rel}: named in both FRAGMENT_PATHS and FRAGMENT_EXCLUDED."
  elsif COPIES[rel].nil?
    errors << "#{rel}: in FRAGMENT_EXCLUDED but COPIES has no entry for it."
  elsif COPIES[rel][:rule] != :per_demo
    errors << "#{rel}: in FRAGMENT_EXCLUDED but COPIES compares it whole; drop the entry."
  end
end

fragment_dsl_ids = {}
fragment_sources = Hash.new { |h, k| h[k] = {} } # "path#unit" => demo => normalised source
FRAGMENT_PATHS.each do |rel|
  entry = COPIES[rel]
  if entry.nil? || entry[:rule] != :per_demo
    errors << "check-demo-copies: FRAGMENT_PATHS names #{rel}, which is not a `:per_demo` COPIES entry."
    next
  end

  demos.each do |dir|
    demo = short.call(File.basename(dir))
    path = File.join(dir, rel)
    next unless File.exist?(path)

    units, unreadable, dsl_names = fragment_units(path)
    dsl_names.each { |name| fragment_dsl_ids["#{rel}##{name}"] = true }
    unless unreadable.empty?
      errors << "#{demo}: #{rel} — could not read #{unreadable.join(', ')} back as valid Ruby within " \
                "#{FRAGMENT_MAX_LINES} lines. Fix the extraction."
    end
    units.each { |name, src| fragment_sources["#{rel}##{name}"][demo] = code_norm(src) }
  end
end

fragment_sources.each do |id, per_demo|
  next if per_demo.size < 2 || FRAGMENTS.key?(id)

  errors << "#{id}: shared by #{per_demo.keys.sort.join(', ')} inside a `:per_demo` file and undeclared. " \
            'Declare it in FRAGMENTS with its `ships:` set and reason.'
end

# Checks one FRAGMENTS entry; returns the copies its `ships:` set holds, or nil.
def fragment_held(id, entry, sources, errors)
  return unless fragment_path_listed?(id, errors)

  errors << "#{id}: FRAGMENTS `why:` is blank" if entry[:why].to_s.strip.empty?
  per_demo = sources[id]
  return rejected(errors, fragment_too_rare(id, per_demo)) if per_demo.size < 2

  check_fragment_ships(id, entry[:ships], per_demo.keys, errors)
  check_fragment_except(id, entry, per_demo, errors)
  per_demo.slice(*entry[:ships])
end

def fragment_path_listed?(id, errors)
  rel = id.split('#', 2).first
  return true if FRAGMENT_PATHS.include?(rel)

  errors << "#{id}: declared in FRAGMENTS, but #{rel} is not in FRAGMENT_PATHS."
  false
end

def rejected(errors, message)
  errors << message
  nil
end

def fragment_too_rare(id, per_demo)
  "#{id}: declared in FRAGMENTS, but it exists in " \
    "#{per_demo.empty? ? 'no demo' : "only #{per_demo.keys.first}"}. Drop it."
end

def check_fragment_ships(id, ships, defining, errors)
  rel, unit_name = id.split('#', 2)
  stray = defining.sort - ships
  gone  = ships - defining
  unless stray.empty?
    errors << "#{stray.join(', ')}: defines #{id} but #{stray.size == 1 ? 'is' : 'are'} not in its " \
              "`ships:` set (#{ships.join(', ')}). Add the demo, or rename the copy."
  end
  return if gone.empty?

  errors << "#{gone.join(', ')}: named in #{id}'s `ships:`, but #{rel} there defines no `#{unit_name}`. " \
            'Update the set, or restore the name.'
end

def check_fragment_except(id, entry, per_demo, errors)
  excepted = entry[:except] || {}
  excepted.each do |demo, reason|
    errors << "#{id}: `except:` reason for #{demo} is blank" if reason.to_s.strip.empty?
    errors.concat(except_membership_faults(id, demo, entry[:ships], per_demo))
  end
  errors << "#{id}: `except:` only means something on a `:code` entry." if excepted.any? && entry[:rule] != :code
end

def except_membership_faults(id, demo, ships, per_demo)
  faults = []
  faults << "#{id}: `except:` names #{demo}, which is not in `ships:`." unless ships.include?(demo)
  faults << "#{id}: stale `except:` for #{demo}, which defines no `#{id.split('#', 2).last}`." unless per_demo.key?(demo)
  faults
end

# Compares the held copies of a `:code` unit; returns how many excepted copies it reached.
def compare_code_fragment(id, excepted, held, errors)
  compared, excused = held.partition { |demo, _| !excepted.key?(demo) }.map(&:to_h)
  if compared.size < 2
    errors << "#{id}: every copy but one is excepted. Drop an exception or make the rule `:per_demo`."
    return 0
  end
  check_code_fragment_groups(id, compared, excused, errors)
  excused.size
end

def fragment_divergence(id, groups)
  listed = groups.values.map { |g| "[#{g.map { |d, _| d }.sort.join(',')}]" }.sort.join(' ')
  "#{id}: the copies must agree once comments and whitespace are normalised away, and they " \
    "do not: #{listed}. Propagate the edit, declare the difference in `except:`, or rename the copy."
end

def check_code_fragment_groups(id, compared, excused, errors)
  groups = compared.group_by { |_demo, src| src }
  return errors << fragment_divergence(id, groups) unless groups.size == 1

  excused.each do |demo, src|
    errors << "#{id}: `except:` for #{demo} is stale — its copy now agrees with the others. Drop it." if src == groups.keys.first
  end
end

fragment_comparisons     = 0
fragment_exceptions_live = 0
FRAGMENTS.each do |id, entry|
  held = fragment_held(id, entry, fragment_sources, errors)
  next if held.nil? || held.size < 2

  fragment_comparisons += held.size
  case entry[:rule]
  when :code then fragment_exceptions_live += compare_code_fragment(id, entry[:except] || {}, held, errors)
  when :per_demo then agree.check(id, 'unit', held, entry[:agree])
  else errors << "#{id}: unknown `rule: #{entry[:rule].inspect}`; FRAGMENTS takes :code or :per_demo."
  end
end

declared_exceptions = FRAGMENTS.sum { |_, e| (e[:except] || {}).size }
if declared_exceptions.positive? && fragment_exceptions_live.zero?
  errors << "check-demo-copies: FRAGMENTS declares #{declared_exceptions} `except:` " \
            "entr#{declared_exceptions == 1 ? 'y' : 'ies'} and NONE of them was reached."
end
errors << "check-demo-copies: the fragment rule declares #{FRAGMENTS.size} unit(s) and compared NONE of them." if FRAGMENTS.any? && fragment_comparisons.zero?

declared_agree_groups = COPIES.sum { |_, e| (e[:agree] || {}).size } + FRAGMENTS.sum { |_, e| (e[:agree] || {}).size }
if declared_agree_groups.positive? && agree.confirmed.zero?
  errors << "check-demo-copies: the manifest declares #{declared_agree_groups} `agree:` group(s) of " \
            'converged `:per_demo` copies and this run CONFIRMED none of them; the grouping pass stopped running.'
end

FRAGMENT_PATHS.each do |rel|
  next if fragment_sources.any? { |id, per_demo| id.start_with?("#{rel}#") && per_demo.size >= 2 }

  errors << "#{rel}: named in FRAGMENT_PATHS, and the extractor finds NO unit shared by two or more copies. " \
            'Move it to FRAGMENT_EXCLUDED, or fix the extractor.'
end

errors << 'check-demo-copies: the class-macro handle found NO class-body macro in any FRAGMENT_PATHS copy.' if fragment_dsl_ids.empty?

# ── Spec units: helpers in demo spec/ and test/ files are held by NAME across the whole corpus ──
DEMO_SPEC_SUBDIRS = %w[spec test].freeze

# :code — copies agree modulo comments; :per_file — same name, each file's own body.
SPEC_UNITS = {
  'ADDRESS' => { rule: :code, why: 'The served delivery address the getgrocery tests order to.' },
  'SHOP' => { rule: :code, why: "The shop's zone in the getgrocery clock tests." },
  'errors' => { rule: :per_file, why: "Each model test's shorthand for the full messages a model answers." },
  'include' => { rule: :per_file, why: "Each file's own mixins." },
  'place' => { rule: :per_file, why: 'Each getgrocery test places the order its own assertions need.' },
  'attr_reader' => { rule: :per_file, why: 'Each processor stub records what its own test reads back.' },
  'initialize' => { rule: :code, why: "The processor stubs' constructors." },
  'release!' => { rule: :code, why: "The payment-window stub's latch." },
  'setup_required?' => { rule: :code, why: 'The payment-window stubs answer that a card is on file.' },
  'eventually?' => { rule: :code, why: "The payment-window tests' bounded poll for a racing thread." },
  'capture' => { rule: :per_file, why: "Each stub's charge, and each test's capture of its own product." },
  'payment_state' => { rule: :per_file, why: "The protocol's payment state, read through each demo's own query." },
  'payment_status' => { rule: :per_file, why: "The stored payment status of each demo's own model." },
  'reserve' => { rule: :per_file, why: "Each demo's own reserve verb and arguments." },
  'reserves' => { rule: :per_file, why: "Each demo's customer reserves its own kind of thing." },
  'books' => { rule: :per_file, why: "Each demo's customer books through its own verb and arguments." },
  'bookings' => { rule: :per_file, why: "Each demo's customer reads its own bookings back." },
  'browses' => { rule: :per_file, why: "Each demo's customer browses its own public listing." },
  'pays_for' => { rule: :per_file, why: "Each demo signs its own action's cart under its own scope." },
  'kiosk_origin' => { rule: :code, why: "The conformance origin where a demo's tests drive its handlers." },
  'assert_kiosk_refused' => { rule: :per_file, why: "Each helper's refusal assertion." },
  'NOON_UTC' => { rule: :code, why: 'The instant two clock tests pin.' },
  'as' => { rule: :per_file, why: 'Each helper opens a session as a principal.' },
  'test' => { rule: :per_file, why: "Minitest's own declaration macro; each body is its own example." },
  'TOKYO' => { rule: :code, why: 'The far-side zone three clock specs hand in, to prove rendering on a zone other than the default.' },
  'MONTREAL' => { rule: :code, why: 'The other zone the same three clock specs pair with TOKYO.' }
}.freeze

# `git ls-files`, falling back to a walk in the self-test's non-git copy.
spec_pathspecs = DEMO_SPEC_SUBDIRS.map { |sub| "kiosk-demo-*/#{sub}/*" }
spec_ls, spec_git = Open3.capture2('git', '-C', ROOT, 'ls-files', '-z', *spec_pathspecs)
spec_corpus =
  if spec_git.success? && !spec_ls.strip.empty?
    spec_ls.split("\0").reject(&:empty?)
  else
    DEMO_SPEC_SUBDIRS.flat_map { |sub| Dir[File.join(ROOT, 'kiosk-demo-*', sub, '**', '*.rb')] }
                     .map { |abs| abs.delete_prefix("#{ROOT}/") }
  end.select { |rel| rel.end_with?('.rb') }.sort

spec_unit_sources = Hash.new { |h, k| h[k] = {} } # unit name => "demo/rel" => normalised body
spec_corpus.each do |rel|
  units, unreadable, = fragment_units(File.join(ROOT, rel))
  unless unreadable.empty?
    errors << "#{rel}: could not read #{unreadable.join(', ')} back as valid Ruby within " \
              "#{FRAGMENT_MAX_LINES} lines. Fix the extraction."
  end
  units.each { |name, src| spec_unit_sources[name][rel] = code_norm(src) }
end

# A name whose every copy FRAGMENTS already holds is delegated there.
spec_held_by_fragments = lambda do |name, rel|
  sub = rel.split('/', 2).last
  FRAGMENT_PATHS.include?(sub) && FRAGMENTS.key?("#{sub}##{name}")
end
spec_shared = spec_unit_sources.select { |_name, byfile| byfile.size >= 2 }
spec_delegated_names = spec_shared.select { |name, byfile| byfile.keys.all? { |rel| spec_held_by_fragments.call(name, rel) } }.keys
spec_owned = spec_shared.except(*spec_delegated_names)
spec_compared = 0

spec_owned.each do |name, byfile|
  next if SPEC_UNITS.key?(name)

  errors << "#{name}: defined in #{byfile.size} demo spec/test file(s) (#{byfile.keys.join(', ')}) and " \
            'declared NOWHERE. Declare it in SPEC_UNITS, or give the second copy its own name.'
end

SPEC_UNITS.each do |name, entry|
  errors << "SPEC_UNITS[#{name.inspect}]: `why:` is blank." if entry[:why].to_s.strip.empty?

  byfile = spec_owned[name]
  if byfile.nil?
    reason = if spec_delegated_names.include?(name)
               'FRAGMENTS already holds every copy'
             else
               "it is defined in #{spec_unit_sources[name].size} file(s)"
             end
    errors << "SPEC_UNITS[#{name.inspect}]: declared, but #{reason}. Drop the entry."
    next
  end

  spec_compared += byfile.size
  groups = byfile.group_by { |_rel, src| src }
  case entry[:rule]
  when :code
    next if groups.size == 1

    listed = groups.values.map { |g| "[#{g.map { |rel, _| rel }.sort.join(',')}]" }.sort.join(' ')
    errors << "#{name}: the demo spec copies must agree once comments and whitespace are normalised away, " \
              "and they do not: #{listed}. Propagate the edit, or rename the copy that differs."
  when :per_file
    next if groups.size > 1

    errors << "#{name}: declared `:per_file` and all #{byfile.size} copies now agree. Make it `:code`."
  else
    errors << "SPEC_UNITS[#{name.inspect}]: unknown `rule: #{entry[:rule].inspect}`; use :code or :per_file."
  end
end

spec_demo_count = spec_corpus.map { |rel| rel.split('/').first }.uniq.size
if spec_corpus.size < 2 || spec_demo_count < 2
  errors << "check-demo-copies: the demo-spec rule read #{spec_corpus.size} Ruby file(s) across " \
            "#{spec_demo_count} demo(s) under kiosk-demo-*/{#{DEMO_SPEC_SUBDIRS.join(',')}}."
end
errors << "check-demo-copies: the demo-spec rule extracted NO unit from #{spec_corpus.size} file(s)." if spec_unit_sources.empty?
errors << "check-demo-copies: SPEC_UNITS declares #{SPEC_UNITS.size} unit(s) and this run compared NONE of them." if SPEC_UNITS.any? && spec_compared.zero?

# ── Shared spec paths: a spec path two demos share must be in EXTRA_SCANNED ──
spec_by_relpath   = spec_corpus.group_by { |rel| rel.split('/', 2).last }
spec_shared_paths = spec_by_relpath.select { |_sub, group| group.size >= 2 }
spec_shared_paths.keys.sort.each do |sub|
  next if EXTRA_SCANNED.include?(sub) || SCAN_ROOTS.any? { |root| sub.start_with?("#{root}/") }

  errors << "#{sub}: #{spec_shared_paths[sub].size} demos ship a file at this SAME relative path " \
            "(#{spec_shared_paths[sub].sort.join(', ')}). Add it to EXTRA_SCANNED and give it a COPIES entry."
end

spec_malformed_keys = spec_by_relpath.keys.reject { |sub| DEMO_SPEC_SUBDIRS.any? { |dir| sub.start_with?("#{dir}/") } }
if spec_malformed_keys.any?
  errors << "check-demo-copies: the shared-spec-path rule grouped #{spec_by_relpath.size} key(s) and " \
            "#{spec_malformed_keys.size} of them are not a path under kiosk-demo-*/{#{DEMO_SPEC_SUBDIRS.join(',')}}."
end

# ── Lockfile platforms: every demo's Gemfile.lock lists the same PLATFORMS ──
lockfile_platforms = demos.filter_map do |dir|
  path = File.join(dir, 'Gemfile.lock')
  next unless File.exist?(path)

  section = File.read(path)[/^PLATFORMS\n(.*?)(?:\n\n|\z)/m, 1]
  [File.basename(dir), section.to_s.split("\n").map(&:strip).reject(&:empty?).sort]
end.to_h

if lockfile_platforms.size < 2
  errors << "check-demo-copies: the lockfile-platforms rule compared #{lockfile_platforms.size} lockfile(s)."
else
  majority = lockfile_platforms.values.tally.max_by { |_, n| n }.first
  lockfile_platforms.each do |demo, platforms|
    next if platforms == majority

    missing = majority - platforms
    extra   = platforms - majority
    detail  = []
    detail << "missing #{missing.join(', ')}" unless missing.empty?
    detail << "declares #{extra.join(', ')}, which no sibling does" unless extra.empty?
    errors << "#{short.call(demo)}: Gemfile.lock PLATFORMS differs from the other demos — #{detail.join('; ')}. " \
              "Fix with `bundle lock --add-platform #{missing.join(' ')}` in #{demo}."
  end
end

# ── Framework patch: no initializer (demo or e2e) patches a Rails framework class ──
RAILS_FRAMEWORK_NAMESPACES = %w[
  ActiveRecord ActiveModel ActiveSupport ActiveJob ActiveStorage
  ActionController ActionDispatch ActionView ActionMailer ActionCable
  Rails
].freeze

FRAMEWORK_PATCH = /
  ^[ \t]*
  (?<constant>(?:#{RAILS_FRAMEWORK_NAMESPACES.join('|')})(?:::[A-Za-z0-9_]+)*)
  \s*\.\s*
  (?<verb>include|prepend|extend|class_eval|module_eval|define_method|alias_method|remove_method)
  \b
/x

scan_initializer = lambda do |label:, rel:, path:|
  File.read(path).each_line.with_index(1) do |line, lineno|
    next if line.lstrip.start_with?('#')

    m = FRAMEWORK_PATCH.match(line) or next
    errors << "#{label}: #{rel}:#{lineno} calls #{m[:constant]}.#{m[:verb]}. An application must not patch a " \
              'Rails class from its configuration; use a railtie in the owning gem, or a concern under app/.'
  end
end

initializer_demos = 0
operator_demos.each do |demo|
  paths = Dir[File.join(ROOT, demo, 'config/initializers', '*.rb')]
  if paths.empty?
    errors << "#{short.call(demo)}: ships no config/initializers/*.rb at all."
    next
  end
  initializer_demos += 1
  paths.each { |path| scan_initializer.call(label: short.call(demo), rel: path.delete_prefix("#{File.join(ROOT, demo)}/"), path: path) }
end
errors << 'check-demo-copies: the framework-patch rule scanned NO initializers.' if initializer_demos.zero?

E2E_RUN_SH           = 'e2e/run.sh'
E2E_INITIALIZER_COPY = %r{^\s*cp\s+"\$FIXTURES/(?<fixture>[^"]+)"\s+config/initializers/}
run_sh               = File.join(ROOT, E2E_RUN_SH)

if File.exist?(run_sh)
  fixtures = File.read(run_sh).scan(E2E_INITIALIZER_COPY).flatten.uniq
  errors << "check-demo-copies: #{E2E_RUN_SH} copies no fixture into config/initializers/." if fixtures.empty?
  fixtures.each do |fixture|
    rel = "e2e/fixtures/#{fixture}"
    if File.exist?(File.join(ROOT, rel))
      scan_initializer.call(label: 'e2e', rel: rel, path: File.join(ROOT, rel))
    else
      errors << "check-demo-copies: #{E2E_RUN_SH} copies #{rel}, which does not exist."
    end
  end
else
  errors << "check-demo-copies: #{E2E_RUN_SH} does not exist."
end

# ── Driver env: demo scripts and each demo's red-team suite fetch these names with NO default ──
DRIVER_NO_DEFAULT_VARS = {
  'SERVER_URL' => 'the origin every request in the file is sent to'
}.freeze
DRIVER_ENV_FETCH = /\A[^#]*\bENV\.fetch\(\s*['"](?<var>[A-Z0-9_]+)['"](?<comma>\s*,)?/
driver_env_held    = DRIVER_NO_DEFAULT_VARS.keys.to_h { |var| [var, 0] }
driver_env_scripts = 0

operator_demos.each do |demo|
  suite = File.join(ROOT, 'kiosk-redteam', 'suites', "#{short.call(demo)}.rb")
  (Dir[File.join(ROOT, demo, 'script', '*.rb')] + Dir[suite]).each do |path|
    rel = path.delete_prefix("#{File.join(ROOT, demo)}/").delete_prefix("#{ROOT}/")
    driver_env_scripts += 1
    File.read(path).each_line.with_index(1) do |line, lineno|
      next if line.lstrip.start_with?('#')

      m = DRIVER_ENV_FETCH.match(line)
      next if m.nil? || !DRIVER_NO_DEFAULT_VARS.key?(m[:var])

      if m[:comma].nil?
        driver_env_held[m[:var]] += 1
      else
        errors << "#{short.call(demo)}: #{rel}:#{lineno} fetches #{m[:var]} WITH a default. It is " \
                  "#{DRIVER_NO_DEFAULT_VARS.fetch(m[:var])}, so a default drives whatever listens there; " \
                  "spell it `ENV.fetch('#{m[:var]}')`."
      end
    end
  end
end

driver_env_held.each do |var, held|
  next unless held.zero?

  errors << "check-demo-copies: the driver-env rule found NO no-default fetch of #{var} in " \
            "#{driver_env_scripts} demo script(s)."
end

# ── E2E fixtures: each is paired with the demo path run.sh installs it at, and compared ──
E2E_FIXTURES_DIR = 'e2e/fixtures'
E2E_FIXTURE_CP   = %r{^\s*cp\s+"\$FIXTURES/(?<fixture>[^"]+)"\s+(?:"(?<quoted>[^"]+)"|(?<bare>\S+))}

# { fixture basename => demo-relative destination }, a `${ts}` timestamp becoming `*`.
def e2e_installed_paths(run_sh_src)
  run_sh_src.gsub(/\\\n\s*/, ' ').each_line.with_object({}) do |line, out|
    m = E2E_FIXTURE_CP.match(line) or next

    out[m[:fixture]] = (m[:quoted] || m[:bare]).gsub(/\$\{[^}]+\}/, '*')
  end
end

