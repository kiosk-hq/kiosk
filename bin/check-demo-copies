      ops:  [[:edit, "bin/check-demo-copies", 'wire_read   = corpus.count { |_, d| d.key?("config/routes/kiosk.rb") }',
              'wire_read   = corpus.count { |_, d| d.key?("config/routes/kiosk-gone.rb") }']],
      expect: /the K-1069 corpus read 0 config\/routes\/kiosk\.rb/ },

    { id: "vacuity-bin-ref-pattern", kind: :vacuity,
      rule: "Every `bin/` script a demo names EXISTS and is runnable (K-1315)",
      what: "BIN_REF_RE stops matching, so no README or script is read as naming a bin/ script and " \
            "the whole exists-and-is-runnable rule resolves nothing",
      ops:  [[:edit, "bin/check-demo-copies", "(?:\\./)?bin/([a-z0-9_][a-z0-9_-]*)", "(?:\\./)?bin-gone/([a-z0-9_][a-z0-9_-]*)"]],
      expect: /resolved NO reference to a demo's own bin\/ script/ },
  ].freeze

  # ── coverage, derived from this file's own banners ────────────────────────
  st_banners    = File.readlines(__FILE__).filter_map { |l| l[/\A# ── (.+?)\s*─*\s*\z/, 1] }
  st_invariants = st_banners - SELF_TEST_NOT_A_RULE
  st_aimed      = SELF_TEST_PLANTS.map { |p| p[:rule] }.uniq
  st_orphans    = st_aimed - st_invariants - SELF_TEST_UNBANNERED
  st_uncovered  = st_invariants - st_aimed

  st_bad   = []
  st_notes = []

  # ── T-155: every section with an in-band vacuity guard carries an arm ──────
  st_src      = File.readlines(__FILE__, chomp: true)
  st_section  = "(preamble)"
  st_guarded  = []
  st_src.each_with_index do |line, i|
    if (b = line[/\A# ── (.+?)\s*─*\s*\z/, 1])
      st_section = b
      next
    end
    next unless line =~ /(errors|failures)\s*<</
    next unless st_src[i, 10].join(" ").match?(SELF_TEST_VACUITY_VOCAB)

    st_guarded << st_section
  end
  st_guarded  = (st_guarded.uniq & st_invariants)
  st_v_armed  = SELF_TEST_PLANTS.select { |p| p[:kind] == :vacuity }.map { |p| p[:rule] }.uniq
  st_unproven = st_guarded - st_v_armed - SELF_TEST_VACUITY_PROXY_EXEMPT.keys

  unless st_unproven.empty?
    st_bad << "#{st_unproven.length} rule(s) raise an in-band vacuity guard and no `:vacuity` arm " \
              "proves it fires: #{st_unproven.map(&:inspect).join(', ')}. A guard that exists to " \
              "notice a rule being switched off, and is itself proven by nothing, is in exactly " \
              "the position of the thing it watches (T-155). Add an arm that switches that rule's " \
              "own MEASUREMENT off — never a violation count (K-1262)."
  end
  if st_guarded.length < SELF_TEST_VACUITY_FLOOR
    st_bad << "the in-band vacuity vocabulary reads #{st_guarded.length} guarded rule(s) where " \
              "#{SELF_TEST_VACUITY_FLOOR} were measured. Either a guard was deleted, or the " \
              "vocabulary stopped recognising one — and a proxy that matches nothing prints the " \
              "same clean coverage as a fully-armed file, which is the failure this whole check is."
  end
  if (stale = SELF_TEST_VACUITY_PROXY_EXEMPT.keys - st_guarded).any?
    st_bad << "SELF_TEST_VACUITY_PROXY_EXEMPT names #{stale.map(&:inspect).join(', ')}, which the " \
              "vocabulary no longer reads as guarded. The exemption is describing a file that has " \
              "moved on: drop it, or say what it exempts now."
  end
  st_notes << "in-band vacuity guards: #{st_guarded.length} rule(s) raise one, " \
              "#{(st_guarded & st_v_armed).length} of them have an arm, " \
              "#{SELF_TEST_VACUITY_PROXY_EXEMPT.length} exempted by name (T-155)"

  unless st_orphans.empty?
    st_bad << "#{st_orphans.length} arm(s) name a `rule:` that is neither a banner in this file nor a " \
              "declared unbannered rule: #{st_orphans.map(&:inspect).join(', ')}. A banner was reworded " \
              "and the plant table was not — which is how a coverage table starts describing a file " \
              "that no longer exists."
  end
  if (SELF_TEST_NOT_A_RULE - st_banners).any?
    st_bad << "SELF_TEST_NOT_A_RULE names #{(SELF_TEST_NOT_A_RULE - st_banners).map(&:inspect).join(', ')}, " \
              "which is not a banner in this file any more. Update the exclusion list in the same commit " \
              "that moved the banner."
  end

  if ARGV.include?("--list")
    puts "check-demo-copies --self-test --list: #{SELF_TEST_PLANTS.length} arm(s) over " \
         "#{st_invariants.length} bannered invariant(s) + #{SELF_TEST_UNBANNERED.length} unbannered"
    (st_invariants + SELF_TEST_UNBANNERED).each do |rule|
      arms = SELF_TEST_PLANTS.select { |p| p[:rule] == rule }
      if arms.empty?
        puts format("  %-6s %s", "NONE", rule)
      else
        puts format("  %-6s %s", arms.map { |a| a[:kind] == :vacuity ? "V" : "B" }.join, rule)
        arms.each { |a| puts format("         %-32s %s — %s", a[:id], a[:kind], a[:what]) }
      end
    end
    st_bad.each { |b| warn "  ✗ #{b}" }
    exit(st_bad.empty? ? 0 : 1)
  end

  # ── the fixture trees ─────────────────────────────────────────────────────
  st_ls, st_git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z", "--cached", "--others",
                                 "--exclude-standard")
  unless st_git.success?
    warn "check-demo-copies --self-test: FAIL — `git ls-files` failed in #{ROOT}. The fixture tree is a " \
         "copy of what git carries plus what it does not ignore, and there is nothing to copy without it."
    exit 1
  end
  st_rels = st_ls.split("\0").select { |r| File.file?(File.join(ROOT, r)) }

  st_jobs = [4, SELF_TEST_PLANTS.length].min
  st_t0   = Process.clock_gettime(Process::CLOCK_MONOTONIC)

  st_results = Array.new(SELF_TEST_PLANTS.length)

  Dir.mktmpdir("check-demo-copies-self-test") do |tmp|
    st_trees = (0...st_jobs).map do |i|
      tree = File.join(tmp, "tree#{i}")
      FileUtils.mkdir_p(st_rels.map { |r| File.dirname(File.join(tree, r)) }.uniq)
      st_rels.each { |r| FileUtils.copy_file(File.join(ROOT, r), File.join(tree, r), true) }
      tree
    end

    st_run = lambda do |tree|
      out, status = Open3.capture2e(RbConfig.ruby, File.join(tree, "bin", "check-demo-copies"))
      [out, status.exitstatus]
    end

    # SELF-NON-VACUITY, three ways, before any arm means anything.
    mine   = Digest::SHA256.file(__FILE__).hexdigest
    theirs = Digest::SHA256.file(File.join(st_trees[0], "bin/check-demo-copies")).hexdigest
    st_bad << "the fixture's copy of this script is not byte-identical to the one running (#{mine[0, 12]} " \
              "vs #{theirs[0, 12]}), so every arm below tests a different file" unless mine == theirs

    real_demos = Dir[File.join(ROOT, "kiosk-demo-*")].count { |d| File.directory?(d) }
    fix_demos  = Dir[File.join(st_trees[0], "kiosk-demo-*")].count { |d| File.directory?(d) }
    st_bad << "the fixture holds #{fix_demos} demo(s) and #{ROOT} holds #{real_demos} — the copy is not " \
              "the corpus this guard walks" unless real_demos == fix_demos && real_demos.positive?

    base_out, base_code = st_run.call(st_trees[0])
    if base_code.zero?
      puts format("  %-6s %s", "GREEN", "baseline: the untouched copy exits 0, so every arm below is ONE " \
                                        "planted break away from red")
    else
      st_bad << "the BASELINE copy is not green (exit #{base_code.inspect}). No arm below means anything " \
                "until it is — and the usual cause is that a bare run of this guard is red too:\n" +
                base_out.lines.grep(/✗/).first(4).map { |l| "      #{l.rstrip[0, 160]}" }.join("\n")
    end

    if st_bad.empty?
      st_queue = SELF_TEST_PLANTS.each_with_index.to_a
      st_lock  = Mutex.new

      st_trees.map do |tree|
        Thread.new do
          loop do
            plant, idx = st_lock.synchronize { st_queue.shift }
            break if plant.nil?

            saved   = {}
            trouble = nil
            # `:each` names a GLOB rather than one path — it is how a vacuity arm
            # drains the whole corpus without listing the files that are in it
            # today. Expanding it here is what keeps the save/restore/verify
            # machinery below identical for every op kind.
            st_rels = lambda do |op|
              case op[0]
              when :copy then [op[2]]
              when :each then Dir[File.join(tree, op[1])].sort.map { |f| f.delete_prefix("#{tree}/") }
              else [op[1]]
              end
            end
            plant[:ops].each do |op|
              st_rels.call(op).each do |rel|
              saved[rel] = nil unless saved.key?(rel)
              path = File.join(tree, rel)
              # Content AND mode: the `:chmod` arm plants a mode, and a restore that
              # only rewrote bytes would leave the fixture tree permanently altered.
              saved[rel] ||= File.exist?(path) ? [File.binread(path), File.stat(path).mode & 0o7777] : nil
              end
            end

            out, code = nil, nil
            begin
              plant[:ops].each do |op|
                rel  = op[0] == :copy ? op[2] : op[1]
                path = File.join(tree, rel)
                case op[0]
                when :edit
                  before = File.read(path)
                  after  = before.gsub(op[2]) { op[3] }
                  trouble ||= "the needle #{op[2].inspect} no longer occurs in #{rel}" if after == before
                  File.write(path, after)
                when :prepend
                  File.write(path, op[2] + File.read(path))
                when :write
                  FileUtils.mkdir_p(File.dirname(path))
                  File.write(path, op[2])
                when :chmod
                  trouble ||= "#{rel} is absent, so there is nothing to chmod" unless File.exist?(path)
                  File.chmod(op[2], path) if File.exist?(path)
                when :delete
                  trouble ||= "#{rel} is already absent, so the deletion plants nothing" unless File.exist?(path)
                  FileUtils.rm_f(path)
                when :copy
                  src = File.join(tree, op[1])
                  trouble ||= "#{op[1]} does not exist, so there is nothing to copy" unless File.exist?(src)
                  FileUtils.mkdir_p(File.dirname(path))
                  FileUtils.copy_file(src, path, true) if File.exist?(src)
                when :each
                  # STRUCTURAL: every file the glob finds, none of them named here.
                  hits = Dir[File.join(tree, op[1])].sort
                  trouble ||= "the glob #{op[1].inspect} matches no file, so this arm plants nothing" if hits.empty?
                  touched = 0
                  hits.each do |f|
                    before = File.read(f)
                    after  = before.gsub(op[2]) { op[3] }
                    next if after == before

                    touched += 1
                    File.write(f, after)
                  end
                  trouble ||= "the needle #{op[2].inspect} occurs in none of the #{hits.length} " \
                              "file(s) #{op[1].inspect} matches" if touched.zero?
                end
              end
              out, code = st_run.call(tree) if trouble.nil?
            ensure
              saved.each do |rel, snap|
                p = File.join(tree, rel)
                if snap.nil?
                  FileUtils.rm_f(p)
                else
                  File.binwrite(p, snap[0])
                  File.chmod(snap[1], p)
                end
              end
            end

            # RESTORE VERIFIED, not assumed: every touched file is re-checksummed
            # against the pristine original under ROOT, because a restore that put
            # back different bytes reads exactly like one that worked.
            drift = saved.keys.reject do |rel|
              a = File.join(tree, rel)
              b = File.join(ROOT, rel)
              next false unless File.exist?(a) == File.exist?(b)
              next true unless File.exist?(a)

              Digest::SHA256.file(a).hexdigest == Digest::SHA256.file(b).hexdigest
            end

            st_results[idx] = { plant: plant, trouble: trouble, code: code, out: out.to_s, drift: drift }
          end
        end
      end.each(&:join)
    end
  end

  st_elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - st_t0

  st_results.compact.each do |r|
    plant = r[:plant]
    label = plant[:kind] == :vacuity ? "VAC" : "RED"
    if r[:trouble]
      st_bad << "#{plant[:id]}: the plant did not apply — #{r[:trouble]}. An arm whose break no longer " \
                "lands is an arm that tests nothing while reading green; re-point it at the live text."
      next
    end
    if r[:code] != 1
      st_bad << "#{plant[:id]}: planted «#{plant[:what]}» and the guard exited #{r[:code].inspect} " \
                "instead of 1. The invariant «#{plant[:rule]}» no longer catches it."
      next
    end
    unless r[:out] =~ plant[:expect]
      st_bad << "#{plant[:id]}: the guard went red as it should, but nothing in its output matched " \
                "#{plant[:expect].inspect} — so it failed for a different reason and this arm proves " \
                "nothing about «#{plant[:rule]}». First failure line:\n      " +
                (r[:out].lines.grep(/✗/).first.to_s.rstrip[0, 200])
      next
    end
    unless r[:drift].empty?
      st_bad << "#{plant[:id]}: after restoring, #{r[:drift].join(', ')} no longer checksum-matches the " \
                "original under #{ROOT}. The fixture tree is throwaway so nothing is lost, but a restore " \
                "that does not restore is a failure this arm exists to make visible."
      next
    end
    puts format("  %-6s %-32s %s", label, plant[:id], plant[:what])
  end

  st_notes << "#{st_uncovered.length} of #{st_invariants.length} bannered invariant(s) have NO arm: " \
              "#{st_uncovered.map(&:inspect).join('; ')}" unless st_uncovered.empty?

  if st_bad.empty?
    puts
    puts "check-demo-copies --self-test: OK — #{SELF_TEST_PLANTS.length} arm(s) " \
         "(#{SELF_TEST_PLANTS.count { |p| p[:kind] == :break }} planted breaks, " \
         "#{SELF_TEST_PLANTS.count { |p| p[:kind] == :vacuity }} vacuity), every one RED and naming its " \
         "invariant, over #{st_aimed.length} of #{st_invariants.length + SELF_TEST_UNBANNERED.length} " \
         "invariants, in #{format('%.1f', st_elapsed)} s over #{st_jobs} throwaway tree(s)."
    st_notes.each { |n| puts "note: #{n}" }
    puts "(This proves each listed arm still reddens on ONE break. It does not prove the guard is " \
         "correct, and it is not a substitute for running it bare.)"
    exit 0
  end

  $stdout.flush
  warn "\ncheck-demo-copies --self-test FAILED:\n"
  st_bad.each { |b| warn "  ✗ #{b}" }
  warn "\nAn arm that stops reddening is an invariant that has quietly left service while the bare run " \
       "still exits 0 — the shape K-1240 measured. Repair the rule, or record why the arm is wrong; do " \
       "not delete the arm to make this green."
  exit 1
end

# Where hand-written demo code lives. Deliberately NOT the Rails skeleton
# (bin/, config/, public/, Rakefile, config.ru): those are generator output each
# demo edits for its own port, host and initializer, and comparing them would
# drown the signal this check exists for. `lib/tasks/*.rake` is outside these
# roots too — a demo's rake file is that storefront's own tasks — so the file
# stays uncompared and the shared CONSTRUCTS inside it are declared one by one
# (see the flow-runner, host-detection and `desc` rules below). What the roots
# leave out is recorded in SKELETON_NOT_COMPARED below.
SCAN_ROOTS = ["lib", "app", "script", "db/migrate"].freeze

# Named one by one because they are the exceptions: paths outside SCAN_ROOTS (or
# outside `*.rb`) that ARE compared. A path earns a place here when its copies
# have no per-demo dimension at all (`.gitignore`, the static pages), when the
# single copy that legitimately differs is carried by the entry's `except:` map,
# or simply because SCAN_ROOTS cannot see the directory it lives in — `spec/` is
# not a scan root, so without a line here the repository's own rule «a NEW
# duplicate fails the build until it is declared» would be untrue for it.
EXTRA_SCANNED = [
  ".gitignore",
  "spec/wire_arguments_spec.rb",
  "public/robots.txt",
  "public/favicon.ico",
  "public/404.html",
  "public/422.html",
  "public/500.html",
  "config/puma.rb",
  "config/cable.yml",
  "config/initializers/filter_parameter_logging.rb",
  "bin/setup",
  "bin/dev",
].freeze

# The one reason six `except:` entries below share (K-643): prove is not a
# divergent COPY of the operator skeleton, it is a different, smaller API-only
# Rails app generated on its own — the recurring shape described atop
# SKELETON_NOT_COMPARED. Stated once so six copies of the sentence cannot
# drift apart.
# The two demos that carry a KYC surface, and the one reason all four of their
# KYC files declare `ships:` (K-657). Stated once so four copies of it cannot
# drift apart, the same way PROVE_SKELETON is.
# The seven OPERATOR demos, by short name — the set every `ships:` that means
# "all of them but the KYC broker" spells. Declared HERE, above COPIES, because
# entries in that manifest need it (bin/setup, bin/dev) as well as the K-1069
# corpus far below; NON_OPERATOR_DEMOS names the other side of the same split.
OPERATOR_SEVEN = %w[atablefor getgrocery hoteling philslist skooti stylish tudu].freeze

KYC_DEMOS = %w[getgrocery skooti].freeze
KYC_SHIPS =
  "`ships:` pins the set to getgrocery and skooti: they are the two operators that configure a " \
  "KYC provider, so only they carry the broker harness and the migrations that retired their own " \
  "KYC table. A third demo growing a copy must be declared here."

# The `app/operations/operation_result.rb` copies that AGREE, and why (K-1262).
# Declared on the file entry and on its `#STATUSES` unit, so written once.
OPERATION_RESULT_AGREE = {
  %w[getgrocery philslist skooti tudu] => {
    rule: :coincidence,
    why:  "Each map lists only `bad_request` and `forbidden` because those are the only refusals " \
          "its own writes make: philslist answers a missing listing 403 so ids cannot be " \
          "enumerated, tudu has no third refusal, and getgrocery's and skooti's KYC refusals " \
          "are raised by the engine. A demo adding a refusal of its own is not drift.",
  },
}.freeze

PROVE_SKELETON =
  "prove is a smaller API-only Rails app generated on its own; its whole skeleton differs from " \
  "the operator seven (the recurring shape noted atop SKELETON_NOT_COMPARED)"

# ── The manifest ─────────────────────────────────────────────────────────────
COPIES = {
  # ── Outside the scan roots, compared anyway (K-629, T-048, K-643) ──────────
  "spec/wire_arguments_spec.rb" => {
    rule:  :per_demo,
    ships: %w[atablefor getgrocery hoteling],
    why:   "The DB-free unit spec for each demo's WireArguments (T-116 wrote getgrocery's, T-137 " \
           "copied the harness into the other two). `:per_demo` because the ASSERTIONS cannot be " \
           "shared: they name each demo's own guards, sentences and columns — `party_size` and a " \
           "seating roster here, a cart and a Dublin delivery clock there, an Istanbul room-night " \
           "floor in the third — and a lockstep rule would demand three different files be one. " \
           "What IS shared is the HARNESS the three copied on purpose, and since T-145 it is HELD " \
           "rather than merely visible: this path is in FRAGMENT_PATHS below and every unit shared " \
           "by two or more copies is declared there — `assert`, `guard`, `assert_typed_400`, " \
           "`refusal_of`, `value_of`, `FAILURES` and `MAX` with `:code` semantics, plus each demo's " \
           "own fixture `DAY` as `:per_demo`. EIGHT units, where T-145 counted five: `FAILURES`, " \
           "`MAX` and `DAY` are shared too, and the discovery rule named all three by hand the " \
           "moment the path was added, which is the whole reason that rule exists. hoteling's 404 " \
           "arm stays its own helper and is compared to nothing, correctly — no sibling has one.",
  },
  ".gitignore" => {
    rule: :identical,
    why:  "A skeleton file with no per-demo dimension: nothing in a .gitignore is per-port, " \
          "per-host or per-app-name, so the four variants this had grown (getgrocery repeating the " \
          "root ignore's `mise.toml`, tudu alone ignoring `/config/*.key`, prove missing the " \
          "sqlite/storage/spring blocks) were drift, not intent. It is also the skeleton file where " \
          "drift is dangerous rather than untidy: K-404 was a `credentials.yml.enc` reaching CI " \
          "without its key, and the fix was a line in every demo's ignore. Machine-local files " \
          "(mise.toml, .bundle, .env) belong in the ROOT .gitignore instead (K-552).",
  },
  "public/robots.txt" => {
    rule:   :identical,
    except: { "prove" => "#{PROVE_SKELETON}, and the divergence here is not skeleton drift but the " \
                         "agent block being FALSE of it (K-1737): the operator copy sends an agent " \
                         "to /.well-known/kiosk.json and /agents.txt, and both come from the " \
                         "engine's mount-gated routes.append, so an origin that mounts no Kiosk " \
                         "wire cannot serve either — PROBED on the booted broker, both 404 while / " \
                         "and /prove_key.pem answer 200. prove's own home page had been saying so " \
                         "one file away («it serves no discovery document»). Its copy therefore " \
                         "names what this origin does serve and nothing it does not" },
    why:  "The T-048 crawling policy: allow everything (these are public demos we want indexed) " \
          "and point the crawler-turned-agent at the agent surface (/.well-known/kiosk.json, " \
          "/agents.txt). One policy statement for the operator seven; a copy that drifts advertises " \
          "a policy the launch story does not make. Its existence is also log hygiene: " \
          "ActionDispatch::Static answers it ahead of routing, where every hit used to raise " \
          "ActionController::RoutingError into the production journal. It was `:identical` across " \
          "all EIGHT until K-1737, which is the failure mode of a lockstep rule rather than of a " \
          "copy: holding a true sentence identical across a corpus whose members do not all satisfy " \
          "it turns the copy that does not into a false advertisement, and the guard is what keeps " \
          "it there.",
  },
  "public/favicon.ico" => {
    rule: :identical,
    why:  "The Kiosk glyph (cut from kiosk.tech's wordmark) — one shared mark for the eight apps " \
          "and the site (T-048). Binary, so only :identical can hold it. Per-demo branding would " \
          "be a legitimate future divergence; that day the divergent demo gets an `except:` here, " \
          "not a silent edit.",
  },

  # ── The K-643 promotion: recorded exclusions become enforced lockstep ──────
  #
  # Each of these was recorded in SKELETON_NOT_COMPARED as identical in the seven
  # operator demos with prove differing — a true statement nothing enforced, so a
  # seventh copy drifting would have been silent. The observation is the rule now:
  # :identical across the operator seven, prove the declared exception.
  "config/cable.yml" => {
    rule:   :identical,
    why:  "One pubsub posture for the operator seven, and the file an adopter copies. " \
          "kiosk-demo-prove does not ship it at all and needs no `except:` for that: the KYC " \
          "broker mounts no Kiosk engine, so it serves no event stream and has no pubsub to " \
          "configure. It reads " \
          "`solid_cable` on the PRIMARY database in production — NOT `async`, which delivers " \
          "only inside one process, so a second Puma worker loses events silently and with " \
          "nothing in any log. A demo that drifts to `async` here is a demo teaching the " \
          "posture the fleet chose against (T-169).",
  },
  "config/puma.rb" => {
    rule:   :identical,
    except: { "prove" => PROVE_SKELETON },
    why:  "Identical in the operator seven — the port comes from PORT, the worker/thread counts " \
          "from WEB_CONCURRENCY/RAILS_MAX_THREADS, so nothing in the file is per-demo; a copy " \
          "that grows its own settings is a deploy behaving unlike the other six (K-643).",
  },
  "config/initializers/filter_parameter_logging.rb" => {
    rule:   :identical,
    except: { "getgrocery" => "a verb argument carrying a human's own data — `delivery_address`, a " \
