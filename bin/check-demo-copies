# `git ls-files`, falling back to a walk in the self-test's non-git copy.
spec_pathspecs = DEMO_SPEC_SUBDIRS.map { |sub| "kiosk-demo-*/#{sub}/*" }
spec_ls, spec_git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z", *spec_pathspecs)
spec_corpus =
  if spec_git.success? && !spec_ls.strip.empty?
    spec_ls.split("\0").reject(&:empty?)
  else
    DEMO_SPEC_SUBDIRS.flat_map { |sub| Dir[File.join(ROOT, "kiosk-demo-*", sub, "**", "*.rb")] }
                     .map { |abs| abs.delete_prefix("#{ROOT}/") }
  end.select { |rel| rel.end_with?(".rb") }.sort

spec_unit_sources = Hash.new { |h, k| h[k] = {} } # unit name => "demo/rel" => normalised body
spec_corpus.each do |rel|
  units, unreadable, = fragment_units(File.join(ROOT, rel))
  unless unreadable.empty?
    errors << "#{rel}: could not read #{unreadable.join(', ')} back as valid Ruby within " \
              "#{FRAGMENT_MAX_LINES} lines. Fix the extraction."
  end
  units.each { |name, src| spec_unit_sources[name][rel] = code_norm(src) }
end

# A name whose every copy FRAGMENTS already holds is delegated there.
spec_held_by_fragments = lambda do |name, rel|
  sub = rel.split("/", 2).last
  FRAGMENT_PATHS.include?(sub) && FRAGMENTS.key?("#{sub}##{name}")
end
spec_shared = spec_unit_sources.select { |_name, byfile| byfile.size >= 2 }
spec_delegated_names = spec_shared.select { |name, byfile| byfile.keys.all? { |rel| spec_held_by_fragments.call(name, rel) } }.keys
spec_owned = spec_shared.reject { |name, _| spec_delegated_names.include?(name) }
spec_compared = 0

spec_owned.each do |name, byfile|
  next if SPEC_UNITS.key?(name)

  errors << "#{name}: defined in #{byfile.size} demo spec/test file(s) (#{byfile.keys.join(', ')}) and " \
            "declared NOWHERE. Declare it in SPEC_UNITS, or give the second copy its own name."
end

SPEC_UNITS.each do |name, entry|
  errors << "SPEC_UNITS[#{name.inspect}]: `why:` is blank." if entry[:why].to_s.strip.empty?

  byfile = spec_owned[name]
  if byfile.nil?
    reason = if spec_delegated_names.include?(name)
               "FRAGMENTS already holds every copy"
             else
               "it is defined in #{spec_unit_sources[name].size} file(s)"
             end
    errors << "SPEC_UNITS[#{name.inspect}]: declared, but #{reason}. Drop the entry."
    next
  end

  spec_compared += byfile.size
  groups = byfile.group_by { |_rel, src| src }
  case entry[:rule]
  when :code
    next if groups.size == 1

    listed = groups.values.map { |g| "[#{g.map { |rel, _| rel }.sort.join(',')}]" }.sort.join(" ")
    errors << "#{name}: the demo spec copies must agree once comments and whitespace are normalised away, " \
              "and they do not: #{listed}. Propagate the edit, or rename the copy that differs."
  when :per_file
    next if groups.size > 1

    errors << "#{name}: declared `:per_file` and all #{byfile.size} copies now agree. Make it `:code`."
  else
    errors << "SPEC_UNITS[#{name.inspect}]: unknown `rule: #{entry[:rule].inspect}`; use :code or :per_file."
  end
end

spec_demo_count = spec_corpus.map { |rel| rel.split("/").first }.uniq.size
if spec_corpus.size < 2 || spec_demo_count < 2
  errors << "check-demo-copies: the demo-spec rule read #{spec_corpus.size} Ruby file(s) across " \
            "#{spec_demo_count} demo(s) under kiosk-demo-*/{#{DEMO_SPEC_SUBDIRS.join(',')}}."
end
if spec_unit_sources.empty?
  errors << "check-demo-copies: the demo-spec rule extracted NO unit from #{spec_corpus.size} file(s)."
end
if SPEC_UNITS.any? && spec_compared.zero?
  errors << "check-demo-copies: SPEC_UNITS declares #{SPEC_UNITS.size} unit(s) and this run compared NONE of them."
end

# ── Shared spec paths: a spec path two demos share must be in EXTRA_SCANNED ──
spec_by_relpath   = spec_corpus.group_by { |rel| rel.split("/", 2).last }
spec_shared_paths = spec_by_relpath.select { |_sub, group| group.size >= 2 }
spec_shared_paths.keys.sort.each do |sub|
  next if EXTRA_SCANNED.include?(sub) || SCAN_ROOTS.any? { |root| sub.start_with?("#{root}/") }

  errors << "#{sub}: #{spec_shared_paths[sub].size} demos ship a file at this SAME relative path " \
            "(#{spec_shared_paths[sub].sort.join(', ')}). Add it to EXTRA_SCANNED and give it a COPIES entry."
end

spec_malformed_keys = spec_by_relpath.keys.reject { |sub| DEMO_SPEC_SUBDIRS.any? { |dir| sub.start_with?("#{dir}/") } }
if spec_malformed_keys.any?
  errors << "check-demo-copies: the shared-spec-path rule grouped #{spec_by_relpath.size} key(s) and " \
            "#{spec_malformed_keys.size} of them are not a path under kiosk-demo-*/{#{DEMO_SPEC_SUBDIRS.join(',')}}."
end

# ── Lockfile platforms: every demo's Gemfile.lock lists the same PLATFORMS ──
lockfile_platforms = demos.filter_map do |dir|
  path = File.join(dir, "Gemfile.lock")
  next unless File.exist?(path)

  section = File.read(path)[/^PLATFORMS\n(.*?)(?:\n\n|\z)/m, 1]
  [File.basename(dir), section.to_s.split("\n").map(&:strip).reject(&:empty?).sort]
end.to_h

if lockfile_platforms.size < 2
  errors << "check-demo-copies: the lockfile-platforms rule compared #{lockfile_platforms.size} lockfile(s)."
else
  majority = lockfile_platforms.values.tally.max_by { |_, n| n }.first
  lockfile_platforms.each do |demo, platforms|
    next if platforms == majority

    missing = majority - platforms
    extra   = platforms - majority
    detail  = []
    detail << "missing #{missing.join(', ')}" unless missing.empty?
    detail << "declares #{extra.join(', ')}, which no sibling does" unless extra.empty?
    errors << "#{short.(demo)}: Gemfile.lock PLATFORMS differs from the other demos — #{detail.join('; ')}. " \
              "Fix with `bundle lock --add-platform #{missing.join(' ')}` in #{demo}."
  end
end

# ── Framework patch: no initializer (demo or e2e) patches a Rails framework class ──
RAILS_FRAMEWORK_NAMESPACES = %w[
  ActiveRecord ActiveModel ActiveSupport ActiveJob ActiveStorage
  ActionController ActionDispatch ActionView ActionMailer ActionCable
  Rails
].freeze

FRAMEWORK_PATCH = /
  ^[ \t]*
  (?<constant>(?:#{RAILS_FRAMEWORK_NAMESPACES.join("|")})(?:::[A-Za-z0-9_]+)*)
  \s*\.\s*
  (?<verb>include|prepend|extend|class_eval|module_eval|define_method|alias_method|remove_method)
  \b
/x

scan_initializer = lambda do |label:, rel:, path:|
  File.read(path).each_line.with_index(1) do |line, lineno|
    next if line.lstrip.start_with?("#")

    m = FRAMEWORK_PATCH.match(line) or next
    errors << "#{label}: #{rel}:#{lineno} calls #{m[:constant]}.#{m[:verb]}. An application must not patch a " \
              "Rails class from its configuration; use a railtie in the owning gem, or a concern under app/."
  end
end

initializer_demos = 0
operator_demos.each do |demo|
  paths = Dir[File.join(ROOT, demo, "config/initializers", "*.rb")].sort
  if paths.empty?
    errors << "#{short.(demo)}: ships no config/initializers/*.rb at all."
    next
  end
  initializer_demos += 1
  paths.each { |path| scan_initializer.call(label: short.(demo), rel: path.delete_prefix("#{File.join(ROOT, demo)}/"), path: path) }
end
errors << "check-demo-copies: the framework-patch rule scanned NO initializers." if initializer_demos.zero?

E2E_RUN_SH           = "e2e/run.sh"
E2E_INITIALIZER_COPY = %r{^\s*cp\s+"\$FIXTURES/(?<fixture>[^"]+)"\s+config/initializers/}
run_sh               = File.join(ROOT, E2E_RUN_SH)

if File.exist?(run_sh)
  fixtures = File.read(run_sh).scan(E2E_INITIALIZER_COPY).flatten.uniq
  errors << "check-demo-copies: #{E2E_RUN_SH} copies no fixture into config/initializers/." if fixtures.empty?
  fixtures.each do |fixture|
    rel = "e2e/fixtures/#{fixture}"
    if File.exist?(File.join(ROOT, rel))
      scan_initializer.call(label: "e2e", rel: rel, path: File.join(ROOT, rel))
    else
      errors << "check-demo-copies: #{E2E_RUN_SH} copies #{rel}, which does not exist."
    end
  end
else
  errors << "check-demo-copies: #{E2E_RUN_SH} does not exist."
end

# ── Driver env: demo scripts fetch these names with NO default ──
DRIVER_NO_DEFAULT_VARS = {
  "SERVER_URL" => "the origin every request in the file is sent to",
}.freeze
DRIVER_ENV_FETCH = /\A[^#]*\bENV\.fetch\(\s*"(?<var>[A-Z0-9_]+)"(?<comma>\s*,)?/
driver_env_held    = DRIVER_NO_DEFAULT_VARS.keys.to_h { |var| [var, 0] }
driver_env_scripts = 0

operator_demos.each do |demo|
  Dir[File.join(ROOT, demo, "script", "*.rb")].sort.each do |path|
    rel = path.delete_prefix("#{File.join(ROOT, demo)}/")
    driver_env_scripts += 1
    File.read(path).each_line.with_index(1) do |line, lineno|
      next if line.lstrip.start_with?("#")

      m = DRIVER_ENV_FETCH.match(line)
      next if m.nil? || !DRIVER_NO_DEFAULT_VARS.key?(m[:var])

      if m[:comma].nil?
        driver_env_held[m[:var]] += 1
      else
        errors << "#{short.(demo)}: #{rel}:#{lineno} fetches #{m[:var]} WITH a default. It is " \
                  "#{DRIVER_NO_DEFAULT_VARS.fetch(m[:var])}, so a default drives whatever listens there; " \
                  "spell it `ENV.fetch(\"#{m[:var]}\")`."
      end
    end
  end
end

driver_env_held.each do |var, held|
  next unless held.zero?

  errors << "check-demo-copies: the driver-env rule found NO no-default fetch of #{var} in " \
            "#{driver_env_scripts} demo script(s)."
end

# ── E2E fixtures: each is paired with the demo path run.sh installs it at, and compared ──
E2E_FIXTURES_DIR = "e2e/fixtures"
E2E_FIXTURE_CP   = /^\s*cp\s+"\$FIXTURES\/(?<fixture>[^"]+)"\s+(?:"(?<quoted>[^"]+)"|(?<bare>\S+))/

# { fixture basename => demo-relative destination }, a `${ts}` timestamp becoming `*`.
def e2e_installed_paths(run_sh_src)
  run_sh_src.gsub(/\\\n\s*/, " ").each_line.with_object({}) do |line, out|
    m = E2E_FIXTURE_CP.match(line) or next

    out[m[:fixture]] = (m[:quoted] || m[:bare]).gsub(/\$\{[^}]+\}/, "*")
  end
end

# `pairs:` overrides the run.sh destination; `pairs: nil` declares no demo counterpart.
E2E_FIXTURES = {
  "salon.rb" => {
    rule: :per_demo,
    why:  "stylish's salon reads its own clock; the harness's salons have no timezone column.",
  },
  "devise_initializer.rb" => {
    rule: :code,
    why:  "The human login configuration every demo ships.",
  },
  "create_users.rb" => {
    rule: :per_demo,
    why:  "Three demos add a column of their own to the users table.",
  },
  "create_kiosk_pay_stripe_customers.rb" => {
    rule: :identical,
    why:  "The harness pays through the same kiosk-pay-stripe table the demos do.",
  },
  "create_salons_and_appointments.rb" => {
    rule: :per_demo,
    why:  "stylish's migration plus `appointments.confirmed_at`, which the event-stream leg needs.",
  },
  "salon_desk_controller.rb" => {
    rule:  :per_demo,
    pairs: nil,
    why:   "The salon back office that confirms an appointment and pushes an event; no demo has one.",
  },
  "application_controller.rb" => {
    rule: :per_demo,
    why:  "Moves the `rails new --api` app onto ActionController::Base for Devise.",
  },
  "user.rb" => {
    rule: :per_demo,
    why:  "The harness's User carries only the association its two verbs need.",
  },
  "appointment.rb" => {
    rule: :per_demo,
    why:  "The harness needs the table and the belongs_to, not stylish's booking rules.",
  },
  "bookings_controller.rb" => {
    rule: :per_demo,
    why:  "A two-verb fixture wire, not atablefor's booking verbs.",
  },
  "routes.rb" => {
    rule: :per_demo,
    why:  "The generated app's own pages.",
  },
  "routes_kiosk.rb" => {
    rule: :per_demo,
    why:  "The harness's own verb routes.",
  },
  "seeds.rb" => {
    rule: :per_demo,
    why:  "The harness's fixture rows.",
  },
  "initializer_kiosk.rb" => {
    rule: :per_demo,
    why:  "The harness's own handlers, issuer and toll.",
  },
  "catalog_controller.rb" => {
    pairs: nil,
    why:   "The fixture wire's read verb; no demo ships one.",
  },
  "demo_audit_sink.rb" => {
    pairs: nil,
    why:   "The audit-sink seam is exercised by the harness alone.",
  },
  "equihash_register.rb" => {
    pairs: "script/equihash_register.rb",
    rule:  :per_demo,
    why:   "Run in place; it solves the toll against the generated app, unlike the demos' copy.",
  },
  "claim_flow.rb" => {
    pairs: nil,
    why:   "Run in place; the demos' claim ceremonies are Minitest tests.",
  },
  "pay_flow.rb" => {
    pairs: nil,
    why:   "Run in place; the demos' payment beats are their own tests.",
  },
  "register_pow_flow.rb" => {
    pairs: nil,
    why:   "Run in place; the demos' toll beats are their own tests.",
  },
  "bind_assistants.rb" => {
    pairs: nil,
    why:   "Run in place in the fixture host's console to mint bindings; a demo binds through its wire.",
  },
  "auth_wire_capture.rb" => {
    pairs: nil,
    why:   "Run in place; the harness's own recorder for the auth wire.",
  },
}.freeze

e2e_fixture_comparisons = 0
e2e_fixture_dir = File.join(ROOT, E2E_FIXTURES_DIR)
if !File.directory?(e2e_fixture_dir) || !File.exist?(run_sh)
  errors << "check-demo-copies: #{E2E_FIXTURES_DIR}/ or #{E2E_RUN_SH} is gone."
else
  installed = e2e_installed_paths(File.read(run_sh))
  errors << "check-demo-copies: #{E2E_RUN_SH} has no `cp \"$FIXTURES/…\"` lines." if installed.empty?

  on_disk = Dir[File.join(e2e_fixture_dir, "*.rb")].map { |p| File.basename(p) }.sort
  (on_disk - E2E_FIXTURES.keys).each do |name|
    errors << "#{E2E_FIXTURES_DIR}/#{name}: exists but is not declared in E2E_FIXTURES. Pair it with a rule, " \
              "or declare `pairs: nil` with the reason."
  end
  (E2E_FIXTURES.keys - on_disk).each do |name|
    errors << "#{E2E_FIXTURES_DIR}/#{name}: declared in E2E_FIXTURES but not on disk. Drop the entry."
  end

  (E2E_FIXTURES.keys & on_disk).each do |name|
    entry = E2E_FIXTURES[name]
    fixture = File.join(e2e_fixture_dir, name)
    label = "#{E2E_FIXTURES_DIR}/#{name}"
    errors << "#{label}: E2E_FIXTURES entry carries no `why:` reason" if entry[:why].to_s.strip.empty?

    declared_nil = entry.key?(:pairs) && entry[:pairs].nil?
    spec = entry.key?(:pairs) ? entry[:pairs] : installed[name]

    if declared_nil
      twins = demos.flat_map { |dir| Dir[File.join(dir, "**", name)] }
                   .reject { |f| f.include?("/.gems/") }
                   .select { |f| code_digest(f) == code_digest(fixture) }
      unless twins.empty?
        errors << "#{label}: declared `pairs: nil`, but #{twins.map { |f| f.delete_prefix("#{ROOT}/") }.sort.join(', ')} " \
                  "#{twins.size == 1 ? 'is' : 'are'} comment-identical to it. Pair it and give it a rule."
      end
      next
    end
    if spec.nil?
      errors << "#{label}: #{E2E_RUN_SH} no longer installs it. Declare `pairs:` explicitly, or `pairs: nil`."
      next
    end

    rule = entry[:rule]
    unless %i[identical code per_demo].include?(rule)
      errors << "#{label}: unknown `rule: #{rule.inspect}`; use :identical, :code or :per_demo."
      next
    end

    copies = demos.each_with_object({}) do |dir, acc|
      match = spec.include?("*") ? Dir[File.join(dir, spec)].sort.first : File.join(dir, spec)
      acc[short.(File.basename(dir))] = match if match && File.file?(match)
    end
    if copies.empty?
      errors << "#{label}: paired with `#{spec}`, and no demo ships that path. Re-pair it, or declare `pairs: nil`."
      next
    end

    e2e_fixture_comparisons += copies.size
    case rule
    when :identical, :code
      digest = rule == :identical ? method(:byte_digest) : method(:code_digest)
      off = copies.reject { |_demo, path| digest.call(path) == digest.call(fixture) }
      next if off.empty?

      errors << "#{label}: declared `:#{rule}` to #{spec}, and #{off.keys.sort.join(', ')} " \
                "#{off.size == 1 ? 'does' : 'do'} not match it. Propagate the edit, or change the rule."
    when :per_demo
      next unless copies.all? { |_demo, path| code_digest(path) == code_digest(fixture) }

      errors << "#{label}: declared `:per_demo` against #{spec}, but it is now comment-identical to every " \
                "demo copy. Declare it `:code`."
    end
  end
end

if e2e_fixture_comparisons.zero? && E2E_FIXTURES.any?
  errors << "check-demo-copies: the e2e fixture rule declares #{E2E_FIXTURES.size} fixture(s) and compared NONE."
end

# ── Bin scripts: every `bin/<name>` a demo's bin/ scripts or README name exists and is executable ──
BIN_REF_RE = %r{(?<=[`"'\s(])(?:\./)?bin/([a-z0-9_][a-z0-9_-]*)}

bin_ref_files = 0
bin_local     = 0
expected_ref_files = 0
demos.each do |dir|
  label   = short.(File.basename(dir))
  sources = Dir[File.join(dir, "bin", "*")].select { |f| File.file?(f) }.sort
  sources.each do |script|
    next if File.executable?(script)

    errors << "#{label}: #{script.delete_prefix("#{ROOT}/")} is not executable " \
              "(mode #{format('%o', File.stat(script).mode & 0o7777)})."
  end

  readme     = File.join(dir, "README.md")
  bin_corpus = sources.map { |f| [f, File.readlines(f).reject { |l| l =~ /\A\s*#/ }.join] }
  bin_corpus << [readme, File.read(readme)] if File.file?(readme)
  expected_ref_files += bin_corpus.size

  bin_corpus.each do |path, body|
    bin_ref_files += 1
    body.scan(BIN_REF_RE).flatten.uniq.each do |name|
      in_demo = File.join(dir, "bin", name)
      at_root = File.join(ROOT, "bin", name)
      where   = File.file?(in_demo) ? in_demo : (File.file?(at_root) ? at_root : nil)
      bin_local += 1 if where == in_demo

      if where.nil?
        errors << "#{label}: #{path.delete_prefix("#{ROOT}/")} names `bin/#{name}`, which exists neither in " \
                  "#{label}'s own bin/ nor at the repo root. Ship the file or stop naming it."
      elsif !File.executable?(where)
        errors << "#{label}: #{path.delete_prefix("#{ROOT}/")} names `bin/#{name}` and " \
                  "#{where.delete_prefix("#{ROOT}/")} is not executable."
      end
    end
  end
end
if bin_ref_files != expected_ref_files
  errors << "check-demo-copies: the bin/-reference scan read #{bin_ref_files} file(s) of #{expected_ref_files}."
end
errors << "check-demo-copies: the bin/-reference scan resolved NO reference to a demo's own bin/ script." if bin_local.zero?

# ── Containers: one root Dockerfile, one compose file per demo, identical modulo demo name and port ──
CONTAINER_IGNORE_RE = /\A\.(?:docker|container|podman)ignore\z/
CONTAINER_RECIPE_RE = /\A(?:Dockerfile|Containerfile)(?:\..+)?\z|\A.+\.(?:dockerfile|containerfile)\z|\A(?:docker-)?compose(?:\..+)?\.ya?ml\z/
CONTAINER_COMPOSE_RE = /\A(?:docker-)?compose(?:\..+)?\.ya?ml\z/
CONTAINER_IMAGE_RE   = /\A(?:Dockerfile|Containerfile)(?:\..+)?\z|\A.+\.(?:dockerfile|containerfile)\z/

[[".dockerignore", :ignore], [".containerignore", :ignore], ["Dockerfile", :recipe], ["compose.yaml", :recipe],
 ["docker-compose.yml", :recipe], ["Dockerfile.prod", :recipe], ["dockerignore", :neither],
 ["README.md", :neither]].each do |name, want|
  got = if name =~ CONTAINER_IGNORE_RE then :ignore
        elsif name =~ CONTAINER_RECIPE_RE then :recipe
        else :neither
        end
  next if got == want

  errors << "check-demo-copies: the container-tooling detector reads #{name.inspect} as #{got} where it must read #{want}."
end

# What git tracks, or a working-tree walk in the self-test's non-git copy.
CONTAINER_PRUNE = %w[.git .gems node_modules tmp log storage coverage public/assets].freeze

def container_walk(root)
  out   = []
  stack = [root]
  until stack.empty?
    dir = stack.pop
    Dir.children(dir).each do |name|
      abs = File.join(dir, name)
      if File.directory?(abs)
        stack << abs unless CONTAINER_PRUNE.include?(name)
      elsif File.file?(abs)
        out << abs.delete_prefix("#{root}/")
      end
    end
  end
  out
end

container_ls, container_git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z")
container_source  = container_git.success? ? "tracked" : "working-tree"
container_tracked = container_git.success? ? container_ls.split("\0").reject(&:empty?) : container_walk(ROOT)
if container_tracked.length < 500
  errors << "check-demo-copies: the container-tooling rule walked #{container_tracked.length} " \
            "#{container_source} path(s), which is not this repository."
end

container_ignores  = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_IGNORE_RE }
container_composes = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_COMPOSE_RE }
container_images   = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_IMAGE_RE }
container_demo_names = demos.map { |d| File.basename(d) }

(container_demo_names - container_composes.map { |rel| File.dirname(rel) }).each do |demo|
  errors << "#{demo} ships no compose file. Add `#{demo}/compose.yaml` beside its siblings."
end

container_images.reject { |rel| File.dirname(rel) == "." }.each do |rel|
  errors << "#{rel} is a SECOND container image recipe. The build context is the repository, so the one " \
            "root `Dockerfile` carries every demo; delete this one."
end
if container_images.empty?
  errors << "check-demo-copies: there is no container image recipe, but #{container_composes.length} compose " \
            "file(s) build one."
end

# The image's Ruby is one CI runs and at least the gemspec floor; compose Postgres is CI's.
container_ci_yml   = File.join(ROOT, ".github", "workflows", "ci.yml")
container_ci_body  = File.file?(container_ci_yml) ? File.read(container_ci_yml) : ""
container_ci_pg    = container_ci_body.scan(/^\s+image:\s*(postgres:[0-9]+(?:\.[0-9]+)*)\s*$/)
                                      .flatten.tally.max_by { |_, n| n }&.first
container_ci_ruby  = container_ci_body.scan(/^\s+ruby-version:\s*"([0-9][0-9.]*)"\s*$/).flatten.uniq
container_gemspec  = File.join(ROOT, "kiosk-core", "kiosk-core.gemspec")
container_floor    = File.file?(container_gemspec) &&
                     File.read(container_gemspec)[/required_ruby_version\s*=\s*"\s*>=\s*([0-9][0-9.]*)"/, 1]

errors << "check-demo-copies: no `image: postgres:<major>` in .github/workflows/ci.yml." if container_ci_pg.nil?
errors << "check-demo-copies: no `ruby-version:` in .github/workflows/ci.yml." if container_ci_ruby.empty?

container_dockerfile = File.join(ROOT, "Dockerfile")
if File.file?(container_dockerfile)
  container_arg = File.read(container_dockerfile)[/^ARG\s+RUBY_VERSION=([0-9][0-9.]*)\s*$/, 1]
  if container_arg.nil?
    errors << "Dockerfile: no `ARG RUBY_VERSION=<version>` line."
  else
    if container_ci_ruby.any? && !container_ci_ruby.include?(container_arg)
      errors << "Dockerfile: `ARG RUBY_VERSION=#{container_arg}` names a Ruby .github/workflows/ci.yml never " \
                "runs (it runs #{container_ci_ruby.sort.join(', ')})."
    end
    if container_floor && Gem::Version.new(container_arg) < Gem::Version.new(container_floor)
      errors << "Dockerfile: `ARG RUBY_VERSION=#{container_arg}` is below kiosk-core's floor, #{container_floor}."
    end
  end
end

container_ports_derived = 0
container_forms = {}
container_by_port = Hash.new { |h, k| h[k] = [] }
container_composes.each do |rel|
  demo = File.dirname(rel)
  next unless container_demo_names.include?(demo)

  body = File.read(File.join(ROOT, rel))
  errors << "#{rel}: its compose project is not named `#{demo}`." unless body.match?(/^name:\s*#{Regexp.escape(demo)}\s*$/)
  unless body.match?(%r{^\s+working_dir:\s*/kiosk/#{Regexp.escape(demo)}\s*$})
    errors << "#{rel}: its `working_dir` is not `/kiosk/#{demo}`, so it brings up another demo."
  end
  unless body.match?(/^\s+context:\s*\.\.\s*$/) && body.match?(/^\s+dockerfile:\s*Dockerfile\s*$/)
    errors << "#{rel}: it does not build the shared `Dockerfile` with `context: ..`."
  end
  if container_ci_pg && !body.match?(/^\s+image:\s*#{Regexp.escape(container_ci_pg)}\s*$/)
    errors << "#{rel}: its database service is not `#{container_ci_pg}`, the Postgres CI runs."
  end
  body.scan(/^\s+- "(\d+):\d+"\s*$/).flatten.each { |p| container_by_port[p] << rel }

  port = body[/^\s+PORT:\s*"(\d+)"\s*$/, 1]
  form = body.gsub(demo.delete_prefix("kiosk-demo-"), "<DEMO>")
  form = form.gsub(port, "<PORT>") if port
  (container_forms[form] ||= []) << rel
  next if port.nil?

  container_ports_derived += 1
  unless body.match?(/^\s+- "#{port}:#{port}"\s*$/)
    errors << "#{rel}: it does not publish the port it serves on, #{port}."
  end
end
errors << "check-demo-copies: not ONE compose file sets a `PORT`." if container_ports_derived.zero?
errors << "check-demo-copies: no compose file was read." if container_forms.empty?

if container_forms.length > 1
  majority = container_forms.max_by { |_, rels| rels.length }
  container_forms.reject { |form, _| form.equal?(majority.first) }.each_value do |rels|
    errors << "#{rels.join(', ')}: the compose file differs from the #{majority.last.length} other(s) in " \
              "something other than its demo name and port. Diff it against #{majority.last.first}."
  end
end

container_by_port.select { |_, rels| rels.length > 1 }.each do |port, rels|
  errors << "#{rels.join(', ')} all publish host port #{port}; two demos must be able to run at once."
end

# An ignore file counts only in a build context: a compose `context:` or an image recipe's directory.
container_contexts = {}
container_images.each { |rel| container_contexts[File.dirname(rel)] = true }
container_composes.each do |rel|
  dir = File.dirname(rel)
  File.read(File.join(ROOT, rel)).scan(/^\s+context:\s*(\S+)\s*$/).flatten.each do |ctx|
    resolved = File.expand_path(ctx, dir == "." ? "/" : "/#{dir}").delete_prefix("/")
    container_contexts[resolved.empty? ? "." : resolved] = true
  end
end
errors << "check-demo-copies: no build-context directory could be derived." if container_contexts.empty?

container_ignores.each do |rel|
  next if container_contexts.key?(File.dirname(rel))

  errors << "#{rel} is an ORPHAN: no build in this repository reads it. Delete it."
end

if AGREE_CENSUS.empty? && errors.empty?
  errors << "check-demo-copies: the convergence census recorded NO compared subject."
end

if errors.empty?
  puts "check-demo-copies: OK — #{dups.size} duplicated paths declared, " \
       "#{COPIES.count { |_, e| e[:rule] != :per_demo }} kept in lockstep"
  exit 0
end

warn "\ncheck-demo-copies FAILED:\n"
errors.each { |e| warn "  ✗ #{e}" }
exit 1
