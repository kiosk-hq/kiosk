    ships: %w[philslist stylish],
    why:  "Each demo's register walkthrough against its own verbs.",
  },
  "test/wire/walkthrough_test.rb" => {
    rule: :per_demo,
    ships: %w[philslist stylish],
    why:  "Each demo's end-to-end story over its own verbs.",
  },
  # ── Outside the scan roots, compared anyway (K-629, T-048, K-643) ──────────
  ".gitignore" => {
    rule: :identical,
    why:  "A skeleton file with no per-demo dimension: nothing in a .gitignore is per-port, " \
          "per-host or per-app-name, so the four variants this had grown (getgrocery repeating the " \
          "root ignore's `mise.toml`, tudu alone ignoring `/config/*.key`, prove missing the " \
          "sqlite/storage/spring blocks) were drift, not intent. It is also the skeleton file where " \
          "drift is dangerous rather than untidy: K-404 was a `credentials.yml.enc` reaching CI " \
          "without its key, and the fix was a line in every demo's ignore. Machine-local files " \
