# ── Cross-demo singleton pairs (K-648) ───────────────────────────────────────
#
# A HAND-WRITTEN migration that ships in two or more demos at demo-specific
# timestamps is a singleton relative path that no `.tt` emits, so neither the
# lockstep rule nor the template rule can reach it — the copies would be compared
# to NOTHING. Declared here by timestamp-stripped basename and compared across
# ALL copies. Fields:
#   rule:  :identical | :code — how the copies must agree (same meaning as in
#          COPIES).
#   drift: the copies KNOWINGLY disagree in code, pending triage: the reason
#          says what differs and why no side was picked, and the entry errors
#          the day the copies converge, so it cannot outlive the divergence it
#          records. Honest scope: unlike a template drift there is no third
#          artifact to hold either side against, so a drifting pair is
#          RECORDED, not guarded, until the triage lands.
#   why:   why two demos share the file at all.
MIGRATION_PAIRS = {}.freeze

# ── Normalisation ────────────────────────────────────────────────────────────
#
# Ripper rather than a regex: `#` inside a string, a regex or a heredoc is not a
# comment, and a regex that thinks otherwise fails OPEN — it would report two
# copies as agreeing when they do not, which is the one failure mode this check
# must not have. :on_sp is whitespace BETWEEN tokens, so collapsing it ignores
# indentation and hash alignment while leaving string and heredoc content alone.
COMMENT_TOKENS = %i[on_comment on_embdoc on_embdoc_beg on_embdoc_end].freeze

# A file's comments as one line of prose.
def comment_prose(path)
  Ripper.lex(File.read(path))
        .select { |(_, type, _)| type == :on_comment }
        .map { |(_, _, tok)| tok.sub(/\A#+\s?/, "").rstrip }
        .join(" ")
        .gsub(/\s+/, " ")
end

# The `:code` normalisation, over a STRING rather than a file — so the fragment
# rule (T-120) compares a `def` with exactly the semantics `:code` compares a
# whole file with, rather than growing a second normaliser next to this one.
def code_norm(src)
  body = Ripper.lex(src).filter_map do |(_pos, type, tok)|
    next if COMMENT_TOKENS.include?(type)

    type == :on_sp ? " " : tok
  end.join
  body.lines.map(&:strip).reject(&:empty?).join("\n")
end

def code_digest(path) = Digest::SHA256.hexdigest(code_norm(File.read(path)))

def byte_digest(path) = Digest::SHA256.file(path).hexdigest

# ── A `:per_demo` subject whose copies have PARTIALLY CONVERGED (K-1262) ─────
#
# `:per_demo` means NOT COMPARED, so the state this manifest is LEAST able to
# describe — most of a group agreeing while one copy still differs — was once
# invisible at both granularities, and it is precisely the state that means
# somebody hand-copied something.
#
# EVERY `:per_demo` PATH IS GROUPED BY THE SHA256 OF ITS {code_norm} ON EVERY RUN.
#
# Any subset that agrees must be declared in the entry's `agree:` map, as one of
# two kinds:
#
#   rule: :lockstep    — these copies are ONE artefact that happens to live at N
#                        paths. They are HELD: a copy edited alone fails here,
#                        which is what turns a hand-copied driver's unwatched
#                        lines into watched ones.
#   rule: :coincidence — they agree today for unrelated reasons, and holding them
#                        would enshrine an accident. NOT held as a promise — but
#                        the group's MEMBERSHIP is: a demo JOINING it, or the
#                        group ceasing to agree, fails, and the declaration is
#                        updated in the same commit. Both kinds are checked
#                        exactly as hard; what differs is the diagnosis the next
#                        reader is handed, and the cap.
#
# THE CAP IS THE ONE SUBSTANTIVE DIFFERENCE, because without it `:coincidence`
# would be a free way to switch this rule off. A `:coincidence` group may not
# exceed AGREE_COINCIDENCE_MAX_LINES normalised lines: above that, «they happen to
# agree» stops being a credible reading of hand-copied code.
#
# THIS IS NOT A PARTIAL COMPARISON — no region is carved out of any file. Whole
# copies, normalised whole, with the SUBSETS that agree named.
#
# ALL COPIES AGREEING IS NOT DECLARABLE, in either kind. That is not a partial
# convergence, it is a `:code` entry nobody has written yet, and it is reported
# as one — the rule the unit level has had since T-120, now at both levels.
AGREE_RULES = %i[lockstep coincidence].freeze
AGREE_COINCIDENCE_MAX_LINES = 12

# `bodies` is demo => normalised source; `declared` is the entry's `agree:` map,
# keyed by a demo list. Appends to `errors` and returns the number of declared
# groups it CONFIRMED against the tree.
# Every subject this rule sees, recorded so an empty census fails (K-1542).
AGREE_CENSUS = []

def agree_check(label, what, bodies, declared, errors)
  declared = (declared || {}).to_h { |demos, spec| [demos.sort, spec] }
  groups   = bodies.group_by { |_demo, norm| norm }
                   .values.select { |g| g.size >= 2 }
                   .to_h { |g| [g.map(&:first).sort, g.first[1]] }

  AGREE_CENSUS << {
    label:  label,
    what:   what,
    sizes:  bodies.to_h { |demo, norm| [demo, norm.lines.size] },
    groups: groups.map { |demos, norm|
      { demos: demos, lines: norm.lines.size, rule: declared[demos] && declared[demos][:rule] }
    },
  }

  declared.each do |demos, spec|
    if demos.size < 2
      errors << "#{label}: `agree:` declares #{demos.inspect} — an agreement is two copies or more " \
                "(K-1262)."
      next
    end
    absent = demos - bodies.keys
    unless absent.empty?
      errors << "#{label}: `agree:` names #{absent.join(', ')}, which no longer contributes a " \
                "compared #{what} here. Update the declared set — a group that names a copy which is " \
                "gone is the record turning back into an assumption (K-1262)."
    end
    errors << "#{label}: `agree:` entry [#{demos.join(',')}] carries no `why:` (K-1262)." \
      if spec[:why].to_s.strip.empty?
    next if AGREE_RULES.include?(spec[:rule])

    errors << "#{label}: `agree:` entry [#{demos.join(',')}] has unknown `rule: " \
              "#{spec[:rule].inspect}` — the choice is `:lockstep` (one artefact, hand-copied, and " \
              "therefore HELD) or `:coincidence` (they agree today for unrelated reasons, recorded " \
              "and capped at #{AGREE_COINCIDENCE_MAX_LINES} normalised lines) (K-1262)."
  end

  widened = {}
  declared.each_key do |demos|
    next if groups.key?(demos)

    bigger = groups.keys.find { |g| (demos - g).empty? }
    widened[demos] = bigger if bigger
  end

  confirmed = 0
  groups.each do |demos, norm|
    if demos.size == bodies.size
      errors << "#{label}: declared `:per_demo` — genuinely different #{what}s sharing a name — but " \
                "ALL #{bodies.size} copies now agree once comments and whitespace are normalised " \
                "away (#{norm.lines.size} line(s)). That is not a partial convergence to declare in " \
                "`agree:`, it is a `:code` entry nobody has written: either declare it `:code` and " \
                "hold them there, or one copy lost what made it different (T-120, K-1262)."
      next
    end
    if (declared_key = widened.key(demos))
      joined = demos - declared_key
      errors << "#{label}: `agree:` declares [#{declared_key.join(',')}] and #{joined.join(', ')} " \
                "#{joined.size == 1 ? 'has' : 'have'} since joined — the agreeing group is now " \
                "[#{demos.join(',')}], #{norm.lines.size} normalised line(s). A demo joining a group " \
                "of copies that already agree is a NEW copy of something already hand-copied: widen " \
                "the declaration and re-argue it, or give that copy back what made it its own " \
                "(K-1262)."
      next
    end
    unless declared.key?(demos)
      # A declared group that has SHRUNK reports itself below, with the remedy
      # that fits (propagate the edit, or drop the group). Reporting its
      # surviving subset here as well would hand the next reader the WRONG
      # remedy — "declare [atablefor,tudu]" — for the same one-sided edit.
      next if declared.keys.any? { |d| (demos - d).empty? && !groups.key?(d) }

      errors << "#{label}: [#{demos.join(',')}] — #{demos.size} of #{bodies.size} copies — agree once " \
                "comments and whitespace are normalised away (#{norm.lines.size} normalised line(s)), " \
                "and nothing declares it. `:per_demo` means the copies are compared to NOTHING, so a " \
                "SUBSET that has quietly become one hand-copied #{what} is held by nothing while the " \
                "entry reads as #{bodies.size} per-demo implementations. Declare it in this entry's " \
                "`agree:` map — `:lockstep` if it is one artefact (then it is HELD), `:coincidence` " \
                "if they agree for unrelated reasons (then it is capped at " \
                "#{AGREE_COINCIDENCE_MAX_LINES} normalised lines) — with the reason (K-1262)."
      next
    end

    confirmed += 1
    spec = declared[demos]
    next unless spec[:rule] == :coincidence && norm.lines.size > AGREE_COINCIDENCE_MAX_LINES

    errors << "#{label}: `agree:` calls [#{demos.join(',')}] a `:coincidence`, but what they agree on " \
              "is #{norm.lines.size} normalised lines and the cap is #{AGREE_COINCIDENCE_MAX_LINES}. " \
              "At that size «they happen to agree» is not a credible reading of hand-copied code, and " \
              "an uncapped `:coincidence` is a free way to switch this rule off. Declare `:lockstep` " \
              "and hold them, or converge the rest and make the whole entry `:code` (K-1262)."
  end

  declared.each do |demos, spec|
    next if groups.key?(demos) || widened.key?(demos)
    next if (demos - bodies.keys).any?

    actual = bodies.select { |d, _| demos.include?(d) }
                   .group_by { |_d, norm| norm }
                   .values.map { |g| "[#{g.map(&:first).sort.join(',')}]" }.sort.join(" ")
    errors << if spec[:rule] == :lockstep
                "#{label}: `agree:` holds [#{demos.join(',')}] in lockstep — ONE #{what}, hand-copied " \
                  "— and they no longer agree: #{actual}. Propagate the edit to every copy in the " \
                  "group, or, if the divergence is real, drop the group from `agree:` in the same " \
                  "commit and say what made them diverge (K-1262)."
              else
                "#{label}: `agree:` records [#{demos.join(',')}] as a `:coincidence` and the " \
                  "coincidence has ended: #{actual}. Nothing is broken — drop the group from " \
                  "`agree:`, because a declaration that no longer describes the tree is the record " \
                  "turning back into an assumption (K-1262)."
              end
  end

  confirmed
end

# What the install generator would write today. `options` is the name the
# templates reference (the generator's Thor options hash); binding hands it to
# the ERB, so `<%= options[:schema].inspect %>` renders exactly as it does in
# `rails g kiosk:install` with no flags. Plain ERB, no trim mode — the
# templates use bare `<%= %>` substitution only.
def render_template(path)
  b = binding
  b.local_variable_set(:options, GENERATOR_DEFAULTS)
  ERB.new(File.read(path)).result(b)
end

# ── Magic comments (K-628) ───────────────────────────────────────────────────
#
# The ONLY comments Ruby acts on. Restricted to the recognised set on purpose: a
# generic "leading `word: value` comment" rule would swallow ordinary prose
# ("# NOTE: ...") and start failing builds over wording, which is exactly what
# :code exists to avoid. Anything outside this list is inert to Ruby and stays
# invisible here.
#
# Only comments BEFORE the first real token count, because that is the only place
# Ruby honours them — a `# frozen_string_literal: true` further down is a plain
# comment and is correctly ignored.
MAGIC_COMMENTS = %w[encoding coding frozen_string_literal warn_indent shareable_constant_value].freeze
MAGIC_RE = /\A#\s*(?:-\*-\s*)?(#{Regexp.union(MAGIC_COMMENTS)})\s*:\s*([^\s;]+)/i

def magic_comments(path)
  found = []
  Ripper.lex(File.read(path)).each do |(_pos, type, tok)|
    case type
    when :on_sp, :on_nl, :on_ignored_nl then next
    when :on_comment
      m = tok.strip.match(MAGIC_RE)
      found << "#{m[1].downcase}: #{m[2].downcase}" if m
    else break # first real token: anything after this is inert to Ruby
    end
  end
  found.sort
end

# ── Discovery ────────────────────────────────────────────────────────────────
demos = Dir[File.join(ROOT, "kiosk-demo-*")].select { |d| File.directory?(d) }.sort
abort "check-demo-copies: no kiosk-demo-* directories under #{ROOT}" if demos.empty?

found = Hash.new { |h, k| h[k] = {} } # relative path => demo name => absolute path
demos.each do |dir|
  demo = File.basename(dir)
  SCAN_ROOTS.each do |sub|
    Dir[File.join(dir, sub, "**", "*.rb")].sort.each do |path|
      rel = path.delete_prefix("#{dir}/")
      next if rel.start_with?("lib/tasks/")

      found[rel][demo] = path
    end
  end
  EXTRA_SCANNED.each do |rel|
    path = File.join(dir, rel)
    found[rel][demo] = path if File.file?(path)
  end
end
dups = found.select { |_rel, copies| copies.size >= 2 }

# db/migrate again, grouped by timestamp-stripped basename this time (K-640):
# migration_template stamps each demo's copy with its own UTC timestamp, so the
# same logical migration sits at different relative paths in different demos
# (getgrocery's create_kiosk_mandates is at …131463 where hoteling's is
# …131462) — grouping by basename is what lets the template rule see them as
# one file where the relative-path rule above cannot.
migrations = Hash.new { |h, k| h[k] = {} } # basename sans timestamp => demo name => absolute path
demos.each do |dir|
  Dir[File.join(dir, "db/migrate", "*.rb")].sort.each do |path|
    migrations[File.basename(path).sub(/\A\d+_/, "")][File.basename(dir)] = path
  end
end
migrations.default_proc = nil

if ARGV.include?("--list")
  puts format("%-64s %-9s %s", "PATH", "RULE", "DEMOS")
  COPIES.sort.each do |rel, entry|
    copies = dups[rel] || {}
    marks  = copies.keys.map { |d| d.delete_prefix("kiosk-demo-") + (entry[:except]&.key?(d.delete_prefix("kiosk-demo-")) ? "*" : "") }
    puts format("%-64s %-9s %s", rel, entry[:rule], marks.join(" "))
  end
  puts "\n* = declared exception (see the `except:` reason in bin/check-demo-copies)"
  puts
  puts format("%-44s %-42s %s", "TEMPLATE (kiosk:install)", "EMITS", "STATE")
  GENERATOR_TEMPLATES.sort.each do |name, entry|
    state = entry[:not_compared] ? "not compared" : "byte-match, all seven"
    shipped = (migrations[entry[:emits]] || {}).keys
    puts format("%-44s %-42s %s%s", name, entry[:emits] || "—", state,
                shipped.empty? ? "" : " (#{shipped.map { |d| d.delete_prefix('kiosk-demo-') }.sort.join(' ')})")
  end
  puts
  puts format("%-44s %-9s %s", "MIGRATION PAIR (K-648, sans timestamp)", "RULE", "STATE")
  MIGRATION_PAIRS.sort.each do |base, entry|
    state  = entry[:drift] ? "drift pending triage" : "held"
    spread = (migrations[base] || {}).map { |d, p| "#{d.delete_prefix('kiosk-demo-')}@#{File.basename(p)[/\A\d+/]}" }.sort
    puts format("%-44s %-9s %s (%s)", base, entry[:rule], state, spread.join(" "))
  end
  exit 0
end

errors = []
short = ->(demo) { demo.delete_prefix("kiosk-demo-") }

# Declared `agree:` groups CONFIRMED against the tree this run, over both
# granularities. See the K-1262 banner above {agree_check} for the vacuity arm
# this number exists to feed.
agree_groups = 0

# ── Undeclared and stale manifest entries ────────────────────────────────────
(dups.keys - COPIES.keys).sort.each do |rel|
  copies = dups[rel]
  groups = copies.group_by { |_demo, path| code_digest(path) }
                 .values.map { |g| "[#{g.map { |d, _| short.(d) }.sort.join(',')}]" }
  errors << "#{rel}: exists in #{copies.size} demos (#{copies.keys.map(&short).sort.join(', ')}) but is not " \
            "declared in bin/check-demo-copies. Add an entry with a rule and a reason " \
            "(:identical / :code / :per_demo). Ignoring comments and whitespace the copies group as " \
            "#{groups.join(' ')}."
end

# ── The recorded exclusion must stay true (K-629) ────────────────────────────
#
# Documentary, but not unchecked: an entry naming a path no longer duplicated,
# or one carrying no reason, is the record turning back into an assumption.
SKELETON_NOT_COMPARED.each do |rel, why|
  errors << "#{rel}: SKELETON_NOT_COMPARED entry carries no reason" if why.to_s.strip.empty?

  ships = demos.count { |dir| File.exist?(File.join(dir, rel)) }
  next if ships >= 2

  errors << "#{rel}: recorded in SKELETON_NOT_COMPARED as a skeleton file this check does not " \
            "compare, but only #{ships} demo ships it — it is not a duplicate any more. Drop the entry."
end

overlap = SKELETON_NOT_COMPARED.keys & COPIES.keys
errors << "#{overlap.join(', ')}: declared BOTH in COPIES and in SKELETON_NOT_COMPARED — a path is " \
          "either compared or recorded as not compared, not both." if overlap.any?

(COPIES.keys - dups.keys).sort.each do |rel|
  where = found[rel]&.keys&.map(&short) || []
  errors << "#{rel}: declared in bin/check-demo-copies but " +
            (where.empty? ? "no demo ships it any more — drop the entry." \
                          : "only #{where.join(', ')} ships it — drop the entry.")
end

# ── The one comparison this whole file exists for ────────────────────────────
COPIES.each do |rel, entry|
  copies = dups[rel] or next

  errors << "#{rel}: manifest entry carries no `why:` reason" if entry[:why].to_s.strip.empty?
  unless %i[identical code per_demo].include?(entry[:rule])
    errors << "#{rel}: unknown rule #{entry[:rule].inspect}"
    next
  end

  present = copies.keys.map(&short)

  # ── The declared SET (K-860, K-883) ──────────────────────────────────────
  # Only for entries that declare one. An unlisted demo shipping the file is a
  # copy nobody reasoned about — which is how the two consumerless copies got
  # here — and a listed demo that no longer ships it is the record turning back
  # into an assumption, the same failure SKELETON_NOT_COMPARED is checked for.
  if entry[:ships]
    stray = present - entry[:ships]
    gone  = entry[:ships] - present
    unless stray.empty?
      errors << "#{rel}: #{stray.sort.join(', ')} #{stray.size == 1 ? 'ships' : 'ship'} this file " \
                "but #{stray.size == 1 ? 'is' : 'are'} not in its declared `ships:` set " \
                "(#{entry[:ships].sort.join(', ')}). A copy is not free: either give that demo a " \
                "driver that USES it and add it to `ships:` with the reason, or delete the copy."
    end
    unless gone.empty?
      errors << "#{rel}: `ships:` names #{gone.sort.join(', ')}, which no longer ship#{gone.size == 1 ? 's' : ''} " \
                "this file — update the declared set."
    end
  end

  excepted = entry[:except] || {}
  excepted.each do |demo, reason|
    errors << "#{rel}: `except:` reason for #{demo} is blank" if reason.to_s.strip.empty?
    errors << "#{rel}: stale `except:` entry for #{demo} — that demo does not ship this file" \
      unless present.include?(demo)
  end
  if entry[:agree] && entry[:rule] != :per_demo
    errors << "#{rel}: `agree:` names the copies of an UNCOMPARED entry that have converged; this " \
              "entry is `:#{entry[:rule]}`, so every copy is already compared against every other " \
              "one and the map records nothing. Drop it (K-1262)."
  end

  if entry[:rule] == :per_demo
    errors << "#{rel}: :per_demo entries are not compared, so `except:` means nothing here" if excepted.any?
    agree_groups += agree_check(rel, "file", copies.to_h { |demo, path| [short.(demo), code_norm(File.read(path))] },
                                entry[:agree], errors)
    next
  end

  digest = entry[:rule] == :identical ? method(:byte_digest) : method(:code_digest)
  compared, skipped = copies.partition { |demo, _| !excepted.key?(short.(demo)) }.map(&:to_h)

  if compared.size < 2
    errors << "#{rel}: every copy but one is excepted — the entry guards nothing. Either drop an " \
              "exception or make the rule :per_demo."
    next
  end

  groups = compared.group_by { |_demo, path| digest.call(path) }
  if groups.size > 1
    how = entry[:rule] == :identical ? "byte-for-byte" : "once comments and whitespace are ignored"
    listed = groups.values.map { |g| "[#{g.map { |d, _| short.(d) }.sort.join(',')}]" }.join(" ")
    errors << "#{rel}: declared :#{entry[:rule]} — the copies must agree #{how}, and they do not: " \
              "#{listed}. Propagate the edit to every copy, or, if the divergence is deliberate, " \
              "record it in this file's `except:` map with the reason."
  end

  # ── The comment `:code` does NOT ignore (K-628) ────────────────────────────
  #
  # code_digest cannot see this: Ripper drops magic comments with every other
  # comment, so a copy that lost `# frozen_string_literal: true` groups with one
  # that kept it. :identical is not checked here — byte equality already implies
  # it, and a second error saying the same thing helps nobody.
  magic = ->(path) { magic_comments(path) }
  if entry[:rule] == :code
    magic_groups = compared.group_by { |_demo, path| magic.call(path) }
    if magic_groups.size > 1
      listed = magic_groups.map do |comments, g|
        "[#{g.map { |d, _| short.(d) }.sort.join(',')}] #{comments.empty? ? '(none)' : comments.join(', ')}"
      end.join(" vs ")
      errors << "#{rel}: declared :code — prose may differ per demo, MAGIC comments may not, because " \
                "they change how the file runs: #{listed}. Add the missing one to every copy (or " \
                "remove it from all of them); `except:` is for real per-demo behaviour, not for this."
    end
  end

  # An exception that is no longer needed is a lie the next reader will believe.
  next unless groups.size == 1

  canonical = groups.keys.first
  canonical_magic = entry[:rule] == :code ? magic.call(compared.values.first) : nil
  skipped.each do |demo, path|
    next unless digest.call(path) == canonical
    next if canonical_magic && magic.call(path) != canonical_magic

    errors << "#{rel}: `except:` for #{short.(demo)} is stale — its copy now agrees with the others. " \
              "Drop the exception so the file is guarded."
  end
end

# ── Template ↔ copy: the drift the lockstep rule cannot see (K-640) ──────────
#
# For each declared template, render it with the generator defaults and require
# every demo copy to byte-match the render — so an engine-side schema edit that
# is not propagated to the demos (or a hand-edit to a copy that is not lifted
# back into the template) fails here instead of surfacing as a runtime column
# error in whichever demo nobody ran.
tpl_files = Dir[File.join(ROOT, GENERATOR_TEMPLATES_DIR, "*.tt")].map { |p| File.basename(p) }

(tpl_files - GENERATOR_TEMPLATES.keys).sort.each do |name|
  errors << "#{GENERATOR_TEMPLATES_DIR}/#{name}: new install-generator template not declared in " \
            "bin/check-demo-copies GENERATOR_TEMPLATES. Add an entry saying what it emits (or why " \
            "it is not compared), so the demos cannot skip regenerating it silently."
end
(GENERATOR_TEMPLATES.keys - tpl_files).sort.each do |name|
  errors << "#{name}: declared in GENERATOR_TEMPLATES but #{GENERATOR_TEMPLATES_DIR} has no such " \
            "template any more — drop the entry."
end

# ── NO LEDGER ID IN A SHIPPED GENERATOR TEMPLATE (K-1298) ────────────────────
#
# These templates are not read, they are WRITTEN — `kiosk:install` copies them
# into a third party's own repository, where a `(K-830)` points at a private
# ledger they cannot open. A live TODO/FIXME still requires its id, which is the
# constitution's rule, so the ban is on the id and not on the marker that needs
# one.
#
# One spelling of «a ledger id», shared by this rule and the demo-tree rule below
# it: two copies of one pattern are two things to be wrong in different ways, and
# both rules are BANS whose obedience and whose blindness print the same zero.
#
# ITS LEADING BOUNDARY IS NOT `\b`. Inside a Ruby string literal `\n` is TWO
# characters — a backslash and the LETTER `n` — so `puts "\nK-724 …"` puts a word
# character immediately before the `K` and a leading `\b` cannot match. Dropping
# the boundary instead would match the hundreds of `SK-001` lines in
# kiosk-demo-skooti's own fixture data (`git grep -cP '[A-Za-z0-9_][KT]-\d{3,4}\b'`
# — PCRE, because an ERE cannot spell `\d` or `\b`). So the boundary HOLDS and an
# ESCAPE RUN is admitted beside it: a backslash and one to five alphanumerics,
# five being the longest escape Ruby spells with an all-alphanumeric body
# (`A`). Everything longer or punctuated (`\u{1F600}`, `\M-\C-x`, a doubled
# `\\`) already ends in a non-word character. The alternation of FIXED-length
# lookbehinds is forced: Onigmo rejects a variable-length one.
LEDGER_ESCAPE_RUN_ALTS = (1..5).map { |n| "(?<=\\\\[A-Za-z0-9]{#{n}})" }.freeze
LEDGER_WORD_START      = "(?:#{LEDGER_ESCAPE_RUN_ALTS.join('|')}|(?<![A-Za-z0-9_]))"
LEDGER_ID_RE = /#{LEDGER_WORD_START}[KT]-\d{3,4}\b/

tpl_files.sort.each do |name|
  path = File.join(GENERATOR_TEMPLATES_DIR, name)
  File.read(File.join(ROOT, path)).each_line.with_index(1) do |line, lineno|
    next unless line =~ LEDGER_ID_RE
    next if line =~ /\b(TODO|FIXME)\b/

    errors << "#{path}:#{lineno}: a ledger id in a template the install generator WRITES INTO A " \
              "CONSUMER'S REPOSITORY -- they cannot resolve it and it is not theirs to carry. " \
              "Say the reason instead of citing the row: #{line.strip[0, 90]}"
  end
end

# ── NO LEDGER ID IN CODE A DEMO RUNS (K-1383) ────────────────────────────────
#
# The rule above bans a ledger id in the install-generator templates, which are
# WRITTEN into a third party's repository. The demo tree has the same reader
# problem for a different reason: a `K-1099` inside a `desc`, an `abort`, a task
# banner or an assertion label is printed AT A TERMINAL, to an operator who cannot
# open the row it names.
#
# So this rule speaks for one reader — the operator at a terminal — and bans the
# id in CODE only. Comments are held next door by `bin/check-shipped-archaeology`,
# which bans a ledger id, an ADR reference and Cyrillic prose in the demo tree's
# comments and prose alike. Phil's standing exemption — `bin/`, `CHANGELOG.md`,
# `CLAUDE.md` — is unchanged in both.
#
# COMMENT versus CODE IS ASKED OF RIPPER, NOT OF A REGEX. `^\s*#` misses a
# trailing comment, and a `#` inside a string literal or a heredoc is not a
# comment at all; both mistakes are silent and both point the wrong way. A file
# the lexer cannot read is an ERROR rather than a skip.
#
# WHAT IS NOT SCANNED, declared rather than assumed:
#   * `kiosk-demo-*/bin/` — Phil's standing exemption, alongside CHANGELOG.md and
#     CLAUDE.md. Those are generator binstubs and maintainer documents, not
#     something a demo prints.
#   * `.md`, `.html`, `.erb`, `.sql` — not Ruby, so «comment» means a different
#     thing in each and Ripper cannot answer for them.
#   * `spec/` and `test/` — developer surfaces. An operator never runs them, and
#     the constitution's own TODO/FIXME rule REQUIRES an id there.
#
# THE VACUITY GUARDS, and note the polarity: this is a BAN, so «no violations» is
# the tree being clean rather than the rule being switched off. Two things are
# asserted about the MECHANISM instead. The file count catches a glob that stopped
# matching or a lexer that stopped running. {DEMO_ID_FIXTURES} — the shapes people
# write, held in this file rather than cited out of the tree — catches the pattern
# itself rotting: each must match {LEDGER_ID_RE}, and the comment/string pair must
# stay separable by the lexer.
DEMO_ID_ROOTS = %w[app lib script config db].freeze
DEMO_ID_TOP   = %w[Rakefile config.ru].freeze

# The shapes people write, owned by this rule. Each must match LEDGER_ID_RE,
# and the pair below must stay separable by the lexer.
DEMO_ID_FIXTURES = [
  "# The past-slot filter, K-480.",
  "# widened by T-158",
  "  desc \"reset the demo\" # K-1099",
  "abort(\"see K-1099\")",
  # K-1537: the shape that was INVISIBLE to this pattern for the whole of its
  # existence. A `\\n` inside a string literal is a backslash and the letter
  # `n`, so the id follows a word character and a leading `\\b` never matches.
  "  puts \"\\nK-480 past-slot filter: ALL PASS\""
].freeze

# THE OTHER HALF OF K-1537, kept executable because the wrong remedy is the
# tempting one: deleting the leading boundary would also match the corpus this
# script scans, which carries kiosk-demo-skooti's own `SK-001` by the hundred.
DEMO_ID_ANTI_FIXTURES = [
  "  SCOOTER = \"SK-001\"",
  "  raise \"OK-1234\"",
  "  # K-12345 has one digit too many"
].freeze
DEMO_ID_IN_COMMENT = "# The past-slot filter, K-480.\n"
DEMO_ID_IN_STRING  = "MSG = \"blocked by K-480\"\n"

demo_id_files   = 0
demo_id_comment = 0
demo_id_unlexed = []

demos.each do |dir|
  paths = DEMO_ID_ROOTS.flat_map { |r| Dir[File.join(dir, r, "**", "*.{rb,rake,ru}")] } +
          DEMO_ID_TOP.map { |n| File.join(dir, n) }.select { |p| File.file?(p) }
  paths.sort.each do |abs|
    rel = abs.delete_prefix("#{ROOT}/")
    src = File.read(abs)
    demo_id_files += 1
    next unless src.match?(LEDGER_ID_RE)

    tokens =
      begin
        Ripper.lex(src)
      rescue StandardError
        nil
      end
    if tokens.nil? || tokens.empty?
      demo_id_unlexed << rel
      next
    end

    tokens.each do |(pos, type, tok, _state)|
      next unless tok.to_s.match?(LEDGER_ID_RE)

      if type == :on_comment
        demo_id_comment += 1
        next
      end

      errors << "#{rel}:#{pos[0]}: a ledger id OUTSIDE a comment, in code this demo RUNS -- it " \
                "reaches an operator's terminal (a `desc` that `rake -D` prints, a task banner, an " \
                "`abort`, an assertion label) and names a private ledger row they cannot open " \
                "(K-1383, the class K-1323 swept and nothing held afterwards). Say what the control " \
                "IS rather than which row filed it — «past-slot filter», not «K-480» — and keep the " \
                "id in a comment beside it if the provenance is worth carrying: " \
                "#{tok.to_s.strip[0, 90]}"
    end
  end
end

if demo_id_files.zero?
  errors << "check-demo-copies: the K-1383 ledger-id rule read 0 Ruby file(s) under " \
            "kiosk-demo-*/{#{DEMO_ID_ROOTS.join(',')}} — the glob has stopped matching, and a BAN " \
            "over an empty corpus reports the same clean zero as an obeyed one, forever."
end
unless demo_id_unlexed.empty?
  errors << "#{demo_id_unlexed.sort.join(', ')}: Ripper returned no tokens for " \
            "#{demo_id_unlexed.one? ? 'this file' : 'these files'}, which carry a ledger id somewhere — " \
            "so the K-1383 rule could not tell a comment from a string in them and did not check them " \
            "at all. A file this rule cannot read must not pass silently."
end
# VACUITY, against a fixture this rule owns rather than against the tree. See
# the paragraph above for why the tree stopped being evidence.
dead_fixtures = DEMO_ID_FIXTURES.reject { _1.match?(LEDGER_ID_RE) }
unless dead_fixtures.empty?
  errors << "check-demo-copies: the K-1383 ledger-id pattern no longer matches its own fixture " \
            "(#{dead_fixtures.map(&:inspect).join(', ')}). LEDGER_ID_RE has stopped matching a " \
            "shape people write, so this ban is holding nothing and its clean zero means nothing."
end

live_anti = DEMO_ID_ANTI_FIXTURES.select { _1.match?(LEDGER_ID_RE) }
unless live_anti.empty?
  errors << "check-demo-copies: the K-1383 ledger-id pattern now matches a shape that is NOT a " \
            "ledger id (#{live_anti.map(&:inspect).join(', ')}). Its leading boundary has been " \
            "dropped rather than taught about escape sequences, and `SK-001` alone is 129 live " \
            "lines of kiosk-demo-skooti -- a ban that reddens on a demo's fixture data is a ban " \
            "somebody switches off."
end

# DERIVED, NOT LISTED (K-1537). The four escape letters somebody thinks of are
# the four that get tested, and `\n` was invisible for the life of this pattern
# because nobody thought of it either. So the arm asks for EVERY single-character
# escape the boundary's own character class can spell.
escape_blind = [*"a".."z", *"A".."Z", *"0".."9"].reject do |c|
  "  MSG = \"\\#{c}K-480 refused\"".match?(LEDGER_ID_RE)
end
unless escape_blind.empty?
  errors << "check-demo-copies: the K-1383 ledger-id pattern misses an id behind the escape(s) " \
            "#{escape_blind.map { "\\#{_1}" }.join(', ')} -- the K-1537 class, where a backslash " \
            "plus a word character stands between the boundary and the id. A ban blind to a " \
            "spelling prints the same clean zero as an obeyed one."
end

fixture_tokens = ->(src) {
  (Ripper.lex(src) || []).select { |(_pos, _type, tok, _st)| tok.to_s.match?(LEDGER_ID_RE) }
}
comment_toks = fixture_tokens.call(DEMO_ID_IN_COMMENT)
string_toks  = fixture_tokens.call(DEMO_ID_IN_STRING)
unless comment_toks.size == 1 && comment_toks.first[1] == :on_comment &&
       string_toks.size == 1 && string_toks.first[1] != :on_comment
  errors << "check-demo-copies: Ripper no longer separates an id in a COMMENT from an id in a " \
            "STRING on this rule's own fixtures (comment → #{comment_toks.map { _1[1] }.inspect}, " \
            "string → #{string_toks.map { _1[1] }.inspect}). The whole ban is that distinction, " \
            "so it cannot be assumed."
end

operator_demos = demos.map { |d| File.basename(d) } - NON_OPERATOR_DEMOS

GENERATOR_TEMPLATES.each do |name, entry|
  next unless tpl_files.include?(name)

  if entry[:not_compared]
    errors << "#{name}: `not_compared:` carries no reason" if entry[:not_compared].to_s.strip.empty?
    next
  end
  if entry[:emits].to_s.strip.empty?
    errors << "#{name}: entry declares neither `emits:` nor `not_compared:` — say what the " \
              "template emits, or why its output is not compared."
    next
  end

  emits  = entry[:emits]
  copies = migrations[emits] || {}
  if copies.empty?
    errors << "#{name}: no demo ships a db/migrate copy of #{emits} — if the demos dropped the " \
              "migration, drop (or `not_compared:`) the entry with the reason. A RENAME is not a " \
              "state this check has any more (K-646): the demos ship the generator's own " \
              "basenames, so a copy under another name is a copy that was not regenerated."
    next
  end

  # ONE_SET_EVERYWHERE (K-646). Every operator demo ships every canonical
  # migration, because every operator demo IS one `kiosk:install` run. A demo
  # missing one is the shape the fleet drifted into before — subsets nobody
  # could adjudicate — and a NEW demo scaffolded from a stale engine is the
  # same failure arriving from the other direction.
  missing = operator_demos - copies.keys
  unless missing.empty?
    errors << "#{name}: #{missing.map(&short).sort.join(', ')} #{missing.size == 1 ? 'ships' : 'ship'} " \
              "no copy of #{emits}, but every operator demo must ship every canonical migration " \
              "(K-646 — the demos are one `kiosk:install` run, not per-demo subsets). Re-run the " \
              "generator into #{missing.size == 1 ? 'that demo' : 'those demos'} and commit the " \
              "output, or — if the migration genuinely left the canonical set — drop the template " \
              "and this entry together."
  end
  extra = copies.keys & NON_OPERATOR_DEMOS
  unless extra.empty?
    errors << "#{name}: #{extra.map(&short).sort.join(', ')} ships #{emits}, but it is declared a " \
              "NON-operator demo (it adopts no Kiosk engine schema). Either it is an operator now " \
              "— drop it from NON_OPERATOR_DEMOS — or the migration does not belong to it."
  end

  rendered = render_template(File.join(ROOT, GENERATOR_TEMPLATES_DIR, name))
  mismatched = copies.reject { |_demo, path| File.read(path) == rendered }
  next if mismatched.empty?

  demo, path = mismatched.first
  a = rendered.lines
  b = File.read(path).lines
  i = (0...[a.size, b.size].max).find { |j| a[j] != b[j] }
  errors << "#{GENERATOR_TEMPLATES_DIR}/#{name}: rendered with the generator's default options " \
            "it must byte-match every demo copy of #{emits}, and " \
            "#{mismatched.keys.map(&short).sort.join(', ')} " \
            "#{mismatched.size == 1 ? 'disagrees' : 'disagree'} (first difference at line " \
            "#{i + 1}: template renders #{(a[i] || '<nothing>').chomp.strip.inspect}, " \
            "#{short.(demo)} has #{(b[i] || '<nothing>').chomp.strip.inspect}). The engine's " \
            "generator output and the demos moved apart — regenerate the demos' copies, or lift " \
            "the copies' edit back into the template, so they move as ONE change. There is NO " \
            "way to record this as a known exception any more (K-646): the four that could be " \
            "recorded in 2026-08 were all still open three months later, which is what a " \
            "recordable exception actually buys."
end

# ── Cross-demo singleton pairs: the migrations neither rule above sees (K-648)
#
# Matched by timestamp-stripped basename, like the template rule — but these
# have no template, so the copies are held against EACH OTHER, like the
# lockstep rule. Detection first: an undeclared pair fails, so a hand-written
# migration copied into a second demo at its own timestamp cannot appear
# silently — the same property the path rule gives paths.
template_basenames = GENERATOR_TEMPLATES.filter_map { |_name, e| e[:emits] }

migrations.each do |base, copies|
  next if copies.size < 2
  next if template_basenames.include?(base)
  # Copies all at ONE shared relative path are the lockstep rule's territory —
  # declared in COPIES, or already failed above as an undeclared duplicate.
  next if copies.values.map { |p| File.basename(p) }.uniq.size == 1
  next if MIGRATION_PAIRS.key?(base)

  spread = copies.map { |d, p| "#{short.(d)}@#{File.basename(p)[/\A\d+/]}" }.sort
  errors << "db/migrate/*_#{base}: ships in #{copies.size} demos at demo-specific timestamps " \
            "(#{spread.join(', ')}) — invisible to the relative-path rule and emitted by no " \
            "install-generator template, so the copies are compared to NOTHING. Declare the " \
            "basename in MIGRATION_PAIRS with a rule and a reason."
end

MIGRATION_PAIRS.each do |base, entry|
  copies = migrations[base] || {}
  label = "db/migrate/*_#{base}"

  errors << "#{label}: MIGRATION_PAIRS entry carries no `why:` reason" if entry[:why].to_s.strip.empty?
  unless %i[identical code].include?(entry[:rule])
    errors << "#{label}: unknown rule #{entry[:rule].inspect} — MIGRATION_PAIRS takes :identical " \
              "or :code (a :per_demo migration pair would be two unrelated files sharing a name; " \
              "record that in the entry's why: by splitting the basenames instead)."
    next
  end
  if copies.size < 2
    errors << "#{label}: declared in MIGRATION_PAIRS but " +
              (copies.empty? ? "no demo ships it any more — drop the entry." \
                             : "only #{copies.keys.map(&short).join(', ')} ships it — drop the entry.")
    next
  end
  if template_basenames.include?(base)
    errors << "#{label}: declared in MIGRATION_PAIRS but GENERATOR_TEMPLATES already holds every " \
              "copy against its template — drop the entry, one declaration per file."
    next
  end
  if copies.values.map { |p| File.basename(p) }.uniq.size == 1
    errors << "#{label}: declared in MIGRATION_PAIRS but every copy now sits at the same relative " \
              "path, which the lockstep rule compares — declare the path in COPIES and drop this " \
              "entry."
    next
  end

  digest = entry[:rule] == :identical ? method(:byte_digest) : method(:code_digest)
  groups = copies.group_by { |_demo, path| digest.call(path) }
  how    = entry[:rule] == :identical ? "byte-for-byte" : "once comments and whitespace are ignored"
  if entry[:drift]
    errors << "#{label}: `drift:` carries no reason" if entry[:drift].to_s.strip.empty?
    if groups.size == 1
      errors << "#{label}: `drift:` is stale — the copies now agree #{how}. Drop the drift so the " \
                "pair is guarded."
    end
  elsif groups.size > 1
    listed = groups.values.map { |g| "[#{g.map { |d, _| short.(d) }.sort.join(',')}]" }.join(" ")
    errors << "#{label}: declared :#{entry[:rule]} — the copies must agree #{how}, and they do " \
              "not: #{listed}. Propagate the edit to every copy, or, if the divergence is " \
              "deliberate, record it as a `drift:` reason with what differs and why."
  end

  # Same K-628 rule as the lockstep loop: prose may differ, MAGIC comments not.
  if entry[:rule] == :code
    magic_groups = copies.group_by { |_demo, path| magic_comments(path) }
    if magic_groups.size > 1
      listed = magic_groups.map do |comments, g|
        "[#{g.map { |d, _| short.(d) }.sort.join(',')}] #{comments.empty? ? '(none)' : comments.join(', ')}"
      end.join(" vs ")
      errors << "#{label}: declared :code — prose may differ per demo, MAGIC comments may not, " \
                "because they change how the file runs: #{listed}."
    end
  end
end

# ── The app/services autoload-once declaration (K-502, re-anchored by T-189) ─
#
# A demo that names an `app/services` constant from
# `config/initializers/kiosk.rb` — an adapter, a broker, a price checker — can only
# do so because app/services is in `config.autoload_once_paths`. Rails sets the
# RELOADABLE autoloader up in its `finisher`, AFTER config/initializers have
# run, so a constant in a normal autoload path is simply not resolvable from an
# initializer; the once loader is set up in `bootstrap`, first. Drop that one
# line and the demo aborts at boot with `NameError: uninitialized constant`.
#
# `config/application.rb` is :per_demo — the module name IS the demo name — so
# nothing above compares this line, and it is the deletable-and-silently-fatal
# kind: no static reader of the initializer would notice. Honest scope: this
# asserts the declaration is PRESENT, not that a boot succeeds; each demo's own
# CI job boots the app.
#
# THE SUBJECT IS DERIVED, NOT NAMED. The demo set is read from the tree — which
# constants app/services actually defines, and whether the initializer names one —
# and the rule is TWO-SIDED: a demo that needs the line must have it, and a demo
# that does not must not carry it. A hand-named subject could never catch the
# second half.
AUTOLOAD_ONCE_PATTERN = /autoload_once_paths\s*<<\s*Rails\.root\.join\("app\/services"\)/

autoload_once_checked = 0
demos.each do |dir|
  demo     = File.basename(dir)
  app_path = File.join(dir, "config/application.rb")
  init     = File.join(dir, "config/initializers/kiosk.rb")
  next unless File.exist?(app_path) && File.exist?(init)

  # Zeitwerk's own inflection: one constant per file, camelised from the name.
  service_constants = Dir[File.join(dir, "app/services/*.rb")]
                      .map { |f| File.basename(f, ".rb").split("_").map(&:capitalize).join }
  initializer = File.read(init)
  named = service_constants.select { |c| initializer.match?(/(?<![A-Za-z0-9_:])#{Regexp.escape(c)}\b/) }
  declared = File.read(app_path).match?(AUTOLOAD_ONCE_PATTERN)
  autoload_once_checked += 1

  if named.any? && !declared
    errors << "#{short.(demo)}: config/initializers/kiosk.rb names #{named.sort.join(', ')} from " \
              "app/services but config/application.rb does not put app/services in " \
              "config.autoload_once_paths — the reloadable autoloader is set up AFTER " \
              "config/initializers run, so that reference would abort the boot with NameError (K-502)"
  elsif named.empty? && declared
    errors << "#{short.(demo)}: config/application.rb puts app/services in " \
              "config.autoload_once_paths, but config/initializers/kiosk.rb names no constant " \
              "defined there#{service_constants.empty? ? ' and the directory is empty' : ''} — the " \
              "once-path is a config line loading nothing, and a non-reloadable path is not free " \
              "(T-189)"
  end
end

if autoload_once_checked.zero?
  errors << "check-demo-copies: the K-502 autoload-once rule read NO demo — it resolves " \
            "config/application.rb and config/initializers/kiosk.rb per demo, and a rule with " \
            "nothing to read passes everything."
end

# ── A deploy/env template may not cite a path that is not there (K-1093) ─────
#
# A template in `deploy/` is the file an operator opens while editing values, and
# a path it cites is a claim the tree can answer. A cite that was true once rots
# silently the day the file moves, while the runbook shipped beside it goes on
# being right — so the two disagree about where a knob lives, and the operator
# reads the wrong one.
#
# `skooti.env.example` is the shape to PREFER and needs no rule at all — it
# names no path, and a
# constant does not rot when a file moves. But a template that DOES cite a path
# must cite one that exists in the demo it configures, which is derived from the
# template's own filename rather than listed here. Only cites containing a `/`
# are read: a bare `production.rb` names a file without saying where it lives,
# and this rule will not guess for it.
ENV_TEMPLATE_DIR  = "deploy/env"
ENV_TEMPLATE_CITE = %r{(?<![\w./-])(?!/)[a-z][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_.-]+)+\.(?:rb|yml|yaml|erb)\b}

env_templates = 0
env_cites     = 0
Dir[File.join(ROOT, ENV_TEMPLATE_DIR, "*.env.example")].sort.each do |tpl|
  stem = File.basename(tpl, ".env.example")
  demo = File.join(ROOT, "kiosk-demo-#{stem}")
  # kyc-demo.env.example configures the prove broker under a name of its own and
  # has no `kiosk-demo-<stem>` to resolve against; skipping it is deliberate and
  # is why the count below is asserted rather than assumed.
  next unless File.directory?(demo)

  env_templates += 1
  File.readlines(tpl).each_with_index do |line, i|
    line.scan(ENV_TEMPLATE_CITE).each do |cite|
      env_cites += 1
      next if File.exist?(File.join(demo, cite))

      errors << "#{ENV_TEMPLATE_DIR}/#{File.basename(tpl)}:#{i + 1}: cites `#{cite}`, which does " \
                "not exist in kiosk-demo-#{stem} (K-1093). A shipped template is what an operator " \
                "opens while editing values, so a path in it is followed — name the CONSTANT " \
                "instead, the way skooti.env.example does, since a constant does not rot when a " \
                "file moves; or cite the path the demo actually has."
    end
  end
end

if env_templates.zero? || env_cites.zero?
  errors << "check-demo-copies: the K-1093 template-cite rule read #{env_templates} template(s) " \
            "and #{env_cites} path cite(s) — either #{ENV_TEMPLATE_DIR}/ moved, the templates no " \
            "longer share a stem with their demo directory, or the cite pattern stopped matching. " \
            "A rule that inspects nothing passes everything."
end

# ── A shared UNIT inside a `:per_demo` file (T-120) ──────────────────────────
#
# The lockstep rule's handle is a relative PATH, so a method or constant shared by
# two demos inside a file the manifest calls `:per_demo` — «not compared» — sits
# BELOW its granularity and is compared to nothing. So the unit is DECLARED and
# COMPARED. What it takes from the file-level manifest, and what it does not:
#
#   * TAKES the `ships:` declaration and the two-directional staleness check, so a
#     demo growing a copy fails rather than becoming another copy nobody reasoned
#     about, and a demo losing one fails too.
#   * TAKES the file-level manifest's `except:` map — «one copy that legitimately
#     differs from its siblings» — one level down, because without it the manifest
#     could not state a true thing: `app/models/user.rb#devise` loads an extra
#     Devise module in tudu alone, the one demo whose humans sign themselves up,
#     and the only declarable file-level rule was `:per_demo`. The exception is
#     checked exactly as hard as the file-level one: a reason may not be blank, an
#     exception for a demo that no longer defines the unit is stale, an exception
#     whose copy has CONVERGED on its siblings is stale, and an entry where every
#     copy but one is excepted guards nothing and says so.
#   * TAKES the loud-failure-on-unreadable rule: a unit the extractor cannot read
#     back as valid Ruby is an ERROR, never a silent skip, because a lockstep rule
#     with nothing to compare passes everything.
#   * DOES NOT take «compare the prose too». Each copy's prose is that demo's own
#     reasoning about its own arguments, and each is correct. So the comparison is
#     `:code` — the manifest's own «identical once comments and whitespace are
#     normalised away» — applied one level down through the same {code_norm}.
#
# DISCOVERY, not just declaration, is the half that makes this a check rather than
# a list: every unit name that appears in TWO OR MORE copies of a declared path
# must be in FRAGMENTS, so a new shared method cannot appear silently. It is also
# why a shared NAME with different bodies is declared `:per_demo` here rather than
# left out — a reader should be told once instead of discovering it by diffing.
#
# THE CRITERION FOR TAKING A PATH, so the next one is judged the same way: take it
# when every unit shared by two or more copies is either identical, or differs for
# a reason that belongs to the DEMO — its own vocabulary, its own fixture, its own
# operator identity. Leave it when a shared name differs only by HARNESS
# GENERATION, because a `:per_demo` fragment entry would then record an accident as
# a decision. Either way the path is declared: every `:per_demo` path is in
# FRAGMENT_PATHS or named in FRAGMENT_EXCLUDED with a reason, and a declared path
# that shares NOTHING is reported by name rather than counted as a file this rule
# holds.
#
# HOW MANY UNITS THE FLEET SHARES IS WHAT A BARE RUN ANSWERS, and it answers by
# failing on the pair that drifted rather than by printing a total. No count of
# them is written down here.
FRAGMENT_PATHS = %w[
  app/controllers/home_controller.rb
  app/models/booking.rb
  app/models/user.rb
  app/operations/wire_arguments.rb
].freeze

# AND THE PATHS THAT ARE NOT IN IT, DECLARED. Every `:per_demo` entry in COPIES is
# either in FRAGMENT_PATHS or named here with a reason, and the check below fails
# on a path in neither, on an entry for a path that is not `:per_demo`, on an entry
# that is also in FRAGMENT_PATHS, and on a blank reason. An undeclared exclusion
# reads exactly like coverage, which is what this list exists to prevent.
FRAGMENT_EXCLUDED = {
  "spec/spec_helper.rb"         => "Each demo's own test setup; nothing in it is meant to be shared.",
  "test/test_helper.rb"         => "Each demo's own test setup; nothing in it is meant to be shared.",
  "test/wire_arguments_test.rb" => "Each demo's own argument checks.",
  "test/wire/binding_test.rb"      => "Their shared helpers are held by name in SPEC_UNITS.",
  "test/wire/discovery_test.rb"    => "Their shared helpers are held by name in SPEC_UNITS.",
  "test/wire/isolation_test.rb"    => "Their shared helpers are held by name in SPEC_UNITS.",
  "test/wire/registration_test.rb" => "Their shared helpers are held by name in SPEC_UNITS.",
  "test/wire/walkthrough_test.rb"  => "Their shared helpers are held by name in SPEC_UNITS.",
  "script/redteam_suite.rb" =>
    "What these seven copies still share by NAME is the `Scenario` subclass vocabulary — " \
    "`initialize`, `call`, `refused`, `check`, `pay_with_ref` — over beats that attack " \
    "different verbs, so the bodies genuinely differ and always will. The HTTP driver, the " \
    "result ledger, the printed vocabulary and the exit contract are `Kiosk::Redteam::Wire` " \
    "and `Kiosk::Redteam::Battery`, held by that gem's own suite rather than by a copy " \
    "comparison. Discovery is all-or-nothing per path, so taking this one would mean " \
    "declaring twenty settled `:per_demo` variants to hold a handful of units — a manifest " \
    "nobody reads, for a guarantee the gem already gives.",
  "app/services/price_checker.rb" =>
    "The one shared unit is `self.call`, the interface `c.cart_price_checker` fixes; its body is " \
    "each operator's own catalog and differs by design.",
}.freeze

FRAGMENTS = {
  "app/operations/wire_arguments.rb#MAX_INT4" => {
    rule:  :code,
    ships: %w[atablefor getgrocery hoteling],
    why:   "PostgreSQL `integer`, 2_147_483_647 — the width of the column each demo's guard " \
           "refuses on behalf of (`bookings.party_size`/`restaurant_tables.capacity`, " \
           "`order_items.qty`/`orders.total_cents`, `properties.stars`/`bookings.total_cents`). " \
           "It is the same NUMBER for the same REASON in all three, and K-968's rule — the bound " \
           "is the column's and not a policy — is what makes that a shared fact rather than three " \
           "coincidences. hoteling's copy is the newest (T-125) and folded in the " \
           "`MAX_TOTAL_CENTS` it used to carry under its own name; holding the three in lockstep " \
           "is what stops the next demo inventing a fourth spelling of int4.",
  },

  # ── the shipped per-demo files (T-136) ────────────────────────────────────
  #
  # Lower unit counts than the drivers and higher stakes: these are files an
  # operator copies, so a shared unit here is shared PRODUCT code. Where the
  # file-level `why:` above already carries the argument, these entries point at
  # it instead of restating it — a second copy of a reason is a second thing to
  # keep true.
  # ── the DSL units the T-146 handle made visible ───────────────────────────
  #
  # Every one of these is a class-body macro, which `FRAGMENT_START` could not
  # see until 2026-08-31. They are declared here for the same reason every other
  # entry is: `:per_demo` means compared to nothing, and a shared `scope` or a
  # shared association is exactly as hand-copied as a shared `def`.
  "app/models/user.rb#devise" => {
    rule:   :code,
    ships:  %w[atablefor getgrocery hoteling philslist skooti stylish tudu],
    except: {
      "tudu" => "tudu is the one demo whose HUMANS SIGN THEMSELVES UP, so its copy reads " \
                "`devise :database_authenticatable, :registerable` where the other six read " \
                "`devise :database_authenticatable`. `:registerable` is what mounts Devise's " \
                "public sign-up route; on the other six the operator's human account is seeded " \
                "and a self-service registration route on those origins would be a way in that " \
                "nobody designed. The difference is one module name and it is deliberate.",
    },
    why:    "WHICH DEVISE MODULES THE OPERATOR'S HUMAN IdP LOADS — and the six that agree are HELD " \
            "here, which until K-1263 gave this rule an `except:` they could not be. The entry was " \
            "`:per_demo` because neither available declaration was true: `:code` failed on tudu, " \
            "and pinning `ships:` to the six failed on tudu as a stray, since discovery requires " \
            "every copy of a shared unit to be in its entry's set. So six copies of an " \
            "authentication line were compared to NOTHING while the manifest read as coverage. " \
            "With the exception declared, one of the six quietly losing " \
            "`:database_authenticatable` — or quietly gaining `:registerable` — fails here.",
  },
  "app/models/user.rb#has_many" => {
    rule:  :per_demo,
    ships: %w[atablefor hoteling philslist skooti stylish tudu],
    agree: {
      %w[atablefor hoteling] => {
        rule: :coincidence,
        why:  "`has_many :bookings, dependent: :destroy` in both, and the entry's own `why:` below " \
              "already says why: a restaurant table and a hotel room are both BOOKED, so two " \
              "unrelated products spell one line identically. One line, no arguments that differ, " \
              "nothing to hold — and holding it would make hoteling adding a second association a " \
              "red build (K-1262). The membership is what is checked: a third demo joining this " \
              "pair means three owners now spell their rows the same way, which is worth a look.",
      },
    },
    why:   "SAME MACRO, EACH DEMO'S OWN ROWS: bookings, reservations, appointments, listings, " \
           "lists and memberships. atablefor and hoteling happen to spell it identically because " \
           "both own `bookings`; philslist and tudu carry an explicit `foreign_key`/`inverse_of` " \
           "pair because their owning column is not `user_id`. Nothing here should be shared — " \
           "declared so the association SET is under the discovery rule, which is what notices a " \
           "seventh demo growing one.",
  },
  "app/models/booking.rb#belongs_to" => {
    rule:  :per_demo,
    ships: %w[atablefor hoteling],
    why:   "SAME MACRO, EACH DEMO'S OWN PARENTS — `user`/`restaurant`/`restaurant_table` against " \
           "`user`/`property`/`room_type`. One unit rather than three (the head is the handle), " \
           "so what is compared is the whole association SET in file order: an association DROPPED " \
           "in one copy is the drift this rule exists for, and a per-association name would report " \
           "it as a unit that merely stopped being shared.",
  },
  "app/models/booking.rb#include" => {
    rule:  :code,
    ships: %w[atablefor hoteling],
    why:   "`include Kiosk::Owned`, the framework's owner scope.",
  },
  "app/models/booking.rb#enum" => {
    rule:  :per_demo,
    ships: %w[atablefor hoteling],
    why:   "Each booking's own lifecycle.",
  },
  "app/operations/wire_arguments.rb#refuse" => {
    rule:  :code,
    ships: %w[atablefor getgrocery hoteling],
    why:   "Raises the 400 every argument check answers with.",
  },
  "app/operations/wire_arguments.rb#priceable_total!" => {
    rule:  :per_demo,
    ships: %w[getgrocery hoteling],
    why:   "Each demo bounds its own total column.",
  },
  "app/models/booking.rb#scope" => {
    rule:  :per_demo,
    ships: %w[atablefor hoteling],
    why:   "SAME MACRO, DIFFERENT SETS: atablefor declares `confirmed` and `on_board`; " \
           "hoteling declares `live` and `overlapping`, the room-night predicate its EXCLUDE " \
           "constraint mirrors.",
  },

  "app/models/user.rb#public_name" => {
    rule:  :per_demo,
    ships: %w[atablefor tudu],
    why:   "SAME NAME, EACH DEMO'S OWN NOUN: the fallback handle for an account with no display " \
           "name is `diner-<12 hex>` on a restaurant origin and `member-<12 hex>` on a to-do one. " \
           "The digest and the truncation are identical; only the word a human would recognise " \
           "differs, which is the right thing to differ and the wrong thing to discover by diffing.",
  },
  "app/controllers/home_controller.rb#index" => {
    rule:  :per_demo,
    ships: %w[atablefor getgrocery hoteling philslist prove skooti stylish],
    why:   "Seven landing pages, seven bodies — this is the ONE unit those seven files share, and " \
           "each demo's home page is that storefront's own. Declared so the path is under the " \
           "discovery rule at all: a helper that appears in two of these seven controllers is a " \
           "thing to notice, and until this entry nothing would have.",
  },
}.freeze

# One unit = EVERY `def` of that name in the file (endless or not, singleton or
# not), or every assignment to that constant — each taken from its first line and
# GROWN until Ripper can parse it, then concatenated in file order.
#
# Growing rather than matching a column-0 `end`, because these live inside a `module … end` at an indentation the next file may
# not share, and because a `def foo = expr` has no `end` at all. The parse is
# the terminator AND the validity check in one: a fragment that never parses is
# reported rather than silently dropped.
#
# EVERY definition and not the FIRST: a name may be defined more than once in one
# file — the payment-window tests each carry two processor stubs that both define
# `initialize`, `capture` and `setup_required?` — so the definitions are
# concatenated in file order, and a copy that edits its SECOND `capture`, or
# reorders the two classes, fails.
FRAGMENT_START = /\A\s*(?:def\s+(?:self\.)?([a-z_][A-Za-z0-9_]*[?!=]?)|([A-Z][A-Za-z0-9_]*)\s*=[^=~>])/
FRAGMENT_MAX_LINES = 200

# THE SECOND HANDLE: A CLASS-BODY MACRO.
#
# `FRAGMENT_START` above is a `def` or a constant, so a unit written in a DSL — a
# shared `scope`, `has_many` or `self.table_name` — needs this second handle.
#
# THE HANDLE IS DERIVED, NOT LISTED, and that is the whole design. A vocabulary of
# macro heads — `scope`, `validates`, `has_many` — is the hand-kept inventory this
# repository has been wrong about repeatedly: a head nobody thought of is invisible,
# and a head that stops occurring reads as coverage forever. So the start points
# come from the PARSE TREE instead: every statement in a `class` or `module` body
# that is a bare method call — `scope :x, -> {...}`, `has_many :y`,
# `devise :database_authenticatable`, `layout false` — plus every `self.<attr> = …`
# assignment. A macro this repository has never used before is reached the day it
# is written, with no edit here.
#
# THE NAME IS THE HEAD ALONE, not the head and its first argument, so `belongs_to`
# is ONE unit holding every association in file order — exactly as `capture` is one
# unit holding both PSP stubs' definitions above. An association DELETED in one
# copy is the drift this rule exists for, and a per-argument name would report it
# as a unit that simply stopped being shared.
#
# WHAT IT STILL CANNOT SEE, stated because an over-claimed handle is this rule's
# own recurring defect: a macro called at the top level of a file rather than in a
# class or module body; a macro generated by another macro; a `def` created by
# `define_method`; and any shared code that is neither a definition nor a
# class-body statement. The vacuity arm below is the only thing that can tell you
# the handle has stopped finding anything at all.
def class_macro_starts(node, out = [])
  return out unless node.is_a?(Array)

  unless %i[class module].include?(node[0])
    node.each { |child| class_macro_starts(child, out) if child.is_a?(Array) }
    return out
  end

  body = node.last
  stmts = (body.is_a?(Array) && body[0] == :bodystmt) ? (body[1] || []) : []
  stmts.each do |stmt|
    next unless stmt.is_a?(Array)

    head =
      case stmt[0]
      when :command          then stmt[1]
      when :method_add_arg   then stmt[1].is_a?(Array) && stmt[1][0] == :fcall ? stmt[1][1] : nil
      when :method_add_block then stmt[1].is_a?(Array) && stmt[1][0] == :command ? stmt[1][1] : nil
      when :assign           then nil
      end
    out << [head[2][0] - 1, head[1]] if head.is_a?(Array) && head[0] == :@ident

    if stmt[0] == :assign && (t = stmt[1]).is_a?(Array) && t[0] == :field &&
       t[1].is_a?(Array) && t[1][0] == :var_ref && t[1][1].is_a?(Array) && t[1][1][1] == "self" &&
       t.last.is_a?(Array) && t.last[0] == :@ident
      out << [t.last[2][0] - 1, "self.#{t.last[1]}"]
    end

    class_macro_starts(stmt, out)
  end
  out
end

# A unit's start points, by line index. Both handles feed the same growth loop,
# and `FRAGMENT_START` wins a line the two would both claim (there is no such
# line today — a `def` is not a class-body macro call — but the precedence has
# to be stated rather than left to hash ordering).
def fragment_starts(src)
  starts = {}
  macro = {}
  sexp = Ripper.sexp(src)
  class_macro_starts(sexp).each { |(i, name)| starts[i] = macro[i] = name } if sexp
  src.lines.each_with_index do |line, i|
    m = line.match(FRAGMENT_START) or next

    starts[i] = m[1] || m[2]
    macro.delete(i)
  end
  [starts, macro.values.uniq, sexp.nil?]
end

# => [units, unreadable, dsl_names] — `dsl_names` is what the T-146 handle
# contributed and nothing else would have found, which is what the vacuity arm
# below counts.
def fragment_units(path)
  src = File.read(path)
  lines = src.lines
  units = Hash.new { |h, k| h[k] = +"" }
  unreadable = []
  starts, dsl_names, whole_file_unparsable = fragment_starts(src)
  unreadable << "the file itself, so the DSL handle saw no class body at all" if whole_file_unparsable
  starts.keys.sort.each do |i|
    name = starts[i]
    unit = (i...[i + FRAGMENT_MAX_LINES, lines.size].min).lazy
                                                         .map { |j| lines[i..j].join }
                                                         .find { |cand| !Ripper.sexp(cand).nil? }
    unit ? units[name] << unit : unreadable << "#{name} (line #{i + 1})"
  end
  [units.to_h, unreadable, dsl_names]
end

# Every `:per_demo` path is IN the fragment rule or declared OUT of it (T-146).
per_demo_paths = COPIES.select { |_rel, e| e[:rule] == :per_demo }.keys
(per_demo_paths - FRAGMENT_PATHS - FRAGMENT_EXCLUDED.keys).sort.each do |rel|
  errors << "#{rel}: declared `:per_demo` in COPIES — compared to NOTHING — but named neither in " \
            "FRAGMENT_PATHS nor in FRAGMENT_EXCLUDED. Take it, or say why the shared units inside " \
            "it are not worth holding. An undeclared exclusion reads exactly like coverage (T-146)."
end
FRAGMENT_EXCLUDED.each do |rel, why|
  errors << "#{rel}: FRAGMENT_EXCLUDED entry carries no reason (T-146)." if why.to_s.strip.empty?
  if FRAGMENT_PATHS.include?(rel)
    errors << "#{rel}: named in BOTH FRAGMENT_PATHS and FRAGMENT_EXCLUDED — a path is either " \
              "walked by the fragment rule or declared out of it, not both (T-146)."
  elsif COPIES[rel].nil?
    errors << "#{rel}: declared in FRAGMENT_EXCLUDED, but COPIES has no entry for it — the " \
              "exclusion is for a path this check does not know about (T-146)."
  elsif COPIES[rel][:rule] != :per_demo
    errors << "#{rel}: declared in FRAGMENT_EXCLUDED, but the manifest now compares it whole " \
              "(`rule: #{COPIES[rel][:rule].inspect}`), so there is nothing for the fragment rule " \
              "to be excluded from. Drop the entry (T-146)."
  end
end

fragment_dsl_ids = {} # "path#unit" reached ONLY by the T-146 class-macro handle
fragment_sources = Hash.new { |h, k| h[k] = {} } # "path#unit" => demo => source
FRAGMENT_PATHS.each do |rel|
  entry = COPIES[rel]
  if entry.nil?
    errors << "check-demo-copies: FRAGMENT_PATHS names #{rel}, which has no COPIES entry — the " \
              "fragment rule reaches inside a file the manifest does not know about (T-120)."
    next
  end
  unless entry[:rule] == :per_demo
    errors << "check-demo-copies: FRAGMENT_PATHS names #{rel}, but the manifest now compares it " \
              "whole (`rule: #{entry[:rule].inspect}`), so every unit inside it is already held. " \
              "Drop it from FRAGMENT_PATHS rather than checking the same bytes twice (T-120)."
    next
  end

  demos.each do |dir|
    demo = short.(File.basename(dir))
    path = File.join(dir, rel)
    next unless File.exist?(path)

    units, unreadable, dsl_names = fragment_units(path)
    dsl_names.each { |name| fragment_dsl_ids["#{rel}##{name}"] = true }
    unless unreadable.empty?
      errors << "#{demo}: #{rel} — the fragment rule could not read #{unreadable.join(', ')} back " \
                "as valid Ruby within #{FRAGMENT_MAX_LINES} lines, so it compared NOTHING for " \
                "#{unreadable.size == 1 ? 'that unit' : 'those units'}. Fix the extraction in " \
                "bin/check-demo-copies, do not drop the rule (T-120)."
    end
    units.each { |name, src| fragment_sources["#{rel}##{name}"][demo] = code_norm(src) }
  end
end

# DISCOVERY: a unit in two or more copies must be declared. This is the property
# the file-level manifest has, one level down.
fragment_sources.each do |id, per_demo|
  next if per_demo.size < 2
  next if FRAGMENTS.key?(id)

  errors << "#{id}: shared by #{per_demo.keys.sort.join(', ')} inside a `:per_demo` file, and " \
            "undeclared. `:per_demo` means the copies are compared to NOTHING, so a method that " \
            "has quietly become shared drifts exactly the way `schedule_delivery` and " \
            "equihash_register.rb's constant did. Declare it in FRAGMENTS in bin/check-demo-copies " \
            "with its `ships:` set and the reason the copies exist (T-120)."
end

fragment_comparisons     = 0
fragment_exceptions_live = 0
FRAGMENTS.each do |id, entry|
  rel = id.split("#").first
  unless FRAGMENT_PATHS.include?(rel)
    errors << "#{id}: declared in FRAGMENTS, but #{rel} is not in FRAGMENT_PATHS, so nothing ever " \
              "looks for it. Add the path or drop the entry (T-120)."
    next
  end
  errors << "#{id}: FRAGMENTS `why:` is blank" if entry[:why].to_s.strip.empty?

  per_demo = fragment_sources[id]
  if per_demo.size < 2
    errors << "#{id}: declared in FRAGMENTS, but it now exists in " \
              "#{per_demo.empty? ? 'no demo' : "only #{per_demo.keys.first}"} — a lockstep entry " \
              "for a unit that is no longer shared is the record turning back into an assumption. " \
              "Drop it (T-120)."
    next
  end

  stray = per_demo.keys.sort - entry[:ships]
  gone  = entry[:ships] - per_demo.keys
  unless stray.empty?
    errors << "#{stray.join(', ')}: defines #{id} but #{stray.size == 1 ? 'is' : 'are'} not in " \
              "that entry's `ships:` set (#{entry[:ships].join(', ')}). A copy of a shared unit is " \
              "not free — add the demo so its copy is held with the others, or give the copy its " \
              "own name (T-120)."
  end
  unless gone.empty?
    errors << "#{gone.join(', ')}: named in #{id}'s `ships:`, but #{rel} there defines no " \
              "`#{id.split('#').last}` any more. Either the demo stopped needing it — update the " \
              "declared set — or the unit was renamed in one copy, which is the drift this rule " \
              "exists for (T-120)."
  end

  # ── `except:` — the K-643 escape hatch, one level down (K-1263) ──────────
  unit_name = id.split("#", 2).last
  excepted  = entry[:except] || {}
  excepted.each do |demo, reason|
    errors << "#{id}: `except:` reason for #{demo} is blank" if reason.to_s.strip.empty?
    unless entry[:ships].include?(demo)
      errors << "#{id}: `except:` names #{demo}, which is not in this entry's `ships:` set " \
                "(#{entry[:ships].join(', ')}) — an exception can only excuse a copy the rule " \
                "would otherwise compare (K-1263)."
    end
    next if per_demo.key?(demo)

    errors << "#{id}: stale `except:` entry for #{demo} — #{rel} there defines no `#{unit_name}` " \
              "any more, so the exception excuses nothing. Drop it (K-1263)."
  end
  if excepted.any? && entry[:rule] != :code
    errors << "#{id}: `except:` excuses one copy from a COMPARISON, and `rule: " \
              "#{entry[:rule].inspect}` compares nothing, so it means nothing here. Either the " \
              "other copies are held — then the rule is `:code` — or they are not, and the " \
              "exception is decoration (K-1263)."
  end

  held   = per_demo.select { |demo, _| entry[:ships].include?(demo) }
  next if held.size < 2

  fragment_comparisons += held.size
  case entry[:rule]
  when :code
    compared, excused = held.partition { |demo, _| !excepted.key?(demo) }.map(&:to_h)
    if compared.size < 2
      errors << "#{id}: every copy but one is excepted — the entry guards nothing. Either drop an " \
                "exception or make the rule `:per_demo` and say the copies are not compared (K-1263)."
      next
    end
    fragment_exceptions_live += excused.size
    groups = compared.group_by { |_demo, src| src }
    unless groups.size == 1
      listed = groups.values.map { |g| "[#{g.map { |d, _| d }.sort.join(',')}]" }.sort.join(" ")
      errors << "#{id}: the copies must agree once comments and whitespace are normalised away, and " \
                "they do not: #{listed}. This unit is hand-copied into #{compared.size} demos — " \
                "propagate the edit to all of them, or, if one copy legitimately differs, declare it " \
                "in this entry's `except:` map with the reason, or give it a " \
                "different NAME and say why, because a shared name with different behaviour is what " \
                "makes the next reader trust the wrong copy (T-120, K-1263)."
      next
    end

    # An exception that is no longer needed is a lie the next reader will
    # believe — the same arm the file-level rule has carried since K-643.
    canonical = groups.keys.first
    excused.each do |demo, src|
      next unless src == canonical

      errors << "#{id}: `except:` for #{demo} is stale — its copy now agrees with the others once " \
                "comments and whitespace are normalised away. Drop the exception so the copy is " \
                "HELD with its siblings (K-1263)."
    end
  when :per_demo
    # Not «are they ALL the same» any more: any SUBSET that agrees is a
    # hand-copied unit nothing compares, and the unanimous case is the one
    # branch of that (K-1262).
    agree_groups += agree_check(id, "unit", held, entry[:agree], errors)
  else
    errors << "#{id}: unknown `rule: #{entry[:rule].inspect}` — the fragment rule understands " \
              ":code and :per_demo only (T-120)."
  end
end

# VACUITY FOR THE EXCEPTION MECHANISM. `except:` is an EXEMPTION, not a ban, so
# «its pattern must match something» is the right direction here: an exception that
# is never REACHED is not excusing anything, and the entry it sits in would then be
# comparing copies it thinks it is not. The two arms above cover a single entry
# (stale demo, converged copy); this one covers the mechanism — if the manifest
# declares exceptions and none of them was live in this run, the partition stopped
# running rather than the tree stopped needing it.
declared_exceptions = FRAGMENTS.sum { |_, e| (e[:except] || {}).size }
if declared_exceptions.positive? && fragment_exceptions_live.zero?
  errors << "check-demo-copies: FRAGMENTS declares #{declared_exceptions} `except:` " \
            "entr#{declared_exceptions == 1 ? 'y' : 'ies'} and NONE of them was reached — every " \
            "excepted copy is outside its entry's `ships:` set, or the `:code` arm stopped " \
            "partitioning. An exemption that excuses nothing is a hole the manifest believes it " \
            "has closed (K-1263)."
end

if FRAGMENTS.any? && fragment_comparisons.zero?
  errors << "check-demo-copies: the T-120 fragment rule declares #{FRAGMENTS.size} unit(s) and " \
            "compared NONE of them — the units have moved out of #{FRAGMENT_PATHS.join(', ')}, and " \
            "a lockstep rule with nothing to compare passes everything."
end

# VACUITY FOR THE PARTIAL-CONVERGENCE RULE, AND IT IS DELIBERATELY NOT «THE PATTERN
# MUST MATCH SOMETHING».
#
# That arm is right for a rule that LOOKS for a thing and wrong for a rule that
# FORBIDS one. `agree:`'s discovery half is a ban — no undeclared group of agreeing
# copies inside a `:per_demo` entry — and a ban whose violations match nothing is
# the ban being obeyed. So the liveness is asserted on the DECLARATIONS instead,
# through exactly the machinery the ban uses: every declared group is re-derived
# from the tree by the same grouping pass, and the count of groups CONFIRMED that
# way is checked against the count declared. If the grouping stops running nothing
# is grouped, so nothing is undeclared, so the ban passes silently — and it cannot
# pass silently AND confirm a declared group at the same time. What must be alive
# is the measurement, not the offence.
declared_agree_groups = COPIES.sum { |_, e| (e[:agree] || {}).size } +
                        FRAGMENTS.sum { |_, e| (e[:agree] || {}).size }
if declared_agree_groups.positive? && agree_groups.zero?
  errors << "check-demo-copies: the manifest declares #{declared_agree_groups} `agree:` group(s) of " \
            "converged `:per_demo` copies and this run CONFIRMED none of them against the tree. " \
            "Every declared group is re-derived by the same grouping pass that catches an " \
            "UNDECLARED one, so zero confirmations means that pass stopped running — and a " \
            "convergence tripwire that groups nothing reports no partial convergence, ever, while " \
            "exiting 0 (K-1262)."
end

# VACUITY, TWO ARMS.
#
# The first: a declared path that shares NOTHING is NAMED. A path contributing
# nothing otherwise looks exactly like a path that has been checked.
FRAGMENT_PATHS.each do |rel|
  shared = fragment_sources.count { |id, per_demo| id.start_with?("#{rel}#") && per_demo.size >= 2 }
  next if shared.positive?

  errors << "#{rel}: named in FRAGMENT_PATHS, and the extractor finds NO unit shared by two or " \
            "more of its copies — so this path contributes nothing while it reads as a " \
            "file the fragment rule holds. Either its copies stopped sharing anything, in which " \
            "case move it to FRAGMENT_EXCLUDED with that as the reason, or the handle cannot see " \
            "what they share, in which case say which construct and fix the handle (T-146)."
end

# The second: a rule whose pattern matches nothing in this repository must fail
# rather than pass. If the class-macro handle ever stops finding a class body at
# all — a Ripper change, a walker that stops matching a node shape — every DSL unit
# silently leaves the corpus.
if fragment_dsl_ids.empty?
  errors << "check-demo-copies: the T-146 class-macro handle found NO class-body macro in any " \
            "copy of the #{FRAGMENT_PATHS.size} declared `:per_demo` path(s); zero means the " \
            "handle has stopped working rather than that the tree has changed."
end

# ── THE DEMO SPEC HARNESS, HELD BY UNIT NAME RATHER THAN BY PATH (K-1536) ───
#
# WHERE THE DUPLICATION ACTUALLY IS: THE UNIT, NOT THE PATH. A demo's `spec/`
# reaches this script only through EXTRA_SCANNED, and of the tracked files under
# `kiosk-demo-*/spec` and `kiosk-demo-*/test` almost every one sits at a path
# unique to its demo — so a file-level entry would compare a copy against nothing
# at all. What IS hand-copied is the harness: `assert`, `guard` and their fixtures,
# across files at different paths, and `at_dublin` across two spec files INSIDE one
# demo. No rule keyed on a path, or on a demo, can see those, so this rule keys on
# the NAME over the whole corpus.
#
# THE REACH OF EACH RULE IS COUNTED, NOT ASSERTED. FRAGMENTS' key is `path#unit`,
# so it reaches exactly those copies whose own relative path is declared in
# FRAGMENT_PATHS; how many of this corpus's files that is, and how many it already
# holds, is printed by the run rather than claimed in a sentence.
#
# THE CORPUS IS DERIVED, never listed — `git ls-files` over the two subdirectory
# globs, filtered to `.rb`, with a filesystem walk behind it for the throwaway tree
# `--self-test` runs in, where `git` exits 128. A demo that grows a spec directory
# tomorrow is in the corpus that day.
#
# THE DELEGATION IS DERIVED TOO. A name whose every copy sits at a path
# FRAGMENT_PATHS walks, under an id FRAGMENTS declares, is already HELD one level
# up; it is reported as delegated and is NOT re-declared here, so the two rules
# compose instead of stating the same thing twice. The day such a unit is copied
# into a file outside that path it stops being delegated and this manifest has to
# speak for it — which is the event that matters.
DEMO_SPEC_SUBDIRS = %w[spec test].freeze

# `:code`     — every copy must agree once comments and whitespace are
#               normalised away, the same semantics `:code` has at file level
#               and in FRAGMENTS.
# `:per_file` — SAME NAME, each file's own body, with the reason. A `:per_file`
#               name whose copies have ALL converged is an error, not a pass:
#               that is the entry describing a state the tree has left.
SPEC_UNITS = {
  "LISBON" => { rule: :per_file, why: "A named zone in each clock test." },
  "refusal" => { rule: :per_file, why: "Each test file's own assert_raises shorthand." },
  "include" => {
    rule: :per_file,
    why:  "Each file's own mixins, concatenated in file order: the live-server harness, the " \
          "conformance assertions, the seeded-database or KYC helpers its tests need.",
  },
  "wire" => {
    rule: :per_file,
    why:  "The bare transport: atablefor and tudu memoise one per test, stylish builds one per " \
          "call behind its private `post`.",
  },
  "book" => { rule: :per_file, why: "Each demo's own booking verb and arguments." },
  "get" => {
    rule: :per_file,
    why:  "Each discovery test's credential-free GET; the copies differ in what they hand back " \
          "(the response, or the parsed body).",
  },
  "solved" => {
    rule: :per_file,
    why:  "A solved toll: atablefor answers every challenge of a register refusal, getgrocery the one " \
          "its catalog query carries.",
  },
  "place" => { rule: :per_file, why: "Two getgrocery tests, each placing the order its own assertions need." },
  "attr_reader" => { rule: :per_file, why: "Each processor stub records what its own test reads back." },
  "initialize" => {
    rule: :per_file,
    why:  "The processor stubs' constructors; the payment-window copies agree, the stuck-paying " \
          "stub records lookups instead.",
  },
  "release!" => { rule: :code, why: "The payment-window stub's latch, one mechanism in three tests." },
  "setup_required?" => {
    rule: :code,
    why:  "The payment-window stubs answer that a card is on file, so the race reaches capture.",
  },
  "wait_until" => { rule: :code, why: "The payment-window tests' bounded poll for a racing thread." },
  "capture" => { rule: :per_file, why: "Each stub's charge, and each test's capture of its own product." },
  "payment_state" => { rule: :per_file, why: "The wire's payment state, read through each demo's own query." },
  "payment_status" => { rule: :per_file, why: "The stored payment status of each demo's own model." },
  "pay" => { rule: :per_file, why: "Each demo's cart mandate over its own product's line items." },
  "confirm" => { rule: :per_file, why: "hoteling's `confirm_booking`, called as each spec needs it." },
  "reserve" => { rule: :per_file, why: "Each demo's own reserve verb and arguments." },
  "PASSWORD" => { rule: :per_file, why: "Each demo's seeded human password." },
  "claims" => { rule: :per_file, why: "A token's claims, decoded where each test holds the token." },
  "proof" => {
    rule: :per_file,
    why:  "A possession proof over a fresh challenge, built with each test's own transport.",
  },
  "poll" => { rule: :per_file, why: "Each device-grant test's token poll, against its own verify page." },
  "login" => { rule: :per_file, why: "A bound assistant's login, built with each test's own transport." },
  "claim" => { rule: :per_file, why: "A link-code claim; tudu's test asserts what stylish's helper returns." },
  "alice" => { rule: :per_file, why: "Each demo's seeded human, found by its own column." },
  "kiosk_origin" => { rule: :code, why: "The conformance origin, where a demo's tests drive its handlers." },
  "assert_kiosk_refused" => { rule: :per_file, why: "Each helper's refusal assertion." },
  "NOON_UTC" => { rule: :code, why: "The instant two clock tests pin." },
  "as" => { rule: :per_file, why: "Each helper opens a session as a principal." },
  "test" => {
    rule: :per_file,
    why:  "MINITEST'S OWN DECLARATION MACRO, not a hand-copied helper: `test \"…\" do` names one " \
          "example, so every file that holds examples at all defines this name and each body is " \
          "its own assertion. It is declared rather than exempted because the discovery half " \
          "above keys on the NAME and cannot tell a framework macro from a copied method — and " \
          "`:per_file` still says something true, since the day all of these agreed would mean " \
          "several files asserting one thing.",
  },
  "TOKYO" => {
    rule: :code,
    why:  "`Time.find_zone!(\"Asia/Tokyo\")` — the far-side zone three per-resource clock specs " \
          "use to prove a stored instant renders in the caller's zone rather than the server's. " \
          "Held so the three keep asking the same question; a copy that switched to another zone " \
          "would still pass and would stop being the same proof.",
  },
  "MONTREAL" => {
    rule: :code,
    why:  "`Time.find_zone!(\"America/Toronto\")` — the other-side-of-the-Atlantic zone the same " \
          "three clock specs pair with {TOKYO}. Same reason, and stated separately because a " \
          "reader meeting one of them is entitled to know the other is held too.",
  },
}.freeze

# The corpus, derived. `git ls-files` first because the tracked set is the
# question, a filesystem walk behind it because `--self-test` copies this tree
# somewhere that is not a git repository (the same fallback the container rule
# uses, and for the same reason).
spec_pathspecs = DEMO_SPEC_SUBDIRS.map { |sub| "kiosk-demo-*/#{sub}/*" }
spec_ls, spec_git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z", *spec_pathspecs)
spec_corpus =
  if spec_git.success? && !spec_ls.strip.empty?
    spec_ls.split("\0").reject(&:empty?)
  else
    DEMO_SPEC_SUBDIRS.flat_map { |sub| Dir[File.join(ROOT, "kiosk-demo-*", sub, "**", "*.rb")] }
                     .map { |abs| abs.delete_prefix("#{ROOT}/") }
  end.select { |rel| rel.end_with?(".rb") }.sort

spec_unit_sources = Hash.new { |h, k| h[k] = {} } # unit name => "demo/rel" => normalised body
spec_corpus.each do |rel|
  units, unreadable, = fragment_units(File.join(ROOT, rel))
  unless unreadable.empty?
    errors << "#{rel}: the demo-spec harness rule could not read #{unreadable.join(', ')} back as " \
              "valid Ruby within #{FRAGMENT_MAX_LINES} lines, so it compared NOTHING for " \
              "#{unreadable.size == 1 ? 'that unit' : 'those units'}. Fix the extraction in " \
              "bin/check-demo-copies, do not drop the rule (K-1536)."
  end
  units.each { |name, src| spec_unit_sources[name][rel] = code_norm(src) }
end

# TWO SEPARATE QUESTIONS ABOUT ONE COPY, both counted rather than claimed.
# FRAGMENTS' key is `path#unit`, so «could a path-keyed rule be pointed at this
# copy» and «does it already hold this copy» are not the same question.
spec_path_walked = lambda { |rel| FRAGMENT_PATHS.include?(rel.split("/", 2).last) }

spec_held_by_fragments = lambda do |name, rel|
  sub = rel.split("/", 2).last
  FRAGMENT_PATHS.include?(sub) && FRAGMENTS.key?("#{sub}##{name}")
end

# A name EVERY one of whose copies FRAGMENTS already holds is DELEGATED, not
# undeclared. Derived from that rule's own manifest, so the two cannot disagree
# about who owns a unit.
spec_delegated = lambda { |name, rels| rels.all? { |rel| spec_held_by_fragments.call(name, rel) } }

spec_shared     = spec_unit_sources.select { |_name, byfile| byfile.size >= 2 }
spec_delegated_names = spec_shared.select { |name, byfile| spec_delegated.call(name, byfile.keys) }.keys
spec_owned      = spec_shared.reject { |name, _| spec_delegated_names.include?(name) }
spec_compared   = 0

# The corpus's OWN split (K-1536). A relative path — the
# part after the demo directory — that two or more corpus files share is a path
# the FRAGMENTS rule above CAN be pointed at; a path unique to its demo is
# reachable at no granularity but the unit name.
spec_by_relpath   = spec_corpus.group_by { |rel| rel.split("/", 2).last }
spec_shared_paths = spec_by_relpath.select { |_sub, group| group.size >= 2 }

# DISCOVERY: a unit name in two or more files of this corpus must be declared.
# The same property the file-level manifest has, at the granularity these copies
# actually exist at.
spec_owned.each do |name, byfile|
  next if SPEC_UNITS.key?(name)

  reach = byfile.keys.count { |rel| spec_path_walked.call(rel) }
  rest  = byfile.size - reach
  reach_says =
    if reach.zero?
      "not one of them sits at a relative path FRAGMENTS walks, so no path-keyed rule can see " \
        "this at all"
    else
      "#{reach} of them #{reach == 1 ? 'sits' : 'sit'} at a relative path FRAGMENTS walks and " \
        "#{rest} #{rest == 1 ? 'does' : 'do'} not, so a path-keyed rule can hold part of this " \
        "and never the whole of it"
    end
  errors << "#{name}: defined in #{byfile.size} demo spec/test file(s) " \
            "(#{byfile.keys.join(', ')}) and declared NOWHERE. These files are hand-copied and " \
            "#{reach_says} — declare it in SPEC_UNITS in bin/check-demo-copies with the reason " \
            "the copies exist, or give the second copy its own name (K-1536)."
end

SPEC_UNITS.each do |name, entry|
  errors << "SPEC_UNITS[#{name.inspect}]: `why:` is blank (K-1536)." if entry[:why].to_s.strip.empty?

  byfile = spec_owned[name]
  if byfile.nil?
    reason =
      if spec_delegated_names.include?(name)
        "every copy of it now sits at a path FRAGMENT_PATHS walks, so FRAGMENTS holds it and this " \
          "entry is a second declaration of one thing"
      else
        "it is defined in #{spec_unit_sources[name].size} file(s) of this corpus, and a lockstep " \
          "entry for a unit that is not shared is the record turning back into an assumption"
      end
    errors << "SPEC_UNITS[#{name.inspect}]: declared, but #{reason}. Drop the entry (K-1536)."
    next
  end

  spec_compared += byfile.size
  groups = byfile.group_by { |_rel, src| src }
  case entry[:rule]
  when :code
    next if groups.size == 1

    listed = groups.values.map { |g| "[#{g.map { |rel, _| rel }.sort.join(',')}]" }.sort.join(" ")
    errors << "#{name}: the demo spec copies must agree once comments and whitespace are " \
              "normalised away, and they do not: #{listed}. This unit is hand-copied into " \
              "#{byfile.size} spec file(s) — propagate the edit to all of them, or give the copy " \
              "that legitimately differs a different NAME and say why, because a shared name " \
              "with different behaviour is what makes the next reader trust the wrong copy " \
              "(K-1536)."
  when :per_file
    next if groups.size > 1

    errors << "#{name}: declared `:per_file` — each copy its own body — and all #{byfile.size} of " \
              "them now agree once comments and whitespace are normalised away. The entry " \
              "describes a state the tree has left; make it `:code` so the agreement is HELD, or " \
              "say what still differs (K-1536)."
  else
    errors << "SPEC_UNITS[#{name.inspect}]: unknown `rule: #{entry[:rule].inspect}` — this rule " \
              "understands :code and :per_file only (K-1536)."
  end
end

# VACUITY, THREE ARMS, AND THE POLARITY MATTERS.
#
# The discovery half is a BAN (no undeclared shared unit), so its silence is the
# tree being clean and cannot be asserted on. What must be alive is the
# MEASUREMENT: the corpus, the extractor, and the comparison. Each of the three
# fails the same clean-looking way — a glob that stops matching, a lexer that
# stops running, a manifest that stops being read all print zero violations.
if spec_corpus.size < 2 || spec_corpus.map { |rel| rel.split("/").first }.uniq.size < 2
  errors << "check-demo-copies: the demo-spec harness rule read #{spec_corpus.size} Ruby file(s) " \
            "across #{spec_corpus.map { |rel| rel.split('/').first }.uniq.size} demo(s) under " \
            "kiosk-demo-*/{#{DEMO_SPEC_SUBDIRS.join(',')}} — the corpus has stopped matching, and " \
            "a lockstep rule over one file or none compares nothing while exiting 0 (K-1536)."
end
if spec_unit_sources.empty?
  errors << "check-demo-copies: the demo-spec harness rule extracted NO unit at all from " \
            "#{spec_corpus.size} file(s). Every one of these specs defines at least an `assert`, " \
            "so zero means the extractor stopped running rather than that the tree changed " \
            "(K-1536)."
end
if SPEC_UNITS.any? && spec_compared.zero?
  errors << "check-demo-copies: SPEC_UNITS declares #{SPEC_UNITS.size} unit(s) and this run " \
            "compared NONE of them — every declared name has left the corpus, or the sharing " \
            "pass stopped grouping. A lockstep rule with nothing to compare passes everything " \
            "(K-1536)."
end

# ── A SPEC PATH TWO DEMOS SHARE MUST REACH THE FILE MANIFEST (K-1550) ───────
#
# THE HOLE THE RULE ABOVE LEAVES, WHICH IS THAT RULE RUN BACKWARDS: the unit rule
# keys on a NAME, so it compares the units it can see and everything else in a
# copied file — the fixtures, the assertions, the tail, the prose — is compared
# against nothing at all. A whole spec file duplicated at one relative path, whose
# every unit name is already declared and whose copies agree, produces silence.
#
# WHAT CLOSES IT is two lines over a corpus that is already derived: every relative
# path that two or more files of this corpus share must be declared in
# EXTRA_SCANNED. That is not a formality — EXTRA_SCANNED is what puts a path
# outside SCAN_ROOTS into the file-level `found` map, which then REQUIRES a COPIES
# entry with a rule (`:code`, `:lockstep`, `:per_demo`, …), which is where a
# `:per_demo` path in turn meets FRAGMENT_PATHS. One declaration hands the path to
# every file-level rule at once.
#
# It is scoped to THIS corpus on purpose: a duplicate under `lib`, `app`, `script`
# or `db/migrate` is already seen, because SCAN_ROOTS walks those. The reject below
# asks that question rather than assuming it, so widening DEMO_SPEC_SUBDIRS into a
# scan root tomorrow does not produce a demand that is already met.
spec_undeclared_paths = spec_shared_paths.keys.reject do |sub|
  EXTRA_SCANNED.include?(sub) || SCAN_ROOTS.any? { |root| sub == root || sub.start_with?("#{root}/") }
end
spec_undeclared_paths.sort.each do |sub|
  where = spec_shared_paths[sub].sort
  errors << "#{sub}: #{where.size} demos ship a file at this SAME relative path " \
            "(#{where.join(', ')}) and the path is not in EXTRA_SCANNED, so the FILE-level " \
            "manifest cannot see it. The unit rule above holds the NAMES it recognises inside " \
            "these files and nothing else in them — the fixtures, the assertions and the tail " \
            "are compared against nothing. Add #{sub.inspect} to EXTRA_SCANNED and give it a " \
            "COPIES entry with the reason the copies exist (K-1550)."
end

# THE VACUITY ARM IS ABOUT THE KEY, because that is the one way this rule goes
# silently blind: the group key is the path with its demo directory stripped, and
# a key that kept the demo prefix would be unique to its demo BY CONSTRUCTION —
# every group would hold exactly one file, nothing would ever be «shared», and
# the rule would pass forever over a tree full of duplicates. Zero shared paths
# is a legitimate clean state and is NOT asserted on; a key that is not a path
# relative to the demo is a broken measurement and is.
spec_malformed_keys = spec_by_relpath.keys.reject do |sub|
  DEMO_SPEC_SUBDIRS.any? { |dir| sub == dir || sub.start_with?("#{dir}/") }
end
if spec_by_relpath.any? && spec_malformed_keys.any?
  errors << "check-demo-copies: the K-1550 shared-path rule grouped #{spec_by_relpath.size} key(s) " \
            "and #{spec_malformed_keys.size} of them are not a path under " \
            "kiosk-demo-*/{#{DEMO_SPEC_SUBDIRS.join(',')}} (#{spec_malformed_keys.sort.first(3).join(', ')}). " \
            "The demo directory is no longer being stripped, so every key is unique to its own demo " \
            "and no duplicate can ever be found. A rule that cannot match is not a rule."
end

# -- Every demo lockfile resolves for the SAME platforms (K-962) -------------
#
# `Gemfile.lock` is declared NOT COMPARED, and for its resolved-versions half
# that is right: each demo pulls a different set of kiosk gems and adapters, so
# the GEM sections legitimately differ. Its `PLATFORMS` section does not.
#
# The deploy box is x86_64 linux and every demo is installed there by the same
# push-to-deploy hook. A lockfile that names fewer platforms than its siblings is
# not a variant, it is a lockfile that cannot be installed frozen: under
# `BUNDLE_FROZEN` / `--deployment`, or a bundler that tightens the default, it
# fails to boot on the box while the others succeed, and every deploy rewrites the
# tracked file in place and leaves the production work-tree dirty.
#
# Deliberately a PARITY rule and not a fixed list: the set changes when bundler
# or a native gem changes, and pinning the ten names here would turn a routine
# `bundle lock` into a check edit. What must never happen is one demo drifting
# away from the rest. Fix a reported drift with
# `bundle lock --add-platform <missing...>` in the demo named, never by
# deleting platforms from the others.
lockfile_platforms = demos.filter_map do |dir|
  path = File.join(dir, "Gemfile.lock")
  next unless File.exist?(path)

  section = File.read(path)[/^PLATFORMS\n(.*?)(?:\n\n|\z)/m, 1]
  [File.basename(dir), section.to_s.split("\n").map(&:strip).reject(&:empty?).sort]
end.to_h

if lockfile_platforms.size < 2
  errors << "check-demo-copies: the K-962 lockfile-PLATFORMS rule compared " \
            "#{lockfile_platforms.size} lockfile(s) - kiosk-demo-*/Gemfile.lock has moved or stopped " \
            "being tracked. A parity rule with nothing to compare passes everything."
else
  majority = lockfile_platforms.values.tally.max_by { |_, n| n }.first
  lockfile_platforms.each do |demo, platforms|
    next if platforms == majority

    missing = majority - platforms
    extra   = platforms - majority
    detail  = []
    detail << "missing #{missing.join(', ')}" unless missing.empty?
    detail << "declares #{extra.join(', ')}, which no sibling does" unless extra.empty?
    errors << "#{short.(demo)}: Gemfile.lock PLATFORMS differs from the other demos - " \
              "#{detail.join('; ')}. The deploy box installs all of them the same way, so a short " \
              "platform list means this demo alone cannot be installed frozen and the deploy has to " \
              "rewrite the tracked lockfile in place (K-962). Fix with " \
              "`bundle lock --add-platform #{missing.join(' ')}` in #{demo}, not by shortening the others."
  end
end

# ── No demo initializer patches a Rails framework class (K-504) ──────────────
#
# An initializer that patches a framework class is an APPLICATION monkey-patching a
# FRAMEWORK class on a GEM's behalf: the host carries a line it did not author, for
# a capability it does not own, at a load-order position nothing verifies. A
# railtie is the extension point Rails provides for exactly this, and a concern in
# `app/` is the answer when the behaviour is the demo's own. So the ban is on the
# SHAPE rather than on one constant: `ActiveRecord::Migration.include(…)`,
# `ActionController::Base.include(…)` and `ActiveSupport::TimeZone.prepend(…)` are
# the same mistake with different constants.
#
# NOT forbidden: patching a KIOSK class. `Kiosk::Configuration.include(...)` is
# the gem's own documented extension idiom — kiosk-rls adds `system_role` to the
# configuration object exactly that way — so skooti extending it with the
# demo's `unlock_signing_key` accessor is adoption, not a framework patch.
RAILS_FRAMEWORK_NAMESPACES = %w[
  ActiveRecord ActiveModel ActiveSupport ActiveJob ActiveStorage
  ActionController ActionDispatch ActionView ActionMailer ActionCable
  Rails
].freeze

FRAMEWORK_PATCH = /
  ^[ \t]*
  (?<constant>(?:#{RAILS_FRAMEWORK_NAMESPACES.join("|")})(?:::[A-Za-z0-9_]+)*)
  \s*\.\s*
  (?<verb>include|prepend|extend|class_eval|module_eval|define_method|alias_method|remove_method)
  \b
/x

scan_initializer = lambda do |label:, rel:, path:|
  File.read(path).each_line.with_index(1) do |line, lineno|
    next if line.lstrip.start_with?("#")

    m = FRAMEWORK_PATCH.match(line)
    next if m.nil?

    errors << "#{label}: #{rel}:#{lineno} calls #{m[:constant]}.#{m[:verb]} — an " \
              "application must not patch a Rails framework class from its configuration. " \
              "This is the K-504 shape: the four demos that carried " \
              "`ActiveRecord::Migration.include(Kiosk::RLS::DSL)` are now served by " \
              "kiosk-rls's own railtie. Whatever this line adds belongs in a railtie inside " \
              "the gem that owns the behaviour, or in an ordinary Rails concern under app/."
  end
end

initializer_demos = 0
operator_demos.each do |demo|
  paths = Dir[File.join(ROOT, demo, "config/initializers", "*.rb")].sort
  if paths.empty?
    errors << "#{short.(demo)}: ships no config/initializers/*.rb at all — an operator demo " \
              "configures Kiosk in one, so either the demo is broken or this check has gone " \
              "blind to where initializers live (K-504)."
    next
  end
  initializer_demos += 1

  paths.each do |path|
    scan_initializer.call(label:    short.(demo),
                          rel:      path.delete_prefix("#{File.join(ROOT, demo)}/"),
                          path:     path)
  end
end

# THE EIGHTH INITIALIZER SET, DERIVED FROM run.sh RATHER THAN LISTED (K-1011).
# K-1009 named ONE fixture by literal path, and `run.sh` installs TWO
# (initializer_kiosk.rb → kiosk.rb, devise_initializer.rb → devise.rb), so the
# generated app was the one place an initializer could be exempt by
# construction. Reading the set out of run.sh means a third copy is scanned the
# day someone adds it, and that a fixture that moves is reported rather than
# skipped. BOTH rules run over each, with the K-504 message worded for a file
# that is not a demo.
E2E_RUN_SH           = "e2e/run.sh"
E2E_INITIALIZER_COPY = %r{^\s*cp\s+"\$FIXTURES/(?<fixture>[^"]+)"\s+config/initializers/}
run_sh               = File.join(ROOT, E2E_RUN_SH)

if File.exist?(run_sh)
  fixtures = File.read(run_sh).scan(E2E_INITIALIZER_COPY).flatten.uniq
  if fixtures.empty?
    errors << "check-demo-copies: #{E2E_RUN_SH} copies NO fixture into config/initializers/, so " \
              "this rule scanned NOTHING. Either the harness stopped shipping an initializer — " \
              "in which case the rule should go with it — or the `cp \"$FIXTURES/…\" " \
              "config/initializers/…` line it reads has been rewritten and this pattern no " \
              "longer matches it. A rule that inspects nothing passes everything (K-1011)."
  end

  fixtures.each do |fixture|
    rel  = "e2e/fixtures/#{fixture}"
    path = File.join(ROOT, rel)
    unless File.exist?(path)
      errors << "check-demo-copies: #{E2E_RUN_SH} copies #{rel} into config/initializers/ of the " \
                "generated app, but that file does not exist, so this rule scanned NOTHING for " \
                "it. Either the fixture moved — run.sh names its new path — or the copy is dead " \
                "and the line should go (K-1009, K-1011)."
      next
    end

    scan_initializer.call(label: "e2e", rel: rel, path: path)
  end
else
  errors << "check-demo-copies: #{E2E_RUN_SH} does not exist, so the harness half of this rule " \
            "scanned NOTHING. Either the harness moved — point this at its new path — or the " \
            "e2e harness is gone and the rule should go with it. A rule that inspects nothing " \
            "passes everything."
end

if initializer_demos.zero?
  errors << "check-demo-copies: the K-504 framework-patch rule scanned NO initializers — " \
            "operator_demos is empty or config/initializers/ has moved. A rule that inspects " \
            "nothing passes everything."
end


# ── A demo DRIVER fetches its ORIGIN NAMES with NO default (K-1543, K-1545, K-1546) ──
#
# A property over a glob, not a comparison between copies: `script/redteam_suite.rb`
# is `:per_demo`, and a single-demo driver is reachable by no copy rule at all.
#
# WHY NO DEFAULT: CI and `bin/demo` pass every one of these names, so a fallback is
# never taken by a gated run and can only fire on a HAND run — which is exactly
# where guessing is wrong. SERVER_URL is the origin every request in the file is
# sent to, and a hard-coded `http://127.0.0.1:<port>` fallback drives whatever
# happens to be listening on that port instead: a red-team suite that silently
# attacks the wrong origin reports BLOCKED for a surface it never touched.
#
# The vacuity arm is per name, so a name whose drivers stopped reading it cannot
# hide behind another name's fetches.
DRIVER_NO_DEFAULT_VARS = {
  "SERVER_URL" => "the origin every request in the file is sent to",
}.freeze
DRIVER_ENV_FETCH = /\A[^#]*\bENV\.fetch\(\s*"(?<var>[A-Z0-9_]+)"(?<comma>\s*,)?/
driver_env_held    = DRIVER_NO_DEFAULT_VARS.keys.to_h { |var| [var, 0] }
driver_env_scripts = 0

operator_demos.each do |demo|
  Dir[File.join(ROOT, demo, "script", "*.rb")].sort.each do |path|
    rel = path.delete_prefix("#{File.join(ROOT, demo)}/")
    driver_env_scripts += 1

    File.read(path).each_line.with_index(1) do |line, lineno|
      next if line.lstrip.start_with?("#")

      m = DRIVER_ENV_FETCH.match(line)
      next if m.nil?
      next unless DRIVER_NO_DEFAULT_VARS.key?(m[:var])

      if m[:comma].nil?
        driver_env_held[m[:var]] += 1
      else
        errors << "#{short.(demo)}: #{rel}:#{lineno} fetches #{m[:var]} WITH a default. This " \
                  "name is #{DRIVER_NO_DEFAULT_VARS.fetch(m[:var])}, and CI and bin/demo pass " \
                  "it on the command line — so a fallback is never taken by a " \
                  "gated run and, on a hand run, quietly drives whatever happens to be listening " \
                  "on that port instead of failing at the line that wants the value. Spell it " \
                  "`ENV.fetch(\"#{m[:var]}\")` (K-1543, K-1545)."
      end
    end
  end
end

driver_env_held.each do |var, held|
  next unless held.zero?

  errors << "check-demo-copies: the K-1543/K-1545 driver-env rule found NO no-default fetch of " \
            "#{var} in #{driver_env_scripts} demo script(s), so it asserted nothing about that " \
            "name. Either the drivers stopped reading it — in which case it should leave " \
            "DRIVER_NO_DEFAULT_VARS with them — or `script/*.rb` is no longer where they live. " \
            "A rule that inspects nothing passes everything."
end

# ── A demo DRIVER's comments name only ports its OWN demo serves on ──────────
#
# A driver's usage line is what a reader copies to run it by hand. A demo serves
# on its `config/puma.rb` default and on the `PORT` its own compose file sets; a
# local URL in a driver comment naming any other port sends the reader to a
# sibling demo, or to nothing.
DRIVER_LOCAL_URL = %r{\bhttps?://(?:127\.0\.0\.1|localhost):(\d+)}
driver_ports_held = 0

operator_demos.each do |demo|
  served = [["config/puma.rb", /^port ENV\.fetch\("PORT", (\d+)\)/],
            ["compose.yaml", /^\s+PORT:\s*"(\d+)"/]].filter_map do |rel, pattern|
    path = File.join(ROOT, demo, rel)
    File.read(path)[pattern, 1] if File.file?(path)
  end.uniq
  next if served.empty?

  Dir[File.join(ROOT, demo, "script", "*.rb")].sort.each do |path|
    rel = path.delete_prefix("#{File.join(ROOT, demo)}/")
    File.read(path).each_line.with_index(1) do |line, lineno|
      next unless line.lstrip.start_with?("#")

      line.scan(DRIVER_LOCAL_URL).flatten.each do |port|
        driver_ports_held += 1
        next if served.include?(port)

        errors << "#{short.(demo)}: #{rel}:#{lineno} names port #{port}, which #{demo} never " \
                  "serves on — it serves on #{served.join(', ')}. Name the demo's own port."
      end
    end
  end
end

if driver_ports_held.zero?
  errors << "check-demo-copies: no demo driver comment names a local port its demo serves on, " \
            "so the driver-port rule compares nothing and reads as coverage."
end

# ── The e2e harness's fixtures, paired with the demo files they came from ────
#    (T-118, generalising the hand-written arms of K-504/K-699, K-1009/K-1011
#    and K-1021)
#
# WHY THIS IS A SCAN ROOT RATHER THAN A SIXTH SPECIAL CASE. `SCAN_ROOTS` walks
# `kiosk-demo-*` and nothing else, so no path under `e2e/fixtures/` enters the
# `found` map and no COPIES rule could apply to one. The cost of that is not the
# unguarded surface: it is that every new rule silently costs a second
# implementation, written by a fixer who has to discover for themselves that the
# discovery loop cannot get there — and a rule written without knowing it passes
# vacuously on the harness.
#
# THE PAIRING IS DERIVED, NOT LISTED, which is the half that makes this a scan root
# rather than a longer manifest. `e2e/run.sh` already says where each fixture is
# installed, in its `cp "$FIXTURES/…" <dest>` lines, and that destination IS the
# demo-relative path to compare against. So an entry needs no `pairs:` unless run.sh
# does not install the file (some fixtures are run in place, one is appended into
# the generated environment files) or unless the installed path exists in no demo. A
# fixture that MOVES in run.sh moves here with it, and one that stops being
# installed is reported rather than skipped.
#
# THE RULES ARE THE MANIFEST'S OWN, one level over: `:identical`, `:code` and
# `:per_demo` mean here exactly what they mean for two demo copies, and `:per_demo`
# carries the same convergence tripwire the fragment rule does — a fixture declared
# a deliberate variant that has quietly become comment-identical to every demo copy
# is reported, because that is a copy nobody decided to make. `pairs: nil` is the
# fourth state: it declares that a fixture has no demo counterpart, and it is
# CHECKED — no demo file sharing its basename may be comment-identical to it.
E2E_FIXTURES_DIR = "e2e/fixtures"
E2E_FIXTURE_CP   = /^\s*cp\s+"\$FIXTURES\/(?<fixture>[^"]+)"\s+(?:"(?<quoted>[^"]+)"|(?<bare>\S+))/

# run.sh's `cp` lines, as { fixture basename => demo-relative destination }.
# A `${ts}`-interpolated migration timestamp becomes a `*`, which is the same
# handle MIGRATION_PAIRS uses for the same reason: every demo stamps its own.
def e2e_installed_paths(run_sh_src)
  run_sh_src.gsub(/\\\n\s*/, " ").each_line.with_object({}) do |line, out|
    m = E2E_FIXTURE_CP.match(line) or next

    out[m[:fixture]] = (m[:quoted] || m[:bare]).gsub(/\$\{[^}]+\}/, "*")
  end
end

