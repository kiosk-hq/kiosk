# ── The engine side of the generator output (K-640) ──────────────────────────
#
# The db/migrate entries in COPIES hold the demos' copies in lockstep with each
# other, which is necessary and not sufficient: `rails g kiosk:install` emits
# those files from these templates, and nothing in the sibling rule ever looks
# at them — the K-580 rebuild was the concrete near-miss, where template and
# copies had to move as one change and a partial move would have stayed green.
#
# So every template under GENERATOR_TEMPLATES_DIR is declared here, rendered
# with plain ERB and the generator's own default options (GENERATOR_DEFAULTS —
# the values every demo was generated with; the templates' only ERB is
# `<%= options[:…] %>` substitution), and the render must byte-match every demo
# copy of that migration. Copies are matched by timestamp-stripped basename,
# because migration_template stamps each demo's copy with its own UTC timestamp
# — which is also why four copies (getgrocery's mandates and its two kyc
# migrations, skooti's kyc_attributes — each at its own timestamp) are
# INVISIBLE to the sibling rule above: a path shipped by one demo is never a
# duplicate, so the two add_kyc_attributes copies were compared to NOTHING
# before this rule.
#
# Entry fields:
#   emits:        — the basename the generator writes (sans timestamp).
#   shipped_as:   — the basename the demos actually ship, when that differs
#                   from emits: (a rename is drift too — recorded, not hidden).
#   drift:        — the render and the copies KNOWINGLY disagree, pending
#                   triage: the reason says what differs and why no side was
#                   picked. The copies must still agree with EACH OTHER
#                   (comments/whitespace ignored) so the pending state cannot
#                   rot further, and the entry errors the day the copies match
#                   the render — a stale exception is a lie, same as `except:`.
#   not_compared: — the template's output has a per-demo dimension; the reason
#                   says where that is recorded.
#
# Staleness is checked both ways, per this file's house rule: a template with
# no entry fails, an entry with no template fails, an emits:/shipped_as:
# basename no demo ships fails, a drift: whose copies have converged fails.
GENERATOR_TEMPLATES_DIR = "kiosk-server/lib/generators/kiosk/install/templates"

# The generator's own class_option defaults (install_generator.rb) — the
# values every demo was generated with.
GENERATOR_DEFAULTS = {
  schema: "kiosk", user_id_type: "uuid", user_table: "users", guc_namespace: "app",
}.freeze

GENERATOR_TEMPLATES = {
