# The corpus documents, as {label => {rel => normalised text}}. Ruby files go
# through Ripper — a routes.rb sentence WRAPS across `#` lines, and the same
# single-line blindness is how «the Kiosk error envelope» hid in
# atablefor/config/routes.rb from every grep for that phrase (K-1090). Markdown
# is read whole with fenced blocks dropped (K-1051's territory, see above).
def framework_prose_ruby(path)
  Ripper.lex(File.read(path))
        .select { |(_, type, _)| type == :on_comment }
        .map { |(_, _, tok)| tok.sub(/\A#+\s?/, "").rstrip }
        .join(" ")
        .gsub(/\s+/, " ")
end

def framework_prose_text(path)
  keep, fence = [], false
  File.foreach(path) do |line|
    if line.start_with?("```")
      fence = !fence
      next
    end
    keep << line unless fence
  end
  keep.join.gsub(/\s+/, " ")
end

corpus = {}
demos.each do |dir|
  label = short.(File.basename(dir))
  FRAMEWORK_CORPUS_RUBY.each do |rel|
    p = File.join(dir, rel)
    (corpus[label] ||= {})[rel] = framework_prose_ruby(p) if File.exist?(p)
  end
  FRAMEWORK_CORPUS_TEXT.each do |rel|
    p = File.join(dir, rel)
    (corpus[label] ||= {})[rel] = framework_prose_text(p) if File.exist?(p)
  end
end
e2e_routes = File.join(ROOT, "e2e/fixtures/routes.rb")
(corpus["e2e"] ||= {})["config/routes.rb"] = framework_prose_ruby(e2e_routes) if File.exist?(e2e_routes)
# The e2e origin keeps its wire in a fixture of its own, copied to
# config/routes/kiosk.rb by run.sh — the same file under another path, so it is
# read under the name the claims name (T-183).
e2e_wire = File.join(ROOT, "e2e/fixtures/routes_kiosk.rb")
(corpus["e2e"] ||= {})["config/routes/kiosk.rb"] = framework_prose_ruby(e2e_wire) if File.exist?(e2e_wire)

# A rule with nothing to read passes everything (the K-1021 lesson, and the
# reason the static-signpost block above counts its pages). These two numbers
# are the corpus, asserted rather than assumed.
routes_read = corpus.count { |_, d| d.key?("config/routes.rb") }
wire_read   = corpus.count { |_, d| d.key?("config/routes/kiosk.rb") }
ba_read     = corpus.count { |_, d| d.key?("before-after.md") }
if routes_read != OPERATOR_SEVEN.length + 2 # + prove + the e2e fixture
  errors << "check-demo-copies: the K-1069 corpus read #{routes_read} config/routes.rb, expected " \
            "#{OPERATOR_SEVEN.length + 2} (seven operator demos + prove + e2e/fixtures). A corpus " \
            "that lost a document passes vacuously for it."
end
if wire_read != OPERATOR_SEVEN.length + 1 # + the e2e fixture; prove serves no Kiosk wire
  errors << "check-demo-copies: the K-1069 corpus read #{wire_read} config/routes/kiosk.rb, " \
            "expected #{OPERATOR_SEVEN.length + 1} (seven operator demos + e2e/fixtures). Since " \
            "T-183 every framework sentence about the wire lives in THAT file, so a corpus that " \
            "lost one passes vacuously for the demo whose wire prose nobody is reading."
end
if ba_read != BEFORE_AFTER_FOUR.length
  errors << "check-demo-copies: the K-1069 corpus read #{ba_read} before-after.md, expected " \
            "#{BEFORE_AFTER_FOUR.length} (#{BEFORE_AFTER_FOUR.join(', ')}). A new one must be " \
            "declared here, because every framework sentence in it is otherwise uncompared."
end

framework_claim_checks = 0
FRAMEWORK_CLAIMS.each do |id, claim|
  # (c) THE SOURCE BINDING, checked first: a claim whose producer stopped saying
  # it is wrong in every document at once, and saying WHICH is more useful than
  # N identical per-demo failures.
  if (src = claim[:source])
    path = File.join(ROOT, src[:file])
    if !File.exist?(path)
      errors << "K-1069 claim `#{id}`: its source #{src[:file]} does not exist. The claim is " \
                "unbound — re-point it or delete it, do not leave it asserting about nothing."
    else
      body = File.read(path)
      framework_claim_checks += 1
      if src[:must] && body !~ src[:must]
        errors << "K-1069 claim `#{id}`: #{src[:file]} no longer matches #{src[:must].inspect}. " \
                  "The demos say this about the framework and the framework stopped saying it — " \
                  "which is exactly how the routes-drawer promise outlived the drawer (K-1068)."
      end
      if src[:must_not] && body =~ src[:must_not]
        errors << "K-1069 claim `#{id}`: #{src[:file]} now matches #{src[:must_not].inspect}, " \
                  "which the claim asserts it does not. Every corpus document repeating this " \
                  "claim is now false; fix the claim and the documents in one wave."
      end
    end
  end

  # (b) THE DECLARED CONTRADICTIONS.
  Array(claim[:forbids]).each do |banned|
    corpus.each do |label, docs|
      docs.each do |rel, text|
        next unless (m = text.match(banned))

        framework_claim_checks += 1
        errors << "#{label}: #{rel} says «#{m[0][0, 140]}», which K-1069 claim `#{id}` forbids. " \
                  "#{claim[:why]}"
      end
    end
  end

  # (a) THE COPIES and THE PARAPHRASES.
  next unless claim[:ships]

  doc = claim[:doc]
  next if doc == :all

  claim[:ships].each do |label|
    text = corpus.dig(label, doc)
    if text.nil?
      errors << "#{label}: K-1069 claim `#{id}` names it in `ships:` but it ships no #{doc}. " \
                "Either the demo stopped shipping the document or the declaration is stale."
      next
    end
    framework_claim_checks += 1

    if claim[:text] && !text.include?(claim[:text])
      errors << "#{label}: #{doc} does not carry K-1069 claim `#{id}` verbatim. It must say " \
                "«#{claim[:text][0, 120]}#{claim[:text].length > 120 ? '…' : ''}». #{claim[:why]}"
    end

    if claim[:topic] && text =~ claim[:topic] && text !~ claim[:must]
      errors << "#{label}: #{doc} raises K-1069 claim `#{id}`'s subject (#{claim[:topic].inspect}) " \
                "but does not state it as #{claim[:must].inspect}. #{claim[:why]}"
    elsif claim[:topic] && text !~ claim[:topic]
      errors << "#{label}: #{doc} is in `ships:` for K-1069 claim `#{id}` but never raises its " \
                "subject. A demo that drops a framework claim changes the set silently — the same " \
                "reason `ships:` exists in COPIES above."
    end
  end

  # A demo NOT in `ships:` that raises the topic anyway is the K-1064 shape: the
  # claim appearing somewhere nobody declared it, in whatever tense that copy
  # happened to be written in.
  next unless claim[:topic]

  (corpus.keys - claim[:ships]).each do |label|
    text = corpus.dig(label, doc)
    next unless text && text =~ claim[:topic]

    framework_claim_checks += 1
    next if text =~ claim[:must]

    errors << "#{label}: #{doc} raises K-1069 claim `#{id}`'s subject without being declared in " \
              "`ships:`, and does not state it as #{claim[:must].inspect}. Add it to `ships:` if " \
              "the claim belongs there; a new copy of a framework claim may not appear silently."
  end
end

# ── The HOUSE SENTENCE, where the ENGINE says it too (K-1294) ────────────────
#
# The FRAGMENTS entry for `app/operations/wire_arguments.rb#missing` calls
# `missing field: <name>` "the one an assistant's error handling matches on" and
# holds the three demos that ship it in lockstep. That was true and it was not
# enough: the file set of every rule above is `kiosk-demo-*`, and the ENGINE
# emits the same sentence on the auth plane — where an assistant meets it FIRST,
# before it has read a catalogue or called a verb.
#
# MEASURED live against the deployed fleet on 2026-09-05: `POST
# /kiosk/auth/register` with an empty object answered
# `"detail":"missing field: key not found: :public_key"`. That is
# `KeyError#message` spliced in whole — a fourth wording, with a Ruby symbol in
# it, in the one place no rule in this file could see. So the sentence is
# compared ACROSS the boundary here: the demos' refusal and the engine's builder
# must open with the same literal, or one of them has drifted.
#
# READ OFF THE PRODUCER, NOT MATCHED AGAINST A REMEMBERED TEXT, and that
# distinction is the whole rule rather than an implementation note. The first
# writing of this section carried the sentence in its own regex; the self-test
# arm below — the engine re-worded to `missing param:` — then reddened for the
# WRONG reason, reporting the engine as silent rather than as disagreeing,
# because a pattern that knows the answer can only ever notice the answer
# VANISHING. So each producer's own method body is sliced and whatever literal
# it interpolates the field into is taken as its spelling; the rule compares
# those spellings to each other and holds nothing else.
#
# WHAT THIS DOES NOT DO, said plainly. It compares the LITERAL, not the
# behaviour: the engine's own suite (`kiosk-server/spec/kiosk/server/
# wire_wording_spec.rb`) is what dispatches each site and reads the detail off
# the wire, and it carries the sweep that stops a new site building the sentence
# for itself. This rule answers the one question that spec structurally cannot:
# whether the two INDEPENDENT producers, in two gems with two suites, still say
# the same words.
#
# The demo side is DERIVED from the fragment entry rather than re-listed, so a
# demo joining or leaving the house sentence moves both rules at once.
HOUSE_SENTENCE_UNIT   = "app/operations/wire_arguments.rb#missing"
HOUSE_SENTENCE_ENGINE = "kiosk-server/lib/kiosk/server/errors.rb"
HOUSE_SENTENCE_ENTRY  = { HOUSE_SENTENCE_ENGINE => "def self.missing_field(",
                          HOUSE_SENTENCE_UNIT   => "def missing(field)" }.freeze
# How far past the entry point the refusal may be built. Both producers put it
# on the next line or two; the window exists so an unrelated later method cannot
# be read as this one's answer.
HOUSE_SENTENCE_WINDOW = 400
# «a literal, then the interpolated field» — the shape both producers use, with
# the literal captured and nothing about it assumed.
HOUSE_SENTENCE_RE     = /"([^"\n]*?)\#\{/

# @return [String, nil] the sentence this producer interpolates the field into
def house_sentence_of(path, entry)
  src = code_source(path)
  idx = src.index(entry)
  return nil if idx.nil?

  src[idx, HOUSE_SENTENCE_WINDOW][HOUSE_SENTENCE_RE, 1]
end

house_sentence_sites = {}

house_engine_path = File.join(ROOT, HOUSE_SENTENCE_ENGINE)
if File.file?(house_engine_path)
  house_sentence_sites[HOUSE_SENTENCE_ENGINE] =
    house_sentence_of(house_engine_path, HOUSE_SENTENCE_ENTRY.fetch(HOUSE_SENTENCE_ENGINE))
else
  errors << "#{HOUSE_SENTENCE_ENGINE} is not in the tree — the engine half of the house-sentence " \
            "rule (K-1294) is aimed at a file that no longer exists. Re-aim it or delete it; a rule " \
            "with no subject is not coverage."
end

house_rel   = HOUSE_SENTENCE_UNIT.split("#").first
house_ships = (FRAGMENTS[HOUSE_SENTENCE_UNIT] || {})[:ships]
if house_ships.nil?
  errors << "the house-sentence rule (K-1294) derives its demo list from " \
            "FRAGMENTS[#{HOUSE_SENTENCE_UNIT.inspect}], which is gone. The engine is then compared to " \
            "nothing at all until that entry is restored or this rule is given another source."
else
  house_ships.each do |demo|
    path = (dups[house_rel] || {})["kiosk-demo-#{demo}"]
    if path.nil?
      errors << "#{demo}: #{house_rel} is declared in `ships:` for the house sentence (K-1294) but " \
                "is not in the tree."
      next
    end
    house_sentence_sites["kiosk-demo-#{demo}/#{house_rel}"] =
      house_sentence_of(path, HOUSE_SENTENCE_ENTRY.fetch(HOUSE_SENTENCE_UNIT))
  end
end

# VACUITY: a producer this rule cannot read is not a producer that agrees. It is
# reported as silence rather than folded into the spellings below, because a
# `nil` quietly compared as one more value is how a rule starts confirming
# agreement between one site and nothing.
house_silent = house_sentence_sites.select { |_, sentence| sentence.nil? }.keys
if house_silent.any?
  errors << "the absent-field refusal cannot be read out of #{house_silent.join(', ')} (K-1294) — " \
            "no `\"…\#{…}\"` sentence within #{HOUSE_SENTENCE_WINDOW} characters of its entry point. " \
            "Either the producer was restructured, in which case this rule must be re-aimed at where " \
            "it now builds the sentence, or it stopped building one at all. It may not simply become " \
            "unreadable: an unread producer is compared to nothing."
end

house_spellings = house_sentence_sites.values.compact.uniq
if house_spellings.size > 1
  errors << "the absent-field refusal has #{house_spellings.size} spellings across the demos and the " \
            "engine — " + house_sentence_sites.compact.map { |site, sentence| "#{site} says #{sentence.inspect}" }.join("; ") +
            " (K-1294). An assistant's error handling matches on ONE of them; the deployed engine " \
            "already shipped a fourth wording once — `missing field: key not found: :public_key`, a " \
            "Ruby KeyError message on the auth plane — and nothing in this file could see it."
end

# ── The WIRE DATE RULE, where the ENGINE says it too (K-1467) ────────────────
#
# Spec §8.1 rule 9 — a date on the wire is `YYYY-MM-DD` and nothing else
# (ADR-0029) — is implemented FOUR times in this repository. The FRAGMENTS entry
# for `app/operations/wire_arguments.rb#ISO_DATE` holds the three demo copies in
# lockstep, so they cannot drift from EACH OTHER. The fourth implementation is
# the engine's `check_date!`, and it is the one an adopting operator actually
# inherits: a verb declares `format: "date"` and the engine is what refuses the
# value, by name, before any handler runs.
#
# Nothing compared those two until this rule, and the lockstep is blind in
# exactly the two directions that matter. A UNIFORM widening — all three demos
# edited at once, which is the shape of an edit somebody makes to be helpful —
# keeps every `:code` comparison green. So does a widening on the ENGINE side,
# where one relaxed line changes the protocol for every adopter simultaneously
# and no demo file moves at all. That is the K-1294 shape, one wire element over.
#
# READ OFF THE PRODUCER, NOT MATCHED AGAINST A REMEMBERED SHAPE — the same
# discipline the house-sentence section above is written to, and for the same
# reason: a pattern that already knows the answer can only ever notice the
# answer VANISHING, never a producer disagreeing. The complication here is that
# the two producers do not share a NOTATION: the demos publish an anchored Ruby
# regexp and the engine publishes a `strftime` format. So each is read in its
# own notation and translated into ONE canonical shape — the widths of its digit
# groups and the separators between them — and the rule compares those and holds
# nothing else. `\A\d{4}-\d{2}-\d{2}\z` and `%Y-%m-%d` both canonicalise to
# `4-2-2`; `%d/%m/%Y` gives `2/2/4` and `\A\d{4}-\d{1,2}-\d{1,2}\z` gives
# `4-1,2-1,2`. A widening on either side is therefore a DIFFERENT shape rather
# than an unreadable one, which is what makes the comparison a comparison.
#
# WHY THE ENGINE HAS TO NAME ITS FORMAT TWICE, and why one occurrence reads as
# silence rather than as an answer. `Date.strptime("2026-9-1", "%Y-%m-%d")`
# SUCCEEDS — strptime does not pin field widths — so the thing that actually
# makes the engine's answer `4-2-2` is the round trip beside it,
# `parsed.strftime(fmt) == value`. A body that names the format once has stopped
# pinning the widths, and its accepted shape can no longer be read off it. This
# rule says so instead of reading the strptime alone and reporting an agreement
# it cannot see.
#
# WHAT THIS DOES NOT DO. It compares the accepted SHAPE, not the behaviour: the
# engine's own suite and each demo's `demo:wire_args_spec` are what dispatch a
# real value and read the answer. It says nothing about the refusal SENTENCE
# either — the three demos word theirs differently on purpose, each naming the
# row an assistant gets a right value from, which the FRAGMENTS entry for
# `#iso_date` records in as many words.
WIRE_DATE_UNIT   = "app/operations/wire_arguments.rb#ISO_DATE"
WIRE_DATE_ENGINE = "kiosk-server/lib/kiosk/server/argument_decoder.rb"
WIRE_DATE_ENTRY  = { WIRE_DATE_ENGINE => "def check_date!(",
                     WIRE_DATE_UNIT   => "ISO_DATE = " }.freeze
# How far past the entry point the shape may be built. Both producers put it
# within a line or two; the window exists so a later method cannot be read as
# this one's answer.
WIRE_DATE_WINDOW = 400
# The demos' notation: an anchored Ruby regexp literal, captured as source.
WIRE_DATE_DEMO_RE   = %r{ISO_DATE\s*=\s*/(\S+)/}
# The engine's notation: a `strftime`/`strptime` format literal.
WIRE_DATE_ENGINE_RE = /"(%[^"\n]*)"/

# @return [String, nil] the digit-group shape of an anchored regexp source, or
#   nil when it is not one this rule can read
def wire_date_shape_from_regexp(source)
  body = source.sub(/\A\\A/, "").sub(/\\z\z/, "")
  return nil if body.empty?

  out = body.gsub(/\\d\{(\d+(?:,\d*)?)\}/) { ::Regexp.last_match(1) }.gsub("\\d", "1")
  out.include?("\\") ? nil : out
end

# @return [String, nil] the digit-group shape of a strftime format, or nil when
#   it carries a directive whose width this rule cannot state
def wire_date_shape_from_strftime(format)
  out = format.gsub("%Y", "4").gsub("%y", "2").gsub("%m", "2").gsub("%d", "2").gsub("%j", "3")
  out.include?("%") ? nil : out
end

wire_date_sites = {}

wire_date_engine_path = File.join(ROOT, WIRE_DATE_ENGINE)
if File.file?(wire_date_engine_path)
  wire_src   = code_source(wire_date_engine_path)
  wire_idx   = wire_src.index(WIRE_DATE_ENTRY.fetch(WIRE_DATE_ENGINE))
  wire_fmts  = wire_idx.nil? ? [] : wire_src[wire_idx, WIRE_DATE_WINDOW].scan(WIRE_DATE_ENGINE_RE).flatten
  if wire_fmts.uniq.length > 1
    errors << "#{WIRE_DATE_ENGINE} parses a wire date with #{wire_fmts.uniq.map(&:inspect).join(' and ')} " \
              "inside one method (K-1467). One of those is the parse and the other is the round trip " \
              "that pins the field widths; while they disagree the engine accepts a shape neither of " \
              "them states, and no demo copy can be compared with it."
  end
  wire_date_sites[WIRE_DATE_ENGINE] =
    wire_fmts.length >= 2 && wire_fmts.uniq.length == 1 ? wire_date_shape_from_strftime(wire_fmts.first) : nil
else
  errors << "#{WIRE_DATE_ENGINE} is not in the tree — the engine half of the wire-date rule " \
            "(K-1467) is aimed at a file that no longer exists. Re-aim it or delete it; a rule " \
            "with no subject is not coverage."
end

wire_date_rel   = WIRE_DATE_UNIT.split("#").first
wire_date_ships = (FRAGMENTS[WIRE_DATE_UNIT] || {})[:ships]
if wire_date_ships.nil?
  errors << "the wire-date rule (K-1467) derives its demo list from " \
            "FRAGMENTS[#{WIRE_DATE_UNIT.inspect}], which is gone. The engine is then compared to " \
            "nothing at all until that entry is restored or this rule is given another source."
else
  wire_date_ships.each do |demo|
    path = (dups[wire_date_rel] || {})["kiosk-demo-#{demo}"]
    if path.nil?
      errors << "#{demo}: #{wire_date_rel} is declared in `ships:` for the wire-date rule (K-1467) " \
                "but is not in the tree."
      next
    end
    src = code_source(path)
    idx = src.index(WIRE_DATE_ENTRY.fetch(WIRE_DATE_UNIT))
    raw = idx.nil? ? nil : src[idx, WIRE_DATE_WINDOW][WIRE_DATE_DEMO_RE, 1]
    wire_date_sites["kiosk-demo-#{demo}/#{wire_date_rel}"] = raw && wire_date_shape_from_regexp(raw)
  end
end

# VACUITY: a producer this rule cannot read is not a producer that agrees — the
# same reasoning as the house sentence above. A `nil` folded in as one more
# value is how a rule starts confirming agreement between one site and nothing.
wire_date_silent = wire_date_sites.select { |_, shape| shape.nil? }.keys
if wire_date_silent.any?
  errors << "the accepted shape of a wire date cannot be read out of #{wire_date_silent.join(', ')} " \
            "(K-1467). A demo must build it from an anchored `ISO_DATE` regexp within " \
            "#{WIRE_DATE_WINDOW} characters of that assignment; the engine must name ONE strftime " \
            "format at least TWICE inside `check_date!` — once to parse and once to round-trip, " \
            "which is the half that pins the field widths, because strptime alone accepts " \
            "`2026-9-1`. A producer that has been restructured needs this rule re-aimed at where " \
            "it now states the shape. It may not simply become unreadable: an unread producer is " \
            "compared to nothing."
end

wire_date_shapes = wire_date_sites.values.compact.uniq
if wire_date_shapes.size > 1
  errors << "a date on the wire has #{wire_date_shapes.size} accepted shapes across the demos and " \
            "the engine — " +
            wire_date_sites.compact.map { |site, shape| "#{site} accepts #{shape.inspect}" }.join("; ") +
            " (K-1467, ADR-0029). Spec §8.1 rule 9 says a date is `YYYY-MM-DD` and nothing else, " \
            "and the engine's copy is the one an adopting operator inherits — so a disagreement " \
            "here is one origin answering a different protocol from the others, not a local " \
            "relaxation. The three demo copies are held in lockstep by FRAGMENTS, which means a " \
            "UNIFORM widening of all three passes every other rule in this file and only this one " \
            "can see it."
end

# ── Every `bin/` script a demo names EXISTS and is runnable (K-1315) ─────────
#
# WHAT WENT WRONG. All seven copies of `bin/setup` ended `exec "bin/dev"`, and
# `bin/dev` shipped in three demos. In the other four the first command a Rails
# developer types died of `Errno::ENOENT` on its last line — and this file,
# which is the one place that looks at those scripts at all, recorded `bin/dev`
# as "Rails generator output, identical where shipped" and never asked whether
# it was shipped. A byte-identity check over the copies that exist certifies
# nothing about the copies that do not. tudu had the same defect in a second
# spelling: `bin/setup`, `bin/rake` and `bin/dev` were tracked mode 100644, so
# there the script was not `ENOENT` but `EACCES`, and no rule here read a mode.
#
# WHY IT IS DERIVED RATHER THAN DECLARED. `ships:` on the two COPIES entries
# above is the declared half and it is real — a demo that drops `bin/dev` fails
# there. But it only holds the paths somebody thought to declare, and the defect
# was precisely that nobody had. This block asks the question the scripts
# themselves ask: every `bin/<name>` a demo's own `bin/` scripts or its README
# NAME must resolve — in that demo's `bin/`, or at the repo root's `bin/` — and
# the file it resolves to must be executable. Nothing has to be declared for a
# new reference to be checked, and nothing has to be remembered when one moves.
#
# HONEST SCOPE. It reads REFERENCES, not reachability: a `bin/` script nothing
# names is not reported here (the COPIES `ships:` sets are what hold those), and
# a name built at runtime from a variable is invisible. Comment-only lines are
# dropped from the scripts before scanning — a path discussed in a comment is
# not a path executed — but NOT from the README, where a `bin/…` in prose is an
# instruction to the operator and is exactly the thing that must resolve.
BIN_REF_RE = %r{(?<=[`"'\s(])(?:\./)?bin/([a-z0-9_][a-z0-9_-]*)}

bin_ref_files = 0
bin_refs      = 0
bin_local     = 0
demos.each do |dir|
  label   = short.(File.basename(dir))
  sources = Dir[File.join(dir, "bin", "*")].select { |f| File.file?(f) }.sort
  sources.each do |script|
    next if File.executable?(script)

    errors << "#{label}: #{script.delete_prefix("#{ROOT}/")} is not executable (mode " \
              "#{format('%o', File.stat(script).mode & 0o7777)}). A `bin/` script a demo ships is a " \
              "script an operator runs; tudu tracked three of them 100644 and `./bin/setup` answered " \
              "Permission denied there (K-1315)."
  end

  readme     = File.join(dir, "README.md")
  bin_corpus = sources.map { |f| [f, File.readlines(f).reject { |l| l =~ /\A\s*#/ }.join] }
  bin_corpus << [readme, File.read(readme)] if File.file?(readme)

  bin_corpus.each do |path, body|
    bin_ref_files += 1
    body.scan(BIN_REF_RE).flatten.uniq.each do |name|
      bin_refs += 1
      in_demo = File.join(dir, "bin", name)
      at_root = File.join(ROOT, "bin", name)
      where   = File.file?(in_demo) ? in_demo : (File.file?(at_root) ? at_root : nil)
      bin_local += 1 if where == in_demo

      if where.nil?
        errors << "#{label}: #{path.delete_prefix("#{ROOT}/")} names `bin/#{name}`, which exists " \
                  "neither in #{label}'s own bin/ nor at the repo root. This is K-1315's exact " \
                  "shape — seven copies of bin/setup exec'ing a bin/dev four of them did not ship. " \
                  "Ship the file or stop naming it."
      elsif !File.executable?(where)
        errors << "#{label}: #{path.delete_prefix("#{ROOT}/")} names `bin/#{name}` and " \
                  "#{where.delete_prefix("#{ROOT}/")} is not executable — the reference resolves to " \
                  "a file the operator cannot run (EACCES, not ENOENT, and just as fatal)."
      end
    end
  end
end

# VACUITY, both halves. A regex that stops matching reads exactly like a tree
# with nothing to complain about — the failure this repository has recorded
# four times over. The corpus must be the one in front of us, and it must
# actually contain the cross-file references this rule exists for.
expected_ref_files = demos.sum do |dir|
  Dir[File.join(dir, "bin", "*")].count { |f| File.file?(f) } + (File.file?(File.join(dir, "README.md")) ? 1 : 0)
end
if bin_ref_files != expected_ref_files
  errors << "check-demo-copies: the bin/-reference scan read #{bin_ref_files} file(s) where the tree " \
            "holds #{expected_ref_files}. A corpus that lost a document passes vacuously for it."
end
if bin_local.zero?
  errors << "check-demo-copies: the bin/-reference scan resolved NO reference to a demo's own bin/ " \
            "script. Either every demo stopped naming its own scripts — which is not a state this " \
            "repository has ever been in — or BIN_REF_RE stopped matching. A rule that matches " \
            "nothing is not a rule (K-1315)."
end

# ── EVERY DEMO SHIPS A CONTAINER PATH, AND THE RECIPE IS SHARED (T-192, K-1335) ─
#
# WHAT THIS RULE USED TO BE, AND WHY IT MOVED. It used to police an ABSENCE:
# `rails new` emits a `.dockerignore` next to the `Dockerfile` it also emits,
# these demos kept neither, and the ignore-file outlived the recipe in one demo
# at a time — three times, in three separate waves, each a hand sweep of the
# demos somebody happened to open. That half is still here, and it is the last
# rule below. What changed is the wider question the old rule deliberately left
# open: whether a self-hostable reference ought to ship a container recipe at
# all. It does now. An operator evaluating this repository expects to clone it
# and type one command, and until this rule the answer was that they had to
# install Postgres, hold a login permitted to `CREATE ROLE`, and have python3
# with numpy on PATH before anything would run at all.
#
# THE SHAPE, and it is the reason this is a rule rather than eight files. The
# demos' Gemfiles resolve the kiosk gems through `path: "../kiosk-<gem>"`, so a
# container build context CANNOT be a single demo directory — it has to be this
# repository. That makes the expensive half — the image — shared by
# construction: ONE `Dockerfile` at the repository root, carrying every demo's
# bundle, `psql`, python3+numpy, curl and jq. What is genuinely per-demo is
# four facts, and each of them is DERIVED from that demo's own tree rather than
# typed: the project name and the working directory (the demo's own directory
# name) and the port (the default its own `lib/tasks/demo.rake` declares).
#
# NON-VACUITY IS NOW STRUCTURAL, and that is the substantive change. The old
# rule's subject was empty — the tree held zero container files — so a count
# could never be its signal and it proved its detector against constructed
# names instead. Its subject is no longer empty, so the count IS the signal,
# and it is taken from the CORPUS: every `kiosk-demo-*` directory this script
# already discovered must have a compose file, so a demo added to this
# repository makes this rule fail until it has one. Nothing below enumerates
# demos, ports or database names; a hand-listed vacuity arm stops draining the
# moment the corpus grows, which is exactly what happened one guard over.
CONTAINER_IGNORE_RE = /\A\.(?:docker|container|podman)ignore\z/
CONTAINER_RECIPE_RE = /\A(?:Dockerfile|Containerfile)(?:\..+)?\z|\A.+\.(?:dockerfile|containerfile)\z|\A(?:docker-)?compose(?:\..+)?\.ya?ml\z/
CONTAINER_COMPOSE_RE = /\A(?:docker-)?compose(?:\..+)?\.ya?ml\z/
CONTAINER_IMAGE_RE   = /\A(?:Dockerfile|Containerfile)(?:\..+)?\z|\A.+\.(?:dockerfile|containerfile)\z/

container_truth = [
  [".dockerignore",    :ignore], [".containerignore", :ignore],
  ["Dockerfile",       :recipe], ["compose.yaml",     :recipe],
  ["docker-compose.yml", :recipe], ["Dockerfile.prod", :recipe],
  ["dockerignore",     :neither], ["README.md",        :neither],
]
container_truth.each do |name, want|
  got = if name =~ CONTAINER_IGNORE_RE then :ignore
        elsif name =~ CONTAINER_RECIPE_RE then :recipe
        else :neither
        end
  next if got == want

  errors << "check-demo-copies: the container-tooling detector reads #{name.inspect} as #{got} where " \
            "it must read #{want} (T-192). Every rule in this section is asked through this pair of " \
            "patterns — which demos have a recipe, which ignore-files are orphans — so a detector " \
            "that has stopped recognising its own subject answers all of them wrongly at once."
end

# THE CORPUS IS WHAT GIT CARRIES, because what ships is what git carries — but
# this guard's own `--self-test` runs it inside a plain file copy that is NOT a
# git repository, where `git ls-files` exits 128 and returns nothing. A rule
# that answered "nothing to check" there would be untestable by the one
# mechanism that proves it works, so the fallback walks the working tree
# instead and the census says which corpus answered.
CONTAINER_PRUNE = %w[.git .gems node_modules tmp log storage coverage public/assets].freeze

def container_walk(root)
  out   = []
  stack = [root]
  until stack.empty?
    dir = stack.pop
    Dir.children(dir).each do |name|
      abs = File.join(dir, name)
      if File.directory?(abs)
        stack << abs unless CONTAINER_PRUNE.include?(name)
      elsif File.file?(abs)
        out << abs.delete_prefix("#{root}/")
      end
    end
  end
  out
rescue SystemCallError
  []
end

container_ls, container_git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z")
container_source  = container_git.success? ? "tracked" : "working-tree"
container_tracked = container_git.success? ? container_ls.split("\0").reject(&:empty?) : container_walk(ROOT)
if container_tracked.length < 500
  errors << "check-demo-copies: the container-tooling rule walked #{container_tracked.length} " \
            "#{container_source} path(s), which is not this repository. The scan lost its corpus " \
            "(K-1335), and an empty corpus reports the same clean zero as a tree with nothing wrong " \
            "in it."
end

container_ignores  = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_IGNORE_RE }
container_recipes  = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_RECIPE_RE }
container_composes = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_COMPOSE_RE }
container_images   = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_IMAGE_RE }

#   (1) Every demo in the corpus has a container path
#
# The demo set is `demos`, discovered at the top of this script from the
# filesystem. Nothing here names one.
container_demo_names = demos.map { |d| File.basename(d) }
container_covered    = container_demo_names.select do |demo|
  container_composes.any? { |rel| File.dirname(rel) == demo }
end
(container_demo_names - container_covered).each do |demo|
  errors << "#{demo} ships no compose file, so it has no container path (T-192). Every demo in this " \
            "repository must be runnable with one command against a database it brings up itself — " \
            "that is the whole of what an operator evaluating Kiosk is entitled to expect, and it is " \
            "why the prerequisites block in the README of every other demo can say the host list is " \
            "optional. Add `#{demo}/compose.yaml` beside its siblings."
end
if container_demo_names.empty?
  errors << "check-demo-copies: the container-path rule found NO demo directories, so it is asserting " \
            "coverage over an empty set (T-192). The corpus this rule counts against is the same " \
            "`demos` list the rest of this script uses; an empty one makes every rule in this section " \
            "pass vacuously."
end

#   (2) The IMAGE is shared: exactly one, at the repository root
#
# A per-demo Dockerfile is the drift this whole script exists to stop, and here
# it would also be wrong on its own terms: the build context has to be the
# repository, so a recipe inside a demo directory cannot build that demo.
container_stray_images = container_images.reject { |rel| File.dirname(rel) == "." }
container_stray_images.each do |rel|
  errors << "#{rel} is a SECOND container image recipe. The image is shared on purpose (T-192): every " \
            "demo's Gemfile resolves the kiosk gems through `path: \"../kiosk-<gem>\"`, so the build " \
            "context is this repository and a recipe inside one demo cannot build it. One `Dockerfile` " \
            "at the repository root carries all of them; keeping a second one here means eight copies " \
            "of an install list, which is the drift the rest of this file is about."
end
if container_images.empty?
  errors << "check-demo-copies: there is no container image recipe anywhere in this repository, but " \
            "#{container_composes.length} compose file(s) declare a build (T-192). Every one of them " \
            "names a `Dockerfile` that is not here, so the one command each demo's README promises " \
            "fails at its first step."
end

#   (2b) The image is pinned to versions THIS repository actually runs
#
# Two numbers in the Dockerfile and one in every compose file are claims about
# an environment nobody here can test on a laptop without a container runtime,
# and both of them have a producer in this repository already: `ci.yml` says
# which Ruby every gem and demo job runs and which Postgres its services run,
# and `kiosk-core.gemspec` says the floor. So they are DERIVED and compared
# rather than remembered — a Ruby bump in CI that leaves the image behind is
# the shape this whole file exists to catch, one file further out.
container_ci_yml   = File.join(ROOT, ".github", "workflows", "ci.yml")
container_ci_body  = File.file?(container_ci_yml) ? File.read(container_ci_yml) : ""
container_ci_pg    = container_ci_body.scan(/^\s+image:\s*(postgres:[0-9]+(?:\.[0-9]+)*)\s*$/)
                                      .flatten.tally.max_by { |_, n| n }&.first
container_ci_ruby  = container_ci_body.scan(/^\s+ruby-version:\s*"([0-9][0-9.]*)"\s*$/).flatten.uniq
container_floor    = begin
  gemspec = File.join(ROOT, "kiosk-core", "kiosk-core.gemspec")
  File.file?(gemspec) ? File.read(gemspec)[/required_ruby_version\s*=\s*"\s*>=\s*([0-9][0-9.]*)"/, 1] : nil
end

if container_ci_pg.nil?
  errors << "check-demo-copies: no `image: postgres:<major>` in .github/workflows/ci.yml, so the " \
            "database-major rule below has nothing to compare the compose files against and passes " \
            "vacuously (T-192). Either CI stopped running Postgres as a service, or the shape this " \
            "reads changed."
end
if container_ci_ruby.empty?
  errors << "check-demo-copies: no `ruby-version:` in .github/workflows/ci.yml, so the image's Ruby " \
            "is compared against nothing and any version at all would read as clean (T-192)."
end

container_dockerfile = File.join(ROOT, "Dockerfile")
if File.file?(container_dockerfile)
  container_arg = File.read(container_dockerfile)[/^ARG\s+RUBY_VERSION=([0-9][0-9.]*)\s*$/, 1]
  if container_arg.nil?
    errors << "Dockerfile: no `ARG RUBY_VERSION=<version>` line (T-192). The base image's Ruby is the " \
              "one thing in this recipe that has to track something else in this repository, and " \
              "without that line there is nothing to hold it to."
  else
    if container_ci_ruby.any? && !container_ci_ruby.include?(container_arg)
      errors << "Dockerfile: `ARG RUBY_VERSION=#{container_arg}` names a Ruby " \
                ".github/workflows/ci.yml never runs (it runs #{container_ci_ruby.sort.join(', ')}) " \
                "(T-192). The container path is the one an operator meets FIRST, so it may not be the " \
                "one interpreter nothing here is tested on."
    end
    if container_floor && (Gem::Version.new(container_arg) < Gem::Version.new(container_floor))
      errors << "Dockerfile: `ARG RUBY_VERSION=#{container_arg}` is below the #{container_floor} " \
                "floor kiosk-core.gemspec declares in `required_ruby_version` (T-192). The image " \
                "could not install the gems it is built to run."
    end
  end
end

#   (3) Each compose file names ITS OWN demo, and the shared recipe
#
# Read as text rather than parsed: this script may not require a YAML parser to
# state a fact about four lines, and the shapes below are the ones an editor
# actually types. Each expectation is DERIVED — the demo's own directory name,
# and the port default in its own `lib/tasks/demo.rake`.
container_ports_derived = 0
container_composes.each do |rel|
  demo = File.dirname(rel)
  next unless container_demo_names.include?(demo)

  body = File.read(File.join(ROOT, rel))

  unless body.match?(/^name:\s*#{Regexp.escape(demo)}\s*$/)
    errors << "#{rel}: its compose project is not named `#{demo}` (T-192). The project name is what " \
              "keeps two demos brought up at the same time from sharing a database volume and a " \
              "network, so a copied-and-half-edited file silently joins its neighbour's project."
  end

  unless body.match?(%r{^\s+working_dir:\s*/kiosk/#{Regexp.escape(demo)}\s*$})
    errors << "#{rel}: its `working_dir` is not `/kiosk/#{demo}` (T-192). The image carries every " \
              "demo, so the working directory is the ONLY thing that decides which one this file " \
              "brings up — a stale one runs a different demo under this demo's name."
  end

  unless body.match?(/^\s+context:\s*\.\.\s*$/) && body.match?(/^\s+dockerfile:\s*Dockerfile\s*$/)
    errors << "#{rel}: it does not build from the shared `Dockerfile` with the repository as its " \
              "context (T-192). `context: ..` and `dockerfile: Dockerfile` are not decoration: this " \
              "demo's Gemfile resolves the kiosk gems through `path: \"../kiosk-<gem>\"`, so a " \
              "narrower context cannot install its dependencies at all."
  end

  # The database image major is derived from what CI actually runs, because the
  # tracked `db/structure.sql` these demos load is a dump in that major's format.
  if container_ci_pg && !body.match?(/^\s+image:\s*#{Regexp.escape(container_ci_pg)}\s*$/)
    errors << "#{rel}: its database service is not `#{container_ci_pg}`, which is the Postgres " \
              "`.github/workflows/ci.yml` runs (T-192). Every demo's `db/structure.sql` is a dump in " \
              "that major's format and `demo:setup` loads it with `psql`, so a container path on a " \
              "different major is a path this repository has never tested."
  end

  # The port is the demo's OWN default where it declares one. Where it does not
  # — kiosk-demo-prove's server is booted by a SIBLING demo's script under
  # `KIOSK_PROVE_PORT`, never by a task of its own — this rule has nothing to
  # compare against and says so rather than inventing an expectation.
  rake = File.join(ROOT, demo, "lib", "tasks", "demo.rake")
  port = File.file?(rake) ? File.read(rake)[/ENV\.fetch\("PORT",\s*"(\d+)"\)/, 1] : nil
  next if port.nil?

  container_ports_derived += 1
  unless body.match?(/^\s+PORT:\s*"#{port}"\s*$/) && body.match?(/^\s+- "#{port}:#{port}"\s*$/)
    errors << "#{rel}: it does not serve on port #{port}, which is the default #{demo}'s own " \
              "`lib/tasks/demo.rake` declares (T-192). The README tells an operator to open that " \
              "port; a compose file that publishes another one sends them to a page that is not " \
              "there, and two demos that drift onto the same port cannot be up at once."
  end
end
if container_ports_derived.zero?
  errors << "check-demo-copies: not ONE demo yielded a port default from its own " \
            "`lib/tasks/demo.rake`, so the compose-port rule compared nothing and read as coverage " \
            "(T-192). Either every demo stopped booting a server of its own — in which case delete " \
            "the rule — or the `ENV.fetch(\"PORT\", …)` shape it derives from changed."
end

#   (3b) The eight compose files are ONE file modulo the demo and the port
#
# Rule (3) holds each per-demo FIELD to what that demo's own tree says. This
# holds everything else — the database service, its healthcheck, the PG
# environment, the header prose an operator reads before typing the command —
# to being the same in all of them. Both are needed and neither implies the
# other: a field rule cannot see a healthcheck that was edited in one file, and
# a whole-file rule cannot see a field that is uniformly wrong.
#
# The normalisation is the demo's short name and its port, which is a claim
# about the design rather than a convenience: the container path was built so
# that those are the ONLY things that differ between demos, and this is where
# that claim is checked. Anything else that starts differing has to be declared
# by widening the normalisation, which is a deliberate act.
container_forms = {}
container_composes.each do |rel|
  demo = File.dirname(rel)
  next unless container_demo_names.include?(demo)

  body  = File.read(File.join(ROOT, rel))
  short = demo.sub(/\Akiosk-demo-/, "")
  port  = body[/^\s+PORT:\s*"(\d+)"\s*$/, 1]
  form  = body.gsub(short, "<DEMO>")
  form  = form.gsub(port, "<PORT>") if port
  (container_forms[form] ||= []) << rel
end

if container_forms.length > 1
  majority = container_forms.max_by { |_, rels| rels.length }
  container_forms.reject { |form, _| form.equal?(majority.first) }.each_value do |rels|
    errors << "#{rels.join(', ')}: the compose file differs from the #{majority.last.length} other(s) " \
              "in something OTHER than its own demo name and its own port (T-192). Those two are the " \
              "only per-demo facts this path has; everything else — the database service, its " \
              "healthcheck, the PG environment, the prose above them — is one file hand-copied eight " \
              "times, and a copy that drifts is the failure this whole script is about. Diff it " \
              "against #{majority.last.first} with the demo name and the port substituted out."
  end
end

if container_forms.empty?
  errors << "check-demo-copies: no compose file was read for the shared-form comparison, so the rule " \
            "that the eight are one file modulo the demo and the port compared nothing (T-192)."
end

# Two demos brought up at the same time must not fight over a host port. The
# published ports come out of the files themselves; nothing here lists them.
container_by_port = Hash.new { |h, k| h[k] = [] }
container_composes.each do |rel|
  next unless container_demo_names.include?(File.dirname(rel))

  File.read(File.join(ROOT, rel)).scan(/^\s+- "(\d+):\d+"\s*$/).flatten.each { |p| container_by_port[p] << rel }
end
container_by_port.select { |_, rels| rels.length > 1 }.each do |port, rels|
  errors << "#{rels.join(', ')} all publish host port #{port} (T-192). Two demos cannot be up at once " \
            "on one port, and the demos are meant to be — the wire is the point, and comparing two " \
            "storefronts is how an operator reads it."
end

#   (4) An ignore file only counts where the BUILD READS IT (K-1335, T-192)
#
# A container IGNORE file is an instruction to a container build, and a build
# reads exactly ONE of them: the one sitting in its context directory. That is
# the correction this rule needed when the repository grew a recipe. The old
# spelling asked whether a recipe existed in the ignore-file's own directory or
# in any ancestor — which was a fair rule while the tree held no recipe at all,
# and became VACUOUS the moment a `Dockerfile` landed at the repository root:
# every path in this repository has the root above it, so every `.dockerignore`
# anywhere would have read as legitimate, and K-1335's exact scaffolding could
# have walked back into all eight demos with this rule reporting clean.
#
# So the legitimate set is DERIVED from what the compose files declare: each
# one's `context:` resolved against its own directory, plus the directory of
# every image recipe. An ignore file outside that set is dead configuration —
# nothing will ever read it — which is what `rails new` leaves behind.
container_contexts = {}
container_images.each { |rel| container_contexts[File.dirname(rel)] = true }
container_composes.each do |rel|
  body = File.read(File.join(ROOT, rel))
  body.scan(/^\s+context:\s*(\S+)\s*$/).flatten.each do |ctx|
    dir = File.dirname(rel)
    container_contexts[File.expand_path(ctx, dir == "." ? "/" : "/#{dir}").delete_prefix("/").then { |d| d.empty? ? "." : d }] = true
  end
end

if container_contexts.empty?
  errors << "check-demo-copies: no build-context directory could be derived from any recipe or " \
            "compose file, so the orphaned-ignore-file rule has an empty legitimate set and would " \
            "call every ignore file — including a correct one — an orphan (T-192)."
end

container_ignores.each do |rel|
  dir = File.dirname(rel)
  next if container_contexts.key?(dir)

  errors << "#{rel} is an ORPHAN: it tells a container build what to leave out, and no build in this " \
            "repository reads it — a build reads the ignore file in its own CONTEXT directory, and " \
            "the contexts here are #{container_contexts.keys.sort.map { |d| d == '.' ? 'the repository root' : d }.join(', ')}. " \
            "This is K-1335's exact shape — `rails new` scaffolding whose recipe was deleted and " \
            "whose ignore-file was not, three times in three demos. Delete it, or make the directory " \
            "it sits in a context something actually builds from."
end

if errors.empty?
  guarded = COPIES.count { |_, e| e[:rule] != :per_demo }
  tpl_checked = GENERATOR_TEMPLATES.count { |_, e| !e[:not_compared] }
  pair_drift  = MIGRATION_PAIRS.count { |_, e| e[:drift] }
  puts "check-demo-copies: OK — #{dups.size} duplicated paths declared, #{guarded} kept in lockstep, " \
       "#{tpl_checked} install-generator templates byte-matched against their copies in all " \
       "#{operator_demos.size} operator demos (no exceptions available), " \
       "#{MIGRATION_PAIRS.size} cross-demo migration pairs (#{pair_drift} with drift pending triage), " \
       "app/services autoload-once resolved both ways in #{autoload_once_checked} demos, " \
       "OperationResult subclassed from kiosk-server in #{(dups[OPERATION_RESULT] || {}).size} demos, " \
       "no env resolution and no Rails-framework patching in the initializers of " \
       "#{initializer_demos} operator demos nor in the #{e2e_initializers} e2e harness " \
       "initializer fixtures run.sh installs " \
       "(#{INITIALIZER_ENV_FETCH_ALLOWED.size} declared ENV.fetch allowances), " \
       "one PLATFORMS set across #{lockfile_platforms.size} demo lockfiles, " \
       "application_controller.rb's superclass sentence checked against the tree in " \
       "#{prose_units.length} copies, " \
       "no retired 0.3 wire or error-shape vocabulary in the served body of " \
       "#{static_pages} static signpost pages, " \
       "#{env_cites} source-path cite(s) in #{env_templates} deploy/env templates resolved " \
       "against their own demo, " \
       "#{framework_claim_checks} cross-demo framework-prose assertions over " \
       "#{FRAMEWORK_CLAIMS.size} declared claims in #{corpus.size} demo document sets, " \
       "the flow-runner helper held in lockstep across #{flow_held.size} demos " \
       "(#{FLOW_RUNNER_VARIANTS.size} declared variant#{FLOW_RUNNER_VARIANTS.size == 1 ? '' : 's'}) " \
       "with its exit-status tail compared in all #{flow_tails.size}, " \
       "#{host_block_sites} host-detection block(s) in #{host_blocks.size} demo(s) held in one form " \
       "modulo each demo's own vanity host and paired one-to-one with the " \
       "#{host_pair_booting} rake task(s) that boot a server, " \
       "#{prose_path_cites} source-path and #{prose_code_refs} `{Constant}` citation(s) in the " \
       "comments of #{prose_corpus.size} compared file(s) resolved against the tree, " \
       "#{E2E_FIXTURES.size} e2e harness fixture(s) declared " \
       "(#{e2e_fixture_comparisons} comparison(s) against a demo copy, " \
       "#{E2E_FIXTURES.count { |_, e| e.key?(:pairs) && e[:pairs].nil? }} declared to have no " \
       "counterpart and checked for one), " \
       "#{fragment_comparisons} shared-unit cop#{fragment_comparisons == 1 ? 'y' : 'ies'} declared " \
       "in #{FRAGMENTS.size} unit(s) inside #{FRAGMENT_PATHS.size} `:per_demo` file(s) " \
       "(#{FRAGMENTS.count { |_, e| e[:rule] == :code }} unit(s) held in lockstep over " \
       "#{fragment_copies_compared} compared copies with #{fragment_exceptions_live} declared " \
       "exception(s), the rest declared " \
       "same-name-different-body; #{fragment_dsl_ids.size} reached only by the class-macro handle, " \
       "#{agree_groups} declared convergence group(s) of `:per_demo` copies confirmed against the " \
       "tree over both granularities, " \
       "#{FRAGMENT_EXCLUDED.size} `:per_demo` path(s) declared out of the rule with a reason), " \
       "one spelling (#{house_spellings.first.inspect}) of the absent-field refusal read off " \
       "#{house_sentence_sites.length} producer(s) — #{house_ships ? house_ships.length : 0} demo(s) " \
       "plus the engine, " \
       "one accepted shape (#{wire_date_shapes.first.inspect}) for a wire date read off " \
       "#{wire_date_sites.length} producer(s) in two notations — " \
       "#{wire_date_ships ? wire_date_ships.length : 0} demo(s) plus the engine, " \
       "#{bin_refs} `bin/` reference(s) in #{bin_ref_files} demo script(s) and README(s) resolved to " \
       "an existing executable (#{bin_local} of them to the demo's own bin/), " \
       "`validate_responses` gated off production in #{vr_demos} operator initializer(s) against " \
       "the engine's own hazard sentence, " \
       "a container path in #{container_covered.length} of #{container_demo_names.length} demo(s) " \
       "off ONE shared image (#{container_ports_derived} port(s) derived from the demos' own rake " \
       "defaults, Ruby and Postgres majors held against ci.yml) and no orphaned container tooling " \
       "in #{container_tracked.length} #{container_source} path(s) " \
       "(#{container_ignores.length} ignore file(s) against #{container_contexts.length} derived " \
       "build context(s), #{container_recipes.length} recipe(s); " \
       "detector proved on #{container_truth.length} constructed names), " \
       "no ledger id outside a comment in #{demo_id_files} demo Ruby file(s) " \
       "(pattern and lexer proved against #{DEMO_ID_FIXTURES.size} fixtures this rule owns; " \
       "bin/check-shipped-archaeology carries the SAME four bans — ledger id, ADR " \
       "reference, Cyrillic, maintainer name — into comments and prose, in the demos and " \
       "in the gems alike, and THAT script is also the one that reads a SENTENCE: its " \
       "R5/R6/R7 refuse a retired wire version, a past-state construction and a " \
       "repository path that resolves to nothing. THIS script reads none of them, so its " \
       "green line says nothing about narration in a compared copy — ask that one)"
  exit 0
end

warn "\ncheck-demo-copies FAILED:\n"
errors.each { |e| warn "  ✗ #{e}" }
warn "\nThe demos are separate Rails apps, so shared code is hand-copied. Every file that exists in " \
     "two or more of them must be declared in bin/check-demo-copies — kept identical, kept identical " \
     "modulo prose, or recorded as a deliberate per-demo variant with the reason."
exit 1
