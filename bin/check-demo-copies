# ── The engine side of the generator output (K-640, hardened at K-646) ───────
#
# The db/migrate entries in COPIES hold the demos' copies in lockstep with each
# other, which is necessary and not sufficient: `rails g kiosk:install` emits them
# from these templates, and the sibling rule never looks at a template — so a
# template edit that reached no demo, or a hand-edit to a copy that was never
# lifted back, would stay green.
#
# So every template under GENERATOR_TEMPLATES_DIR is declared here, rendered with
# plain ERB and the generator's own default options (GENERATOR_DEFAULTS; the
# templates' only ERB is `<%= options[:…] %>` substitution), and the render must
# byte-match the copy in EVERY ONE of the seven operator demos.
#
# THERE IS NO WAY TO RECORD AN EXCEPTION, and that is deliberate: an entry is
# `emits:` (compared, byte for byte, in all seven) or `not_compared:` (with the
# reason and where it is recorded), and there is no third state. A recordable
# drift converts «the build is red until you propagate» into «the build is green
# and someone will look at it».
#
# ONE_SET_EVERYWHERE below is the other half: every operator demo ships every
# canonical migration, because every operator demo IS one `kiosk:install` run. A
# demo that skips one, or a new demo scaffolded from a stale engine, fails here.
#
# Entry fields:
#   emits:        — the basename the generator writes (sans timestamp). The
#                   render must byte-match this file in all seven demos.
#   not_compared: — the template's output has a per-demo dimension; the reason
#                   says where that is recorded.
#
# Staleness is checked both ways, per this file's house rule: a template with no
# entry fails, an entry with no template fails, an `emits:` basename no demo ships
# fails, and a basename not shipped by ALL of them fails.
GENERATOR_TEMPLATES_DIR = "kiosk-server/lib/generators/kiosk/install/templates"

# The generator's own class_option defaults (install_generator.rb) — the
# values every demo was generated with.
GENERATOR_DEFAULTS = {
  schema: "kiosk", user_id_type: "uuid", user_table: "users", guc_namespace: "app",
}.freeze

# The seven operator demos. kiosk-demo-prove is the KYC BROKER, not an operator:
# it adopts no Kiosk engine schema at all (its two migrations are its own), so
# the all-seven rule must not ask it for generator output it has no business
# carrying.
NON_OPERATOR_DEMOS = %w[kiosk-demo-prove].freeze

GENERATOR_TEMPLATES = {
  "initializer.rb.tt" => {
