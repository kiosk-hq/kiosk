# ── The e2e fixture rule runs (T-118) ────────────────────────────────────────
e2e_fixture_comparisons = 0
e2e_fixture_dir = File.join(ROOT, E2E_FIXTURES_DIR)
e2e_run_sh_path = File.join(ROOT, E2E_RUN_SH)
if !File.directory?(e2e_fixture_dir) || !File.exist?(e2e_run_sh_path)
  errors << "check-demo-copies: #{E2E_FIXTURES_DIR}/ or #{E2E_RUN_SH} is gone, so the e2e fixture " \
            "rule compared NOTHING. The harness moving is a change to make on purpose — move this " \
            "rule with it rather than letting it inspect an empty directory (T-118)."
else
  installed = e2e_installed_paths(File.read(e2e_run_sh_path))
  if installed.empty?
    errors << "check-demo-copies: #{E2E_RUN_SH} has no `cp \"$FIXTURES/…\"` lines at all, so every " \
              "pairing this rule derives is empty. The derivation has broken, not the harness " \
              "(T-118)."
  end

  on_disk = Dir[File.join(e2e_fixture_dir, "*.rb")].map { |p| File.basename(p) }.sort
  (on_disk - E2E_FIXTURES.keys).each do |name|
    errors << "#{E2E_FIXTURES_DIR}/#{name}: exists but is not declared in E2E_FIXTURES. Say which " \
              "demo path it was copied from and which rule holds it — or declare `pairs: nil` with " \
              "the reason it has no counterpart. Five hand-written arms reached into this " \
              "directory one file at a time before it was a scan root; a new fixture may not " \
              "arrive unexamined (T-118)."
  end
  (E2E_FIXTURES.keys - on_disk).each do |name|
    errors << "#{E2E_FIXTURES_DIR}/#{name}: declared in E2E_FIXTURES but no longer on disk. Drop " \
              "the entry (T-118)."
  end

  (E2E_FIXTURES.keys & on_disk).each do |name|
    entry = E2E_FIXTURES[name]
    fixture = File.join(e2e_fixture_dir, name)
    errors << "#{E2E_FIXTURES_DIR}/#{name}: E2E_FIXTURES entry carries no `why:` reason" if entry[:why].to_s.strip.empty?

    declared_nil = entry.key?(:pairs) && entry[:pairs].nil?
    spec = entry.key?(:pairs) ? entry[:pairs] : installed[name]

    if spec.nil? && !declared_nil
      errors << "#{E2E_FIXTURES_DIR}/#{name}: #{E2E_RUN_SH} no longer copies it anywhere, so this " \
                "rule has no demo path to pair it with and silently compares nothing. Either the " \
                "fixture is run in place — declare `pairs:` explicitly — or it is dead; declare " \
                "`pairs: nil` with the reason (T-118)."
      next
    end

    if declared_nil
      # THE DECLARATION IS CHECKED. «No demo counterpart» must stay true: a demo
      # file of this basename that has become comment-identical to the fixture
      # is a copy nobody declared, which is the whole class this rule is for.
      twins = demos.flat_map { |dir| Dir[File.join(dir, "**", name)] }
                   .reject { |f| f.include?("/.gems/") }
                   .select { |f| code_digest(f) == code_digest(fixture) }
      unless twins.empty?
        errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `pairs: nil` — no demo counterpart — but " \
                  "#{twins.map { |f| f.delete_prefix("#{ROOT}/") }.sort.join(', ')} " \
                  "#{twins.size == 1 ? 'is' : 'are'} comment-identical to it. That is a copy, not " \
                  "an absence: pair it and give it a rule (T-118)."
      end
      next
    end

    rule = entry[:rule]
    unless %i[identical code per_demo].include?(rule)
      errors << "#{E2E_FIXTURES_DIR}/#{name}: paired with #{spec} but declares " \
                "`rule: #{rule.inspect}` — the fixture rule understands :identical, :code and " \
                ":per_demo, the same three the manifest above uses (T-118)."
      next
    end

    copies = demos.each_with_object({}) do |dir, acc|
      match = spec.include?("*") ? Dir[File.join(dir, spec)].sort.first : File.join(dir, spec)
      acc[short.(File.basename(dir))] = match if match && File.file?(match)
    end
    if copies.empty?
      errors << "#{E2E_FIXTURES_DIR}/#{name}: paired with `#{spec}`, and NO demo ships that path " \
                "any more — the pairing is stale, so this fixture is compared to nothing while " \
                "reading as declared. Re-pair it, or declare `pairs: nil` with the reason (T-118)."
      next
    end

    e2e_fixture_comparisons += copies.size
    case rule
    when :identical
      off = copies.reject { |_demo, path| byte_digest(path) == byte_digest(fixture) }
      next if off.empty?

      errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `:identical` to #{spec}, and " \
                "#{off.keys.sort.join(', ')} #{off.size == 1 ? 'does' : 'do'} not match it " \
                "byte-for-byte. The harness and the demo prove the same file; propagate the edit, " \
                "or say what makes the fixture its own and change the rule (T-118)."
    when :code
      off = copies.reject { |_demo, path| code_digest(path) == code_digest(fixture) }
      next if off.empty?

      errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `:code`-identical to #{spec}, and " \
                "#{off.keys.sort.join(', ')} #{off.size == 1 ? 'does' : 'do'} not match it once " \
                "comments and whitespace are normalised away (T-118)."
    when :per_demo
      converged = copies.select { |_demo, path| code_digest(path) == code_digest(fixture) }
      next unless converged.size == copies.size

      errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `:per_demo` against #{spec} — a deliberate " \
                "variant — but it is now comment-identical to " \
                "#{copies.size == 1 ? "#{copies.keys.first}'s copy" : "all #{copies.size} demo copies"}. " \
                "That is a hand-copy nobody decided to make: declare it `:code` and hold it there, " \
                "or restore what made the harness's version its own (T-118)."
    end
  end
end

if e2e_fixture_comparisons.zero? && E2E_FIXTURES.any?
  errors << "check-demo-copies: the T-118 fixture rule declares #{E2E_FIXTURES.size} fixture(s) " \
            "and compared NONE of them against a demo copy. Every pairing has gone `nil` or " \
            "stale, and a rule with nothing to compare passes everything."
end

# ── A comment in a compared file may not cite something that is not there ────
#    (T-117, generalising K-1021 from one sentence to the whole corpus)
#
# WHAT `rule: :code` MEANS, AND WHY THAT LEFT FOURTEEN HEADERS UNGUARDED.
# `:code` compares copies MODULO COMMENTS, so each copy's header may name its
# own demo — which is the whole point of the rule and is right. It also means
# every one of those headers is unconstrained BY CONSTRUCTION, and that is how
# «The Kiosk wire controllers ship their own bases inside kiosk-server» — false
# of all seven demos — survived in eight copies until a human read it (K-1017).
# K-1021 closed the class for ONE sentence in ONE file by deriving the answer
# from disk. Thirteen `:code` paths still had nothing.
#
# THE ANSWER IS NOT «COMPARE THE COMMENTS TOO», and it is worth saying why
# before saying what it is. Comparing them would delete the reason `:code`
# exists: `script/schema_flow.rb`'s header explains that demo's own catalogue,
# and seven identical explanations would each be wrong in six demos.
# Nor is it thirteen more bespoke arms in K-1021's shape — one derivation per
# sentence does not generalise, and the fourteenth header would be unguarded
# again.
#
# WHAT IS HELD INSTEAD IS THE PART OF A HEADER THAT IS MECHANICALLY FALSIFIABLE:
# its CITATIONS. These headers do not merely describe, they point — at files and
# at code — and a pointer is a claim the tree can answer. Two arms, both derived,
# no list:
#
#   * A SOURCE PATH named in a comment must exist. Same shape and the same
#     regex family as the K-1093 rule for deploy/env templates, which already
#     does this for a different corpus.
#   * A `{Constant}` or `{Constant.member}` reference must resolve. This is the
#     repository's own YARD-ish notation and it is used heavily —
#     `{Kiosk::UuidCheck}` and `{WireArguments}` through
#     `{Order::SETTLED_CART_REFERENCES_THIS_ROW}` and
#     `{Reservation.owned_by_current_principal}`. A rename that reaches the code
#     and not the six comments pointing at it is exactly the drift this file
#     exists for, one notation over.
#
#     BOTH COUNTS ARE PRINTED BY THE RUN, NOT FROZEN HERE, and that is a repair
#     rather than a style: this paragraph used to state «208 citations» and «147
#     citations of 56 distinct names» as MEASURED facts and offered `{UuidCheck}`
#     as its first example. T-189 promoted that module to `Kiosk::UuidCheck`, so
#     the example named a constant that occurs nowhere in the corpus, and both
#     numbers had drifted with the tree. The green line reports the live pair
#     every time this script runs; a number written down here is a claim nothing
#     rechecks.
#
# THE CORPUS IS EVERY `.rb` THE MANIFEST DECLARES, IN EVERY DEMO THAT SHIPS IT,
# PLUS `e2e/fixtures/` — not just the `:code` paths T-117 named. Restricting it
# to `:code` would itself be an undeclared exclusion: an `:identical` header can
# be identically false (this file's own header records that happening), and a
# `:per_demo` header is as unguarded as a `:code` one. The wider corpus was
# measured before it was chosen, and it is clean.
#
# WHAT THIS DOES NOT DO, stated because an over-claimed prose rule is what
# K-1021 was filed about. It cannot tell whether a sentence is TRUE — «the verb
# handlers are ActiveRecord since K-654» names no path and no constant, and
# nothing mechanical reaches it. It resolves a `{Constant}` by its LAST segment,
# so `{Kiosk::Server::ArgumentDecoder}` is satisfied by a class named
# `ArgumentDecoder` anywhere in the index; it does not check the namespace. It
# resolves a member against any file that defines the constant, not against the
# right one. And it is blind to a citation written any other way — a bare
# `UuidCheck` in prose, a path without a directory. It holds the pointers, and
# says so.
PROSE_PATH_CITE = %r{(?<![\w./-])(?!/)[a-z][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_.-]+)+\.(?:rb|yml|yaml|erb|sql|py|json|md|txt)\b}
PROSE_CODE_REF  = /\{([A-Z][A-Za-z0-9_]*(?:::[A-Z][A-Za-z0-9_]*)*)(?:[.#]([A-Za-z_][A-Za-z0-9_]*[?!]?))?\}/
# `scope :referencing`, `has_many :settlements`, `attr_reader :psp` — a member a
# class macro names. Deliberately permissive: this index only ever makes a
# reference RESOLVE, so a false entry costs a missed catch and never a false
# alarm, while a missing one would fail a comment that is right.
PROSE_MACRO_MEMBER = /\A\s*[a-z_][A-Za-z0-9_]*\s+:([A-Za-z_][A-Za-z0-9_]*[?!]?)/

# Where a definition may live: every demo's own code, the harness's fixtures,
# and every kiosk gem's `lib/` and `spec/`. Built once; ~700 files, ~0.2 s.
prose_index = []
demos.each { |dir| %w[app lib script spec db].each { |sub| prose_index.concat(Dir[File.join(dir, sub, "**", "*.rb")]) } }
prose_index.concat(Dir[File.join(ROOT, "e2e", "**", "*.rb")])
Dir[File.join(ROOT, "kiosk-*")].select { |d| File.directory?(d) && !File.basename(d).start_with?("kiosk-demo-") }.each do |gem_dir|
  prose_index.concat(Dir[File.join(gem_dir, "lib", "**", "*.rb")])
  prose_index.concat(Dir[File.join(gem_dir, "spec", "**", "*.rb")])
end
prose_index.uniq!

prose_defines = Hash.new { |h, k| h[k] = [] } # constant's LAST segment => [file, …]
prose_members = Hash.new { |h, k| h[k] = {} } # file => { member name => true }
prose_index.each do |path|
  File.foreach(path) do |line|
    if (m = line.match(/\A\s*(?:class|module)\s+([A-Z][A-Za-z0-9_:]*)/))
      prose_defines[m[1].split("::").last] << path
    end
    if (m = line.match(FRAGMENT_START))
      name = m[1] || m[2]
      prose_members[path][name] = true
      prose_defines[name] << path if m[2] # a constant is both a definition and a member
    elsif (m = line.match(PROSE_MACRO_MEMBER))
      prose_members[path][m[1]] = true
    end
  end
end

# The files whose comments are held: every `.rb` the manifest declares, in every
# demo that ships it, plus every e2e fixture.
prose_corpus = []
demos.each do |dir|
  COPIES.each_key do |rel|
    next unless rel.end_with?(".rb")

    Dir[File.join(dir, rel)].sort.each do |path|
      prose_corpus << [short.(File.basename(dir)), dir, rel, path] if File.file?(path)
    end
  end
end
Dir[File.join(e2e_fixture_dir, "*.rb")].sort.each do |path|
  prose_corpus << ["e2e", File.join(ROOT, "e2e"), "#{E2E_FIXTURES_DIR}/#{File.basename(path)}", path]
end

prose_path_cites = 0
prose_code_refs  = 0
e2e_install_targets = File.exist?(e2e_run_sh_path) ? e2e_installed_paths(File.read(e2e_run_sh_path)).values : []
prose_corpus.each do |(label, own_root, rel, path)|
  text = comment_prose(path)

  text.scan(PROSE_PATH_CITE) do |cite|
    prose_path_cites += 1
    # Four rungs, widest last: the citing file's own root (a demo, or `e2e/`),
    # the repository root, ONE package directory down (a shared header naming a
    # sibling demo's file, or a gem's `spec/`), and — for a fixture — a path
    # run.sh installs into the app it generates, which exists only at run time.
    next if File.exist?(File.join(own_root, cite)) ||
            File.exist?(File.join(ROOT, cite)) ||
            Dir[File.join(ROOT, "*", cite)].any? ||
            e2e_install_targets.include?(cite)

    errors << "#{label}: #{rel} — a comment cites the source path `#{cite}`, and no file of that " \
              "name exists in this demo, at the repository root, one package directory down, or " \
              "among the paths e2e/run.sh installs. `:code` compares copies modulo COMMENTS, so a " \
              "header that points at a file somebody moved or deleted rots silently in every copy " \
              "at once — which is how a false sentence lived in eight of them (K-1017/K-1021). " \
              "Fix the citation or restore the file (T-117)."
  end

  text.scan(PROSE_CODE_REF) do |(const, member)|
    prose_code_refs += 1
    last = const.split("::").last
    homes = prose_defines[last]
    if homes.empty?
      errors << "#{label}: #{rel} — a comment references `{#{const}}`, and no class, module or " \
                "constant of that name is defined in any demo, in e2e/, or in any kiosk gem's " \
                "lib/ or spec/. The braces are this repository's notation for a thing in the " \
                "code, so a name that resolves to nothing is either a rename that did not reach " \
                "the prose or a thing that was never code — say it in backticks if it is a beat " \
                "name rather than a constant (T-117)."
    elsif member && homes.uniq.none? { |home| prose_members[home][member] }
      errors << "#{label}: #{rel} — a comment references `{#{const}.#{member}}`, and none of the " \
                "#{homes.uniq.size} file(s) defining `#{last}` defines a `#{member}` — not as a " \
                "method, a constant, or a name a class macro declares. MEASURED example of this " \
                "exact shape: skooti's cart_mandate.rb pointed at `{WireArguments.uuid}` where " \
                "skooti's WireArguments defines `reservation_id` and `missing` and nothing else " \
                "(K-1264). Fix the reference or restore the member (T-117)."
    end
  end
end

# NON-VACUITY, one arm per pattern. Both of these are rules whose subject set is
# LIVE — unlike the promise ban in bin/check-demo-derivations, these patterns are
# supposed to match, and a zero means the extraction broke rather than that the
# corpus got tidier. EARLIER_WIRES is the standing example of what a silent zero
# buys: a rule that covered nothing, anywhere, for its whole existence, with
# nothing saying so.
if prose_corpus.empty?
  errors << "check-demo-copies: the T-117 citation rule read NO files — every `.rb` in COPIES has " \
            "moved, or the fixture directory has. A prose rule with no corpus passes everything."
else
  if prose_path_cites.zero?
    errors << "check-demo-copies: the T-117 citation rule found NO source-path citation in any of " \
              "the #{prose_corpus.size} compared file(s). There were 208 when it was written, so " \
              "zero means PROSE_PATH_CITE has stopped matching rather than that the headers " \
              "stopped pointing at files."
  end
  if prose_code_refs.zero?
    errors << "check-demo-copies: the T-117 citation rule found NO `{Constant}` reference in any " \
              "of the #{prose_corpus.size} compared file(s). There were 147 when it was written, " \
              "so zero means PROSE_CODE_REF has stopped matching rather than that the headers " \
              "stopped pointing at code."
  end
  if prose_defines.empty?
    errors << "check-demo-copies: the T-117 citation rule indexed #{prose_index.size} file(s) and " \
              "found NO class, module or constant in any of them, so every `{Constant}` reference " \
              "would resolve against an empty index. The index has broken, not the tree."
  end
end

# ── Cross-demo PROSE about the FRAMEWORK (K-1069) ────────────────────────────
#
# WHAT WENT WRONG, and it is the only reason this block exists. Three shapes,
# all from the K-1062..K-1066 wave, every one found by a human eye reading four
# documents in one sitting:
#
#   (a) THE SAME FACTUAL SENTENCE IN N DEMOS, TRUE IN SOME AND FALSE IN OTHERS.
#       K-1064: hoteling's «a follow-up release will mount these via the engine's
#       own routes drawer» beside getgrocery's «Mounting the engine draws all of
#       this in one line» — one framework fact, two documents shipping side by
#       side, one of them stale. K-1068 was the same sentence in six
#       `config/routes.rb`. K-1065's PoW leg was the same shape with the truth
#       and the falsehood swapped between demos.
#   (b) ONE DOCUMENT CONTRADICTING ITSELF. skooti's before-after asserted a KYC
#       registration gate in its opening and its closing paragraph that its own
#       shipped-gate list denied in the middle (K-1065). Two documents were not
#       even needed.
#   (c) A CLAIM ABOUT THE FRAMEWORK THAT WAS FALSE AT THE SOURCE. The routes
#       drawer again: the demos promised it as future work while
#       `kiosk-server/lib/kiosk/server/engine.rb` had shipped both drawers.
#
# WHY THIS IS NOT K-1051's GUARD, and the argument is MECHANISM rather than
# scope. K-1051 commissions a DERIVATION guard: a fenced block must equal what
# its named producer prints. Prose ABOUT THE FRAMEWORK has no producer to derive
# from, so that guard, fully built and green, would have caught none of (a), (b)
# or (c). The oracle here is cross-document AGREEMENT plus a binding to the
# framework file that makes the claim true.
#
# WHAT THIS BLOCK DOES. It declares a CORPUS — the per-demo documents every rule
# above leaves uncompared (`before-after.md`, declared per-demo at
# SKELETON_NOT_COMPARED with no checker of its own until now; `config/routes.rb`,
# declared per-demo there too and otherwise uncompared) —
# and a manifest of FRAMEWORK CLAIMS over it. Each claim carries up to five
# declarations, and each one answers a different one of the three shapes:
#
#   text:    a sentence that must appear VERBATIM (whitespace-normalised) in
#            every document listed in `ships:`. This is the (a) detector for
#            copies: the five `config/routes.rb` that were one line short of
#            getgrocery's and hoteling's would have failed here.
#   topic:   a regex naming the SUBJECT. Where it matches a corpus document,
#            `must:` has to match too. This is the (a) detector for PARAPHRASES,
#            which `text:` structurally cannot see — hoteling's stale sentence
#            and getgrocery's current one are not copies of each other, they are
#            two different texts about one fact, and only a topic can pair them.
#   forbids: regexes that may not match ANY corpus document. This is the (b)
#            detector, and it is honest about its limit: it finds contradictions
#            SOMEBODY DECLARED, never contradictions in general.
#   source:  a framework file + a regex that must match it. This is the (c)
#            detector. It fires when the producer stops saying the thing the
#            demos say about it.
#   ships:   which demos must carry the claim at all, the same declaration and
#            the same reason as `ships:` in COPIES above — a demo that silently
#            drops the subject, or grows it, changes the set with nothing
#            noticing.
#
# WHAT THIS BLOCK DOES **NOT** DO. Stated plainly, because an over-claimed guard
# is the defect this class keeps producing:
#
#   * IT CANNOT TELL WHICH OF TWO VARIANTS IS TRUE. It forces ONE text and binds
#     it to a source; choosing the text stays a human act. A corpus declared
#     around a false sentence enforces the false sentence in seven demos.
#   * IT CANNOT SEE AN UNDECLARED SELF-CONTRADICTION. skooti's KYC pair is caught
#     because a `forbids:` entry names it, not because anything here understands
#     KYC. A new contradiction, on a new subject, is invisible until someone
#     declares it — exactly as a new duplicated path is invisible to the lockstep
#     rule until it appears in a second demo.
#   * `source:` PROVES THE FRAMEWORK STILL SAYS IT, NOT THAT THE FRAMEWORK DOES
#     IT. Every binding below is aimed at CODE (a `routes` call, the absence of a
#     method, the absence of a token in a file) rather than at a comment, because
#     a comment satisfying a comment is a tautology — but it is still a proxy.
#   * A PARAPHRASE IN VOCABULARY NO `topic:` MATCHES IS INVISIBLE. That is the
#     residual hole and it does not close: the topic regexes are as wide as their
#     authors made them.
#   * FENCED BLOCKS ARE EXCLUDED from `before-after.md`. They are
#     bin/check-demo-derivations's territory (K-1051) — a transcript or a
#     snippet has a producer to derive from — and checking them here would
#     double-count the easy half and dilute this one.
#
# prove ships no corpus document of its own that makes framework claims: it is
# the smaller API-only broker (PROVE_SKELETON above), it has no `before-after.md`
# at all, and its `config/routes.rb` carries none of the operator wire-surface
# prose. It is excluded by `ships:`, not by an exception.
FRAMEWORK_CORPUS_RUBY = ["config/routes.rb", "config/routes/kiosk.rb"].freeze
FRAMEWORK_CORPUS_TEXT = ["before-after.md"].freeze
BEFORE_AFTER_FOUR = %w[atablefor getgrocery hoteling skooti].freeze

