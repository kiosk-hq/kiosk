    ships: %w[atablefor hoteling],
    why:   "SAME MACRO, DIFFERENT SETS: atablefor declares `confirmed`, `on_board` and " \
           "`owned_by_current_principal`; hoteling declares `live`, `owned_by_current_principal` " \
