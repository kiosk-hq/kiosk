#!/usr/bin/env ruby
# frozen_string_literal: true

# Every file that exists in two or more demos (plus e2e fixtures and the engine's install
# templates) is declared in a manifest below as :identical, :code (identical modulo comments
# and whitespace, magic comments compared) or :per_demo, and the copies must agree as declared.
# Also holds a few cross-demo properties no copy rule reaches: see each `# ──` banner.
# Usage: bin/check-demo-copies [--self-test]

require "digest"
require "erb"
require "open3"
require "ripper"

ROOT = File.expand_path("..", __dir__)

# ── --self-test: plant one break per rule in a throwaway copy; each must go red ──
if ARGV.include?("--self-test")
  require "fileutils"
  require "rbconfig"
  require "tmpdir"

  SELF_TEST_PROBE_RB =
    "# frozen_string_literal: true\n\n# A shared helper two demos grew in the same wave.\n" \
    "class SelfTestProbe\n  def self.call = :ok\nend\n"
  SELF_TEST_DISCOVERY_SHIPS =
    "    ships: %w[atablefor getgrocery philslist skooti stylish tudu],\n" \
    "    why:  \"Each origin's own capabilities, verbs and pages, read without a credential.\",\n"
  SELF_TEST_EXCLUSION_RE = /^  "script\/redteam_suite\.rb" => ".*",\n/
  SELF_TEST_DSL_LINE     = "    dsl_names.each { |name| fragment_dsl_ids[\"\#{rel}\#\#{name}\"] = true }\n"

  # `ops:` are applied to one fixture tree; the run must exit 1 and print `expect:`.
  SELF_TEST_PLANTS = [
    { id: "code-copy-diverges", rule: "copy comparison",
      what: "a rename reaches one of the `:code` copies",
      ops:  [[:edit, "kiosk-demo-philslist/script/equihash_register.rb", "equihash_solve", "solve_equihash"]],
      expect: /script\/equihash_register\.rb: declared :code — the copies must agree.+\[philslist\]/ },
    { id: "magic-comment-lost", rule: "copy comparison",
      what: "one copy loses `# frozen_string_literal: true`",
      ops:  [[:edit, "kiosk-demo-stylish/app/controllers/application_controller.rb",
              "# frozen_string_literal: true\n", ""]],
      expect: /application_controller\.rb: declared :code — prose may differ per demo, MAGIC comments may not/ },
    { id: "ships-stray-copy", rule: "copy comparison",
      what: "a copy appears in a demo outside the entry's `ships:` set",
      ops:  [[:copy, "kiosk-demo-atablefor/script/bound_assistant.rb",
              "kiosk-demo-hoteling/script/bound_assistant.rb"]],
      expect: /script\/bound_assistant\.rb: hoteling ships this file but is not in its declared `ships:` set/ },
    { id: "ships-copy-gone", rule: "copy comparison",
      what: "a demo named in `ships:` stops shipping the file",
      ops:  [[:delete, "kiosk-demo-stylish/script/bound_assistant.rb"]],
      expect: /script\/bound_assistant\.rb: `ships:` names stylish, which no longer ships/ },
    { id: "except-has-converged", rule: "copy comparison",
      what: "the excepted copy converges on its siblings",
      ops:  [[:copy, "kiosk-demo-tudu/config/puma.rb", "kiosk-demo-prove/config/puma.rb"]],
      expect: /config\/puma\.rb: `except:` for prove is stale/ },
    { id: "new-copy-undeclared", rule: "undeclared and stale entries",
      what: "a helper lands in two demos with no manifest entry",
      ops:  [[:write, "kiosk-demo-tudu/app/services/self_test_probe.rb", SELF_TEST_PROBE_RB],
             [:write, "kiosk-demo-philslist/app/services/self_test_probe.rb", SELF_TEST_PROBE_RB]],
      expect: /app\/services\/self_test_probe\.rb: exists in 2 demos \(philslist, tudu\) but is not declared/ },
    { id: "entry-no-longer-duplicated", rule: "undeclared and stale entries",
      what: "a copy is deleted, leaving an entry that compares one file",
      ops:  [[:delete, "kiosk-demo-philslist/test/wire/registration_test.rb"]],
      expect: /test\/wire\/registration_test\.rb: declared in COPIES but only stylish ships it/ },
    { id: "exclusion-no-longer-true", rule: "skeleton exclusions",
      what: "an excluded skeleton file is deleted from all but one demo",
      ops:  [[:delete, "kiosk-demo-philslist/config/initializers/cors.rb"],
             [:delete, "kiosk-demo-stylish/config/initializers/cors.rb"]],
      expect: /config\/initializers\/cors\.rb: recorded in SKELETON_NOT_COMPARED but only 1 demo ships it/ },
    { id: "template-regenerated-alone", rule: "generator templates",
      what: "an install template is edited and the demos are not regenerated",
      ops:  [[:edit, "kiosk-server/lib/generators/kiosk/install/templates/create_kiosk_schema.rb.tt",
              "  def up\n", "  def up\n    # engine-side change that never reached the demos\n"]],
      expect: /create_kiosk_schema\.rb\.tt: rendered with the generator's default options/ },
    { id: "template-undeclared", rule: "generator templates",
      what: "a new install template appears with no GENERATOR_TEMPLATES entry",
      ops:  [[:write, "kiosk-server/lib/generators/kiosk/install/templates/create_kiosk_audit_log.rb.tt",
              "class CreateKioskAuditLog < ActiveRecord::Migration[8.0]\n  def change; end\nend\n"]],
      expect: /create_kiosk_audit_log\.rb\.tt: new install-generator template not declared/ },
    { id: "spec-harness-unit-drifts", rule: "spec units",
      what: "one demo's copy of a `:code` test constant moves alone",
      ops:  [[:edit, "kiosk-demo-tudu/test/reader_clock_test.rb",
              "NOON_UTC = Time.utc(2026, 9, 14, 12)", "NOON_UTC = Time.utc(2026, 9, 14, 13)"]],
      expect: /NOON_UTC: the demo spec copies must agree once comments and whitespace are normalised/ },
    { id: "spec-harness-undeclared-unit", rule: "spec units",
      what: "a helper is copied into a second demo's test",
      ops:  [[:edit, "kiosk-demo-stylish/test/book_appointment_test.rb",
              "require \"test_helper\"\n", "require \"test_helper\"\n\ndef probe_shared_helper = :ok\n"],
             [:edit, "kiosk-demo-skooti/test/licence_flag_test.rb",
              "require \"test_helper\"\n", "require \"test_helper\"\n\ndef probe_shared_helper = :ok\n"]],
      expect: /probe_shared_helper: defined in 2 demo spec\/test file\(s\).*declared NOWHERE/ },
    { id: "vacuity-spec-harness-corpus", rule: "spec units",
      what: "the corpus glob stops matching",
      ops:  [[:edit, "bin/check-demo-copies",
              "DEMO_SPEC_SUBDIRS = %w[spec test].freeze", "DEMO_SPEC_SUBDIRS = %w[spec_gone].freeze"]],
      expect: /the demo-spec rule read 0 Ruby file\(s\)/ },
    { id: "vacuity-spec-harness-stale-entry", rule: "spec units",
      what: "a declared unit name the corpus no longer shares",
      ops:  [[:edit, "bin/check-demo-copies", "  \"TOKYO\" => {", "  \"TOKYO_RENAMED\" => {"]],
      expect: /SPEC_UNITS\["TOKYO_RENAMED"\]: declared, but it is defined in 0 file\(s\)/ },
    { id: "spec-whole-file-copied-at-one-path", rule: "shared spec paths",
      what: "a whole test file copied into a second demo at the same relative path",
      ops:  [[:copy, "kiosk-demo-philslist/test/board_clock_test.rb", "kiosk-demo-tudu/test/board_clock_test.rb"]],
      expect: %r{test/board_clock_test\.rb: 2 demos ship a file at this SAME relative path} },
    { id: "vacuity-spec-shared-path-key", rule: "shared spec paths",
      what: "the group key keeps its demo directory, so no duplicate can be found",
      ops:  [[:edit, "bin/check-demo-copies",
              "spec_by_relpath   = spec_corpus.group_by { |rel| rel.split(\"/\", 2).last }",
              "spec_by_relpath   = spec_corpus.group_by { |rel| rel }"]],
      expect: /the shared-spec-path rule grouped \d+ key\(s\) and \d+ of them are not a path/ },
    { id: "migration-pair-undeclared", rule: "migration pairs",
      what: "a demo's own migration is copied into a second demo at another timestamp",
      ops:  [[:copy, "kiosk-demo-philslist/db/migrate/20260101000010_create_categories_and_listings.rb",
              "kiosk-demo-tudu/db/migrate/20260101000011_create_categories_and_listings.rb"]],
      expect: /db\/migrate\/\*_create_categories_and_listings\.rb: ships in 2 demos at demo-specific timestamps/ },
    { id: "autoload-once-line-gone", rule: "autoload-once",
      what: "the autoload_once_paths line is dropped from one demo",
      ops:  [[:edit, "kiosk-demo-skooti/config/application.rb", /^.*autoload_once_paths.*\n/, ""]],
      expect: /skooti: config\/initializers\/kiosk\.rb names .* from app\/services but config\/application\.rb does not put app\/services/ },
    { id: "unit-one-sided-edit", rule: "fragments",
      what: "one of the held `devise` lines gains a module",
      ops:  [[:edit, "kiosk-demo-getgrocery/app/models/user.rb", "devise :database_authenticatable",
              "devise :database_authenticatable, :rememberable"]],
      expect: /app\/models\/user\.rb#devise: the copies must agree once comments and whitespace are normalised away/ },
    { id: "unit-except-has-converged", rule: "fragments",
      what: "the excepted copy converges on the others",
      ops:  [[:edit, "kiosk-demo-tudu/app/models/user.rb", "devise :database_authenticatable, :registerable",
              "devise :database_authenticatable"]],
      expect: /app\/models\/user\.rb#devise: `except:` for tudu is stale/ },
    { id: "fragment-path-shares-nothing", rule: "fragments",
      what: "a rename leaves a FRAGMENT_PATHS entry contributing nothing",
      ops:  [[:edit, "kiosk-demo-atablefor/app/models/booking.rb", "enum ", "enum_x "],
             [:edit, "kiosk-demo-atablefor/app/models/booking.rb", "belongs_to ", "belongs_to_x "],
             [:edit, "kiosk-demo-atablefor/app/models/booking.rb", "scope ", "scope_x "],
             [:edit, "kiosk-demo-atablefor/app/models/booking.rb", "include ", "include_x "]],
      expect: /app\/models\/booking\.rb: named in FRAGMENT_PATHS, and the extractor finds NO unit shared/ },
    { id: "per-demo-path-in-neither-list", rule: "fragments",
      what: "a `:per_demo` path drops out of FRAGMENT_EXCLUDED without joining FRAGMENT_PATHS",
      ops:  [[:edit, "bin/check-demo-copies", SELF_TEST_EXCLUSION_RE, ""]],
      expect: /script\/redteam_suite\.rb: declared `:per_demo` in COPIES but named neither/ },
    { id: "vacuity-fragment-comparisons", rule: "fragments",
      what: "the fragment rule stops comparing anything",
      ops:  [[:edit, "bin/check-demo-copies", "  fragment_comparisons += held.size\n", ""]],
      expect: /the fragment rule declares \d+ unit\(s\) and compared NONE of them/ },
    { id: "vacuity-fragment-except", rule: "fragments",
      what: "the `:code` arm stops partitioning, so a declared exception excuses nothing",
      ops:  [[:edit, "bin/check-demo-copies", "    fragment_exceptions_live += excused.size\n", ""]],
      expect: /FRAGMENTS declares \d+ `except:` entr(?:y|ies) and NONE of them was reached/ },
    { id: "vacuity-class-macro-handle", rule: "fragments",
      what: "the class-macro handle stops seeing a class body",
      ops:  [[:edit, "bin/check-demo-copies", SELF_TEST_DSL_LINE, ""]],
      expect: /the class-macro handle found NO class-body macro/ },
    { id: "two-of-three-converge", rule: "partial convergence",
      what: "two `:per_demo` copies quietly become one unit",
      ops:  [[:edit, "kiosk-demo-skooti/app/models/user.rb", "has_many :reservations,", "has_many :appointments,"]],
      expect: /app\/models\/user\.rb#has_many: \[skooti,stylish\] — 2 of 6 copies — agree/ },
    { id: "lockstep-group-shrinks", rule: "partial convergence",
      what: "a one-sided edit inside a `:lockstep` group",
      ops:  [[:copy, "kiosk-demo-getgrocery/test/wire/discovery_test.rb", "kiosk-demo-skooti/test/wire/discovery_test.rb"],
             [:edit, "bin/check-demo-copies", SELF_TEST_DISCOVERY_SHIPS,
              SELF_TEST_DISCOVERY_SHIPS + "    agree: { %w[getgrocery skooti] => { rule: :lockstep, why: \"probe\" } },\n"],
             [:edit, "kiosk-demo-skooti/test/wire/discovery_test.rb", "\"GET \#{path} with no credential\"", "\"GET \#{path}\""]],
      expect: /test\/wire\/discovery_test\.rb: `agree:` holds \[getgrocery,skooti\] in lockstep/ },
    { id: "fourth-demo-joins-group", rule: "partial convergence",
      what: "a third copy joins a group that already agrees",
      ops:  [[:copy, "kiosk-demo-getgrocery/test/wire/discovery_test.rb", "kiosk-demo-skooti/test/wire/discovery_test.rb"],
             [:copy, "kiosk-demo-getgrocery/test/wire/discovery_test.rb", "kiosk-demo-stylish/test/wire/discovery_test.rb"],
             [:edit, "bin/check-demo-copies", SELF_TEST_DISCOVERY_SHIPS,
              SELF_TEST_DISCOVERY_SHIPS + "    agree: { %w[getgrocery skooti] => { rule: :lockstep, why: \"probe\" } },\n"]],
      expect: /test\/wire\/discovery_test\.rb: `agree:` declares \[getgrocery,skooti\] and stylish has since joined/ },
    { id: "coincidence-has-ended", rule: "partial convergence",
      what: "a legitimate divergence inside a `:coincidence`",
      ops:  [[:edit, "kiosk-demo-hoteling/app/models/user.rb",
              "has_many :bookings, dependent: :destroy", "has_many :bookings, dependent: :restrict_with_error"]],
      expect: /app\/models\/user\.rb#has_many: `agree:` records \[atablefor,hoteling\] as a `:coincidence` and the coincidence has ended/ },
    { id: "coincidence-over-the-cap", rule: "partial convergence",
      what: "a whole copied file labelled `:coincidence`",
      ops:  [[:copy, "kiosk-demo-getgrocery/test/wire/discovery_test.rb", "kiosk-demo-skooti/test/wire/discovery_test.rb"],
             [:edit, "bin/check-demo-copies", SELF_TEST_DISCOVERY_SHIPS,
              SELF_TEST_DISCOVERY_SHIPS + "    agree: { %w[getgrocery skooti] => { rule: :coincidence, why: \"probe\" } },\n"]],
      expect: /`agree:` calls \[getgrocery,skooti\] a `:coincidence`, but what they agree on is \d+ normalised lines and the cap is 12/ },
    { id: "vacuity-agree-confirmation", rule: "partial convergence",
      what: "the grouping pass stops running",
      ops:  [[:edit, "bin/check-demo-copies", "def agree_check(label, what, bodies, declared, errors)\n",
              "def agree_check(label, what, bodies, declared, errors)\n  return 0\n"]],
      expect: /declares \d+ `agree:` group\(s\) of converged `:per_demo` copies and this run CONFIRMED none/ },
    { id: "vacuity-convergence-census", rule: "partial convergence",
      what: "the convergence census records nothing",
      ops:  [[:edit, "bin/check-demo-copies", "  AGREE_CENSUS << label\n", ""]],
      expect: /the convergence census recorded NO compared subject/ },
    { id: "initializer-patches-framework", rule: "framework patch",
      what: "an initializer includes a module into a Rails class",
      ops:  [[:prepend, "kiosk-demo-hoteling/config/initializers/kiosk.rb",
              "ActiveRecord::Migration.include(Kiosk::RLS::DSL)\n"]],
      expect: /hoteling: config\/initializers\/kiosk\.rb:1 calls ActiveRecord::Migration\.include/ },
    { id: "vacuity-initializer-corpus", rule: "framework patch",
      what: "the per-demo initializer walk comes back empty",
      ops:  [[:edit, "bin/check-demo-copies",
              "  paths = Dir[File.join(ROOT, demo, \"config/initializers\", \"*.rb\")].sort\n",
              "  paths = []\n"]],
      expect: /the framework-patch rule scanned NO initializers/ },
    { id: "driver-env-defaulted-server-url", rule: "driver env",
      what: "a red-team suite regrows a hard-coded SERVER_URL default",
      ops:  [[:edit, "kiosk-demo-hoteling/script/redteam_suite.rb",
              "BASE_URL = ENV.fetch(\"SERVER_URL\")",
              "BASE_URL = ENV.fetch(\"SERVER_URL\", \"http://127.0.0.1:3003\")"]],
      expect: /hoteling: script\/redteam_suite\.rb:\d+ fetches SERVER_URL WITH a default/ },
    { id: "driver-env-single-demo", rule: "driver env",
      what: "a single-demo driver regrows it",
      ops:  [[:edit, "kiosk-demo-skooti/script/rental_flow.rb",
              "issuer = ENV.fetch(\"SERVER_URL\")",
              "issuer = ENV.fetch(\"SERVER_URL\", \"http://127.0.0.1:3004\")"]],
      expect: /skooti: script\/rental_flow\.rb:\d+ fetches SERVER_URL WITH a default/ },
    { id: "vacuity-driver-env-server-url", rule: "driver env",
      what: "the rule stops matching any driver's SERVER_URL fetch",
      ops:  [[:edit, "bin/check-demo-copies",
              "  \"SERVER_URL\" => \"the origin every request in the file is sent to",
              "  \"SERVER_URL_RENAMED\" => \"the origin every request in the file is sent to"]],
      expect: /driver-env rule found NO no-default fetch of SERVER_URL_RENAMED/ },
    { id: "e2e-fixture-undeclared", rule: "e2e fixtures",
      what: "a new harness fixture arrives with no E2E_FIXTURES entry",
      ops:  [[:write, "e2e/fixtures/probe_helper.rb",
              "# frozen_string_literal: true\n\n# A helper the harness grew.\nmodule ProbeHelper\nend\n"]],
      expect: /e2e\/fixtures\/probe_helper\.rb: exists but is not declared in E2E_FIXTURES/ },
    { id: "e2e-fixture-diverges", rule: "e2e fixtures",
      what: "the harness copy and the demo copy of one file stop agreeing",
      ops:  [[:edit, "e2e/fixtures/create_kiosk_pay_stripe_customers.rb", /\nend\n\z/, "\n  # probe\nend\n"]],
      expect: /e2e\/fixtures\/create_kiosk_pay_stripe_customers\.rb: declared `:identical`/ },
    { id: "lockfile-platforms-drift", rule: "lockfile platforms",
      what: "one lockfile loses a platform",
      ops:  [[:edit, "kiosk-demo-philslist/Gemfile.lock", "\n  x86_64-linux\n", "\n"]],
      expect: /philslist: Gemfile\.lock PLATFORMS differs from the other demos/ },
    { id: "exec-target-missing", rule: "bin scripts",
      what: "a demo stops shipping the bin/dev its bin/setup execs",
      ops:  [[:delete, "kiosk-demo-hoteling/bin/dev"]],
      expect: /hoteling: kiosk-demo-hoteling\/bin\/setup names `bin\/dev`, which exists neither in hoteling's own bin\/ nor at the repo root/ },
    { id: "exec-target-not-executable", rule: "bin scripts",
      what: "a shipped bin/ script loses its executable bit",
      ops:  [[:chmod, "kiosk-demo-tudu/bin/dev", 0o644]],
      expect: /tudu: kiosk-demo-tudu\/bin\/dev is not executable \(mode 644\)/ },
    { id: "readme-names-absent-script", rule: "bin scripts",
      what: "a README names a script the demo does not ship",
      ops:  [[:edit, "kiosk-demo-skooti/README.md", "bin/rails db:reset     # DROPS", "bin/reset-fleet     # DROPS"]],
      expect: /skooti: kiosk-demo-skooti\/README\.md names `bin\/reset-fleet`, which exists neither/ },
    { id: "vacuity-bin-ref-pattern", rule: "bin scripts",
      what: "BIN_REF_RE stops matching",
      ops:  [[:edit, "bin/check-demo-copies", "(?:\\./)?bin/([a-z0-9_][a-z0-9_-]*)", "(?:\\./)?bin-gone/([a-z0-9_][a-z0-9_-]*)"]],
      expect: /resolved NO reference to a demo's own bin\/ script/ },
    { id: "demo-without-container-path", rule: "containers",
      what: "a demo ships no compose file",
      ops:  [[:delete, "kiosk-demo-tudu/compose.yaml"]],
      expect: /kiosk-demo-tudu ships no compose file/ },
    { id: "compose-runs-another-demo", rule: "containers",
      what: "a half-edited compose file brings up a different demo",
      ops:  [[:edit, "kiosk-demo-tudu/compose.yaml",
              "working_dir: /kiosk/kiosk-demo-tudu", "working_dir: /kiosk/kiosk-demo-skooti"]],
      expect: %r{kiosk-demo-tudu/compose\.yaml: its `working_dir` is not} },
    { id: "compose-port-not-published", rule: "containers",
      what: "a demo moves its port and the compose file publishes the old one",
      ops:  [[:edit, "kiosk-demo-stylish/compose.yaml", 'PORT: "3005"', 'PORT: "3105"']],
      expect: %r{kiosk-demo-stylish/compose\.yaml: it does not publish the port it serves on, 3105} },
    { id: "compose-shared-half-drifts", rule: "containers",
      what: "one compose file's database service is edited alone",
      ops:  [[:edit, "kiosk-demo-philslist/compose.yaml",
              "pg_isready -U postgres", "pg_isready -U postgres -d postgres"]],
      expect: %r{compose\.yaml: the compose file differs from the \d+ other\(s\)} },
    { id: "compose-port-collision", rule: "containers",
      what: "two demos publish the same host port",
      ops:  [[:edit, "kiosk-demo-tudu/compose.yaml",
              '      - "3007:3007"', "      - \"3007:3007\"\n      - \"3003:3007\""]],
      expect: /all publish host port 3003/ },
    { id: "second-image-recipe", rule: "containers",
      what: "a demo grows its own Dockerfile",
      ops:  [[:write, "kiosk-demo-skooti/Dockerfile", "FROM ruby:4.0.1-slim\nRUN echo hi\n"]],
      expect: %r{kiosk-demo-skooti/Dockerfile is a SECOND container image recipe} },
    { id: "image-ruby-drifts-from-ci", rule: "containers",
      what: "the image's Ruby stops being one CI runs",
      ops:  [[:edit, "Dockerfile", /^ARG RUBY_VERSION=[0-9][0-9.]*$/, "ARG RUBY_VERSION=3.2.9"]],
      expect: /`ARG RUBY_VERSION=3\.2\.9` names a Ruby \.github\/workflows\/ci\.yml never runs/ },
    { id: "orphan-container-ignore", rule: "containers",
      what: "a demo grows back a `.dockerignore` no build reads",
      ops:  [[:write, "kiosk-demo-hoteling/.dockerignore",
              "# See https://docs.docker.com/engine/reference/builder/#dockerignore-file\n/.git/\n/tmp/*\n"]],
      expect: /kiosk-demo-hoteling\/\.dockerignore is an ORPHAN/ },
    { id: "vacuity-container-detector", rule: "containers",
      what: "the ignore-file pattern stops matching its own subject",
      ops:  [[:edit, "bin/check-demo-copies",
              "CONTAINER_IGNORE_RE = /\\A\\.(?:docker|container|podman)ignore\\z/",
              "CONTAINER_IGNORE_RE = /\\A\\.nothing-matches-this\\z/"]],
      expect: /the container-tooling detector reads "\.dockerignore" as neither/ },
    { id: "vacuity-container-corpus", rule: "containers",
      what: "the file walk comes back empty",
      ops:  [[:edit, "bin/check-demo-copies",
              "container_tracked = container_git.success? ? container_ls.split(\"\\0\").reject(&:empty?) : container_walk(ROOT)",
              "container_tracked = []"]],
      expect: /the container-tooling rule walked 0 (?:tracked|working-tree) path\(s\)/ },
    { id: "vacuity-no-port-anywhere", rule: "containers",
      what: "no compose file sets a PORT any more",
      ops:  [[:each, "kiosk-demo-*/compose.yaml", /PORT: "\d+"/, 'PORT_UNSET: "0"']],
      expect: /not ONE compose file sets a `PORT`/ },
    { id: "vacuity-ci-postgres-unreadable", rule: "containers",
      what: "ci.yml stops declaring a Postgres service",
      ops:  [[:edit, ".github/workflows/ci.yml", "image: postgres:17", "image: pg-service:17"]],
      expect: /no `image: postgres:<major>` in \.github\/workflows\/ci\.yml/ },
  ].freeze

  st_bad = []
  st_ls, st_git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
  abort "check-demo-copies --self-test: `git ls-files` failed in #{ROOT}." unless st_git.success?
  st_rels = st_ls.split("\0").select { |r| File.file?(File.join(ROOT, r)) }
  st_jobs = [4, SELF_TEST_PLANTS.length].min
  st_results = Array.new(SELF_TEST_PLANTS.length)

  Dir.mktmpdir("check-demo-copies-self-test") do |tmp|
    st_trees = (0...st_jobs).map do |i|
      tree = File.join(tmp, "tree#{i}")
      FileUtils.mkdir_p(st_rels.map { |r| File.dirname(File.join(tree, r)) }.uniq)
      st_rels.each { |r| FileUtils.copy_file(File.join(ROOT, r), File.join(tree, r), true) }
      tree
    end
    st_run = lambda do |tree|
      out, status = Open3.capture2e(RbConfig.ruby, File.join(tree, "bin", "check-demo-copies"))
      [out, status.exitstatus]
    end

    base_out, base_code = st_run.call(st_trees[0])
    unless base_code.zero?
      st_bad << "the untouched copy is not green (exit #{base_code.inspect}); run bin/check-demo-copies bare first:\n" +
                base_out.lines.grep(/✗/).first(4).map { |l| "      #{l.rstrip[0, 160]}" }.join("\n")
    end

    if st_bad.empty?
      queue = SELF_TEST_PLANTS.each_with_index.to_a
      lock  = Mutex.new
      st_trees.map do |tree|
        Thread.new do
          loop do
            plant, idx = lock.synchronize { queue.shift }
            break if plant.nil?

            touched = plant[:ops].flat_map do |op|
              case op[0]
              when :copy then [op[2]]
              when :each then Dir[File.join(tree, op[1])].sort.map { |f| f.delete_prefix("#{tree}/") }
              else [op[1]]
              end
            end.uniq
            saved = touched.to_h do |rel|
              path = File.join(tree, rel)
              [rel, File.exist?(path) ? [File.binread(path), File.stat(path).mode & 0o7777] : nil]
            end

            trouble = nil
            out = code = nil
            begin
              plant[:ops].each do |op|
                path = File.join(tree, op[0] == :copy ? op[2] : op[1])
                case op[0]
                when :edit
                  before = File.exist?(path) ? File.read(path) : nil
                  after  = before&.gsub(op[2]) { op[3] }
                  trouble ||= "the needle #{op[2].inspect} does not occur in #{op[1]}" if before.nil? || after == before
                  File.write(path, after) if after
                when :prepend
                  File.write(path, op[2] + File.read(path))
                when :write
                  FileUtils.mkdir_p(File.dirname(path))
                  File.write(path, op[2])
                when :chmod
                  trouble ||= "#{op[1]} is absent" unless File.exist?(path)
                  File.chmod(op[2], path) if File.exist?(path)
                when :delete
                  trouble ||= "#{op[1]} is already absent" unless File.exist?(path)
                  FileUtils.rm_f(path)
                when :copy
                  src = File.join(tree, op[1])
                  trouble ||= "#{op[1]} does not exist" unless File.exist?(src)
                  FileUtils.mkdir_p(File.dirname(path))
                  FileUtils.copy_file(src, path, true) if File.exist?(src)
                when :each
                  hits = Dir[File.join(tree, op[1])].select do |f|
                    before = File.read(f)
                    after  = before.gsub(op[2]) { op[3] }
                    File.write(f, after) unless after == before
                    after != before
                  end
                  trouble ||= "the needle #{op[2].inspect} occurs in no file #{op[1].inspect} matches" if hits.empty?
                end
              end
              out, code = st_run.call(tree) if trouble.nil?
            ensure
              saved.each do |rel, snap|
                p = File.join(tree, rel)
                if snap.nil?
                  FileUtils.rm_f(p)
                else
                  File.binwrite(p, snap[0])
                  File.chmod(snap[1], p)
                end
              end
            end

            drift = touched.reject do |rel|
              a = File.join(tree, rel)
              b = File.join(ROOT, rel)
              File.exist?(a) == File.exist?(b) &&
                (!File.exist?(a) || Digest::SHA256.file(a).hexdigest == Digest::SHA256.file(b).hexdigest)
            end
            st_results[idx] = { plant: plant, trouble: trouble, code: code, out: out.to_s, drift: drift }
          end
        end
      end.each(&:join)
    end
  end

  st_results.compact.each do |r|
    plant = r[:plant]
    failure = if r[:trouble]
                "the plant did not apply — #{r[:trouble]}. Re-point it at the live text."
              elsif r[:code] != 1
                "planted «#{plant[:what]}» and the check exited #{r[:code].inspect}, not 1."
              elsif r[:out] !~ plant[:expect]
                "red, but nothing matched #{plant[:expect].inspect}. First failure:\n      " +
                  r[:out].lines.grep(/✗/).first.to_s.rstrip[0, 200]
              elsif r[:drift].any?
                "after restoring, #{r[:drift].join(', ')} no longer matches the original."
              end
    if failure
      st_bad << "#{plant[:id]} (#{plant[:rule]}): #{failure}"
    else
      puts format("  RED  %-36s %s", plant[:id], plant[:what])
    end
  end

  if st_bad.empty?
    puts "\ncheck-demo-copies --self-test: OK — #{SELF_TEST_PLANTS.length} plant(s), every one red and named."
    exit 0
  end
  warn "\ncheck-demo-copies --self-test FAILED:\n"
  st_bad.each { |b| warn "  ✗ #{b}" }
  exit 1
end

