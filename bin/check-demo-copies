# Hand-written migrations shipped by several demos at their own timestamps, by
# timestamp-stripped basename => { rule: :identical | :code, why: }.
MIGRATION_PAIRS = {}.freeze

# ── Normalisation: Ripper drops comments and collapses whitespace between tokens ──
COMMENT_TOKENS = %i[on_comment on_embdoc on_embdoc_beg on_embdoc_end].freeze

def code_norm(src)
  body = Ripper.lex(src).filter_map do |(_pos, type, tok)|
    next if COMMENT_TOKENS.include?(type)

    type == :on_sp ? ' ' : tok
  end.join
  body.lines.map(&:strip).reject(&:empty?).join("\n")
end

def code_digest(path) = Digest::SHA256.hexdigest(code_norm(File.read(path)))

def byte_digest(path) = Digest::SHA256.file(path).hexdigest

# ── Partial convergence: agreeing subsets of :per_demo copies must be declared in `agree:` ──
# :lockstep holds the group; :coincidence records it, capped at AGREE_COINCIDENCE_MAX_LINES.
AGREE_RULES = %i[lockstep coincidence].freeze
AGREE_COINCIDENCE_MAX_LINES = 12
# Checks `agree:` declarations against the copies that agree, and records what it saw.
class AgreeCheck
  attr_reader :census, :confirmed

  def initialize(errors)
    @errors    = errors
    @census    = []
    @confirmed = 0
  end

  # `bodies` maps each demo to its normalised copy; `declared` is the entry's `agree:`.
  def check(label, what, bodies, declared)
    start(label, bodies, declared)
    @declared.each { |demos, spec| check_declaration(what, demos, spec) }
    @widened = widened_groups
    @groups.each { |demos, norm| check_group(demos, norm) }
    @declared.each { |demos, spec| check_dissolved(demos, spec) }
  end

  private

  def start(label, bodies, declared)
    @census << label
    @label    = label
    @bodies   = bodies
    @declared = (declared || {}).to_h { |demos, spec| [demos.sort, spec] }
    @groups   = bodies.group_by { |_demo, norm| norm }
                      .values.select { |g| g.size >= 2 }
                      .to_h { |g| [g.map(&:first).sort, g.first[1]] }
  end

  def check_declaration(what, demos, spec)
    return @errors << "#{@label}: `agree:` declares #{demos.inspect}; an agreement is two copies or more." if demos.size < 2

    absent = demos - @bodies.keys
    @errors << "#{@label}: `agree:` names #{absent.join(', ')}, which no longer has a #{what} here. Update the set." if absent.any?
    check_declaration_fields(demos, spec)
  end

  def check_declaration_fields(demos, spec)
    @errors << "#{@label}: `agree:` entry [#{demos.join(',')}] carries no `why:`." if spec[:why].to_s.strip.empty?
    return if AGREE_RULES.include?(spec[:rule])

    @errors << "#{@label}: `agree:` entry [#{demos.join(',')}] has unknown `rule: #{spec[:rule].inspect}`; " \
               'use :lockstep or :coincidence.'
  end

  # Each declared group that a larger agreeing group now contains, mapped to that larger group.
  def widened_groups
    @declared.each_key.with_object({}) do |demos, widened|
      next if @groups.key?(demos)

      bigger = @groups.keys.find { |g| (demos - g).empty? }
      widened[demos] = bigger if bigger
    end
  end

  def check_group(demos, norm)
    return all_agree if demos.size == @bodies.size
    return group_joined(demos) if @widened.key(demos)
    return group_undeclared(demos, norm) unless @declared.key?(demos)

    @confirmed += 1
    check_coincidence_cap(demos, norm)
  end

  def all_agree
    @errors << "#{@label}: declared `:per_demo` but ALL #{@bodies.size} copies now agree once comments and " \
               'whitespace are normalised away. Declare it `:code`, or restore what made one differ.'
  end

  def group_joined(demos)
    declared_key = @widened.key(demos)
    joined = demos - declared_key
    @errors << "#{@label}: `agree:` declares [#{declared_key.join(',')}] and #{joined.join(', ')} " \
               "#{joined.size == 1 ? 'has' : 'have'} since joined. Widen the declaration, or make that copy its own again."
  end

  def group_undeclared(demos, norm)
    # A declared group that shrank reports itself in check_dissolved.
    return if @declared.keys.any? { |d| (demos - d).empty? && !@groups.key?(d) }

    @errors << "#{@label}: [#{demos.join(',')}] — #{demos.size} of #{@bodies.size} copies — agree once comments " \
               "and whitespace are normalised away (#{norm.lines.size} line(s)), and nothing declares it. " \
               'Declare it in `agree:` as :lockstep or :coincidence.'
  end

  def check_coincidence_cap(demos, norm)
    return unless @declared[demos][:rule] == :coincidence && norm.lines.size > AGREE_COINCIDENCE_MAX_LINES

    @errors << "#{@label}: `agree:` calls [#{demos.join(',')}] a `:coincidence`, but what they agree on is " \
               "#{norm.lines.size} normalised lines and the cap is #{AGREE_COINCIDENCE_MAX_LINES}. Declare :lockstep."
  end

  def current_groups(demos)
    @bodies.slice(*demos)
           .group_by { |_d, norm| norm }
           .values.map { |g| "[#{g.map(&:first).sort.join(',')}]" }.sort.join(' ')
  end

  # A declared group whose copies no longer agree.
  def check_dissolved(demos, spec)
    return if @groups.key?(demos) || @widened.key?(demos) || (demos - @bodies.keys).any?

    actual = current_groups(demos)
    @errors << if spec[:rule] == :lockstep
                 "#{@label}: `agree:` holds [#{demos.join(',')}] in lockstep and they no longer agree: #{actual}. " \
                   'Propagate the edit, or drop the group.'
               else
                 "#{@label}: `agree:` records [#{demos.join(',')}] as a `:coincidence` and the coincidence has " \
                   "ended: #{actual}. Drop the group."
               end
  end
end

# ── Magic comments: the only comments Ruby acts on, so :code compares them ──
MAGIC_COMMENTS = %w[encoding coding frozen_string_literal warn_indent shareable_constant_value].freeze
MAGIC_RE = /\A#\s*(?:-\*-\s*)?(#{Regexp.union(MAGIC_COMMENTS)})\s*:\s*([^\s;]+)/i

def magic_comments(path)
  found = []
  Ripper.lex(File.read(path)).each do |(_pos, type, tok)|
    next if %i[on_sp on_nl on_ignored_nl].include?(type)
    break unless type == :on_comment

    m = tok.strip.match(MAGIC_RE)
    found << "#{m[1].downcase}: #{m[2].downcase}" if m
  end
  found.sort
end

# ── Discovery ────────────────────────────────────────────────────────────────
demos = Dir[File.join(ROOT, 'kiosk-demo-*')].select { |d| File.directory?(d) }.sort
abort "check-demo-copies: no kiosk-demo-* directories under #{ROOT}" if demos.empty?

found = Hash.new { |h, k| h[k] = {} } # relative path => demo => absolute path
demos.each do |dir|
  demo = File.basename(dir)
  SCAN_ROOTS.each do |sub|
    Dir[File.join(dir, sub, '**', '*.rb')].each do |path|
      rel = path.delete_prefix("#{dir}/")
      next if rel.start_with?('lib/tasks/')

      found[rel][demo] = path
    end
  end
  EXTRA_SCANNED.each do |rel|
    path = File.join(dir, rel)
    found[rel][demo] = path if File.file?(path)
  end
end
dups = found.select { |_rel, copies| copies.size >= 2 }

# db/migrate by timestamp-stripped basename, since each demo stamps its own copy.
migrations = Hash.new { |h, k| h[k] = {} }
demos.each do |dir|
  Dir[File.join(dir, 'db/migrate', '*.rb')].each do |path|
    migrations[File.basename(path).sub(/\A\d+_/, '')][File.basename(dir)] = path
  end
end
migrations.default_proc = nil

def short_name(demo) = demo.delete_prefix('kiosk-demo-')

errors = []
short = method(:short_name)
agree = AgreeCheck.new(errors)

# ── Undeclared and stale manifest entries ────────────────────────────────────
(dups.keys - COPIES.keys).sort.each do |rel|
  copies = dups[rel]
  groups = copies.group_by { |_demo, path| code_digest(path) }
                 .values.map { |g| "[#{g.map { |d, _| short.call(d) }.sort.join(',')}]" }
  errors << "#{rel}: exists in #{copies.size} demos (#{copies.keys.map(&short).sort.join(', ')}) but is not " \
            'declared. Add a COPIES entry with a rule and a reason; modulo comments the copies group as ' \
            "#{groups.join(' ')}."
end

# ── Skeleton exclusions stay true ────────────────────────────────────────────
SKELETON_NOT_COMPARED.each do |rel, why|
  errors << "#{rel}: SKELETON_NOT_COMPARED entry carries no reason" if why.to_s.strip.empty?
  ships = demos.count { |dir| File.exist?(File.join(dir, rel)) }
  next if ships >= 2

  errors << "#{rel}: recorded in SKELETON_NOT_COMPARED but only #{ships} demo ships it — drop the entry."
end

overlap = SKELETON_NOT_COMPARED.keys & COPIES.keys
errors << "#{overlap.join(', ')}: declared in both COPIES and SKELETON_NOT_COMPARED." if overlap.any?

(COPIES.keys - dups.keys).sort.each do |rel|
  where = found[rel]&.keys&.map(&short) || []
  errors << ("#{rel}: declared in COPIES but " +
            (where.empty? ? 'no demo ships it — drop the entry.' : "only #{where.join(', ')} ships it — drop the entry."))
end

# ── Copy comparison ──────────────────────────────────────────────────────────
def copy_digest(rule) = rule == :identical ? method(:byte_digest) : method(:code_digest)

def short_list(demos) = demos.map { |d| short_name(d) }.sort.join(', ')

def demo_groups(groups) = groups.values.map { |g| "[#{g.map { |d, _| short_name(d) }.sort.join(',')}]" }

def check_copy(rel, entry, copies, errors, agree)
  return unless copy_entry_valid?(rel, entry, errors)

  present = copies.keys.map { |demo| short_name(demo) }
  check_copy_ships(rel, entry[:ships], present, errors) if entry[:ships]
  check_copy_except(rel, entry, present, errors)
  return compare_copies(rel, entry, copies, errors) unless entry[:rule] == :per_demo

  check_per_demo_copy(rel, entry, copies, errors, agree)
end

def check_per_demo_copy(rel, entry, copies, errors, agree)
  errors << "#{rel}: :per_demo entries are not compared, so `except:` means nothing here" if (entry[:except] || {}).any?
  agree.check(rel, 'file', copies.to_h { |demo, path| [short_name(demo), code_norm(File.read(path))] }, entry[:agree])
end

def copy_entry_valid?(rel, entry, errors)
  errors << "#{rel}: manifest entry carries no `why:` reason" if entry[:why].to_s.strip.empty?
  return true if %i[identical code per_demo].include?(entry[:rule])

  errors << "#{rel}: unknown rule #{entry[:rule].inspect}"
  false
end

def stray_copy_message(rel, stray, ships)
  "#{rel}: #{stray.sort.join(', ')} #{stray.size == 1 ? 'ships' : 'ship'} this file but " \
    "#{stray.size == 1 ? 'is' : 'are'} not in its declared `ships:` set " \
    "(#{ships.sort.join(', ')}). Add it with the reason, or delete the copy."
end

def check_copy_ships(rel, ships, present, errors)
  stray = present - ships
  gone  = ships - present
  errors << stray_copy_message(rel, stray, ships) unless stray.empty?
  return if gone.empty?

  errors << "#{rel}: `ships:` names #{gone.sort.join(', ')}, which no longer ship#{'s' if gone.size == 1} " \
            'this file — update the set.'
end

def check_copy_except(rel, entry, present, errors)
  (entry[:except] || {}).each do |demo, reason|
    errors << "#{rel}: `except:` reason for #{demo} is blank" if reason.to_s.strip.empty?
    errors << "#{rel}: stale `except:` for #{demo}, which does not ship this file" unless present.include?(demo)
  end
  errors << "#{rel}: `agree:` only applies to `:per_demo` entries; drop it." if entry[:agree] && entry[:rule] != :per_demo
end

def digest_groups(copies, rule)
  digest = copy_digest(rule)
  copies.group_by { |_demo, path| digest.call(path) }
end

# [compared, excepted] copies, each a demo => path hash.
def split_excepted(copies, excepted)
  copies.partition { |demo, _| !excepted.key?(short_name(demo)) }.map(&:to_h)
end

def compare_copies(rel, entry, copies, errors)
  rule = entry[:rule]
  compared, skipped = split_excepted(copies, entry[:except] || {})
  return errors << "#{rel}: every copy but one is excepted. Drop an exception or make the rule :per_demo." if compared.size < 2

  groups = digest_groups(compared, rule)
  report_copy_divergence(rel, rule, groups, errors) if groups.size > 1
  check_copy_magic(rel, compared, errors) if rule == :code
  check_stale_copy_except(rel, rule, compared, skipped, errors) if groups.size == 1
end

def report_copy_divergence(rel, rule, groups, errors)
  how = rule == :identical ? 'byte-for-byte' : 'once comments and whitespace are ignored'
  errors << "#{rel}: declared :#{rule} — the copies must agree #{how}, and they do not: " \
            "#{demo_groups(groups).join(' ')}. Propagate the edit, or record the divergence in `except:` with the reason."
end

def check_copy_magic(rel, compared, errors)
  magic_groups = compared.group_by { |_demo, path| magic_comments(path) }
  return if magic_groups.size <= 1

  listed = magic_groups.map do |comments, g|
    "[#{g.map { |d, _| short_name(d) }.sort.join(',')}] #{comments.empty? ? '(none)' : comments.join(', ')}"
  end.join(' vs ')
  errors << "#{rel}: declared :code — prose may differ per demo, MAGIC comments may not: #{listed}."
end

# An excepted copy that now agrees with the compared ones.
def check_stale_copy_except(rel, rule, compared, skipped, errors)
  digest    = copy_digest(rule)
  canonical = digest.call(compared.values.first)
  magic     = rule == :code ? magic_comments(compared.values.first) : nil
  skipped.each do |demo, path|
    next unless digest.call(path) == canonical
    next if magic && magic_comments(path) != magic

    errors << "#{rel}: `except:` for #{short_name(demo)} is stale — its copy now agrees with the others. Drop it."
  end
end

COPIES.each do |rel, entry|
  copies = dups[rel] or next

  check_copy(rel, entry, copies, errors, agree)
end

# ── Generator templates: every operator demo ships each migration a template emits ──
tpl_files = Dir[File.join(ROOT, GENERATOR_TEMPLATES_DIR, '*.tt')].map { |p| File.basename(p) }

(tpl_files - GENERATOR_TEMPLATES.keys).sort.each do |name|
  errors << "#{GENERATOR_TEMPLATES_DIR}/#{name}: new install-generator template not declared in " \
            'GENERATOR_TEMPLATES. Say what it emits, or why it is not compared.'
end
(GENERATOR_TEMPLATES.keys - tpl_files).sort.each do |name|
  errors << "#{name}: declared in GENERATOR_TEMPLATES but no such template exists — drop the entry."
end

operator_demos = demos.map { |d| File.basename(d) } - NON_OPERATOR_DEMOS

def check_template(name, entry, migrations, operator_demos, errors)
  return template_not_compared(name, entry, errors) if entry[:not_compared]
  return errors << "#{name}: entry declares neither `emits:` nor `not_compared:`." if entry[:emits].to_s.strip.empty?

  emits  = entry[:emits]
  copies = migrations[emits] || {}
  return errors << "#{name}: no demo ships a db/migrate copy of #{emits}. Regenerate the demos, or drop the entry." if copies.empty?

  check_template_demos(name, emits, copies.keys, operator_demos, errors)
end

def template_not_compared(name, entry, errors)
  errors << "#{name}: `not_compared:` carries no reason" if entry[:not_compared].to_s.strip.empty?
end

def check_template_demos(name, emits, shipping, operator_demos, errors)
  missing = operator_demos - shipping
  unless missing.empty?
    errors << "#{name}: #{short_list(missing)} #{missing.size == 1 ? 'ships' : 'ship'} " \
              "no copy of #{emits}; every operator demo ships every canonical migration. Re-run the generator there."
  end
  extra = shipping & NON_OPERATOR_DEMOS
  errors << "#{name}: #{short_list(extra)} ships #{emits}, but is declared a non-operator demo." unless extra.empty?
end

GENERATOR_TEMPLATES.each do |name, entry|
  next unless tpl_files.include?(name)

  check_template(name, entry, migrations, operator_demos, errors)
end

# ── Migration pairs: hand-written migrations shipped at demo-specific timestamps ──
template_basenames = GENERATOR_TEMPLATES.filter_map { |_name, e| e[:emits] }

migrations.each do |base, copies|
  next if copies.size < 2
  next if template_basenames.include?(base)
  next if copies.values.map { |p| File.basename(p) }.uniq.size == 1
  next if MIGRATION_PAIRS.key?(base)

  spread = copies.map { |d, p| "#{short.call(d)}@#{File.basename(p)[/\A\d+/]}" }.sort
  errors << "db/migrate/*_#{base}: ships in #{copies.size} demos at demo-specific timestamps " \
            "(#{spread.join(', ')}). Declare it in MIGRATION_PAIRS with a rule and a reason."
end

MIGRATION_PAIRS.each do |base, entry|
  copies = migrations[base] || {}
  label = "db/migrate/*_#{base}"
  errors << "#{label}: MIGRATION_PAIRS entry carries no `why:` reason" if entry[:why].to_s.strip.empty?
  unless %i[identical code].include?(entry[:rule])
    errors << "#{label}: unknown rule #{entry[:rule].inspect}; MIGRATION_PAIRS takes :identical or :code."
    next
  end
  if copies.size < 2 || template_basenames.include?(base) || copies.values.map { |p| File.basename(p) }.uniq.size == 1
    errors << "#{label}: no longer a cross-demo pair at distinct timestamps — drop the entry."
    next
  end

  digest = entry[:rule] == :identical ? method(:byte_digest) : method(:code_digest)
  groups = copies.group_by { |_demo, path| digest.call(path) }
  if groups.size > 1
    listed = groups.values.map { |g| "[#{g.map { |d, _| short.call(d) }.sort.join(',')}]" }.join(' ')
    errors << "#{label}: declared :#{entry[:rule]} and the copies do not agree: #{listed}."
  end
  errors << "#{label}: declared :code — MAGIC comments must agree." if entry[:rule] == :code && copies.values.map { |p| magic_comments(p) }.uniq.size > 1
end

# ── Autoload-once: app/services is a once-path exactly when the initializer names a constant from it ──
AUTOLOAD_ONCE_PATTERN = %r{autoload_once_paths\s*<<\s*Rails\.root\.join\(['"]app/services['"]\)}

autoload_once_checked = 0
demos.each do |dir|
  demo     = File.basename(dir)
  app_path = File.join(dir, 'config/application.rb')
  init     = File.join(dir, 'config/initializers/kiosk.rb')
  next unless File.exist?(app_path) && File.exist?(init)

  service_constants = Dir[File.join(dir, 'app/services/*.rb')]
                      .map { |f| File.basename(f, '.rb').split('_').map(&:capitalize).join }
  initializer = File.read(init)
  named = service_constants.select { |c| initializer.match?(/(?<![A-Za-z0-9_:])#{Regexp.escape(c)}\b/) }
  declared = File.read(app_path).match?(AUTOLOAD_ONCE_PATTERN)
  autoload_once_checked += 1

  if named.any? && !declared
    errors << "#{short.call(demo)}: config/initializers/kiosk.rb names #{named.sort.join(', ')} from " \
              'app/services but config/application.rb does not put app/services in ' \
              'config.autoload_once_paths, so the boot fails with NameError.'
  elsif named.empty? && declared
    errors << "#{short.call(demo)}: config/application.rb puts app/services in config.autoload_once_paths, " \
              'but config/initializers/kiosk.rb names no constant from it. Drop the line.'
  end
end
errors << 'check-demo-copies: the autoload-once rule read no demo.' if autoload_once_checked.zero?

