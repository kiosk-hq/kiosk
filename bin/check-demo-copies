# ── The engine side of the generator output (K-640, hardened at K-646) ───────
#
# The db/migrate entries in COPIES hold the demos' copies in lockstep with each
# other, which is necessary and not sufficient: `rails g kiosk:install` emits
# those files from these templates, and nothing in the sibling rule ever looks
# at them — the K-580 rebuild was the concrete near-miss, where template and
# copies had to move as one change and a partial move would have stayed green.
#
# So every template under GENERATOR_TEMPLATES_DIR is declared here, rendered
# with plain ERB and the generator's own default options (GENERATOR_DEFAULTS —
# the values every demo was generated with; the templates' only ERB is
# `<%= options[:…] %>` substitution), and the render must byte-match the copy in
# EVERY ONE of the seven operator demos.
#
# ── WHY THERE IS NO WAY TO RECORD AN EXCEPTION ANY MORE ─────────────────────
#
# K-640 shipped this rule with two escape hatches: `drift:` (the render and the
# copies knowingly disagree, pending triage) and `shipped_as:` (the demos ship
# the migration under another basename). Both were used the day the rule
# landed, for four clusters, and all four were still sitting there three months
# later — which is the honest measure of what a recordable exception buys: it
# converts "the build is red until you propagate" into "the build is green and
# someone will look at it". Phil's answer to that state was «я вообще не
# понимаю о чём речь, и почему какие-то шаблоны мандатов расходятся», and then
# the instruction that removed the divergence outright: delete the demos'
# migrations and re-emit (K-646).
#
# So the hatches are GONE, not merely unused. An entry is `emits:` (compared,
# byte for byte, in all seven) or `not_compared:` (with the reason and where it
# is recorded), and there is no third state. A template edit that is not
# propagated to the demos now reddens the build the day it lands, which is the
# whole mechanism this file owes the K-646 decision.
#
# The all-seven rule is the other half. A per-demo SUBSET is how the fleet
# drifted in the first place: demos generated at different times shipped
# different slices of the canonical set (philslist had no mandates, hoteling no
# governance columns), so "which migrations should this demo have" had no
# answer a check could hold. Since K-646 the answer is "all of them", and
# ONE_SET_EVERYWHERE below enforces it: a demo that skips a migration, or a new
# demo scaffolded from a stale engine, fails here.
#
# Entry fields:
#   emits:        — the basename the generator writes (sans timestamp). The
#                   render must byte-match this file in all seven demos.
#   not_compared: — the template's output has a per-demo dimension; the reason
#                   says where that is recorded.
#
# Staleness is checked both ways, per this file's house rule: a template with
# no entry fails, an entry with no template fails, an `emits:` basename no demo
# ships fails, and a basename not shipped by ALL of them fails.
GENERATOR_TEMPLATES_DIR = "kiosk-server/lib/generators/kiosk/install/templates"

# The generator's own class_option defaults (install_generator.rb) — the
# values every demo was generated with.
GENERATOR_DEFAULTS = {
  schema: "kiosk", user_id_type: "uuid", user_table: "users", guc_namespace: "app",
}.freeze

# The seven operator demos. kiosk-demo-prove is the KYC BROKER, not an operator:
# it adopts no Kiosk engine schema at all (its two migrations are its own), so
# the all-seven rule must not ask it for generator output it has no business
# carrying.
NON_OPERATOR_DEMOS = %w[kiosk-demo-prove].freeze

GENERATOR_TEMPLATES = {
  "initializer.rb.tt" => {
    not_compared: "emits config/initializers/kiosk.rb — per-demo by design (capabilities, verbs, " \
                  "PoW policy, adapters), recorded in SKELETON_NOT_COMPARED; the one line every " \
                  "copy of it must carry IS asserted at the bottom of this file.",
  },
  "create_kiosk_schema.rb.tt"                => { emits: "create_kiosk_schema.rb" },
  "create_kiosk_identity_tables.rb.tt"       => { emits: "create_kiosk_identity_tables.rb" },
  "create_kiosk_reservations.rb.tt"          => { emits: "create_kiosk_reservations.rb" },
  "create_kiosk_device_authorizations.rb.tt" => { emits: "create_kiosk_device_authorizations.rb" },
