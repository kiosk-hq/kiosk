# ── The e2e fixture rule runs (T-118) ────────────────────────────────────────
e2e_fixture_comparisons = 0
e2e_fixture_dir = File.join(ROOT, E2E_FIXTURES_DIR)
e2e_run_sh_path = File.join(ROOT, E2E_RUN_SH)
if !File.directory?(e2e_fixture_dir) || !File.exist?(e2e_run_sh_path)
  errors << "check-demo-copies: #{E2E_FIXTURES_DIR}/ or #{E2E_RUN_SH} is gone, so the e2e fixture " \
            "rule compared NOTHING. The harness moving is a change to make on purpose — move this " \
            "rule with it rather than letting it inspect an empty directory (T-118)."
else
  installed = e2e_installed_paths(File.read(e2e_run_sh_path))
  if installed.empty?
    errors << "check-demo-copies: #{E2E_RUN_SH} has no `cp \"$FIXTURES/…\"` lines at all, so every " \
              "pairing this rule derives is empty. The derivation has broken, not the harness " \
              "(T-118)."
  end

  on_disk = Dir[File.join(e2e_fixture_dir, "*.rb")].map { |p| File.basename(p) }.sort
  (on_disk - E2E_FIXTURES.keys).each do |name|
    errors << "#{E2E_FIXTURES_DIR}/#{name}: exists but is not declared in E2E_FIXTURES. Say which " \
              "demo path it was copied from and which rule holds it — or declare `pairs: nil` with " \
              "the reason it has no counterpart. Five hand-written arms reached into this " \
              "directory one file at a time before it was a scan root; a new fixture may not " \
              "arrive unexamined (T-118)."
  end
  (E2E_FIXTURES.keys - on_disk).each do |name|
    errors << "#{E2E_FIXTURES_DIR}/#{name}: declared in E2E_FIXTURES but no longer on disk. Drop " \
              "the entry (T-118)."
  end

  (E2E_FIXTURES.keys & on_disk).each do |name|
    entry = E2E_FIXTURES[name]
    fixture = File.join(e2e_fixture_dir, name)
    errors << "#{E2E_FIXTURES_DIR}/#{name}: E2E_FIXTURES entry carries no `why:` reason" if entry[:why].to_s.strip.empty?

    declared_nil = entry.key?(:pairs) && entry[:pairs].nil?
    spec = entry.key?(:pairs) ? entry[:pairs] : installed[name]

    if spec.nil? && !declared_nil
      errors << "#{E2E_FIXTURES_DIR}/#{name}: #{E2E_RUN_SH} no longer copies it anywhere, so this " \
                "rule has no demo path to pair it with and silently compares nothing. Either the " \
                "fixture is run in place — declare `pairs:` explicitly — or it is dead; declare " \
                "`pairs: nil` with the reason (T-118)."
      next
    end

    if declared_nil
      # THE DECLARATION IS CHECKED. «No demo counterpart» must stay true: a demo
      # file of this basename that has become comment-identical to the fixture
      # is a copy nobody declared, which is the whole class this rule is for.
      twins = demos.flat_map { |dir| Dir[File.join(dir, "**", name)] }
                   .reject { |f| f.include?("/.gems/") }
                   .select { |f| code_digest(f) == code_digest(fixture) }
      unless twins.empty?
        errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `pairs: nil` — no demo counterpart — but " \
                  "#{twins.map { |f| f.delete_prefix("#{ROOT}/") }.sort.join(', ')} " \
                  "#{twins.size == 1 ? 'is' : 'are'} comment-identical to it. That is a copy, not " \
                  "an absence: pair it and give it a rule (T-118)."
      end
      next
    end

    rule = entry[:rule]
    unless %i[identical code per_demo].include?(rule)
      errors << "#{E2E_FIXTURES_DIR}/#{name}: paired with #{spec} but declares " \
                "`rule: #{rule.inspect}` — the fixture rule understands :identical, :code and " \
                ":per_demo, the same three the manifest above uses (T-118)."
      next
    end

    copies = demos.each_with_object({}) do |dir, acc|
      match = spec.include?("*") ? Dir[File.join(dir, spec)].sort.first : File.join(dir, spec)
      acc[short.(File.basename(dir))] = match if match && File.file?(match)
    end
    if copies.empty?
      errors << "#{E2E_FIXTURES_DIR}/#{name}: paired with `#{spec}`, and NO demo ships that path " \
                "any more — the pairing is stale, so this fixture is compared to nothing while " \
                "reading as declared. Re-pair it, or declare `pairs: nil` with the reason (T-118)."
      next
    end

    e2e_fixture_comparisons += copies.size
    case rule
    when :identical
      off = copies.reject { |_demo, path| byte_digest(path) == byte_digest(fixture) }
      next if off.empty?

      errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `:identical` to #{spec}, and " \
                "#{off.keys.sort.join(', ')} #{off.size == 1 ? 'does' : 'do'} not match it " \
                "byte-for-byte. The harness and the demo prove the same file; propagate the edit, " \
                "or say what makes the fixture its own and change the rule (T-118)."
    when :code
      off = copies.reject { |_demo, path| code_digest(path) == code_digest(fixture) }
      next if off.empty?

      errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `:code`-identical to #{spec}, and " \
                "#{off.keys.sort.join(', ')} #{off.size == 1 ? 'does' : 'do'} not match it once " \
                "comments and whitespace are normalised away (T-118)."
    when :per_demo
      converged = copies.select { |_demo, path| code_digest(path) == code_digest(fixture) }
      next unless converged.size == copies.size

      errors << "#{E2E_FIXTURES_DIR}/#{name}: declared `:per_demo` against #{spec} — a deliberate " \
                "variant — but it is now comment-identical to " \
                "#{copies.size == 1 ? "#{copies.keys.first}'s copy" : "all #{copies.size} demo copies"}. " \
                "That is a hand-copy nobody decided to make: declare it `:code` and hold it there, " \
                "or restore what made the harness's version its own (T-118)."
    end
  end
end

if e2e_fixture_comparisons.zero? && E2E_FIXTURES.any?
  errors << "check-demo-copies: the T-118 fixture rule declares #{E2E_FIXTURES.size} fixture(s) " \
            "and compared NONE of them against a demo copy. Every pairing has gone `nil` or " \
            "stale, and a rule with nothing to compare passes everything."
end

# ── A comment in a compared file may not cite something that is not there ────
#    (T-117, generalising K-1021 from one sentence to the whole corpus)
#
# `:code` compares copies MODULO COMMENTS, so each copy's header may name its own
# demo — which is the point of the rule — and every one of those headers is
# therefore unconstrained by construction. Comparing the comments instead would
# delete the reason `:code` exists, and one bespoke derivation per sentence does not
# generalise.
#
# WHAT IS HELD INSTEAD IS THE PART OF A HEADER THAT IS MECHANICALLY FALSIFIABLE:
# its CITATIONS. These headers do not merely describe, they point — at files and at
# code — and a pointer is a claim the tree can answer. Two arms, both derived, no
# list:
#
#   * A SOURCE PATH named in a comment must exist — the same shape as the K-1093
#     rule for deploy/env templates, over a different corpus.
#   * A `{Constant}` or `{Constant.member}` reference must resolve. This is the
#     repository's own YARD-ish notation, and a rename that reaches the code and not
#     the comments pointing at it is exactly the drift this file exists for, one
#     notation over.
#
# Both counts are PRINTED BY THE RUN rather than written down here.
#
# THE CORPUS IS EVERY `.rb` THE MANIFEST DECLARES, IN EVERY DEMO THAT SHIPS IT, PLUS
# `e2e/fixtures/` — not only the `:code` paths. Restricting it to `:code` would
# itself be an undeclared exclusion: an `:identical` header can be identically
# false, and a `:per_demo` header is as unguarded as a `:code` one.
#
# WHAT THIS DOES NOT DO, stated because an over-claimed prose rule is the defect
# this class keeps producing. It cannot tell whether a sentence is TRUE — a claim
# naming no path and no constant is out of reach. It resolves a `{Constant}` by its
# LAST segment, so `{Kiosk::Server::ArgumentDecoder}` is satisfied by a class named
# `ArgumentDecoder` anywhere in the index; it does not check the namespace. It
# resolves a member against any file that defines the constant, not against the
# right one. And it is blind to a citation written any other way — a bare constant
# in prose, a path without a directory. It holds the pointers, and says so.
PROSE_PATH_CITE = %r{(?<![\w./-])(?!/)[a-z][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_.-]+)+\.(?:rb|yml|yaml|erb|sql|py|json|md|txt)\b}
PROSE_CODE_REF  = /\{([A-Z][A-Za-z0-9_]*(?:::[A-Z][A-Za-z0-9_]*)*)(?:[.#]([A-Za-z_][A-Za-z0-9_]*[?!]?))?\}/
# `scope :referencing`, `has_many :settlements`, `attr_reader :psp` — a member a
# class macro names. Deliberately permissive: this index only ever makes a
# reference RESOLVE, so a false entry costs a missed catch and never a false
# alarm, while a missing one would fail a comment that is right.
PROSE_MACRO_MEMBER = /\A\s*[a-z_][A-Za-z0-9_]*\s+:([A-Za-z_][A-Za-z0-9_]*[?!]?)/

# Where a definition may live: every demo's own code, the harness's fixtures,
# and every kiosk gem's `lib/` and `spec/`. Built once; ~700 files, ~0.2 s.
prose_index = []
demos.each { |dir| %w[app lib script spec db].each { |sub| prose_index.concat(Dir[File.join(dir, sub, "**", "*.rb")]) } }
prose_index.concat(Dir[File.join(ROOT, "e2e", "**", "*.rb")])
Dir[File.join(ROOT, "kiosk-*")].select { |d| File.directory?(d) && !File.basename(d).start_with?("kiosk-demo-") }.each do |gem_dir|
  prose_index.concat(Dir[File.join(gem_dir, "lib", "**", "*.rb")])
  prose_index.concat(Dir[File.join(gem_dir, "spec", "**", "*.rb")])
end
prose_index.uniq!

prose_defines = Hash.new { |h, k| h[k] = [] } # constant's LAST segment => [file, …]
prose_members = Hash.new { |h, k| h[k] = {} } # file => { member name => true }
prose_index.each do |path|
  File.foreach(path) do |line|
    if (m = line.match(/\A\s*(?:class|module)\s+([A-Z][A-Za-z0-9_:]*)/))
      prose_defines[m[1].split("::").last] << path
    end
    if (m = line.match(FRAGMENT_START))
      name = m[1] || m[2]
      prose_members[path][name] = true
      prose_defines[name] << path if m[2] # a constant is both a definition and a member
    elsif (m = line.match(PROSE_MACRO_MEMBER))
      prose_members[path][m[1]] = true
    end
  end
end

# The files whose comments are held: every `.rb` the manifest declares, in every
# demo that ships it, plus every e2e fixture.
prose_corpus = []
demos.each do |dir|
  COPIES.each_key do |rel|
    next unless rel.end_with?(".rb")

    Dir[File.join(dir, rel)].sort.each do |path|
      prose_corpus << [short.(File.basename(dir)), dir, rel, path] if File.file?(path)
    end
  end
end
Dir[File.join(e2e_fixture_dir, "*.rb")].sort.each do |path|
  prose_corpus << ["e2e", File.join(ROOT, "e2e"), "#{E2E_FIXTURES_DIR}/#{File.basename(path)}", path]
end

prose_path_cites = 0
prose_code_refs  = 0
e2e_install_targets = File.exist?(e2e_run_sh_path) ? e2e_installed_paths(File.read(e2e_run_sh_path)).values : []
prose_corpus.each do |(label, own_root, rel, path)|
  text = comment_prose(path)

  text.scan(PROSE_PATH_CITE) do |cite|
    prose_path_cites += 1
    # Four rungs, widest last: the citing file's own root (a demo, or `e2e/`),
    # the repository root, ONE package directory down (a shared header naming a
    # sibling demo's file, or a gem's `spec/`), and — for a fixture — a path
    # run.sh installs into the app it generates, which exists only at run time.
    next if File.exist?(File.join(own_root, cite)) ||
            File.exist?(File.join(ROOT, cite)) ||
            Dir[File.join(ROOT, "*", cite)].any? ||
            e2e_install_targets.include?(cite)

    errors << "#{label}: #{rel} — a comment cites the source path `#{cite}`, and no file of that " \
              "name exists in this demo, at the repository root, one package directory down, or " \
              "among the paths e2e/run.sh installs. `:code` compares copies modulo COMMENTS, so a " \
              "header that points at a file somebody moved or deleted rots silently in every copy " \
              "at once — which is how a false sentence lived in eight of them (K-1017/K-1021). " \
              "Fix the citation or restore the file (T-117)."
  end

  text.scan(PROSE_CODE_REF) do |(const, member)|
    prose_code_refs += 1
    last = const.split("::").last
    homes = prose_defines[last]
    if homes.empty?
      errors << "#{label}: #{rel} — a comment references `{#{const}}`, and no class, module or " \
                "constant of that name is defined in any demo, in e2e/, or in any kiosk gem's " \
                "lib/ or spec/. The braces are this repository's notation for a thing in the " \
                "code, so a name that resolves to nothing is either a rename that did not reach " \
                "the prose or a thing that was never code — say it in backticks if it is a beat " \
                "name rather than a constant (T-117)."
    elsif member && homes.uniq.none? { |home| prose_members[home][member] }
      errors << "#{label}: #{rel} — a comment references `{#{const}.#{member}}`, and none of the " \
                "#{homes.uniq.size} file(s) defining `#{last}` defines a `#{member}` — not as a " \
                "method, a constant, or a name a class macro declares. Fix the reference or " \
                "restore the member."
    end
  end
end

# NON-VACUITY, one arm per pattern. Both of these are rules whose subject set is
# LIVE: these patterns are supposed to match, and a zero means the extraction
# broke rather than that the corpus got tidier. EARLIER_WIRES is the standing example of what a silent zero
# buys: a rule that covered nothing, anywhere, for its whole existence, with
# nothing saying so.
if prose_corpus.empty?
  errors << "check-demo-copies: the T-117 citation rule read NO files — every `.rb` in COPIES has " \
            "moved, or the fixture directory has. A prose rule with no corpus passes everything."
else
  if prose_path_cites.zero?
    errors << "check-demo-copies: the T-117 citation rule found NO source-path citation in any of " \
              "the #{prose_corpus.size} compared file(s). There were 208 when it was written, so " \
              "zero means PROSE_PATH_CITE has stopped matching rather than that the headers " \
              "stopped pointing at files."
  end
  if prose_code_refs.zero?
    errors << "check-demo-copies: the T-117 citation rule found NO `{Constant}` reference in any " \
              "of the #{prose_corpus.size} compared file(s). There were 147 when it was written, " \
              "so zero means PROSE_CODE_REF has stopped matching rather than that the headers " \
              "stopped pointing at code."
  end
  if prose_defines.empty?
    errors << "check-demo-copies: the T-117 citation rule indexed #{prose_index.size} file(s) and " \
              "found NO class, module or constant in any of them, so every `{Constant}` reference " \
              "would resolve against an empty index. The index has broken, not the tree."
  end
end

# ── Cross-demo PROSE about the FRAMEWORK (K-1069) ────────────────────────────
#
# `:code` and `:per_demo` are rules about CODE, so the PROSE in these documents is
# compared by nothing — and a framework fact hand-written into N demos is true in
# some of them and stale in the rest as soon as the framework moves. So this block
# declares a CORPUS (the per-demo documents no rule above compares) and a manifest
# of FRAMEWORK CLAIMS over it. Each claim carries up to five declarations:
#
#   text:    a sentence that must appear VERBATIM (whitespace-normalised) in every
#            document listed in `ships:` — the detector for COPIES.
#   topic:   a regex naming the SUBJECT. Where it matches a corpus document, `must:`
#            has to match too — the detector for PARAPHRASES, which `text:`
#            structurally cannot see, because two texts about one fact are not
#            copies of each other.
#   forbids: regexes that may not match ANY corpus document — the detector for a
#            document contradicting itself. It finds contradictions SOMEBODY
#            DECLARED, never contradictions in general.
#   source:  a framework file + a regex that must match it. It fires when the
#            producer stops saying the thing the demos say about it.
#   ships:   which demos must carry the claim at all, the same declaration and the
#            same reason as `ships:` in COPIES above.
#
# WHAT THIS BLOCK DOES **NOT** DO, because an over-claimed guard is the defect this
# class keeps producing:
#
#   * IT CANNOT TELL WHICH OF TWO VARIANTS IS TRUE. It forces ONE text and binds it
#     to a source; choosing the text stays a human act, and a corpus declared around
#     a false sentence enforces the false sentence in seven demos.
#   * IT CANNOT SEE AN UNDECLARED SELF-CONTRADICTION: a `forbids:` entry has to name
#     the pair, exactly as a new duplicated path is invisible to the lockstep rule
#     until somebody declares it.
#   * `source:` PROVES THE FRAMEWORK STILL SAYS IT, NOT THAT THE FRAMEWORK DOES IT.
#     Every binding below is aimed at CODE rather than at a comment, because a
#     comment satisfying a comment is a tautology — but it is still a proxy.
#   * A PARAPHRASE IN VOCABULARY NO `topic:` MATCHES IS INVISIBLE. That is the
#     residual hole and it does not close: the topic regexes are as wide as their
#     authors made them.
#
# prove is excluded by `ships:` rather than by an exception: it is the smaller
# API-only broker, and its `config/routes.rb` carries none of the operator
# wire-surface prose.
FRAMEWORK_CORPUS_RUBY = ["config/routes.rb", "config/routes/kiosk.rb"].freeze

FRAMEWORK_CLAIMS = {
  "protocol-plane-mounted-first" => {
    doc:   "config/routes/kiosk.rb",
    text:  "The protocol plane is mounted first, so no verb below can shadow it.",
    ships: OPERATOR_SEVEN + ["e2e"],
    source: { file: "kiosk-server/lib/kiosk/server/handler_mixin.rb", must: /RESERVED_NAMES\s*=\s*%w\[/ },
    why:   "The ordering every wire file relies on: Rails dispatches the first matching route, so " \
           "the mount above the operator's verbs wins, and kiosk-server refuses at boot a verb " \
           "named after a reserved path.",
  },
  "one-route-per-verb" => {
    doc:   "config/routes/kiosk.rb",
    text:  "Each verb this origin declares gets one route: GET for a query, POST for an action.",
    ships: OPERATOR_SEVEN + ["e2e"],
    source: { file: "kiosk-server/lib/kiosk/server/verb_controller.rb",
              must: %r{GET\s+<endpoint>/<query-name>.*?POST\s+<endpoint>/<action-name>}m },
    why:   "The one-endpoint-per-verb shape the engine's VerbController serves; a wire file that " \
           "says otherwise describes routes the engine does not answer.",
  },
  "routes-drawer-is-not-future-work" => {
    doc:     :all,
    forbids: [
      /follow-?up release[^.]{0,200}(?:mount|routes drawer)/i,
      /(?:mount|routes drawer)[^.]{0,200}(?:will be|lands? in|in a) follow-?up release/i,
    ],
    source:  { file: "kiosk-server/lib/kiosk/server/engine.rb", must: /^\s*routes do\s*$/ },
    why:     "A ban rather than a required sentence, because the defect was a sentence that " \
             "should not exist anywhere rather than one missing somewhere: the demos promised " \
             "the engine's routes drawer as future work while `engine.rb` had shipped BOTH " \
             "drawers — the root-relative discovery block and the mount-prefixed one.",
  },
  "kyc-is-not-a-registration-gate" => {
    doc:     :all,
    forbids: [
      /(?:registration|register|bot-?wall)[^.]{0,140}(?:PoW|proof-of-work)\s*(?:\+|and)\s*KYC/i,
      /(?:PoW|proof-of-work)\s*(?:\+|and)\s*KYC[^.]{0,140}(?:registration|register|bot-?wall)/i,
      /(?:hasn't|has not|hasn’t) paid the PoW and passed KYC/i,
    ],
    source:  { file: "kiosk-server/lib/kiosk/server/auth_controller.rb", must_not: /kyc/i },
    why:     "The source binding is what makes this ban true rather than stylistic: the " \
             "register endpoint's whole controller contains no KYC token, so nothing on the " \
             "registration path can consult an attestation, and a document saying otherwise " \
             "contradicts its own shipped-gate list. NOTE THE LIMIT this entry exists to " \
             "illustrate — it catches this contradiction because it is DECLARED, not because " \
             "anything here reasons.",
  },
}.freeze

# The corpus documents, as {label => {rel => comment prose}}: a sentence wraps
# across `#` lines, and a single-line scan is blind to it.
corpus = {}
demos.each do |dir|
  label = short.(File.basename(dir))
  FRAMEWORK_CORPUS_RUBY.each do |rel|
    p = File.join(dir, rel)
    (corpus[label] ||= {})[rel] = comment_prose(p) if File.exist?(p)
  end
end
e2e_routes = File.join(ROOT, "e2e/fixtures/routes.rb")
(corpus["e2e"] ||= {})["config/routes.rb"] = comment_prose(e2e_routes) if File.exist?(e2e_routes)
# The e2e origin keeps its wire in a fixture of its own, copied to
# config/routes/kiosk.rb by run.sh — the same file under another path, so it is
# read under the name the claims name (T-183).
e2e_wire = File.join(ROOT, "e2e/fixtures/routes_kiosk.rb")
(corpus["e2e"] ||= {})["config/routes/kiosk.rb"] = comment_prose(e2e_wire) if File.exist?(e2e_wire)

# A rule with nothing to read passes everything (the K-1021 lesson). These two
# numbers are the corpus, asserted rather than assumed.
routes_read = corpus.count { |_, d| d.key?("config/routes.rb") }
wire_read   = corpus.count { |_, d| d.key?("config/routes/kiosk.rb") }
if routes_read != OPERATOR_SEVEN.length + 2 # + prove + the e2e fixture
  errors << "check-demo-copies: the K-1069 corpus read #{routes_read} config/routes.rb, expected " \
            "#{OPERATOR_SEVEN.length + 2} (seven operator demos + prove + e2e/fixtures). A corpus " \
            "that lost a document passes vacuously for it."
end
if wire_read != OPERATOR_SEVEN.length + 1 # + the e2e fixture; prove serves no Kiosk wire
  errors << "check-demo-copies: the K-1069 corpus read #{wire_read} config/routes/kiosk.rb, " \
            "expected #{OPERATOR_SEVEN.length + 1} (seven operator demos + e2e/fixtures). Since " \
            "T-183 every framework sentence about the wire lives in THAT file, so a corpus that " \
            "lost one passes vacuously for the demo whose wire prose nobody is reading."
end

FRAMEWORK_CLAIMS.each do |id, claim|
  # (c) THE SOURCE BINDING, checked first: a claim whose producer stopped saying
  # it is wrong in every document at once, and saying WHICH is more useful than
  # N identical per-demo failures.
  if (src = claim[:source])
    path = File.join(ROOT, src[:file])
    if !File.exist?(path)
      errors << "K-1069 claim `#{id}`: its source #{src[:file]} does not exist. The claim is " \
                "unbound — re-point it or delete it, do not leave it asserting about nothing."
    else
      body = File.read(path)
      if src[:must] && body !~ src[:must]
        errors << "K-1069 claim `#{id}`: #{src[:file]} no longer matches #{src[:must].inspect}. " \
                  "The demos say this about the framework and the framework stopped saying it — " \
                  "which is exactly how the routes-drawer promise outlived the drawer (K-1068)."
      end
      if src[:must_not] && body =~ src[:must_not]
        errors << "K-1069 claim `#{id}`: #{src[:file]} now matches #{src[:must_not].inspect}, " \
                  "which the claim asserts it does not. Every corpus document repeating this " \
                  "claim is now false; fix the claim and the documents in one wave."
      end
    end
  end

  # (b) THE DECLARED CONTRADICTIONS.
  Array(claim[:forbids]).each do |banned|
    corpus.each do |label, docs|
      docs.each do |rel, text|
        next unless (m = text.match(banned))

        errors << "#{label}: #{rel} says «#{m[0][0, 140]}», which K-1069 claim `#{id}` forbids. " \
                  "#{claim[:why]}"
      end
    end
  end

  # (a) THE COPIES and THE PARAPHRASES.
  next unless claim[:ships]

  doc = claim[:doc]
  next if doc == :all

  claim[:ships].each do |label|
    text = corpus.dig(label, doc)
    if text.nil?
      errors << "#{label}: K-1069 claim `#{id}` names it in `ships:` but it ships no #{doc}. " \
                "Either the demo stopped shipping the document or the declaration is stale."
      next
    end

    if claim[:text] && !text.include?(claim[:text])
      errors << "#{label}: #{doc} does not carry K-1069 claim `#{id}` verbatim. It must say " \
                "«#{claim[:text][0, 120]}#{claim[:text].length > 120 ? '…' : ''}». #{claim[:why]}"
    end

    if claim[:topic] && text =~ claim[:topic] && text !~ claim[:must]
      errors << "#{label}: #{doc} raises K-1069 claim `#{id}`'s subject (#{claim[:topic].inspect}) " \
                "but does not state it as #{claim[:must].inspect}. #{claim[:why]}"
    elsif claim[:topic] && text !~ claim[:topic]
      errors << "#{label}: #{doc} is in `ships:` for K-1069 claim `#{id}` but never raises its " \
                "subject. A demo that drops a framework claim changes the set silently — the same " \
                "reason `ships:` exists in COPIES above."
    end
  end

  # A demo NOT in `ships:` that raises the topic anyway is the K-1064 shape: the
  # claim appearing somewhere nobody declared it, in whatever tense that copy
  # happened to be written in.
  next unless claim[:topic]

  (corpus.keys - claim[:ships]).each do |label|
    text = corpus.dig(label, doc)
    next unless text && text =~ claim[:topic]

    next if text =~ claim[:must]

    errors << "#{label}: #{doc} raises K-1069 claim `#{id}`'s subject without being declared in " \
              "`ships:`, and does not state it as #{claim[:must].inspect}. Add it to `ships:` if " \
              "the claim belongs there; a new copy of a framework claim may not appear silently."
  end
end

# ── Every `bin/` script a demo names EXISTS and is runnable (K-1315) ─────────
#
# A `bin/` script a demo NAMES must exist and be runnable, or the first command a
# developer types dies of `Errno::ENOENT` — or of `EACCES`, when the file is tracked
# without its executable bit. A byte-identity check over the copies that exist
# certifies nothing about the copies that do not, and no rule above reads a mode.
#
# WHY IT IS DERIVED RATHER THAN DECLARED. `ships:` on the two COPIES entries
# above is the declared half and it is real — a demo that drops `bin/dev` fails
# there. But it only holds the paths somebody thought to declare, and the defect
# was precisely that nobody had. This block asks the question the scripts
# themselves ask: every `bin/<name>` a demo's own `bin/` scripts or its README
# NAME must resolve — in that demo's `bin/`, or at the repo root's `bin/` — and
# the file it resolves to must be executable. Nothing has to be declared for a
# new reference to be checked, and nothing has to be remembered when one moves.
#
# HONEST SCOPE. It reads REFERENCES, not reachability: a `bin/` script nothing
# names is not reported here (the COPIES `ships:` sets are what hold those), and
# a name built at runtime from a variable is invisible. Comment-only lines are
# dropped from the scripts before scanning — a path discussed in a comment is
# not a path executed — but NOT from the README, where a `bin/…` in prose is an
# instruction to the operator and is exactly the thing that must resolve.
BIN_REF_RE = %r{(?<=[`"'\s(])(?:\./)?bin/([a-z0-9_][a-z0-9_-]*)}

bin_ref_files = 0
bin_local     = 0
demos.each do |dir|
  label   = short.(File.basename(dir))
  sources = Dir[File.join(dir, "bin", "*")].select { |f| File.file?(f) }.sort
  sources.each do |script|
    next if File.executable?(script)

    errors << "#{label}: #{script.delete_prefix("#{ROOT}/")} is not executable (mode " \
              "#{format('%o', File.stat(script).mode & 0o7777)}). A `bin/` script a demo ships is a " \
              "script an operator runs; tudu tracked three of them 100644 and `./bin/setup` answered " \
              "Permission denied there (K-1315)."
  end

  readme     = File.join(dir, "README.md")
  bin_corpus = sources.map { |f| [f, File.readlines(f).reject { |l| l =~ /\A\s*#/ }.join] }
  bin_corpus << [readme, File.read(readme)] if File.file?(readme)

  bin_corpus.each do |path, body|
    bin_ref_files += 1
    body.scan(BIN_REF_RE).flatten.uniq.each do |name|
      in_demo = File.join(dir, "bin", name)
      at_root = File.join(ROOT, "bin", name)
      where   = File.file?(in_demo) ? in_demo : (File.file?(at_root) ? at_root : nil)
      bin_local += 1 if where == in_demo

      if where.nil?
        errors << "#{label}: #{path.delete_prefix("#{ROOT}/")} names `bin/#{name}`, which exists " \
                  "neither in #{label}'s own bin/ nor at the repo root. This is K-1315's exact " \
                  "shape — seven copies of bin/setup exec'ing a bin/dev four of them did not ship. " \
                  "Ship the file or stop naming it."
      elsif !File.executable?(where)
        errors << "#{label}: #{path.delete_prefix("#{ROOT}/")} names `bin/#{name}` and " \
                  "#{where.delete_prefix("#{ROOT}/")} is not executable — the reference resolves to " \
                  "a file the operator cannot run (EACCES, not ENOENT, and just as fatal)."
      end
    end
  end
end

# VACUITY, both halves. A regex that stops matching reads exactly like a tree
# with nothing to complain about — the failure this repository has recorded
# four times over. The corpus must be the one in front of us, and it must
# actually contain the cross-file references this rule exists for.
expected_ref_files = demos.sum do |dir|
  Dir[File.join(dir, "bin", "*")].count { |f| File.file?(f) } + (File.file?(File.join(dir, "README.md")) ? 1 : 0)
end
if bin_ref_files != expected_ref_files
  errors << "check-demo-copies: the bin/-reference scan read #{bin_ref_files} file(s) where the tree " \
            "holds #{expected_ref_files}. A corpus that lost a document passes vacuously for it."
end
if bin_local.zero?
  errors << "check-demo-copies: the bin/-reference scan resolved NO reference to a demo's own bin/ " \
            "script. Either every demo stopped naming its own scripts — which is not a state this " \
            "repository has ever been in — or BIN_REF_RE stopped matching. A rule that matches " \
            "nothing is not a rule (K-1315)."
end

# ── EVERY DEMO SHIPS A CONTAINER PATH, AND THE RECIPE IS SHARED (T-192, K-1335) ─
#
# The kiosk gems are resolved through `path: "../kiosk-<gem>"` wherever a demo
# depends on them, so a container build context CANNOT be a single demo directory —
# it has to be this repository. That makes the expensive half shared by
# construction: ONE `Dockerfile` at the repository root, carrying every demo's
# bundle, `psql`, python3+numpy, curl and jq. What is genuinely per-demo is DERIVED
# from that demo's own tree rather than typed: the project name and the working
# directory (the demo's own directory name) and the port the compose file sets.
#
# Two properties are held. Every demo must ship a compose file, because an operator
# evaluating this repository expects to clone it and type one command. And an
# ignore-file may not outlive the recipe `rails new` emitted it beside — that is the
# last rule below, and it is the half this section started as.
#
# NON-VACUITY IS STRUCTURAL. The count is taken from the CORPUS: every
# `kiosk-demo-*` directory this script already discovered must have a compose file,
# so a demo added to this repository makes this rule fail until it has one. Nothing
# below enumerates demos, ports or database names — a hand-listed vacuity arm stops
# draining the moment the corpus grows.
CONTAINER_IGNORE_RE = /\A\.(?:docker|container|podman)ignore\z/
CONTAINER_RECIPE_RE = /\A(?:Dockerfile|Containerfile)(?:\..+)?\z|\A.+\.(?:dockerfile|containerfile)\z|\A(?:docker-)?compose(?:\..+)?\.ya?ml\z/
CONTAINER_COMPOSE_RE = /\A(?:docker-)?compose(?:\..+)?\.ya?ml\z/
CONTAINER_IMAGE_RE   = /\A(?:Dockerfile|Containerfile)(?:\..+)?\z|\A.+\.(?:dockerfile|containerfile)\z/

container_truth = [
  [".dockerignore",    :ignore], [".containerignore", :ignore],
  ["Dockerfile",       :recipe], ["compose.yaml",     :recipe],
  ["docker-compose.yml", :recipe], ["Dockerfile.prod", :recipe],
  ["dockerignore",     :neither], ["README.md",        :neither],
]
container_truth.each do |name, want|
  got = if name =~ CONTAINER_IGNORE_RE then :ignore
        elsif name =~ CONTAINER_RECIPE_RE then :recipe
        else :neither
        end
  next if got == want

  errors << "check-demo-copies: the container-tooling detector reads #{name.inspect} as #{got} where " \
            "it must read #{want} (T-192). Every rule in this section is asked through this pair of " \
            "patterns — which demos have a recipe, which ignore-files are orphans — so a detector " \
            "that has stopped recognising its own subject answers all of them wrongly at once."
end

# THE CORPUS IS WHAT GIT CARRIES, because what ships is what git carries — but
# this guard's own `--self-test` runs it inside a plain file copy that is NOT a
# git repository, where `git ls-files` exits 128 and returns nothing. A rule
# that answered "nothing to check" there would be untestable by the one
# mechanism that proves it works, so the fallback walks the working tree
# instead and the census says which corpus answered.
CONTAINER_PRUNE = %w[.git .gems node_modules tmp log storage coverage public/assets].freeze

def container_walk(root)
  out   = []
  stack = [root]
  until stack.empty?
    dir = stack.pop
    Dir.children(dir).each do |name|
      abs = File.join(dir, name)
      if File.directory?(abs)
        stack << abs unless CONTAINER_PRUNE.include?(name)
      elsif File.file?(abs)
        out << abs.delete_prefix("#{root}/")
      end
    end
  end
  out
rescue SystemCallError
  []
end

container_ls, container_git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z")
container_source  = container_git.success? ? "tracked" : "working-tree"
container_tracked = container_git.success? ? container_ls.split("\0").reject(&:empty?) : container_walk(ROOT)
if container_tracked.length < 500
  errors << "check-demo-copies: the container-tooling rule walked #{container_tracked.length} " \
            "#{container_source} path(s), which is not this repository. The scan lost its corpus " \
            "(K-1335), and an empty corpus reports the same clean zero as a tree with nothing wrong " \
            "in it."
end

container_ignores  = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_IGNORE_RE }
container_composes = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_COMPOSE_RE }
container_images   = container_tracked.select { |rel| File.basename(rel) =~ CONTAINER_IMAGE_RE }

#   (1) Every demo in the corpus has a container path
#
# The demo set is `demos`, discovered at the top of this script from the
# filesystem. Nothing here names one.
container_demo_names = demos.map { |d| File.basename(d) }
container_covered    = container_demo_names.select do |demo|
  container_composes.any? { |rel| File.dirname(rel) == demo }
end
(container_demo_names - container_covered).each do |demo|
  errors << "#{demo} ships no compose file, so it has no container path (T-192). Every demo in this " \
            "repository must be runnable with one command against a database it brings up itself — " \
            "that is the whole of what an operator evaluating Kiosk is entitled to expect, and it is " \
            "why the prerequisites block in the README of every other demo can say the host list is " \
            "optional. Add `#{demo}/compose.yaml` beside its siblings."
end
if container_demo_names.empty?
  errors << "check-demo-copies: the container-path rule found NO demo directories, so it is asserting " \
            "coverage over an empty set (T-192). The corpus this rule counts against is the same " \
            "`demos` list the rest of this script uses; an empty one makes every rule in this section " \
            "pass vacuously."
end

#   (2) The IMAGE is shared: exactly one, at the repository root
#
# A per-demo Dockerfile is the drift this whole script exists to stop, and here
# it would also be wrong on its own terms: the build context has to be the
# repository, so a recipe inside a demo directory cannot build that demo.
container_stray_images = container_images.reject { |rel| File.dirname(rel) == "." }
container_stray_images.each do |rel|
  errors << "#{rel} is a SECOND container image recipe. The image is shared on purpose (T-192): the " \
            "kiosk gems are resolved through `path: \"../kiosk-<gem>\"` wherever a demo depends on " \
            "them, so the build context is this repository and a recipe inside one demo cannot build it. One `Dockerfile` " \
            "at the repository root carries all of them; keeping a second one here means eight copies " \
            "of an install list, which is the drift the rest of this file is about."
end
if container_images.empty?
  errors << "check-demo-copies: there is no container image recipe anywhere in this repository, but " \
            "#{container_composes.length} compose file(s) declare a build (T-192). Every one of them " \
            "names a `Dockerfile` that is not here, so the one command each demo's README promises " \
            "fails at its first step."
end

#   (2b) The image is pinned to versions THIS repository actually runs
#
# Two numbers in the Dockerfile and one in every compose file are claims about
# an environment nobody here can test on a laptop without a container runtime,
# and both of them have a producer in this repository already: `ci.yml` says
# which Ruby every gem and demo job runs and which Postgres its services run,
# and `kiosk-core.gemspec` says the floor. So they are DERIVED and compared
# rather than remembered — a Ruby bump in CI that leaves the image behind is
# the shape this whole file exists to catch, one file further out.
container_ci_yml   = File.join(ROOT, ".github", "workflows", "ci.yml")
container_ci_body  = File.file?(container_ci_yml) ? File.read(container_ci_yml) : ""
container_ci_pg    = container_ci_body.scan(/^\s+image:\s*(postgres:[0-9]+(?:\.[0-9]+)*)\s*$/)
                                      .flatten.tally.max_by { |_, n| n }&.first
container_ci_ruby  = container_ci_body.scan(/^\s+ruby-version:\s*"([0-9][0-9.]*)"\s*$/).flatten.uniq
container_floor    = begin
  gemspec = File.join(ROOT, "kiosk-core", "kiosk-core.gemspec")
  File.file?(gemspec) ? File.read(gemspec)[/required_ruby_version\s*=\s*"\s*>=\s*([0-9][0-9.]*)"/, 1] : nil
end

if container_ci_pg.nil?
  errors << "check-demo-copies: no `image: postgres:<major>` in .github/workflows/ci.yml, so the " \
            "database-major rule below has nothing to compare the compose files against and passes " \
            "vacuously (T-192). Either CI stopped running Postgres as a service, or the shape this " \
            "reads changed."
end
if container_ci_ruby.empty?
  errors << "check-demo-copies: no `ruby-version:` in .github/workflows/ci.yml, so the image's Ruby " \
            "is compared against nothing and any version at all would read as clean (T-192)."
end

container_dockerfile = File.join(ROOT, "Dockerfile")
if File.file?(container_dockerfile)
  container_arg = File.read(container_dockerfile)[/^ARG\s+RUBY_VERSION=([0-9][0-9.]*)\s*$/, 1]
  if container_arg.nil?
    errors << "Dockerfile: no `ARG RUBY_VERSION=<version>` line (T-192). The base image's Ruby is the " \
              "one thing in this recipe that has to track something else in this repository, and " \
              "without that line there is nothing to hold it to."
  else
    if container_ci_ruby.any? && !container_ci_ruby.include?(container_arg)
      errors << "Dockerfile: `ARG RUBY_VERSION=#{container_arg}` names a Ruby " \
                ".github/workflows/ci.yml never runs (it runs #{container_ci_ruby.sort.join(', ')}) " \
                "(T-192). The container path is the one an operator meets FIRST, so it may not be the " \
                "one interpreter nothing here is tested on."
    end
    if container_floor && (Gem::Version.new(container_arg) < Gem::Version.new(container_floor))
      errors << "Dockerfile: `ARG RUBY_VERSION=#{container_arg}` is below the #{container_floor} " \
                "floor kiosk-core.gemspec declares in `required_ruby_version` (T-192). The image " \
                "could not install the gems it is built to run."
    end
  end
end

#   (3) Each compose file names ITS OWN demo, and the shared recipe
#
# Read as text rather than parsed: this script may not require a YAML parser to
# state a fact about four lines, and the shapes below are the ones an editor
# actually types. Each expectation is DERIVED — the demo's own directory name,
# and the `PORT` the file itself sets.
container_ports_derived = 0
container_composes.each do |rel|
  demo = File.dirname(rel)
  next unless container_demo_names.include?(demo)

  body = File.read(File.join(ROOT, rel))

  unless body.match?(/^name:\s*#{Regexp.escape(demo)}\s*$/)
    errors << "#{rel}: its compose project is not named `#{demo}` (T-192). The project name is what " \
              "keeps two demos brought up at the same time from sharing a database volume and a " \
              "network, so a copied-and-half-edited file silently joins its neighbour's project."
  end

  unless body.match?(%r{^\s+working_dir:\s*/kiosk/#{Regexp.escape(demo)}\s*$})
    errors << "#{rel}: its `working_dir` is not `/kiosk/#{demo}` (T-192). The image carries every " \
              "demo, so the working directory is the ONLY thing that decides which one this file " \
              "brings up — a stale one runs a different demo under this demo's name."
  end

  unless body.match?(/^\s+context:\s*\.\.\s*$/) && body.match?(/^\s+dockerfile:\s*Dockerfile\s*$/)
    errors << "#{rel}: it does not build from the shared `Dockerfile` with the repository as its " \
              "context (T-192). `context: ..` and `dockerfile: Dockerfile` are not decoration: a " \
              "demo that depends on the kiosk gems resolves them through `path: \"../kiosk-<gem>\"`, " \
              "so a narrower context cannot install its dependencies at all."
  end

  # The database image major is derived from what CI actually runs.
  if container_ci_pg && !body.match?(/^\s+image:\s*#{Regexp.escape(container_ci_pg)}\s*$/)
    errors << "#{rel}: its database service is not `#{container_ci_pg}`, which is the Postgres " \
              "`.github/workflows/ci.yml` runs (T-192), so a container path on a different major is a " \
              "path this repository has never tested."
  end

  # The app serves on the `PORT` this file sets and the file publishes that same
  # port, so the README's one URL is the page that answers.
  port = body[/^\s+PORT:\s*"(\d+)"\s*$/, 1]
  next if port.nil?

  container_ports_derived += 1
  unless body.match?(/^\s+- "#{port}:#{port}"\s*$/)
    errors << "#{rel}: it does not publish the port it serves on, #{port} (T-192). The README tells " \
              "an operator to open that port; a compose file that publishes another one sends them " \
              "to a page that is not there."
  end
end
if container_ports_derived.zero?
  errors << "check-demo-copies: not ONE compose file sets a `PORT`, so the compose-port rule " \
            "compared nothing and read as coverage (T-192)."
end

#   (3b) The eight compose files are ONE file modulo the demo and the port
#
# Rule (3) holds each per-demo FIELD to what that demo's own tree says. This
# holds everything else — the database service, its healthcheck, the PG
# environment, the header prose an operator reads before typing the command —
# to being the same in all of them. Both are needed and neither implies the
# other: a field rule cannot see a healthcheck that was edited in one file, and
# a whole-file rule cannot see a field that is uniformly wrong.
#
# The normalisation is the demo's short name and its port, which is a claim
# about the design rather than a convenience: the container path was built so
# that those are the ONLY things that differ between demos, and this is where
# that claim is checked. Anything else that starts differing has to be declared
# by widening the normalisation, which is a deliberate act.
container_forms = {}
container_composes.each do |rel|
  demo = File.dirname(rel)
  next unless container_demo_names.include?(demo)

  body  = File.read(File.join(ROOT, rel))
  short = demo.sub(/\Akiosk-demo-/, "")
  port  = body[/^\s+PORT:\s*"(\d+)"\s*$/, 1]
  form  = body.gsub(short, "<DEMO>")
  form  = form.gsub(port, "<PORT>") if port
  (container_forms[form] ||= []) << rel
end

if container_forms.length > 1
  majority = container_forms.max_by { |_, rels| rels.length }
  container_forms.reject { |form, _| form.equal?(majority.first) }.each_value do |rels|
    errors << "#{rels.join(', ')}: the compose file differs from the #{majority.last.length} other(s) " \
              "in something OTHER than its own demo name and its own port (T-192). Those two are the " \
              "only per-demo facts this path has; everything else — the database service, its " \
              "healthcheck, the PG environment, the prose above them — is one file hand-copied eight " \
              "times, and a copy that drifts is the failure this whole script is about. Diff it " \
              "against #{majority.last.first} with the demo name and the port substituted out."
  end
end

if container_forms.empty?
  errors << "check-demo-copies: no compose file was read for the shared-form comparison, so the rule " \
            "that the eight are one file modulo the demo and the port compared nothing (T-192)."
end

# Two demos brought up at the same time must not fight over a host port. The
# published ports come out of the files themselves; nothing here lists them.
container_by_port = Hash.new { |h, k| h[k] = [] }
container_composes.each do |rel|
  next unless container_demo_names.include?(File.dirname(rel))

  File.read(File.join(ROOT, rel)).scan(/^\s+- "(\d+):\d+"\s*$/).flatten.each { |p| container_by_port[p] << rel }
end
container_by_port.select { |_, rels| rels.length > 1 }.each do |port, rels|
  errors << "#{rels.join(', ')} all publish host port #{port} (T-192). Two demos cannot be up at once " \
            "on one port, and the demos are meant to be — the wire is the point, and comparing two " \
            "storefronts is how an operator reads it."
end

#   (4) An ignore file only counts where the BUILD READS IT (K-1335, T-192)
#
# A container IGNORE file is an instruction to a container build, and a build
# reads exactly ONE of them: the one sitting in its context directory. That is
# the correction this rule needed when the repository grew a recipe. The old
# spelling asked whether a recipe existed in the ignore-file's own directory or
# in any ancestor — which was a fair rule while the tree held no recipe at all,
# and became VACUOUS the moment a `Dockerfile` landed at the repository root:
# every path in this repository has the root above it, so every `.dockerignore`
# anywhere would have read as legitimate, and K-1335's exact scaffolding could
# have walked back into all eight demos with this rule reporting clean.
#
# So the legitimate set is DERIVED from what the compose files declare: each
# one's `context:` resolved against its own directory, plus the directory of
# every image recipe. An ignore file outside that set is dead configuration —
# nothing will ever read it — which is what `rails new` leaves behind.
container_contexts = {}
container_images.each { |rel| container_contexts[File.dirname(rel)] = true }
container_composes.each do |rel|
  body = File.read(File.join(ROOT, rel))
  body.scan(/^\s+context:\s*(\S+)\s*$/).flatten.each do |ctx|
    dir = File.dirname(rel)
    container_contexts[File.expand_path(ctx, dir == "." ? "/" : "/#{dir}").delete_prefix("/").then { |d| d.empty? ? "." : d }] = true
  end
end

if container_contexts.empty?
  errors << "check-demo-copies: no build-context directory could be derived from any recipe or " \
            "compose file, so the orphaned-ignore-file rule has an empty legitimate set and would " \
            "call every ignore file — including a correct one — an orphan (T-192)."
end

container_ignores.each do |rel|
  dir = File.dirname(rel)
  next if container_contexts.key?(dir)

  errors << "#{rel} is an ORPHAN: it tells a container build what to leave out, and no build in this " \
            "repository reads it — a build reads the ignore file in its own CONTEXT directory, and " \
            "the contexts here are #{container_contexts.keys.sort.map { |d| d == '.' ? 'the repository root' : d }.join(', ')}. " \
            "This is K-1335's exact shape — `rails new` scaffolding whose recipe was deleted and " \
            "whose ignore-file was not, three times in three demos. Delete it, or make the directory " \
            "it sits in a context something actually builds from."
end

# An empty census reads exactly like a tree with nothing in it (K-1542).
if AGREE_CENSUS.empty? && errors.empty?
  errors << "check-demo-copies: the convergence census recorded NO compared subject, so the " \
            "rule would pass an empty tree as a clean one. {agree_check} runs over every " \
            "`:per_demo` file and every `:per_demo` fragment unit, so an empty census means neither " \
            "pass reached it (K-1542)."
end

if errors.empty?
  puts "check-demo-copies: OK — #{dups.size} duplicated paths declared, " \
       "#{COPIES.count { |_, e| e[:rule] != :per_demo }} kept in lockstep"
  exit 0
end

warn "\ncheck-demo-copies FAILED:\n"
errors.each { |e| warn "  ✗ #{e}" }
warn "\nThe demos are separate Rails apps, so shared code is hand-copied. Every file that exists in " \
     "two or more of them must be declared in bin/check-demo-copies — kept identical, kept identical " \
     "modulo prose, or recorded as a deliberate per-demo variant with the reason."
exit 1
