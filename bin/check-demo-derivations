#!/usr/bin/env ruby
# frozen_string_literal: true

# Every fenced block in a demo's before-after.md declares what produced it, and
# the one producer in use is checked: a `derived: generator` block quotes an
# invocation of the generator its `from:` names, whose namespace is derived
# twice — from the file's path and from its class nesting — and the two must
# agree. A fenced block with no declaration fails, so a new block cannot appear
# unchecked; a block declaring any other producer fails too, because nothing
# here checks it.
#
# A sibling of bin/check-demo-copies (demo against demo) and bin/check-ci-tasks
# (ci.yml against the rake tasks) rather than a mode of either. The boundary is
# the comparison INPUT: this one holds a demo's document to a producer in the
# engine gem.
#
# Usage:
#   bin/check-demo-derivations             # check
#   bin/check-demo-derivations --self-test # plant each defect in a copy of the tree
#   bin/check-demo-derivations --root DIR  # read DIR instead of this checkout

require "fileutils"
require "open3"
require "rbconfig"
require "tmpdir"

ARGS = ARGV.dup
root_at = ARGS.index("--root")
ROOT = root_at ? File.expand_path(ARGS[root_at + 1].to_s) : File.expand_path("..", __dir__)
ARGS.slice!(root_at, 2) if root_at
unknown = ARGS - ["--self-test"]
unless unknown.empty?
  warn "check-demo-derivations: unrecognised argument(s): #{unknown.join(' ')}. " \
       "It takes --self-test and --root DIR and nothing else."
  exit 2
end

DOC = "before-after.md"
DECL_RE = /\A<!--\s*derived:\s*(.*?)\s*-->\z/
GENERATOR_PATH_RE = %r{(?:\A|/)lib/generators/(?<ns>[a-z0-9_]+)/(?<name>[a-z0-9_]+)/\k<name>_generator\.rb\z}
GENERATOR_RUNNERS = ["rails", "bin/rails", "bundle exec rails"].freeze
GENERATOR_VERBS   = %w[g generate].freeze

# The adoption recipe is a cross-demo section, so which documents show the
# invocation in a block is DECLARED: a demo that drops its recipe, or grows a
# copy of it, changes the set and the checks above would pass either way.
GENERATOR_BLOCK_DEMOS = %w[atablefor getgrocery hoteling].freeze

Block = Struct.new(:where, :decl, :body, :body_line, keyword_init: true)

def parse_declaration(text)
  fields = {}
  text.split("|").each_with_index do |part, idx|
    if idx.zero?
      fields["derived"] = part.strip
      next
    end
    k, v = part.split(":", 2)
    fields[k.strip] = v.strip unless v.nil?
  end
  fields
end

def blocks_in(path, label)
  lines = File.readlines(path, chomp: true)
  blocks = []
  i = 0
  while i < lines.length
    unless lines[i].start_with?("```")
      i += 1
      next
    end
    j = i + 1
    j += 1 while j < lines.length && !lines[j].start_with?("```")
    decl = (m = i.positive? && DECL_RE.match(lines[i - 1].strip)) ? parse_declaration(m[1]) : nil
    blocks << Block.new(where: "#{label}:#{i + 1}", decl: decl, body: lines[(i + 1)...j], body_line: i + 2)
    i = j + 1
  end
  blocks
end

def generator_invocations(namespace)
  GENERATOR_RUNNERS.product(GENERATOR_VERBS).map { |runner, verb| "#{runner} #{verb} #{namespace}" }
end

# Rails::Generators::Base.namespace, read off the source rather than by loading
# it: the class nesting, underscored, with `_generator` stripped and the
# `:generators:` segment collapsed.
def generator_namespace_from_source(body)
  mods  = body.scan(/^\s*module\s+([A-Z][A-Za-z0-9_]*)\s*$/).flatten
  klass = body[/^\s*class\s+([A-Z][A-Za-z0-9_]*Generator)\s*<\s*(?:::)?Rails::Generators::(?:Base|NamedBase)\b/, 1]
  return nil if klass.nil?

  parts = (mods + [klass]).map { |c| c.gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase }
  parts.join(":").sub(/_generator\z/, "").sub(/:generators:/, ":")
end

def check_generator(block, errors)
  rel = block.decl["from"].to_s.strip
  return errors << "#{block.where}: `derived: generator` needs a `from:` naming the generator, repository-relative." if rel.empty?

  src = File.join(ROOT, rel)
  return errors << "#{block.where}: `from: #{rel}` names no file in this repository." unless File.file?(src)

  m = GENERATOR_PATH_RE.match(rel)
  if m.nil?
    return errors << "#{block.where}: `from: #{rel}` is not a Rails generator path " \
                     "(`…/lib/generators/<ns>/<name>/<name>_generator.rb`), so no namespace can be derived from it."
  end

  namespace  = "#{m[:ns]}:#{m[:name]}"
  from_class = generator_namespace_from_source(File.read(src))
  if from_class.nil?
    return errors << "#{block.where}: #{rel} defines no `class …Generator < Rails::Generators::Base` " \
                     "(or NamedBase), so it answers no invocation."
  end
  if from_class != namespace
    return errors << "#{block.where}: #{rel} derives `#{namespace}` from its path but `#{from_class}` " \
                     "from its class nesting; Rails resolves an invocation by both."
  end

  accepted = generator_invocations(namespace)
  file = block.where.sub(/:\d+\z/, "")
  block.body.each_with_index do |line, k|
    next if line.strip.empty? || accepted.include?(line.strip.gsub(/\s+/, " "))

    errors << "#{file}:#{block.body_line + k}: this line does not invoke `#{namespace}` " \
              "(accepted: #{accepted.join(', ')}):\n      #{line.strip[0, 160]}"
  end
end

def documents
  Dir.glob(File.join(ROOT, "kiosk-demo-*", DOC)).sort
     .to_h { |doc| [File.basename(File.dirname(doc)).delete_prefix("kiosk-demo-"), doc] }
end

def run
  errors = []
  docs = documents
  held = Hash.new(0)

  docs.each do |demo, doc|
    blocks_in(doc, doc.delete_prefix("#{ROOT}/")).each do |block|
      if block.decl.nil?
        errors << "#{block.where}: fenced block with no `<!-- derived: … -->` declaration on the line " \
                  "above it. A block nobody declared is a block nobody checks."
        next
      end
      unknown = block.decl.keys - %w[derived from why]
      errors << "#{block.where}: unknown key(s) #{unknown.join(', ')} in the declaration." unless unknown.empty?
      unless block.decl["derived"] == "generator"
        errors << "#{block.where}: `derived: #{block.decl['derived']}` — this check holds `generator` " \
                  "blocks only; another kind needs a checker of its own before it may be declared."
        next
      end
      held[demo] += 1
      check_generator(block, errors)
    end
  end

  docs.each_key do |demo|
    want = GENERATOR_BLOCK_DEMOS.include?(demo) ? 1 : 0
    next if held[demo] == want

    errors << if want == 1
                "kiosk-demo-#{demo}/#{DOC}: declares #{held[demo]} `derived: generator` block(s), " \
                "expected 1 — #{demo} is declared to show the generator invocation."
              else
                "kiosk-demo-#{demo}/#{DOC}: declares #{held[demo]} `derived: generator` block(s) but " \
                "#{demo} is not declared to carry one. A new copy of a cross-demo command may not " \
                "appear silently."
              end
  end

  total = held.values.sum
  if total.zero?
    errors << "check-demo-derivations: no declared block in any #{DOC}. " \
              "A rule that inspects nothing passes everything."
  end

  if errors.empty?
    puts "check-demo-derivations: OK — #{total} generator-invocation block(s) across #{docs.size} " \
         "narrative document(s), each bound to the generator its `from:` names."
    return 0
  end
  warn "\ncheck-demo-derivations FAILED:\n"
  errors.each { |e| warn "  ✗ #{e}" }
  1
end

# ── --self-test: one planted defect per rule, in a copy of the files this reads ─
def self_test
  ls, git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z", "kiosk-demo-*/#{DOC}", "kiosk-server/lib/generators")
  abort "check-demo-derivations --self-test: `git ls-files` failed in #{ROOT}" unless git.success?
  rels = ls.split("\0").reject(&:empty?)
  generator = rels.find { |r| r.end_with?("install_generator.rb") } or abort "no install_generator.rb tracked"
  docs = rels.grep(/#{DOC}\z/)
  declared = docs.select { |d| GENERATOR_BLOCK_DEMOS.any? { |demo| d.start_with?("kiosk-demo-#{demo}/") } }
  undeclared = docs - declared

  edit = lambda do |tree, rel, from, to|
    path = File.join(tree, rel)
    body = File.read(path)
    abort "self-test fixture #{rel} does not contain #{from.inspect}" unless body.include?(from)
    File.write(path, body.sub(from, to))
  end
  unfence = ->(tree, rel) { edit.(tree, rel, "```\nrails g kiosk:install\n```", "`rails g kiosk:install`") }
  decl = "<!-- derived: generator | from: #{generator}"

  arms = [
    ["baseline", ->(_t) {}, 0, /OK — 3 generator-invocation block\(s\)/],
    ["undeclared block", ->(t) { edit.(t, declared[0], decl, "<!-- a comment that declares nothing") }, 1, /no `<!-- derived: … -->` declaration/],
    ["misspelt invocation", ->(t) { edit.(t, declared[1], "kiosk:install\n```", "kiosk:instal\n```") }, 1, /does not invoke `kiosk:install`/],
    ["from: naming no file", ->(t) { edit.(t, declared[2], "from: #{generator}", "from: kiosk-server/lib/generators/kiosk/gone/gone_generator.rb") }, 1, /names no file/],
    ["path and class nesting disagree", ->(t) { edit.(t, generator, "module Kiosk\n", "module Kiosks\n") }, 1, /from its class nesting/],
    ["a kind nothing checks", ->(t) { edit.(t, declared[0], "derived: generator", "derived: transcript") }, 1, /holds `generator` blocks only/],
    ["a declared demo drops its recipe", ->(t) { unfence.(t, declared[1]) }, 1, /expected 1 — getgrocery is declared/],
    ["an undeclared demo grows one", ->(t) { edit.(t, undeclared[0], "\n## What an operator adds\n", "\n## What an operator adds\n\n#{decl} -->\n```\nrails g kiosk:install\n```\n") }, 1, /is not declared to carry one/],
    ["nothing left to check", ->(t) { declared.each { |d| unfence.(t, d) } }, 1, /A rule that inspects nothing passes everything/],
  ]

  failures = []
  arms.each do |name, plant, want_exit, want_re|
    Dir.mktmpdir("derivations-") do |tree|
      rels.each do |r|
        FileUtils.mkdir_p(File.dirname(File.join(tree, r)))
        FileUtils.cp(File.join(ROOT, r), File.join(tree, r))
      end
      plant.call(tree)
      out, err, st = Open3.capture3(RbConfig.ruby, __FILE__, "--root", tree)
      text = out + err
      ok = st.exitstatus == want_exit && text.match?(want_re)
      puts "  #{ok ? 'OK ' : 'FAIL'}  #{name}"
      failures << "#{name}: exit #{st.exitstatus} (wanted #{want_exit}), #{want_re.inspect} #{text.match?(want_re) ? 'matched' : 'NOT matched'}" unless ok
    end
  end
  if failures.empty?
    puts "check-demo-derivations --self-test: OK — #{arms.length} arm(s), every one caught."
    exit 0
  end
  warn "\ncheck-demo-derivations --self-test FAILED (#{failures.length} of #{arms.length} arm(s)):\n"
  failures.each { |f| warn "  ✗ #{f}" }
  exit 1
end

self_test if ARGS.include?("--self-test")
exit run
