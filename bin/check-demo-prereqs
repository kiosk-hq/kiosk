#!/usr/bin/env ruby
# frozen_string_literal: true

# Demo prerequisites, DERIVED from each demo's own files (K-1316, K-1317).
#
# WHY THIS EXISTS. The documented prerequisites were not the actual
# prerequisites, in every demo. Three of the eight READMEs carried a
# prerequisites block at all; in three others the whole precondition was the
# sentence "Postgres required. From this directory:". Two hard requirements were
# named nowhere an operator reads:
#
#   (1) python3 + numpy. Every operator demo sets `registration_pow_count = 1`
#       and every copy of `script/equihash_register.rb` shells out to `python3`
#       with the bundled numpy solver, so EVERY task that registers an assistant
#       needs both. Without numpy the solver exits "this solver requires numpy".
#   (2) The `CREATE ROLE` privilege. `demo:setup` runs `psql -d postgres` with
#       `CREATE ROLE app_role NOLOGIN` and `GRANT app_role TO CURRENT_USER`,
#       which managed Postgres and shared dev servers refuse.
#
# CI masks both: it pip-installs numpy and runs Postgres as a superuser, so
# neither has ever failed for us and neither would.
#
# A third thing was undocumented in the same way and is the same class (K-1317):
# `demo:setup` runs `db:drop db:create db:schema:load db:seed` unconditionally,
# with no env check and no prompt. Two READMEs described it as "create + load
# schema + seed" and three omitted it entirely; only three disclosed the drop.
#
# WHY IT IS DERIVED RATHER THAN WRITTEN SEVEN TIMES. A hand-copied list across
# seven READMEs is the exact drift this repository keeps repairing — it is what
# `bin/check-demo-copies` exists for, and what the prose there records happening
# again and again. So the block is GENERATED: each requirement below carries a
# TRIGGER, a question asked of that demo's OWN files, and the block rendered
# into that demo's README holds exactly the requirements its own code creates.
# A demo that stops shelling out to python3 loses the line; one that grows a new
# `CREATE ROLE` gains it; and a requirement declared here that no demo triggers
# fails the run, so a rule that has stopped covering anything cannot read as
# coverage.
#
# WHAT IT CANNOT DO, said plainly:
#
#   * A TRIGGER IS A PROXY, NOT AN ANALYSIS. `script/equihash_register.rb`
#     containing "python3" is strong evidence the demo needs python3; it is not
#     a proof that nothing ELSE in the demo needs something not listed here. An
#     undeclared requirement is invisible exactly as an undeclared duplicate is
#     invisible to check-demo-copies.
#   * IT CHECKS THAT THE TEXT MATCHES THE TRIGGER, NEVER THAT THE TEXT IS TRUE.
#     A wrong sentence declared here is enforced, identically, in seven READMEs.
#   * IT SAYS NOTHING ABOUT AN OPERATOR ADOPTING THE GEMS. Verifying a proof is
#     pure Ruby; only SOLVING one needs the Python solver, and that is the
#     client side. These are the prerequisites of RUNNING THE DEMOS.
#
# Usage:
#   bin/check-demo-prereqs               # check every demo README (no bundle needed)
#   bin/check-demo-prereqs --write       # (re)generate the blocks
#   bin/check-demo-prereqs --self-test   # one planted break per rule, in a temp tree

require "fileutils"
require "tmpdir"

ROOT       = File.expand_path("..", __dir__)
BEGIN_MARK = "<!-- PREREQS:BEGIN — generated by bin/check-demo-prereqs --write; do not edit by hand -->"
END_MARK   = "<!-- PREREQS:END -->"

# ── The requirements, each with the question that decides whether a demo has it ──
#
# `file` + `must` is asked of the demo's own tree — that is the TRIGGER, and it
# is what decides whether this demo has the requirement at all. `line` is what
# the README then has to say, verbatim, and it may read a producer ANYWHERE in
# the repo for the VALUE: the two are different questions. Order is render order.
#
# NOT `.ruby-version` (measured 2026-09-06): every demo has one on this machine
# and `git ls-files` lists NONE of them — the root `.gitignore` excludes
# `.ruby-version`, `mise.toml` and `.mise.toml` deliberately, as machine-local
# toolchain pins that must not ship. A block derived from a file a fresh clone
# does not carry would render differently here and in CI, which is a defect of
# exactly the shape this guard exists to prevent. The gems' own
# `required_ruby_version` IS tracked and IS the producer of the floor.
RUBY_FLOOR_FILE = "kiosk-core/kiosk-core.gemspec"

def ruby_floor
  body = File.read(File.join(ROOT, RUBY_FLOOR_FILE))
  body[/required_ruby_version\s*=\s*"\s*>=\s*([0-9][0-9.]*)"/, 1]
end

REQUIREMENTS = [
  {
    id:   "ruby",
    file: "Gemfile", must: /kiosk-/,
    line: ->(_) { "- **Ruby #{ruby_floor} or newer**, then `bundle install` — the floor every " \
                  "kiosk gem declares in its `required_ruby_version`." },
    why:  "Derived from the gemspec because the per-app toolchain pins are gitignored (see above).",
  },
  {
    id:   "postgres",
    file: "lib/tasks/demo.rake", must: /\bpsql\b/,
    line: ->(_) { "- **Postgres**, reachable — `pg_isready` returns OK — with `psql` on PATH: " \
                  "the demo tasks shell out to it directly, not only through ActiveRecord." },
    why:  "Every demo:setup runs psql itself, so `pg_isready` alone is not the whole precondition.",
  },
  {
    id:   "create-role",
    file: "lib/tasks/demo.rake", must: /CREATE ROLE app_role/,
    line: ->(_) { "- **A Postgres login permitted to `CREATE ROLE`.** `demo:setup` creates the " \
                  "`app_role` group role and grants it to the current user. Managed Postgres and " \
                  "shared development servers usually refuse this; a local superuser has it." },
    why:  "K-1316's second gap. CI runs as a superuser, so this has never failed for us.",
  },
  {
    id:   "python3-numpy",
    file: "script/equihash_register.rb", must: /python3/,
    line: ->(_) { "- **python3 with numpy** — check with `python3 -c \"import numpy\"`. Registering " \
                  "an assistant pays an Equihash toll, and every task that registers one solves it " \
                  "with the bundled `solve.py`; without numpy the solver exits " \
                  "`this solver requires numpy` and the task fails at its first step." },
    why:  "K-1316's first gap, and the one that stops EVERY task: registration is where a flow starts.",
  },
  {
    id:   "curl-jq",
    file: "bin/demo", must: /require_tool jq/,
    line: ->(_) { "- **`curl` and `jq`** on PATH — `bin/demo` drives the walkthrough with them." },
    why:  "Only the demos whose walkthrough is a shell tour need these; the Ruby flow drivers do not.",
  },
].freeze

# ── The destructive-setup disclosure (K-1317) ────────────────────────────────
#
# Same derivation, different shape: not a bullet in a list but a warning, and
# the database it names is read out of config/database.yml rather than typed.
DESTRUCTIVE_TRIGGER = { file: "lib/tasks/demo.rake", must: /db:drop\s+db:create/ }.freeze

def dev_database(dir)
  yml = File.read(File.join(dir, "config", "database.yml"))
  dev = yml[/^development:\n(?:[ \t].*\n|\n)*/m] or return nil
  raw = dev[/^\s+database:\s*(.+)$/, 1] or return nil
  raw = raw.strip
  # Six demos name it literally; getgrocery resolves an env var with a default,
  # which WIDENS the blast radius and therefore has to reach the operator.
  if (m = raw.match(/ENV\.fetch\(\s*"([A-Z0-9_]+)"\s*,\s*"([^"]+)"\s*\)/))
    { name: m[2], env: m[1] }
  else
    { name: raw, env: nil }
  end
end

def triggered?(dir, trigger)
  path = File.join(dir, trigger[:file])
  File.file?(path) && File.read(path).match?(trigger[:must])
end

def prereq_block(dir)
  bullets = REQUIREMENTS.select { |r| triggered?(dir, r) }.map { |r| r[:line].call(dir) }
  parts   = [BEGIN_MARK, "### Prerequisites", ""]
  parts << "Generated by `bin/check-demo-prereqs` from this demo's own files — the build fails when"
  parts << "this list and the code that needs it disagree."
  parts << ""
  parts.concat(bullets)

  if triggered?(dir, DESTRUCTIVE_TRIGGER)
    db = dev_database(dir)
    parts << ""
    parts << "> **`demo:setup` is destructive, and every task that depends on it inherits that.**"
    parts << "> It runs `db:drop db:create db:schema:load db:seed` unconditionally — no environment"
    parts << "> check, no confirmation prompt — so running it **DROPS and recreates**"
    parts << "> `#{db[:name]}`. Nothing you left in that database survives."
    if db[:env]
      parts << "> `#{db[:env]}` overrides that name in development too, so an export points the drop"
      parts << "> at whatever it names."
    end
    # ONLY where the demo actually ships the script, and naming only what that
    # script actually runs. Writing "bin/setup does this" into a README of a demo
    # that ships no bin/setup would be K-1315 committed a second time, in the
    # document rather than in the script.
    setup = File.join(dir, "bin", "setup")
    if File.file?(setup)
      steps = File.readlines(setup).reject { |l| l =~ /\A\s*#/ }.join
                  .scan(%r{"((?:\./)?bin/[^"]*)"}).flatten.uniq
      parts << ">"
      parts << "> `bin/setup` is the shortcut, and it inherits the drop: `bundle install`, then " +
               steps.map { |x| "`#{x}`" }.join(", then ") + "."
    end
  end

  parts << END_MARK
  parts.join("\n")
end

# ── The run ──────────────────────────────────────────────────────────────────
def run(root, write: false)
  errors  = []
  demos   = Dir[File.join(root, "kiosk-demo-*")].select { |d| File.directory?(d) }.sort
  fired   = Hash.new(0)
  blocks  = 0

  if demos.empty?
    return [["check-demo-prereqs: no kiosk-demo-* directories under #{root} — there is nothing to " \
             "derive from, and a run with no corpus passes vacuously."], 0, fired]
  end

  demos.each do |dir|
    label  = File.basename(dir)
    readme = File.join(dir, "README.md")
    unless File.file?(readme)
      errors << "#{label}: no README.md — the prerequisites have nowhere to be stated."
      next
    end

    REQUIREMENTS.each { |r| fired[r[:id]] += 1 if triggered?(dir, r) }
    fired["destructive"] += 1 if triggered?(dir, DESTRUCTIVE_TRIGGER)

    # A demo with NO triggered requirement gets no block: kiosk-demo-prove has
    # its own smaller shape, and inventing an empty section for it would be
    # noise. It is still checked for a STALE block.
    wanted  = REQUIREMENTS.any? { |r| triggered?(dir, r) }
    body    = File.read(readme)
    present = body.include?(BEGIN_MARK) && body.include?(END_MARK)

    unless wanted
      errors << "#{label}/README.md: carries a PREREQS block but triggers no requirement — the " \
                "block is describing a demo that no longer exists. Remove it." if present
      next
    end

    unless present
      errors << "#{label}/README.md: no PREREQS block. Add the marker pair where the operator " \
                "reads how to run this demo, then `bin/check-demo-prereqs --write`:\n" \
                "  #{BEGIN_MARK}\n  #{END_MARK}"
      next
    end

    blocks += 1
    current = body[/#{Regexp.escape(BEGIN_MARK)}.*?#{Regexp.escape(END_MARK)}/m]
    wanted_block = prereq_block(dir)
    next if current == wanted_block

    if write
      File.write(readme, body.sub(current, wanted_block))
      warn "updated #{label}/README.md"
    else
      errors << "#{label}/README.md: the PREREQS block does not match what this demo's own files " \
                "say it needs — run `bin/check-demo-prereqs --write`. Expected:\n" +
                wanted_block.lines.map { |l| "      #{l.rstrip}" }.join("\n")
    end
  end

  # ── VACUITY ────────────────────────────────────────────────────────────────
  #
  # A trigger that matches nothing anywhere is not a requirement nobody has — it
  # is a regex that stopped working, and it reads exactly like a clean tree.
  # This is the arm that would have caught `EARLIER_WIRES` in the sibling guard,
  # which covered nothing at all for its entire existence.
  if ruby_floor.nil?
    errors << "check-demo-prereqs: no `required_ruby_version = \">= X\"` in #{RUBY_FLOOR_FILE}. The " \
              "Ruby floor every generated block states is read out of that line; with the line gone " \
              "the blocks would silently stop stating one."
  end

  (REQUIREMENTS.map { |r| r[:id] } + ["destructive"]).each do |id|
    next if fired[id].positive?

    errors << "check-demo-prereqs: the `#{id}` trigger matched NO demo. Either every demo dropped " \
              "the requirement — in which case delete the entry — or the trigger stopped matching, " \
              "in which case seven READMEs are silently under-stating what they need."
  end

  [errors, blocks, fired]
end

# ── --self-test: one planted break per rule, in a throwaway copy ─────────────
if ARGV.include?("--self-test")
  require "open3"

  plants = [
    { id:   "block-missing",
      what: "a demo ships no PREREQS block at all — the state five of eight READMEs were in",
      op:   ->(t) { r = File.join(t, "kiosk-demo-hoteling/README.md")
                    File.write(r, File.read(r).sub(/#{Regexp.escape(BEGIN_MARK)}.*?#{Regexp.escape(END_MARK)}\n?/m, "")) },
      expect: %r{hoteling/README\.md: no PREREQS block} },
    { id:   "requirement-undocumented",
      what: "a demo's README loses the python3 line while its code still shells out to python3 — " \
            "K-1316's shape, and CI installs numpy so nothing else would notice",
      op:   ->(t) { r = File.join(t, "kiosk-demo-skooti/README.md")
                    File.write(r, File.read(r).sub(/^- \*\*python3 with numpy\*\*.*?\n(?=- |\n|<!--)/m, "")) },
      expect: %r{skooti/README\.md: the PREREQS block does not match} },
    { id:   "requirement-appears-in-code",
      what: "a demo grows a CREATE ROLE its README does not mention",
      op:   ->(t) { r  = File.join(t, "kiosk-demo-philslist/README.md")
                    ra = File.join(t, "kiosk-demo-philslist/lib/tasks/demo.rake")
                    File.write(r, File.read(r).sub(/^- \*\*A Postgres login permitted.*?\n(?=- |\n|<!--)/m, ""))
                    File.write(ra, File.read(ra)) },
      expect: %r{philslist/README\.md: the PREREQS block does not match} },
    { id:   "drop-not-disclosed",
      what: "the destructive-setup warning is deleted while demo:setup still drops the database — " \
            "K-1317's shape, two READMEs describing a drop as create-load-seed",
      op:   ->(t) { r = File.join(t, "kiosk-demo-atablefor/README.md")
                    File.write(r, File.read(r).sub(/^> \*\*`demo:setup` is destructive.*?\n(?=<!-- PREREQS:END)/m, "")) },
      expect: %r{atablefor/README\.md: the PREREQS block does not match} },
    { id:   "stale-database-name",
      what: "the development database is renamed and the warning keeps naming the old one",
      op:   ->(t) { y = File.join(t, "kiosk-demo-tudu/config/database.yml")
                    File.write(y, File.read(y).sub("database: kiosk_tudu_development",
                                                   "database: kiosk_tudu_dev")) },
      expect: %r{tudu/README\.md: the PREREQS block does not match} },
    { id:   "vacuity-trigger-stops-matching", kind: :vacuity,
      what: "the CREATE ROLE trigger stops matching anywhere, so the requirement silently covers " \
            "nothing and every README reads as complete",
      op:   ->(t) { Dir[File.join(t, "kiosk-demo-*/lib/tasks/demo.rake")].each do |f|
                      File.write(f, File.read(f).gsub("CREATE ROLE app_role", "CREATE GROUP app_role"))
                    end },
      expect: %r{the `create-role` trigger matched NO demo} },
  ]

  ls, git = Open3.capture2("git", "-C", ROOT, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
  abort "check-demo-prereqs --self-test: `git ls-files` failed in #{ROOT}" unless git.success?
  rels = ls.split("\0").select { |r| File.file?(File.join(ROOT, r)) }

  bad = []
  Dir.mktmpdir("check-demo-prereqs-self-test") do |tmp|
    tree = File.join(tmp, "tree")
    FileUtils.mkdir_p(rels.map { |r| File.dirname(File.join(tree, r)) }.uniq)
    rels.each { |r| FileUtils.copy_file(File.join(ROOT, r), File.join(tree, r), true) }

    base_errors, base_blocks, = run(tree)
    if base_errors.empty?
      puts format("  %-6s %s", "GREEN", "baseline: the untouched copy is clean over #{base_blocks} " \
                                        "block(s), so every arm below is ONE planted break away from red")
    else
      bad << "the BASELINE copy is not clean:\n" + base_errors.first(3).map { |e| "      #{e.lines.first.rstrip}" }.join("\n")
    end

    if bad.empty?
      pristine = rels.to_h { |r| [r, File.binread(File.join(ROOT, r))] }
      plants.each do |plant|
        plant[:op].call(tree)
        errs, = run(tree)
        hit = errs.any? { |e| e =~ plant[:expect] }
        puts format("  %-6s %-34s %s", hit ? (plant[:kind] == :vacuity ? "VAC" : "RED") : "GREEN",
                    plant[:id], plant[:what])
        bad << "#{plant[:id]}: planted and nothing matched #{plant[:expect].inspect}" unless hit
        # Restore from the pristine BYTES, never from git — a `git checkout` here
        # would be restore-to-HEAD rather than undo-my-mutation.
        rels.each { |r| File.binwrite(File.join(tree, r), pristine[r]) }
      end
    end
  end

  if bad.empty?
    puts "\ncheck-demo-prereqs --self-test: OK — #{plants.length} arm(s) " \
         "(#{plants.count { |p| p[:kind] != :vacuity }} planted breaks, " \
         "#{plants.count { |p| p[:kind] == :vacuity }} vacuity), every one caught."
    exit 0
  end
  warn "\ncheck-demo-prereqs --self-test FAILED:"
  bad.each { |b| warn "  ✗ #{b}" }
  exit 1
end

write = ARGV.include?("--write")
errors, blocks, fired = run(ROOT, write: write)

if errors.empty?
  unless write
    puts "check-demo-prereqs: OK — #{blocks} generated prerequisites block(s), " \
         "#{REQUIREMENTS.length + 1} requirement(s) derived from each demo's own files (" +
         (REQUIREMENTS.map { |r| r[:id] } + ["destructive"]).map { |id| "#{id}:#{fired[id]}" }.join(" ") + ")"
  end
  exit 0
end

warn "\ncheck-demo-prereqs FAILED:\n"
errors.each { |e| warn "  ✗ #{e}" }
warn "\nA demo README's prerequisites are DERIVED from that demo's own files, never typed beside " \
     "them. Run `bin/check-demo-prereqs --write` after changing what a demo needs."
exit 1
