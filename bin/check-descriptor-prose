#!/usr/bin/env ruby
# frozen_string_literal: true

# check-descriptor-prose — a verb descriptor's PROSE may not restate the SHAPE
# its own schema declares (ADR-0023).
#
# WHY THIS EXISTS, and the reason is the history rather than the rule. ADR-0023
# re-scoped `description` to SEMANTICS ONLY: it says what a verb does, how, and
# what its answer MEANS, and it "must never carry a field list, a type, a
# required/optional marker, or a param name that the schema also carries."
# Every name and shape lives in `input_schema`/`output_schema`, which is the one
# declaration a machine can check against the handler.
#
# The clause has been applied to this tree by hand THREE times and each pass
# left live instances behind, every time because the pass chose its own pattern
# and the pattern could not see a spelling:
#
#   * the first swept four demos with a hand search;
#   * the second used `git grep -F 'description: "Optional'` — a literal
#     anchored at the START of a description string — reported SEVEN sites,
#     noticed one more by eye and called it "an eighth". The corpus was NINE:
#     the same sentence sat on two `delivery_date` properties in one file, MID
#     STRING, where a start-anchored literal cannot reach it, and only one of
#     the two was edited;
#   * the third re-derived with `git grep -nP 'description:.*\bOptional\b'`,
#     drained the ninth, and concluded that "the same command over the whole
#     repository returns nothing". True, and the wrong question: that pattern is
#     CASE-SENSITIVE. Adding `-i` to it, at the head that sentence was written
#     on, returns FOUR more live sites in THREE files — two demo properties
#     spelled `OPTIONAL`, and two in the engine's own OpenAPI description
#     surface, which no `kiosk-demo-*` pathspec would have reached anyway.
#
# Three passes, three patterns, three misses: an anchor, a case, and a pathspec.
# That is what a class held by nobody looks like, and it is why this reads the
# descriptors STRUCTURALLY — with Ruby's own parser, off the tracked tree —
# rather than grepping for a spelling somebody remembered.
#
# ── WHAT IT READS ───────────────────────────────────────────────────────────
#
# Every tracked `.rb`/`.rake` file in this repository is parsed with Prism (a
# stdlib parse of the text — nothing boots, no bundle, no database), and two
# kinds of description come out of the syntax tree:
#
#   VERB      a receiverless `description "…"` call — the descriptor DSL's verb
#             description, whatever file or macro context it sits in.
#   PROPERTY  a `description:` key inside a schema object, i.e. a hash that also
#             carries `properties:`. Its NAME and its sibling `required:` array
#             come out of the same hash, so the membership question is answered
#             from the declaration itself.
#   PARAMETER an OpenAPI Parameter Object — a hash with a `description:`, an
#             `in:` and a `required:` that is a BOOLEAN rather than an array,
#             and NO `properties:`. It is a third kind because the first two
#             definitions are structural and this shape falls outside BOTH by
#             construction: the membership question is decided by a key of its
#             own instead of by an array one level up. The engine builds its
#             reserved query parameters that way, and until K-1521 they were in
#             no scope at all — a bare label planted on one left this script at
#             exit 0 while the identical label on a property in the SAME FILE
#             reddened it.
#
# Nothing about the demos, the engine or the e2e fixtures is typed here. The set
# is `git ls-files`, so an eighth demo, a new controller or a schema written
# somewhere nobody expected is in scope the day it lands.
#
# ── ONE BAN AND ONE CENSUS, AND WHICH IS WHICH WAS MEASURED ─────────────────
#
# The obvious rule — "no optionality word in a description" — reddens correct
# prose, and by a wide margin. MEASURED over the derived corpus with a generous
# scan for every optionality-ish spelling, the large majority of what comes back
# is sentences earlier passes examined and deliberately KEPT. NO COUNT IS TYPED
# HERE and none should be: the run prints the corpus size and the census beside
# each other, and an integer written into a comment is a measurement that stops
# being one the day after it is typed. What does NOT decay is the SHAPES, which
# is what the decision below actually rests on:
#
#   * "New in-zone Dublin delivery address; unchanged if omitted." — what
#     omission MEANS is semantics, and is the half those passes protected;
#   * "Omitting it books tomorrow at the address." — the same;
#   * "Leave them out and the list is this hotel's full CATALOGUE" — the same;
#   * "Appointment time, RFC 3339, and the OFFSET IS REQUIRED" — a constraint on
#     the VALUE, not a statement about the property's membership;
#   * "licence-free and licence-required alike" — a compound adjective;
#   * "(requires the booking to belong to the principal)" — a precondition;
#   * "a window and an address are required to place one" — a business rule that
#     merely coincides with the required list, declared as a borderline and kept
#     on purpose.
#
# So the BAN is drawn where the corpus says it is safe, and everything else is
# COUNTED:
#
#   LABEL   (BAN, exit code)  a PROPERTY or PARAMETER description may not carry
#           a bare optionality LABEL — `optional`, `optionally`, `required`,
#           `mandatory`, `compulsory` — about itself. Bare means: not part of a
#           hyphenated compound (`licence-required`), not the complement of a
#           copula (`the OFFSET IS REQUIRED`), and not taking an INFINITIVE
#           complement (`never required TO BE declared`) — three forms that say
#           such a word about something OTHER than this descriptor's membership.
#           The third arrived with the parameter kind and is the same
#           distinction from the other side: a predicate about an ACTION rather
#           than a marker of membership, and a membership label never takes one.
#           The verdict needs no judgement, because the declaration beside the
#           prose has already decided the fact the label restates — a property's
#           sibling `required:` array, a parameter's own `required:` boolean.
#           Whichever way the two agree, one of them is redundant and the
#           machine-checkable one is not the sentence.
#
#   C1      (CENSUS, printed, never red)  every OTHER optionality construction
#           in any description, verb or property — the copula forms, `omit`,
#           `if omitted`/`if provided`, `defaults to`, `leave it out`, and every
#           marker in a VERB description. Nearly everything the generous scan
#           finds lands here and nearly all of it is correct prose, so a gate
#           over them would be a gate somebody switches off. Each is printed
#           with the property's membership beside it so a human can adjudicate
#           the new ones; the run is where the number lives.
#
# WHY THE VERB DESCRIPTIONS ARE CENSUS AND NOT BAN, and it is a measurement
# rather than caution: almost every verb-level hit is correct prose — a
# precondition, a compound adjective, a business rule — and the one genuine
# candidate ("Naming a service is OPTIONAL and the two forms differ in what the
# appointment records") is a copula form carrying real semantics in the same
# breath. A verb description also has no single `required:` array to be
# redundant against, so the structural comparison that makes LABEL unarguable
# does not exist there. Re-run the census and read the split rather than
# trusting this paragraph.
#
# ── HOW IT KNOWS IT STILL WORKS ─────────────────────────────────────────────
#
# LABEL is a ban, so its count is permanently zero when it works, and "no
# violations" and "this pattern stopped matching" print the same clean zero. Two
# separate mechanisms answer that, and neither is a census of the tree:
#
#   DETECTOR  the ban and the census each declare PROBES (one per marker, plus
#             one per historical spelling: leading, mid-string, uppercase,
#             parenthetical) and FOILS (the seven live sentences above, written
#             out here so that a widened pattern reddens THIS file rather than a
#             shipped descriptor). Every run re-proves them against fixtures
#             that are not in the tree at all.
#   STRUCTURE three arms, every one of them DERIVED from the filesystem rather
#             than from a list of what this file happens to know — a vacuity arm
#             that names what it knows is a blind spot waiting for the corpus to
#             grow, which is the failure this workspace has on record four times.
#             (a) EVERY HANDLER CONTROLLER any origin declares — resolved from
#             that origin's own `c.handlers`, class name to path — must yield at
#             least one verb AND one property description, so a parser that
#             stops reading ONE file goes red naming it, and a ninth controller
#             or an eighth origin is covered the day it lands.
#             (b) THE CORPUS MUST REACH PAST `kiosk-demo-*`. The third hand pass
#             declared the class drained repository-wide from a demos-only
#             pathspec while two survivors sat in the engine; a scope that has
#             quietly narrowed back to the demos is a fault, by name.
#             (c) A SECOND READING: file by file, wherever the syntax tree found
#             a verb description, a plain text scan of the same file must find
#             the same number. Scoped to those files deliberately — a
#             `description "…"` inside a HEREDOC is source a spec writes to a
#             temp file, and counting it would make the arm permanently wrong
#             for a reason that is not a defect.
#             (d) THE PARAMETER CORPUS MUST COVER EVERY RESERVED QUERY ARGUMENT
#             THE ENGINE DECLARES. The parameter kind is recognised by a SHAPE,
#             and a shape is a scope that can stop matching — which is precisely
#             how those descriptions came to be in no scope at all. The expected
#             subject is therefore derived from a DIFFERENT file:
#             `ArgumentDecoder::RESERVED` names the reserved arguments, and each
#             must appear here with a description. A third reserved argument, or
#             a rewrite of the parameter builder this reader stops recognising,
#             costs a decision instead of shrinking the corpus quietly.
#             Each of the four is itself proved able to go red, off a corpus
#             emptied or quietened on purpose, in `--self-test`.
#
# ── WHAT IT DELIBERATELY DOES NOT DO ────────────────────────────────────────
#
#   * IT DOES NOT READ THE PUBLISHED DESCRIPTOR. It reads the DECLARATION. A
#     description assembled at runtime from something this parser cannot see is
#     invisible to it, which is what the structural arms above are for.
#   * IT JUDGES NO OTHER ADR-0023 CLAUSE. Types, ranges, defaults and param
#     names restated in prose are the same decision and are not this file's
#     subject; `bin/check-spec-schemas` and the demos' own conformance specs
#     hold neighbouring properties.
#   * IT DOES NOT READ THE JSON SCHEMAS, and the reason is a refusal rather
#     than an oversight. The published `spec/schemas/schema-descriptor.schema.json`
#     carries the same class in its own `description`s, and the copy of it that
#     lives in this repository is VENDORED — held byte-identical to the
#     published one by `bin/check-spec-schemas`, so it cannot be repaired from
#     this side at all. A rule reaching it would be a permanently red tree with
#     no legal move here, which is the wrong shape for a gate. Those instances
#     are filed as a ledger row against the published schema instead.
#   * IT NEVER REWRITES. The repair is a human sentence, because what a
#     description is FOR cannot be derived.
#
# Usage:  bin/check-descriptor-prose [--list] [--self-test]
# Exit:   0 clean, 1 on any LABEL violation, on a detector that cannot prove
#         itself, or on a structural arm that says the corpus went quiet.

require "prism"
require "json"

ROOT = File.expand_path("..", __dir__)

# ── an argument this script does not implement is REFUSED, not ignored ──────
#
# A flag that is accepted, ignored and answered with the ordinary success line
# lets a session type it, read exit 0 and honestly record a run that never
# happened (K-1462, one repository over).
KNOWN_FLAGS = ["--list", "--self-test"].freeze
unknown = ARGV.reject { |a| KNOWN_FLAGS.include?(a) }
unless unknown.empty?
  warn "check-descriptor-prose: unknown argument(s) #{unknown.join(' ')}; " \
       "known: #{KNOWN_FLAGS.join(' ')}"
  exit 2
end

# ── the markers ─────────────────────────────────────────────────────────────

# The bare optionality LABEL. Written as one alternation so that a marker
# deleted from it fails its own probe rather than passing silently.
#
# `EDGE` is a word boundary that a HYPHEN, an UNDERSCORE or a digit does not
# satisfy, and each of the three was measured rather than guessed. Ruby's `\b`
# counts all of them as boundaries, which is the wrong answer three times over
# here: `licence-required` is a compound adjective, and `setup_required` and
# `pow_required` are WIRE VALUES a description quotes — the first writing of
# this rule used `\b` and reddened four correct descriptions whose whole text
# was the literal `setup_required.`, which is a value and not a sentence.
#
# The COPULA test is a separate step rather than a lookbehind, and not by
# preference: Ruby's look-behind must be fixed-width, so `(?<!\bis )` and
# `(?<!\bwere )` cannot share one group. Written as two halves — find the
# marker, then read what stands immediately before it — the two questions stay
# legible and `label_marker` is what every caller asks.
LABEL_WORDS = %w[optionally optional required mandatory compulsory].freeze
EDGE_BEFORE = /(?<![-_\p{L}\p{N}])/
EDGE_AFTER  = /(?![-_\p{L}\p{N}])/
COPULA_RE   = /\b(?:is|are|am|be|been|being|was|were|isn't|aren't|wasn't|weren't|not)[ ]+\z/i
MARKER_RE   = /#{EDGE_BEFORE}(?:#{LABEL_WORDS.join('|')})#{EDGE_AFTER}/i

# The second predicate form, and it arrived with the OpenAPI parameter objects
# (K-1521). «Reserved: always accepted, never required TO BE DECLARED» takes an
# INFINITIVE complement: the word is a predicate about an ACTION — declaring it —
# rather than a marker of this parameter's own membership, which is the same
# distinction the copula test already draws from the other side. A membership
# label never takes one: «Optional to include» is not a sentence anybody writes.
# Two live engine descriptions turned on this the moment the parameter corpus
# existed, and both are foils below, so widening the ban reddens THIS file first.
INFINITIVE_AFTER_RE = /\A[ ]+to[ ]+\p{L}/

# The THIRD compound joiner, and it is the same argument the `EDGE` makes about
# `-` and `_` (K-1524). A marker glued to its OPPOSITE by a slash names the AXIS
# — «names, required/optional, types, enums, ranges» is a list of the things a
# JSON Schema declares, in ADR-0023 decision 2's own words — and an axis is never
# a label on the property carrying the sentence. It is a separate test rather
# than a fourth character in `EDGE` so that the shared vocabulary of this guard
# and `kiosk.tech/bin/check-schema-prose` stays identical character for character
# and the extra question stays visible.
#
# MEASURED at head, and the residue is NIL, which is the whole point: `git grep
# -nIc "required/optional\|optional/required" -- '*.rb' '*.rake'` (real `git
# grep`, default BRE, tracked tree) answers TWO files, `kiosk-server/lib/kiosk/
# server/{actions,queries}.rb`, and both are Ruby COMMENTS documenting the
# descriptor API rather than `description:` values — so this guard never read
# them and was never red. The shape is this project's own vocabulary, in the two
# files that TEACH an author how to write a descriptor; the day somebody copies
# that phrasing into a `description` the ban was red on a correct sentence and
# the obvious repair was to reword ADR-0023's own words. Watched before the
# predicate existed: that sentence planted into a live property description drove
# this script to exit 1 telling the author to delete the label.
SLASH_BEFORE_RE = %r{/\z}
SLASH_AFTER_RE  = %r{\A/}

# The first bare LABEL in this text, or nil. "the OFFSET IS REQUIRED" says a
# word about the VALUE's spelling rather than about the property's membership,
# and nothing lexical separates the two subjects, so the predicate form is
# COUNTED instead of banned.
def label_marker(text)
  offset = 0
  while (m = MARKER_RE.match(text, offset))
    offset = m.end(0)
    before = text[0...m.begin(0)]
    after  = text[m.end(0)..].to_s
    next if before =~ COPULA_RE
    next if after  =~ INFINITIVE_AFTER_RE
    next if before =~ SLASH_BEFORE_RE || after =~ SLASH_AFTER_RE

    return m[0]
  end
  nil
end

# Everything else that spells optionality. Counted, never banned — see the
# header's measurement.
COUNTED_RE = /
  #{EDGE_BEFORE}(?:#{LABEL_WORDS.join('|')})#{EDGE_AFTER}
  | \bomit(?:s|ted|ting|ission)?\b
  | \brequires?\b
  | \b(?:if|when|unless)[ ](?:provided|given|present|supplied|absent|missing|omitted|set|unset)\b
  | \bdefaults?[ ](?:to|is)\b
  | \bleave[ ](?:it[ ]|them[ ]|this[ ])?(?:out|blank|off|empty|unset)\b
  | \b(?:may|can)[ ]be[ ](?:omitted|left[ ]out|skipped|absent)\b
/xi.freeze

# ── the corpus, read structurally ───────────────────────────────────────────

Desc = Struct.new(:kind, :file, :line, :prop, :required, :text, keyword_init: true)

def tracked_ruby(root)
  out = IO.popen(["git", "-C", root, "ls-files", "--", "*.rb", "*.rake"], &:read)
  out.split("\n")
end

def literal_string(node)
  case node
  when Prism::StringNode
    node.unescaped
  when Prism::InterpolatedStringNode
    # An interpolation is a hole this parser cannot fill; the literal parts
    # around it are still prose and are still read.
    node.parts.map { |p| p.is_a?(Prism::StringNode) ? p.unescaped : " " }.join
  end
end

def assoc_pairs(node)
  return {} unless node.is_a?(Prism::HashNode) || node.is_a?(Prism::KeywordHashNode)

  node.elements.each_with_object({}) do |element, acc|
    next unless element.is_a?(Prism::AssocNode) && element.key.is_a?(Prism::SymbolNode)

    acc[element.key.unescaped] = element.value
  end
end

def string_array(node)
  return [] unless node.is_a?(Prism::ArrayNode)

  node.elements.filter_map do |element|
    case element
    when Prism::StringNode, Prism::SymbolNode then element.unescaped
    end
  end
end

# Every description one schema object declares, with the membership its own
# `required:` array gives each property.
def descriptions_in_schema(rel, hash_node, out)
  pairs = assoc_pairs(hash_node)
  return unless pairs.key?("properties")

  required = string_array(pairs["required"])
  assoc_pairs(pairs["properties"]).each do |name, schema|
    node = assoc_pairs(schema)["description"]
    text = node && literal_string(node)
    next unless text

    out << Desc.new(kind: :property, file: rel, line: node.location.start_line,
                    prop: name, required: required.include?(name), text: text)
  end
end

# THE OpenAPI PARAMETER OBJECT — a third kind, and its membership comes from a
# key of its OWN rather than from an array one level up (K-1521).
#
# `descriptions_in_schema` above defines the PROPERTY corpus by construction: a
# `description:` inside a hash that also carries `properties:`. A hash with a
# `description:` and a `required:` but NO `properties:` is therefore outside it,
# and the engine builds its reserved query parameters exactly that way — each is
# `{ name:, in: "query", required: false, description: "…", schema: {…} }`, an
# OpenAPI Parameter Object, where `required` is a BOOLEAN about this parameter
# instead of an array listing its siblings.
#
# MEASURED before this reader existed: a bare `OPTIONAL.` planted at the head of
# the `limit` parameter's description left this script at EXIT 0, named by
# neither the ban nor the census, while the identical label planted on
# `example_params` in the SAME FILE — a property-shaped descriptor — drove it to
# EXIT 1. The residue is nil today and that is the point: the next reserved
# parameter written with a bare label was found by nobody.
#
# The BOOLEAN is what identifies the shape, not a file name or a key order. A
# schema object's `required:` is an array; a parameter object's is `true` or
# `false`, and OpenAPI requires the `in:` beside it. Both are read off the
# syntax tree, so a parameter declared somewhere nobody expected is in scope the
# day it lands, and a hash that merely resembles one is not.
def descriptions_in_parameter(rel, hash_node, out)
  pairs = assoc_pairs(hash_node)
  return if pairs.key?("properties") # a schema object — `descriptions_in_schema` owns it
  return unless pairs.key?("in") && pairs.key?("description")

  membership =
    case pairs["required"]
    when Prism::TrueNode  then true
    when Prism::FalseNode then false
    end
  return if membership.nil?

  node = pairs["description"]
  text = literal_string(node)
  return unless text

  name = pairs["name"] && literal_string(pairs["name"])
  out << Desc.new(kind: :parameter, file: rel, line: node.location.start_line,
                  prop: name || "(unnamed parameter)", required: membership, text: text)
end

# One file's descriptions. Returns [descriptions, parse_error_or_nil].
def descriptions_in(rel, source)
  result = Prism.parse(source)
  return [[], "#{rel}: Prism cannot parse it"] unless result.success?

  out   = []
  queue = [result.value]
  until queue.empty?
    node = queue.shift
    next unless node

    if node.is_a?(Prism::CallNode) && node.name == :description && node.receiver.nil? && node.arguments
      args = node.arguments.arguments
      text = args.size == 1 ? literal_string(args[0]) : nil
      if text
        out << Desc.new(kind: :verb, file: rel, line: node.location.start_line,
                        prop: nil, required: nil, text: text)
      end
    end

    case node
    when Prism::HashNode, Prism::KeywordHashNode
      descriptions_in_schema(rel, node, out)
      descriptions_in_parameter(rel, node, out)
    when Prism::CallNode
      if %i[input_schema output_schema].include?(node.name) && node.arguments
        last = node.arguments.arguments.last
        descriptions_in_schema(rel, last, out) if last.is_a?(Prism::KeywordHashNode)
      end
    end

    queue.concat(node.compact_child_nodes)
  end
  [out.uniq, nil]
end

Corpus = Struct.new(:descriptions, :files_read, :parse_errors, keyword_init: true)

def build_corpus(root)
  descriptions = []
  parse_errors = []
  files_read   = []

  tracked_ruby(root).each do |rel|
    path = File.join(root, rel)
    next unless File.file?(path)

    source = begin
      File.read(path, encoding: "UTF-8")
    rescue StandardError
      next
    end
    next unless source.include?("description")

    files_read << rel

    found, error = descriptions_in(rel, source)
    parse_errors << error if error
    descriptions.concat(found)
  end

  Corpus.new(descriptions: descriptions.uniq, files_read: files_read,
             parse_errors: parse_errors)
end

# ── the rule and the census ─────────────────────────────────────────────────

# The ban reaches BOTH kinds whose membership is declared beside the prose — a
# property (its schema's `required:` array) and an OpenAPI parameter (its own
# `required:` boolean). A verb description has no such declaration, which is why
# it is counted instead; see the header.
DECIDED_KINDS = %i[property parameter].freeze

def label_hits(descriptions)
  descriptions.select { |d| DECIDED_KINDS.include?(d.kind) && label_marker(d.text) }
end

def counted_hits(descriptions)
  labels = label_hits(descriptions)
  descriptions.select { |d| d.text =~ COUNTED_RE }.reject { |d| labels.include?(d) }
end

def label_remedy(desc)
  decided =
    if desc.kind == :parameter
      "`#{desc.prop}` declares `required: #{desc.required}` in the same parameter object"
    else
      "`#{desc.prop}` #{desc.required ? 'IS in' : 'is NOT in'} its schema's own `required:` array"
    end
  "#{decided}, which already decides this. Delete the label and keep every semantic clause — " \
    "what omitting it MEANS, what the value must look like — which is what prose is for " \
    "(ADR-0023)."
end

# ── the detector arms: probes and foils, none of them in the tree ───────────
#
# One probe PER MARKER and one per historical spelling, because a single probe
# against a five-way alternation proves one branch and reports a clean pass for
# the other four — which is how the three hand passes each missed a spelling.

LABEL_PROBES = [
  ["marker `optional`",   "Optional. The delivery date."],
  ["marker `optionally`", "Optionally names a second guest."],
  ["marker `required`",   "Required: the sku from the catalog."],
  ["marker `mandatory`",  "Mandatory for a licence-bearing vehicle."],
  ["marker `compulsory`", "Compulsory when the salon charges a deposit."],
  ["spelling: leading",   "Optional deadline, RFC 3339."],
  ["spelling: MID-STRING",
   "The date of the chosen row. Optional; omitting it books tomorrow."],
  ["spelling: UPPERCASE", "OPTIONAL example inputs."],
  ["spelling: parenthetical", "The room to hold (optional)."],
  ["spelling: late in a long sentence",
   "The `date` of the chosen delivery_slots row, echoing the row you saw — optional."],
  ["spelling: a bare label in an OpenAPI PARAMETER description (K-1521)",
   "OPTIONAL. Maximum rows in one page. The operator MAY clamp it."],
  ["spelling: `required` before a NOUN, not an infinitive",
   "Required cursor for the next page."],
].freeze

# The live sentences the ban had to be argued against. A widening of the label
# reddens this file before it reddens a shipped descriptor.
LABEL_FOILS = [
  ["copula: a constraint on the VALUE",
   "Appointment time, RFC 3339 timestamp, and the OFFSET IS REQUIRED (\"…Z\", \"…+02:00\")."],
  ["copula: a business rule",
   "This origin will not take an order it cannot deliver, so a window and an address " \
   "are required to place one."],
  ["hyphenated compound",
   "Reserving is open to EVERY vehicle, licence-free and licence-required alike."],
  ["the consequence of omitting",
   "New in-zone Dublin delivery address; unchanged if omitted."],
  ["the consequence of omitting, again",
   "Omitting it books tomorrow at the address."],
  ["leave-it-out, spelled out",
   "Leave them out and the list is this hotel's full CATALOGUE."],
  ["a precondition, not a shape",
   "Cancel one of the principal's own bookings (requires the booking to belong to them)."],
  ["infinitive complement: a guarantee about the OPERATOR's declaration, not this " \
   "parameter's membership (K-1521)",
   "Maximum rows in one page. The operator MAY clamp it. Reserved: always accepted, " \
   "never required to be declared."],
  ["infinitive complement, the second reserved parameter",
   "The OPAQUE `next` token from the previous page, echoed back verbatim. Never parse or " \
   "construct one. Reserved: always accepted, never required to be declared."],
  ["a SLASH compound naming the AXIS, not this property's membership (K-1524)",
   "JSON Schema for this verb's inputs: names, required/optional, types, enums, ranges."],
  ["the same compound the other way round",
   "It declares optional/required per field."],
].freeze

COUNTED_PROBES = [
  ["copula form",      "The offset is required."],
  ["omit family",      "Omitting it books tomorrow."],
  ["requires",         "Requires the booking to belong to the principal."],
  ["if-omitted",       "Unchanged if omitted."],
  ["defaults to",      "Page size defaults to 20."],
  ["leave it out",     "Leave them out and the list is the full catalogue."],
  ["may be omitted",   "The room id may be omitted."],
  ["a bare label too", "Optional deadline."],
].freeze

COUNTED_FOILS = [
  ["no optionality at all", "The Stripe-hosted card-entry page to hand to your human."],
  ["a requirement of the OPERATOR, differently worded",
   "The cashier re-counts every line against its own catalogue before it charges."],
].freeze

def detector_faults
  faults = []
  LABEL_PROBES.each do |what, text|
    faults << "LABEL cannot see its own probe (#{what}): #{text.inspect}" unless label_marker(text)
  end
  LABEL_FOILS.each do |what, text|
    faults << "LABEL fires on a FOIL (#{what}) — the ban has widened onto correct " \
              "prose: #{text.inspect}" if label_marker(text)
  end
  COUNTED_PROBES.each do |what, text|
    faults << "C1 cannot see its own probe (#{what}): #{text.inspect}" unless text =~ COUNTED_RE
  end
  COUNTED_FOILS.each do |what, text|
    faults << "C1 fires on a FOIL (#{what}): #{text.inspect}" if text =~ COUNTED_RE
  end
  faults
end

# ── the structural arms: derived from the filesystem, never from a list ─────

# Where the engine declares WHICH query arguments are reserved. Read for arm (d)
# below, which is the only thing keeping the OpenAPI parameter corpus from
# silently draining back to the empty set it was before K-1521.
ARGUMENT_DECODER = "kiosk-server/lib/kiosk/server/argument_decoder.rb"

def reserved_argument_names(root)
  path = File.join(root, ARGUMENT_DECODER)
  return [] unless File.file?(path)

  result = Prism.parse(File.read(path, encoding: "UTF-8"))
  return [] unless result.success?

  queue = [result.value]
  until queue.empty?
    node = queue.shift
    next unless node

    if node.is_a?(Prism::ConstantWriteNode) && node.name == :RESERVED
      value = node.value
      value = value.receiver if value.is_a?(Prism::CallNode) && value.name == :freeze
      # STRING keys, not symbols: `RESERVED = { "limit" => "integer", … }`, so
      # `assoc_pairs` (which reads the symbol-keyed descriptor hashes) is the
      # wrong reader here and returning its empty answer would read as «the
      # engine reserves nothing».
      if value.is_a?(Prism::HashNode)
        return value.elements.filter_map { |e|
          e.key.unescaped if e.is_a?(Prism::AssocNode) &&
                             (e.key.is_a?(Prism::StringNode) || e.key.is_a?(Prism::SymbolNode))
        }
      end
    end
    queue.concat(node.compact_child_nodes)
  end
  []
end

# `Kiosk::HotelsController` -> `kiosk/hotels_controller.rb`. Rails' own
# underscore rule, written out because this script loads no ActiveSupport —
# the same derivation bin/check-verb-routes makes, for the same reason.
def controller_file(class_name)
  "#{class_name.split('::').map { |part| part.gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase }.join('/')}.rb"
end

# The HANDLER CONTROLLERS this repository ships, as [origin, relative path] —
# resolved from each origin's own `config/initializers/kiosk.rb`, which is the
# list the registry reads at boot. Nothing here is a demo name, a controller
# name or a count: an eighth origin, or a ninth controller inside one, is
# covered the day it lands, and a file that stops parsing is named.
def handler_controllers(root)
  Dir[File.join(root, "kiosk-demo-*/config/initializers/kiosk.rb")].sort.flat_map do |initializer|
    dir    = File.expand_path("../../..", initializer)
    origin = File.basename(dir)
    names  = File.read(initializer)[/c\.handlers\s*=\s*%w\[([^\]]*)\]/m].to_s.scan(/[A-Z][\w:]*/)
    names.filter_map do |class_name|
      rel = File.join(origin, "app/controllers", controller_file(class_name))
      File.file?(File.join(root, rel)) ? [origin, rel] : nil
    end
  end
end

def origins(root)
  handler_controllers(root).map(&:first).uniq
end

def structural_faults(root, corpus)
  faults = corpus.parse_errors.dup

  if corpus.descriptions.empty?
    faults << "VACUITY: the corpus is EMPTY — nothing in this repository parsed as a " \
              "descriptor description, so every rule below is a statement about nothing."
    return faults
  end

  # (a) EVERY handler controller an origin declares must still be readable. This
  # is the arm that goes red when the parser's shape assumption breaks on one
  # file rather than on all of them.
  controllers = handler_controllers(root)
  if controllers.empty?
    faults << "VACUITY: no handler controller was resolved from any " \
              "`kiosk-demo-*/config/initializers/kiosk.rb` — the derivation that decides this " \
              "check's subject has stopped answering, so every arm below is vacuous."
  end
  controllers.each do |origin, rel|
    mine = corpus.descriptions.select { |d| d.file == rel }
    if mine.none? { |d| d.kind == :verb }
      faults << "VACUITY: #{rel} is named in #{origin}'s `c.handlers` and yielded NO verb " \
                "description — the parser has stopped reading it."
    end
    if mine.none? { |d| d.kind == :property }
      faults << "VACUITY: #{rel} is named in #{origin}'s `c.handlers` and yielded NO property " \
                "description — the parser has stopped reading its schemas."
    end
  end

  # (b) THE SCOPE MUST REACH PAST THE DEMOS. The third hand pass concluded the
  # class was drained repository-wide from a `kiosk-demo-*` pathspec, and two of
  # the four survivors were in the engine's own description surface. A corpus
  # that has quietly become demos-only cannot make that mistake silently again.
  outside = corpus.descriptions.reject { |d| d.file.start_with?("kiosk-demo-") }
  if outside.none? { |d| d.kind == :property }
    faults << "VACUITY: every property description in the corpus is inside a `kiosk-demo-*` " \
              "directory. The scope has narrowed to the demos, which is the pathspec that hid " \
              "two live violations in the engine's own description surface."
  end

  # (d) THE PARAMETER CORPUS MUST COVER EVERY RESERVED ARGUMENT THE ENGINE
  # DECLARES (K-1521). The parameter shape is recognised by a `required:`
  # BOOLEAN beside an `in:`, and a shape recognised by a pattern is a scope that
  # can silently stop matching — which is exactly how these descriptions came to
  # be in no scope at all. So the expected SUBJECT is derived from a DIFFERENT
  # file: `ArgumentDecoder::RESERVED` is where the engine says which query
  # arguments are reserved, and every one of them must show up here with a
  # description. A third reserved argument, or a rewrite of the parameter
  # builder that this reader stops recognising, costs a decision instead of
  # quietly shrinking the corpus.
  reserved = reserved_argument_names(root)
  if reserved.empty?
    faults << "VACUITY: #{ARGUMENT_DECODER} yields no `RESERVED` names, so the arm that keeps " \
              "the OpenAPI parameter corpus honest has no subject to compare against."
  else
    named   = corpus.descriptions.select { |d| d.kind == :parameter }.map(&:prop)
    missing = reserved - named
    unless missing.empty?
      faults << "VACUITY: the engine declares reserved query argument(s) " \
                "#{missing.map(&:inspect).join(', ')} in #{ARGUMENT_DECODER}, and the OpenAPI " \
                "parameter corpus carries a description for #{named.map(&:inspect).join(', ')} " \
                "— so either a reserved parameter has no published description, or this " \
                "reader has stopped recognising the parameter-object shape. That shape was in " \
                "NO scope at all until K-1521; it must not go quiet again."
    end
  end

  # (c) A SECOND READING OF THE SAME FILES. The verb DSL is a line of its own,
  # so a text scan and the syntax tree must agree file by file wherever the tree
  # found anything. Scoped to those files on purpose: a `description "…"` inside
  # a HEREDOC is source text a spec writes to a temp file, and counting it would
  # make this arm permanently wrong for a reason that is not a defect.
  corpus.descriptions.map(&:file).uniq.each do |rel|
    ast  = corpus.descriptions.count { |d| d.file == rel && d.kind == :verb }
    next if ast.zero?

    text = File.read(File.join(root, rel), encoding: "UTF-8")
               .scan(/^[ \t]*description[ \t]+"/).length
    next if text == ast

    faults << "VACUITY: #{rel} — a text scan finds #{text} verb `description \"…\"` line(s) " \
              "and the syntax tree finds #{ast}. The two readings of one file have come apart."
  end

  faults
end

# ── the run ─────────────────────────────────────────────────────────────────

def run_check(root, list: false)
  corpus = build_corpus(root)
  errors = structural_faults(root, corpus)

  verbs  = corpus.descriptions.count { |d| d.kind == :verb }
  props  = corpus.descriptions.count { |d| d.kind == :property }
  params = corpus.descriptions.count { |d| d.kind == :parameter }
  decided = props + params
  files  = corpus.descriptions.map(&:file).uniq.sort

  puts "SCOPE — `git ls-files -- '*.rb' '*.rake'`, parsed with Prism"
  puts "  #{verbs} verb description(s), #{props} property description(s) and #{params} " \
       "OpenAPI parameter description(s) in #{files.length} file(s), across " \
       "#{origins(root).length} origin(s) with a `c.handlers`"
  puts "  the ban reaches the #{decided} whose membership is declared beside the prose " \
       "(a property's sibling `required:` array, a parameter's own `required:` boolean); " \
       "a verb description has no such declaration and is counted"

  if list
    corpus.descriptions.sort_by { |d| [d.file, d.line] }.each do |d|
      tag = d.kind == :verb ? "VERB" : "#{d.kind == :parameter ? 'PARAM ' : ''}#{d.prop} required=#{d.required}"
      puts format("  %-72s %s", "#{d.file}:#{d.line}", tag)
    end
  end

  errors.concat(detector_faults)

  hits = label_hits(corpus.descriptions)
  puts
  if hits.empty?
    puts "LABEL. no property and no OpenAPI parameter description carries a bare optionality " \
         "label — OK (#{decided} description(s) whose membership is declared beside them: " \
         "#{props} property, #{params} parameter; detector re-proved on this run against " \
         "#{LABEL_PROBES.length} probe(s) and #{LABEL_FOILS.length} foil(s))"
  else
    puts "LABEL. a description restates the membership its own declaration already decides " \
         "— #{hits.length} occurrence(s):"
    hits.sort_by { |d| [d.file, d.line] }.each do |d|
      errors << "LABEL #{d.file}:#{d.line} — `#{d.prop}`"
      marker = label_marker(d.text)
      puts "  FAIL #{d.file}:#{d.line} — «#{marker}» in `#{d.prop}`'s description. " \
           "#{label_remedy(d)}"
      puts "       #{d.text.gsub(/\s+/, ' ')[0, 220]}"
    end
  end

  counted = counted_hits(corpus.descriptions)
  puts
  puts "COUNTED, NEVER BANNED — every other optionality construction in a description. Each " \
       "spells archaeology of shape and live semantics with the same letters, so each is a " \
       "line a human adjudicates and none of it reaches the exit code:"
  puts "  C1 optionality outside the bare label — #{counted.length} line(s), " \
       "#{counted.count { |d| d.kind == :verb }} in a verb description, " \
       "#{counted.count { |d| d.kind == :property }} in a property's and " \
       "#{counted.count { |d| d.kind == :parameter }} in an OpenAPI parameter's"
  counted.sort_by { |d| [d.file, d.line] }.each do |d|
    tag = d.kind == :verb ? "VERB" : "#{d.kind == :parameter ? 'PARAM ' : ''}`#{d.prop}` required=#{d.required}"
    puts "       #{d.file}:#{d.line} (#{tag}) — #{d.text.gsub(/\s+/, ' ')[0, 160]}"
  end
  puts "       adjudicate: what OMITTING a property MEANS, a constraint on the VALUE, a " \
       "precondition and a business rule are all SEMANTICS and stay. A word that only " \
       "restates the `required:` array is the label the rule above bans."
  puts "  A ZERO HERE IS NOT A PASS AND A COUNT HERE IS NOT A FAILURE — the detector behind " \
       "it is re-proved on every run against fixtures that are not in this tree."

  errors
end

# ── the self-test ───────────────────────────────────────────────────────────
#
# A plant is a REAL tracked file, a faithful mutation of it, and the real
# parser: the fixture cannot rot without saying so, because each plant asserts
# its pattern still matches the file before it substitutes anything. Nothing is
# written to disk — the mutation is applied to the source in memory, which is
# the same text the run reads.

PLANTS = [
  { rule: "LABEL / leading, mixed case — the spelling the first sweep found",
    file: "kiosk-demo-hoteling/app/controllers/kiosk/hotels_controller.rb",
    find: /description: "Hotel name\."/,
    with: 'description: "Optional. Hotel name."',
    expect: /LABEL kiosk-demo-hoteling/ },
  { rule: "LABEL / MID-STRING — the spelling a start-anchored literal cannot see",
    file: "kiosk-demo-getgrocery/app/controllers/kiosk/orders_controller.rb",
    find: /description: "uuid of an unpaid order to replace\."/,
    with: 'description: "uuid of an unpaid order to replace. Optional; pass it to amend."',
    expect: %r{LABEL kiosk-demo-getgrocery/app/controllers/kiosk/orders_controller\.rb} },
  { rule: "LABEL / UPPERCASE — the spelling a case-sensitive pattern cannot see",
    file: "kiosk-demo-tudu/app/controllers/kiosk/todo_lists_controller.rb",
    find: /description: "The todo text/,
    with: 'description: "REQUIRED. The todo text',
    expect: %r{LABEL kiosk-demo-tudu} },
  { rule: "LABEL / parenthetical",
    file: "kiosk-demo-stylish/app/controllers/kiosk/appointments_controller.rb",
    find: /description: "Appointment time, RFC 3339 timestamp/,
    with: 'description: "Appointment time (optional), RFC 3339 timestamp',
    expect: %r{LABEL kiosk-demo-stylish} },
  { rule: "LABEL / outside the demos — the engine's own description surface",
    file: "kiosk-server/lib/kiosk/server/open_api.rb",
    find: /description: "The verb's SEMANTICS, in prose\. Authoritative\."/,
    with: 'description: "The verb\'s SEMANTICS, in prose. Mandatory."',
    expect: %r{LABEL kiosk-server/lib/kiosk/server/open_api\.rb} },
  { rule: "LABEL / an OpenAPI PARAMETER OBJECT, whose membership is its own `required:` " \
          "boolean and which was in NO scope at all (K-1521)",
    file: "kiosk-server/lib/kiosk/server/open_api.rb",
    find: /description: "Maximum rows in one page\./,
    with: 'description: "OPTIONAL. Maximum rows in one page.',
    expect: %r{LABEL kiosk-server/lib/kiosk/server/open_api\.rb} },
  { rule: "LABEL / a CONTINUATION LINE, where the marker is nowhere near the key",
    file: "kiosk-demo-skooti/app/controllers/kiosk/rentals_controller.rb",
    find: /description: "The hosted setup page to hand to your human\."/,
    with: "description: \"The hosted setup page to hand to your human. \" \\\n" \
          "                            \"Optional.\"",
    expect: %r{LABEL kiosk-demo-skooti} },
].freeze

# Sentences that must NOT redden the ban. Each is a live shape somebody wrote on
# purpose, planted into a real descriptor.
FOIL_PLANTS = [
  { what: "the reserved parameter's live guarantee, in a parameter object (K-1521)",
    file: "kiosk-server/lib/kiosk/server/open_api.rb",
    find: /description: "Maximum rows in one page\./,
    with: 'description: "Never required to be declared. Maximum rows in one page.' },
  { what: "a copula form about the VALUE",
    file: "kiosk-demo-hoteling/app/controllers/kiosk/hotels_controller.rb",
    find: /description: "Hotel name\."/,
    with: 'description: "The offset is required. Hotel name."' },
  { what: "a hyphenated compound",
    file: "kiosk-demo-hoteling/app/controllers/kiosk/hotels_controller.rb",
    find: /description: "Hotel name\."/,
    with: 'description: "Licence-required rooms included. Hotel name."' },
  { what: "the consequence of omitting",
    file: "kiosk-demo-getgrocery/app/controllers/kiosk/orders_controller.rb",
    find: /description: "uuid of an unpaid order to replace\."/,
    with: 'description: "uuid of an unpaid order to replace. Unchanged if omitted."' },
  { what: "a precondition",
    file: "kiosk-demo-getgrocery/app/controllers/kiosk/orders_controller.rb",
    find: /description: "uuid of an unpaid order to replace\."/,
    with: 'description: "uuid of an order (requires the order to be unpaid) to replace."' },
].freeze

def plant_and_run(root, plant)
  rel  = plant[:file]
  path = File.join(root, rel)
  return [nil, "#{rel} is not in the tree, so this arm proves nothing"] unless File.file?(path)

  source = File.read(path, encoding: "UTF-8")
  unless source.match?(plant[:find])
    return [nil, "the plant no longer matches anything in #{rel} (#{plant[:find].inspect}) — " \
                 "the fixture has rotted, so this arm proves nothing"]
  end

  # The BLOCK form of `sub`, so a backslash in the replacement is a backslash
  # and not a backreference — the continuation-line plant below is a real Ruby
  # line continuation and has one.
  found, error = descriptions_in(rel, source.sub(plant[:find]) { plant[:with] })
  return [nil, "the planted source no longer parses: #{error}"] if error

  [label_hits(found), nil]
end

def self_test(root)
  failures = []

  detector_faults.each { |f| failures << "DETECTOR: #{f}" }

  corpus = build_corpus(root)
  structural_faults(root, corpus).each { |f| failures << "STRUCTURE: #{f}" }

  PLANTS.each do |plant|
    hits, error = plant_and_run(root, plant)
    if error
      failures << "#{plant[:rule]}: #{error}"
      next
    end
    lines = hits.map { |d| "LABEL #{d.file}:#{d.line} — `#{d.prop}`" }
    if lines.empty?
      failures << "#{plant[:rule]}: PLANTED AND STILL GREEN"
    elsif lines.none? { |l| l =~ plant[:expect] }
      failures << "#{plant[:rule]}: went red but not for its own site (wanted " \
                  "#{plant[:expect].inspect}); got #{lines.first}"
    end
  end

  FOIL_PLANTS.each do |plant|
    hits, error = plant_and_run(root, plant)
    if error
      failures << "FOIL #{plant[:what]}: #{error}"
      next
    end
    unless hits.empty?
      failures << "FOIL #{plant[:what]}: the ban REDDENED on correct prose at " \
                  "#{hits.first.file}:#{hits.first.line} — it has widened onto the sentences " \
                  "three hand passes deliberately kept"
    end
  end

  # The structural arms must be able to go red, or they are decoration. Each is
  # driven off a corpus that has been emptied rather than off a promise.
  empty = Corpus.new(descriptions: [], files_read: [], parse_errors: [])
  if structural_faults(root, empty).empty?
    failures << "STRUCTURE: an EMPTY corpus raises no fault, so the vacuity arms assert nothing"
  end

  quiet = Corpus.new(descriptions: corpus.descriptions.reject { |d| d.kind == :verb },
                     files_read: corpus.files_read, parse_errors: [])
  if structural_faults(root, quiet).none? { |f| f.include?("NO verb description") }
    failures << "STRUCTURE: an origin contributing no verb description raises no fault, so the " \
                "per-origin arm is a statement about nothing"
  end

  if origins(root).empty?
    failures << "STRUCTURE: no origin was discovered on disk, so the per-origin arm has no subject"
  end

  # Arm (d) proved able to go red, driven off a corpus with the parameter kind
  # removed rather than off a promise (K-1521). The empty-corpus arm above
  # cannot stand in for this one: it empties EVERYTHING, so it would raise on
  # the per-origin arms and say nothing about whether the parameter shape is
  # still being recognised.
  no_params = Corpus.new(descriptions: corpus.descriptions.reject { |d| d.kind == :parameter },
                         files_read: corpus.files_read, parse_errors: [])
  if structural_faults(root, no_params).none? { |f| f.include?("reserved query argument") }
    failures << "STRUCTURE: a corpus carrying NO OpenAPI parameter description raises no fault, " \
                "so the arm that keeps that scope from draining back to empty asserts nothing"
  end
  if reserved_argument_names(root).empty?
    failures << "STRUCTURE: #{ARGUMENT_DECODER} yields no reserved argument names on disk, so " \
                "arm (d) has no subject to compare the parameter corpus against"
  end

  failures
end

# ── main ────────────────────────────────────────────────────────────────────

if ARGV.include?("--self-test")
  failures = self_test(ROOT)
  if failures.empty?
    puts "check-descriptor-prose --self-test: OK — #{PLANTS.length} planted break(s) each red " \
         "for its own site, #{FOIL_PLANTS.length} foil(s) each still green, " \
         "#{LABEL_PROBES.length + COUNTED_PROBES.length} detector probe(s) and " \
         "#{LABEL_FOILS.length + COUNTED_FOILS.length} detector foil(s), and the structural " \
         "arms proved able to go red."
    exit 0
  end
  warn "\ncheck-descriptor-prose --self-test FAILED:\n"
  failures.each { |f| warn "  x #{f}" }
  exit 1
end

errors = run_check(ROOT, list: ARGV.include?("--list"))

puts
if errors.empty?
  puts "check-descriptor-prose: OK — every descriptor description read from the syntax tree, " \
       "and none of them restates the membership its own `required:` array decides."
  exit 0
end

warn "\ncheck-descriptor-prose FAILED:\n"
errors.each { |e| warn "  x #{e}" }
warn "\nADR-0023: a description carries SEMANTICS — what the verb does, what a value means, " \
     "what omitting it does. Names, types and required/optional live in the schema beside it, " \
     "which is the one declaration a machine can check against the handler."
exit 1
