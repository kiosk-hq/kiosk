#!/usr/bin/env ruby
# frozen_string_literal: true

# check-descriptor-prose — no property or OpenAPI parameter description served in a
# descriptor carries a bare optionality label (`optional`, `required`, …); its
# `required:` declaration already says that. Reads every tracked .rb/.rake with Prism.
#
# Usage: bin/check-descriptor-prose [--self-test]

require 'prism'

ROOT = File.expand_path('..', __dir__)

unless (unknown = ARGV - ['--self-test']).empty?
  warn "check-descriptor-prose: unknown argument(s) #{unknown.join(' ')}; known: --self-test"
  exit 2
end

# A label word with no hyphen, underscore, letter or digit glued to either side.
LABEL_WORDS = %w[optionally optional required mandatory compulsory].freeze
EDGE_BEFORE = /(?<![-_\p{L}\p{N}])/
EDGE_AFTER  = /(?![-_\p{L}\p{N}])/
MARKER_RE   = /#{EDGE_BEFORE}(?:#{LABEL_WORDS.join('|')})#{EDGE_AFTER}/i
# Not a label: the complement of a copula («the offset is required»).
COPULA_RE   = /\b(?:is|are|am|be|been|being|was|were|isn't|aren't|wasn't|weren't|not) +\z/i
# Not a label: an infinitive complement («never required to be declared»).
INFINITIVE_AFTER_RE = /\A +to +\p{L}/
# Not a label: a slash compound naming the axis («required/optional»).
SLASH_BEFORE_RE = %r{/\z}
SLASH_AFTER_RE  = %r{\A/}

def label_marker(text)
  offset = 0
  while (m = MARKER_RE.match(text, offset))
    offset = m.end(0)
    before = text[0...m.begin(0)]
    after  = text[m.end(0)..].to_s
    next if before =~ COPULA_RE || after =~ INFINITIVE_AFTER_RE
    next if before =~ SLASH_BEFORE_RE || after =~ SLASH_AFTER_RE

    return m[0]
  end
  nil
end

Desc = Struct.new(:kind, :file, :line, :prop, :required, :text, keyword_init: true)

def literal_string(node)
  case node
  when Prism::StringNode then node.unescaped
  when Prism::InterpolatedStringNode
    node.parts.map { |p| p.is_a?(Prism::StringNode) ? p.unescaped : ' ' }.join
  end
end

def assoc_pairs(node)
  return {} unless node.is_a?(Prism::HashNode) || node.is_a?(Prism::KeywordHashNode)

  node.elements.each_with_object({}) do |element, acc|
    next unless element.is_a?(Prism::AssocNode) && element.key.is_a?(Prism::SymbolNode)

    acc[element.key.unescaped] = element.value
  end
end

def string_array(node)
  return [] unless node.is_a?(Prism::ArrayNode)

  node.elements.filter_map { |e| e.unescaped if e.is_a?(Prism::StringNode) || e.is_a?(Prism::SymbolNode) }
end

# A schema object: `properties:` with a sibling `required:` array.
def descriptions_in_schema(rel, hash_node, out)
  pairs = assoc_pairs(hash_node)
  return unless pairs.key?('properties')

  required = string_array(pairs['required'])
  assoc_pairs(pairs['properties']).each do |name, schema|
    node = assoc_pairs(schema)['description']
    text = node && literal_string(node)
    next unless text

    out << Desc.new(kind: :property, file: rel, line: node.location.start_line,
                    prop: name, required: required.include?(name), text: text)
  end
end

# An OpenAPI parameter object: `in:`, `description:` and a boolean `required:`.
def descriptions_in_parameter(rel, hash_node, out)
  pairs = assoc_pairs(hash_node)
  return unless parameter_object?(pairs)

  membership = { Prism::TrueNode => true, Prism::FalseNode => false }[pairs['required'].class]
  text = literal_string(pairs['description'])
  return if membership.nil? || text.nil?

  out << Desc.new(kind: :parameter, file: rel, line: pairs['description'].location.start_line,
                  prop: parameter_name(pairs), required: membership, text: text)
end

def parameter_object?(pairs) = !pairs.key?('properties') && pairs.key?('in') && pairs.key?('description')
def parameter_name(pairs) = (pairs['name'] && literal_string(pairs['name'])) || '(unnamed parameter)'

# Yields every node of the tree, breadth first.
def each_node(root)
  queue = [root]
  until queue.empty?
    node = queue.shift
    next unless node

    yield node
    queue.concat(node.compact_child_nodes)
  end
end

def descriptions_in(rel, source)
  result = Prism.parse(source)
  return [[], "#{rel}: Prism cannot parse it"] unless result.success?

  out = []
  each_node(result.value) do |node|
    next unless node.is_a?(Prism::HashNode) || node.is_a?(Prism::KeywordHashNode)

    descriptions_in_schema(rel, node, out)
    descriptions_in_parameter(rel, node, out)
  end
  [out.uniq, nil]
end

def build_corpus(root)
  errors = []
  descriptions = tracked_ruby(root).flat_map do |rel|
    found, error = file_descriptions(root, rel)
    errors << error if error
    found
  end
  [descriptions, errors]
end

def tracked_ruby(root) = IO.popen(['git', '-C', root, 'ls-files', '--', '*.rb', '*.rake'], &:read).split("\n")

def file_descriptions(root, rel)
  path = File.join(root, rel)
  return [[], nil] unless File.file?(path)

  source = File.read(path, encoding: 'UTF-8')
  return [[], nil] unless source.include?('description')

  descriptions_in(rel, source)
end

def label_hits(descriptions) = descriptions.select { |d| label_marker(d.text) }

ARGUMENT_DECODER = 'kiosk-server/lib/kiosk/server/argument_decoder.rb'

# The keys of the engine's `RESERVED = { "limit" => …, … }`.
def reserved_argument_names(root)
  path = File.join(root, ARGUMENT_DECODER)
  return [] unless File.file?(path)

  each_node(Prism.parse(File.read(path, encoding: 'UTF-8')).value) do |node|
    hash = reserved_hash(node)
    return hash.elements.filter_map { |e| e.key.unescaped if e.is_a?(Prism::AssocNode) } if hash
  end
  []
end

# The hash literal of a `RESERVED = { … }` or `RESERVED = { … }.freeze` node; nil for any other node.
def reserved_hash(node)
  return unless node.is_a?(Prism::ConstantWriteNode) && node.name == :RESERVED

  value = node.value
  value = value.receiver if value.is_a?(Prism::CallNode) && value.name == :freeze
  value if value.is_a?(Prism::HashNode)
end

# The reader still reaches what it must: every demo handler controller, the engine,
# and every reserved query parameter the engine declares.
def structural_faults(root, descriptions)
  return ['the corpus is empty: nothing parsed as a property or parameter description'] if descriptions.empty?

  controller_faults(root, descriptions) + engine_faults(descriptions) + reserved_faults(root, descriptions)
end

def controller_faults(root, descriptions)
  Dir[File.join(root, 'kiosk-demo-*/app/controllers/kiosk/**/*.rb')].filter_map do |path|
    rel = path.delete_prefix("#{root}/")
    next if descriptions.any? { |d| d.file == rel && d.kind == :property }

    "#{rel} yields no property description; the schema reader has stopped reading it."
  end
end

def engine_faults(descriptions)
  return [] unless descriptions.select { |d| d.kind == :property }.all? { |d| d.file.start_with?('kiosk-demo-') }

  ['every property description is inside a demo; the scope no longer reaches the engine.']
end

def reserved_faults(root, descriptions)
  reserved = reserved_argument_names(root)
  return ["#{ARGUMENT_DECODER} yields no RESERVED names to compare the parameter corpus against."] if reserved.empty?

  missing = reserved - descriptions.select { |d| d.kind == :parameter }.map(&:prop)
  return [] if missing.empty?

  ["reserved query argument(s) #{missing.join(', ')} have no OpenAPI parameter description; " \
   'describe them, or teach this reader the new parameter shape.']
end

LABEL_PROBES = [
  'Optional. The delivery date.',
  'Optionally names a second guest.',
  'Required: the sku from the catalog.',
  'Mandatory for a licence-bearing vehicle.',
  'Compulsory when the salon charges a deposit.',
  'The date of the chosen row. Optional; omitting it books tomorrow.',
  'OPTIONAL example inputs.',
  'The room to hold (optional).',
  'The `date` of the chosen delivery_slots row, echoing the row you saw — optional.',
  'Required cursor for the next page.'
].freeze

LABEL_FOILS = [
  'Appointment time, RFC 3339 timestamp, and the OFFSET IS REQUIRED ("…Z", "…+02:00").',
  'A window and an address are required to place one.',
  'Reserving is open to EVERY vehicle, licence-free and licence-required alike.',
  'New in-zone Dublin delivery address; unchanged if omitted.',
  "Cancel one of the principal's own bookings (requires the booking to belong to them).",
  'Maximum rows in one page. Reserved: always accepted, never required to be declared.',
  "JSON Schema for this verb's inputs: names, required/optional, types, enums, ranges.",
  'It declares optional/required per field.'
].freeze

def detector_faults
  LABEL_PROBES.reject { |t| label_marker(t) }.map { |t| "the label pattern misses its probe: #{t.inspect}" } +
    LABEL_FOILS.select { |t| label_marker(t) }.map { |t| "the label pattern fires on a foil: #{t.inspect}" }
end

def report(hit)
  decided = if hit.kind == :parameter
              "the parameter declares `required: #{hit.required}`"
            else
              "`#{hit.prop}` is #{'not ' unless hit.required}in its schema's `required:` array"
            end
  "#{hit.file}:#{hit.line}: «#{label_marker(hit.text)}» in `#{hit.prop}`'s description; " \
    "#{decided}. Delete the label and keep what the value means."
end

# Each plant is a real descriptor mutated in memory; a planted label must redden.
PLANTS = [
  ['kiosk-demo-hoteling/app/controllers/kiosk/hotels_controller.rb',
   /description: 'Hotel name\.'/, 'description: "Optional. Hotel name."'],
  ['kiosk-demo-getgrocery/app/controllers/kiosk/orders_controller.rb',
   /description: 'The `slot_at` of a delivery_slots row\.'/, 'description: "Optional. The `slot_at` of a delivery_slots row."'],
  ['kiosk-demo-tudu/app/controllers/kiosk/todos_controller.rb',
   /description: 'The todo text/, "description: 'REQUIRED. The todo text"],
  ['kiosk-demo-stylish/app/controllers/kiosk/appointments_controller.rb',
   /description: 'Appointment time; must be in the future\.'/, 'description: "Appointment time (optional); must be in the future."'],
  ['kiosk-server/lib/kiosk/server/open_api.rb',
   /description: "The verb's SEMANTICS, in prose\. Authoritative\."/,
   'description: "The verb\'s SEMANTICS, in prose. Mandatory."'],
  ['kiosk-server/lib/kiosk/server/open_api.rb',
   /description: 'Maximum rows in one page\./, "description: 'OPTIONAL. Maximum rows in one page."],
  ['kiosk-server/lib/kiosk/server/payment_setup.rb',
   /description: 'The page to hand to your human\.'/,
   "description: \"The page to hand to your human. \" \\\n                            \"Optional.\""]
].freeze

# Correct sentences planted into real descriptors; they must stay green.
FOIL_PLANTS = [
  ['kiosk-server/lib/kiosk/server/open_api.rb',
   /description: 'Maximum rows in one page\./, "description: 'Never required to be declared. Maximum rows in one page."],
  ['kiosk-demo-hoteling/app/controllers/kiosk/hotels_controller.rb',
   /description: 'Hotel name\.'/, 'description: "The offset is required. Hotel name."'],
  ['kiosk-demo-hoteling/app/controllers/kiosk/hotels_controller.rb',
   /description: 'Hotel name\.'/, 'description: "Licence-required rooms included. Hotel name."'],
  ['kiosk-demo-getgrocery/app/controllers/kiosk/orders_controller.rb',
   /description: 'The `slot_at` of a delivery_slots row\.'/, 'description: "The `slot_at` of a delivery_slots row. Unchanged if omitted."']
].freeze

def plant_hits(root, (rel, find, with))
  source = File.read(File.join(root, rel), encoding: 'UTF-8')
  return [nil, "#{rel}: the plant pattern #{find.inspect} no longer matches"] unless source.match?(find)

  found, error = descriptions_in(rel, source.sub(find) { with })
  error ? [nil, error] : [label_hits(found).select { |d| d.file == rel }, nil]
end

def self_test(root)
  descriptions, errors = build_corpus(root)
  detector_faults + errors + structural_faults(root, descriptions) +
    plant_failures(root) + foil_failures(root) + corpus_failures(root, descriptions)
end

def plant_failures(root)
  PLANTS.filter_map do |plant|
    hits, error = plant_hits(root, plant)
    error || "#{plant[0]}: a planted label stays green" if error || hits.empty?
  end
end

def foil_failures(root)
  FOIL_PLANTS.filter_map do |plant|
    hits, error = plant_hits(root, plant)
    error || "#{plant[0]}: a correct sentence reddens: #{plant[2]}" if error || hits.any?
  end
end

# Each damaged corpus must raise a structural fault.
def corpus_failures(root, descriptions)
  damaged_corpora(root, descriptions).filter_map do |what, corpus|
    "#{what} raises no structural fault" if structural_faults(root, corpus).empty?
  end
end

def damaged_corpora(root, descriptions)
  first_controller = Dir.glob('kiosk-demo-*/app/controllers/kiosk/*.rb', base: root).min
  { 'an empty corpus' => [],
    'a corpus with no engine property' => descriptions.reject { |d| d.kind == :property && !d.file.start_with?('kiosk-demo-') },
    'a corpus with no parameter' => descriptions.reject { |d| d.kind == :parameter },
    'a corpus missing one demo controller' => descriptions.reject { |d| d.file == first_controller } }
end

if ARGV.include?('--self-test')
  failures = self_test(ROOT)
  if failures.empty?
    puts 'check-descriptor-prose --self-test: OK'
    exit 0
  end
  failures.each { |f| warn "  x #{f}" }
  exit 1
end

descriptions, errors = build_corpus(ROOT)
errors.concat(structural_faults(ROOT, descriptions), detector_faults)
errors.concat(label_hits(descriptions).sort_by { |d| [d.file, d.line] }.map { |d| report(d) })
if errors.empty?
  puts "check-descriptor-prose: OK — #{descriptions.size} property and parameter descriptions, no bare optionality label."
  exit 0
end
errors.each { |e| warn "  x #{e}" }
exit 1
