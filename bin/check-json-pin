#!/usr/bin/env ruby
# frozen_string_literal: true

# check-json-pin -- the `json < 3.0` pin is REAL, is EXPLAINED, and RETIRES
# ITSELF (K-1384).
#
# WHAT BROKE. json 3.0.0 was published on 2026-09-07 and removed the POSITIONAL
# options argument from JSON.parse: the signature is now
# `parse(source, on_load:, object_class:, array_class:, **options)`, so
# `JSON.parse(str, {})` raises `ArgumentError (wrong number of arguments (given
# 2, expected 1))`. activesupport 8.1.3.1 -- the NEWEST release, and the only
# line kiosk-server's gemspec allows (`~> 8.1`) -- still spells it positionally
# in `ActiveSupport::JSON.decode`, and declares `json (>= 0)` with no upper
# bound. Two Rails paths reach that call on ordinary requests:
#
#   * `ActionDispatch::Cookies::EncryptedKeyRotatingCookieJar#parse` ->
#     `MessageEncryptor#read_message` -> `Metadata#deserialize_from_json`, so
#     the session cookie cannot be read and every Devise sign-in answers 500;
#   * `ActionDispatch::Http::Parameters`' default JSON parser, so every wire
#     POST with a JSON body answers 400 instead of being executed.
#
# Neither is Kiosk code. Nothing in this repository pinned `json`, so the
# breakage arrived from the registry rather than from a commit: `e2e/run.sh`
# generates its Gemfile fresh on every run and went red on a tree nobody had
# touched, and kiosk-server's suite goes red the same way in CI, which resolves
# with no committed lockfile (measured: 1609 examples, 19 failures).
#
# WHY A GATE AND NOT A COMMENT. A pin whose removal condition lives only in a
# comment is a pin nobody removes: the condition becomes true in a release
# nobody is watching for, and the constraint outlives its reason by however long
# it takes someone to re-derive all of the above. So the condition is CHECKED.
# `rails/rails` main already spells it `::JSON.parse(json, **options)`; this
# script reads that one line out of the activesupport that is actually resolved
# here and goes RED the day a RELEASE carries the keyword-splat form -- which is
# the day the pin must come off.
#
# THE THREE ARMS.
#
#   1. PIN FORM. Every tracked file that declares `gem "json"` must spell it
#      exactly `gem "json", "< 3.0"`, and the comment block directly above it
#      must name K-1384 and state a REMOVAL CONDITION. That is the workspace
#      rule -- whatever you pin, write down what must be true for it to come
#      off -- made mechanical. Vacuity arm: at least one such declaration must
#      exist, so the day the pins are deleted without deleting this script, the
#      script says so instead of passing on an empty set.
#
#   2. REMOVAL CONDITION. The resolved activesupport's
#      `lib/active_support/json/decoding.rb` must still carry the POSITIONAL
#      call. The splat form means the pin is obsolete: RED, with instructions.
#      NEITHER form means the source moved and this arm has gone blind: also
#      RED, because a check that silently matches nothing is the failure mode
#      this workspace has recorded more than once.
#
#   3. NO LOCKFILE RESOLVES BOTH. For every tracked `Gemfile.lock`: if it
#      resolves activesupport, its resolved `json` must be < 3.0. This is what
#      covers the eight demos, which are green today ONLY because their
#      committed lockfiles predate json 3 -- the next `bundle update` in any of
#      them reddens here rather than in a 500 nobody traces back. Vacuity arm:
#      at least one lockfile must have been examined.
#
# WHAT IT DOES NOT CHECK, said plainly. It cannot tell you which UNLOCKED
# bundles ought to carry the pin, because that answer needs a resolution and a
# resolution needs the network; the three that resolve activesupport today
# (kiosk-all, kiosk-rls, kiosk-server) carry it, and any other bundle that grows
# a Rails dependency will announce itself by failing its own suite. It also says
# nothing about a consumer's app: an operator who runs `rails new` today gets a
# broken Rails 8.1 app before Kiosk is involved at all.
#
# FILE SET: `git ls-files` in this repository -- so the tracked, committed tree,
# which is the tree CI resolves. Untracked local Gemfile.lock files are NOT
# examined by arm 3 (they are not what CI sees).
#
# Usage:
#   bin/check-json-pin              # the three arms, against this repository
#   bin/check-json-pin --self-test  # fixtures: one per failure mode, plus vacuity

require "open3"
require "tmpdir"
require "fileutils"

ROOT = File.expand_path("..", __dir__)

PIN_SPELLING = 'gem "json", "< 3.0"'
PIN_DECL     = /^\s*gem\s+["']json["']\s*(?:,|$)/
ROW_ID       = "K-1384"
REMOVAL_MARK = "REMOVAL CONDITION"

POSITIONAL_CALL = "::JSON.parse(json, options)"
SPLAT_CALL      = "::JSON.parse(json, **options)"

JSON3 = Gem::Version.new("3.0.0")

# ── file set ──────────────────────────────────────────────────────────────

def tracked(root, *pathspec)
  out, err, status = Open3.capture3("git", "-C", root, "ls-files", "-z", *pathspec)
  abort "check-json-pin: git ls-files failed in #{root}: #{err.strip}" unless status.success?
  out.split("\0").reject(&:empty?)
end

# ── arm 1: the pin is spelled one way, and says why ───────────────────────

def check_pin_form(root)
  failures = []
  found    = 0

  tracked(root).each do |rel|
    path = File.join(root, rel)
    next unless File.file?(path)

    body = begin
      File.read(path, encoding: "UTF-8")
    rescue ArgumentError, Errno::EISDIR
      next
    end
    next unless body.valid_encoding?
    next unless body.match?(PIN_DECL)

    lines = body.lines
    lines.each_with_index do |line, i|
      next unless line.match?(PIN_DECL)

      found += 1
      failures << "#{rel}:#{i + 1}: declares json as #{line.strip.inspect} -- the only " \
                  "sanctioned spelling is #{PIN_SPELLING.inspect}" unless line.strip == PIN_SPELLING

      # The comment block directly above the declaration is where the reason lives.
      block = []
      j = i - 1
      while j >= 0 && lines[j].lstrip.start_with?("#")
        block.unshift(lines[j])
        j -= 1
      end
      comment = block.join

      if comment.empty?
        failures << "#{rel}:#{i + 1}: the json pin carries NO comment block -- a pin with no " \
                    "stated reason and no removal condition is a pin nobody removes (#{ROW_ID})"
        next
      end
      unless comment.include?(ROW_ID)
        failures << "#{rel}:#{i + 1}: the json pin's comment does not name #{ROW_ID}, so a reader " \
                    "cannot find what it is for"
      end
      unless comment.include?(REMOVAL_MARK)
        failures << "#{rel}:#{i + 1}: the json pin's comment states no #{REMOVAL_MARK.inspect} -- " \
                    "whatever you pin, write down what must be true for it to come off"
      end
    end
  end

  if found.zero?
    failures << "VACUITY: no tracked file declares `gem \"json\"` at all. Either the #{ROW_ID} pins " \
                "were removed without removing this script, or the pattern stopped matching them. " \
                "A check with no subject is not a passing check."
  end

  [found, failures]
end

# ── arm 2: the removal condition, read out of the resolved gem ────────────

def check_removal_condition(source, where)
  splat      = source.include?(SPLAT_CALL)
  positional = source.include?(POSITIONAL_CALL)

  return [:obsolete, "#{where}: calls #{SPLAT_CALL} -- the upstream fix has SHIPPED, so the " \
                     "#{ROW_ID} json pin's removal condition is MET. Delete `#{PIN_SPELLING}` from " \
                     "every tracked file that carries it, delete this script, and re-run the suites."] if splat
  return [:ok, "#{where}: still calls #{POSITIONAL_CALL} -- json 3 remains unreadable, pin stands"] if positional

  [:blind, "#{where}: carries NEITHER #{POSITIONAL_CALL.inspect} NOR #{SPLAT_CALL.inspect}. " \
           "ActiveSupport::JSON.decode has been rewritten into a shape this check cannot read, so " \
           "it can no longer tell you whether the pin is still needed. Re-derive it from the gem " \
           "source before trusting any green run."]
end

def resolved_activesupport
  spec = Gem::Specification.find_all_by_name("activesupport").max_by(&:version)
  return [nil, nil, nil] if spec.nil?

  path = File.join(spec.gem_dir, "lib", "active_support", "json", "decoding.rb")
  return [spec, path, nil] unless File.file?(path)

  [spec, path, File.read(path)]
end

# ── arm 3: no committed lockfile resolves activesupport beside json 3 ─────

def lock_versions(body)
  # The `GEM > specs:` section indents a resolved gem by four spaces; its
  # dependencies get six. Anchoring on exactly four is what keeps a dependency
  # LINE (`      json (>= 2.3)`) from being read as a resolution.
  resolved = {}
  body.each_line do |line|
    m = /\A {4}([A-Za-z0-9_.-]+) \(([^)<>=~! ]+)\)\s*\z/.match(line)
    next unless m

    resolved[m[1]] ||= m[2]
  end
  resolved
end

def check_locks(root)
  failures = []
  examined = 0

  tracked(root, "*Gemfile.lock").each do |rel|
    body = File.read(File.join(root, rel))
    versions = lock_versions(body)
    next unless versions.key?("activesupport")

    examined += 1
    json = versions["json"]
    next if json.nil?

    next if Gem::Version.new(json) < JSON3

    failures << "#{rel}: resolves json #{json} beside activesupport #{versions['activesupport']} -- " \
                "that pair cannot read an encrypted cookie or a JSON request body (#{ROW_ID}). " \
                "Re-lock with `bundle update json --conservative` or add the pin to its Gemfile."
  end

  if examined.zero?
    failures << "VACUITY: no tracked Gemfile.lock resolves activesupport, so this arm compared " \
                "nothing. Either the lockfiles are gone or the parser stopped reading them."
  end

  [examined, failures]
end

# ── the run ───────────────────────────────────────────────────────────────

def run(root)
  failures = []

  found, pin_failures = check_pin_form(root)
  failures.concat(pin_failures)
  puts "  pin form        : #{found} `gem \"json\"` declaration(s) in the tracked tree"

  spec, path, source = resolved_activesupport
  if spec.nil?
    failures << "no activesupport is installed here, so the pin's REMOVAL CONDITION could not be " \
                "checked. This arm is not skippable -- a skip is how a pin outlives its reason. " \
                "Run this from a bundle that resolves activesupport (`cd kiosk-server && bundle " \
                "install && bundle exec ../bin/check-json-pin`)."
  elsif source.nil?
    failures << "activesupport #{spec.version} has no lib/active_support/json/decoding.rb " \
                "(looked at #{path}) -- the file this arm reads has moved."
  else
    verdict, message = check_removal_condition(source, "activesupport #{spec.version}")
    puts "  removal condition: #{message}"
    failures << message unless verdict == :ok
  end

  examined, lock_failures = check_locks(root)
  failures.concat(lock_failures)
  puts "  lockfiles       : #{examined} tracked lockfile(s) resolve activesupport"

  failures
end

# ── self-test ─────────────────────────────────────────────────────────────

def fixture_repo(files)
  dir = Dir.mktmpdir("check-json-pin-selftest")
  files.each do |rel, body|
    full = File.join(dir, rel)
    FileUtils.mkdir_p(File.dirname(full))
    File.write(full, body)
  end
  _o, e, st = Open3.capture3("git", "-C", dir, "init", "-q")
  raise "git init failed: #{e}" unless st.success?

  _o, e, st = Open3.capture3("git", "-C", dir, "add", "-A")
  raise "git add failed: #{e}" unless st.success?

  dir
end

GOOD_COMMENT = <<~TEXT
  # K-1384 -- json 3.0.0 dropped the positional options argument.
  # REMOVAL CONDITION: a released activesupport spelling it with a keyword splat.
TEXT

GOOD_LOCK = <<~TEXT
  GEM
    remote: https://rubygems.org/
    specs:
      activesupport (8.1.3.1)
        json (>= 0)
      json (2.20.0)
TEXT

def self_test
  results = []
  check = lambda do |name, condition|
    results << [name, condition]
    puts format("  %-4s %s", condition ? "ok" : "FAIL", name)
  end

  # arm 1 --------------------------------------------------------------
  dir = fixture_repo("Gemfile" => "#{GOOD_COMMENT}gem \"json\", \"< 3.0\"\n")
  found, f = check_pin_form(dir)
  check.call("arm1: a correctly spelled, explained pin passes", found == 1 && f.empty?)
  FileUtils.remove_entry(dir)

  dir = fixture_repo("Gemfile" => "#{GOOD_COMMENT}gem \"json\", \"< 4.0\"\n")
  _n, f = check_pin_form(dir)
  check.call("arm1: a DIFFERENT constraint fails", f.any? { |m| m.include?("sanctioned spelling") })
  FileUtils.remove_entry(dir)

  dir = fixture_repo("Gemfile" => "gem \"json\", \"< 3.0\"\n")
  _n, f = check_pin_form(dir)
  check.call("arm1: a pin with NO comment fails", f.any? { |m| m.include?("NO comment block") })
  FileUtils.remove_entry(dir)

  dir = fixture_repo("Gemfile" => "# a pin.\n# REMOVAL CONDITION: someday.\ngem \"json\", \"< 3.0\"\n")
  _n, f = check_pin_form(dir)
  check.call("arm1: a comment that does not name the row fails", f.any? { |m| m.include?("does not name") })
  FileUtils.remove_entry(dir)

  dir = fixture_repo("Gemfile" => "# K-1384 -- because.\ngem \"json\", \"< 3.0\"\n")
  _n, f = check_pin_form(dir)
  check.call("arm1: a comment with no removal condition fails", f.any? { |m| m.include?("REMOVAL CONDITION") })
  FileUtils.remove_entry(dir)

  dir = fixture_repo("Gemfile" => "gem \"json_schemer\"\n")
  found, f = check_pin_form(dir)
  check.call("arm1: `gem \"json_schemer\"` is NOT read as a json pin",
             found.zero? && f.any? { |m| m.start_with?("VACUITY") })
  FileUtils.remove_entry(dir)

  # arm 2 --------------------------------------------------------------
  verdict, = check_removal_condition("data = #{POSITIONAL_CALL}\n", "fixture")
  check.call("arm2: the positional call keeps the pin", verdict == :ok)

  verdict, message = check_removal_condition("data = #{SPLAT_CALL}\n", "fixture")
  check.call("arm2: the splat call fails, naming the removal",
             verdict == :obsolete && message.include?("removal condition is MET"))

  verdict, message = check_removal_condition("data = JSON.load(json)\n", "fixture")
  check.call("arm2: neither call fails as BLIND, not as ok",
             verdict == :blind && message.include?("can no longer tell you"))

  # arm 3 --------------------------------------------------------------
  dir = fixture_repo("demo/Gemfile.lock" => GOOD_LOCK)
  examined, f = check_locks(dir)
  check.call("arm3: a lock at json 2.x passes", examined == 1 && f.empty?)
  FileUtils.remove_entry(dir)

  dir = fixture_repo("demo/Gemfile.lock" => GOOD_LOCK.sub("json (2.20.0)", "json (3.0.0)"))
  _n, f = check_locks(dir)
  check.call("arm3: a lock at json 3.0.0 beside activesupport fails",
             f.any? { |m| m.include?("resolves json 3.0.0") })
  FileUtils.remove_entry(dir)

  dir = fixture_repo("demo/Gemfile.lock" => "GEM\n  specs:\n    rake (13.4.2)\n")
  examined, f = check_locks(dir)
  check.call("arm3: a lock with no activesupport is not examined, and the empty set is VACUOUS",
             examined.zero? && f.any? { |m| m.start_with?("VACUITY") })
  FileUtils.remove_entry(dir)

  dir = fixture_repo(
    "demo/Gemfile.lock" => "GEM\n  specs:\n    activesupport (8.1.3.1)\n      json (>= 3.0)\n    json (2.20.0)\n"
  )
  _n, f = check_locks(dir)
  check.call("arm3: a six-space DEPENDENCY line is not read as a resolution", f.empty?)
  FileUtils.remove_entry(dir)

  # vacuity of the live tree -------------------------------------------
  found, = check_pin_form(ROOT)
  check.call("live: this repository still carries at least one json pin", found.positive?)
  examined, = check_locks(ROOT)
  check.call("live: this repository still has lockfiles resolving activesupport", examined.positive?)

  failed = results.count { |_n, ok| !ok }
  puts
  puts "#{results.length} arms, #{failed} failed"
  failed.zero?
end

# ── main ──────────────────────────────────────────────────────────────────

if ARGV.include?("--self-test")
  puts "check-json-pin --self-test"
  exit(self_test ? 0 : 1)
end

puts "check-json-pin (#{ROW_ID}) -- the json < 3.0 pin"
failures = run(ROOT)

if failures.empty?
  puts
  puts "PASS: the pin is spelled one way, says why, still has its reason, and no committed " \
       "lockfile resolves json 3 beside activesupport."
  exit 0
end

puts
puts "FAIL (#{failures.length}):"
failures.each { |m| puts "  - #{m}" }
exit 1
