#!/usr/bin/env ruby
# frozen_string_literal: true

# check-redteam-headers -- a demo's PROSE restatements of its red-team beat list,
# diffed against the beats that demo's suite actually registers (T-078, T-105).
#
# WHY IT EXISTS, from what happened rather than from principle. K-709 and K-710
# were this defect twice: six driver headers told the reader registration carried
# no PoW while each solved one a few dozen lines below, and five redteam-suite
# headers disagreed with the scenarios beneath them -- stylish's naming a beat
# that did not exist and omitting three that did. Both were fixed by hand
# (0e5087a, 59bdac7, 5e4151f), and the class came back TWICE more: philslist's
# two wire-shape beats arrived with the per-verb cutover and the header
# was never updated (K-901), and the 2026-08-26 wave found a `verified` K-710
# carrying a verification sentence that had itself gone false. Every one of those
# repairs was a hand-kept list corrected by hand, and every gate stayed green
# throughout, because nothing in this repository reads a beat name in prose.
#
# THE COMPARISON INPUT IS A FOURTH PAIR, WHICH IS WHY THIS IS A SIBLING SCRIPT.
# bin/check-demo-derivations states the boundary the guards in this directory are
# divided on -- «the boundary is the comparison INPUT» -- and names the three that
# existed: bin/check-ci-tasks compares ci.yml against each demo's rake tasks,
# bin/check-demo-copies compares demo files against EACH OTHER, and it itself
# compares a demo's before-after.md against that demo's own producers. This one
# compares a demo's redteam PROSE -- the suite header, the `demo:redteam` rake
# `desc`, the README battery section -- against that demo's own suite
# REGISTRATIONS. It was not folded into check-demo-derivations because that file
# is bound to one document (`DOC = "before-after.md"`) and to one carrier (a
# fenced block with an HTML `<!-- derived: ... -->` comment above it); a Ruby
# comment header and a heredoc `desc` can carry neither, so folding it in would
# mean a second parser and a second corpus inside a file whose name and header
# are about narrative derivation.
#
# ── WHAT IS DERIVED AND WHAT IS DECLARED ─────────────────────────────────────
#
# The beat set is DERIVED once per demo, from the suite, and every rule below
# compares a document against THAT. There is no list of beat names in this file
# and there must never be one: a hand-kept inventory is the thing this guard
# exists to replace. The demo set is derived too -- `kiosk-demo-*/script/
# redteam_suite.rb` by glob -- so an eighth demo that grows a suite is covered
# with no edit here.
#
# THE REGISTRATION VOCABULARY IS THE GEM'S, AND THE EXTRACTORS READ THAT. Every
# suite builds one `Kiosk::Redteam::Battery` and every beat it runs is registered
# on it, so the battery's own receiver name is derived per file first and the
# rules below hang off it. A suite with no battery is a LOUD failure rather than
# a short list quietly compared to a short list, and so is a registration in a
# form none of these four reads:
#
#   E1  the framework registry -- entries of the top-level `scenarios = [...]`,
#       driven through the gem's `Runner` and `absorb`ed into the battery
#   E2  a hand-written beat -- `<battery>.record("Name", ...)`
#   E3  a library scenario run straight from the battery --
#       `<battery>.scenario(...::Name.new, ...)`
#   E4  a table of locally-built beats fed to the battery in one pass --
#       the string keys of the hash literal `.each`ed into `<battery>.record`
#
# E2, E3 and E4 replaced a `record(results, ...)` trio when T-188 lifted the
# harness into `kiosk-redteam`: the beat names had moved from a local helper's
# arguments onto the gem's ledger, and the extractors that could no longer see
# them retire here with the helper they were written for.
#
# ── THE RULES, AND WHICH KIND EACH ONE IS ────────────────────────────────────
#
# R1  ENUMERATION (derivation). Every suite yields a non-empty beat set through
#     the extractors above, and every registration on its battery and every
#     `scenarios = [...]` entry is in a form one of them reads. UNPARSEABLE IS
#     RED: a beat this guard cannot see is a beat no rule below can protect.
#
# R2  HEADER COVERAGE (coverage). A suite header that DECLARES its list complete
#     -- the literal «each must be BLOCKED», which is the files' own existing
#     wording and not a marker invented here -- must name every registered beat.
#     Headers that say «Headline scenarios» instead are a selection by their own
#     words and are not held to this.
#
# R3  HEADER NAMES ARE REAL (ban). Every list ENTRY in any suite header -- the
#     `#   Name  — gloss` shape -- must be a registered beat. This is the arm
#     that would have caught stylish's `CustomerCannotSelfSelectOwnerAtBinding`,
#     a scenario the header named and the file did not have.
#
# R4  DESC COVERAGE (coverage). Every registered beat is named somewhere in that
#     demo's `demo:redteam` rake `desc`. Text, not table: tudu writes its list as
#     a prose sentence and the other six as a `BLOCKED  Name` column, and the
#     rule holds for both because it asks only whether the name is there.
#
# R5  DESC NAMES ARE REAL (ban). Every `BLOCKED|SKIPPED|BREACH  Name` entry in a
#     `demo:redteam` desc must be a registered beat.
#
# R6  README COVERAGE (coverage). A README section headed for the battery --
#     a heading whose text matches /redteam|adversarial/i -- must name every
#     registered beat. The SCOPE IS DERIVED FROM THE HEADING, not from a list in
#     this file: at the time of writing exactly two READMEs carry one, and a
#     third that grows one is covered without an edit.
#
# R7  STATUS AGREEMENT (derivation). A restatement may not attribute an HTTP
#     status to a beat that the beat's OWN assertion code does not name. The
#     beat SET is already derived; this derives each beat's STATUS SET too, from
#     wherever that beat is implemented -- a scenario class in the suite, an
#     inline `record` call, an entry of a locally-built beat table, or the gem's
#     `Kiosk::Redteam::Scenarios::<Name>` file -- and holds all three
#     restatements to it: the suite header, the `demo:redteam` desc and the
#     README battery section. A registered beat whose implementation this guard
#     cannot FIND is red for R1's reason: an unlocatable beat is one whose prose
#     nothing here checks.
#
#     THIS IS THE RULE K-1482 ASKED FOR, and what it missed is worth writing
#     down. For the whole life of the K-1418 change, four demos' `demo:redteam`
#     descs promised `405 method_not_allowed with Allow:` and `401 without a
#     bearer` for two beats whose suites had already moved to the plain 404 --
#     and R1..R6, which own exactly those two files, stayed green throughout,
#     because every rule above asks only whether a NAME is present. The names
#     were never what rotted.
#
#     A beat that delegates its verdict to `verdict_from` with no explicit
#     `expect:` asserts the gem's own definition of a refusal, so its status set
#     is `Kiosk::Redteam::BLOCKED_STATUSES` -- READ OUT OF THE GEM, not written
#     down here. That is why hoteling and skooti may say a tampered cart is
#     «→ 403» while getgrocery says only «rejected»: both are true of the same
#     assertion, and R7 knows it because it read the constant.
#
# LISTS, NEVER COUNTS. The 2026-08-26 wave that last repaired this class DELETED
# the totals from two rake descs rather than correcting them, on the ground that
# both suites print their count at runtime, so a count in a `desc` is redundant
# and independently rottable. This guard therefore diffs SETS OF NAMES and never
# compares a number to a number.
#
# ── WHAT IT DOES NOT COVER, stated plainly ───────────────────────────────────
#
# * A README naming a beat that does not exist. R3 and R5 hold that direction for
#   the two sites where the class actually occurred; doing it for a README needs
#   CamelCase-token classification over free-form Markdown, which is a heuristic,
#   and a heuristic that misfires here gets switched off rather than fixed.
# * Whether a beat's GLOSS is true. Every rule here is about a NAME being present
#   or absent. A header entry that names a real beat and describes the wrong
#   attack is invisible to this file, and always will be.
# * The FLOW drivers' sibling class (K-707's hardcoded literals, K-711's
#   independently declared paths), which T-078 records as not mechanically
#   checkable the same way and which stays a fix rather than a guard.
# * Whether the status a beat ASSERTS is the RIGHT one. R7 holds the prose to
#   the assertion, never the assertion to the spec: a beat that asserts 403
#   where the wire says 409 is green here and always will be.
# * A DENIED status. «never a 500» is a claim about what does NOT happen, so the
#   beat's own assertion cannot contain it by construction. R7 reads the words
#   IMMEDIATELY before the number and exempts those mentions instead of
#   demanding they be backed, so a wrong denial is invisible. The cue is
#   deliberately adjacent-only: «no route draws them: the ordinary 404» denies
#   nothing, and a wider window would read it as a denial and stop checking the
#   one number in that sentence that matters.
# * The permissiveness of R7's oracle. A beat's status set is every
#   status-shaped literal in its implementation -- including one that is a
#   quantity rather than a status, and including a branch the beat never takes.
#   That direction is chosen: an over-wide oracle lets a stale sentence through,
#   a too-narrow one reddens a true one, and only the second kind of failure
#   gets a guard switched off.
#
# ── IN-BAND VACUITY, and the polarity is deliberate (K-1262) ─────────────────
#
# Two of the six rules are BANS, and for a ban «this rule matched something» is
# backwards: a ban whose violations match nothing is the ban being OBEYED. So
# their liveness is asserted on the DECLARATIONS instead -- on the extractors
# still finding entries to judge. Every run reports, and fails on:
#
#   * a demo whose derived beat set is empty (R1)
#   * no header anywhere declaring «each must be BLOCKED» (R2 would cover nothing)
#   * zero header list entries across the fleet (R3 could not bite)
#   * a demo whose suite header carries NO list entries at all — R2 and R3 read
#     that one list, so neither says anything about that demo, while the
#     fleet-wide count above stays satisfied by the demos that do carry one
#     (R2/R3-vacuity). Asked PER DEMO off the suite glob, for the same reason
#     R7's is: a vacuity arm whose UNIT is the corpus rather than the member
#     reads as coverage of every member, which is the K-1213 shape one level up.
#   * zero desc entries across the fleet (R5 could not bite)
#   * a README battery section that names fewer than three beats (R6's scope
#     detector has found a heading over something that is not a beat list)
#   * a demo none of whose three restatements names a single checkable HTTP
#     status -- R7 is covering nothing THERE (R7-vacuity). The set of demos is
#     the suite glob, never a list in this file, so an eighth demo is held to
#     this without an edit here and a demo that stops naming statuses says so
#     instead of going quiet. That polarity is the K-1213 lesson, paid for again
#     when bin/check-demo-prereqs' hand-listed arm stopped draining its corpus
#     the moment two demos grew a task.
#   * a registered beat whose implementation this guard cannot find at all
#     (R7-locate), and a `BLOCKED_STATUSES` it can no longer read out of the gem
#
# A README that names at least half the suite's beats WITHOUT carrying such a
# heading is REPORTED, not failed: that is the shape of a beat list whose heading
# was renamed out of the rule's reach, and printing it is how the derived scope
# is stopped from silently shrinking.
#
# Usage:
#   bin/check-redteam-headers              # exit 1 on any mismatch
#   bin/check-redteam-headers --list       # print each demo's derived beat set
#   bin/check-redteam-headers --self-test  # fixtures: every rule, red and green
#                                          # (R7's arms, and R2/R3's per-demo
#                                          #  vacuity arm, are derived from the
#                                          #  suite glob rather than listed)

require "fileutils"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)

# ── Extraction ───────────────────────────────────────────────────────────────

# The battery's receiver name, derived per file: every rule is about what is
# registered ON it, so a suite that builds none registers nothing readable.
def battery_name(src)
  src[/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*Kiosk::Redteam::Battery\.new/, 1]
end

# E1 + E2 + E3 + E4. Returns [names, problems]; `problems` is R1's loud half.
def suite_beats(src)
  names    = []
  problems = []

  battery = battery_name(src)
  unless battery
    problems << "no `<name> = Kiosk::Redteam::Battery.new` — the gem's ledger is where every beat " \
                "registers, so this guard can read no beat off this suite at all"
  end
  recv = battery && Regexp.escape(battery)

  # E1 — the framework registry.
  if (m = src.match(/^scenarios = \[\n(.*?)^\]\s*$/m))
    m[1].lines.each do |line|
      body = line.split("#", 2).first.to_s.strip
      next if body.empty?

      if (e = body.match(/\A(?:[A-Z][A-Za-z0-9]*::)*([A-Z][A-Za-z0-9]*)\.new\b/))
        names << e[1]
      else
        problems << "an entry of `scenarios = [...]` is not a `Name.new` this guard can read: #{body.inspect}"
      end
    end
  end

  return [names.uniq.sort, problems] unless recv

  # E4 — a table of locally-built beats registered in one pass. The names live in
  # the hash literal's keys; the `record` call beneath it names only the block
  # parameter, so it is read HERE and the parameter is remembered so E2 does not
  # report it as unresolvable.
  table_params = []
  src.scan(/^\{\n((?:^[ \t]*"[A-Za-z0-9]+"[ \t]*=>.*\n)+)^\}\.each\s*(?:\{|do)\s*\|(\w+),\s*\w+\|\s*
           #{recv}\.record\(\s*\k<2>\s*,/xm) do |(rows, param)|
    rows.scan(/"([A-Za-z0-9]+)"[ \t]*=>/) { names << Regexp.last_match(1) }
    table_params << param
  end

  # E3 — a library scenario run straight from the battery.
  src.scan(/#{recv}\.scenario\(\s*(?:[A-Z][A-Za-z0-9]*::)*([A-Z][A-Za-z0-9]*)\.new\b/m) do |(name)|
    names << name
  end
  src.scan(/#{recv}\.scenario\(\s*([^\n,)]{0,80})/m) do |(arg)|
    arg = arg.strip
    next if arg.match?(/\A(?:[A-Z][A-Za-z0-9]*::)*[A-Z][A-Za-z0-9]*\.new\b/)

    problems << "`#{battery}.scenario(#{arg.inspect}, ...)` does not open with a `Name.new` this guard " \
                "can read — this beat cannot be enumerated, so no rule here protects it"
  end

  # E2 — a hand-written beat on the battery's ledger.
  src.scan(/#{recv}\.record\(\s*(.{0,80}?)[,\n]/m) do |(arg)|
    arg = arg.strip
    if (lit = arg.match(/\A"([A-Za-z0-9]+)"\z/))
      names << lit[1]
    elsif table_params.include?(arg)
      next # already enumerated by E4, off the hash literal that feeds this call
    else
      problems << "`#{battery}.record(#{arg.inspect}, ...)` is neither a string literal nor the block " \
                  "parameter of a beat table this guard can read — this beat cannot be enumerated, so " \
                  "no rule here protects it"
    end
  end

  [names.uniq.sort, problems]
end

# A document NAMES a beat when the name stands on its own: `include?` would let
# a renamed `CrossOwnerEditt` satisfy a rule about `CrossOwnerEdit`, which is the
# rename case K-710 recorded twice.
def mentions?(text, name)
  text.match?(/(?<![A-Za-z0-9_])#{Regexp.escape(name)}(?![A-Za-z0-9_])/)
end

# The leading comment block: every line from the top that is a comment or blank,
# stopping at the first line of code.
def header_block(src)
  out = []
  src.lines.each do |l|
    break unless l.start_with?("#") || l.strip.empty?

    out << l
  end
  out.join
end

# A header LIST ENTRY: `#   Name  — gloss`, optionally behind the `C2`-style tag
# hoteling and skooti put on their headline beats.
def header_entries(header)
  header.scan(/^#\s{2,}(?:C\d+\s+)?([A-Z][A-Za-z0-9]{3,})[ \t]*(?:\(.*?\))?[ \t]*(?:—|–|-{1,2})[ \t]/).flatten.uniq
end

# The `desc` heredoc that belongs to `task redteam:` — the LAST one before it.
def redteam_desc(rake_src)
  i = rake_src.index(/^\s*task redteam[: ]/)
  return nil unless i

  body = nil
  rake_src[0...i].scan(/desc <<~(\w+)\n(.*?)\n[ \t]*\1[ \t]*$/m) { body = Regexp.last_match(2) }
  body
end

def desc_entries(desc)
  desc.scan(/^\s*(?:BLOCKED|SKIPPED|BREACH)\s+([A-Z][A-Za-z0-9]{3,})\b/).flatten.uniq
end

# The README's battery section: a heading naming the red team, up to the next
# heading at the same or a higher level.
def readme_battery_section(md)
  lines = md.lines
  start = lines.index { |l| l =~ /\A(\#{1,6})\s.*(redteam|adversarial)/i }
  return nil unless start

  level = lines[start][/\A\#+/].length
  body  = []
  lines[(start + 1)..].each do |l|
    break if l =~ /\A(\#{1,6})\s/ && Regexp.last_match(1).length <= level

    body << l
  end
  body.join
end

# ── R7: statuses, derived from the beat's own assertion code ─────────────────

# The status codes the wire can carry. A whitelist of the PROTOCOL rather than
# of this corpus: it decides which three-digit numbers count as statuses at all,
# so a port number or a cents amount is not read as one.
HTTP_STATUSES = %w[100 101 200 201 202 204 206 301 302 303 304 307 308 400 401
                   402 403 404 405 406 409 410 412 415 422 423 425 428 429 500
                   501 502 503 504].freeze

# A three-digit number standing on its own — not part of a version, a decimal,
# a date or a path.
STATUS_TOKEN = %r{(?<![\d./-])(\d{3})(?![\d./-])}

# A DENIAL — the words IMMEDIATELY before the number say this status is what
# does not happen («never a 500», «not 201»). Adjacent-only on purpose: see the
# «what it does not cover» note above.
DENIAL          = /(?:\bnever|\bnot)\s+(?:an?\s+|the\s+)?(?:[a-z]+\s+)?\z/i
CURRENCY_BEFORE = /[€$£¥]\s*\z/
UNIT_AFTER      = /\A\s*(?:ms|kb|mb|cents?|bytes?|chars?|characters?|columns?|lines?|px|items?)\b/i

# Every status a piece of PROSE asserts.
def asserted_statuses(text)
  flat = text.gsub(/\s+/, " ")
  out  = []
  flat.to_enum(:scan, STATUS_TOKEN).each do
    m = Regexp.last_match
    next unless HTTP_STATUSES.include?(m[1])

    pre  = flat[[0, m.begin(0) - 40].max...m.begin(0)]
    post = flat[m.end(0), 16].to_s
    next if pre =~ DENIAL || pre =~ CURRENCY_BEFORE || post =~ UNIT_AFTER

    out << m[1]
  end
  out.uniq.sort
end

# Every status a piece of CODE names. Comments go first: a comment is prose, and
# prose is the thing being checked — letting it into the oracle would let a
# stale sentence vouch for itself.
def code_statuses(code)
  code.lines.reject { _1 =~ /\A\s*#/ }.join
      .scan(STATUS_TOKEN).flatten
      .select { HTTP_STATUSES.include?(_1) }.uniq.sort
end

# `Kiosk::Redteam.blocked?` is the gem's own definition of a refusal, and a beat
# that delegates to `verdict_from` with no explicit `expect:` asserts exactly
# that. Read out of the gem so this file holds no copy of it.
def blocked_statuses(root)
  path = File.join(root, "kiosk-redteam", "lib", "kiosk", "redteam.rb")
  return nil unless File.exist?(path)

  list = File.read(path)[/^\s*BLOCKED_STATUSES\s*=\s*\[([^\]]*)\]/, 1]
  list&.scan(/\d{3}/)
end

def snake_case(name)
  name.gsub(/([a-z0-9])([A-Z])/) { "#{Regexp.last_match(1)}_#{Regexp.last_match(2)}" }
      .gsub(/([A-Z]+)([A-Z][a-z])/) { "#{Regexp.last_match(1)}_#{Regexp.last_match(2)}" }
      .downcase
end

# The offset of the `)` closing the `(` at `open`.
def balanced_paren(src, open)
  depth = 0
  i     = open
  while i < src.length
    depth += 1 if src[i] == "("
    if src[i] == ")"
      depth -= 1
      return i if depth.zero?
    end
    i += 1
  end
  src.length - 1
end

# WHERE A BEAT IS IMPLEMENTED — the four registration shapes above, walked in
# the other direction. A LOCAL implementation always wins over the gem's: tudu
# records its own `CrossTenantRead` inline and the gem ships one too, and the
# beat that RUNS is the local one. Returns [kind, source] or [nil, nil].
def beat_code(root, src, name, battery)
  esc = Regexp.escape(name)

  # (a) a scenario class defined in the suite itself
  return ["class", Regexp.last_match(1)] if src =~ /^class #{esc} < .*?\n(.*?)^end\b/m

  # (b) a locally-built beat fed to the battery through a table: the table names
  #     a local, the local is what calling a lambda returned, the lambda is the
  #     beat. Two hops, both spelled one way in the one suite that does it.
  if (m = src.match(/"#{esc}"\s*=>\s*(\w+)/)) &&
     (a = src.match(/^#{Regexp.escape(m[1])}\s*=\s*(\w+)\.call\b/)) &&
     (b = src.match(/^#{Regexp.escape(a[1])}\s*=\s*(?:lambda|proc) do\b(.*?)^end\b/m))
    return ["table", b[1]]
  end

  # (c) an inline `record`. The beat is the code that RAN to produce the verdict
  #     argument, so the span reaches back to the previous registration.
  if battery && (m = src.match(/#{Regexp.escape(battery)}\.record\(\s*"#{esc}"/))
    call_end = balanced_paren(src, src.index("(", m.begin(0)))
    prev     = 0
    src.to_enum(:scan, /#{Regexp.escape(battery)}\.(?:record|scenario)\(/).each do
      earlier = Regexp.last_match
      break if earlier.begin(0) >= m.begin(0)

      prev = balanced_paren(src, src.index("(", earlier.begin(0)))
    end
    return ["inline", src[prev..call_end]]
  end

  # (d) the gem's shared library scenario
  gem = File.join(root, "kiosk-redteam", "lib", "kiosk", "redteam", "scenarios", "#{snake_case(name)}.rb")
  return ["gem", File.read(gem)] if File.exist?(gem)

  [nil, nil]
end

# THE TEXT A RESTATEMENT ATTRIBUTES TO ONE BEAT. Two shapes, both read off the
# documents rather than declared here: an ENTRY opening with the beat's name and
# running to the next entry or the next unindented line (the desc's
# `BLOCKED  Name — …` column, the header's `Name — …` list), and a PARENTHETICAL
# opening straight after the name (`MalformedUuidArg (400)`), which is how
# tudu's prose desc and both battery READMEs write theirs.
DESC_ENTRY   = /^\s*(?:BLOCKED|SKIPPED|BREACH)\s+([A-Z][A-Za-z0-9]{3,})\b(.*)$/
HEADER_ENTRY = /^\s{2,}(?:C\d+\s+)?([A-Z][A-Za-z0-9]{3,})[ \t]*(?:\(.*?\))?[ \t]*(?:—|–|-{1,2})[ \t](.*)$/
NO_ENTRY     = /(?!)/ # the README is flowing prose: parentheticals only

def attributed(text, beats, entry_re)
  out = Hash.new { |h, k| h[k] = +"" }
  cur = nil
  text.lines.each do |line|
    if (m = line.match(entry_re))
      cur = m[1]
      out[cur] << m[2].to_s << "\n"
    elsif cur
      if line.strip.empty? || line !~ /\A[ \t]{2,}\S/
        cur = nil
      else
        out[cur] << line
      end
    end
  end
  beats.each do |name|
    text.to_enum(:scan, /(?<![A-Za-z0-9_])#{Regexp.escape(name)}`?(?![A-Za-z0-9_])[ \t\n]*\(/).each do
      m    = Regexp.last_match
      open = text.index("(", m.begin(0))
      out[name] << text[open..balanced_paren(text, open)] << "\n"
    end
  end
  out
end

# ── The check ────────────────────────────────────────────────────────────────

Report = Struct.new(:failures, :notes, :stats, keyword_init: true)

def check(root)
  failures = []
  notes    = []
  stats    = []

  suites = Dir.glob(File.join(root, "kiosk-demo-*", "script", "redteam_suite.rb")).sort
  if suites.empty?
    failures << "no kiosk-demo-*/script/redteam_suite.rb found under #{root} — this guard is reading nothing"
    return Report.new(failures:, notes:, stats:)
  end

  declaring_headers = 0
  header_entry_total = 0
  header_entries_by_demo = {}
  desc_entry_total   = 0
  readme_sections    = 0
  r7_checked         = {}

  # R7's oracle for every beat that delegates its verdict to the gem.
  blocked = blocked_statuses(root)
  if blocked.nil? || blocked.empty?
    failures << "kiosk-redteam's BLOCKED_STATUSES could not be read — every beat that delegates to " \
                "`verdict_from` with no explicit `expect:` has lost its status oracle, so R7 would " \
                "redden true sentences instead of stale ones [R7-locate]"
    blocked = []
  end

  suites.each do |suite_path|
    dir  = File.dirname(File.dirname(suite_path))
    demo = File.basename(dir)
    src  = File.read(suite_path)

    beats, problems = suite_beats(src)
    problems.each { failures << "#{demo}: #{_1} [R1]" }
    if beats.empty?
      failures << "#{demo}: no beat name could be derived from script/redteam_suite.rb — the extractors " \
                  "read nothing, so every rule below would pass on an empty set [R1]"
      next
    end

    header  = header_block(src)
    entries = header_entries(header)
    header_entry_total += entries.length
    header_entries_by_demo[demo] = entries.length

    # R3 — a header may not name a beat the suite does not register.
    (entries - beats).each do |ghost|
      failures << "#{demo}: script/redteam_suite.rb's header lists #{ghost}, which the file does not " \
                  "register — the header names a beat that does not run [R3]"
    end

    # R2 — a header that declares its list complete must be complete.
    if header.include?("each must be BLOCKED")
      declaring_headers += 1
      missing = beats.reject { mentions?(header, _1) }
      unless missing.empty?
        failures << "#{demo}: script/redteam_suite.rb's header says «each must be BLOCKED» and does not " \
                    "name #{missing.join(', ')} — a reader of that list does not learn the beat runs [R2]"
      end
    end

    rake_path = File.join(dir, "lib", "tasks", "demo.rake")
    unless File.exist?(rake_path)
      failures << "#{demo}: has script/redteam_suite.rb but no lib/tasks/demo.rake [R4]"
      next
    end

    desc = redteam_desc(File.read(rake_path))
    if desc.nil?
      failures << "#{demo}: lib/tasks/demo.rake has no `desc` heredoc before `task redteam:` — the second " \
                  "copy of the beat list is unreadable, so nothing holds it [R4]"
    else
      d_entries = desc_entries(desc)
      desc_entry_total += d_entries.length

      # R5 — the desc may not name a beat the suite does not register.
      (d_entries - beats).each do |ghost|
        failures << "#{demo}: demo:redteam's desc lists #{ghost}, which script/redteam_suite.rb does not " \
                    "register [R5]"
      end

      # R4 — every registered beat is named in the desc.
      d_missing = beats.reject { mentions?(desc, _1) }
      unless d_missing.empty?
        failures << "#{demo}: demo:redteam's desc does not name #{d_missing.join(', ')} — an operator " \
                    "reading `rake -D` is told a smaller battery runs than does [R4]"
      end
    end

    readme_path = File.join(dir, "README.md")
    section = File.exist?(readme_path) ? readme_battery_section(File.read(readme_path)) : nil
    named   = section ? beats.count { mentions?(section, _1) } : 0
    if section
      readme_sections += 1
      if named < 3
        failures << "#{demo}: README.md has a battery heading whose section names #{named} beat(s) — the " \
                    "heading has been put over something that is not a beat list, so R6 is watching " \
                    "nothing here [R6-vacuity]"
      else
        r_missing = beats.reject { mentions?(section, _1) }
        unless r_missing.empty?
          failures << "#{demo}: README.md's battery section does not name #{r_missing.join(', ')} [R6]"
        end
      end
    elsif File.exist?(readme_path)
      whole = File.read(readme_path)
      hits  = beats.count { mentions?(whole, _1) }
      if hits * 2 >= beats.length
        notes << "#{demo}: README.md names #{hits} of #{beats.length} beats but carries no battery heading, " \
                 "so R6 does not reach it — a heading matching /redteam¦adversarial/i would put it back in scope"
      end
    end

    # R7 — STATUS AGREEMENT. Every status a restatement attributes to a beat
    # must be one that beat's own assertion code names. Three surfaces, one
    # oracle, and the oracle is CODE.
    surfaces = {
      "script/redteam_suite.rb's header" => attributed(header.gsub(/^#[ \t]?/, ""), beats, HEADER_ENTRY),
      "demo:redteam's desc"              => attributed(desc.to_s, beats, DESC_ENTRY),
      "README.md's battery section"      => attributed(section.to_s, beats, NO_ENTRY),
    }
    r7_checked[demo] ||= 0
    battery = battery_name(src)
    beats.each do |beat|
      kind, code = beat_code(root, src, beat, battery)
      if kind.nil?
        failures << "#{demo}: #{beat} is registered but this guard cannot find where it is IMPLEMENTED — " \
                    "not a scenario class in the suite, not a beat table entry, not an inline record, and " \
                    "no kiosk-redteam/lib/kiosk/redteam/scenarios/#{snake_case(beat)}.rb — so nothing " \
                    "checks what its prose promises [R7-locate]"
        next
      end

      asserts = code_statuses(code)
      asserts |= blocked if code.match?(/verdict_from\(/) && !code.match?(/expect(?:_code)?:/)

      surfaces.each do |where, table|
        said = asserted_statuses(table[beat].to_s)
        r7_checked[demo] += said.length
        (said - asserts).each do |ghost|
          failures << "#{demo}: #{where} says #{beat} answers #{ghost}, and nothing in that beat's own " \
                      "#{kind} assertion names it (it asserts " \
                      "#{asserts.empty? ? 'no status at all' : asserts.join('/')}) — the prose describes " \
                      "a refusal the suite does not check for [R7]"
        end
      end
    end

    stats << format("  %-24s beats %2d  header-entries %2d%s  desc-entries %2d  readme %s",
                    demo, beats.length, entries.length,
                    header.include?("each must be BLOCKED") ? " (declares complete)" : "                    ",
                    desc ? desc_entries(desc).length : 0,
                    section ? "section names #{named}" : "no battery heading")
    stats[-1] << format("  statuses-checked %2d", r7_checked[demo])
  end

  # In-band vacuity. Coverage rules answer for themselves; the two BANS cannot,
  # so their liveness is asserted on the extractors that feed them (K-1262).
  if declaring_headers.zero?
    failures << "no suite header contains «each must be BLOCKED» — R2 is covering nothing, in any demo " \
                "[R2-vacuity]"
  end
  if header_entry_total.zero?
    failures << "the header list-entry extractor found no entries in any suite — R3 is a ban that cannot " \
                "bite [R3-vacuity]"
  end
  # …and the same question asked PER DEMO, off the suite glob. R2 and R3 read
  # ONE list — the suite header's — and the fleet-wide count above is satisfied
  # by six demos while a seventh carrying no list at all is covered by neither:
  # R3 has no entry to hold against the registrations, and R2's «is this list
  # complete?» cannot be asked of a header that has no list. That is the K-1213
  # shape one level up — a vacuity arm whose UNIT is the corpus rather than the
  # member reads as coverage of every member. The demo set is the glob, so an
  # eighth demo is held to this with no edit here.
  header_entries_by_demo.each do |demo, count|
    next unless count.zero?

    failures << "#{demo}: its suite header carries no beat list at all — R3 has no entry to check against " \
                "the registrations and R2 has no list to ask about, so NEITHER rule says anything about " \
                "this demo while the fleet-wide counts stay satisfied by the others [R2/R3-vacuity]"
  end
  if desc_entry_total.zero?
    failures << "the desc entry extractor found no entries in any demo:redteam desc — R5 is a ban that " \
                "cannot bite [R5-vacuity]"
  end
  if readme_sections.zero?
    failures << "no README carries a battery heading — R6 is covering nothing [R6-vacuity]"
  end
  # R7's liveness is asked PER DEMO, and the demo set is the suite glob above:
  # an eighth demo is held to this with no edit here, and a demo whose prose
  # stops naming statuses says so rather than going quiet (K-1213).
  r7_checked.each do |demo, checked|
    next unless checked.zero?

    failures << "#{demo}: not one of its three restatements names an HTTP status R7 can check, so the " \
                "rule covers nothing in this demo [R7-vacuity]"
  end

  Report.new(failures:, notes:, stats:)
end

# ── --self-test ──────────────────────────────────────────────────────────────
#
# An arm per rule plus a vacuity arm per rule, against a THROWAWAY COPY of the
# real suites rather than against a synthetic idiom this guard would then be the
# only reader of: the extractors have to bind to the shapes the demos actually
# use, and a fixture written to match the extractor proves the extractor matches
# the fixture. Two synthetic arms remain, for R1, because the unreadable
# registration forms they plant do not exist in the tree by construction.

CORPUS_GLOBS = [
  "kiosk-demo-*/script/redteam_suite.rb",
  "kiosk-demo-*/lib/tasks/demo.rake",
  "kiosk-demo-*/README.md",
  # R7's oracle lives in the gem, so the throwaway tree needs it too — and an
  # arm can then plant a break in the gem's own scenarios.
  "kiosk-redteam/lib/kiosk/redteam.rb",
  "kiosk-redteam/lib/kiosk/redteam/scenarios/*.rb",
].freeze

def fixture_root(dir)
  CORPUS_GLOBS.each do |g|
    Dir.glob(File.join(ROOT, g)).each do |src|
      rel = src.delete_prefix("#{ROOT}/")
      dst = File.join(dir, rel)
      FileUtils.mkdir_p(File.dirname(dst))
      FileUtils.cp(src, dst)
    end
  end
  dir
end

def edit(path, from, to)
  s = File.read(path)
  raise "self-test fixture: #{from.inspect} not found in #{path}" unless s.include?(from)

  File.write(path, s.sub(from, to))
end

def self_test # rubocop:disable Metrics/AbcSize, Metrics/MethodLength
  arms     = []
  failures = []

  # Each arm names the rule TAG it must be answered by, not merely a string that
  # appears in some message: an arm that goes red for a different rule than the
  # one it was written for is a green arm proving nothing, and two of these did
  # exactly that on the day they were written.
  run = lambda do |name, tag, &setup|
    Dir.mktmpdir("redteam-headers-selftest") do |dir|
      root = fixture_root(dir)
      setup.call(root)
      rep = check(root)
      arms << name
      if tag.nil?
        failures << "#{name}: expected GREEN, got: #{rep.failures.first}" unless rep.failures.empty?
      elsif rep.failures.empty?
        failures << "#{name}: expected RED [#{tag}], stayed GREEN"
      elsif rep.failures.none? { _1.include?("[#{tag}]") }
        failures << "#{name}: went red, but no failure carries [#{tag}] — first was: #{rep.failures.first}"
      end
    end
  end

  run.call("GREEN — the tree as it stands", nil) { nil }

  # R1 — ENUMERATION. Both halves are loud by design: a registration this guard
  # cannot read is a beat no later rule protects.
  run.call("R1 — a battery `record` whose beat name is an unresolvable expression", "R1") do |root|
    edit(File.join(root, "kiosk-demo-tudu/script/redteam_suite.rb"),
         'BATTERY.record("CrossTenantRead"', "BATTERY.record(beat_name_from_somewhere")
  end
  run.call("R1 — a `scenarios = [...]` entry that is not a `Name.new`", "R1") do |root|
    edit(File.join(root, "kiosk-demo-hoteling/script/redteam_suite.rb"),
         "  PastStay.new,", "  build_a_beat(:past_stay),")
  end
  run.call("R1 — a battery `scenario` that does not open with a readable `Name.new`", "R1") do |root|
    edit(File.join(root, "kiosk-demo-tudu/script/redteam_suite.rb"),
         "  Kiosk::Redteam::Scenarios::DeviceGrantRoleSelfSelection.new,", "  beat_from_a_factory,")
  end
  run.call("R1 — the suite builds no battery, so nothing registers anywhere readable", "R1") do |root|
    edit(File.join(root, "kiosk-demo-tudu/script/redteam_suite.rb"),
         "BATTERY = Kiosk::Redteam::Battery.new", "BATTERY = LocalLedger.new")
  end
  run.call("R1-vacuity — a suite from which no beat can be derived at all", "R1") do |root|
    p = File.join(root, "kiosk-demo-tudu/script/redteam_suite.rb")
    File.write(p, File.read(p).gsub(/BATTERY\.(record|scenario)\(/, "noop("))
  end
  # E4's own arm: skooti is the only suite whose beat names live in a hash
  # literal rather than at the registration call, and it is the extractor most
  # easily broken by a reformat that reads as tidying.
  run.call("R1 — skooti's beat table stops being readable, taking nine beats with it", "R1") do |root|
    p = File.join(root, "kiosk-demo-skooti/script/redteam_suite.rb")
    File.write(p, File.read(p).sub("}.each { |name, beat| battery.record(name,",
                                   "}.each { |name, beat| battery.record(name.to_s,"))
  end

  # R2 — HEADER COVERAGE, a coverage rule, plus the declaration that scopes it.
  run.call("R2 — a declaring header that drops an entry for a beat that runs", "R2") do |root|
    edit(File.join(root, "kiosk-demo-tudu/script/redteam_suite.rb"),
         "#   InviteCodeReplay      — an already-used invite code is rejected → 403\n", "")
  end
  run.call("R2-vacuity — no header anywhere declares its list complete", "R2-vacuity") do |root|
    Dir.glob(File.join(root, "kiosk-demo-*/script/redteam_suite.rb")).each do |p|
      File.write(p, File.read(p).gsub("each must be BLOCKED", "each is worth a look"))
    end
  end

  # R3 — the header BAN. Its liveness is asserted on the EXTRACTOR, never on the
  # violations: a ban whose violations match nothing is the ban being obeyed
  # (K-1262).
  run.call("R3 — a header entry naming a beat that does not run", "R3") do |root|
    edit(File.join(root, "kiosk-demo-tudu/script/redteam_suite.rb"),
         "# Standard scenarios (each must be BLOCKED):\n",
         "# Standard scenarios (each must be BLOCKED):\n#   GhostBeatName    — an attack nobody wrote\n")
  end
  run.call("R3-vacuity — the header entry extractor finds nothing in any suite", "R3-vacuity") do |root|
    Dir.glob(File.join(root, "kiosk-demo-*/script/redteam_suite.rb")).each do |p|
      s = File.read(p)
      head, rest = s.split("\nrequire ", 2)
      File.write(p, "#{head.gsub(/^#[ \t]{2,}/, '# ')}\nrequire #{rest}")
    end
  end
  # …and the same loss in ONE demo, which the fleet-wide count above cannot see
  # because the other six keep it non-zero. The demo is taken off the glob, not
  # named, for the same reason R7's arms are.
  run.call("R2/R3-vacuity — ONE demo's suite header stops carrying a beat list", "R2/R3-vacuity") do |root|
    p = Dir.glob(File.join(root, "kiosk-demo-*/script/redteam_suite.rb")).sort.first
    s = File.read(p)
    head, rest = s.split("\nrequire ", 2)
    File.write(p, "#{head.gsub(/^#[ \t]{2,}/, '# ')}\nrequire #{rest}")
  end

  # R4 / R5 — the rake desc, both directions.
  run.call("R4 — a desc that stops naming a beat that runs", "R4") do |root|
    edit(File.join(root, "kiosk-demo-tudu/lib/tasks/demo.rake"),
         "MalformedUuidArg (400)", "a junk uuid (400)")
  end
  run.call("R5 — a desc entry naming a beat that does not run", "R5") do |root|
    edit(File.join(root, "kiosk-demo-hoteling/lib/tasks/demo.rake"),
         "      BLOCKED  PastStay", "      BLOCKED  GhostDescBeat\n      BLOCKED  PastStay")
  end
  run.call("R5-vacuity — the desc entry extractor finds nothing in any demo", "R5-vacuity") do |root|
    Dir.glob(File.join(root, "kiosk-demo-*/lib/tasks/demo.rake")).each do |p|
      File.write(p, File.read(p).gsub(/^([ \t]*)(?:BLOCKED|SKIPPED|BREACH)([ \t]+[A-Z])/) { "#{$1}listed#{$2}" })
    end
  end

  # R6 — the README battery section, its coverage and its DERIVED scope.
  run.call("R6 — a battery section that renames a beat out from under itself", "R6") do |root|
    edit(File.join(root, "kiosk-demo-philslist/README.md"), "`CrossOwnerEdit`", "`CrossOwnerEditt`")
  end
  run.call("R6-vacuity — a battery heading over something that is not a beat list", "R6-vacuity") do |root|
    p = File.join(root, "kiosk-demo-tudu/README.md")
    s = File.read(p)
    i = s.index(/^\#{1,6}[ \t].*adversarial/i)
    j = s.index(/^\#{1,6}[ \t]/, i + 1)
    File.write(p, "#{s[0...i]}### Adversarial battery (`rake demo:redteam`)\n\nNothing to see.\n\n#{s[j..]}")
  end
  run.call("R6-scope — no README carries a battery heading any more", "R6-vacuity") do |root|
    Dir.glob(File.join(root, "kiosk-demo-*/README.md")).each do |p|
      File.write(p, File.read(p).lines.map { |l|
        l =~ /\A\#{1,6}[ \t].*(redteam|adversarial)/i ? "### Attack battery\n" : l
      }.join)
    end
  end

  # R7 — ONE ARM PER DEMO, and the demo list is the SUITE GLOB rather than a
  # list written here: an eighth demo is planted into with no edit to this file.
  # That polarity is the K-1213 lesson and it has now been paid for twice — most
  # recently when bin/check-demo-prereqs' hand-listed arm stopped draining its
  # own corpus the moment two demos grew a task.
  #
  # Each arm rewrites the first status R7 actually checks in that demo's
  # `demo:redteam` desc into one no beat asserts, which is the K-1418 shape
  # exactly: the assertion moved, the sentence beside it did not. A demo whose
  # desc stops naming a checkable status RAISES here rather than passing, for
  # the same reason the vacuity arm exists.
  # 429 is asserted by no beat in this repository; a beat that starts asserting
  # it turns these arms GREEN, which fails the self-test loudly rather than
  # quietly weakening it.
  stale = "429"
  Dir.glob(File.join(ROOT, "kiosk-demo-*", "script", "redteam_suite.rb")).sort.each do |real_suite|
    demo = File.basename(File.dirname(File.dirname(real_suite)))
    run.call("R7 — #{demo}'s demo:redteam desc promises a status its own suite never asserts", "R7") do |root|
      src      = File.read(File.join(root, demo, "script", "redteam_suite.rb"))
      beats, _ = suite_beats(src)
      rake     = File.join(root, demo, "lib", "tasks", "demo.rake")
      rake_src = File.read(rake)
      desc     = redteam_desc(rake_src)
      table    = attributed(desc.to_s, beats, DESC_ENTRY)
      beat, statuses = beats.map { |b| [b, asserted_statuses(table[b].to_s)] }.find { |_, st| !st.empty? }
      raise "self-test fixture: #{demo}'s demo:redteam desc names no status R7 checks" unless beat

      from = desc.index(/(?<![A-Za-z0-9_])#{Regexp.escape(beat)}(?![A-Za-z0-9_])/)
      at   = desc.index(statuses.first, from)
      raise "self-test fixture: cannot locate #{statuses.first} beside #{demo}'s #{beat}" unless at

      planted = desc.dup
      planted[at, 3] = stale
      File.write(rake, rake_src.sub(desc) { planted })
    end
  end

  run.call("R7-locate — a registered beat with no implementation anywhere", "R7-locate") do |root|
    edit(File.join(root, "kiosk-demo-getgrocery/script/redteam_suite.rb"),
         "  Kiosk::Redteam::Scenarios::CrossTenantRead.new,",
         "  Kiosk::Redteam::Scenarios::NoSuchBeatAnywhere.new,")
  end

  run.call("R7-locate — BLOCKED_STATUSES can no longer be read out of the gem", "R7-locate") do |root|
    p = File.join(root, "kiosk-redteam/lib/kiosk/redteam.rb")
    File.write(p, File.read(p).sub(/^(\s*)BLOCKED_STATUSES\s*=\s*\[[^\]]*\]/) { "#{Regexp.last_match(1)}BLOCKED_STATUSES = refusal_statuses" })
  end

  # R7-vacuity — the demo is taken off the glob, not named, for the same reason
  # the arms above are.
  run.call("R7-vacuity — a demo whose three restatements stop naming any status", "R7-vacuity") do |root|
    demo  = File.basename(File.dirname(File.dirname(
              Dir.glob(File.join(root, "kiosk-demo-*", "script", "redteam_suite.rb")).sort.first)))
    strip = lambda do |text|
      text.gsub(STATUS_TOKEN) { HTTP_STATUSES.include?(Regexp.last_match(1)) ? "a refusal" : Regexp.last_match(1) }
    end
    suite = File.join(root, demo, "script", "redteam_suite.rb")
    src   = File.read(suite)
    head  = header_block(src)
    File.write(suite, strip.call(head) + src[head.length..])
    rake = File.join(root, demo, "lib", "tasks", "demo.rake")
    File.write(rake, strip.call(File.read(rake)))
    readme = File.join(root, demo, "README.md")
    File.write(readme, strip.call(File.read(readme))) if File.exist?(readme)
  end

  if failures.empty?
    puts "check-redteam-headers --self-test: OK — #{arms.length} arm(s), one per rule plus its vacuity arm, " \
         "each planted into a throwaway copy of the REAL suites and answered by the rule tag it was " \
         "written for:"
    arms.each { puts "  #{_1}" }
    exit 0
  end

  warn "\ncheck-redteam-headers --self-test FAILED (#{failures.length} of #{arms.length} arm(s)):\n"
  failures.each { warn "  x #{_1}" }
  exit 1
end

self_test if ARGV.include?("--self-test")

report = check(ROOT)

if ARGV.include?("--list")
  puts report.stats
  exit 0
end

report.notes.each { puts "check-redteam-headers NOTE: #{_1}" }

if report.failures.empty?
  puts report.stats
  puts "check-redteam-headers: OK — every registered beat is named where its demo restates the list, no " \
       "restatement names a beat that does not run, and no restatement attributes an HTTP status to a beat " \
       "whose own assertion never names it."
  exit 0
end

warn "\ncheck-redteam-headers FAILED (#{report.failures.length}):\n"
report.failures.each { warn "  x #{_1}" }
warn "\nThe beat set — and, since K-1482, each beat's status set — is DERIVED from each suite's own " \
     "registrations and assertions; the header, the demo:redteam desc and the README battery section are " \
     "RESTATEMENTS of it. Repair the restatement, never the derivation — and if a beat was renamed, or the " \
     "status it asserts moved, all three move together (K-709, K-710, K-1482, T-078)."
exit 1
