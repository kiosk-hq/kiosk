#!/usr/bin/env ruby
# frozen_string_literal: true

# check-refusal-assertions — a demo red-team beat (`<battery>.record(label, predicate)` in
# `kiosk-demo-*/script/*.rb`) whose label claims a 400 refusal of an input property the demo's
# descriptors constrain must have a predicate that reads the refusal's words, not only status and code.
# Beats whose label is not a literal are counted, not read.
# Usage: bin/check-refusal-assertions [--self-test]

require 'fileutils'
require 'tmpdir'

ROOT = File.expand_path('..', __dir__)

# The call form whose label and predicate are arguments of one call.
RECEIVER = '.record'

# A claim the engine's argument validation could have produced; a 403 cannot come from it.
REFUSAL_CLAIM = /\b400\b|bad_request/

# Reading the refusal's own words.
EVIDENCE = /detail|message|hint|include\?|match\?|=~|start_with\?|end_with\?/

# A JSON Schema keyword the engine can refuse an argument on.
CONSTRAINT = /\b(format|enum|pattern|minLength|maxLength|minimum|maximum|const):/

Report = Struct.new(:failures, :notes, :stats, keyword_init: true)

# ── extraction ───────────────────────────────────────────────────────────────

# Every `<receiver>( … )` in `src`, as [line, argument-text].
def call_sites(src, receiver)
  out = []
  idx = 0
  while (m = src.index(receiver, idx))
    open_paren = src.index('(', m + receiver.length - 1)
    break unless open_paren

    i = scan_to_close(src, open_paren, '(', ')')
    out << [src[0...m].count("\n") + 1, src[(open_paren + 1)...i].to_s]
    idx = i > m ? i : m + 1
  end
  out
end

# Walks Ruby text and yields each code character: outside strings and comments, inside `#{…}`.
class CodeChars
  QUOTES = ['"', "'"].freeze

  def initialize(text)
    @text = text
    @interp = [] # brace depth inside each open `#{`
    @in_str = nil
    @in_comment = false
    @esc = false
    @skip = false
  end

  def each(from)
    pos = from
    while pos < @text.length
      char = @text[pos]
      yield char, pos if code?(char, pos)
      pos += @skip ? 2 : 1
      @skip = false
    end
  end

  private

  # True when `char` is code. Updates the reader state either way.
  def code?(char, pos)
    if @in_comment then @in_comment = char != "\n"
    elsif @in_str then string_char(char, pos)
    elsif QUOTES.include?(char) then @in_str = char
    elsif @interp.any? then interpolation_char(char)
    elsif char == '#' then @in_comment = true
    else return true
    end
    false
  end

  def string_char(char, pos)
    if @esc then @esc = false
    elsif char == '\\' then @esc = true
    elsif @in_str == '"' && char == '#' && @text[pos + 1] == '{' then open_interpolation
    elsif char == @in_str then @in_str = nil
    end
  end

  def open_interpolation
    @interp.push(0)
    @in_str = nil
    @skip = true
  end

  def interpolation_char(char)
    if char == '{' then @interp[-1] += 1
    elsif char == '}' && @interp[-1].zero? then close_interpolation
    elsif char == '}' then @interp[-1] -= 1
    end
  end

  def close_interpolation
    @interp.pop
    @in_str = '"'
  end
end

# Yields every code character of `text` (outside strings and comments, inside `#{…}`) with its index.
def each_code_char(text, from = 0, &) = CodeChars.new(text).each(from, &)

# Index of the closer that balances the opener at `from`, ignoring strings and comments.
def scan_to_close(src, from, opener, closer)
  depth = 0
  each_code_char(src, from) do |c, i|
    depth += 1 if c == opener
    next unless c == closer

    depth -= 1
    return i if depth.zero?
  end
  src.length
end

BRACKET_DEPTH = { '(' => 1, '[' => 1, '{' => 1, ')' => -1, ']' => -1, '}' => -1 }.freeze

# Split an argument list at top-level commas, read as `each_code_char` reads it.
def top_level_args(body)
  cuts = []
  depth = 0
  each_code_char(body) do |c, i|
    depth += BRACKET_DEPTH.fetch(c, 0)
    cuts << i if c == ',' && depth.zero?
  end
  [-1, *cuts].zip([*cuts, body.length]).map { |from, to| body[(from + 1)...to] }
end

# The PROSE is every string-literal argument; the PREDICATE is everything else.
def prose_and_predicate(body)
  prose = []
  code  = []
  top_level_args(body).each { |a| (a.strip.start_with?('"', "'") ? prose : code) << a }
  [prose.join(' '), code.join(' ')]
end

# Every input-schema property name this demo constrains with a keyword the engine validates.
def constrained_input_fields(demo_dir)
  Dir.glob(File.join(demo_dir, 'app/**/*.rb')).flat_map do |f|
    constrained_names(input_schema_regions(File.read(f)))
  end.uniq
end

def constrained_names(src)
  names = []
  idx = 0
  while (m = src.match(/^[ \t]*([a-z_][a-z0-9_]*):\s*\{/, idx))
    names << m[1] if m[1] != 'properties' && braced_body(src, m.end(0) - 1).match?(CONSTRAINT)
    idx = m.end(0)
  end
  names
end

def braced_body(src, open_i) = src[(open_i + 1)...scan_to_close(src, open_i, '{', '}')].to_s

def input_schema_regions(src)
  out = +''
  idx = 0
  while (m = src.match(/^[ \t]*input_schema\b/, idx))
    nxt = src.index(/^[ \t]*(output_schema|example_params|example_row|def |kind |description )/, m.end(0)) ||
          src.length
    out << src[m.begin(0)...nxt] << "\n"
    idx = nxt
  end
  out
end

# ── reading a predicate ──────────────────────────────────────────────────────

# The nearest preceding assignment of `name` in `src`, as its expression text, so one beat
# never borrows another's evidence.
def nearest_assignment(src, name, before_line)
  lines = src.lines
  found = nil
  lines.each_with_index do |line, i|
    break if i + 1 >= before_line
    next unless line.match?(/^\s*#{Regexp.escape(name)}\s*(?:,\s*[a-z_0-9,\s*]*)?=[^=~]/) ||
                line.match?(/^\s*[a-z_0-9,\s*]*\b#{Regexp.escape(name)}\b[a-z_0-9,\s*]*=[^=~]/)

    found = i
  end
  return '' unless found

  expression_at(lines, found)
end

DO_LINE = /\bdo\b\s*(\|[^|]*\|)?\s*$/

# From `lines[start]`, as many lines as it takes to balance brackets and close a trailing `do`.
def expression_at(lines, start, cap: 60)
  last = [lines.length, start + cap].min - 1
  depth = blocks = 0
  stop = (start..last).find do |j|
    code = strip_comment(lines[j])
    depth += bracket_balance(code)
    blocks += block_balance(code)
    expression_end?(depth, blocks, j > start, code)
  end
  lines[start..(stop || last)].join
end

# Strip a comment, never an interpolation.
def strip_comment(line) = line.sub(/(\A|\s)#(?!\{).*$/) { Regexp.last_match(1).to_s }

def bracket_balance(code) = code.count('([{') - code.count(')]}')
def block_balance(code) = (code.match?(DO_LINE) ? 1 : 0) - (code.match?(/^\s*end\b/) ? 1 : 0)

# Brackets and blocks balance. A first line that opens nothing is a whole expression.
def expression_end?(depth, blocks, continued, code)
  return depth <= 0 && blocks <= 0 if continued

  depth.zero? && blocks.zero? && !code.match?(DO_LINE)
end

# A `def <name>` … `end` in `src`, matched on the definition's own indentation.
def method_definition(src, name)
  lines = src.lines
  start = lines.index { |l| l.match?(/^(\s*)def\s+(self\.)?#{Regexp.escape(name)}\b/) }
  return '' unless start

  indent = lines[start][/^\s*/]
  stop = ((start + 1)...lines.length).find { |j| lines[j].match?(/^#{indent}end\b/) } || (lines.length - 1)
  lines[start..stop].join
end

# The predicate PLUS everything it delegates to: the locals it reads, then the
# helper methods any of that calls.
def predicate_reading(predicate, src, line)
  text = predicate.dup
  predicate.scan(/\b([a-z_][a-z0-9_]*)\b/).flatten.uniq.each do |v|
    text << ' ' << nearest_assignment(src, v, line)
  end
  text.scan(/\b([a-z_][a-z0-9_]*)\b/).flatten.uniq.each do |v|
    text << ' ' << method_definition(src, v)
  end
  text
end

# ── the check ────────────────────────────────────────────────────────────────

def check(root)
  report = Report.new(failures: [], notes: [], stats: Hash.new(0))
  Dir.glob(File.join(root, 'kiosk-demo-*')).each { |demo_dir| check_demo(report, root, demo_dir) }
  report.failures.concat(vacuity_failures(report.stats))
  report.notes << stats_note(report.stats)
  report
end

def check_demo(report, root, demo_dir)
  fields = constrained_input_fields(demo_dir)
  report.stats[:fields] += fields.length
  Dir.glob(File.join(demo_dir, 'script/*.rb')).each do |f|
    src = File.read(f)
    ctx = { demo: File.basename(demo_dir), rel: f.delete_prefix("#{root}/"), fields: fields, src: src }
    call_sites(src, RECEIVER).each { |line, body| check_beat(report, ctx, line, body) }
  end
end

def check_beat(report, ctx, line, body)
  prose, predicate = prose_and_predicate(body)
  named = named_fields(prose, ctx[:fields], report.stats)
  return if named.empty?

  report.stats[:named] += 1
  return report.stats[:evidenced] += 1 if predicate_reading(predicate, ctx[:src], line).match?(EVIDENCE)

  report.failures << ra1_failure(ctx, line, named, prose)
end

# Counts the beat into `stats` and returns the constrained fields its 400 claim names.
def named_fields(prose, fields, stats)
  if prose.strip.empty?
    stats[:unreadable] += 1
    return []
  end
  stats[:assertions] += 1
  return [] unless prose.match?(REFUSAL_CLAIM)

  stats[:refusal_claims] += 1
  fields.select { |n| prose.match?(/\b#{Regexp.escape(n)}\b/) }
end

def ra1_failure(ctx, line, named, prose)
  label = prose.strip.gsub(/\s+/, ' ')[0, 120]
  "[RA-1] #{ctx[:rel]}:#{line} — the beat claims a 400 refusal of " \
    "`#{named.join('`/`')}`, which #{ctx[:demo]}'s descriptor constrains, but reads only " \
    "status and code. Assert the refusal's own words (a `detail`/`message`/`hint`, " \
    "or a substring test). LABEL: #{label}"
end

# ── vacuity ────────────────────────────────────────────────────────────────
def vacuity_failures(stats)
  [("[RA-V1] no readable beat was found in any demo's `script/*.rb`; fix the beat extractor" if stats[:assertions].zero?),
   ('[RA-V2] no constrained input property was found in any demo; fix the field extractor' if stats[:fields].zero?),
   ('[RA-V3] no beat claims a `400`/`bad_request` refusal; fix REFUSAL_CLAIM' if stats[:refusal_claims].zero?),
   ("[RA-V4] no beat in scope reads a refusal's words; fix EVIDENCE" if stats[:evidenced].zero? && stats[:named].positive?)]
    .compact
end

def stats_note(stats)
  "beats read: #{stats[:assertions]} (#{stats[:unreadable]} whose label is not a " \
    "literal, not read); claiming a 400 refusal: #{stats[:refusal_claims]}; " \
    "also naming a constrained argument: #{stats[:named]}; of those, reading the " \
    "refusal's words: #{stats[:evidenced]}"
end

# ── --self-test: plants in a throwaway copy of the real demos, each answered by its own tag ──

CORPUS_GLOBS = [
  'kiosk-demo-*/script/*.rb',
  'kiosk-demo-*/app/**/*.rb'
].freeze

def fixture_root(dir)
  CORPUS_GLOBS.each do |g|
    Dir.glob(File.join(ROOT, g)).each do |src|
      dst = File.join(dir, src.delete_prefix("#{ROOT}/"))
      FileUtils.mkdir_p(File.dirname(dst))
      FileUtils.cp(src, dst)
    end
  end
  dir
end

def edit(path, from, to)
  s = File.read(path)
  raise "self-test fixture: #{from.inspect} not found in #{path}" unless s.include?(from)

  File.write(path, s.sub(from, to))
end

PHILSLIST_SUITE = 'kiosk-demo-philslist/script/redteam_suite.rb'
TUDU_SUITE      = 'kiosk-demo-tudu/script/redteam_suite.rb'

# [name, the tag it must redden with (nil: stays green), edits [[file, from, to]] or a bulk-rewrite method].
ARMS = [
  ['GREEN — the tree as it stands', nil, []],
  # RA-1, hop 0: the predicate is right there.
  ["RA-1 — philslist's out-of-enum filter beat back to status-and-code", 'RA-1',
   [[PHILSLIST_SUITE, "detail_bad.include?('bikes') && detail_bad.include?('housing') &&\n", '']]],
  # The same plant behind a comment carrying an unbalanced `(`.
  ['RA-1 — a comment carrying a stray `(` does not move where the beat ends', 'RA-1',
   [[PHILSLIST_SUITE, "detail_bad.include?('bikes') && detail_bad.include?('housing') &&\n",
     "# the app's own check ( defeated\n"]]],
  # RA-1, hop 1: the beat delegates to a local computed above it.
  ["RA-1 — philslist's MalformedUuidArg stops reading the detail", 'RA-1',
   [[PHILSLIST_SUITE, "         body['detail'].to_s.include?('listing_id') && !scan.leak?", '         !scan.leak?']]],
  # A 403 claim is out of scope.
  ['GREEN — a status-only beat claiming a 403 stays out of scope', nil,
   [[TUDU_SUITE, "\"replay of used invite code → \#{rc} (want 403)\"",
     "\"replay of used invite code → \#{rc} (want 403, code refused)\""]]],
  # The same beat re-labelled as a 400 claim is in scope.
  ['RA-1 — the same beat re-labelled as a 400 claim is in scope', 'RA-1',
   [[TUDU_SUITE, "\"replay of used invite code → \#{rc} (want 403)\"",
     "\"replay of used invite code → \#{rc} (want 400)\""]]],
  ['RA-V1 — no beat is readable anywhere', 'RA-V1', :hide_beats],
  ['RA-V2 — no descriptor constrains an input any more', 'RA-V2', :drop_constraints],
  ['RA-V3 — no beat claims a 400 refusal any more', 'RA-V3', :drop_refusal_claims],
  # Every EVIDENCE token split apart; RA-1 reddens too, the arm demands RA-V4.
  ["RA-V4 — no predicate reads a refusal's words any more", 'RA-V4', :drop_evidence]
].freeze

def rewrite_scripts(root, glob)
  Dir.glob(File.join(root, glob)).each { |p| File.write(p, yield(File.read(p))) }
end

def hide_beats(root) = rewrite_scripts(root, 'kiosk-demo-*/script/*.rb') { it.gsub('.record(', '.noop(') }

def drop_constraints(root)
  rewrite_scripts(root, 'kiosk-demo-*/app/**/*.rb') do |s|
    s.gsub(/\b(format|enum|pattern|minLength|maxLength|minimum|maximum|const):/) { "x#{it}" }
  end
end

def drop_refusal_claims(root)
  rewrite_scripts(root, 'kiosk-demo-*/script/*.rb') { it.gsub('400', '4oo').gsub('bad_request', 'bad_req') }
end

def drop_evidence(root)
  rewrite_scripts(root, 'kiosk-demo-*/script/*.rb') { |s| s.gsub(EVIDENCE) { |m| m.chars.join('-') } }
end

def apply_plant(root, setup)
  return send(setup, root) if setup.is_a?(Symbol)

  setup.each { |rel, from, to| edit(File.join(root, rel), from, to) }
end

def run_arm(name, tag, setup)
  Dir.mktmpdir('refusal-assertions-selftest') do |dir|
    root = fixture_root(dir)
    apply_plant(root, setup)
    arm_failure(name, tag, check(root).failures)
  end
end

# Why the arm failed, or nil when it answered as expected.
def arm_failure(name, tag, failures)
  if tag.nil?
    "#{name}: expected GREEN, got: #{failures.first}" unless failures.empty?
  elsif failures.empty?
    "#{name}: expected RED [#{tag}], stayed GREEN"
  elsif failures.none? { it.include?("[#{tag}]") }
    "#{name}: went red, but no failure carries [#{tag}] — first was: #{failures.first}"
  end
end

def self_test
  failures = ARMS.filter_map { |name, tag, setup| run_arm(name, tag, setup) }
  if failures.empty?
    puts "check-refusal-assertions --self-test: OK — #{ARMS.length} arm(s)."
    exit 0
  end

  warn "\ncheck-refusal-assertions --self-test FAILED (#{failures.length} of #{ARMS.length} arm(s)):\n"
  failures.each { |f| warn "  - #{f}" }
  exit 1
end

self_test if ARGV.include?('--self-test')

report = check(ROOT)
report.notes.each { |n| puts "  #{n}" }
if report.failures.empty?
  puts 'check-refusal-assertions: OK — every beat that claims a 400 refusal of a constrained ' \
       "argument reads the refusal's own words."
  exit 0
end

warn "\ncheck-refusal-assertions FAILED (#{report.failures.length}):\n"
report.failures.each { |f| warn "  - #{f}\n" }
exit 1
