#!/usr/bin/env ruby
# frozen_string_literal: true

# NO ARCHAEOLOGY IN A PUBLISHED ARTEFACT (T-186, K-1435).
#
# Phil, 2026-09-07: «Я ж просил - убери из демок ВСЮ археологию.» The gems in
# this repository are published. A stranger who adds one to their Gemfile and
# opens the source meets «the K-1035 class», «the T-090 rule», «ADR-0018» —
# inside code they are being asked to adopt. NONE of those ids resolves for
# them, and none ever will: the findings ledger is private and the ADRs live in
# a private repository. The constitution's rule is «a public artefact describes
# what IS»; a citation to a document the reader cannot open is the opposite.
#
# ── COMMENTS ARE IN SCOPE, IN THE GEMS AND IN THE DEMOS ──────────────────────
#
# The reader of `kiosk-server/lib` IS the adopter: comments are the surface
# they read, and the measurement that opened this rule was 576 ledger ids
# across the fourteen gems' `lib/`, 473 of them in `kiosk-server` and
# effectively all of them in comments.
#
# THE DEMO TREE IS HELD ON THE SAME TERMS — and «the same terms» means the
# SCOPE TABLE below rather than a reader's inference, because for a while it
# did not: the sentence covered a demo's `spec/` and `test/` and the file set
# did not, so 14 tracked files were held by nothing at all (K-1509, K-1435).
# Each tree now has two scopes that MEET: the surfaces a receiver browses, on
# R1–R3 and R5–R7, and the test tree, on R3 and R7. R4 is the one asymmetry and
# it is declared at the rule. The narrower rule this tree used to be
# held on is why this file says so at length. `bin/check-demo-copies` bans a
# ledger id in the demo tree's CODE TOKENS only — a `desc`, a banner, an
# `abort`, an assertion label — on the argument that those reach an operator's
# terminal while a comment is a note to the next maintainer. Phil's instruction
# is «убери из демок ВСЮ археологию», and the demos are the first thing an
# operator opens: somebody evaluating Kiosk reads `kiosk-demo-hoteling/app` to
# find out what adopting it looks like, and a comment there is read exactly as
# a comment in `kiosk-server/lib` is. The exempt half was measured regrowing —
# 24 comment-carried occurrences of 9 ids, then 41 of 17 one day later, all of
# it by ordinary fix waves rather than by anyone deciding to. So the ban covers
# comment and code alike, in both trees, and `bin/check-demo-copies` keeps its
# code-token rule as the narrower statement about terminals.
#
# That also RETIRES the sentence the demo rule used to carry — «the standing
# decision for this repository is that inline K-/ADR-/T- refs in its code,
# READMEs and CHANGELOGs stay AS-IS, permanently». It was true when written and
# Phil overruled it. What survives of it is the exemption list below, which is
# his and is unchanged.
#
# ── THE SCOPE, DERIVED RATHER THAN LISTED ────────────────────────────────────
#
# Every non-demo `kiosk-*` gem directory in this repository, and inside it
# WHAT THAT GEM'S OWN `spec.files` NAMES — the set an adopter receives, read
# off the gemspec rather than re-globbed (K-1511). It reaches, today:
#
#   * `lib/**`      — everything, any file type. The install-generator
#                     templates under `lib/generators/**/templates` are in here
#                     and are the worst case of all: `kiosk:install` COPIES
#                     them into a third party's own repository.
#   * `app/**`      — `kiosk-server` ships `app/views`; two controllers resolve
#                     their templates from it, so it is packaged, not optional.
#   * `README.md`   — listed in every gemspec's `spec.files`.
#   * the packaged assets that are in NEITHER of those directories — the two
#     PoW backends' `solve*.py` and `requirements.txt`, and
#     `kiosk-pow-equihash`'s `solve.py` and `bench/` pair. Those seven were the
#     hole: the hand-list that stood here matched what MOST gems package, and a
#     file inside the `.gem` but outside the list was read by nobody.
#   * `<gem>.gemspec` — added on top, because it is not in `spec.files` and
#     RubyGems renders its description on the gem's page.
#
# Minus `CHANGELOG.md` and `LICENSE.txt`, declared at `GEM_NOT_READ` below.
# THIS LIST IS AN OBSERVATION, NOT THE SCOPE: the scope is the gemspec, so a
# gem that starts packaging a directory nobody thought of is read the day it
# does, and a self-test arm re-derives the packaged set and fails on anything
# this scope drops.
#
# And every `kiosk-demo-*` directory, where the receiver is an operator reading
# a worked example rather than an adopter installing a package, so the file set
# is what somebody browsing the app actually opens:
#
#   * `app/**`, `lib/**`, `script/**`, `config/**`, `db/**` — the application,
#     its tasks, its initializers and its migrations.
#   * `Rakefile`, `config.ru`, `README.md`, `before-after.md` — the root files
#     a reader meets first. `before-after.md` is the demo's published
#     narrative and carries derived transcripts of the code above.
#
#   Restricted to TEXT extensions (.rb .rake .ru .erb .yml .sql .md .json .tt
#   .txt .html) because `config/` also holds credentials keys and `.enc`
#   blobs, and a byte-scan of those answers a question nobody asked.
#
#   * `spec/**` and `test/**` — a SEPARATE scope, on the footing the gems' own
#     spec trees are held on, and it is separate rather than folded in because
#     the two receivers differ. A demo's spec tree does not ship anywhere, but
#     the repository is public and a stranger who clones it to see how a worked
#     example is TESTED reads it exactly as they read `app/`. Until K-1509 it
#     was in NO scope at all: the `spec` scope below is derived with the demo
#     directories SUBTRACTED, and the demo file set above names neither
#     directory, so the two met nowhere and left 14 tracked files across 6
#     demos unheld. WATCHED, not argued: one line carrying a ledger id, an ADR
#     reference, Cyrillic and the maintainer's name at once, appended to
#     `kiosk-demo-stylish/spec/salon_clock_spec.rb`, left this guard at exit 0
#     naming nothing, while the identical line in `kiosk-server/spec/` reddened
#     it.
#
# And `e2e/`, the end-to-end harness, where the receiver is an ADOPTER: its
# README is a teaching surface this repository points people at, `run.sh` is
# the sequence of edits it presents as what adopting Kiosk looks like, and
# `fixtures/` is the generated origin those edits produce. Nothing about that
# reader differs from the one the gem and demo scopes are written for, and
# the ban stopped at the harness door for no stated reason until it did not.
#
#   * `e2e/**` restricted to `.md .sh .rb .json`, excluding `e2e/.gems/` —
#     the harness's INSTALLED bundle, gitignored, thousands of files deep and
#     none of them ours.
#   * `e2e/schemas/*.schema.json` are VENDORED MIRRORS and are read for one
#     thing only: the TOP-LEVEL `$comment`, the provenance marker upstream
#     does not carry. `bin/check-spec-schemas` removes exactly that member
#     from each side and holds every other byte equal to the schema
#     kiosk.tech publishes, so it is the one part of a mirror this repository
#     may change; everything else, a NESTED `$comment` included, is the site
#     repository's. A citation cannot enter the body from here without
#     turning THAT guard red, and scrubbing one out here would make the
#     mirror stop mirroring. WHICH member is exempt is READ OUT of that
#     script rather than restated here — see `exempt_mirror_members`.
#
# And `deploy/`, the fleet runbook — ON TWO RULES ONLY, and the boundary is the
# point rather than a detail (K-1409, reopened twice). This directory was in NO
# scope at all until `deploy/README.md` was found telling its re-checker to look
# at `deploy/check-edge-ratelimit.sh`, a file that does not exist and has not
# since 2026-09-06. Every other guard that owns this tree reads the Caddyfile,
# the wire or the box; nothing read a sentence, so the sentence stood.
#
#   * `deploy/**` — every tracked file. A self-test arm re-derives the tracked
#     set from git and fails if one of them falls outside this scope, so a file
#     added with an extension nobody thought of is a DECISION rather than a
#     silent gap.
#
#   R1 (a ledger id), R2 (an ADR reference), R3 (Cyrillic) and R4 (the
#   maintainer named) DO NOT REACH IT, on the same footing as `bin/`: this is
#   maintainer tooling for one fleet, its reader is the person holding the ssh
#   key, and the harm those four rules exist for is that a STRANGER cannot
#   resolve what they are reading. R5, R6 and R7 do reach it, because their
#   harm is different in kind — a document that describes something which does
#   not exist is broken for EVERY reader, the maintainer included, and that is
#   exactly what was measured here. MEASURED at head when the scope was added,
#   `git grep -cP` over `-- 'deploy/*'`: R1 would fail on 168 lines in 12 files,
#   R3 on 11 lines in 4, R4 on 5 lines in 4. Those numbers are NOT a judgement
#   that the four are acceptable here — the R3/R4 residue is filed as K-1505 —
#   they are the measurement behind not turning this guard red on a standing
#   backlog nobody has agreed to drain.
#
# ── WHAT IS EXEMPT, DECLARED WITH ITS REASON ─────────────────────────────────
#
#   * `bin/`, `CHANGELOG.md`, `CLAUDE.md` — Phil's standing exemption. The
#     first is maintainer tooling, the second is append-only history that is
#     SUPPOSED to say what things used to be, the third is a maintainer
#     document. None of the three is inside the scope globs above; they are
#     named here so the boundary is a decision rather than an accident.
#   * `spec/`, `test/` — developer surfaces, absent from every `spec.files`,
#     and the constitution REQUIRES an inline TODO/FIXME to carry a ledger id,
#     which is a rule these directories have to be able to obey. So R1 and R2
#     do not reach them, and neither do R5 and R6. R3 AND R4 DO: a gem's
#     `spec/` is not shipped but it IS
#     published, and neither a Russian sentence nor an attributed decision is
#     readable to a stranger who clones this repository, whether or not it
#     travels in the .gem. An example's comment is where a reader goes to find
#     out what a control PROMISES, and «the maintainer ruled X» tells them to
#     trust a person instead.
#     A DEMO's `spec/` and `test/` are held the same way, in their own scope,
#     with ONE difference and it is R4's existing demo exemption rather than a
#     new judgement: `kiosk-demo-philslist` is an app called Phil's List, and a
#     sentence that is legal in its `app/` cannot be illegal in its `spec/` —
#     it is the same app and the same subject matter. The cost is stated rather
#     than hidden: «the maintainer ruled X» in a demo's spec is held by nothing,
#     exactly as it is in a demo's `app/`. No gem here has a `test/` and at
#     least one demo does, which is why the directory is globbed in the demo
#     half and not in the gem half — and a self-test arm re-derives the TRACKED
#     set from git and fails when a file falls outside the scope, so the
#     question «which directory is it this week» is answered by the tree.
#   * `Gemfile`, `Rakefile`, `.rubocop.yml` and the rest of a gem's root —
#     build and dev tooling, not packaged, never read by an adopter.
#   * `kiosk-demo-*/bin/` — generator binstubs, and Phil's exemption again.
#   * a demo's `Gemfile`, `Gemfile.lock`, `mise.toml`, `public/`, `log/`,
#     `tmp/`, `storage/` — build output and runtime state, not something a
#     reader browses for the example.
#   * A line carrying a live `TODO` or `FIXME` marker, anywhere in scope. The
#     constitution requires that marker to name a `K-`/`T-` row so it stays
#     actionable, so the ban is on the citation, not on the marker that needs
#     one. Zero such lines exist in scope today; the carve-out is here so that
#     obeying one rule cannot break the other.
#
# ── WHAT IS ASSERTED ─────────────────────────────────────────────────────────
#
#   R1  no ledger id — /\b[KT]-\d{3,4}\b/ — anywhere in either scope.
#   R2  no ADR reference — /\bADR-\d{4}\b/ — anywhere in either scope.
#   R3  no Cyrillic — /[Ѐ-ӿ]/ — anywhere in either scope. This
#       repository's working language is Russian and its published language is
#       English, and twelve lines of quoted Russian shipped inside five
#       `kiosk-server/lib` files for months. It is the same unresolvable-reader
#       defect as a ledger id, one layer worse: a reader cannot even tell
#       whether the sentence binds them. Guillemets, em dashes and § are Latin
#       and stay; only the Cyrillic block is banned, so the rule cannot argue
#       with the house punctuation.
#   R4  no maintainer named in prose — /\bPhil\b/ — everywhere but the demos.
#       «Phil accepted this control's weakness openly» tells an adopter to trust
#       a person they have never met instead of stating the property. Say what
#       the code does and why; the name belongs in `spec.authors` and in git.
#       DEMO-EXEMPT because `kiosk-demo-philslist` is an app called Phil's List
#       and the word is its subject matter, not an attribution. No other scope
#       has a reason like that.
#   R5  no RETIRED WIRE VERSION named in prose — in the gems, the demos, the
#       harness and the deploy directory. See the section below; the pattern is
#       DERIVED from `Kiosk::Protocol::API_VERSION` rather than typed here.
#   R6  no sentence NARRATING A PAST STATE — `formerly`, `previously`,
#       `historically`, `until recently`, `used to be`, `before the fix`,
#       `cutover`, `has since been — in the same four scopes. See below.
#   R7  no REPOSITORY PATH THAT DOES NOT EXIST — in EVERY scope, `spec/`
#       included. See the section below; the directory prefixes it recognises
#       are DERIVED from the repository layout rather than typed here.
#
# AND TWO THINGS THAT ARE COUNTED RATHER THAN BANNED:
#
#   C1  a bare `used to` — PRINTED, NEVER RED. It is the one construction that
#       spells archaeology and ordinary English with the same letters, so it
#       gets a census for a human to adjudicate instead of a rule that would
#       either fail on live prose or say nothing. See the census section below.
#   C2  `retired` and the PLUPERFECT `had been` — PRINTED, NEVER RED, and for
#       the same reason. These are the two idioms K-1510 measured walking
#       straight through R6's fixed word list. They are a CENSUS rather than
#       new markers on that list because a ban on either would demand a repair
#       that is wrong. See the census section below for the measurement.
#
# ── R5 AND R6: A PUBLIC ARTEFACT DESCRIBES WHAT IS (T-195, K-1460) ──────────
#
# Phil, 2026-09-07, on finding two demo READMEs explaining that the retired
# `POST /kiosk/query` and `POST /kiosk/run` «are the ordinary 404 an
# authenticated caller gets»: «Введи правило это убирать сразу. Этому не место
# в публичных артефактах кроме очень кратко changelog'а.» The afterlife of a
# removed wire version, verb, endpoint, envelope or configuration key is ONE
# SHORT CHANGELOG LINE and nothing else — not a README paragraph, not a comment
# explaining what it used to do. A reader arriving today has no memory to
# correct, and being told about a version of us they never met, ahead of the
# one they did, is the page failing at its only job.
#
# WHY THIS IS A GUARD AND NOT A CONVENTION. The class was found NINE times in
# four days — K-1398, K-1409, K-1449, K-1431, K-1458, K-1459, K-1461, K-1463,
# K-1476 — each time in a file set the previous fix had not declared, and each
# fix drained its own set and stopped. A watched fail settled why: a deleted
# narration sentence was planted back into a shipped demo file and ALL FIVE
# guards that own that file exited 0. Nothing read a sentence. These two rules
# are the first thing that does.
#
#   R5 — A RETIRED WIRE VERSION, DERIVED RATHER THAN LISTED. The current wire
#   is `Kiosk::Protocol::API_VERSION`, read out of kiosk-core at run time. Every
#   MAJOR.MINOR strictly below it is a wire no reader of this repository can
#   meet, so naming one in a shipped file is narration by construction. The ban
#   WIDENS ON ITS OWN: the day API_VERSION becomes 0.5.0, `0.4` joins it and
#   nothing here is edited. That is the whole reason it is derived — a typed
#   list of retired versions is a list somebody has to remember to extend, which
#   is the failure this repository has recorded about hand-kept inventories more
#   than once.
#
#   R5 IS PROSE-ONLY, and that is not a softening. `sleep 0.2` and
#   `spec.add_development_dependency "base64", "~> 0.2"` are NUMBERS, not
#   sentences; a version token inside code is a value the code uses, and a rule
#   that cannot tell them apart would be switched off within the day. So a hit
#   classified :code is skipped — Ripper decides that for a Ruby file, a leading
#   `#` for a shell file, and everything else is read as prose. Three further
#   shapes are excluded by the pattern itself, each with a self-test arm: a
#   token carrying a UNIT is a duration or a size (`~0.3 ms`, `~0.2 s`,
#   `44 MiB`), a token preceded by a digit or a dot is part of a longer number
#   (`127.0.0.1`), and a token followed by one is a three-component version
#   (`0.1.0`, `skill-v0.4.12.md`) rather than a wire.
#
#   R6 — A CONSTRUCTION THAT NARRATES A PAST STATE. This one is a LEXICAL
#   PROXY and is written down as such: it matches a phrase, not a meaning, and
#   the marker set is small on purpose. Every marker in it was chosen because
#   it has no reading in which a live sentence needs it — a caveat a reader can
#   still meet can always be stated in the present, and stating it in the
#   present is what the rule is for.
#
#   WHAT R6 DELIBERATELY DOES NOT CARRY, because it would fire on live prose:
#   `no longer` (measured live in three harness sentences — «a key the origin no
#   longer knows» is the state of the flow at that line, not its history), and
#   a bare `used to`, which is ALSO the ordinary passive «employed in order to».
#   Nothing lexical separates «the engine used to read `role`» from «a key used
#   to sign mandates», so it cannot be a BAN. It is a CENSUS instead — see the
#   next section, which also records the measurement that settled the question.
#
# ── R7: A PATH A DOCUMENT NAMES MUST RESOLVE (K-1409) ───────────────────────
#
# R6 is a LEXICAL proxy and says so; R7 is the same class asked as a question
# the filesystem answers, which is why it is worth having beside it. The
# sentence that reopened K-1409 twice carries no R6 marker at all — it names a
# script, in the present tense, and the script is gone. No idiom set finds that.
# `File.exist?` does, every time, for every spelling.
#
# THE PREFIXES ARE DERIVED, NOT LISTED: every `kiosk-*` directory at the
# repository root, plus `deploy` and `e2e`. A path that starts with one of those
# is unambiguously repository-relative, so it can be resolved without guessing.
# `bin/` is deliberately NOT among them and that is a measurement rather than a
# preference: `bin/rails`, `bin/dev`, `bin/setup` and `bin/demo` are each a
# DEMO'S binstub, resolved relative to the app being run, and a repo-root reading
# of them is wrong in 100-plus places — the rule would have to be switched off
# within the hour. Anything under `bin/` therefore stays unchecked here, and that
# gap is stated rather than hidden.
#
# IT APPLIES IN EVERY SCOPE, `spec/` INCLUDED, because it is the one rule in
# this file that is not about WHO is reading: a dangling path is equally wrong
# for the maintainer, the adopter and the stranger.
#
# WHAT MAKES IT SAFE, measured at head when it was written over the 936 files in
# scope: 209 path tokens resolve and 3 distinct ones did not, at 5 sites — the
# two that reopened K-1409, a stale `lib/prove_key.rb` in two files that named a
# path a move had emptied (K-1504), and one extensionless `e2e/README`. Zero
# false positives. Its vacuity arm asserts the RESOLVING count is non-zero,
# because a pattern that stopped matching paths would print the same clean line
# as a repository with no dangling ones.
#
# ── C1: THE `used to` CENSUS — PRINTED, NEVER RED ──────────────────────────
#
# `used to be` is a rule (R6) because the copula has no live reading here. A
# bare `used to` has two readings and no lexical fork between them, so this
# guard prints every one it finds, in the same three scopes, and the exit code
# never moves. A count that is printed and never enforced is the honest shape
# for a residue with two readings: an honest number is worth more than a gate
# somebody switches off because it reddens on correct prose.
#
# WHY A CENSUS RATHER THAN A DECLARED GAP, decided on a measurement rather than
# on taste. The gap was declared here in prose when R6 was written, and a
# declared gap finds nothing — a sentence nobody greps for is a sentence nobody
# reads. Re-measured word-bounded across these three scopes, `git grep -nP` with
# pathspecs ending in `/*`: SIX lines. Four are the ordinary passive, one is a
# vendored mirror this repository cannot repair (below), and the sixth is a
# genuine archaeology paragraph in a shipped demo script that the declared gap
# had not surfaced. Six rows is not a backlog; it is a list a human reads once.
#
# WHY THE WORD BOUNDARY IS PART OF THE PATTERN AND NOT A DETAIL: unbounded,
# `used to` also matches the tail of «ref-used to», «ab-used to», «ca-used to».
# The first of those is live in this repository today, and counting it made the
# gem figure four where three is right.
#
# ── C2: `retired` AND THE PLUPERFECT — PRINTED, NEVER RED (K-1510) ─────────
#
# R6 is a LEXICAL PROXY over a fixed word list, and a fixed list is a blind spot
# waiting for the corpus to grow into it. It did: four shipped surfaces narrated
# a retired element in words the list does not carry — the adjective «retired»
# and the pluperfect «it had been» — and the guard was green on all four.
#
# THE INSTRUMENT WAS CHOSEN BY MEASUREMENT, NOT BY TASTE, and the measurement
# says a ban would be wrong. Read by THIS SCRIPT over its own four scopes at the
# head that added it — which is the file set that matters, and it is wider than
# a hand-run pathspec: `retired` stands at SIX lines and every one of them is
# LIVE —
#
#   * `kiosk-pow/README.md` and `kiosk-pow/kiosk-pow.gemspec` call that gem the
#     «Retired / optional» backend. That is the gem's status TODAY, on a gem an
#     adopter can still add to a Gemfile; it is what stops them picking it.
#   * `kiosk-server/lib/kiosk/server/open_api.rb` says «`params` is the RETIRED
#     slot and is published as null». The slot is IN the document a reader
#     fetches, and this sentence is what tells them what they will find in it.
#   * `deploy/README.md` says `box-prep-…sh` «strips the retired
#     KIOSK_POW_DEMO/… flags that current code refuses at boot». The word is
#     load-bearing and the caveat is live: the flags are gone from the code and
#     may still be in a box's env file, which is why the script exists.
#   * `deploy/Caddyfile` warns that «the retired live limit was 1 req/s … and
#     neither number has a recorded derivation» — a bound an operator may still
#     be running.
#   * `deploy/check-live-hsts.sh` says «THIS SCRIPT IS NOT RETIRED BY THAT and
#     must not be», which is a maintainer rule addressed to a future editor and
#     is the shape the R5/R6 header already declares must never redden.
#
# A rule that reddened on those six would demand six repairs that each make the
# document worse, which is the definition of a gate somebody switches off.
# The pluperfect is the same story one degree weaker: `had been` stands at
# THREE, and one of them — philslist's red-team beat, «nothing in the response
# saying the filter had been discarded» — is an assertion about what the server
# does NOW, phrased in the tense the attack needs.
#
# THOSE NINE ARE A READING OF ONE DAY AND THE CENSUS RE-DERIVES THEM ON EVERY
# RUN. Read the rows the script prints, not this paragraph.
#
# AND THE WIDER RETIREMENT VOCABULARY IS NOT EVEN A CANDIDATE, which is the
# other half of why this is a census. Over the same file set: «once» 286,
# «old» 244, «deprecat» 59, «no longer» 47, «legacy» 32, «originally» 9. Those
# are ordinary English in a repository that documents its own design at length.
# The lesson R6's header already states — «every marker in it was chosen because
# it has no reading in which a live sentence needs it» — is what keeps that list
# SHORT, and this census is where the rest of the vocabulary goes.
#
# WHAT A CENSUS ROW DOES NOT MEAN. It is not a finding. Most rows are the
# passive and want nothing done. And a row inside a VENDORED SCHEMA MIRROR is
# not repairable from this side at all — the mask above leaves only the member
# `bin/check-spec-schemas` exempts, so anything a census row can still name in
# such a file is the provenance marker this repository itself wrote. Such rows
# are labelled where they are printed rather than silently dropped, because a
# reader who cannot see them cannot know the sentence exists at all.
#
# ── WHAT R5 AND R6 MUST NOT REDDEN ON, AND WHY EACH IS SAFE ────────────────
#
#   * `CHANGELOG.md` — the sanctioned afterlife, in this repository and in each
#     gem. It is outside every scope glob above; a self-test arm asserts that
#     rather than trusting it.
#   * the repository journal — the same file.
#   * a live caveat a reader can still meet, and a maintainer rule addressed to
#     a future editor. The 21 `kiosk-demo-*/public/*.html` signpost pages are
#     the standing example (upheld deliberately on K-1459) and are outside the
#     demo scope, which reads `app lib script config db` and four root files;
#     an arm asserts no `public/` path reaches it.
#   * a schema this repository VENDORS from kiosk.tech. `bin/check-spec-schemas`
#     holds eight files byte-equal to what that repository publishes, so a
#     sentence in one is not repairable from this side — scrubbing it here
#     would make the mirror stop mirroring. Everything but the member THAT
#     guard exempts is masked, in BOTH homes, and two vacuity arms re-read it:
#     one fails if it ever mirrors a path this mask does not cover, the other
#     if it stops naming a member at all, which would leave this file guessing
#     which bytes are ours.
#
# Both rules read every file as lines, so `.md`, `.json`, `.erb` and `.tt` are
# covered as well as Ruby. For a RUBY file the hit is additionally CLASSIFIED
# by Ripper, because the two halves need different remedies and the message
# should say which: an id inside a string, a symbol or an identifier reaches a
# caller's screen and the fix is to say what the control IS, while an id in a
# comment is prose and the fix is to drop the citation and keep the sentence.
# `^\s*#` cannot answer that question — a `#` inside a string or a heredoc is
# not a comment and a trailing comment is not at the start of a line — and both
# mistakes are silent. A Ruby file this script cannot lex is an ERROR rather
# than a skip, the same fail-open discipline the other guards here use.
#
# ── THE VACUITY ARMS, AND THE POLARITY THEY EXIST FOR ────────────────────────
#
# This is a BAN, so «no violations» is the tree being clean rather than the
# rule being switched off, and the two look identical from outside. Three
# things are therefore asserted about the MECHANISM instead:
#
#   * the scope is non-empty — gems found, files read, Ruby files LEXED. A glob
#     that stops matching, or a lexer that stops running, prints the same clean
#     zero as an obeyed ban, forever.
#   * each pattern still matches the shape people write. Both are re-run over a
#     corpus that is OUTSIDE this ban and cannot honestly drain: the repository
#     journal `CHANGELOG.md` (append-only by rule, hundreds of ledger ids and
#     dozens of ADR references) and `bin/`. If `LEDGER_ID_RE` or `ADR_RE` ever
#     matches nothing there, the regex has rotted and this guard is holding
#     nothing — which is exactly how three earlier invariants in this workspace
#     covered nothing at all for their whole existence.
#
# Usage: bin/check-shipped-archaeology [--self-test]

require "ripper"

REPO = File.expand_path("..", __dir__)

# One spelling of each shape, shared by the check and by the vacuity arms, so
# there is a single thing to be wrong about rather than two that rot apart.
LEDGER_ID_RE = /\b[KT]-\d{3,4}\b/
ADR_RE       = /\bADR-\d{4}\b/
CYRILLIC_RE  = /[Ѐ-ӿ]/
MAINTAINER_RE = /\bPhil\b/

# The wire this repository speaks TODAY, read out of the tree. Anything strictly
# below it is a wire nobody reading this has used.
WIRE_VERSION_FILE = File.join(REPO, "kiosk-core", "lib", "kiosk", "protocol.rb")

def current_wire
  src = File.read(WIRE_VERSION_FILE, encoding: "UTF-8")
  m = src.match(/^\s*API_VERSION\s*=\s*"(\d+)\.(\d+)/)
  raise "check-shipped-archaeology: no API_VERSION in #{WIRE_VERSION_FILE}" if m.nil?

  [m[1].to_i, m[2].to_i]
end

# Every MAJOR.MINOR below the current one, as regex alternatives. A lower MAJOR
# is banned at every minor (`\d+`); the current major only below the current
# minor. Derived, so a wire bump widens the ban with no edit here.
def retired_wire_alternatives
  major, minor = current_wire
  alts = (0...major).map { |m| "#{m}\\.\\d+" }
  alts << "#{major}\\.(?:#{(0...minor).to_a.join('|')})" if minor.positive?
  alts
end

# A quantity is not a version: `~0.3 ms`, `~0.2 s`, `44 MiB`. A longer number is
# not one either, on the left (`127.0.0.1`) or on the right (`0.1.0`,
# `skill-v0.4.12.md`).
WIRE_UNIT = "ms|s|sec|secs|seconds?|min|mins|h|hr|hrs|%|[KMG]i?B|kB"

def retired_wire_re
  alts = retired_wire_alternatives
  return nil if alts.empty?

  Regexp.new("(?<![\\d.])(?:#{alts.join('|')})(?![.\\d])(?!\\s*(?:#{WIRE_UNIT})\\b)")
end

RETIRED_WIRE_RE = retired_wire_re

# A construction that announces a past state. A LEXICAL PROXY — see the header
# for what is deliberately absent from it and why.
PAST_NARRATION_RE =
  /\b(?:formerly|previously(?!-)|historically|until\s+recently|(?<!-)used\s+to\s+be|
       before\s+the\s+fix|cutover|has\s+since\s+been)\b/ix

# A repository-relative path, recognised by a prefix that EXISTS at the root.
# Derived so a new gem or demo is covered the day it lands; `bin/` is excluded
# for the reason the header gives (every `bin/<x>` in this tree is a demo's own
# binstub). The trailing class refuses a closing `.` or `/` so a path at the end
# of a sentence — «see e2e/README.md.» — resolves as the file rather than as a
# miss.
def repo_path_prefixes
  (Dir.glob(File.join(REPO, "kiosk-*")) + [File.join(REPO, "deploy"), File.join(REPO, "e2e")])
    .select { |d| File.directory?(d) }
    .map { |d| File.basename(d) }
    .uniq
    .sort
end

REPO_PATH_PREFIXES = repo_path_prefixes.freeze

REPO_PATH_RE =
  Regexp.new("(?<![\\w/.@-])(?:#{REPO_PATH_PREFIXES.map { |p| Regexp.escape(p) }.join('|')})" \
             "/[A-Za-z0-9._@/-]*[A-Za-z0-9_@-]")

# The tokens on one line that name nothing. `File.exist?` and not `git ls-files`
# on purpose: a path this repository generates but does not track (`e2e/.gems`,
# a demo's `tmp/`) is still a path a reader can follow.
def unresolved_paths(line)
  line.scan(REPO_PATH_RE).uniq.reject { |t| File.exist?(File.join(REPO, t)) }
end

# `scopes` is which published surface each rule speaks for. R4 reaches every
# scope but the demos, for the reason given in the header: one demo is NAMED
# after the maintainer.
RULES = [
  { id: "R1", re: LEDGER_ID_RE,  scopes: %i[gem demo e2e], what: "a ledger id",
    none: "no ledger id" },
  { id: "R2", re: ADR_RE,        scopes: %i[gem demo e2e], what: "an ADR reference",
    none: "no ADR reference" },
  { id: "R3", re: CYRILLIC_RE,   scopes: %i[gem demo spec demo_spec e2e], what: "Cyrillic prose",
    none: "no Cyrillic" },
  { id: "R4", re: MAINTAINER_RE, scopes: %i[gem spec e2e], what: "the maintainer named in prose",
    none: "no maintainer named in prose" },
  { id: "R5", re: RETIRED_WIRE_RE, scopes: %i[gem demo e2e deploy], what: "a retired wire version",
    none: "no retired wire version", prose_only: true },
  { id: "R6", re: PAST_NARRATION_RE, scopes: %i[gem demo e2e deploy],
    what: "a sentence narrating a past state", none: "no narration of a past state" },
  { id: "R7", re: REPO_PATH_RE, scopes: %i[gem demo spec demo_spec e2e deploy], resolve: true,
    what: "a repository path that does not exist", none: "no dangling repository path" }
].freeze

# A bare `used to`, with the copula excluded because R6 already fails on it and
# one sentence must not be reported twice. TWO boundary conditions, and both
# were bought with a false row: `\b` keeps the pattern off the tail of
# `refused to`, which is live in a shipped controller; `(?<!-)` keeps it off
# the tail of a HYPHENATED COMPOUND — «being cross-used to mint anything else»
# is one hyphenated verb followed by an infinitive, and a hyphen IS a word
# boundary, so the first condition let the second shape straight through. A
# census is only worth its cost while every row it prints is worth reading.
BARE_USED_TO_RE = /\b(?<!-)used\s+to\b(?!\s+be\b)/i

# The two idioms that walked through R6's fixed word list (K-1510). Counted and
# never banned, for the reason the census section above measures: every live
# occurrence of `retired` in this tree is a STATUS or a live caveat, not a
# narration, and a rule would demand three repairs that make the document worse.
RETIRED_OR_PLUPERFECT_RE = /\b(?:retired|had\s+been)\b/i

# Counted, never banned. Same shape as a rule so `scan` can take it unchanged;
# `read:` is the adjudication note printed beside each row, per census rather
# than shared, because the two readings a reader has to separate are different.
CENSUS = [
  { id: "C1", re: BARE_USED_TO_RE, scopes: %i[gem demo e2e deploy],
    what: "a bare `used to`", none: "no bare `used to`",
    read: "the passive «employed in order to» wants nothing done; «X used to Y» is " \
          "archaeology and wants the present tense" },
  { id: "C2", re: RETIRED_OR_PLUPERFECT_RE, scopes: %i[gem demo e2e deploy],
    what: "`retired` or the pluperfect `had been`",
    none: "no `retired` and no pluperfect `had been`",
    read: "a STATUS («this gem is the retired backend») and a live caveat («strips the " \
          "retired flags a box may still carry») both want nothing done; «the retired X " \
          "did Y» is archaeology and wants deleting, with one changelog line as its " \
          "whole afterlife" }
].freeze

def rules_for(scope) = RULES.select { |r| r[:scopes].include?(scope) }
def census_for(scope) = CENSUS.select { |r| r[:scopes].include?(scope) }

# `spec.authors` is where a gem states its author, and RubyGems reads it. It is
# the one place R4 does not reach; every other mention is prose.
AUTHORS_RE = /^\s*spec\.authors\s*=/

# A live TODO/FIXME is REQUIRED to carry its id — see the exemption list above.
TODO_RE = /\b(?:TODO|FIXME)\b/

# The corpus the vacuity arms re-run the patterns against: outside the ban,
# append-only, and Phil-exempt, so it cannot drain for an honest reason.
def vacuity_corpus
  ([File.join(REPO, "CHANGELOG.md")] + Dir.glob(File.join(REPO, "bin", "*")))
    .select { |p| File.file?(p) }
    .sort
end

# ── the scope ───────────────────────────────────────────────────────────────

def shipped_gems
  Dir.glob(File.join(REPO, "kiosk-*"))
     .select { |d| File.directory?(d) }
     .reject { |d| File.basename(d).start_with?("kiosk-demo-") }
     .sort
end

# THE TWO PACKAGED FILES THIS GUARD DOES NOT READ, each for its own reason.
# `CHANGELOG.md` is the SANCTIONED AFTERLIFE of everything R6 bans — one line
# per retirement is the whole point — and it is append-only, so a hit there
# asks for a repair nobody may make; a self-test arm asserts it is in no scope
# at all. `LICENSE.txt` is verbatim Apache-2.0 text: not ours to edit either.
GEM_NOT_READ = %w[CHANGELOG.md LICENSE.txt].freeze

# THE SHIPPED SET IS `spec.files`, NOT A GLOB THAT RESEMBLES IT (K-1511).
#
# This used to glob `lib/**` and `app/**` and add `README.md` and the gemspec —
# a list, written down, matching what most gems package. What an adopter
# actually receives is whatever that gem's `spec.files` names, and the two are
# not the same set: MEASURED at head, SEVEN packaged regular files across three
# gems were outside the glob and therefore held by nothing — `kiosk-pow`'s and
# `kiosk-pow-cuckoo`'s `solve*.py` and `requirements.txt`, and
# `kiosk-pow-equihash`'s `solve.py` and its `bench/` pair. Every one of them is
# inside the `.gem` a stranger installs, which is the receiver this whole file
# is written for, and `kiosk-pow-equihash/solve.py` is additionally the file
# four published skill cuts pin by URL. Nothing was lost in the other
# direction: the glob named no packaged file the gemspec does not (0 at head).
#
# The gemspecs call `Dir.glob`, which resolves against CWD, so the load has to
# happen from inside the gem directory — the same reason `bin/check-gem-packaging`
# builds each gem from its own dir. That script remains the authority on whether
# `spec.files` is COMPLETE; this one only reads what it names.
def gem_spec_for(gem_dir)
  @gem_specs ||= {}
  @gem_specs[gem_dir] ||= begin
    name = File.basename(gem_dir)
    spec = Dir.chdir(gem_dir) { Gem::Specification.load("#{name}.gemspec") }
    if spec.nil?
      abort("check-shipped-archaeology: #{name}/#{name}.gemspec did not load, so the shipped " \
            "set of that gem cannot be derived. A scope this guard cannot read is a hole, " \
            "not a pass.")
    end
    spec
  end
end

def shipped_files(gem_dir)
  name = File.basename(gem_dir)
  (gem_spec_for(gem_dir).files + ["#{name}.gemspec"]).uniq
    .reject { |rel| GEM_NOT_READ.include?(rel) }
    .map { |rel| File.join(gem_dir, rel) }
    .select { |p| File.file?(p) }
    .sort
end

# The gems' own spec/ directories. These do NOT ship — every gemspec globs
# `lib/**/*`, so nothing here reaches a `gem install` — but the repository is
# public, and a stranger who clones it reads them. Only R3 and R4 apply: a
# ledger id or an ADR reference is a note between maintainers on a developer
# surface and stays (that is T-186's declared exemption), while a Russian
# sentence is unreadable to most of the people this repository is published
# for and an attributed ruling asks them to trust a stranger's judgement in
# place of the property the example pins.
def spec_dirs
  (Dir.glob(File.join(REPO, "kiosk-*")) - Dir.glob(File.join(REPO, "kiosk-demo-*")))
    .select { |d| File.directory?(File.join(d, "spec")) }
    .sort
end

def spec_files(gem_dir)
  Dir.glob(File.join(gem_dir, "spec", "**", "*"))
    .select { |p| File.file?(p) && DEMO_EXTS.include?(File.extname(p)) }
    .sort
end

def demo_dirs
  Dir.glob(File.join(REPO, "kiosk-demo-*")).select { |d| File.directory?(d) }.sort
end

# A DEMO's own spec/ and test/ trees (K-1509). The `spec` scope above subtracts
# the demos and the demo file set names neither directory, so between them they
# left these files in no scope at all — held by nothing, in a repository that is
# published. The receiver is the gem-spec receiver: a stranger reading the tests
# to find out what the example actually promises.
DEMO_SPEC_ROOTS = %w[spec test].freeze

def demo_spec_dirs
  demo_dirs.select { |d| DEMO_SPEC_ROOTS.any? { |r| File.directory?(File.join(d, r)) } }
end

def demo_spec_files(demo_dir)
  DEMO_SPEC_ROOTS
    .flat_map { |r| Dir.glob(File.join(demo_dir, r, "**", "*")) }
    .select { |p| File.file?(p) && DEMO_EXTS.include?(File.extname(p)) }
    .sort
end

# The end-to-end harness. One directory, so `dirs` is a list of one — the
# SCOPES table wants a per-directory shape and there is no reason to give this
# one a different one.
E2E_ROOT = File.join(REPO, "e2e").freeze
E2E_EXTS = %w[.md .sh .rb .json].freeze

def e2e_dirs
  File.directory?(E2E_ROOT) ? [E2E_ROOT] : []
end

# `e2e/.gems/` is the installed bundle and `e2e/tmp/` is the generated app.
# `Dir.glob` does not match a leading dot, so `.gems` is already outside this
# glob; the reject is written down anyway so the boundary is a decision rather
# than a property of the globber, and a self-test arm holds it.
def e2e_files(root)
  Dir.glob(File.join(root, "**", "*"))
    .reject { |p| p.include?("/.gems/") || p.include?("/tmp/") }
    .select { |p| File.file?(p) && E2E_EXTS.include?(File.extname(p)) }
    .sort
end

# The fleet runbook. Every file here is text — the runbook, the checklist, the
# Caddy template (no extension), the unit file, the SQL and the `.env.example`
# set — so the extension list is a statement about what is THERE rather than a
# filter against binaries, and a self-test arm re-derives the tracked set from
# git and fails when something falls outside it.
DEPLOY_ROOT = File.join(REPO, "deploy").freeze
DEPLOY_EXTS = %w[.md .sh .sql .service .example .conf .yml .json .txt].freeze

def deploy_dirs
  File.directory?(DEPLOY_ROOT) ? [DEPLOY_ROOT] : []
end

def deploy_files(root)
  Dir.glob(File.join(root, "**", "*"))
    .select { |p| File.file?(p) && (DEPLOY_EXTS.include?(File.extname(p)) ||
                                    File.extname(p).empty?) }
    .sort
end

# A vendored mirror is read for its local `$comment` and nothing else — see
# the header. Masking the other lines rather than skipping the file keeps the
# reported line number honest. BOTH homes: `bin/check-spec-schemas` mirrors
# seven schemas into `e2e/schemas` and one into `kiosk-server/lib`, and a
# self-test arm re-reads THAT script's manifest and fails if it ever mirrors a
# path this pattern does not cover — so the two homes are a pattern here and a
# derivation there, rather than a list nobody re-checks.
VENDORED_MIRROR_RE = %r{/(?:e2e|kiosk-server/lib/kiosk/server)/schemas/[^/]+\.schema\.json\z}

# The paths `bin/check-spec-schemas` holds byte-equal to what kiosk.tech
# publishes. Read out of that script rather than restated, for the vacuity arm.
def mirrored_paths
  src = File.read(File.join(REPO, "bin", "check-spec-schemas"), encoding: "UTF-8")
  src.scan(/File\.join\(REPO,\s*"([^"]+\.schema\.json)"\)/).flatten.uniq
end

# WHICH `$comment` IS OURS — DERIVED FROM THE GUARD THAT FREEZES THE REST, NOT
# RE-TYPED HERE. `bin/check-spec-schemas` compares the PARSED documents after
# removing named members from each side, and those members — and only those —
# are the bytes of a mirror this repository may change. A second answer typed
# here is a second thing to be wrong about: while this file assumed EVERY
# `$comment` line was ours and that script exempted only the top-level one, the
# gap between the two masks was a trap where R5 or R6 could demand a repair
# `check-spec-schemas` fails on, leaving a red tree with no legal move from
# inside this repository. Same "derive it, do not re-type it" move R5 makes for
# the wire version.
def exempt_mirror_members
  src = File.read(File.join(REPO, "bin", "check-spec-schemas"), encoding: "UTF-8")
  members = src.scan(/^\s*(?:local|upstream)\.delete\("([^"]+)"\)/).flatten.uniq
  if members.empty?
    raise "check-shipped-archaeology: bin/check-spec-schemas names no member it removes " \
          "before comparing a vendored mirror with the published original, so this guard " \
          "cannot know which bytes of a mirror are ours. Re-point exempt_mirror_members at " \
          "however that script now spells the carve-out; do not guess."
  end
  members
end

EXEMPT_MIRROR_MEMBERS = exempt_mirror_members.freeze

# The nesting depth at the START of each line. A JSON string cannot contain a
# newline, so a per-line tally of the brackets outside string literals answers
# it exactly — and it is the only thing that separates a TOP-LEVEL `$comment`,
# which is the provenance marker this repository writes, from a NESTED one,
# which is a byte of the schema kiosk.tech publishes. The two are identical on
# their own line.
def json_line_depths(src)
  depth = 0
  src.each_line.map do |line|
    at_start = depth
    in_string = false
    escaped = false
    line.each_char do |c|
      if in_string
        if escaped        then escaped = false
        elsif c == "\\"   then escaped = true
        elsif c == '"'    then in_string = false
        end
        next
      end
      case c
      when '"'       then in_string = true
      when "{", "["  then depth += 1
      when "}", "]"  then depth -= 1
      end
    end
    at_start
  end
end

def rule_source(path)
  src = File.read(path, encoding: "UTF-8", invalid: :replace, undef: :replace)
  return src unless path.match?(VENDORED_MIRROR_RE)

  keys   = EXEMPT_MIRROR_MEMBERS.map { |m| /\A\s*"#{Regexp.escape(m)}"\s*:/ }
  depths = json_line_depths(src)
  src.each_line.with_index
     .map { |l, i| depths[i] == 1 && keys.any? { |re| l.match?(re) } ? l : "\n" }
     .join
end

# Text only: `config/` also holds `credentials.yml.enc` and `*.key`, and a
# byte-scan of those answers a question nobody asked.
DEMO_ROOTS = %w[app lib script config db].freeze
DEMO_TOP   = %w[Rakefile config.ru README.md before-after.md].freeze
DEMO_EXTS  = %w[.rb .rake .ru .erb .yml .sql .md .json .tt .txt .html].freeze

def demo_files(demo_dir)
  (DEMO_ROOTS.flat_map { |r| Dir.glob(File.join(demo_dir, r, "**", "*")) }
     .select { |p| DEMO_EXTS.include?(File.extname(p)) } +
   DEMO_TOP.map { |n| File.join(demo_dir, n) })
    .select { |p| File.file?(p) }
    .sort
end

def ruby_file?(path)
  path.end_with?(".rb", ".rake", ".ru", ".gemspec") || File.basename(path) == "Rakefile"
end

# Shell and Python have no lexer here and do not need one: R5's only question
# of such a line is whether the number it carries is a sentence or an argument,
# and a leading `#` answers that in both languages. A trailing comment after
# code is read as code, which is the conservative direction — it can only SKIP
# a hit, never invent one, and R5 is the only prose-only rule.
#
# `.py` JOINED THIS THE DAY THE GEM SCOPE STOPPED BEING A GLOB (K-1511). Four
# Python files ship inside three gems and were in no scope at all; the moment
# they were read, `def one_run(n, k, timeout, mem_cap_mb, poll=0.1)` was a
# RETIRED WIRE VERSION named in prose, because "everything else is read as
# prose" and Python was everything else. A keyword default is a number the code
# uses — the exact shape the R5 header says must never redden — so the language
# whose comment marker is `#` is named here rather than left to the default.
HASH_COMMENT_EXTS = %w[.sh .py].freeze

def hash_comment_file?(path) = HASH_COMMENT_EXTS.include?(File.extname(path))

# ── A MARKDOWN TABLE PUTS THE UNIT IN THE COLUMN HEADER (K-1511) ────────────
#
# R5 already exempts `~0.3 ms` and `~0.2 s`: a token carrying a unit is a
# duration or a size, not a wire. A table states that unit ONCE, in the header
# row, and every cell under it is then a bare number — `| p50 s |` over
# `| **0.2** |`. Without this the same quantity is exempt inline and a
# violation in a table, which makes R5 a rule about typography rather than
# about sentences. It surfaced with the scope: `kiosk-pow-equihash/bench/README.md`
# is packaged and its measured grid has a `p50 s` and a `p95 s` column.
#
# The unit vocabulary is the SAME `WIRE_UNIT` list the inline exemption uses,
# so the two cannot drift. And it exempts the CELL, never the row: in the very
# table that motivated it the `note` column is still read as prose, so a
# retired wire named in a table's sentence column is still a violation.
UNIT_HEADER_RE = /(?:\A|[\s(\[])(?:#{WIRE_UNIT})[)\]]?\z/

def md_cells(line)
  l = line.strip
  return nil unless l.start_with?("|") && l.count("|") >= 2

  l.sub(/\A\|/, "").sub(/\|\z/, "").split("|", -1)
end

def md_separator_row?(cells) = cells.all? { |c| c.strip.match?(/\A:?-{2,}:?\z/) }

# lineno => the header row's per-column «this column names a unit» flags, for
# every BODY row of every table in the file. A line that is not a table body
# row is absent, and absent means «not exempt».
def md_unit_columns(src)
  cols   = {}
  header = nil
  src.each_line.with_index(1) do |line, lineno|
    cells = md_cells(line)
    if cells.nil?
      header = nil
      next
    end
    if header.nil?
      header = cells.map { |c| c.strip.match?(UNIT_HEADER_RE) }
      next
    end
    next if md_separator_row?(cells)

    cols[lineno] = header
  end
  cols
end

# True when EVERY occurrence of this rule's pattern on the line sits in a cell
# whose column header names a unit. One occurrence in a prose column and the
# line is read as prose, which is what keeps the `note` column live.
def md_unit_cell_only?(line, flags, regexp)
  return false if flags.nil?

  cells = md_cells(line)
  return false if cells.nil? || cells.size != flags.size

  cells.each_with_index.none? { |c, i| !flags[i] && c.match?(regexp) }
end

# ── the scan ────────────────────────────────────────────────────────────────

Hit = Struct.new(:path, :line, :rule, :where, :text)

# Every rule violation in one file, with a Ruby file's hits classified as
# :comment or :code. Returns [hits, lexed] — `lexed` is false when the file is
# Ruby, carries a hit, and Ripper could not read it.
def scan(path, rules = RULES)
  src = rule_source(path)
  return [[], true] unless rules.any? { |r| src.match?(r[:re]) }

  # PER RULE, not per line: two rules can both match a line while only one of
  # them matches a code TOKEN on it, and a shared flag would report the other
  # as :code. That mattered the moment R5 arrived, because R5 is the one rule
  # that ACTS on the classification.
  code_lines  = Hash.new { |h, k| h[k] = {} }
  token_lines = {}
  lexed = true
  if ruby_file?(path)
    tokens =
      begin
        Ripper.lex(src)
      rescue StandardError
        nil
      end
    if tokens.nil? || tokens.empty?
      lexed = false
    else
      tokens.each do |(pos, type, tok, _state)|
        token_lines[pos[0]] = true
        next if type == :on_comment

        rules.each { |r| code_lines[r[:id]][pos[0]] = true if tok.to_s.match?(r[:re]) }
      end
    end
  end

  # Per FILE, because the answer is a property of the table's header row rather
  # than of the line carrying the hit.
  unit_cols = File.extname(path) == ".md" ? md_unit_columns(src) : {}

  hits = []
  src.each_line.with_index(1) do |line, lineno|
    next if line.match?(TODO_RE)

    rules.each do |rule|
      next unless line.match?(rule[:re])
      # The one place a gem states its author, and RubyGems reads it.
      next if rule[:id] == "R4" && line.match?(AUTHORS_RE)
      # A number under a column header that names its unit is a measurement.
      next if rule[:prose_only] && md_unit_cell_only?(line, unit_cols[lineno], rule[:re])

      # A resolving rule matches a SHAPE and is only a violation when the thing
      # the shape names is absent, so the pattern alone decides nothing.
      dangling = rule[:resolve] ? unresolved_paths(line) : nil
      next if dangling&.empty?

      # A citation line the lexer never reached cannot be classified, and
      # defaulting it to :comment would be a guess dressed as an answer.
      lexed = false if ruby_file?(path) && !token_lines[lineno]

      where =
        if ruby_file?(path) then (code_lines[rule[:id]][lineno] ? :code : :comment)
        elsif hash_comment_file?(path) then (line.match?(/^\s*#/) ? :comment : :code)
        else :text
        end
      # A version token inside code is a NUMBER the code uses — `sleep 0.2`, a
      # dependency constraint. R5 is about sentences; see the header.
      next if rule[:prose_only] && where == :code

      text = dangling ? "#{dangling.join(', ')} — #{line.strip[0, 80]}" : line.strip[0, 100]
      hits << Hit.new(path.delete_prefix("#{REPO}/"), lineno, rule, where, text)
    end
  end
  [hits, lexed]
end

# Two axes: WHERE the hit is (what the reader is doing when they meet it) and
# WHAT the rule bans (what to do about it). A citation and a Russian sentence
# are both unreadable to the same stranger and neither has the same remedy.
WHERE = {
  code:    "in code this RUNS — it reaches a reader's screen",
  comment: "in a comment a reader READS",
  text:    "in prose a reader READS"
}.freeze

REMEDY = {
  "R1" => "they cannot open the ledger it names. Drop the citation and keep the sentence that " \
          "explains the code",
  "R2" => "the ADRs are in a private repository. Drop the reference and state the rule it " \
          "decided",
  "R3" => "this repository publishes in English. Say the same thing in English, as a statement " \
          "about the code rather than as a quotation",
  "R4" => "naming a maintainer asks a stranger to trust a person instead of reading a property. " \
          "State the property",
  "R5" => "no reader of this repository has met that wire. Say what the wire does NOW; the removed " \
          "one gets one changelog line and nothing else",
  "R6" => "a reader arriving today has no memory to correct. State the property in the present; if " \
          "it is a caveat they can still meet, say what they will meet",
  "R7" => "the path names nothing — a reader cannot follow it. Point at what is there now, or " \
          "drop the reference and state the property"
}.freeze

SCOPES = {
  gem: { label: "a shipped gem", dirs: -> { shipped_gems }, files: ->(d) { shipped_files(d) },
         per: "everything the gem's own `spec.files` names, plus <gem>.gemspec, " \
              "minus CHANGELOG.md and LICENSE.txt" },
  demo: { label: "a demo", dirs: -> { demo_dirs }, files: ->(d) { demo_files(d) },
          per: "app/**, lib/**, script/**, config/**, db/** (text extensions), " \
               "Rakefile, config.ru, README.md, before-after.md" },
  spec: { label: "a gem's spec/ (published, not shipped)", dirs: -> { spec_dirs },
          files: ->(d) { spec_files(d) },
          per: "spec/** (text extensions) — R3 and R4 only" },
  demo_spec: { label: "a demo's spec/ and test/ (published, not shipped)",
               dirs: -> { demo_spec_dirs }, files: ->(d) { demo_spec_files(d) },
               per: "spec/**, test/** (text extensions) — R3 only, plus R7; R4 stops at " \
                    "the door on the demo scope's own footing (one demo is NAMED after " \
                    "the maintainer, and it is the same app in both subtrees)" },
  e2e: { label: "the e2e harness", dirs: -> { e2e_dirs }, files: ->(d) { e2e_files(d) },
         per: "e2e/** (.md .sh .rb .json), minus .gems/ and tmp/; a vendored " \
              "schema mirror is read for its TOP-LEVEL `$comment` only" },
  deploy: { label: "the deploy runbook", dirs: -> { deploy_dirs },
            files: ->(d) { deploy_files(d) },
            per: "deploy/** (every tracked file) — R5, R6 and R7 only; R1–R4 stop " \
                 "at the door on `bin/`'s footing (maintainer tooling for one fleet)" }
}.freeze

def run_check
  puts "SCOPE (derived from the layout and from each gem's own `spec.files`, not listed)"
  scoped = SCOPES.to_h do |name, spec|
    dirs  = spec[:dirs].call
    files = dirs.flat_map { |d| spec[:files].call(d) }
    ruby  = files.count { |p| ruby_file?(p) }
    puts "  #{name}s".ljust(17) + ": #{dirs.size} — #{dirs.map { |d| File.basename(d) }.join(', ')}"
    puts "    files        : #{files.size} (#{ruby} Ruby, #{files.size - ruby} other)"
    puts "    per directory: #{spec[:per]}"
    [name, files]
  end
  puts "  exempt         : bin/, CHANGELOG.md, CLAUDE.md (Phil's standing exemption); " \
       "spec/, test/ for R1/R2/R5/R6 (developer surfaces; R3 and R7 reach"
  puts "                   BOTH a gem's spec/ and a demo's spec/ and test/, and R4 reaches " \
       "the gem's only);"
  puts "                   Gemfile/Gemfile.lock/mise.toml and the rest of a directory root " \
       "(not packaged, not browsed);"
  puts "                   a demo's public/, log/, tmp/, storage/ and its non-text config " \
       "(credentials keys, *.enc);"
  puts "                   any line carrying a live TODO/FIXME (the constitution requires " \
       "that marker to cite a row);"
  puts "                   e2e/.gems (the installed bundle) and e2e/tmp (the generated app); " \
       "the BODY of a vendored"
  puts "                   schema mirror in EITHER home (everything but the TOP-LEVEL " \
       "$comment bin/check-spec-schemas exempts);"
  puts "                   `spec.authors` for R4 only; and, for R5 only, a version token that " \
       "is CODE rather than prose"
  puts "                   (a float literal, a dependency constraint) — R5 and R6 do not " \
       "reach spec/ at all;"
  puts "                   deploy/ for R1-R4 on bin/'s footing (maintainer tooling for one " \
       "fleet), and anything under"
  puts "                   bin/ for R7 (every `bin/<x>` in this tree is a DEMO's binstub, " \
       "not a repo-root path)"
  puts

  if scoped.any? { |_, files| files.empty? }
    puts "FAIL: a scope is EMPTY — a ban over no files reports the same clean zero as an " \
         "obeyed one, forever."
    return 1
  end

  failed = false
  scoped.each do |scope, files|
    rules = rules_for(scope)
    hits = []
    unlexed = []
    files.each do |path|
      file_hits, lexed = scan(path, rules)
      hits.concat(file_hits)
      unlexed << path.delete_prefix("#{REPO}/") unless lexed
    end

    unless unlexed.empty?
      puts "FAIL: Ripper returned no tokens for #{unlexed.size} Ruby file(s) that carry a " \
           "citation, so this guard could not tell a comment from a string in them and did not " \
           "classify them:"
      unlexed.each { |rel| puts "  #{rel}" }
      puts "  A file this rule cannot read must not pass silently."
      failed = true
    end

    rules.each do |rule|
      mine = hits.select { |h| h.rule[:id] == rule[:id] }
      if mine.empty?
        puts "#{rule[:id]}/#{scope}. #{rule[:none]} in #{SCOPES[scope][:label]} — OK " \
             "(#{files.size} files)"
        next
      end
      failed = true
      puts "#{rule[:id]}/#{scope}. #{rule[:what]} in #{SCOPES[scope][:label]} — " \
           "#{mine.size} occurrence(s):"
      mine.each do |h|
        puts "  FAIL #{h.path}:#{h.line} — #{rule[:what]} #{WHERE[h.where]} — " \
             "#{REMEDY[rule[:id]]}: #{h.text}"
      end
    end

    # ── the census. It PRINTS and it never touches `failed`. ───────────────
    census_for(scope).each do |rule|
      seen = files.flat_map { |path| scan(path, [rule]).first }
      if seen.empty?
        puts "#{rule[:id]}/#{scope}. #{rule[:none]} in #{SCOPES[scope][:label]} — census " \
             "empty (#{files.size} files)"
        next
      end
      puts "#{rule[:id]}/#{scope}. #{rule[:what]} in #{SCOPES[scope][:label]} — " \
           "#{seen.size} occurrence(s), CENSUS ONLY, never red. Read it: #{rule[:read]}."
      seen.each do |h|
        upstream = "/#{h.path}".match?(VENDORED_MIRROR_RE) ?
                     " [vendored mirror — upstream's byte, not repairable from this side]" : ""
        puts "  WARN #{h.path}:#{h.line}#{upstream} — #{WHERE[h.where]}: #{h.text}"
      end
    end
  end

  failed ? 1 : 0
end

# ── self-test ───────────────────────────────────────────────────────────────

def self_test
  require "tmpdir"
  require "fileutils"
  failures = []

  check = lambda do |name, ok|
    puts(ok ? "  ok   #{name}" : "  FAIL #{name}")
    failures << name unless ok
  end

  Dir.mktmpdir("shipped-archaeology-selftest") do |dir|
    plant = lambda do |name, basename, body|
      path = File.join(dir, basename)
      File.write(path, body)
      [name, path]
    end

    # ── one planted RED arm per rule, in each place a citation can hide ──────
    [
      ["R1 in a Ruby comment",
       "a.rb", "# frozen_string_literal: true\n\n# The past-slot filter, K-480.\ndef f = 1\n",
       :comment],
      ["R1 in a Ruby string (code)",
       "b.rb", "MSG = \"blocked by K-072\"\n", :code],
      ["R1 in a Ruby symbol (code)",
       "c.rb", "SYM = :\"K-1035\"\n", :code],
      ["R1 in a trailing comment after code",
       "d.rb", "VALUE = 1 # widened by T-158\n", :comment],
      ["R2 in a Ruby comment",
       "e.rb", "# The refusal shape is fixed by ADR-0018.\ndef f = 1\n", :comment],
      ["R2 in a Ruby string (code)",
       "f.rb", "MSG = \"see ADR-0007\"\n", :code],
      ["R1 in a Markdown README",
       "README.md", "The wire error contract (T-054) is closed.\n", :text],
      ["R1 in a JSON schema description",
       "g.json", "{ \"description\": \"the toll, K-512\" }\n", :text],
      ["R1 in an ERB template comment",
       "h.html.erb", "<%# The access line is a CONSENT field (K-072). %>\n", :text],
      ["R1 in a generator template",
       "i.rb.tt", "# Emitted into the host app (K-830).\n", :text],
      ["R3 quoted Russian in a Ruby comment",
       "j.rb", "# The trade-off, weighed: «пусть будет 1m».\ndef f = 1\n", :comment],
      ["R3 Cyrillic in a Ruby string (code)",
       "k.rb", "MSG = \"это паблик\"\n", :code],
      ["R3 Cyrillic in a Markdown README",
       "README.md", "Убери из демок всю археологию.\n", :text],
      ["R4 the maintainer named in a Ruby comment",
       "l.rb", "# Phil accepted this control's weakness openly.\ndef f = 1\n", :comment],
      ["R5 a retired wire version in a Ruby comment",
       "p.rb", "# Through 0.3 every read was one POST endpoint.\ndef f = 1\n", :comment],
      ["R5 a retired wire version in a Markdown narrative",
       "README.md", "The 0.3 name-dispatch endpoints are gone.\n", :text],
      ["R5 a retired wire version in a shell comment",
       "q.sh", "#!/usr/bin/env bash\n# the 0.3 envelope carried an `ok` wrapper.\n", :comment],
      ["R6 a past state narrated in a Ruby comment",
       "r.rb", "# It moved here at the cutover, in one wave.\ndef f = 1\n", :comment],
      ["R6 a past state narrated in a Markdown narrative",
       "README.md", "The published field was formerly named `zone`.\n", :text],
      ["R6 `used to be` in a Ruby comment",
       "s.rb", "# It used to be that the caller could not say which day.\ndef f = 1\n", :comment]
    ].each do |name, basename, body, expected_where|
      _, path = plant.call(name, basename, body)
      hits, lexed = scan(path)
      check.call("detects #{name}", !hits.empty? && lexed)
      next if hits.empty?

      check.call("…and classifies it as #{expected_where}", hits.first.where == expected_where)
    end

    # ── the exemption, and the pattern's own boundaries ──────────────────────
    _, todo = plant.call("todo", "todo.rb", "# TODO(K-1099): widen the filter.\ndef f = 1\n")
    check.call("does NOT flag a live TODO carrying its required id", scan(todo).first.empty?)

    _, fixme = plant.call("fixme", "fixme.rb", "# FIXME: T-186 — narrow this.\ndef f = 1\n")
    check.call("does NOT flag a live FIXME carrying its required id", scan(fixme).first.empty?)

    _, clean = plant.call("clean", "clean.rb", <<~RUBY)
      # frozen_string_literal: true

      # The past-slot filter refuses a booking whose start has gone by. OK-1234
      # is a fixture id, RFC 8628 is a standard, and CVE-2021-0001 is neither.
      def f = 1
    RUBY
    check.call("does NOT flag OK-1234 / RFC 8628 / CVE-… (no word boundary before K)",
               scan(clean).first.empty?)

    _, short = plant.call("short", "short.rb", "# K-12 and T-9 and ADR-12 are not ledger ids.\n")
    check.call("does NOT flag too-few-digit lookalikes", scan(short).first.empty?)

    _, authors = plant.call("authors", "m.gemspec", "  spec.authors       = [\"Phil Pirozhkov\"]\n")
    check.call("does NOT flag R4 on the `spec.authors` line a gemspec is REQUIRED to carry",
               scan(authors).first.empty?)

    _, punct = plant.call("punct", "n.rb", <<~RUBY)
      # frozen_string_literal: true

      # The window is said out loud — «08:00–10:00 (Europe/Dublin)» — per §11.6,
      # and a naïve reader gets the same bytes. ← → ✓ €200.
      def f = 1
    RUBY
    check.call("does NOT flag R3 on guillemets, em dashes, §, arrows or accented Latin",
               scan(punct).first.empty?)

    _, demo_only = plant.call("demo-only", "o.rb", "# Phil's List is the board this demo serves.\n")
    check.call("R4 does not apply in the demo scope (one demo is NAMED after the maintainer)",
               scan(demo_only, rules_for(:demo)).first.empty?)
    check.call("…and DOES apply in the gem scope",
               !scan(demo_only, rules_for(:gem)).first.empty?)
    check.call("…and DOES apply in a gem's spec/ scope (K-1457)",
               !scan(demo_only, rules_for(:spec)).first.empty?)
    check.call("…and does NOT apply in a DEMO's spec/ or test/ either (K-1509) — a sentence " \
               "that is legal in Phil's List's app/ cannot be illegal in its spec/; it is " \
               "the same app and the same subject matter",
               scan(demo_only, rules_for(:demo_spec)).first.empty?)

    # ── PYTHON IS CODE, AND ITS COMMENT MARKER IS `#` (K-1511) ─────────────
    #
    # Four `.py` files ship inside three gems. Before the gem scope was derived
    # from `spec.files` they were in no scope at all; the moment they were read,
    # a keyword default `poll=0.1` was «a retired wire version in prose», which
    # is precisely the shape the R5 header says must never redden.
    _, pycode = plant.call("py code", "t.py", "def one_run(n, k, timeout, poll=0.1):\n    pass\n")
    check.call("R5 does NOT fire on a Python keyword default (`poll=0.1` is a number the " \
               "code uses, not a sentence)",
               scan(pycode).first.empty?)
    _, pycomment = plant.call("py comment", "u.py",
                              "#!/usr/bin/env python3\n# The 0.3 envelope carried an ok wrapper.\n")
    pyhits, = scan(pycomment)
    check.call("…and DOES fire on the same token in a Python COMMENT", !pyhits.empty?)
    check.call("…classified as a comment rather than as code",
               !pyhits.empty? && pyhits.first.where == :comment)

    # ── A MARKDOWN TABLE PUTS THE UNIT IN THE COLUMN HEADER (K-1511) ───────
    #
    # Three arms, because the exemption has to be keyed on the HEADER and has
    # to stop at the CELL. The middle one is the live shape in
    # kiosk-pow-equihash/bench/README.md; the third is the one that keeps this
    # from becoming «numbers in tables are never wires».
    _, tbl_unit = plant.call("md table, unit column", "tbl1.md", <<~MD)
      | n | k | p50 s | note |
      |---|---|-------|------|
      | 96 | 5 | 0.2 | the toll a first-time poker meets |
    MD
    check.call("R5 does NOT fire on a bare number under a `p50 s` column header",
               scan(tbl_unit).first.empty?)
    _, tbl_note = plant.call("md table, prose column", "tbl2.md", <<~MD)
      | n | k | p50 s | note |
      |---|---|-------|------|
      | 96 | 5 | 0.2 | measured on the 0.3 wire |
    MD
    check.call("…and DOES fire on a retired wire in the same row's PROSE column — the " \
               "exemption is per CELL, never per row",
               !scan(tbl_note).first.empty?)
    _, tbl_bare = plant.call("md table, no unit", "tbl3.md", <<~MD)
      | n | k | p50 | note |
      |---|---|-----|------|
      | 96 | 5 | 0.2 | fine |
    MD
    check.call("…and DOES fire on a bare number under a header that names NO unit — the " \
               "exemption is the header's claim, not the pipe characters",
               !scan(tbl_bare).first.empty?)

    # THE VENDORED-MIRROR MASK, both ways. The `$comment` is the harness's own
    # provenance marker and is IN scope; every other byte is the schema
    # kiosk.tech publishes and is NOT, because bin/check-spec-schemas holds it
    # equal and scrubbing it here would make the mirror stop mirroring.
    mirror_dir = File.join(dir, "e2e", "schemas")
    FileUtils.mkdir_p(mirror_dir)
    mirror = File.join(mirror_dir, "x.schema.json")
    File.write(mirror, <<~JSON)
      {
        "$comment": "VENDORED copy, K-822.",
        "description": "a normative sentence, K-1278.",
        "$defs": {
          "thing": {
            "$comment": "an upstream aside, K-1249.",
            "type": "object"
          }
        }
      }
    JSON
    mirror_hits = scan(mirror).first
    check.call("a citation in a vendored mirror's TOP-LEVEL `$comment` IS flagged — that " \
               "member is the provenance marker this repository itself writes",
               mirror_hits.any? { |h| h.line == 2 })
    check.call("…and one in the mirror's BODY is NOT — it is kiosk.tech's to remove",
               mirror_hits.none? { |h| h.line == 3 })
    check.call("…and one in a NESTED `$comment` is NOT either — bin/check-spec-schemas holds " \
               "that byte equal, so a rule firing on it would demand the one edit that guard " \
               "fails on",
               mirror_hits.none? { |h| h.line == 6 })

    # ── R5 IS PROSE-ONLY: a version token inside CODE is a number ───────────
    _, sleeper = plant.call("sleep", "sleep.rb", "def f\n  sleep 0.2\n  sleep 0.3\nend\n")
    check.call("R5 does NOT flag a float literal in Ruby code (`sleep 0.2`)",
               scan(sleeper).first.none? { |h| h.rule[:id] == "R5" })

    _, dep = plant.call("dep", "d.gemspec", %(  spec.add_development_dependency "base64", "~> 0.2"\n))
    check.call("R5 does NOT flag a gemspec dependency constraint (`~> 0.2`)",
               scan(dep).first.none? { |h| h.rule[:id] == "R5" })

    _, shcode = plant.call("shcode", "t.sh", "#!/usr/bin/env bash\nsleep 0.2\n")
    check.call("R5 does NOT flag a float literal on a shell CODE line",
               scan(shcode).first.none? { |h| h.rule[:id] == "R5" })

    _, numbers = plant.call("numbers", "n2.rb", <<~RUBY)
      # frozen_string_literal: true

      # The origin answers on 127.0.0.1 and verification costs ~0.3 ms against a
      # ~0.2 s solve in ~44 MiB. The gem is 0.1.0 and the cut is skill-v0.4.12.md;
      # the wire this speaks is 0.4 and the header says so.
      def f = 1
    RUBY
    check.call("R5 does NOT flag an IP, a timing, a size, a 3-part version, a cut or the " \
               "CURRENT wire", scan(numbers).first.none? { |h| h.rule[:id] == "R5" })

    # ── R6's declared boundaries, both of them measured ────────────────────
    _, hyphen = plant.call("hyphen", "u.rb", "# Release a previously-claimed id (compensating op).\ndef f = 1\n")
    check.call("R6 does NOT flag `previously-claimed` — a claim earlier in THIS run, not our past",
               scan(hyphen).first.none? { |h| h.rule[:id] == "R6" })

    _, passive = plant.call("passive", "v.rb", <<~RUBY)
      # frozen_string_literal: true

      # @!attribute rsa_key [OpenSSL::PKey::RSA] the key used to sign mandates,
      # for a caller the origin no longer knows about.
      def f = 1
    RUBY
    check.call("R6 does NOT flag the passive `used to` or the live `no longer` — the two " \
               "constructions the header declares ABSENT",
               scan(passive).first.none? { |h| h.rule[:id] == "R6" })

    # ── R5/R6 reach the demo and harness scopes, and NOT spec/ ─────────────
    _, cut = plant.call("cutover", "w.rb", "# Retired at the 0.3 cutover, in one wave.\ndef f = 1\n")
    rule_scopes = ->(id) { RULES.find { |r| r[:id] == id }[:scopes] }
    (rule_scopes.call("R5") & rule_scopes.call("R6")).each do |scope|
      check.call("R5 and R6 both reach the #{scope} scope",
                 %w[R5 R6].all? { |id| scan(cut, rules_for(scope)).first.any? { |h| h.rule[:id] == id } })
    end
    check.call("…and NEITHER reaches a gem's spec/ (a developer surface, like R1 and R2)",
               scan(cut, rules_for(:spec)).first.none? { |h| %w[R5 R6].include?(h.rule[:id]) })
    check.call("…nor a DEMO's spec/ or test/, which are held on the gem spec tree's footing",
               scan(cut, rules_for(:demo_spec)).first.none? { |h| %w[R5 R6].include?(h.rule[:id]) })

    # ── K-1509: the four shapes, asked of a demo's spec/ in ONE line ────────
    #
    # This is the exact plant that measured the hole — a ledger id, an ADR
    # reference, Cyrillic and the maintainer's name on one line — so the arm
    # and the finding are the same sentence.
    _, demo_spec_line = plant.call("demo-spec-four", "salon_clock_spec.rb",
                                   "# K-9999 / ADR-0029 — так решил Phil.\n")
    demo_spec_ids = scan(demo_spec_line, rules_for(:demo_spec)).first.map { |h| h.rule[:id] }.uniq
    check.call("a demo's spec/ is HELD for Cyrillic (K-1509) — it was in no scope at all, " \
               "and this line left the guard at exit 0 naming nothing",
               demo_spec_ids.include?("R3"))
    check.call("…and R1, R2 and R4 still stop at its door (the developer-surface exemption " \
               "and the demo's own R4 exemption)",
               (demo_spec_ids & %w[R1 R2 R4]).empty?)

    # ── R7: a path is a violation only when it RESOLVES to nothing ──────────
    _, gone = plant.call("r7-gone", "gone.md",
                         "Re-check it with `deploy/check-edge-ratelimit.sh` before the deploy.\n")
    r7 = ->(p) { scan(p).first.select { |h| h.rule[:id] == "R7" } }
    check.call("R7 flags a path that names nothing — the sentence that reopened this class " \
               "twice carries no R6 marker at all, so no idiom set could reach it",
               r7.call(gone).size == 1)
    check.call("…and the message NAMES the missing path rather than echoing the line",
               r7.call(gone).first.text.start_with?("deploy/check-edge-ratelimit.sh —"))

    _, live = plant.call("r7-live", "live.md",
                         "See `deploy/README.md`, `kiosk-server/lib` and e2e/run.sh.\n")
    check.call("R7 does NOT flag a path that exists, with or without backticks, and a " \
               "DIRECTORY resolves as well as a file",
               r7.call(live).empty?)

    _, stop = plant.call("r7-stop", "stop.md", "The adopter edits e2e/README.md. Then run it.\n")
    check.call("R7 does NOT flag a path that ends a sentence — the closing `.` is not part " \
               "of the name",
               r7.call(stop).empty?)

    _, binstub = plant.call("r7-binstub", "binstub.md",
                            "Run `bin/rails demo:setup`, then `bin/dev` and `bin/setup`.\n")
    check.call("R7 does NOT read `bin/<x>` as a repository path — every one in this tree is " \
               "a DEMO's own binstub, and a repo-root reading is wrong in 100-plus places",
               r7.call(binstub).empty?)

    rule_scopes.call("R7").each do |scope|
      check.call("R7 reaches the #{scope} scope — a dangling path is the one defect here " \
                 "that is not about WHO is reading",
                 scan(gone, rules_for(scope)).first.any? { |h| h.rule[:id] == "R7" })
    end

    # Ripper.lex is a LEXER, not a parser: a syntax error still yields tokens.
    # What silences it is a file it cannot tokenize at all — here, NUL bytes.
    _, unlexable = plant.call("unlexable", "broken.rb", "\0\0# K-1035\n")
    unlexable_hits, lexed = scan(unlexable)
    check.call("a Ruby file carrying a citation that Ripper cannot read is an ERROR, not a skip",
               !lexed && !unlexable_hits.empty?)

    # …and the same when the lexer reads SOME of the file but never reaches the
    # citation line, which would otherwise be silently classified :comment.
    _, truncated = plant.call("truncated", "truncated.rb", "S = \"unterminated\n# K-1035\n")
    _, part_lexed = scan(truncated)
    check.call("a citation on a line the lexer never reached is an ERROR too", !part_lexed)

    # ── C1's own arms: it must SEE the archaeology, and must not double-report
    #    or fire on the two spellings that are not it ───────────────────────
    _, arch = plant.call("c1-arch", "t.rb", "# The engine used to read the role off the wire.\n")
    check.call("C1 counts a bare `used to` narrating a past state",
               scan(arch, CENSUS).first.any? { |h| h.rule[:id] == "C1" })

    _, passive = plant.call("c1-passive", "u.rb", "# The RSA key used to sign mandates.\n")
    check.call("C1 counts the ordinary passive too — the census does NOT judge, which is " \
               "why it is not a rule",
               scan(passive, CENSUS).first.any? { |h| h.rule[:id] == "C1" })

    _, refused = plant.call("c1-refused", "v.rb", "# a grant row this endpoint just refused to " \
                                                  "accept.\n")
    check.call("C1 does NOT fire on the tail of `refused to` — the word boundary is the " \
               "difference between three hits and four",
               scan(refused, CENSUS).first.none? { |h| h.rule[:id] == "C1" })

    _, hyphenated = plant.call("c1-hyphen", "x.rb", "#   being cross-used to mint anything " \
                                                    "else a lock would accept.\n")
    check.call("C1 does NOT fire on the tail of a HYPHENATED COMPOUND — `cross-used to` is " \
               "one verb plus an infinitive, and a hyphen IS a word boundary, so the word " \
               "boundary alone let this shape through",
               scan(hyphenated, CENSUS).first.none? { |h| h.rule[:id] == "C1" })

    _, hyphcopula = plant.call("r6-hyphen", "y.rb", "# a key cross-used to be minted twice.\n")
    check.call("…and R6 does not fire on the same compound before `be` — a false RED there " \
               "would be a repair nobody can make",
               scan(hyphcopula).first.none? { |h| h.rule[:id] == "R6" })

    _, copula = plant.call("c1-copula", "w.rb", "# It used to be that the caller could not " \
                                                "say which day.\n")
    check.call("C1 does NOT re-report `used to be`, which R6 already FAILS on — one " \
               "sentence, one report",
               scan(copula, CENSUS).first.none? { |h| h.rule[:id] == "C1" } &&
                 scan(copula).first.any? { |h| h.rule[:id] == "R6" })

    # ── C2's own arms (K-1510): the two idioms that walked through R6 ───────
    c2 = ->(p) { scan(p, CENSUS).first.select { |h| h.rule[:id] == "C2" } }

    _, retired_arch = plant.call("c2-retired", "z1.rb",
                                 "# It is the direct analogue of the retired StubKyc.attest.\n")
    check.call("C2 counts the adjective `retired` — the word R6's fixed list does not carry, " \
               "and the one the clean K-1510 instance was written with",
               c2.call(retired_arch).size == 1)

    _, pluperfect = plant.call("c2-pluperfect", "z2.rb",
                               "# It had been optional while validation was opt-in.\n")
    check.call("…and the pluperfect `had been`, which is the other one",
               c2.call(pluperfect).size == 1)

    _, retired_live = plant.call("c2-live", "z3.md",
                                 "It strips the retired flags a box may still carry.\n")
    check.call("…and it counts the LIVE reading too — a status and a live caveat are the " \
               "reason this is a census and not a rule; the census does NOT judge",
               c2.call(retired_live).size == 1)

    check.call("C2 never moves the exit code — it is not in RULES at all",
               RULES.none? { |r| r[:id] == "C2" })

    _, r6_only = plant.call("c2-no-overlap", "z4.rb",
                            "# The published field was formerly named `zone`.\n")
    check.call("C2 does NOT re-report a sentence R6 already FAILS on — one sentence, one " \
               "report, the same discipline C1 keeps against `used to be`",
               c2.call(r6_only).empty? &&
                 scan(r6_only).first.any? { |h| h.rule[:id] == "R6" })
  end

  # ── VACUITY: the guard must be looking at something real ──────────────────
  gems  = shipped_gems
  files = gems.flat_map { |g| shipped_files(g) }
  ruby  = files.select { |p| ruby_file?(p) }
  check.call("the shipped-gem scope names at least one gem", !gems.empty?)
  check.call("the shipped-gem scope reads files", !files.empty?)
  check.call("the shipped-gem scope contains Ruby files to lex", !ruby.empty?)
  check.call(
    "Ripper actually lexes them (a sampled shipped Ruby file yields tokens)",
    ruby.take(25).all? { |p| !(Ripper.lex(File.read(p)) || []).empty? }
  )
  check.call(
    "the scope reaches kiosk-server/lib",
    files.any? { |p| p.include?("/kiosk-server/lib/") }
  )
  check.call(
    "the scope reaches an install-generator template",
    files.any? { |p| p.include?("/lib/generators/") && p.end_with?(".tt") }
  )
  check.call(
    "the scope reaches a gemspec and a README",
    files.any? { |p| p.end_with?(".gemspec") } && files.any? { |p| p.end_with?("/README.md") }
  )
  check.call("the demo tree is NOT in the GEM scope", files.none? { |p| p.include?("/kiosk-demo-") })
  check.call("spec/ is NOT in scope", files.none? { |p| p.include?("/spec/") })

  # ── VACUITY: THE GEM SCOPE IS THE SHIPPED SET, RE-DERIVED (K-1511) ────────
  #
  # The arm that matters is the one that is NOT a list: every regular file the
  # gem's own `spec.files` names must land in this scope, so a gem that starts
  # packaging a directory nobody thought of is read the day it does. That is
  # the same shape the demo spec/test arm below uses off `git ls-files`, and it
  # is why the four things this scope «reaches» above are examples rather than
  # the definition — a hand-list of four is exactly what left seven packaged
  # files held by nothing.
  packaged = gems.to_h do |g|
    name = File.basename(g)
    [g, (gem_spec_for(g).files + ["#{name}.gemspec"]).uniq
          .map { |rel| File.join(g, rel) }
          .select { |p| File.file?(p) }]
  end
  unread = packaged.values.flatten.reject do |p|
    files.include?(p) || GEM_NOT_READ.include?(File.basename(p))
  end
  check.call("every gemspec in this repository LOADS, so no gem's shipped set is unknown " \
             "(#{gems.size} gem(s))",
             gems.all? { |g| !gem_spec_for(g).nil? })
  check.call("every PACKAGED file is IN the gem scope (#{packaged.values.flatten.size} packaged)" \
             "#{unread.empty? ? '' : " — unread: #{unread.map do |p|
               p.delete_prefix("#{REPO}/")
             end.join(', ')}"}",
             !packaged.values.flatten.empty? && unread.empty?)
  check.call("…and the scope reaches a packaged file that is in NEITHER lib/ NOR app/ — the " \
             "hole this derivation closed (K-1511)",
             files.any? do |p|
               !p.include?("/lib/") && !p.include?("/app/") &&
                 !p.end_with?(".gemspec") && File.basename(p) != "README.md"
             end)
  check.call("…including a file type no extension list here names (`.py`), which is why " \
             "Python's `#` is declared beside shell's",
             files.any? { |p| p.end_with?(".py") })
  check.call("LICENSE.txt is in NO scope — it is verbatim Apache-2.0 text, not ours to edit",
             files.none? { |p| File.basename(p) == "LICENSE.txt" })

  # ── VACUITY: the same three questions of the demo scope ───────────────────
  demos      = demo_dirs
  demo_paths = demos.flat_map { |d| demo_files(d) }
  demo_ruby  = demo_paths.select { |p| ruby_file?(p) }
  check.call("the demo scope names at least one demo", !demos.empty?)
  check.call("the demo scope reads files", !demo_paths.empty?)
  check.call("the demo scope contains Ruby files to lex", !demo_ruby.empty?)
  check.call(
    "Ripper actually lexes them (a sampled demo Ruby file yields tokens)",
    demo_ruby.take(25).all? { |p| !(Ripper.lex(File.read(p)) || []).empty? }
  )
  check.call(
    "the demo scope reaches an operator-facing surface of every demo",
    demos.all? { |d| demo_files(d).any? { |p| p.include?("/app/") } }
  )
  check.call(
    "the demo scope reaches the published narrative and the task file",
    demo_paths.any? { |p| p.end_with?("/before-after.md") } &&
      demo_paths.any? { |p| p.end_with?("/lib/tasks/demo.rake") }
  )
  check.call(
    "the demo scope skips the non-text config a byte-scan should never read",
    demo_paths.none? { |p| p.end_with?(".key", ".pem", ".enc") }
  )
  check.call("a gem is NOT in the demo scope", demo_paths.none? { |p| p.include?("/kiosk-server/") })

  # ── VACUITY: a demo's spec/ and test/ (K-1509) ───────────────────────────
  #
  # The arm that matters here is the one that is NOT a list: the tracked set is
  # re-derived from git and every text file in it must land in this scope, so a
  # demo that grows a `features/` directory, or a spec written with an extension
  # nobody thought of, costs a DECISION instead of becoming the same silent gap
  # this scope was added to close. The extension filter is shared with the demo
  # scope, so a file git tracks and DEMO_EXTS does not name is reported by name.
  demo_spec_roots = demo_spec_dirs
  demo_spec_paths = demo_spec_roots.flat_map { |d| demo_spec_files(d) }
  check.call("the demo spec/test scope names at least one demo (#{demo_spec_roots.size})",
             !demo_spec_roots.empty?)
  check.call("the demo spec/test scope reads files (#{demo_spec_paths.size})",
             !demo_spec_paths.empty?)
  check.call("…and contains Ruby files to lex", demo_spec_paths.any? { |p| ruby_file?(p) })
  check.call(
    "Ripper actually lexes them (a sampled demo spec file yields tokens)",
    demo_spec_paths.select { |p| ruby_file?(p) }.take(25)
                   .all? { |p| !(Ripper.lex(File.read(p)) || []).empty? }
  )
  tracked_demo_spec =
    IO.popen(["git", "-C", REPO, "ls-files", "-z",
              "kiosk-demo-*/spec/*", "kiosk-demo-*/test/*"], &:read)
      .split("\0").reject(&:empty?)
      .map { |rel| File.join(REPO, rel) }
      .select { |p| File.file?(p) }
  outside_demo_spec = tracked_demo_spec.reject do |p|
    demo_spec_paths.include?(p) || !DEMO_EXTS.include?(File.extname(p))
  end
  unnamed_ext = (tracked_demo_spec - demo_spec_paths).reject { |p| DEMO_EXTS.include?(File.extname(p)) }
  check.call("every TRACKED file under a demo's spec/ or test/ that this guard can read is " \
             "IN the demo spec/test scope (#{tracked_demo_spec.size} tracked)" \
             "#{outside_demo_spec.empty? ? '' : " — outside: #{outside_demo_spec.map do |p|
               p.delete_prefix("#{REPO}/")
             end.join(', ')}"}",
             !tracked_demo_spec.empty? && outside_demo_spec.empty?)
  check.call("…and none of them is dropped by an extension DEMO_EXTS does not name " \
             "#{unnamed_ext.empty? ? '' : "(dropped: #{unnamed_ext.map do |p|
               p.delete_prefix("#{REPO}/")
             end.join(', ')})"}",
             unnamed_ext.empty?)
  check.call("the demo spec/test scope reaches BOTH directory names it globs " \
             "(#{DEMO_SPEC_ROOTS.join(', ')})",
             DEMO_SPEC_ROOTS.all? { |r| demo_spec_paths.any? { |p| p.include?("/#{r}/") } })
  check.call("a gem's spec/ is NOT in the demo spec/test scope, and a demo's spec/ is NOT " \
             "in the gem one — the two scopes MEET rather than overlap",
             demo_spec_paths.none? { |p| p.include?("/kiosk-server/") } &&
               spec_dirs.flat_map { |d| spec_files(d) }.none? { |p| p.include?("/kiosk-demo-") })
  check.call("…and a demo's app/ is not in it either — the demo scope keeps its own rules",
             demo_spec_paths.none? { |p| p.include?("/app/") })

  # ── VACUITY: the same questions of the e2e scope ──────────────────────────
  e2e_roots = e2e_dirs
  e2e_paths = e2e_roots.flat_map { |d| e2e_files(d) }
  check.call("the e2e scope finds the harness directory", !e2e_roots.empty?)
  check.call("the e2e scope reads files", !e2e_paths.empty?)
  check.call("the e2e scope contains Ruby files to lex",
             e2e_paths.any? { |p| ruby_file?(p) })
  check.call(
    "Ripper actually lexes them (a sampled harness Ruby file yields tokens)",
    e2e_paths.select { |p| ruby_file?(p) }.take(25)
             .all? { |p| !(Ripper.lex(File.read(p)) || []).empty? }
  )
  check.call(
    "the e2e scope reaches the adopter-facing surfaces: README, the runner, the " \
    "assistant, a fixture and a vendored schema",
    e2e_paths.any? { |p| p.end_with?("/e2e/README.md") } &&
      e2e_paths.any? { |p| p.end_with?("/e2e/run.sh") } &&
      e2e_paths.any? { |p| p.end_with?("/e2e/assistant.sh") } &&
      e2e_paths.any? { |p| p.include?("/e2e/fixtures/") } &&
      e2e_paths.any? { |p| p.include?("/e2e/schemas/") }
  )
  check.call("the e2e scope skips the installed bundle and the generated app",
             e2e_paths.none? { |p| p.include?("/.gems/") || p.include?("/e2e/tmp/") })
  check.call("a gem is NOT in the e2e scope",
             e2e_paths.none? { |p| p.include?("/kiosk-server/") })

  # ── VACUITY: the deploy scope, and the one arm that is not a list ────────
  #
  # The extension filter is a statement about what is in `deploy/` today, so the
  # arm that matters re-derives the TRACKED set from git and fails when a file
  # falls outside the scope. A `.py` or a `.toml` landing there then costs a
  # decision instead of becoming a silent gap — which is the shape this whole
  # directory was until K-1409 was reopened a second time.
  deploy_roots = deploy_dirs
  deploy_paths = deploy_roots.flat_map { |d| deploy_files(d) }
  check.call("the deploy scope finds the runbook directory", !deploy_roots.empty?)
  check.call("the deploy scope reads files (#{deploy_paths.size})", !deploy_paths.empty?)
  tracked_deploy =
    IO.popen(["git", "-C", REPO, "ls-files", "deploy"], &:read).lines(chomp: true)
      .map { |rel| File.join(REPO, rel) }
      .select { |p| File.file?(p) }
  missing_from_scope = tracked_deploy - deploy_paths
  check.call("every TRACKED file under deploy/ is in the deploy scope " \
             "(#{tracked_deploy.size} tracked)" \
             "#{missing_from_scope.empty? ? '' : " — outside: #{missing_from_scope.map do |p|
               p.delete_prefix("#{REPO}/")
             end.join(', ')}"}",
             !tracked_deploy.empty? && missing_from_scope.empty?)
  check.call("it reaches the runbook, the checklist, the extensionless Caddy template, the " \
             "unit file and an env example",
             deploy_paths.any? { |p| p.end_with?("/deploy/README.md") } &&
               deploy_paths.any? { |p| p.end_with?("/deploy/CHECKLIST.md") } &&
               deploy_paths.any? { |p| p.end_with?("/deploy/Caddyfile") } &&
               deploy_paths.any? { |p| p.end_with?(".service") } &&
               deploy_paths.any? { |p| p.include?("/deploy/env/") })
  check.call("R1-R4 do NOT reach the deploy runbook — it is maintainer tooling for one " \
             "fleet, on bin/'s footing",
             (rules_for(:deploy).map { |r| r[:id] } & %w[R1 R2 R3 R4]).empty?)
  check.call("R5, R6 and R7 DO — a document describing something that does not exist is " \
             "broken for the maintainer too",
             (%w[R5 R6 R7] - rules_for(:deploy).map { |r| r[:id] }).empty?)
  check.call("a gem is NOT in the deploy scope",
             deploy_paths.none? { |p| p.include?("/kiosk-server/") })

  # ── VACUITY: R7's prefixes are DERIVED, and its pattern must still RESOLVE
  #    paths. A regex that stopped matching prints the same clean line as a
  #    repository with no dangling path in it. ────────────────────────────────
  check.call("R7's prefixes are read off the repository root (#{REPO_PATH_PREFIXES.size} " \
             "directories)", REPO_PATH_PREFIXES.size > 5)
  check.call("…and include the gems, the demos, the harness and the runbook",
             %w[kiosk-server kiosk-demo-getgrocery e2e deploy].all? { |d| REPO_PATH_PREFIXES.include?(d) })
  check.call("…and NOT bin/, whose every entry in this tree is a demo binstub",
             !REPO_PATH_PREFIXES.include?("bin"))
  resolving = SCOPES.keys.sum do |scope|
    next 0 unless rules_for(scope).any? { |r| r[:id] == "R7" }

    SCOPES[scope][:dirs].call.flat_map { |d| SCOPES[scope][:files].call(d) }.sum do |p|
      rule_source(p).scan(REPO_PATH_RE).count { |t| File.exist?(File.join(REPO, t)) }
    end
  end
  check.call("R7's pattern still RESOLVES repository paths in scope (#{resolving} token(s)) " \
             "— a pattern that matched nothing would read as a clean tree",
             resolving.positive?)

  # ── VACUITY: R5's ban is DERIVED, so prove the derivation, not a list ────
  #
  # A hand-listed vacuity arm names what it already knows and is blind to what
  # the corpus grows into. These three questions are about the MECHANISM: they
  # are the same questions whatever the wire version is, and they keep being
  # the right ones after it moves.
  major, minor = current_wire
  check.call("the wire version is READ from kiosk-core (found #{major}.#{minor})",
             major.is_a?(Integer) && minor.is_a?(Integer))
  check.call("the retired set is non-empty — a ban over nothing is a green nothing",
             !retired_wire_alternatives.empty?)
  check.call("the CURRENT wire (#{major}.#{minor}) is NOT banned",
             !"speaks #{major}.#{minor} today".match?(RETIRED_WIRE_RE))
  prev = minor.positive? ? "#{major}.#{minor - 1}" : "#{major - 1}.0"
  check.call("the wire immediately before it (#{prev}) IS banned — the ban follows the " \
             "constant, so a bump widens it with no edit here",
             "the #{prev} wire is gone".match?(RETIRED_WIRE_RE))

  # ── VACUITY: the mirror mask covers every file another guard freezes ─────
  mirrors = mirrored_paths
  check.call("bin/check-spec-schemas names the mirrors it holds (#{mirrors.size})", !mirrors.empty?)
  uncovered = mirrors.reject { |rel| File.join(REPO, rel).match?(VENDORED_MIRROR_RE) }
  check.call("…and WHICH member of one is ours is read out of that script too " \
             "(#{EXEMPT_MIRROR_MEMBERS.join(', ')}) — a second answer typed here is a " \
             "second thing to drift",
             !EXEMPT_MIRROR_MEMBERS.empty?)
  on_disk = mirrors.map { |rel| File.join(REPO, rel) }.select { |p| File.exist?(p) }
  check.call("the mask leaves a mirror's TOP-LEVEL marker readable and blanks everything " \
             "else, nested `$comment` included (#{on_disk.size} mirror(s) on disk)",
             !on_disk.empty? && on_disk.all? do |p|
               kept = rule_source(p).each_line.reject { |l| l == "\n" }
               kept.size == 1 &&
                 kept.first.match?(/\A\s*"#{Regexp.escape(EXEMPT_MIRROR_MEMBERS.first)}"\s*:/)
             end)
  check.call("every path it mirrors is masked here — scrubbing one would make the mirror " \
             "stop mirroring#{uncovered.empty? ? '' : " (uncovered: #{uncovered.join(', ')})"}",
             uncovered.empty?)

  # ── VACUITY: the two sanctioned afterlives are OUTSIDE every scope ───────
  all_scoped = SCOPES.values.flat_map { |s| s[:dirs].call.flat_map { |d| s[:files].call(d) } }
  check.call("the repository journal is in NO scope — CHANGELOG.md is the sanctioned afterlife",
             all_scoped.none? { |p| File.basename(p) == "CHANGELOG.md" })
  check.call("a demo's public/ signpost pages are in NO scope — a maintainer rule addressed " \
             "to a future editor is not archaeology",
             all_scoped.none? { |p| p.include?("/public/") })

  corpus = vacuity_corpus
  check.call("the vacuity corpus is non-empty", !corpus.empty?)
  (RULES + CENSUS).each do |rule|
    hits = corpus.count do |p|
      File.read(p, encoding: "UTF-8", invalid: :replace, undef: :replace).match?(rule[:re])
    end
    # A RESOLVING rule's pattern matches a shape and the filesystem decides the
    # rest, so this arm can only honestly claim the shape is still being found.
    # What holds its other half is the resolving-token count above.
    subject = rule[:resolve] ? "the SHAPE of #{rule[:what]}" : rule[:what]
    check.call(
      "#{rule[:id]}'s pattern still matches #{subject} outside the ban " \
      "(CHANGELOG.md + bin/): #{hits} file(s)",
      hits.positive?
    )
  end

  # ── VACUITY: the census must reach the scopes it claims, and must be able
  #    to answer NON-empty — a census that structurally cannot print a row is
  #    the same green nothing a rotted ban is ────────────────────────────────
  r6_scopes = RULES.find { |r| r[:id] == "R6" }[:scopes]
  check.call("the census declares the same scopes R6 does (#{r6_scopes.join(', ')}) — derived " \
             "from the rule, so widening one widens the other",
             CENSUS.all? { |r| r[:scopes] == r6_scopes })
  census_files = CENSUS.flat_map { |r| r[:scopes] }.uniq.sum do |scope|
    SCOPES[scope][:dirs].call.sum { |d| SCOPES[scope][:files].call(d).size }
  end
  check.call("the census reads a non-empty file set (#{census_files} files)",
             census_files.positive?)
  # The census ROW COUNT is deliberately NOT asserted: unlike a ban, zero is the
  # outcome this one is trying to reach, and a self-test that reddened on a
  # drained census would punish the fix. What holds the pattern is the vacuity
  # arm above, which re-runs it against a corpus that cannot honestly drain.
  census_rows = CENSUS.flat_map { |r| r[:scopes] }.uniq.sum do |scope|
    SCOPES[scope][:dirs].call
                        .flat_map { |d| SCOPES[scope][:files].call(d) }
                        .sum { |p| scan(p, census_for(scope)).first.size }
  end
  puts "  note the census stands at #{census_rows} row(s) at head (informational — a census " \
       "row count is never an assertion)"

  if failures.empty?
    puts "SELF-TEST OK"
    0
  else
    puts "SELF-TEST FAILED: #{failures.size} arm(s)"
    1
  end
end

exit(ARGV.include?("--self-test") ? self_test : run_check)
