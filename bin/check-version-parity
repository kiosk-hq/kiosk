#!/usr/bin/env ruby
# frozen_string_literal: true

# Version-parity check (K-748).
#
# WHY THIS EXISTS. `kiosk.tech/spec/protocol.md` §14.1 is normative and says:
#
#     Version parity (MAJOR.MINOR only). The protocol, the reference
#     implementation, and the AI assistant skill share their MAJOR.MINOR
#     version — currently 0.3. An operator on Kiosk 0.3 pins a 0.3 skill
#     against a 0.3 wire.
#
# For months that sentence was false about one of its three subjects, on every
# request. The protocol was 0.3.0 and the skill was 0.3.11, but thirteen gems
# were `VERSION = "0.0.1"` and kiosk-pow-equihash was `"0.1.0"` — the gems did
# not even agree with each other — and `Kiosk-Server-Version` emits the gem
# version, so a server advertising `Kiosk-API-Version: 0.3.0` answered
# `Kiosk-Server-Version: 0.0.1` on the same response. Nothing was red. Every
# suite in this repo passes at any version number, because the version is an
# input to no assertion: the specs that touch it match `/\A\d+\.\d+\.\d+\z/`
# or compare the constant against itself.
#
# Phil's answer (2026-08-16) was to honour the published rule rather than
# weaken it — and to stop the rule being prose. So this is a CHECK, not a
# convention: it reads the protocol version out of kiosk-core, reads every
# gem's version out of its own gemspec the way RubyGems would, and fails the
# build when they no longer speak the same MAJOR.MINOR.
#
# THE RULE IT ENFORCES — and the half of it that is easy to get wrong. §14.1
# binds MAJOR.MINOR **only**. A per-gem PATCH release is legitimate and
# expected: kiosk-server may ship 0.3.4 while kiosk-rls-minitest sits at
# 0.3.0, because a fix in one gem is not a protocol event. So this check must
# NOT demand identical versions — a check that did would be wrong about the
# spec and would be silenced the first time someone needed a patch release.
# Four things are asserted, and none of them looks at PATCH:
#
#   A. GEM VERSIONS.  Every gemspec's `spec.version` shares MAJOR.MINOR with
#      `Kiosk::Protocol::API_VERSION`. That constant is the source of truth —
#      it is what `Kiosk-API-Version` puts on the wire, so it is the number
#      the spec sentence is about.
#
#   B. INTER-GEM CONSTRAINTS.  Every `kiosk-*` dependency any gemspec declares
#      must be `~> MAJOR.MINOR.0`, which is exactly `>= 0.3.0, < 0.4.0` — the
#      parity rule written where the RESOLVER can read it. This matters
#      off-tree, not here: everything in this monorepo consumes siblings by
#      `path:`, so the constraint is never exercised locally and a stale one
#      cannot fail any suite. The constraints really were stale — `~> 0.0`
#      (i.e. `>= 0.0, < 1.0`) would have let someone `gem install kiosk-server`
#      0.3 against kiosk-core 0.1 and get a resolution the spec forbids.
#
#   C. THE SKILL PIN.  §14.1's third subject. The `skill_url` each demo pins,
#      and kiosk-server's default, names `skill-vMAJOR.MINOR.PATCH.md`; that
#      MAJOR.MINOR must be the protocol's too. PATCH is deliberately ignored
#      — §14.4 makes the skill's PATCH an independent, skill-only revision
#      line (0.3.11 today, eleven cuts into protocol 0.3).
#
#      THIS IS NOT WHAT kiosk-test-support/spec/skill_pin_spec.rb COVERS, and
#      the two do not overlap. That spec asserts INTEGRITY — that the pinned
#      `skill_sha256` equals the SHA-256 of the pinned file's bytes — and it
#      reads those bytes out of a sibling `../kiosk.tech` checkout, so it
#      SKIPS ENTIRELY in public CI, where that sibling does not exist. It
#      never looks at the version number in the filename. A demo could pin
#      skill-v0.2.0.md with a perfectly correct sha256 and that spec would be
#      green (and, in public CI, would not even run). This check reads only
#      the URL string, needs no sibling checkout and no network, and asserts
#      only the number that spec ignores.
#
#   D. THE SINGLE EDIT POINT.  Each gem's `lib/**/version.rb` must declare
#      exactly one `VERSION` and the gemspec's `spec.version` must equal it.
#      Without this, a gemspec that stopped reading its own version.rb — a
#      hardcoded `spec.version = "0.3.9"` — would pass A while the file every
#      human edits became decoration.
#
# THE FAIL-OPEN GUARD. Rule A reads `spec.version` by LOADING each gemspec
# (`Gem::Specification.load`, the same evaluation `gem build` performs) rather
# than by regexing `spec.version =`, because a regex that does not recognise a
# shape reports success — the failure mode this file exists to prevent. Same
# for rule B: it reads `spec.dependencies`, the resolved requirement objects,
# not the source text. Where text IS parsed (the protocol constant, the
# version.rb literal, the skill URLs) an unparseable shape is a HARD ERROR,
# never a skip: the checker says out loud that it cannot see.
#
# WHEN THIS FAILS ON YOU. Cutting a new protocol MINOR means moving all of it
# together, in one commit: `API_VERSION` (and `MIN_CLIENT`) in
# kiosk-core/lib/kiosk/protocol.rb, all 14 version.rb files, the `~>`
# constraints in the gemspecs, every Gemfile.lock that pins them (`bundle lock`
# per demo — do not hand-edit), and the demos' `skill_url` pins once the new
# skill is cut and published. This check is the list of what "together" means.
#
# Stdlib only (rubygems), no bundle, no database, no network. ~0.2 s for 14
# gems. Same profile and same reason as bin/check-ci-tasks, bin/check-demo-copies
# and bin/check-gem-packaging.
#
# Usage:
#   bin/check-version-parity          # check
#   bin/check-version-parity --list   # print every version this check compares

require "rubygems"

ROOT            = File.expand_path("..", __dir__)
PROTOCOL_SOURCE = File.join(ROOT, "kiosk-core", "lib", "kiosk", "protocol.rb")
SERVER_DEFAULTS = File.join(ROOT, "kiosk-server", "lib", "kiosk", "server", "configuration_extension.rb")

errors = []

# ── The source of truth ──────────────────────────────────────────────────────
#
# Kiosk::Protocol::API_VERSION is what `Kiosk-API-Version` puts on every
# /kiosk/* response, so it is the number §14.1's sentence is about. Read as
# text, not by require: this must run on a bare checkout with nothing loaded.
abort "check-version-parity: #{PROTOCOL_SOURCE} not found — is this a checkout?" unless File.exist?(PROTOCOL_SOURCE)
api_version = File.read(PROTOCOL_SOURCE)[/^\s*API_VERSION\s*=\s*"(\d+\.\d+\.\d+)"/, 1]
abort "check-version-parity: could not read `API_VERSION = \"X.Y.Z\"` from #{PROTOCOL_SOURCE}. " \
      "That constant is the source of truth for this check; if it moved or changed shape, this " \
      "file must be taught the new one rather than left guessing." unless api_version

major, minor, = api_version.split(".").map(&:to_i)
SERIES      = "#{major}.#{minor}"                             # "0.3.0" -> "0.3"
NEXT_SERIES = "#{major}.#{minor + 1}.0"                       # the exclusive upper bound
WANT        = Gem::Requirement.new("~> #{SERIES}.0")          # >= 0.3.0, < 0.4.0

def series_of(version) = version.to_s.split(".").first(2).join(".")

listing = []

# ── Rules A and D: gem versions, and the file humans edit ────────────────────
gemspecs = Dir[File.join(ROOT, "*", "*.gemspec")].sort
abort "check-version-parity: no */*.gemspec under #{ROOT}" if gemspecs.empty?

specs = {}
gemspecs.each do |gemspec|
  dir  = File.dirname(gemspec)
  gem  = File.basename(dir)

  spec = Gem::Specification.load(gemspec)
  unless spec
    errors << "#{gem}: `Gem::Specification.load` returned nil for #{File.basename(gemspec)} — the " \
              "gemspec does not evaluate, so its version cannot be read at all."
    next
  end
  specs[spec.name] = spec

  # ── A ──
  if series_of(spec.version) == SERIES
    # ok
  else
    errors << "#{gem}: packages as version #{spec.version}, whose MAJOR.MINOR is " \
              "#{series_of(spec.version)}, but the protocol is #{api_version} (#{SERIES}). " \
              "protocol.md §14.1 promises the protocol, this implementation and the skill share " \
              "MAJOR.MINOR — and kiosk-server puts this number on every response as " \
              "`Kiosk-Server-Version`. Set VERSION to #{SERIES}.<patch> in #{gem}'s version.rb, or " \
              "— if the PROTOCOL moved — move API_VERSION and all 14 gems together (see the header)."
  end

  # ── D ──
  version_files = Dir[File.join(dir, "lib", "**", "version.rb")].sort
  if version_files.size != 1
    errors << "#{gem}: expected exactly one lib/**/version.rb, found #{version_files.size} " \
              "(#{version_files.map { |f| f.delete_prefix("#{ROOT}/") }.join(', ')}). This check " \
              "asserts the gemspec's version comes from that one file; with none or several it " \
              "cannot tell which one a human is supposed to edit."
  else
    rel      = version_files.first.delete_prefix("#{ROOT}/")
    literals = File.read(version_files.first).scan(/^\s*VERSION\s*=\s*"([^"]*)"/).flatten
    if literals.size != 1
      errors << "#{rel}: found #{literals.size} `VERSION = \"…\"` declarations, expected exactly one. " \
                "An unreadable shape must not pass silently — this check would otherwise be blind to " \
                "the file it is meant to police."
    elsif literals.first != spec.version.to_s
      errors << "#{gem}: #{rel} says VERSION = \"#{literals.first}\" but the gemspec packages " \
                "#{spec.version} — the gemspec is not reading its own version file, so editing " \
                "version.rb changes nothing that ships. Restore `spec.version = <the VERSION constant>`."
    end
  end

  listing << [gem, spec.version.to_s]
end

# ── Rule B: the constraints the RESOLVER reads ───────────────────────────────
own_gems = specs.keys.to_a
constraints = []
specs.each_value do |spec|
  spec.dependencies.select { |d| d.name.start_with?("kiosk-") }.each do |dep|
    constraints << [spec.name, dep.name, dep.requirement.to_s, dep.type]

    unless own_gems.include?(dep.name)
      errors << "#{spec.name}: depends on `#{dep.name}`, which is not a gem in this repo — either " \
                "the name is wrong or this manifest is stale."
      next
    end
    next if dep.requirement == WANT

    errors << "#{spec.name}: declares `#{dep.name}` as `#{dep.requirement}`, expected " \
              "`~> #{SERIES}.0`. Everything in this monorepo consumes siblings by `path:`, so this " \
              "constraint is never exercised here and no suite can go red on it — but it is what " \
              "RubyGems resolves for someone installing the gem, and `~> #{SERIES}.0` " \
              "(>= #{SERIES}.0, < #{NEXT_SERIES}) is the parity rule stated to the resolver: " \
              "same MAJOR.MINOR, any PATCH."
  end
end

# ── Rule C: the third subject of the parity sentence ─────────────────────────
#
# One default in kiosk-server plus one pin per operator demo. The URL string is
# all this reads; skill_pin_spec owns the sha256 half (see the header).
skill_pins = []
unless File.exist?(SERVER_DEFAULTS)
  errors << "kiosk-server/lib/kiosk/server/configuration_extension.rb is missing — the default " \
            "skill_url every demo inherits cannot be checked."
end
if File.exist?(SERVER_DEFAULTS)
  default_url = File.read(SERVER_DEFAULTS)[/@skill_url\s*\|\|=\s*"([^"]+)"/, 1]
  if default_url
    skill_pins << ["kiosk-server (default)", default_url]
  else
    errors << "kiosk-server/lib/kiosk/server/configuration_extension.rb: no `@skill_url ||= \"…\"` " \
              "default found. Either the default moved — teach this check where — or kiosk-server " \
              "stopped shipping one, which is a wire-visible change."
  end
end

initializers = Dir[File.join(ROOT, "kiosk-demo-*", "config", "initializers", "kiosk.rb")].sort
if initializers.empty?
  errors << "no kiosk-demo-*/config/initializers/kiosk.rb found — the demos' skill pins cannot be " \
            "checked, and this check must not pass by finding nothing."
end
initializers.each do |path|
  demo = path[%r{(kiosk-demo-[^/]+)}, 1]
  url  = File.read(path)[/skill_url\s*=\s*"([^"]+)"/, 1]
  # A demo with no explicit pin inherits kiosk-server's default, already checked.
  skill_pins << [demo, url] if url
end

skill_pins.each do |where, url|
  version = File.basename(url)[/\Askill-v(\d+\.\d+\.\d+)\.md\z/, 1]
  unless version
    errors << "#{where}: skill_url `#{url}` does not name a `skill-vMAJOR.MINOR.PATCH.md` file, so " \
              "its version cannot be read. protocol.md §14.4 makes that filename the skill's version; " \
              "an unparseable pin must fail rather than pass unchecked."
    next
  end
  next if series_of(version) == SERIES

  errors << "#{where}: pins skill v#{version} (#{series_of(version)}) against protocol " \
            "#{api_version} (#{SERIES}). protocol.md §14.1: an operator on Kiosk #{SERIES} pins a " \
            "#{SERIES} skill against a #{SERIES} wire. Re-pin to the published #{SERIES} skill — " \
            "URL and skill_sha256 move together (ADR-0012)."
end

# ── Rule E: the OTHER place the cut is advertised — the discovery signal ─────
#
# WHY THIS LIVES HERE AND NOT IN ITS OWN SCRIPT. Rule C above already owns
# "every place a demo names the skill cut", and protocol.md §4.5 made the
# discovery signal one of those places (K-927, Phil 2026-08-21): the
# `<link rel="kiosk">` tag and the `Link: <…>; rel="kiosk"` response header MUST
# name `skill-vMAJOR.MINOR.PATCH.md`, MUST NOT name the mutable `skill.md`
# alias, and where the origin also publishes a `skill` pin the two MUST name the
# SAME url. A second `bin/check-*` would put one invariant behind two exit codes
# and duplicate this file's demo enumeration. kiosk.tech's
# `bin/check-skill-immutability` cannot hold it either: the demo half of the
# relink lives in THIS repo, which that guard cannot reach — and a relink site
# with no guard is how K-923 happened.
#
# WHAT IT ASSERTS, and why it is a SHAPE rule rather than a URL rule. Until
# K-927 all eighteen sites carried the alias as a string literal, and option B
# as filed would have replaced them with eighteen literals naming the cut —
# eighteen new places to re-pin on every bump, on top of the eight pins. So the
# demos DERIVE the value instead: both signals read
# `Kiosk.configuration.skill_url`, the same accessor `/.well-known/kiosk.json`
# renders its `skill` block from. The two signals then cannot disagree by
# construction, and the relink inventory does not grow at all.
#
# That is the lesson well_known_spec.rb records about its own copy of the
# default URL (K-750): "restating it here made a second copy that had to be
# hand-chased on every skill cut, and it went red exactly that way". A checker
# comparing eighteen literals would re-introduce the copies it exists to
# police, so this rule bans the literal and demands the accessor:
#
#   E1  no file under `kiosk-demo-*/app/` contains a literal
#       `https://kiosk.tech/skill…` url. A literal there is a second copy of the
#       pin, whether it names the alias (the K-927 defect) or a cut (the same
#       defect one bump later).
#   E2  every line that EMITS the signal — one carrying `rel="kiosk"` together
#       with an `href=` or a `set_header` — reads `Kiosk.configuration.skill_url`.
#       Prose mentioning `<link rel="kiosk">` emits nothing and is left alone.
#   E3  each operator demo emits BOTH forms: at least one tag under app/views
#       and at least one header under app/controllers. §4.5 lets an operator
#       pick either; these seven ship both, and a signal silently lost in a view
#       rewrite is exactly the drift nothing else here would catch.
#
# The operator demos are the ones with a `config/initializers/kiosk.rb` — the
# set rule C already derives its pins from — so kiosk-demo-prove (the KYC
# broker, which mounts no Kiosk engine) is excluded without a hardcoded list.
SIGNAL_ACCESSOR = "Kiosk.configuration.skill_url"
SKILL_LITERAL   = %r{https://kiosk\.tech/skill[-.][^"'\s)>]*}
SIGNAL_REL      = /rel=("|&quot;)kiosk\1/
EMITS           = /href\s*=|set_header/

signal_sites   = []
operator_demos = initializers.map { |path| File.dirname(File.dirname(File.dirname(path))) }

operator_demos.each do |dir|
  demo  = File.basename(dir)
  files = Dir[File.join(dir, "app", "**", "*.{rb,erb}")].sort
  if files.empty?
    errors << "#{demo}: no app/**/*.{rb,erb} found, so the discovery signal cannot be checked. " \
              "This rule must not pass by finding nothing to look at."
    next
  end

  tags = 0
  hdrs = 0

  files.each do |path|
    rel = path.delete_prefix("#{ROOT}/")
    File.readlines(path).each_with_index do |line, idx|
      lineno = idx + 1

      # ── E1 ──
      if (literal = line[SKILL_LITERAL])
        errors << "#{rel}:#{lineno}: hardcodes `#{literal}`. The discovery signal names the cut " \
                  "this operator PINS, and that url has exactly one home — `skill_url` in " \
                  "config/initializers/kiosk.rb, which `/.well-known/kiosk.json` already renders " \
                  "its `skill` block from. Read `#{SIGNAL_ACCESSOR}` instead: a literal here is a " \
                  "second copy to hand-chase on every cut (K-750's lesson, K-927's defect), and " \
                  "if it names `skill.md` it also violates protocol.md §4.5, which forbids " \
                  "advertising the mutable alias."
      end

      next unless line.match?(SIGNAL_REL) && line.match?(EMITS)

      # ── E2 ──
      unless line.include?(SIGNAL_ACCESSOR)
        errors << "#{rel}:#{lineno}: emits a `rel=\"kiosk\"` discovery signal whose value does " \
                  "not come from `#{SIGNAL_ACCESSOR}`. protocol.md §4.5: the href MUST name a " \
                  "versioned cut and, where the origin publishes a `skill` pin, MUST name the " \
                  "same url as that pin — which is what reading the accessor guarantees."
        next
      end

      in_view = path.include?("/app/views/")
      in_view ? tags += 1 : hdrs += 1
      signal_sites << [demo, in_view ? "<link>" : "Link:", "#{rel}:#{lineno}"]
    end
  end

  # ── E3 ──
  if tags.zero?
    errors << "#{demo}: no `<link rel=\"kiosk\">` tag under app/views reads #{SIGNAL_ACCESSOR}. " \
              "All seven operator demos advertise the signal in both forms; a tag that " \
              "disappears in a view rewrite is invisible to every other check in this repo."
  end
  next unless hdrs.zero?

  errors << "#{demo}: no `Link: <…>; rel=\"kiosk\"` response header under app/controllers reads " \
            "#{SIGNAL_ACCESSOR}. The header is the half an assistant that never downloads the " \
            "page relies on."
end

# ── --list ───────────────────────────────────────────────────────────────────
if ARGV.include?("--list")
  puts "protocol  Kiosk::Protocol::API_VERSION = #{api_version}   (series #{SERIES})"
  puts
  puts format("%-24s %-10s %s", "GEM", "VERSION", "SERIES")
  listing.each { |(gem, v)| puts format("%-24s %-10s %s", gem, v, series_of(v)) }
  puts
  puts format("%-24s %-24s %-12s %s", "GEM", "DEPENDS ON", "REQUIREMENT", "KIND")
  constraints.sort.each do |(from, to, req, type)|
    puts format("%-24s %-24s %-12s %s", from, to, req, type == :development ? "development" : "runtime")
  end
  puts
  puts format("%-24s %s", "SKILL PINNED BY", "URL")
  skill_pins.each { |(where, url)| puts format("%-24s %s", where, url) }
  puts
  puts format("%-24s %-8s %s", "SIGNAL EMITTED BY", "FORM", "SITE")
  signal_sites.each { |(demo, form, site)| puts format("%-24s %-8s %s", demo, form, site) }
  # Deliberately falls through to the verdict below rather than exiting here,
  # for the same reason bin/check-gem-packaging's --list does: a mode that
  # returned 1 without printing WHY would be a check that fails silently.
end

if errors.empty?
  puts "check-version-parity: OK — protocol #{api_version}; #{listing.size} gems, " \
       "#{constraints.size} inter-gem constraints and #{skill_pins.size} skill pins all on " \
       "#{SERIES}; #{signal_sites.size} `rel=\"kiosk\"` discovery signals across " \
       "#{operator_demos.size} operator demos, all derived from #{SIGNAL_ACCESSOR}"
  exit 0
end

warn "\ncheck-version-parity FAILED:\n"
errors.each { |e| warn "  ✗ #{e}" }
warn "\nprotocol.md §14.1 is normative: the protocol, this reference implementation and the AI " \
     "assistant skill share their MAJOR.MINOR version. PATCH is free — per-gem patch releases are " \
     "legitimate and this check never compares them — but the #{SERIES} line is a promise every " \
     "response carries in its `Kiosk-Server-Version` header."
exit 1
