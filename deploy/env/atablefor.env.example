# Kiosk hosted demo — atablefor (the flagship)
#   → copy to /etc/kiosk-demo/atablefor.env
# Subdomain: atablefor.demo.kiosk.tech   Port: 3002
# Replace every REPLACE_* value. `deploy/rollout.sh --apply` installs this onto
# the box and sets its owner and mode. Shell-source-safe (`set -a; . file`).
#

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
PORT=3002

# ── Database (DB-per-app; the app reads BOTH names from here) ────────────────
# config/database.yml (production) resolves the database and login role from
# the two variables below, defaulting to exactly these values. Change either
# one and you must pass the SAME value to deploy/postgres-init.sql
# (-v af_db=… / -v af_user=…) — otherwise provisioning creates one name and
# the app connects to another. Leave them as shipped: nothing to keep in sync.
PGHOST=127.0.0.1
KIOSK_ATABLEFOR_DB=kiosk_atablefor_production
KIOSK_ATABLEFOR_DB_USER=kiosk_atablefor
# Same value passed to postgres-init.sql as -v af_pw
KIOSK_ATABLEFOR_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://atablefor.demo.kiosk.tech
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work: REPUTATION mode + HIGH difficulty ────────────────────────
# atablefor is THE designated production-grade demo — the ONLY one shipped high.
# It advertises the real anti-scalping REPUTATION policy (RateAndReputation):
# the :query toll is priced by the caller's CONFIRMED-BOOKING history —
# a fresh/low-reputation agent pays escalating PoW to browse prime-time
# availability, and the cost DROPS as it builds a genuine booking record. Show
# the "beware: intensive PoW" banner on the demo page.
#
# EXACTLY ONE PoW mode is selected here, by this one selector. The per-flag
# knobs KIOSK_POW_DEMO / KIOSK_POW_REPUTATION_DEMO / KIOSK_POW_BACKOFF_DEMO are
# honoured as single-mode aliases; setting MORE THAN ONE of them RAISES at boot.
#   KIOSK_POW_MODE = reputation | demo | backoff | off
KIOSK_POW_MODE=reputation
# Difficulty knob (wired: registration_pow_params =
# Kiosk::Pow::Equihash::Difficulty.params, and
# the catalog toll's EQUIHASH_DEMO_PARAMS from the same call): HIGH here.
#   high → n=168 k=7, ~1.3 GiB and ~9–10 s on one M-series laptop core (the
#          only hardware the seconds have been measured on; the GiB is the
#          reference solver's sorted-nonce table, not a floor those params
#          impose on every solver — a memory-optimised solver trades the
#          table for time, which is how 200/9's footprint fell to ~144 MB).
#   low  → n=96 k=5, sub-second.
# At high difficulty a fresh HN visitor pays its reputation count of ~2 proofs
# (~20 s on that same machine) at first contact, dropping to 1 proof then a free
# pass as its bookings
# confirm — the pokeable-ness cost of choosing the reputation showcase.
KIOSK_POW_DIFFICULTY=high
# Registration PoW (POW-VERB-GATING): register is tolled UNCONDITIONALLY in
# the app config — there is no env flag. Difficulty
# inherits KIOSK_POW_DIFFICULTY, so on this flagship register costs the SAME high
# n=168 k=7 proof.
# HMAC key every PoW challenge is signed with — REQUIRED: no shipped
# default, the app refuses to boot without it outside dev/test, and it must be
# ≥ 32 bytes. Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET

# ── Payments: NONE ──────────────────────────────────────────────────────────
# atablefor books restaurant tables — a reservation takes no money. It configures
# NO payment provider, so `pay` is absent from its capabilities and there is no
# Stripe key here (unlike getgrocery). This is deliberate and load-bearing.
