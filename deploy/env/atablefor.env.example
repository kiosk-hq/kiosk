# Kiosk hosted demo — atablefor (the flagship)
#   → copy to /etc/kiosk-demo/atablefor.env
# Subdomain: atablefor.demo.kiosk.tech (or the apex atablefor.us)   Port: 3002
# Replace every REPLACE_* value. Keep this file mode 0600, owned by the kiosk
# user. This template is shell-source-safe (`set -a; . file`) as written.
#

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
PORT=3002

# ── Database (DB-per-app; role owns kiosk_atablefor_production) ──────────────
PGHOST=127.0.0.1
KIOSK_ATABLEFOR_DB=kiosk_atablefor_production
KIOSK_ATABLEFOR_DB_USER=kiosk_atablefor
# Same value passed to postgres-init.sql as -v af_pw
KIOSK_ATABLEFOR_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://atablefor.demo.kiosk.tech   # or https://atablefor.us
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work: HIGH / "beware: memory- and CPU-intensive PoW" ───────────
# atablefor is THE designated production-grade demo — the ONLY one shipped high.
# A poker feels the real ~9–10 s / ~1.3 GiB memory+CPU-hard toll first-hand — the
# DoS shield made tangible. Show the "beware: intensive PoW" banner on the demo
# page. (The other six demos honor this same knob but default low.)
KIOSK_POW_DEMO=1
KIOSK_POW_REPUTATION_DEMO=1
# Count-based PoW backoff ("solve once, next N calls free") — ENABLED so the
# high-PoW flagship is POKEABLE: one ~9 s solve buys the next N ungated calls
# before the toll returns, so a visitor doesn't re-solve on every request. The
# VALUE IS THE COUNT (=10 → 10 free calls per solve; 0/unset = per-request toll).
# This is the active reputation policy and OVERRIDES the two demo flags above
# (KIOSK_POW_DEMO / KIOSK_POW_REPUTATION_DEMO drive the local demo:pow /
# demo:reputation flows, not this deploy). NOTE: the default in-process
# BackoffStore is per-worker, so with WEB_CONCURRENCY>1 the count is per-worker —
# a multi-worker deploy that wants an authoritative count must pass a shared
# store (Redis/DB) via a custom BackoffStore.
KIOSK_POW_BACKOFF_DEMO=10
# Registration PoW (POW-VERB-GATING, K-487): register is now tolled
# UNCONDITIONALLY in the app config — no env flag to set (it activates on
# code-deploy and can't be forgotten). Difficulty inherits KIOSK_POW_DIFFICULTY,
# so on this flagship register costs the SAME high n=168 k=7 proof.
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET
# Difficulty knob: HIGH here (wired via lib/pow_difficulty.rb):
#   high → n=168 k=7, ~9–10 s / ~1.3 GiB.  low → n=96 k=5, sub-second.
KIOSK_POW_DIFFICULTY=high

# ── Payments: NONE ──────────────────────────────────────────────────────────
# atablefor books restaurant tables — a reservation takes no money. It configures
# NO payment provider, so `pay` is absent from its capabilities and there is no
# Stripe key here (unlike getgrocery). This is deliberate and load-bearing.
