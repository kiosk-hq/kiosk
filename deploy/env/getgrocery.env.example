# Kiosk hosted demo — getgrocery   → copy to /etc/kiosk-demo/getgrocery.env
# Subdomain: getgrocery.demo.kiosk.tech   Port: 3001
# Replace every REPLACE_* value. `deploy/rollout.sh` installs this onto the box
# and sets its owner and mode. Shell-source-safe (`set -a; . file`).

RAILS_ENV=production
# Generate: `bin/rails secret`  (or `openssl rand -hex 64`)
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

# Puma sizing (lean, per deploy/CHECKLIST.md §2): one worker per app —
# ~5 concurrent req/app, ~250 MB RSS — so all eight apps fit a 2–4 GB box.
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
PORT=3001

# ── Database (DB-per-app; the app reads BOTH names from here) ────────────────
# config/database.yml (production) resolves the database and login role from
# the two variables below, defaulting to exactly these values. Change either
# one and you must pass the SAME value to deploy/postgres-init.sql
# (-v gg_db=… / -v gg_user=…) — otherwise provisioning creates one name and
# the app connects to another. Leave them as shipped: nothing to keep in sync.
PGHOST=127.0.0.1
KIOSK_GETGROCERY_DB=kiosk_getgrocery_production
KIOSK_GETGROCERY_DB_USER=kiosk_getgrocery
# Same value passed to postgres-init.sql as -v gg_pw
KIOSK_GETGROCERY_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://getgrocery.demo.kiosk.tech
# Stable RSA signing key (base64 of a PEM). Generate once, reuse across deploys:
#   openssl genrsa 2048 | base64 -w0
# (Do NOT rely on the dev ephemeral-key fallback — it is local-only by design.)
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work: LOW / poke-friendly ──────────────────────────────────────
# getgrocery tolls every query (a metered browse toll, not a wall) and register
# costs one proof — both in the app config. Low, so a first-time poker's solve is
# sub-second and the toll is still SEEN (see kiosk-pow-equihash/bench/README.md
# for what that is on what).
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET
# Equihash params are fixed in config/initializers/kiosk.rb.

# ── Payments: real Stripe in TEST mode ──────────────────────────
# getgrocery runs SetupIntent card-on-file. Test key only — NO live key on the
# box. Test card 4242 4242 4242 4242 (any future expiry/CVC). No real charge.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_TEST_KEY

# ── KYC broker trust (getgrocery gates alcohol create_order on age_over_18;
# the shared broker at kyc.demo.kiosk.tech is its trusted issuer). All four
# are required: the app does not boot without them. The broker registers
# getgrocery only when its KIOSK_PROVE_GETGROCERY_SECRET and
# KIOSK_PROVE_GETGROCERY_CALLBACK_HOST are set (deploy/env/kyc-demo.env.example carries both), and this file's
# KIOSK_PROVE_INTAKE_SECRET must equal the first of them.
# ────────────────────────────────────────────────────────────────────────────
KIOSK_PROVE_ISSUER=https://kyc.demo.kiosk.tech
KIOSK_PROVE_BROKER_URL=https://kyc.demo.kiosk.tech
# The shared bearer getgrocery presents at the broker intake. The OPERATOR side
# reads ONE role-named variable; the BROKER side keeps a per-operator name:
# this value MUST equal the broker's KIOSK_PROVE_GETGROCERY_SECRET.
KIOSK_PROVE_INTAKE_SECRET=REPLACE_WITH_SHARED_INTAKE_SECRET
# The broker's RSA PUBLIC key PEM (public half of its PROVE_KEY_PEM). Derive:
# openssl rsa -in prove_key.pem -pubout  (or fetch once from
# https://kyc.demo.kiosk.tech/prove_key.pem). Paste the PEM verbatim.
KIOSK_PROVE_PUBLIC_KEY_PEM=REPLACE_WITH_BROKER_PUBLIC_PEM
