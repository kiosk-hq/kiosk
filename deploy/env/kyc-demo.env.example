# Kiosk hosted demo — prove.my KYC broker   → copy to /etc/kiosk-demo/prove.env
# App dir: kiosk-demo-prove   Subdomain: kyc.demo.kiosk.tech   Port: 3008
# Replace every REPLACE_* value. Keep this file mode 0600, owned by the kiosk
# user. This template is shell-source-safe (`set -a; . file`) as written.
#
# NOTE ON NAMING: the gem dir stays kiosk-demo-prove (no churn); the DEPLOY
# domain is kyc.demo.kiosk.tech. The systemd instance is `prove` (matches the
# dir → /srv/kiosk/kiosk-demo-prove), so copy THIS file to
# /etc/kiosk-demo/prove.env — see the exception note in kiosk-demo@.service.
#
# prove.my is an ISSUER, not a Kiosk operator: no kiosk gem, no signing key,
# no PoW knob, no /.well-known/kiosk.json. It needs only SECRET_KEY_BASE, its
# own DB role, its issuer identity, the shared operator-intake config, and the
# public URL it stamps into verification links.

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
PORT=3008

# ── Database (DB-per-app; role owns kiosk_prove_production) ──────────────────
PGHOST=127.0.0.1
KIOSK_PROVE_DB=kiosk_prove_production
KIOSK_PROVE_DB_USER=kiosk_prove
# Same value passed to postgres-init.sql as -v pv_pw
KIOSK_PROVE_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Issuer identity (the `iss` stamped into every claim; operators pin it) ───
# Operators (skooti) set c.kyc_issuer to this EXACT value and verify the minted
# `iss` against it, so both sides must agree. Defaults to the deploy origin.
KIOSK_PROVE_ISSUER=https://kyc.demo.kiosk.tech
# The public origin the broker stamps into the verification_url it hands back
# (the link the human opens). Defaults to the request base_url; pin it so links
# are correct behind the TLS-terminating Caddy proxy.
PROVE_PUBLIC_URL=https://kyc.demo.kiosk.tech

# ── Broker private signing key (the "ProveKey" — operators trust its PUBLIC
# half). Generate a fresh 2048-bit RSA key for the deploy; do NOT ship the
# baked-in dev key. Give skooti's env the matching PUBLIC PEM (KIOSK_KYC_PUBLIC_KEY).
# Generate: openssl genrsa 2048   (paste the PEM verbatim, or load from a file)
PROVE_KEY_PEM=REPLACE_WITH_RSA_PRIVATE_PEM

# ── Operator intake allow-list (design §4.7) ────────────────────────────────
# skooti is the one pre-registered operator. The broker authenticates it by this
# shared bearer secret and will POST callbacks ONLY to the allow-listed host.
# Use the SAME secret in skooti's env (KIOSK_KYC_INTAKE_SECRET / the value
# ProveTrust.intake_secret reads).
# Generate: openssl rand -hex 32
KIOSK_PROVE_SKOOTI_SECRET=REPLACE_WITH_SHARED_INTAKE_SECRET
# The ONLY host the broker will POST skooti's callback to (SSRF/open-relay guard).
KIOSK_PROVE_SKOOTI_CALLBACK_HOST=skooti.demo.kiosk.tech
