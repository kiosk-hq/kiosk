# Kiosk hosted demo — KYC broker   → copy to /etc/kiosk-demo/prove.env
# App dir: kiosk-demo-prove   Subdomain: kyc.demo.kiosk.tech   Port: 3008
# Replace every REPLACE_* value. `deploy/rollout.sh --apply` installs this onto
# the box and sets its owner and mode. Shell-source-safe (`set -a; . file`).
#
# NOTE ON NAMING: the gem dir stays kiosk-demo-prove (no churn); the DEPLOY
# domain is kyc.demo.kiosk.tech. The systemd instance is `prove` (matches the
# dir → /srv/kiosk/kiosk-demo-prove), so copy THIS file to
# /etc/kiosk-demo/prove.env — see the exception note in kiosk-demo@.service.
#
# the broker is an ISSUER, not a Kiosk operator: no kiosk gem, no signing key,
# no PoW knob, no /.well-known/kiosk.json. It needs only SECRET_KEY_BASE, its
# own DB role, its issuer identity, the shared operator-intake config, and the
# public URL it stamps into verification links.

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
PORT=3008

# ── Database (DB-per-app; the app reads BOTH names from here) ────────────────
# config/database.yml (production) resolves the database and login role from
# the two variables below, defaulting to exactly these values. Change either
# one and you must pass the SAME value to deploy/postgres-init.sql
# (-v pv_db=… / -v pv_user=…) — otherwise provisioning creates one name and
# the app connects to another. Leave them as shipped: nothing to keep in sync.
PGHOST=127.0.0.1
KIOSK_PROVE_DB=kiosk_prove_production
KIOSK_PROVE_DB_USER=kiosk_prove
# Same value passed to postgres-init.sql as -v pv_pw
KIOSK_PROVE_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Issuer identity (the `iss` stamped into every claim; operators pin it) ───
# Every operator sets c.kyc_issuer to this EXACT value and verifies the minted
# `iss` against it, so both sides must agree. Defaults to the deploy origin.
KIOSK_PROVE_ISSUER=https://kyc.demo.kiosk.tech
# The public origin the broker stamps into the verification_url it hands back
# (the link the human opens). Defaults to the request base_url; pin it so links
# are correct behind the TLS-terminating Caddy proxy.
PROVE_PUBLIC_URL=https://kyc.demo.kiosk.tech

# ── Broker private signing key (the "ProveKey" — operators trust its PUBLIC
# half). REQUIRED, enforced at boot: in production the broker refuses
# to start without it, and rejects a value that does not parse as an RSA
# PRIVATE key — the baked-in dev key is dev/test-only (its private half is
# world-readable in the public repo, so signing with it would let anyone forge
# attestations). Give EVERY allow-listed operator's env the matching PUBLIC PEM
# (KIOSK_PROVE_PUBLIC_KEY_PEM) — without it that operator's KycVerifier fails
# closed and its age gate refuses whatever the broker signs.
# Generate: openssl genrsa 2048   (paste the PEM verbatim, or load from a file)
PROVE_KEY_PEM=REPLACE_WITH_RSA_PRIVATE_PEM

# ── Operator intake allow-list (the broker's intake trust model) ───────────
# EVERY operator demo that ships app/services/prove_broker_client.rb needs a
# PAIR of variables here, and an operator with neither is simply NOT REGISTERED
# — its intakes answer 401 and its `request_kyc` fails, while the operator box
# itself looks perfectly configured. There is no default for either: a shipped
# one is world-readable in this public repo, so anyone could present it to drive
# operator intake and trigger broker→operator callbacks. Fail-closed is the
# right posture; SILENTLY fail-closed is what this block exists to prevent, and
# bin/check-kyc-operator-pairing holds the pairing across both templates.
#
# The names on the two sides differ ON PURPOSE. The BROKER keeps a per-operator
# name, one registry entry each; every OPERATOR app reads ONE role-named
# KIOSK_PROVE_INTAKE_SECRET, because config/environments/production.rb is
# byte-identical across the operator demos and so must not name a demo. The
# VALUE is what pairs them, and the broker looks the operator up by the
# `operator_id` in the intake body.
#
# Generate each secret: openssl rand -hex 32
#
# skooti — motorcycle licence + age gate.
KIOSK_PROVE_SKOOTI_SECRET=REPLACE_WITH_SHARED_INTAKE_SECRET
# The ONLY host the broker will POST skooti's callback to (SSRF/open-relay
# guard). It must be the host of skooti's own KIOSK_ISSUER: that is the origin
# request_kyc builds its callback_url from, and a value that disagrees makes
# every intake 403 while both secrets match.
KIOSK_PROVE_SKOOTI_CALLBACK_HOST=skooti.demo.kiosk.tech
# getgrocery — the alcohol age gate (age_over_18). A DISTINCT operator with its
# own secret and its own callback host; sharing skooti's would let either one
# obtain the other's attestations.
KIOSK_PROVE_GETGROCERY_SECRET=REPLACE_WITH_SHARED_INTAKE_SECRET
# Same rule as above: the host of getgrocery's own KIOSK_ISSUER.
KIOSK_PROVE_GETGROCERY_CALLBACK_HOST=getgrocery.demo.kiosk.tech
