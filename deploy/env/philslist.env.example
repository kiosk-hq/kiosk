# Kiosk hosted demo — philslist   → copy to /etc/kiosk-demo/philslist.env
# Subdomain: philslist.demo.kiosk.tech   Port: 3006
# Replace every REPLACE_* value. Keep this file mode 0600, owned by the kiosk
# user. This template is shell-source-safe (`set -a; . file`) as written.

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
PORT=3006

# ── Database (DB-per-app; the app reads BOTH names from here) ────────────────
# config/database.yml (production) resolves the database and login role from
# the two variables below, defaulting to exactly these values. Change either
# one and you must pass the SAME value to deploy/postgres-init.sql
# (-v pl_db=… / -v pl_user=…) — otherwise provisioning creates one name and
# the app connects to another. Leave them as shipped: nothing to keep in sync.
PGHOST=127.0.0.1
KIOSK_PHILSLIST_DB=kiosk_philslist_production
KIOSK_PHILSLIST_DB_USER=kiosk_philslist
# Same value passed to postgres-init.sql as -v pl_pw
KIOSK_PHILSLIST_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://philslist.demo.kiosk.tech
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work: LOW / poke-friendly ──────────────────────────────────────
# philslist gates registration with PoW UNCONDITIONALLY (wired in the app config,
# no env flag to set — it activates on code-deploy). Low so a poker solves in ~1 s.
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET
# Difficulty knob: low (wired: registration_pow_params = PowDifficulty.params —
# every demo honors it now; set high to feel this demo's own registration toll.
# atablefor is the pinned production-grade showcase, not this one).
KIOSK_POW_DIFFICULTY=low
