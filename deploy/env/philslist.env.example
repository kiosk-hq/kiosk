# Kiosk hosted demo — philslist   → copy to /etc/kiosk-demo/philslist.env
# Subdomain: philslist.demo.kiosk.tech   Port: 3006
# Replace every REPLACE_* value. Keep this file mode 0600, owned by the kiosk
# user. This template is shell-source-safe (`set -a; . file`) as written.

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
PORT=3006

# ── Database (DB-per-app; role owns kiosk_philslist_production) ──────────────
PGHOST=127.0.0.1
KIOSK_PHILSLIST_DB=kiosk_philslist_production
KIOSK_PHILSLIST_DB_USER=kiosk_philslist
# Same value passed to postgres-init.sql as -v pl_pw
KIOSK_PHILSLIST_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://philslist.demo.kiosk.tech
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work: LOW / poke-friendly ──────────────────────────────────────
# philslist gates registration with PoW. Low so a poker solves in ~1 s.
KIOSK_POW_REGISTER_DEMO=1
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET
# This demo runs fixed low PoW params (n=96 k=5); it does not read the
# KIOSK_POW_DIFFICULTY knob (wired only in the higher-toll demos).
