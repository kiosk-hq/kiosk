# Kiosk hosted demo — skooti   → copy to /etc/kiosk-demo/skooti.env
# Subdomain: skooti.demo.kiosk.tech   Port: 3004
# Replace every REPLACE_* value. `deploy/rollout.sh` installs this onto the box
# and sets its owner and mode. Shell-source-safe (`set -a; . file`).

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
PORT=3004

# ── Database (DB-per-app; the app reads BOTH names from here) ────────────────
# config/database.yml (production) resolves the database and login role from
# the two variables below, defaulting to exactly these values. Change either
# one and you must pass the SAME value to deploy/postgres-init.sql
# (-v sk_db=… / -v sk_user=…) — otherwise provisioning creates one name and
# the app connects to another. Leave them as shipped: nothing to keep in sync.
PGHOST=127.0.0.1
KIOSK_SKOOTI_DB=kiosk_skooti_production
KIOSK_SKOOTI_DB_USER=kiosk_skooti
# Same value passed to postgres-init.sql as -v sk_pw
KIOSK_SKOOTI_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://skooti.demo.kiosk.tech
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work ────────────────────────────────────────────────────────────
# skooti tolls REGISTRATION with one Equihash proof at n=96 k=5, fixed in
# config/initializers/kiosk.rb.
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET

# ── Payments: real Stripe in TEST mode ──────────────────────────
# skooti runs SetupIntent card-on-file. Test key only — NO live key on the
# box. Test card 4242 4242 4242 4242 (any future expiry/CVC). No real charge.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_TEST_KEY

# ── Rental-token (lock) signing key — REQUIRED, enforced at boot ────────────
# The Ed25519 key skooti signs every offline unlock/rental token with; each
# scooter lock verifies against its PUBLIC half, baked in at provisioning.
# skooti is the only demo with locks, so it is the only env file carrying this.
# There is NO fallback: the dev keypair at kiosk-demo-skooti/config/
# dev_unlock_key.pem ships in a PUBLIC repo, so signing production tokens with
# it would let anyone with a clone mint a token any provisioned lock accepts —
# past reserve, past payment, past ownership, past KYC. skooti REFUSES TO BOOT
# in production without this variable (config/environments/production.rb).
# Generate: openssl genpkey -algorithm ed25519
# Paste the PEM verbatim (multi-line is fine under `set -a; . file`), e.g.:
#   KIOSK_UNLOCK_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----
#   …
#   -----END PRIVATE KEY-----"
# Then provision/flash the locks with the matching public half:
#   openssl pkey -in unlock_key.pem -pubout -outform DER | tail -c 32 | xxd -p -c 32
KIOSK_UNLOCK_SIGNING_KEY_PEM=REPLACE_WITH_ED25519_PRIVATE_PEM

# ── KYC broker trust (skooti gates rent_motorcycle on age_over_18 +
# licence_a; the SHARED KYC broker at kyc.demo.kiosk.tech is skooti's
# trusted KYC issuer). The issuer and broker URL default to the broker's
# deploy values (Kiosk::KycProviders::Prove); the SECRET and the PUBLIC KEY have NO defaults
# at all (they are read via config/environments from these
# variables, fail-closed when unset) — so those two are REQUIRED for the KYC
# flow, and pinning all four makes a rotated broker key or a moved broker
# origin a config change, not a code change. ──────────────────────────────────
# The broker's issuer identity — MUST equal the broker's KIOSK_PROVE_ISSUER
# (skooti's KycVerifier compares the minted `iss` against this).
KIOSK_PROVE_ISSUER=https://kyc.demo.kiosk.tech
# Where skooti's request_kyc calls the broker intake (server-to-server).
KIOSK_PROVE_BROKER_URL=https://kyc.demo.kiosk.tech
# The shared bearer secret skooti presents at the broker intake. The OPERATOR
# side reads ONE role-named variable; the BROKER side keeps a per-operator
# name: this value MUST equal the broker's KIOSK_PROVE_SKOOTI_SECRET.
KIOSK_PROVE_INTAKE_SECRET=REPLACE_WITH_SHARED_INTAKE_SECRET
# The broker's RSA PUBLIC key PEM (the "ProveKey" public half). skooti pins this
# as c.kyc_public_key so KycVerifier accepts the broker's signatures. This MUST
# be the public half of the broker's PROVE_KEY_PEM. Paste the PEM verbatim
# (multi-line is fine under `set -a; . file`), e.g.:
#   KIOSK_PROVE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
#   …
#   -----END PUBLIC KEY-----"
# Derive from the broker key: openssl rsa -in prove_key.pem -pubout
# (or fetch once from https://kyc.demo.kiosk.tech/prove_key.pem).
KIOSK_PROVE_PUBLIC_KEY_PEM=REPLACE_WITH_BROKER_PUBLIC_PEM
