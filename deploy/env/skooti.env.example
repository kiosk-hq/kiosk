# Kiosk hosted demo — skooti (T-032)   → copy to /etc/kiosk-demo/skooti.env
# Subdomain: skooti.demo.kiosk.tech   Port: 3004
# Design: meta/docs/architecture/2026-07-20-hosted-live-demos.md
# Replace every REPLACE_* value. Keep this file mode 0600, owned by the kiosk
# user. This template is shell-source-safe (`set -a; . file`) as written.

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
PORT=3004

# ── Database (DB-per-app; role owns kiosk_skooti_production) ─────────────────
PGHOST=127.0.0.1
KIOSK_SKOOTI_DB=kiosk_skooti_production
KIOSK_SKOOTI_DB_USER=kiosk_skooti
# Same value passed to postgres-init.sql as -v sk_pw
KIOSK_SKOOTI_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://skooti.demo.kiosk.tech
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work: HIGH / "beware: memory- and CPU-intensive PoW" ───────────
# skooti gates REGISTRATION with PoW (registration_pow_count=1). It is one of
# the TWO high-toll demos (with atablefor): a poker feels the real ~30 s
# memory+CPU-hard toll before their first register succeeds — the DoS shield
# made tangible (design §8.4). Show the "beware: intensive PoW" banner.
# NOTE: skooti's initializer has no on/off env toggle — its registration PoW is
# always on; params live in code (SKOOTI_REGISTRATION_POW_PARAMS). Only the
# difficulty knob below is a deploy-time intent.
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET
# Design knob (§8): HIGH here. See getgrocery.env for the wiring caveat (today
# fixed small params; high→heavy ~30 s mapping lands with the follow-up).
KIOSK_POW_DIFFICULTY=high
