# Kiosk hosted demo — tudu   → copy to /etc/kiosk-demo/tudu.env
# Subdomain: tudu.demo.kiosk.tech   Port: 3007
# Replace every REPLACE_* value. `deploy/rollout.sh` installs this onto the box
# and sets its owner and mode. Shell-source-safe (`set -a; . file`).

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

# Demo only: one Puma worker, so eight apps fit one small box. Size workers for your traffic.
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
PORT=3007

# ── Database (DB-per-app; the app reads BOTH names from here) ────────────────
# config/database.yml (production) resolves the database and login role from
# the two variables below, defaulting to exactly these values. Change either
# one and you must pass the SAME value to deploy/postgres-init.sql
# (-v td_db=… / -v td_user=…) — otherwise provisioning creates one name and
# the app connects to another. Leave them as shipped: nothing to keep in sync.
PGHOST=127.0.0.1
KIOSK_TUDU_DB=kiosk_tudu_production
KIOSK_TUDU_DB_USER=kiosk_tudu
# Same value passed to postgres-init.sql as -v td_pw
KIOSK_TUDU_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://tudu.demo.kiosk.tech
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work ────────────────────────────────────────────────────────────
# Registration costs one Equihash proof at the gem default (n=168 k=7), set in
# config/initializers/kiosk.rb; nothing here changes it.
# HMAC key every proof-of-work challenge is signed with: required, at least 32 bytes.
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET
