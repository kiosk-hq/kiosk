# Kiosk hosted demo — tudu (T-032)   → copy to /etc/kiosk-demo/tudu.env
# Subdomain: tudu.demo.kiosk.tech   Port: 3007
# Design: meta/docs/architecture/2026-07-20-hosted-live-demos.md
# Replace every REPLACE_* value. Keep this file mode 0600, owned by the kiosk
# user. This template is shell-source-safe (`set -a; . file`) as written.

RAILS_ENV=production
# Generate: `bin/rails secret`
SECRET_KEY_BASE=REPLACE_WITH_RAILS_SECRET

WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
PORT=3007

# ── Database (DB-per-app; role owns kiosk_tudu_production) ───────────────────
PGHOST=127.0.0.1
KIOSK_TUDU_DB=kiosk_tudu_production
KIOSK_TUDU_DB_USER=kiosk_tudu
# Same value passed to postgres-init.sql as -v td_pw
KIOSK_TUDU_DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# ── Kiosk identity ──────────────────────────────────────────────────────────
KIOSK_ISSUER=https://tudu.demo.kiosk.tech
# Generate: openssl genrsa 2048 | base64 -w0
KIOSK_SIGNING_KEY_B64=REPLACE_WITH_BASE64_RSA_PEM

# ── Proof-of-Work: LOW / poke-friendly ──────────────────────────────────────
# tudu gates registration with PoW. Low so a poker solves in ~1 s (§3a).
KIOSK_POW_REGISTER_DEMO=1
# Generate: openssl rand -hex 32
KIOSK_POW_SECRET=REPLACE_WITH_POW_SECRET
# Design knob (§8): low. See getgrocery.env for the wiring caveat.
KIOSK_POW_DIFFICULTY=low
