#!/bin/sh
# kiosk — POSIX shell CLI for Kiosk-enabled providers.
#
# The CLI is the public API. Verbs map 1:1 onto the wire protocol
# (POST <endpoint>/exec) per design spec §5.1.
#
# Dependencies: POSIX sh, curl, jq.
# Apache-2.0.

set -eu

VERSION="0.1.0-alpha"
PROG="kiosk"

die() {
  code="$1"; shift
  printf '%s: %s\n' "$PROG" "$*" >&2
  exit "$code"
}

usage() {
  cat <<EOF >&2
usage: $PROG <host> login
       $PROG <host> well-known
       $PROG <host> sql <statement>
       $PROG <host> run <action> [k=v ...]
       $PROG --version | --help

<host> is the provider origin, e.g. https://sweepy.example or
http://localhost:3001. The endpoint is discovered via
<host>/.well-known/kiosk.json (spec §3.4).

token resolution (first match wins):
  KIOSK_TOKEN_<HOST_UPPER>      per-host env, e.g. KIOSK_TOKEN_LOCALHOST_3001
  KIOSK_TOKEN                   generic env
  ~/.kiosk/credentials          JSON map: { "<host>": { "token": "..." } }

exit codes (spec §5.2):
  0 ok          2 bad request / not found       3 auth / forbidden
  4 rls denied  5 quota / rate limit             6 server / network
EOF
}

require_deps() {
  for tool in curl jq; do
    command -v "$tool" >/dev/null 2>&1 \
      || die 6 "required tool not found in PATH: $tool"
  done
}

# Strip trailing slashes from the host argument so the URL we build later is
# never `https://example.com//.well-known/...`.
normalize_host() {
  printf '%s' "$1" | sed 's:/*$::'
}

# Build the per-host env-var name. `http://localhost:3001` → `KIOSK_TOKEN_LOCALHOST_3001`.
# Different schemes, hosts, or ports get distinct keys — a deliberate property,
# so a token bound to staging doesn't leak to prod.
host_env_key() {
  printf 'KIOSK_TOKEN_%s' "$(printf '%s' "$1" \
    | sed -e 's|^https\{0,1\}://||' -e 's|[^A-Za-z0-9]|_|g' \
    | tr 'a-z' 'A-Z')"
}

resolve_token() {
  host="$1"
  env_key=$(host_env_key "$host")
  eval "value=\${$env_key-}"
  if [ -n "$value" ]; then printf '%s' "$value"; return 0; fi
  if [ -n "${KIOSK_TOKEN-}" ]; then printf '%s' "$KIOSK_TOKEN"; return 0; fi
  cred="$HOME/.kiosk/credentials"
  if [ -f "$cred" ]; then
    tok=$(jq -r --arg host "$host" '.[$host].token // empty' "$cred" 2>/dev/null) || tok=""
    if [ -n "$tok" ]; then printf '%s' "$tok"; return 0; fi
  fi
  return 1
}

discover_endpoint() {
  host="$1"
  body=$(curl -sS -f "$host/.well-known/kiosk.json" 2>/dev/null) \
    || die 6 "failed to fetch $host/.well-known/kiosk.json"
  ep=$(printf '%s' "$body" | jq -r '.kiosk.endpoint // empty' 2>/dev/null) || ep=""
  [ -n "$ep" ] || die 6 "well-known missing .kiosk.endpoint"
  printf '%s' "$ep"
}

# Map the server's `error.code` to the CLI exit code per spec §5.2 and
# kiosk-server/lib/kiosk/server/errors.rb. Unknown codes default to 6 so
# scripts can still branch sensibly.
error_code_to_exit() {
  case "$1" in
    bad_request|not_found) printf 2 ;;
    unauthenticated|forbidden) printf 3 ;;
    rls_denied) printf 4 ;;
    quota_exceeded) printf 5 ;;
    *) printf 6 ;;
  esac
}

# Single POST to `<endpoint>/exec`. Prints the success envelope to stdout
# (jq-pretty); on error envelopes prints `code: message [hint]` to stderr
# and exits with the mapped code.
exec_call() {
  host="$1"; body="$2"
  endpoint=$(discover_endpoint "$host")
  token=$(resolve_token "$host") \
    || die 3 "no token for $host (set KIOSK_TOKEN, KIOSK_TOKEN_$(host_env_key "$host" | sed 's/^KIOSK_TOKEN_//'), or ~/.kiosk/credentials)"

  tmp=$(mktemp)
  err=$(mktemp)
  # `set -e` is paused around curl so we can read the response body even
  # when HTTP is non-2xx — the server returns structured JSON envelopes on
  # both success and failure (spec §5.2).
  set +e
  status=$(curl -sS -o "$tmp" -w '%{http_code}' \
    -X POST "$endpoint/exec" \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "$body" 2>"$err")
  rc=$?
  set -e

  response=$(cat "$tmp")
  curl_err_msg=$(cat "$err")
  rm -f "$tmp" "$err"

  if [ "$rc" -ne 0 ] || [ -z "$status" ] || [ "$status" = "000" ]; then
    die 6 "network error talking to $endpoint/exec${curl_err_msg:+: $curl_err_msg}"
  fi

  ok=$(printf '%s' "$response" | jq -r '.ok // false' 2>/dev/null) || ok="false"

  if [ "$ok" = "true" ]; then
    printf '%s' "$response" | jq .
    return 0
  fi

  code=$(printf '%s' "$response" | jq -r '.error.code // "unknown"' 2>/dev/null) || code="unknown"
  msg=$(printf '%s' "$response"  | jq -r '.error.message // empty' 2>/dev/null) || msg=""
  hint=$(printf '%s' "$response" | jq -r '.error.hint // empty'    2>/dev/null) || hint=""
  ec=$(error_code_to_exit "$code")

  if [ -n "$hint" ]; then
    printf '%s: %s: %s (hint: %s)\n' "$PROG" "$code" "$msg" "$hint" >&2
  else
    printf '%s: %s: %s\n' "$PROG" "$code" "$msg" >&2
  fi
  exit "$ec"
}

cmd_well_known() {
  host="$1"
  body=$(curl -sS -f "$host/.well-known/kiosk.json" 2>/dev/null) \
    || die 6 "failed to fetch $host/.well-known/kiosk.json"
  printf '%s' "$body" | jq .
}

cmd_sql() {
  host="$1"; sql="$2"
  body=$(jq -n --arg sql "$sql" '{command:"sql", body:{sql:$sql}}')
  exec_call "$host" "$body"
}

# `kiosk <host> run <action> k=v k=v ...` — each k=v becomes a JSON field.
# Values that parse as a JSON number are sent as numbers; everything else is
# a string. Booleans / nested objects are not supported in the shell
# surface; agents that need richer args call /exec directly.
cmd_run() {
  host="$1"; action="$2"; shift 2
  args_json=$(jq -n --arg name "$action" '{name:$name}')
  for kv; do
    case "$kv" in
      *=*)
        k="${kv%%=*}"
        v="${kv#*=}"
        if printf '%s' "$v" | jq -e 'tonumber' >/dev/null 2>&1; then
          args_json=$(printf '%s' "$args_json" | jq --arg k "$k" --argjson v "$v" '. + {($k): $v}')
        else
          args_json=$(printf '%s' "$args_json" | jq --arg k "$k" --arg v "$v" '. + {($k): $v}')
        fi
        ;;
      *)
        die 2 "expected key=value, got: $kv"
        ;;
    esac
  done
  body=$(jq -n --argjson args "$args_json" '{command:"run", body:$args}')
  exec_call "$host" "$body"
}

# RFC 8628 grant_type literal — long but standard.
GRANT_TYPE_DEVICE_CODE="urn:ietf:params:oauth:grant-type:device_code"

# Save (or update) a host's bearer token to ~/.kiosk/credentials. JSON
# map keyed by host URL: { "<host>": { "token": "..." } }. Atomic write
# via mktemp + mv; 0600 perms so the token never leaks via shared dir.
save_token() {
  host="$1"; token="$2"
  mkdir -p "$HOME/.kiosk"
  cred="$HOME/.kiosk/credentials"
  existing="{}"
  [ -f "$cred" ] && existing=$(cat "$cred")

  updated=$(printf '%s' "$existing" | jq --arg host "$host" --arg token "$token" \
    '. + {($host): {token: $token}}')

  tmp=$(mktemp)
  printf '%s\n' "$updated" >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$cred"
}

# Attempt to open a URL in the user's default browser. Best-effort:
# silently no-op when no opener exists, when stdout isn't a TTY, or
# when KIOSK_NO_BROWSER is set (CI / headless flows).
open_in_browser() {
  url="$1"
  [ -n "${KIOSK_NO_BROWSER-}" ] && return 0
  [ -t 1 ] || return 0

  if command -v open >/dev/null 2>&1; then
    open "$url" 2>/dev/null || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" 2>/dev/null || true
  fi
}

# kiosk login <host> — RFC 8628 Device Authorization Grant.
# Initiates /oauth/device_authorization, displays the user_code, polls
# /oauth/token until the user approves (or denies / code expires) at
# the verification URL. On success, saves the bearer to
# ~/.kiosk/credentials.
#
# Env overrides:
#   KIOSK_CLIENT_ID   override the default `kiosk-cli` client identifier
#   KIOSK_NO_BROWSER  set to skip auto-opening the verification URL
cmd_login() {
  host="$1"
  client_id="${KIOSK_CLIENT_ID:-kiosk-cli}"

  # Step 1 — initiate.
  da_resp=$(curl -sS -X POST "$host/kiosk/oauth/device_authorization" \
    -H "Content-Type: application/x-www-form-urlencoded" \
    --data-urlencode "client_id=$client_id" \
    --data-urlencode "role=customer" 2>/dev/null) \
    || die 6 "failed to initiate device authorization at $host"

  device_code=$(printf '%s' "$da_resp"               | jq -r '.device_code // empty')
  user_code=$(printf '%s' "$da_resp"                 | jq -r '.user_code // empty')
  verification_uri=$(printf '%s' "$da_resp"          | jq -r '.verification_uri // empty')
  verification_uri_complete=$(printf '%s' "$da_resp" | jq -r '.verification_uri_complete // .verification_uri // empty')
  expires_in=$(printf '%s' "$da_resp"                | jq -r '.expires_in // 900')
  interval=$(printf '%s' "$da_resp"                  | jq -r '.interval // 5')

  if [ -z "$device_code" ] || [ -z "$user_code" ] || [ -z "$verification_uri" ]; then
    desc=$(printf '%s' "$da_resp" | jq -r '.error_description // .error // empty')
    die 6 "server did not return a valid device_authorization response${desc:+ ($desc)}"
  fi

  # Step 2 — show the user what to do.
  printf '\n  To complete login, open this URL on any device:\n'
  printf '    \033[1m%s\033[0m\n\n' "$verification_uri"
  printf '  And enter this code:\n'
  printf '    \033[1m%s\033[0m\n\n' "$user_code"

  open_in_browser "$verification_uri_complete"

  printf '  Waiting for approval'

  # Step 3 — poll.
  deadline=$(($(date +%s) + expires_in))
  while :; do
    now=$(date +%s)
    if [ "$now" -ge "$deadline" ]; then
      printf '\n'
      die 6 "device code expired before approval"
    fi

    sleep "$interval"
    printf '.'

    token_resp=$(curl -sS -X POST "$host/kiosk/oauth/token" \
      -H "Content-Type: application/x-www-form-urlencoded" \
      --data-urlencode "grant_type=$GRANT_TYPE_DEVICE_CODE" \
      --data-urlencode "device_code=$device_code" 2>/dev/null) \
      || { printf '\n'; die 6 "network error polling token endpoint"; }

    access_token=$(printf '%s' "$token_resp" | jq -r '.access_token // empty')
    if [ -n "$access_token" ]; then
      printf '\n\n'
      save_token "$host" "$access_token"
      printf '  \033[1;32m✓\033[0m Logged in to %s\n' "$host"
      printf '    token written to %s\n\n' "$HOME/.kiosk/credentials"
      return 0
    fi

    err=$(printf '%s' "$token_resp" | jq -r '.error // empty')
    case "$err" in
      authorization_pending)
        continue
        ;;
      slow_down)
        interval=$((interval + 5))
        continue
        ;;
      access_denied)
        printf '\n'
        die 3 "user denied authorization"
        ;;
      expired_token)
        printf '\n'
        die 6 "device code expired"
        ;;
      "")
        printf '\n'
        die 6 "unexpected token response: $token_resp"
        ;;
      *)
        printf '\n'
        desc=$(printf '%s' "$token_resp" | jq -r '.error_description // empty')
        die 6 "token endpoint error: $err${desc:+ ($desc)}"
        ;;
    esac
  done
}

# ───── main ─────

require_deps

case "${1-}" in
  "")
    usage; exit 2 ;;
  -h|--help|help)
    usage; exit 0 ;;
  -V|--version|version)
    printf '%s %s\n' "$PROG" "$VERSION"; exit 0 ;;
esac

host=$(normalize_host "$1"); shift
verb="${1-}"
[ -n "$verb" ] || { usage; exit 2; }
shift

case "$verb" in
  login)
    cmd_login "$host"
    ;;
  well-known)
    cmd_well_known "$host"
    ;;
  sql)
    [ "$#" -ge 1 ] || die 2 "sql: missing statement"
    cmd_sql "$host" "$1"
    ;;
  run)
    [ "$#" -ge 1 ] || die 2 "run: missing action name"
    cmd_run "$host" "$@"
    ;;
  schema|help|pay|events|register)
    die 6 "verb '$verb' not yet implemented in this milestone (M2 in progress)"
    ;;
  *)
    die 2 "unknown verb: $verb (try: login, well-known, sql, run)"
    ;;
esac
