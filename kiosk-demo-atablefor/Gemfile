source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# The per-identity bad-proof counter (lib/bad_proof_counter.rb) — a small
# sqlite store on the PoW demo path, NOT a second application database.
gem "sqlite3", "~> 2.7"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Action Cable's pubsub adapter, for the Kiosk event stream. NOT `async`: that
# adapter delivers only inside ONE process, so the moment this app runs a second
# Puma worker an event reaches whichever worker happened to emit it and no
# other — silently, with nothing in any log. A demo is the worked example an
# operator copies, and `adapter: async` in a copied cable.yml teaches a
# single-process posture that breaks without saying so.
gem "solid_cable"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Human diner accounts sign in with real Devise sessions; the Kiosk
# account-binding surfaces (link mint, verify page, unlink) authenticate
# that Warden session through the kiosk-user-idp-devise adapter below, so a
# diner can link their AI assistant to their restaurant account.
gem "devise"

# ─── Kiosk ────────────────────────────────────────────────────────────
# Path overrides while the gems live in this monorepo. When the demo
# moves to its own kiosk-hq/kiosk-demo-atablefor repo, swap these to
# rubygems-published versions.
gem "kiosk-all",                path: "../kiosk-all"
gem "kiosk-core",               path: "../kiosk-core"
gem "kiosk-rls",                path: "../kiosk-rls"
gem "kiosk-server",             path: "../kiosk-server"
gem "kiosk-pow-equihash",       path: "../kiosk-pow-equihash"
# The shared adversarial harness. `script/redteam_suite.rb` runs its
# DeviceGrantRoleSelfSelection scenario, so every demo asserts the SAME thing
# about the account-binding claim ceremony instead of each one hand-rolling it.
gem "kiosk-redteam",            path: "../kiosk-redteam"
gem "kiosk-reputation",         path: "../kiosk-reputation"
gem "kiosk-user-idp-devise",    path: "../kiosk-user-idp-devise"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
end
