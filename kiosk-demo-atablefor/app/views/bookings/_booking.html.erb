<% restaurant, table = booking.restaurant, booking.restaurant_table %>
<li class="res">
  <span class="res-party" title="party size"><%= booking.party_size %>&nbsp;guests</span>
  <span class="res-table"><%= restaurant.name %><% if restaurant.neighborhood.present? %> <span class="res-hood">(<%= restaurant.neighborhood %>)</span><% end %> · <%= table.label %></span>
  <span class="res-when"><%= seating_label(booking) %></span>
  <span class="res-name"><%= booking.user.public_name %></span>
</li>
