#!/usr/bin/env bash
# Kiosk foodelivery demo walkthrough — a curl-driven tour of the wire surface.
#
# Run via `rake demo:walkthrough` (boots the server, runs this script, tears
# down), or directly when the demo DB is already prepared (rake demo:setup).
# `rake demo` runs the pay-settling headline (demo:setup + demo:order), not
# this tour.
#
# This tour browses and places one real order under a single stable stub
# principal (AGENT_TOKEN below); demo:setup seeds its users row so place_order
# succeeds (Order belongs_to :user). The order/my_orders steps ASSERT their
# results and exit non-zero on any mismatch — a broken showcase fails loudly.

set -euo pipefail

PORT="${KIOSK_DEMO_PORT:-3002}"
SERVER_URL="http://127.0.0.1:$PORT"

# Stable stub token for menu browse (no human needed — this is the no-auth-human path)
AGENT_TOKEN="agent:u-00000000-0000-0000-0000-000000000001:a-alice-agent:r-customer"

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
step()    { printf "\n  \033[1;33m▶\033[0m %s\n" "$1"; }
say()     { printf "  %s\n" "$1"; }

cleanup() {
  if [[ -n "${SERVER_PID:-}" ]]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

require_tool() {
  command -v "$1" >/dev/null 2>&1 \
    || { echo "missing: $1 — install it then re-run" >&2; exit 1; }
}
require_tool curl
require_tool jq

# ─── boot ────────────────────────────────────────────────────────────

heading "Starting foodelivery (the demo provider) on port $PORT"
KIOSK_ISSUER="$SERVER_URL" \
  bundle exec rails s -p "$PORT" -b 127.0.0.1 -e development \
  >/tmp/kiosk-foodelivery-demo.log 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 30); do
  if curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null 2>&1; then
    say "✓ Server up at $SERVER_URL"
    break
  fi
  sleep 1
done

curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null || {
  echo "server did not become ready — see /tmp/kiosk-foodelivery-demo.log" >&2
  exit 1
}

# ─── discovery ───────────────────────────────────────────────────────

heading "Discovery: what is this provider?"

step "GET /.well-known/kiosk.json"
curl -sf "$SERVER_URL/.well-known/kiosk.json" \
  | jq '.kiosk | {version, endpoint, issuer, capabilities, owner}'

step "GET <endpoint>/.well-known/jwks.json — public verification keys"
curl -sf "$SERVER_URL/kiosk/.well-known/jwks.json" \
  | jq '.keys[0] | {kty, use, alg, kid}'

# ─── named queries ───────────────────────────────────────────────────

heading "Agent browses the menu via named queries"

step "List restaurants (publicly visible) — query: restaurants"
curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"name":"restaurants"}' \
  | jq '.rows'

step "List menu items for Mamma Pizza — query: menu_by_restaurant"
curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"name":"menu_by_restaurant","restaurant":"Mamma Pizza"}' \
  | jq '.rows'

# ─── run an Action ───────────────────────────────────────────────────

heading "Agent places an order via Action (no human at the provider)"

MENU_ITEM_ID=$(curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"name":"menu_by_restaurant","restaurant":"Mamma Pizza"}' \
  | jq -r '.rows[] | select(.sku=="margherita") | .id')

step "run place_order for menu_item $MENU_ITEM_ID (Margherita)"
PLACE_RESP=$(curl -sS -X POST "$SERVER_URL/kiosk/run" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"place_order\",\"menu_item_id\":$MENU_ITEM_ID,\"quantity\":1,\"delivery_address\":\"1 Test St\"}")
printf '%s\n' "$PLACE_RESP" | jq '.value'

# Assert: a success envelope carries a .value object with an order_id. A broken
# showcase (e.g. missing users row → Order belongs_to :user fails) returns an
# error envelope with .value == null; catch it here and fail the script.
ORDER_ID=$(printf '%s\n' "$PLACE_RESP" | jq -r '.value.order_id // empty')
if [[ -z "$ORDER_ID" ]]; then
  echo "✗ place_order did not return a value.order_id — got: $PLACE_RESP" >&2
  exit 1
fi
say "✓ place_order succeeded (order_id=$ORDER_ID)"

# ─── app-layer isolation ─────────────────────────────────────────────

heading "App-layer isolation: agent sees only their own orders"

step "Count orders visible to this agent's user (should be 1) — query: my_orders"
MY_ORDERS_RESP=$(curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"name":"my_orders"}')
MY_ORDERS_COUNT=$(printf '%s\n' "$MY_ORDERS_RESP" | jq '.rows | length')
printf '%s\n' "$MY_ORDERS_COUNT"

# Assert: exactly the one order just placed is visible to this principal
# (fresh DB from demo:setup → 0 pre-existing orders). A broken place_order
# (0 rows) or a cross-tenant leak (>1 row) trips this.
if [[ "$MY_ORDERS_COUNT" != "1" ]]; then
  echo "✗ my_orders expected exactly 1 row, got ${MY_ORDERS_COUNT} — response: $MY_ORDERS_RESP" >&2
  exit 1
fi
# ...and that row is the order just placed, not some stray row.
MY_ORDER_ID=$(printf '%s\n' "$MY_ORDERS_RESP" | jq -r '.rows[0].id // empty')
if [[ "$MY_ORDER_ID" != "$ORDER_ID" ]]; then
  echo "✗ my_orders row id ($MY_ORDER_ID) != placed order id ($ORDER_ID) — response: $MY_ORDERS_RESP" >&2
  exit 1
fi
say "✓ my_orders shows exactly the 1 order just placed (app-layer per-user isolation)"

# ─── done ────────────────────────────────────────────────────────────

heading "Demo complete"
say "Server log:        /tmp/kiosk-foodelivery-demo.log"
say "DB:                kiosk_foodelivery_development"
say ""
say "To add realistic domain resolution:"
say "  echo \"127.0.0.1 foodelivery.app\" | sudo tee -a /etc/hosts"
say "  KIOSK_ISSUER=https://foodelivery.app KIOSK_DEMO_PORT=443 rake demo:walkthrough"
say ""
say "Swap StubPsp for real Stripe:"
say "  replace StubPsp.new with Kiosk::PaymentProviders::Stripe.new(api_key: ENV['STRIPE_SECRET_KEY'])"
