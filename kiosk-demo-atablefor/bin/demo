#!/usr/bin/env bash
# Kiosk atablefor demo walkthrough — a curl-driven tour of the wire surface.
#
# Run via `rake demo:walkthrough` (boots the server, runs this script, tears
# down), or directly when the demo DB is already prepared (rake demo:setup).
# `rake demo` runs the headline booking (demo:setup + demo:book), not this tour.
#
# This tour books one real table under ONE assistant that EARNS its principal:
# script/mint_agent_token.rb runs the shipped `/kiosk/auth/register` handshake
# and prints the kiosk-pop token the engine minted (T-104 — there is no
# self-asserted bearer a shell script can write down any more). Registration
# creates that assistant's own account row, so no human and no seeded principal
# is involved; `Booking belongs_to :user` is satisfied by the row register
# created. The book/my_bookings steps ASSERT their results and exit non-zero on
# any mismatch — a broken showcase fails loudly.
# atablefor takes NO payments: a table reservation needs none.

set -euo pipefail

PORT="${KIOSK_DEMO_PORT:-3002}"
SERVER_URL="http://127.0.0.1:$PORT"

DEMO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# "a table for two tonight at 8" — availability returns the current upcoming
# seatings (Europe/Lisbon), so the tour reads the seating date/time off a row.
PARTY=2

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
step()    { printf "\n  \033[1;33m▶\033[0m %s\n" "$1"; }
say()     { printf "  %s\n" "$1"; }

cleanup() {
  if [[ -n "${SERVER_PID:-}" ]]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

require_tool() {
  command -v "$1" >/dev/null 2>&1 \
    || { echo "missing: $1 — install it then re-run" >&2; exit 1; }
}
require_tool curl
require_tool jq

# The 0.4 wire: one endpoint per verb. A query is a GET whose arguments are the
# query string; an action is a POST whose arguments are the JSON body. A success
# body IS the result — no envelope to unwrap, so no `.rows`/`.value` below.
#   q   <token> <query-name> [query-string]
#   run <token> <action-name> <json-body>
q()   { curl -sS "$SERVER_URL/kiosk/$2${3:+?$3}" -H "Authorization: Bearer $1"; }
run() { curl -sS -X POST "$SERVER_URL/kiosk/$2" -H "Authorization: Bearer $1" \
          -H "Content-Type: application/json" -d "$3"; }

# ─── boot ────────────────────────────────────────────────────────────

heading "Starting atablefor (the demo provider) on port $PORT"
KIOSK_ISSUER="$SERVER_URL" \
  bundle exec rails s -p "$PORT" -b 127.0.0.1 -e development \
  >/tmp/kiosk-atablefor-demo.log 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 30); do
  if curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null 2>&1; then
    say "✓ Server up at $SERVER_URL"
    break
  fi
  sleep 1
done

curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null || {
  echo "server did not become ready — see /tmp/kiosk-atablefor-demo.log" >&2
  exit 1
}

# ─── the assistant earns its principal ───────────────────────────────

heading "Assistant registers itself: POST /kiosk/auth/register"

# This one step is NOT curl-shaped: the handshake signs a server challenge with
# a fresh RSA key and pays whatever Equihash toll the operator charges. Ruby
# does it once, here, and prints the kiosk-pop JWT the ENGINE minted — the only
# kind of bearer this provider accepts.
AGENT_TOKEN=$(SERVER_URL="$SERVER_URL" KIOSK_ISSUER="$SERVER_URL" \
  bundle exec ruby "$DEMO_ROOT/script/mint_agent_token.rb")
if [[ -z "$AGENT_TOKEN" ]]; then
  echo "✗ /kiosk/auth/register did not yield a token (handshake output above; server log /tmp/kiosk-atablefor-demo.log)" >&2
  exit 1
fi
say "✓ registered — every call below carries the token the engine issued"

# ─── discovery ───────────────────────────────────────────────────────

heading "Discovery: what is this provider?"

step "GET /.well-known/kiosk.json"
# capabilities are [schema, queries, actions] — no `pay` (a reservation takes no money).
curl -sf "$SERVER_URL/.well-known/kiosk.json" \
  | jq '.kiosk | {version, endpoint, issuer, capabilities, owner}'

step "GET <endpoint>/.well-known/jwks.json — public verification keys"
curl -sf "$SERVER_URL/kiosk/.well-known/jwks.json" \
  | jq '.keys[0] | {kty, use, alg, kid}'

# ─── named queries ───────────────────────────────────────────────────

heading "Agent checks availability via a named query"

step "Open tables across the aggregator for a party of $PARTY (upcoming seatings) — GET /kiosk/availability"
q "$AGENT_TOKEN" availability "party_size=$PARTY" | jq '.'

# ─── run an Action ───────────────────────────────────────────────────

heading "Agent books a table via Action (no human at the provider)"

# Pick a 20:00 2-top ("a table for two tonight at 8"); fall back to the first
# open table if the headline seating is gone. Read the whole row so we can pass
# restaurant_id + restaurant_table_id + seating_date back to book_table.
SLOT=$(q "$AGENT_TOKEN" availability "party_size=$PARTY" \
  | jq -c '([.[] | select(.seating_time=="20:00")] + .)[0] // empty')

if [[ -z "$SLOT" ]]; then
  echo "✗ no open table for a party of $PARTY in the upcoming seatings" >&2
  exit 1
fi
RESTAURANT_ID=$(printf '%s' "$SLOT" | jq -r '.restaurant_id')
TABLE_ID=$(printf '%s' "$SLOT" | jq -r '.restaurant_table_id')
SLOT_DATE=$(printf '%s' "$SLOT" | jq -r '.seating_date')
SLOT_TIME=$(printf '%s' "$SLOT" | jq -r '.seating_time')

step "POST /kiosk/book_table at restaurant $RESTAURANT_ID table $TABLE_ID for $SLOT_DATE $SLOT_TIME, party of $PARTY"
BOOK_RESP=$(run "$AGENT_TOKEN" book_table \
  "{\"restaurant_id\":$RESTAURANT_ID,\"restaurant_table_id\":$TABLE_ID,\"date\":\"$SLOT_DATE\",\"time\":\"$SLOT_TIME\",\"party_size\":$PARTY}")
printf '%s\n' "$BOOK_RESP" | jq '.'

# Assert: an action's success body IS its own object, carrying a booking_id. A
# broken showcase (e.g. missing users row → Booking belongs_to :user fails)
# answers an RFC 9457 problem document with no booking_id at all; catch it here
# and fail the script.
BOOKING_ID=$(printf '%s\n' "$BOOK_RESP" | jq -r '.booking_id // empty')
if [[ -z "$BOOKING_ID" ]]; then
  echo "✗ book_table did not return a booking_id — got: $BOOK_RESP" >&2
  exit 1
fi
say "✓ book_table succeeded (booking_id=$BOOKING_ID)"

# ─── app-layer isolation ─────────────────────────────────────────────

heading "App-layer isolation: agent sees only their own bookings"

step "List bookings visible to this agent's user (should be 1) — GET /kiosk/my_bookings"
MY_RESP=$(q "$AGENT_TOKEN" my_bookings)
MY_COUNT=$(printf '%s\n' "$MY_RESP" | jq 'length')
printf '%s\n' "$MY_COUNT"

# Assert: exactly the one booking just made is visible to this principal
# (fresh DB from demo:setup → 0 pre-existing bookings). A broken book_table
# (0 rows) or a cross-tenant leak (>1 row) trips this.
if [[ "$MY_COUNT" != "1" ]]; then
  echo "✗ my_bookings expected exactly 1 row, got ${MY_COUNT} — response: $MY_RESP" >&2
  exit 1
fi
MY_BOOKING_ID=$(printf '%s\n' "$MY_RESP" | jq -r '.[0].booking_id // empty')
if [[ "$MY_BOOKING_ID" != "$BOOKING_ID" ]]; then
  echo "✗ my_bookings row id ($MY_BOOKING_ID) != booking id ($BOOKING_ID) — response: $MY_RESP" >&2
  exit 1
fi
say "✓ my_bookings shows exactly the 1 booking just made (app-layer per-user isolation)"

# ─── done ────────────────────────────────────────────────────────────

heading "Demo complete"
say "Server log:        /tmp/kiosk-atablefor-demo.log"
say "DB:                kiosk_atablefor_development"
say ""
say "To add realistic domain resolution:"
say "  echo \"127.0.0.1 atablefor.demo.kiosk.tech\" | sudo tee -a /etc/hosts"
say "  KIOSK_ISSUER=https://atablefor.demo.kiosk.tech KIOSK_DEMO_PORT=443 rake demo:walkthrough"
say ""
say "Production-shape auth — two DIFFERENT seams, neither replacing the other:"
say "  • AGENT-IdP (c.agent_idp): nothing to wire, and this demo sets nothing."
say "    The token above is a kiosk-pop JWT this engine minted at"
say "    /kiosk/auth/register, verified by the adapter it already ships"
say "    (Kiosk::Server::AgentIdentityProviders::DefaultAgentIdp). Set"
say "    c.agent_idp ONLY to front an EXTERNAL agent-identity issuer, by"
say "    subclassing Kiosk::AgentIdentityProviders::Base — whose one hard"
say "    constraint is that the agent_id it returns must be a uuid."
say "  • USER-IdP (c.user_idp): the HUMAN account channel — sign-in, link-code"
say "    mint, unlink. This demo already runs kiosk-user-idp-devise there;"
say "    rake demo:binding walks a diner linking their assistant."
