#!/usr/bin/env bash
# Kiosk atablefor demo walkthrough — a curl-driven tour of the wire surface.
#
# Run via `rake demo:walkthrough` (boots the server, runs this script, tears
# down), or directly when the demo DB is already prepared (rake demo:setup).
# `rake demo` runs the headline booking (demo:setup + demo:book), not this tour.
#
# This tour books one real table under a single stable stub principal
# (AGENT_TOKEN below); demo:setup seeds its users row so book_table succeeds
# (Booking belongs_to :user). The book/my_bookings steps ASSERT their results
# and exit non-zero on any mismatch — a broken showcase fails loudly.
# atablefor takes NO payments: a table reservation needs none.

set -euo pipefail

PORT="${KIOSK_DEMO_PORT:-3002}"
SERVER_URL="http://127.0.0.1:$PORT"

# Stable stub token for the booking tour (no human needed — the no-auth-human path)
AGENT_TOKEN="agent:u-00000000-0000-0000-0000-000000000001:a-alice-agent:r-customer"

# "a table for two, tomorrow at 8" — tomorrow's date, 20:00.
TOMORROW="$(date -v+1d +%Y-%m-%d 2>/dev/null || date -d '+1 day' +%Y-%m-%d)"
PARTY=2

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
step()    { printf "\n  \033[1;33m▶\033[0m %s\n" "$1"; }
say()     { printf "  %s\n" "$1"; }

cleanup() {
  if [[ -n "${SERVER_PID:-}" ]]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

require_tool() {
  command -v "$1" >/dev/null 2>&1 \
    || { echo "missing: $1 — install it then re-run" >&2; exit 1; }
}
require_tool curl
require_tool jq

# ─── boot ────────────────────────────────────────────────────────────

heading "Starting atablefor (the demo provider) on port $PORT"
KIOSK_ISSUER="$SERVER_URL" \
  bundle exec rails s -p "$PORT" -b 127.0.0.1 -e development \
  >/tmp/kiosk-atablefor-demo.log 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 30); do
  if curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null 2>&1; then
    say "✓ Server up at $SERVER_URL"
    break
  fi
  sleep 1
done

curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null || {
  echo "server did not become ready — see /tmp/kiosk-atablefor-demo.log" >&2
  exit 1
}

# ─── discovery ───────────────────────────────────────────────────────

heading "Discovery: what is this provider?"

step "GET /.well-known/kiosk.json"
# capabilities are [schema, query, run] — no `pay` (a reservation takes no money).
curl -sf "$SERVER_URL/.well-known/kiosk.json" \
  | jq '.kiosk | {version, endpoint, issuer, capabilities, owner}'

step "GET <endpoint>/.well-known/jwks.json — public verification keys"
curl -sf "$SERVER_URL/kiosk/.well-known/jwks.json" \
  | jq '.keys[0] | {kty, use, alg, kid}'

# ─── named queries ───────────────────────────────────────────────────

heading "Agent checks availability via a named query"

step "Open table-slots for a party of $PARTY tomorrow ($TOMORROW) — query: availability"
curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"availability\",\"date\":\"$TOMORROW\",\"party_size\":$PARTY}" \
  | jq '.rows'

# ─── run an Action ───────────────────────────────────────────────────

heading "Agent books a table via Action (no human at the provider)"

# Pick the 20:00 2-top ("a table for two, tomorrow at 8"); fall back to the
# first open slot if the headline one is gone.
SLOT_TIME=$(curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"availability\",\"date\":\"$TOMORROW\",\"party_size\":$PARTY}" \
  | jq -r '([.rows[] | select(.slot_time=="20:00")] + .rows)[0].slot_time // empty')

if [[ -z "$SLOT_TIME" ]]; then
  echo "✗ no open slot for a party of $PARTY tomorrow" >&2
  exit 1
fi

step "run book_table for $TOMORROW $SLOT_TIME, party of $PARTY"
BOOK_RESP=$(curl -sS -X POST "$SERVER_URL/kiosk/run" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"book_table\",\"date\":\"$TOMORROW\",\"time\":\"$SLOT_TIME\",\"party_size\":$PARTY}")
printf '%s\n' "$BOOK_RESP" | jq '.value'

# Assert: a success envelope carries a .value object with a booking_id. A broken
# showcase (e.g. missing users row → Booking belongs_to :user fails) returns an
# error envelope with .value == null; catch it here and fail the script.
BOOKING_ID=$(printf '%s\n' "$BOOK_RESP" | jq -r '.value.booking_id // empty')
if [[ -z "$BOOKING_ID" ]]; then
  echo "✗ book_table did not return a value.booking_id — got: $BOOK_RESP" >&2
  exit 1
fi
say "✓ book_table succeeded (booking_id=$BOOKING_ID)"

# ─── app-layer isolation ─────────────────────────────────────────────

heading "App-layer isolation: agent sees only their own bookings"

step "List bookings visible to this agent's user (should be 1) — query: my_bookings"
MY_RESP=$(curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"name":"my_bookings"}')
MY_COUNT=$(printf '%s\n' "$MY_RESP" | jq '.rows | length')
printf '%s\n' "$MY_COUNT"

# Assert: exactly the one booking just made is visible to this principal
# (fresh DB from demo:setup → 0 pre-existing bookings). A broken book_table
# (0 rows) or a cross-tenant leak (>1 row) trips this.
if [[ "$MY_COUNT" != "1" ]]; then
  echo "✗ my_bookings expected exactly 1 row, got ${MY_COUNT} — response: $MY_RESP" >&2
  exit 1
fi
MY_BOOKING_ID=$(printf '%s\n' "$MY_RESP" | jq -r '.rows[0].id // empty')
if [[ "$MY_BOOKING_ID" != "$BOOKING_ID" ]]; then
  echo "✗ my_bookings row id ($MY_BOOKING_ID) != booking id ($BOOKING_ID) — response: $MY_RESP" >&2
  exit 1
fi
say "✓ my_bookings shows exactly the 1 booking just made (app-layer per-user isolation)"

# ─── done ────────────────────────────────────────────────────────────

heading "Demo complete"
say "Server log:        /tmp/kiosk-atablefor-demo.log"
say "DB:                kiosk_atablefor_development"
say ""
say "To add realistic domain resolution:"
say "  echo \"127.0.0.1 atablefor.app\" | sudo tee -a /etc/hosts"
say "  KIOSK_ISSUER=https://atablefor.app KIOSK_DEMO_PORT=443 rake demo:walkthrough"
say ""
say "Swap StubIdp for production-shape auth:"
say "  replace lib/jwt_or_stub_idp.rb with kiosk-user-idp-devise (or your IdP)"
