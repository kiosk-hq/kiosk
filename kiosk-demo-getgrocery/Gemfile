# frozen_string_literal: true

source 'https://rubygems.org'

gem 'pg', '~> 1.1'
gem 'puma', '>= 5.0'
gem 'rails', '~> 8.1.3'

gem 'bootsnap', require: false
gem 'tzinfo-data', platforms: %i[windows jruby]

# The event stream between Puma workers, on the primary database (config/cable.yml).
gem 'solid_cable'

# The answers to the Kiosk queries and actions are app/views/kiosk/**/*.json.jbuilder.
gem 'jbuilder'

# The job queue, on the primary database: the courier's departures and the daily restock (config/recurring.yml).
gem 'solid_queue'

# The human shopper signs in with a real Devise session; the Kiosk
# account-binding surfaces (device verify page, link mint, unlink) authenticate
# that Warden session through the kiosk-user-idp-devise adapter below.
gem 'devise'

# ─── Kiosk ────────────────────────────────────────────────────────────
# kiosk-all brings kiosk-core and kiosk-server, and kiosk-pow-equihash brings
# kiosk-pow. `path '..'` reads each gem from the working tree of this
# monorepo. Outside it, keep the gem lines and remove the `path` block around them.
path '..' do
  gem 'kiosk-all'
  gem 'kiosk-kyc-proveli'
  gem 'kiosk-pay-stripe'
  gem 'kiosk-pow-equihash'
  gem 'kiosk-reputation'
  gem 'kiosk-user-idp-devise'
end

group :development, :test do
  gem 'debug', platforms: %i[mri windows], require: 'debug/prelude'
end

group :test do
  # The conformance checks this app runs against itself — that its routes
  # resolve, that a verb executes, that a query answers the shape it declared,
  # and that data access is scoped to the calling customer. `test/` connects the
  # Minitest adapter; the RSpec adapter ships in the same gem and needs no other.
  gem 'kiosk-test-support', path: '..'
end

# The attack battery, ../kiosk-redteam/suites/getgrocery.rb, runs with this bundle.
group :development do
  gem 'kiosk-redteam', path: '..', require: false
end
