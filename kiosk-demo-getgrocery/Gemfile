source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "pg", "~> 1.1"
# The per-identity bad-proof counter (lib/bad_proof_counter.rb) — a small
# sqlite store on the PoW demo path, NOT a second application database.
gem "sqlite3", "~> 2.7"
gem "puma", ">= 5.0"
gem "tzinfo-data", platforms: %i[ windows jruby ]
gem "bootsnap", require: false

# The human shopper signs in with a real Devise session; the Kiosk
# account-binding surfaces (device verify page, link mint, unlink) authenticate
# that Warden session through the kiosk-user-idp-devise adapter below.
gem "devise"

# --- Kiosk ----------------------------------------------------------------
gem "kiosk-all",        path: "../kiosk-all"
gem "kiosk-core",       path: "../kiosk-core"
gem "kiosk-rls",        path: "../kiosk-rls"
gem "kiosk-server",       path: "../kiosk-server"
gem "kiosk-pow-equihash", path: "../kiosk-pow-equihash"
gem "kiosk-reputation",   path: "../kiosk-reputation"
gem "kiosk-redteam",      path: "../kiosk-redteam"
gem "kiosk-pay-stripe",   path: "../kiosk-pay-stripe"
gem "kiosk-user-idp-devise", path: "../kiosk-user-idp-devise"

# Request-shape validation. `json_schemer` is a RUNTIME dependency of
# kiosk-server, not an opt-in extra: every 0.4 verb's `input_schema` is
# validated before the handler sees an argument, behind no flag at all
# (`c.validate_requests` is the SEPARATE opt-in PoW-shape check, and it does
# not switch that off). So bundler would install it transitively anyway; the
# line is pinned here so a vendored checkout is explicit about it.
gem "json_schemer"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
end
