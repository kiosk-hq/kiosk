<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders — GetGrocery Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f5f6f8;
      color: #1a1a2e;
      min-height: 100vh;
    }

    /* ── Header ─────────────────────────────────────────────────── */
    header {
      background: #1a6b3c;
      color: #fff;
      padding: 0 32px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 6px rgba(0,0,0,.18);
    }
    .logo {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    .logo span { color: #7fe89f; }
    nav { font-size: 13px; opacity: .85; }

    /* ── Page ────────────────────────────────────────────────────── */
    main {
      max-width: 900px;
      margin: 32px auto;
      padding: 0 24px;
    }

    .page-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .page-subtitle {
      font-size: 13px;
      color: #777;
      margin-bottom: 24px;
    }

    /* ── Order card ──────────────────────────────────────────────── */
    .order-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e2e5ea;
      margin-bottom: 16px;
      overflow: hidden;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    .order-header {
      padding: 14px 20px 12px;
      border-bottom: 1px solid #f0f2f5;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }

    .order-id {
      font-family: "SF Mono", "Fira Mono", monospace;
      font-size: 13px;
      font-weight: 600;
      color: #444;
      background: #f0f2f5;
      padding: 3px 8px;
      border-radius: 5px;
    }

    /* ── Status badges ───────────────────────────────────────────── */
    .badge {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.6px;
      padding: 3px 9px;
      border-radius: 20px;
      text-transform: uppercase;
    }
    .badge-paid {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #6ee7b7;
    }
    .badge-pending {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fcd34d;
    }

    /* ── Delivery info ───────────────────────────────────────────── */
    .delivery-info {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      margin-left: auto;
      font-size: 13.5px;
      color: #555;
    }
    .delivery-info .label {
      font-weight: 600;
      color: #333;
    }

    /* ── Line items ──────────────────────────────────────────────── */
    .order-items {
      padding: 10px 20px 14px;
    }

    .item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 10px;
      border-radius: 6px;
      margin-bottom: 4px;
      font-size: 14px;
      background: #fafafa;
      border: 1px solid #ececec;
    }
    .item:last-child { margin-bottom: 0; }

    .item.substituted {
      background: #fffbeb;
      border-color: #fde68a;
    }

    .item .qty {
      font-weight: 600;
      color: #1a6b3c;
      min-width: 24px;
      font-size: 13px;
    }
    .item .name {
      flex: 1;
      font-weight: 500;
    }
    .sub-tag {
      font-size: 11px;
      font-weight: 600;
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fcd34d;
      padding: 1px 7px;
      border-radius: 12px;
      white-space: nowrap;
    }
    .item .price {
      font-size: 13px;
      color: #888;
      min-width: 60px;
      text-align: right;
    }

    /* ── Empty state ─────────────────────────────────────────────── */
    .empty {
      text-align: center;
      color: #aaa;
      font-size: 15px;
      padding: 60px 0;
    }

    /* ── Footer ──────────────────────────────────────────────────── */
    footer {
      text-align: center;
      font-size: 11px;
      color: #bbb;
      padding: 32px 0 24px;
    }
  </style>
</head>
<body>

<header>
  <div class="logo">Get<span>Grocery</span></div>
  <nav>Store Admin &rsaquo; Orders</nav>
</header>

<main>
  <div class="page-title">Recent Orders</div>
  <div class="page-subtitle">
    <% count = @orders.length %>
    <%= count %> order<%= count == 1 ? "" : "s" %> &mdash; most recent first
  </div>

  <% if @orders.empty? %>
    <p class="empty">No orders yet — run <code>demo:shop</code> to create one.</p>
  <% else %>
    <% @orders.each do |order| %>
      <%
        paid      = order["paid"] == "t" || order["paid"] == true
        slot_raw  = order["slot_at"].to_s
        slot_time = begin
          t = Time.parse(slot_raw)
          t_end = t + 7200  # 2-hour delivery window
          "#{t.strftime("%a %-d %b, %H:%M")} – #{t_end.strftime("%H:%M")}"
        rescue
          slot_raw
        end
        created   = begin
          Time.parse(order["created_at"].to_s).strftime("%-d %b %Y at %H:%M")
        rescue
          order["created_at"].to_s
        end
        items     = order["items"] || []
      %>
      <div class="order-card">
        <div class="order-header">
          <span class="order-id">#<%= order["short_id"] %></span>
          <span class="badge <%= paid ? "badge-paid" : "badge-pending" %>">
            <%= paid ? "PAID" : "PENDING" %>
          </span>
          <div class="delivery-info">
            <span><span class="label">Address:</span> <%= h order["address"] %></span>
            <span><span class="label">Slot:</span> <%= slot_time %></span>
            <span style="color:#bbb">Ordered <%= created %></span>
          </div>
        </div>

        <div class="order-items">
          <% if items.empty? %>
            <span style="color:#bbb;font-size:13px">No items on cart</span>
          <% else %>
            <% items.each do |item| %>
              <% subst = item["substituted"] == "t" || item["substituted"] == true %>
              <div class="item<%= subst ? " substituted" : "" %>">
                <span class="qty">&times;<%= item["qty"] %></span>
                <span class="name"><%= h item["product_name"] %></span>
                <% if subst %>
                  <span class="sub-tag">&#8644; substituted</span>
                <% end %>
                <span class="price">&euro;<%= format("%.2f", item["price_cents"].to_i / 100.0) %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</main>

<footer>
  GetGrocery Admin &mdash; Demo Provider &mdash; Powered by Kiosk
</footer>

</body>
</html>
