<% content_for :title, "Orders" %>

<div class="page-title">Recent Orders</div>
<div class="page-subtitle">
  <%= pluralize(@orders.length, "order") %> &mdash; most recent first<br>
  Demo operator back-office &mdash; public by design; addresses masked; data resets periodically.
</div>

<% if @orders.empty? %>
  <p class="empty">No orders yet — ask an assistant to order something.</p>
<% else %>
  <%= render @orders %>
<% end %>
