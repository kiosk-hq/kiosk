<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Orders — GetGrocery Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #f5f6f8;
      color: #1a1a2e;
      min-height: 100vh;
    }

    header {
      background: #1a6b3c;
      color: #fff;
      padding: 0 32px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 6px rgba(0,0,0,.18);
    }
    .logo {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    .logo span { color: #7fe89f; }
    nav { font-size: 13px; opacity: .85; }

    main {
      max-width: 900px;
      margin: 32px auto;
      padding: 0 24px;
    }

    .page-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .page-subtitle {
      font-size: 13px;
      color: #777;
      margin-bottom: 24px;
    }

    .order-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e2e5ea;
      margin-bottom: 16px;
      overflow: hidden;
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

    .order-header {
      padding: 14px 20px 12px;
      border-bottom: 1px solid #f0f2f5;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }

    .order-id {
      font-family: "SF Mono", "Fira Mono", monospace;
      font-size: 13px;
      font-weight: 600;
      color: #444;
      background: #f0f2f5;
      padding: 3px 8px;
      border-radius: 5px;
    }

    .badge {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.6px;
      padding: 3px 9px;
      border-radius: 20px;
      text-transform: uppercase;
    }
    .badge-scheduled {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #6ee7b7;
    }
    .badge-paid {
      background: #dbeafe;
      color: #1e40af;
      border: 1px solid #93c5fd;
    }
    .badge-created {
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #cbd5e1;
    }

    .order-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      margin-left: auto;
      font-size: 13.5px;
      color: #555;
    }
    .order-meta .label {
      font-weight: 600;
      color: #333;
    }

    .order-items {
      padding: 10px 20px 14px;
    }

    .item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 10px;
      border-radius: 6px;
      margin-bottom: 4px;
      font-size: 14px;
      background: #fafafa;
      border: 1px solid #ececec;
    }
    .item:last-child { margin-bottom: 0; }

    .item .qty {
      font-weight: 600;
      color: #1a6b3c;
      min-width: 24px;
      font-size: 13px;
    }
    .item .name {
      flex: 1;
      font-weight: 500;
    }
    .item .price {
      font-size: 13px;
      color: #888;
      min-width: 60px;
      text-align: right;
    }

    .empty {
      text-align: center;
      color: #aaa;
      font-size: 15px;
      padding: 60px 0;
    }

    footer {
      text-align: center;
      font-size: 11px;
      color: #bbb;
      padding: 32px 0 24px;
    }
  </style>
</head>
<body>

<header>
  <div class="logo">Get<span>Groceries</span></div>
  <nav>Provider Admin &rsaquo; Orders</nav>
</header>

<main>
  <div class="page-title">Recent Orders</div>
  <div class="page-subtitle">
    <% count = @orders.length %>
    <%= count %> order<%= count == 1 ? "" : "s" %> &mdash; most recent first<br>
    Demo operator back-office &mdash; public by design; addresses masked; data resets periodically.
  </div>

  <% if @orders.empty? %>
    <p class="empty">No orders yet — run <code>demo:shop</code> to create one.</p>
  <% else %>
    <% @orders.each do |order| %>
      <%
        paid       = order["paid"] == "t" || order["paid"] == true
        status     = order["status"].to_s
        scheduled  = status == "scheduled"
        slot_raw   = order["slot_at"].to_s
        slot_time  = begin
          t = Time.parse(slot_raw)
          t_end = t + 7200
          "#{t.strftime("%a %-d %b, %H:%M")} – #{t_end.strftime("%H:%M")}"
        rescue
          slot_raw.empty? ? "—" : slot_raw
        end
        created    = begin
          Time.parse(order["created_at"].to_s).strftime("%-d %b %Y at %H:%M")
        rescue
          order["created_at"].to_s
        end
        cur_glyph  = { "usd" => "$", "eur" => "€" }.fetch(order["settled_currency"].to_s.downcase, "€")
        total_str  = format("%s%.2f", cur_glyph, order["total_cents"].to_i / 100.0)
        items      = order["items"] || []

        badge_class = if scheduled
          "badge-scheduled"
        elsif paid
          "badge-paid"
        else
          "badge-created"
        end
        badge_label = scheduled ? "SCHEDULED" : (paid ? "PAID" : "CREATED")
      %>
      <div class="order-card">
        <div class="order-header">
          <span class="order-id">#<%= order["short_id"] %></span>
          <span class="badge <%= badge_class %>"><%= badge_label %></span>
          <div class="order-meta">
            <span><span class="label">Total:</span> <%= total_str %></span>
            <% if order["address"] && !order["address"].empty? %>
              <span><span class="label">Address:</span> <%= h order["address"] %></span>
            <% end %>
            <% if scheduled && !slot_raw.empty? %>
              <span><span class="label">Slot:</span> <%= slot_time %></span>
            <% end %>
            <span style="color:#bbb">Ordered <%= created %></span>
          </div>
        </div>

        <div class="order-items">
          <% if items.empty? %>
            <span style="color:#bbb;font-size:13px">No items</span>
          <% else %>
            <% items.each do |item| %>
              <div class="item">
                <span class="qty">&times;<%= item["qty"] %></span>
                <span class="name"><%= h item["product_name"] %></span>
                <span class="price"><%= cur_glyph %><%= format("%.2f", item["price_cents"].to_i / 100.0) %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</main>

<footer>
  GetGrocery Admin &mdash; Demo Provider &mdash; Powered by Kiosk
</footer>

</body>
</html>
