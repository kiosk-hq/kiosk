<% content_for :title, "GetGrocery — fresh groceries, delivered in Dublin (Kiosk demo)" %>

  <div class="agentbar">
    <span class="tag">🤖 For agents</span>
    <span>Agents &amp; AI assistants — <a href="/.well-known/kiosk.json">learn here</a> how to work with this site.</span>
    <a class="what" href="https://kiosk.tech">(what is this?)</a>
  </div>
  <header>
    <div class="logo">Get<span>Grocery</span></div>
    <nav class="tagline">Dublin · same-day delivery</nav>
  </header>

  <div class="wrap">

    <!-- ── 1. Try it with your own assistant ─────────────────────────── -->
    <section class="sec" id="try">
      <div class="sec-k">🤖 Try it with your own assistant</div>
      <div class="tryit">
        <h2>Order groceries — no account, no app</h2>
        <p>Tell your AI assistant:</p>
        <p class="say">“Order milk, eggs and cheese from getgrocery.demo.kiosk.tech and check out.”</p>
        <p>It discovers this store, registers itself, shops, schedules a delivery slot, and pays. When it hands you the Stripe checkout link, pay with the test card:</p>
        <p class="card"><strong>4242&nbsp;4242&nbsp;4242&nbsp;4242</strong> &nbsp;·&nbsp; any future expiry &nbsp;·&nbsp; any CVC &nbsp;·&nbsp; any ZIP</p>
        <p class="note">Payment runs on <strong>real Stripe</strong> in <strong>test mode</strong>: no real money moves. The shop asks a proof-of-work toll: one memory-hard puzzle to register, and one on every 10th call, each 9 to 20&nbsp;s on one Apple M3 laptop core.</p>
      </div>
    </section>

    <!-- ── 2. About this demo ────────────────────────────────────────── -->
    <section class="sec">
      <div class="sec-k">About this demo</div>
      <div class="about">
        <p><strong>getgrocery</strong> is a demo grocery shop. An assistant does the whole order through Kiosk: find the shop → register → shop → book a delivery → pay. It is the demo to read for payments: the customer saves a card with Stripe once, and the shop charges it later. The assistant never sees a card number.</p>
        <div class="chips">
          <span class="chip">💳 Real Stripe payments</span>
          <span class="chip">Card saved once, charged later</span>
          <span class="chip">Catalog + delivery slots</span>
          <span class="chip">Link an assistant to your account</span>
        </div>
        <div class="links">
          <a href="https://github.com/kiosk-hq/kiosk/tree/main/kiosk-demo-getgrocery">▶ Source on GitHub</a>
          <a href="https://kiosk.tech">What is Kiosk? →</a>
        </div>
      </div>
    </section>

    <!-- ── The shop's back-office link ── -->
    <section class="sec">
      <p class="disco">🧾 The shop's view: <a href="/admin/orders">the live back-office order list</a> &mdash; public on purpose, addresses masked.</p>
    </section>

    <!-- ── 3. Live activity (compact) ────────────────────────────────── -->
    <section class="sec">
      <div class="sec-k">Live activity</div>
      <div class="stats">
        <div class="stat"><div class="n"><%= @products_in_catalog %></div><div class="l">Products in catalog</div></div>
        <div class="stat"><div class="n"><%= @orders_placed %></div><div class="l">Orders placed</div></div>
        <div class="stat"><div class="n"><%= @items_ordered %></div><div class="l">Items ordered</div></div>
        <div class="stat"><div class="n"><%= @deliveries_scheduled %></div><div class="l">Deliveries scheduled</div></div>
      </div>
    </section>

  </div>

  <!-- ── 4. The storefront — what a human visitor sees (separated) ────── -->
  <div class="wrap">
    <div class="store">
      <div class="store-label">The storefront — what a human visitor sees</div>
      <div class="store-body">
        <div class="hero">
          <h1>Fresh groceries, at your door in Dublin.</h1>
          <p>Everyday groceries. Pick a delivery slot. Done.</p>
          <a class="cta" href="#try">Start shopping</a>
        </div>
        <div class="cats">
          <div class="cat"><span class="emoji">🥛</span>Dairy &amp; Eggs</div>
          <div class="cat"><span class="emoji">🍞</span>Bakery</div>
          <div class="cat"><span class="emoji">🥦</span>Produce</div>
          <div class="cat"><span class="emoji">🧴</span>Pantry</div>
          <div class="cat"><span class="emoji">🥤</span>Drinks</div>
        </div>
      </div>
    </div>
  </div>
