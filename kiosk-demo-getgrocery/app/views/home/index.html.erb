<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GetGroceries — fresh groceries, delivered in Neo-Tokyo</title>
  <!-- Machine-readable affordance: assistants discover the Kiosk surface here. -->
  <link rel="kiosk" href="https://kiosk.tech/skill.md">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:#13241a;background:#f6faf6}
    header{background:#1a6b3c;color:#fff;padding:0 32px;height:60px;display:flex;align-items:center;justify-content:space-between}
    .logo{font-size:22px;font-weight:800;letter-spacing:-.5px}
    .logo span{color:#9bf0b8}
    .hero{max-width:880px;margin:48px auto 0;padding:0 24px;text-align:center}
    .hero h1{font-size:34px;line-height:1.15;font-weight:800;margin-bottom:12px}
    .hero p{font-size:17px;color:#4a5c50;margin-bottom:28px}
    .cta{display:inline-block;background:#1a6b3c;color:#fff;text-decoration:none;font-weight:700;padding:13px 26px;border-radius:10px}
    .cats{max-width:880px;margin:40px auto;padding:0 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px}
    .cat{background:#fff;border:1px solid #e2ece4;border-radius:12px;padding:22px 14px;text-align:center;font-weight:600;font-size:15px}
    .cat .emoji{font-size:30px;display:block;margin-bottom:8px}

    /* ── Live activity stat cards ─────────────────────────────────────── */
    .stats-wrap{max-width:880px;margin:8px auto 8px;padding:0 24px}
    .stats-h{margin:0 0 14px;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#7a8f80;text-align:center}
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px}
    .stat{background:#fff;border:1px solid #e2ece4;border-radius:14px;padding:22px 16px;text-align:center}
    .stat .n{font-size:30px;font-weight:800;color:#1a6b3c;line-height:1}
    .stat .l{margin-top:8px;font-size:13px;color:#5c6d62;font-weight:600}

    /* ── The agent hook ───────────────────────────────────────────────── */
    .agents{max-width:880px;margin:8px auto 56px;padding:0 24px}
    .agents-card{background:linear-gradient(135deg,#0f2a1c,#1a6b3c);color:#fff;border-radius:16px;padding:26px 28px;display:flex;flex-wrap:wrap;align-items:center;gap:18px}
    .agents-card .bot{font-size:40px;line-height:1}
    .agents-card .copy{flex:1;min-width:240px}
    .agents-card h2{font-size:19px;font-weight:800;margin-bottom:4px}
    .agents-card p{font-size:14px;color:#cfeBDA;opacity:.92}
    .agents-card .links{display:flex;gap:10px;flex-wrap:wrap}
    .agents-card a{background:rgba(255,255,255,.14);color:#fff;text-decoration:none;font-weight:700;font-size:13px;padding:9px 14px;border-radius:9px;border:1px solid rgba(255,255,255,.22)}
    .agents-card a:hover{background:rgba(255,255,255,.24)}
    .agents-card code{font-family:"SF Mono","Fira Mono",monospace;font-size:12px}
    footer{text-align:center;font-size:12px;color:#9bb0a2;padding:28px 0 36px}
  </style>
</head>
<body>
  <header>
    <div class="logo">Get<span>Groceries</span></div>
    <nav style="font-size:13px;opacity:.9">Neo-Tokyo · same-day delivery</nav>
  </header>

  <section class="hero">
    <h1>Fresh groceries, at your door in Neo-Tokyo.</h1>
    <p>Hundreds of everyday items. Pick a delivery slot. Done.</p>
    <a class="cta" href="#">Start shopping</a>
  </section>

  <section class="cats">
    <div class="cat"><span class="emoji">🥛</span>Dairy &amp; Eggs</div>
    <div class="cat"><span class="emoji">🍞</span>Bakery</div>
    <div class="cat"><span class="emoji">🥦</span>Produce</div>
    <div class="cat"><span class="emoji">🧴</span>Pantry</div>
    <div class="cat"><span class="emoji">🥤</span>Drinks</div>
  </section>

  <!-- ── Live activity (real domain counts) ──────────────────────────── -->
  <section class="stats-wrap">
    <h3 class="stats-h">Live activity</h3>
    <div class="stats">
      <div class="stat">
        <div class="n"><%= @products_in_catalog %></div>
        <div class="l">Products in catalog</div>
      </div>
      <div class="stat">
        <div class="n"><%= @orders_placed %></div>
        <div class="l">Orders placed</div>
      </div>
      <div class="stat">
        <div class="n"><%= @items_ordered %></div>
        <div class="l">Items ordered</div>
      </div>
      <div class="stat">
        <div class="n"><%= @deliveries_scheduled %></div>
        <div class="l">Deliveries scheduled</div>
      </div>
    </div>
  </section>

  <!-- ── Agents → Kiosk here ─────────────────────────────────────────── -->
  <section class="agents">
    <div class="agents-card">
      <div class="bot">🤖</div>
      <div class="copy">
        <h2>AI assistants — over here. This store speaks Kiosk.</h2>
        <p>Your assistant can order and pay directly, no human account and no checkout hand-off. Start at <code>/.well-known/kiosk.json</code>, then read <code>/kiosk/schema</code> — the surface self-describes from there.</p>
      </div>
      <div class="links">
        <a href="/.well-known/kiosk.json">/.well-known/kiosk.json</a>
        <a href="/kiosk/schema">/kiosk/schema</a>
      </div>
    </div>
  </section>

  <footer>GetGroceries — demo provider — powered by Kiosk</footer>
</body>
</html>
