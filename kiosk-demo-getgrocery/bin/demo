#!/usr/bin/env bash
# Kiosk getgrocery demo walkthrough — a curl-driven tour of the wire surface.
#
# Run via `rake demo` (handles DB setup + invokes this script), or
# directly when the demo DB is already prepared.

set -euo pipefail

PORT="${KIOSK_DEMO_PORT:-3005}"
SERVER_URL="http://127.0.0.1:$PORT"

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
step()    { printf "\n  \033[1;33m▶\033[0m %s\n" "$1"; }
say()     { printf "  %s\n" "$1"; }

cleanup() {
  if [[ -n "${SERVER_PID:-}" ]]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

require_tool() {
  command -v "$1" >/dev/null 2>&1 \
    || { echo "missing: $1 — install it then re-run" >&2; exit 1; }
}
require_tool curl
require_tool jq
require_tool openssl

# ─── boot ────────────────────────────────────────────────────────────

heading "Starting getgrocery (the demo provider) on port $PORT"
KIOSK_ISSUER="$SERVER_URL" \
  bundle exec rails s -p "$PORT" -b 127.0.0.1 -e development \
  >/tmp/kiosk-getgrocery-demo.log 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 30); do
  if curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null 2>&1; then
    say "✓ Server up at $SERVER_URL"
    break
  fi
  sleep 1
done

curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null || {
  echo "server did not become ready — see /tmp/kiosk-getgrocery-demo.log" >&2
  exit 1
}

# ─── discovery ───────────────────────────────────────────────────────

heading "Discovery: what is this provider?"

step "GET /.well-known/kiosk.json"
curl -sf "$SERVER_URL/.well-known/kiosk.json" \
  | jq '.kiosk | {version, endpoint, issuer, capabilities, owner}'

step "GET <endpoint>/.well-known/jwks.json — public verification keys"
curl -sf "$SERVER_URL/kiosk/.well-known/jwks.json" \
  | jq '.keys[0] | {kty, use, alg, kid}'

# ─── register ────────────────────────────────────────────────────────

heading "Register: agent gets an access token"

step "Generate a throwaway RSA key pair"
openssl genrsa -out /tmp/demo-agent.pem 2048 2>/dev/null
PUBKEY_PEM=$(openssl rsa -in /tmp/demo-agent.pem -pubout 2>/dev/null)
PUBKEY_JSON=$(printf '%s' "$PUBKEY_PEM" | jq -Rs .)

# JWS uses URL-safe base64 with no padding.
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

step "GET /kiosk/auth/challenge — a public key is not a credential; prove you hold the private key"
CHALLENGE=$(curl -sSG "$SERVER_URL/kiosk/auth/challenge" --data-urlencode "public_key=$PUBKEY_PEM" | jq -r '.challenge')

step "Sign the challenge (aud = this origin, so the proof can't be relayed)"
JWS_HEADER=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
JWS_PAYLOAD=$(printf '{"aud":"%s","nonce":"%s","jti":"%s","iat":%s}' \
  "${KIOSK_ISSUER:-$SERVER_URL}" "$CHALLENGE" "$(uuidgen)" "$(date +%s)" | b64url)
JWS_SIG=$(printf '%s.%s' "$JWS_HEADER" "$JWS_PAYLOAD" \
  | openssl dgst -sha256 -sign /tmp/demo-agent.pem -binary | b64url)
SIGNED="$JWS_HEADER.$JWS_PAYLOAD.$JWS_SIG"

step "POST /kiosk/auth/register"
REG=$(curl -sS -X POST "$SERVER_URL/kiosk/auth/register" \
  -H "Content-Type: application/json" \
  -d "{\"public_key\":$PUBKEY_JSON,\"signed\":\"$SIGNED\"}")
echo "$REG" | jq '{agent_id, user_id}'
AGENT_TOKEN=$(echo "$REG" | jq -r '.access_token')

# ─── named queries ───────────────────────────────────────────────────

heading "Agent browses the store via named queries"

step "List grocery stores — query: stores"
STORES=$(curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"name":"stores"}')
echo "$STORES" | jq '.rows'
STORE_ID=$(echo "$STORES" | jq -r '.rows[0].id')

step "List products at store $STORE_ID — query: products_by_store"
PRODUCTS=$(curl -sS -X POST "$SERVER_URL/kiosk/query" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"products_by_store\",\"store_id\":$STORE_ID}")
echo "$PRODUCTS" | jq '.rows'
PRODUCT_ID=$(echo "$PRODUCTS" | jq -r '.rows[0].id')

# ─── run an Action ───────────────────────────────────────────────────

heading "Agent adds a product to cart via Action"

step "run add_to_cart for store $STORE_ID, product $PRODUCT_ID"
curl -sS -X POST "$SERVER_URL/kiosk/run" \
  -H "Authorization: Bearer $AGENT_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"add_to_cart\",\"store_id\":$STORE_ID,\"product_id\":$PRODUCT_ID,\"qty\":1}" \
  | jq '.value'

# ─── done ────────────────────────────────────────────────────────────

heading "Demo complete"
say "Server log:        /tmp/kiosk-getgrocery-demo.log"
say "DB:                kiosk_getgrocery_development"
say ""
say "To add realistic domain resolution:"
say "  echo \"127.0.0.1 getgrocery.app\" | sudo tee -a /etc/hosts"
say "  KIOSK_ISSUER=https://getgrocery.app KIOSK_DEMO_PORT=443 rake demo"
say ""
say "Full flow (cart + substitution + delivery) is covered by:"
say "  SERVER_URL=http://127.0.0.1:3005 KIOSK_ISSUER=http://127.0.0.1:3005 bundle exec ruby getgrocery_flow.rb"
