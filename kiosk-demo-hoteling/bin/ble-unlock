#!/usr/bin/env python3
"""
bin/ble-unlock — write a rental token to the ESP32-C3 BLE lock from a Mac/laptop.

Purpose: no-Apple physical-unlock path for the demo.  Lets you verify the lock
         clicks WITHOUT an iPhone or App Clip.  The token is written directly to
         the ESP32-C3's unlock characteristic over BLE from this script.

Prerequisites:
    pip3 install bleak

On macOS the script uses CoreBluetooth via bleak.  The first run will trigger
a system Bluetooth permission prompt — grant it.

HONESTY NOTE:
    The BLE write below is constructed correctly against the firmware's wire
    contract (characteristic 4e2a1002-…, UTF-8 token bytes, write-with-response),
    but this script is UNVERIFIED until run against a real flashed ESP32-C3.
    No board is available in the development environment — exercise against
    hardware before relying on it.

Usage:
    bin/ble-unlock --scooter SK-001 --token "<wire token>"
    bin/ble-unlock --scooter SK-001 --from-server   # requires SERVER_URL env

BLE contract (from skooti_lock.ino):
    Device name:          skooti-<SCOOTER_CODE>  (e.g. skooti-SK-001)
    Service UUID:         4e2a1000-5b3c-4b1e-9f8c-6d7e8a9b0c1d
    Unlock char UUID:     4e2a1002-5b3c-4b1e-9f8c-6d7e8a9b0c1d
    Write: raw wire-token (UTF-8, ~200 bytes), write-with-response
"""

import argparse
import asyncio
import json
import os
import subprocess
import sys
from pathlib import Path

UNLOCK_UUID = "4e2a1002-5b3c-4b1e-9f8c-6d7e8a9b0c1d"
SCAN_TIMEOUT = 15.0  # seconds to wait for the peripheral


def parse_args():
    p = argparse.ArgumentParser(
        description="Write a skooti rental token to the ESP32-C3 BLE lock.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    p.add_argument("--scooter", default="SK-001", metavar="CODE",
                   help="Scooter code (default: SK-001)")

    source = p.add_mutually_exclusive_group(required=True)
    source.add_argument("--token", metavar="TOKEN",
                        help="Wire rental token (explicit)")
    source.add_argument("--from-server", action="store_true",
                        help="Run rental_flow.rb to obtain a fresh token (SERVER_URL must be set)")

    p.add_argument("--timeout", type=float, default=SCAN_TIMEOUT, metavar="SECS",
                   help=f"BLE scan timeout in seconds (default: {SCAN_TIMEOUT})")
    return p.parse_args()


def obtain_token_from_server(scooter_code: str) -> str:
    """Run rental_flow.rb, parse its JSON stdout, return the rental_token."""
    demo_root = Path(__file__).parent.parent
    flow_rb   = demo_root / "rental_flow.rb"

    if not flow_rb.exists():
        sys.exit(f"Error: rental_flow.rb not found at {flow_rb}")

    server_url   = os.environ.get("SERVER_URL")
    kiosk_issuer = os.environ.get("KIOSK_ISSUER")

    if not server_url:
        sys.exit("Error: SERVER_URL env var is required for --from-server.")

    env = dict(os.environ)
    env["SERVER_URL"]   = server_url
    if kiosk_issuer:
        env["KIOSK_ISSUER"] = kiosk_issuer

    print("  Running rental_flow.rb ...", flush=True)
    result = subprocess.run(
        ["bundle", "exec", "ruby", str(flow_rb)],
        cwd=str(demo_root),
        capture_output=False,
        stdout=subprocess.PIPE,
        text=True,
        env=env,
    )
    if result.returncode != 0:
        sys.exit(f"rental_flow.rb exited with status {result.returncode}.")

    json_line = result.stdout.strip()
    if not json_line:
        sys.exit("rental_flow.rb produced no output.")

    data = json.loads(json_line)
    token = data.get("rental_token")
    if token is None:
        sys.exit("rental_flow.rb returned null rental_token (start_rental may have returned 403).")

    reservation_id = data.get("reservation_id", "?")
    print(f"  Got token for reservation {reservation_id}.", flush=True)
    return token


async def ble_unlock(device_name: str, token: str, scan_timeout: float):
    """Scan for the peripheral, connect, write token to unlock characteristic."""
    from bleak import BleakScanner, BleakClient

    print(f"Scanning for BLE device '{device_name}' (timeout: {scan_timeout}s)...", flush=True)

    # Scan until we find a device whose local name matches exactly.
    target = None

    def match_by_name(device, adv):
        local_name = adv.local_name or device.name or ""
        return local_name == device_name

    target = await BleakScanner.find_device_by_filter(
        match_by_name,
        timeout=scan_timeout,
    )

    if target is None:
        sys.exit(
            f"\nDevice '{device_name}' not found within {scan_timeout}s.\n"
            "Check that the ESP32-C3 is powered, flashed, and advertising.\n"
            "The firmware sets the BLE name to 'skooti-<SCOOTER_CODE>'.\n"
        )

    print(f"Found: {target.name} ({target.address})", flush=True)
    print("Connecting...", flush=True)

    token_bytes = token.encode("utf-8")
    byte_count  = len(token_bytes)

    async with BleakClient(target) as client:
        if not client.is_connected:
            sys.exit("Failed to connect to the device.")

        print(f"Connected. Writing {byte_count} bytes to unlock characteristic...", flush=True)

        await client.write_gatt_char(
            UNLOCK_UUID,
            token_bytes,
            response=True,  # WRITE (with response), as the firmware expects
        )

    print(f"Done. Wrote {byte_count} bytes — check the lock for GPIO HIGH / LED flash (3 s).", flush=True)


def main():
    args = parse_args()

    if args.from_server:
        rental_token = obtain_token_from_server(args.scooter)
    else:
        rental_token = args.token

    device_name = f"skooti-{args.scooter}"

    # Validate bleak is importable before attempting BLE.
    try:
        import bleak  # noqa: F401
    except ImportError:
        sys.exit(
            "Error: 'bleak' is not installed.\n"
            "Install it with:  pip3 install bleak\n"
            "(On macOS this uses CoreBluetooth — grant Bluetooth permission when prompted.)"
        )

    asyncio.run(ble_unlock(device_name, rental_token, args.timeout))


if __name__ == "__main__":
    main()
