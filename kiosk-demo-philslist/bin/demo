#!/usr/bin/env bash
# philslist demo walkthrough — a curl-driven tour of the wire surface.
#
# The happy path is the VISIBLE CONTRAST with every commerce demo:
#   browse → post → edit → close, with NO payment step.
#
# Run via `rake demo` (handles DB setup + invokes this script), or directly
# when the demo DB is already prepared. Exits non-zero on any failed assertion
# so CI catches regressions.

set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${KIOSK_DEMO_PORT:-3006}"
SERVER_URL="http://127.0.0.1:$PORT"

# The seeded human this walkthrough acts for (db/seeds.rb). Her ASSISTANT's
# token is minted below, after the server is up, by running the real binding
# ceremony — see the "Binding" heading. Until T-104 this script wrote the
# bearer down as `agent:u-<uuid>:a-<slug>:r-customer` and a dev-only parser in
# the demo believed it; that parser is deleted, so the walkthrough now shows
# the same thing a real assistant does to get a token.
ALICE_EMAIL="${ALICE_EMAIL:-alice@example.com}"
DEMO_PASSWORD="${DEMO_PASSWORD:-philslist-demo-password}"

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
step()    { printf "\n  \033[1;33m▶\033[0m %s\n" "$1"; }
say()     { printf "  %s\n" "$1"; }
fail()    { printf "\n  \033[1;31m✗ %s\033[0m\n" "$1" >&2; exit 1; }

cleanup() {
  if [[ -n "${SERVER_PID:-}" ]]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

require_tool() {
  command -v "$1" >/dev/null 2>&1 \
    || { echo "missing: $1 — install it then re-run" >&2; exit 1; }
}
require_tool curl
require_tool jq

# The 0.4 wire: one endpoint per verb. A query is a GET whose arguments are the
# query string; an action is a POST whose arguments are the JSON body. A success
# body IS the result — no envelope to unwrap, so no `.rows`/`.value` below.
#   q  <token> <query-name> [query-string]
#   run <token> <action-name> <json-body>
q()   { curl -sS "$SERVER_URL/kiosk/$2${3:+?$3}" -H "Authorization: Bearer $1"; }
run() { curl -sS -X POST "$SERVER_URL/kiosk/$2" -H "Authorization: Bearer $1" \
          -H "Content-Type: application/json" -d "$3"; }

# Bind one assistant to one seeded human and print its access token.
#
# There is no shortcut left to take: script/bound_assistant.rb runs the shipped
# ceremony over real HTTP — the Equihash-tolled /kiosk/auth/register, the
# human's own /users/sign_in form, /kiosk/auth/link, /kiosk/auth/claim — and
# the token that comes back is one this provider minted for a key it saw.
# ~a second per assistant, most of it the Equihash toll and the RSA keygen.
#   bind <email>
bind() {
  SERVER_URL="$SERVER_URL" KIOSK_ISSUER="$SERVER_URL" \
  HOLDER_EMAIL="$1" HOLDER_PASSWORD="$DEMO_PASSWORD" \
    bundle exec ruby -r"$APP_ROOT/script/bound_assistant" -e '
      puts bind_assistant(server:   ENV.fetch("SERVER_URL"),
                          issuer:   ENV.fetch("KIOSK_ISSUER"),
                          email:    ENV.fetch("HOLDER_EMAIL"),
                          password: ENV.fetch("HOLDER_PASSWORD")).token
    '
}

# ─── boot ────────────────────────────────────────────────────────────

heading "Starting philslist (the demo provider) on port $PORT"
KIOSK_ISSUER="$SERVER_URL" \
  bundle exec rails s -p "$PORT" -b 127.0.0.1 -e development \
  >/tmp/kiosk-philslist-demo.log 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 30); do
  if curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null 2>&1; then
    say "✓ Server up at $SERVER_URL"
    break
  fi
  sleep 1
done
curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null \
  || fail "server did not become ready — see /tmp/kiosk-philslist-demo.log"

# ─── binding: the assistants EARN their tokens ────────────────────────

heading "Binding: each assistant earns a token through the real ceremony"

step "Alice's assistant: register (Equihash toll) → Alice signs in → link → claim"
ALICE_TOKEN="$(bind "$ALICE_EMAIL")"
[[ -n "$ALICE_TOKEN" ]] || fail "could not bind an assistant for $ALICE_EMAIL"
say "✓ Alice's assistant holds a kiosk-pop JWT this provider minted"

# Bob is NOT bound here, on purpose. This walkthrough is a single account's tour
# — browse → post → edit → close — and the cross-owner board it browses comes
# from the seeds, not from a second live principal. (A `BOB_TOKEN` used to be
# declared at the top of this file and never read; a written-down string costs
# nothing, a ceremony costs a real Equihash toll, so the dead one is gone rather
# than promoted.) Bob's side of the boundary is asserted where it belongs:
# `rake demo:isolation` and `rake demo:redteam`, which bind him for real.

# ─── discovery: prove there is NO payment ─────────────────────────────

heading "Discovery: what is this provider? (note: no payments)"

step "GET /.well-known/kiosk.json — capabilities"
CAPS=$(curl -sf "$SERVER_URL/.well-known/kiosk.json" | jq -c '.kiosk.capabilities')
say "capabilities = $CAPS"
echo "$CAPS" | jq -e 'index("pay") == null' >/dev/null \
  || fail "capabilities advertise 'pay' — philslist must take no payments"
say "✓ 'pay' is ABSENT from capabilities — not-only-commerce, demonstrably"

# ─── browse the open board (cross-owner, no account needed) ───────────

heading "Alice's agent browses the open board (browse_listings)"

step "browse_listings — all sellers, open board"
q "$ALICE_TOKEN" browse_listings | jq 'map({title, price_text, category_slug, owner_handle})'
COUNT=$(q "$ALICE_TOKEN" browse_listings | jq 'length')
[[ "$COUNT" -ge 2 ]] || fail "expected the seeded cross-owner board (>=2 listings), got $COUNT"
say "✓ browse sees $COUNT listings across owners"

# ─── post → edit → close (NO payment step) ────────────────────────────

heading "Alice's agent posts a listing (post_listing) — no card, no checkout"

step "run post_listing (desk for sale)"
POST=$(run "$ALICE_TOKEN" post_listing '{"category_slug":"furniture","title":"Oak desk","body":"Solid oak, moving sale","price_text":"€150"}')
echo "$POST" | jq '.'
LISTING_ID=$(echo "$POST" | jq -r '.listing_id')
[[ "$LISTING_ID" != "null" && -n "$LISTING_ID" ]] || fail "post_listing did not return a listing_id"
say "✓ posted listing $LISTING_ID"

step "run edit_listing (drop the price)"
run "$ALICE_TOKEN" edit_listing "{\"listing_id\":\"$LISTING_ID\",\"price_text\":\"€120\"}" | jq '.'

step "run close_listing (it sold)"
CLOSE=$(run "$ALICE_TOKEN" close_listing "{\"listing_id\":\"$LISTING_ID\"}")
echo "$CLOSE" | jq '.'
[[ "$(echo "$CLOSE" | jq -r '.status')" == "closed" ]] || fail "close_listing did not close the listing"
say "✓ closed listing $LISTING_ID"

step "my_listings reflects the final state (the desk is now closed)"
MINE=$(q "$ALICE_TOKEN" my_listings)
echo "$MINE" | jq 'map({title, status, price_text})'
echo "$MINE" | jq -e --arg id "$LISTING_ID" '.[] | select(.listing_id == $id) | .status == "closed"' >/dev/null \
  || fail "my_listings does not show the posted desk as closed"
say "✓ my_listings shows the desk closed at €120"

# ─── done ────────────────────────────────────────────────────────────

heading "Demo complete — a full provider exchange with NO money on the wire"
say "Server log:        /tmp/kiosk-philslist-demo.log"
say "DB:                kiosk_philslist_development"
say ""
say "The whole exchange (browse → post → edit → close) used queries and actions only."
say "There is no /kiosk/pay route and 'pay' is absent from the discovery doc —"
say "the same wire the commerce demos use for money, here with none."
