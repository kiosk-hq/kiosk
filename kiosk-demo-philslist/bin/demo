#!/usr/bin/env bash
# A curl tour of the wire as Alice's assistant: browse → post → edit → close,
# with no payment step. Drives the origin `bin/dev` serves.

set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SERVER_URL="${SERVER_URL:-http://localhost:${PORT:-3000}}"

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
fail()    { printf "\n  \033[1;31m✗ %s\033[0m\n" "$1" >&2; exit 1; }

# A query is a GET with its arguments on the query string; an action is a POST
# with a JSON body. A success body is the result itself.
q()   { curl -sS "$SERVER_URL/kiosk/$2${3:+?$3}" -H "Authorization: Bearer $1"; }
run() { curl -sS -X POST "$SERVER_URL/kiosk/$2" -H "Authorization: Bearer $1" \
          -H "Content-Type: application/json" -d "$3"; }

heading "Alice's assistant registers, and Alice links it to her account"
TOKEN="$(cd "$APP_ROOT" && SERVER_URL="$SERVER_URL" bundle exec ruby -r./script/bound_assistant -e '
  puts bind_assistant(server: ENV["SERVER_URL"], issuer: ENV["SERVER_URL"],
                      email: "alice@example.com", password: "philslist-demo-password").token')"

heading "Discovery: the capabilities carry no pay"
curl -sS "$SERVER_URL/.well-known/kiosk.json" | jq -c .kiosk.capabilities

heading "browse_listings — the open board, every seller"
q "$TOKEN" browse_listings | jq -c '.[] | {title, price_text, owner_handle}'

heading "post_listing → edit_listing → close_listing"
LISTING_ID=$(run "$TOKEN" post_listing \
  '{"category_slug":"furniture","title":"Oak desk","body":"Solid oak, moving sale","price_text":"€150"}' | jq -r .listing_id)
[[ "$LISTING_ID" != null ]] || fail "post_listing returned no listing_id"
run "$TOKEN" edit_listing "{\"listing_id\":\"$LISTING_ID\",\"price_text\":\"€120\"}" | jq -c .
run "$TOKEN" close_listing "{\"listing_id\":\"$LISTING_ID\"}" | jq -c .

heading "my_listings"
q "$TOKEN" my_listings | jq -c '.[] | {title, status, price_text}'
