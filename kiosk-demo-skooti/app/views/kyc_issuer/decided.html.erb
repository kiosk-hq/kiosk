<%# Result of the human's decision on the stub KYC-provider page. %>
<main>
  <% if @decision == :approved %>
    <h1>Verified</h1>
    <p>
      Your age and category-A licence were confirmed. The assistant can now
      complete the motorcycle rental. You can close this page.
    </p>
  <% else %>
    <h1>Declined</h1>
    <p>
      You declined this verification. The assistant will not be able to rent the
      combustion-engine motorcycle. You can close this page.
    </p>
  <% end %>
</main>
