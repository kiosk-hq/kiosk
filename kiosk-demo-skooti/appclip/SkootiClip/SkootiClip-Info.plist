<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SkootiClip-Info.plist
  ─────────────────────
  SNIPPET — not a complete Info.plist.  In Xcode the App Clip target
  inherits most keys from the PRODUCT_NAME-Info.plist generated by the
  build system.  Add these keys to that file (or via the target editor
  under "Info" → "Custom iOS Target Properties").

  Required keys for this App Clip:
    NSBluetoothAlwaysUsageDescription  — without this iOS will refuse
      to call CBCentralManager; the app will crash or be rejected.
    NSAppClip (dict)  — required for every App Clip target.
-->
<plist version="1.0">
<dict>

  <!-- ── CoreBluetooth permission ──────────────────────────────
       Displayed in the system permission dialog the first time
       the App Clip tries to scan.  Must be present; without it
       iOS refuses to show the dialog and the BLE calls silently
       fail with CBManagerState.unauthorized.
  -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Skooti needs Bluetooth to connect to the scooter lock and unlock it.</string>

  <!-- ── App Clip configuration ────────────────────────────────
       NSAppClip is required in every App Clip target's Info.plist.
       NSAppClipRequestEphemeralUserNotification and
       NSAppClipRequestLocationConfirmation are optional; omit if
       not needed.
  -->
  <key>NSAppClip</key>
  <dict>
    <!-- Optional: ask iOS to grant ephemeral notification permission
         so the clip can notify the user when the scooter is unlocked
         even if the app is backgrounded.  Set to false if not needed. -->
    <key>NSAppClipRequestEphemeralUserNotification</key>
    <false/>
  </dict>

  <!-- ── Foreground BLE caveat ──────────────────────────────────
       App Clips CANNOT use background BLE execution modes.
       Do NOT add UIBackgroundModes / bluetooth-central here.
       The BLE session must complete while the App Clip is in
       the foreground (~5-10 s is sufficient for the unlock flow).

       If the user backgrounds the Clip mid-flow, CoreBluetooth will
       pause; the flow resumes when the Clip returns to foreground.
       In practice, the user holds the phone near the scooter and
       the entire flow completes in under 5 s.
  -->

</dict>
</plist>
