#!/usr/bin/env bash
# A curl tour of a running stylish origin (bin/dev): binding, discovery, queries,
# a booking, and isolation between two humans' assistants.
#
#   bin/demo                                   # the origin bin/dev serves
#   SERVER_URL=http://localhost:3005 bin/demo  # any other

set -euo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SERVER_URL="${SERVER_URL:-http://localhost:3000}"
DEMO_PASSWORD="combette-demo-password"
# book_appointment refuses a slot that has passed, so the slot is a month ahead.
DEMO_SLOT="$(date -u -v+30d '+%Y-%m-%dT14:00:00Z' 2>/dev/null || date -u -d '+30 days' '+%Y-%m-%dT14:00:00Z')"

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
step()    { printf "\n  \033[1;33m▶\033[0m %s\n" "$1"; }

for tool in curl jq; do
  command -v "$tool" >/dev/null || { echo "missing: $tool" >&2; exit 1; }
done

# A query is a GET with its arguments in the query string; an action is a POST
# with its arguments as the JSON body. The body IS the result.
#   q   <token> <query-name>
#   run <token> <action-name> <json-body>
q()   { curl -sSf "$SERVER_URL/kiosk/$2" -H "Authorization: Bearer $1"; }
run() { curl -sSf -X POST "$SERVER_URL/kiosk/$2" -H "Authorization: Bearer $1" \
          -H "Content-Type: application/json" -d "$3"; }

# Register a fresh assistant, sign the human in, link, claim; print its token.
#   bind <email>
bind() {
  SERVER_URL="$SERVER_URL" HOLDER_EMAIL="$1" HOLDER_PASSWORD="$DEMO_PASSWORD" \
    bundle exec ruby -r"$APP_ROOT/script/bound_assistant" -e '
      puts bind_assistant(server: ENV["SERVER_URL"], issuer: ENV["SERVER_URL"],
                          email: ENV["HOLDER_EMAIL"], password: ENV["HOLDER_PASSWORD"]).token
    '
}

heading "Binding: each assistant earns a token through the real ceremony"
step "Alice's assistant: register (Equihash toll) → Alice signs in → link → claim"
ALICE_TOKEN="$(bind alice@example.com)"
step "Bob's assistant: the same ceremony, another human, another key"
BOB_TOKEN="$(bind bob@example.com)"

heading "Discovery: what is this provider?"
step "GET /.well-known/kiosk.json"
curl -sSf "$SERVER_URL/.well-known/kiosk.json" | jq '.kiosk | {version, endpoint, issuer, capabilities, owner}'
step "GET /kiosk/.well-known/jwks.json — the keys its tokens verify against"
curl -sSf "$SERVER_URL/kiosk/.well-known/jwks.json" | jq '.keys[0] | {kty, use, alg, kid}'

heading "Alice's assistant reads"
step "salons"
q "$ALICE_TOKEN" salons | jq '.'
step "availability — every service is always open"
q "$ALICE_TOKEN" availability | jq 'map({service, open, price_eur})'
step "my_appointments — none yet"
q "$ALICE_TOKEN" my_appointments | jq 'length'

heading "Alice's assistant books a service off the menu"
SALON_ID="$(q "$ALICE_TOKEN" salons | jq -r '.[0].salon_id')"
SERVICE_ID="$(q "$ALICE_TOKEN" availability | jq -r '.[0].service_id')"
step "POST /kiosk/book_appointment"
run "$ALICE_TOKEN" book_appointment \
  "{\"salon_id\":$SALON_ID,\"service_id\":$SERVICE_ID,\"slot\":\"$DEMO_SLOT\"}" | jq '.'

heading "Isolation: the same query, two humans"
step "Alice sees her appointment"
q "$ALICE_TOKEN" my_appointments | jq 'length'
step "Bob sees none"
q "$BOB_TOKEN" my_appointments | jq 'length'

heading "Try it yourself"
printf '  curl -sS %s/kiosk/salons -H "Authorization: Bearer $TOKEN" | jq .\n' "$SERVER_URL"
