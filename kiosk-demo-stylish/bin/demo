#!/usr/bin/env bash
# Kiosk demo walkthrough — a curl-driven tour of the wire surface.
#
# Run via `rake demo` (handles DB setup + invokes this script), or
# directly when the demo DB is already prepared.

set -euo pipefail

PORT="${KIOSK_DEMO_PORT:-3005}"
SERVER_URL="http://127.0.0.1:$PORT"
ALICE="00000000-0000-0000-0000-000000000001"
BOB="00000000-0000-0000-0000-000000000002"

ALICE_TOKEN="agent:u-$ALICE:a-alice-claude:r-customer"
BOB_TOKEN="agent:u-$BOB:a-bob-chatgpt:r-customer"

heading() { printf "\n\033[1;36m── %s ──\033[0m\n" "$1"; }
step()    { printf "\n  \033[1;33m▶\033[0m %s\n" "$1"; }
say()     { printf "  %s\n" "$1"; }

cleanup() {
  if [[ -n "${SERVER_PID:-}" ]]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

require_tool() {
  command -v "$1" >/dev/null 2>&1 \
    || { echo "missing: $1 — install it then re-run" >&2; exit 1; }
}
require_tool curl
require_tool jq

# The 0.4 wire: one endpoint per verb. A query is a GET whose arguments are the
# query string; an action is a POST whose arguments are the JSON body. A success
# body IS the result — no envelope to unwrap, so no `.rows`/`.value` below.
#   q  <token> <query-name> [query-string]
#   run <token> <action-name> <json-body>
q()   { curl -sS "$SERVER_URL/kiosk/$2${3:+?$3}" -H "Authorization: Bearer $1"; }
run() { curl -sS -X POST "$SERVER_URL/kiosk/$2" -H "Authorization: Bearer $1" \
          -H "Content-Type: application/json" -d "$3"; }

# ─── boot ────────────────────────────────────────────────────────────

heading "Starting Combette (the demo provider) on port $PORT"
KIOSK_ISSUER="$SERVER_URL" \
  bundle exec rails s -p "$PORT" -b 127.0.0.1 -e development \
  >/tmp/kiosk-demo.log 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 30); do
  if curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null 2>&1; then
    say "✓ Server up at $SERVER_URL"
    break
  fi
  sleep 1
done

curl -sf "$SERVER_URL/.well-known/kiosk.json" >/dev/null || {
  echo "server did not become ready — see /tmp/kiosk-demo.log" >&2
  exit 1
}

# ─── discovery ───────────────────────────────────────────────────────

heading "Discovery: what is this provider?"

step "GET /.well-known/kiosk.json"
curl -sf "$SERVER_URL/.well-known/kiosk.json" \
  | jq '.kiosk | {version, endpoint, issuer, capabilities, owner}'

step "GET <endpoint>/.well-known/jwks.json — public verification keys"
curl -sf "$SERVER_URL/kiosk/.well-known/jwks.json" \
  | jq '.keys[0] | {kty, use, alg, kid}'

# ─── authenticated SQL ───────────────────────────────────────────────

heading "Alice's agent reads data (named queries)"

step "List salons (publicly visible)"
q "$ALICE_TOKEN" salons | jq '.'

step "Browse the salon's OPEN services (evergreen menu — always bookable, infinite capacity)"
q "$ALICE_TOKEN" availability | jq 'map({service, open, price_eur})'

step "Count appointments visible to Alice (initially 0 — bookings accumulate during the demo)"
q "$ALICE_TOKEN" my_appointments | jq 'length'

# ─── run an Action ───────────────────────────────────────────────────

heading "Alice's agent books a haircut — picks a service off the menu"

SALON_ID=$(q "$ALICE_TOKEN" salons | jq -r '.[0].salon_id')

# Pick the first open service from the availability query (all always bookable).
SERVICE_ID=$(q "$ALICE_TOKEN" availability | jq -r '.[0].service_id')

step "POST /kiosk/book_appointment for salon $SALON_ID with service $SERVICE_ID"
run "$ALICE_TOKEN" book_appointment \
  "{\"salon_id\":$SALON_ID,\"service_id\":$SERVICE_ID,\"slot\":\"2026-07-01T14:00:00Z\"}" \
  | jq '.'

# ─── App-layer isolation ─────────────────────────────────────────────

heading "App-layer isolation: Alice and Bob can only see their own"

step "Alice sees her appointment (count = 1)"
q "$ALICE_TOKEN" my_appointments | jq 'length'

step "Bob sees 0 (same query, different identity)"
q "$BOB_TOKEN" my_appointments | jq 'length'

# ─── done ────────────────────────────────────────────────────────────

heading "Demo complete"
say "Server log:        /tmp/kiosk-demo.log"
say "DB:                kiosk_stylish_development"
say ""
say "Try it yourself (the wire is plain HTTP — curl + jq):"
say "  a query is a GET at its own endpoint, and the body IS the result:"
say "    curl -sS $SERVER_URL/kiosk/salons \\"
say "      -H 'Authorization: Bearer $ALICE_TOKEN' | jq '.'"
say "  an action is a POST at its own endpoint, arguments in the JSON body:"
say "    curl -sS -X POST $SERVER_URL/kiosk/book_appointment \\"
say "      -H 'Authorization: Bearer $ALICE_TOKEN' \\"
say "      -H 'Content-Type: application/json' \\"
say "      -d '{\"salon_id\":1,\"slot\":\"2026-07-01T14:00:00Z\"}' | jq '.'"
say ""
say "Swap the demo stubs for production-shape auth (two DIFFERENT seams):"
say "  • AGENT-IdP (c.agent_idp): registered assistants already flow through real"
say "    Kiosk-issued JWTs; to front an EXTERNAL agent-identity issuer, implement"
say "    Kiosk::AgentIdentityProviders::Base (external agent-IdP adapters are a"
say "    planned seam — none shipped yet)."
say "  • USER-IdP (c.user_idp): to bind a real HUMAN account/role, set c.user_idp;"
say "    kiosk-user-idp-devise is the shipped worked example (this demo runs it)."
