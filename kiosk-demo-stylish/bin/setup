#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Set this DEMO up. It is the Rails-generated bin/setup with the one
  # substitution that matters in a demo app, and with the flag the substitution
  # made meaningless removed.
  #
  # WHY (K-1315). The generated script runs `db:prepare` and then execs
  # `bin/dev`. Both halves were wrong here. `db:prepare` loads the schema and
  # stops, so the app came up with no seeded catalogue and without `app_role` —
  # the group role this demo's queries assume, created and granted by
  # `demo:setup` — while the exec named a file four of the seven demos did not
  # ship, so the first command a Rails developer types ended in Errno::ENOENT on
  # its last line. `demo:setup` is what this app's own README tells an operator
  # to run; running anything else here would be a second, worse answer to the
  # same question. The generated `--reset` arm is gone with it: `demo:setup`
  # already drops.
  #
  # IT IS DESTRUCTIVE, and says so where the operator reads rather than only
  # here: `demo:setup` runs `db:drop db:create db:schema:load db:seed`
  # unconditionally, so nothing left in this demo's development database
  # survives. The README's generated Prerequisites block carries the same
  # sentence, and bin/check-demo-prereqs keeps the two in step.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Preparing the demo database (DROPS and reseeds it) =="
  system! "bin/rails demo:setup"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
