source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Human account holders sign in with real Devise sessions; the Kiosk
# account-binding surfaces (device verify page, link mint, unlink)
# authenticate that Warden session through the kiosk-user-idp-devise
# adapter below.
gem "devise"

# ─── Kiosk ────────────────────────────────────────────────────────────
# Path overrides while the gems live in this monorepo. When the demo
# moves to its own kiosk-hq/kiosk-demo-tudu repo, swap these to
# rubygems-published versions.
gem "kiosk-all",                path: "../kiosk-all"
gem "kiosk-core",               path: "../kiosk-core"
gem "kiosk-rls",                path: "../kiosk-rls"
gem "kiosk-server",             path: "../kiosk-server"
gem "kiosk-pow-equihash",       path: "../kiosk-pow-equihash"
gem "kiosk-reputation",         path: "../kiosk-reputation"
gem "kiosk-user-idp-devise",    path: "../kiosk-user-idp-devise"

# Opt-in request-shape validation (c.validate_requests = true) — kiosk-server
# lazily requires json_schemer only when the flag is on (UNIFORM-VALIDATION
# slice-1, K-479).
gem "json_schemer"

# K-661: `UUID.validate` backs UuidCheck's canonical-uuid guard (K-579/K-596).
# Pinned to the final release (2.3.9, 2018-05-15) — upstream repo archived
# 2024-01-01, nothing newer to move to. `require: false`: UuidCheck requires
# it explicitly rather than at boot. Pulls macaddr -> systemu (MAC-address
# reading for v1 UUID generation, a code path UuidCheck never calls) as
# transitive runtime deps.
gem "uuid", "= 2.3.9", require: false

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
end
