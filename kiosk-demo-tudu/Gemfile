# frozen_string_literal: true

source 'https://rubygems.org'

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem 'rails', '~> 8.1.3'
# Use postgresql as the database for Active Record
gem 'pg', '~> 1.1'
# Use the Puma web server [https://github.com/puma/puma]
gem 'puma', '>= 5.0'

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: %i[windows jruby]

# The event stream between Puma workers, on the primary database (config/cable.yml).
gem 'solid_cable'

# Reduces boot times through caching; required in config/boot.rb
gem 'bootsnap', require: false

# The answers to the Kiosk queries and actions are app/views/kiosk/**/*.json.jbuilder.
gem 'jbuilder'

# Human account holders sign in with real Devise sessions; the Kiosk
# account-binding surfaces (device verify page, link mint, unlink)
# authenticate that Warden session through the kiosk-user-idp-devise
# adapter below.
gem 'devise'

# ─── Kiosk ────────────────────────────────────────────────────────────
# kiosk-all brings kiosk-core and kiosk-server, and kiosk-pow-equihash brings
# kiosk-pow. `path '..'` reads each gem from the working tree of this
# monorepo. Outside it, keep the gem lines and remove the `path` block around them.
path '..' do
  gem 'kiosk-all'
  gem 'kiosk-pow-equihash'
  gem 'kiosk-reputation'
  gem 'kiosk-user-idp-devise'
end

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem 'debug', platforms: %i[mri windows], require: 'debug/prelude'
end

group :test do
  gem 'kiosk-test-support', path: '..'
end

# The attack battery, ../kiosk-redteam/suites/tudu.rb, runs with this bundle.
group :development do
  gem 'kiosk-redteam', path: '..', require: false
end
