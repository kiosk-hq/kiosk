<!DOCTYPE html>
<html>
  <head>
    <title>tudu</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 640px; margin: 2rem auto; padding: 0 1rem; color: #222; }
      h1 a { color: inherit; text-decoration: none; }
      nav { font-size: .9rem; margin-bottom: 1.5rem; color: #666; }
      nav a { margin-right: 1rem; }
      .notice { background: #e6f7e6; padding: .6rem .8rem; border-radius: 6px; word-break: break-all; }
      .alert  { background: #fbe6e6; padding: .6rem .8rem; border-radius: 6px; }
      ul { list-style: none; padding: 0; }
      li { padding: .4rem 0; border-bottom: 1px solid #eee; }
      .done { text-decoration: line-through; color: #999; }
      form.inline { display: inline; }
      .role { color: #888; font-size: .85rem; }
      button, input[type=submit] { cursor: pointer; }
    </style>
  </head>
  <body>
    <h1><a href="/">tudu</a></h1>
    <nav>
      <% if user_signed_in? %>
        Signed in as <%= current_user.email %>
        <%= link_to "My lists", lists_path %>
        <%= link_to "Assistants", "/kiosk/auth/assistants" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "inline" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path %>
      <% end %>
    </nav>

    <% if notice %><p class="notice"><%= notice %></p><% end %>
    <% if alert %><p class="alert"><%= alert %></p><% end %>

    <%= yield %>
  </body>
</html>
