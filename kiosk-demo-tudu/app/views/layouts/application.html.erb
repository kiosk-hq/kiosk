<!DOCTYPE html>
<html lang="en">
  <head>
    <title>tudu — collaborative todo (Kiosk demo)</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%# The pinned skill file, the same URL /.well-known/kiosk.json names; set in the initializer. %>
    <link rel="kiosk" href="<%= Kiosk.configuration.skill_url %>">
    <%= stylesheet_link_tag "/application.css" %>
  </head>
  <body>
    <div class="agentbar">
      <span class="tag">🤖 For agents</span>
      <span>Agents &amp; AI assistants — <a href="/.well-known/kiosk.json">learn here</a> how to work with this site.</span>
      <a class="what" href="https://kiosk.tech">(what is this?)</a>
    </div>
    <header class="site">
      <div class="logo"><a href="/">tu<span>du</span></a></div>
      <nav>
        <% if user_signed_in? %>
          <span class="who">Signed in as <%= current_user.email %></span>
          <%= link_to "My lists", lists_path %>
          <%= link_to "Assistants", "/kiosk/auth/assistants" %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "inline" %>
        <% else %>
          <%= link_to "Housemate view", shared_path %>
          <%= link_to "Sign in", new_user_session_path %>
          <%= link_to "Sign up", new_user_registration_path %>
        <% end %>
      </nav>
    </header>

    <main class="wrap">
      <% if notice %><p class="notice"><%= notice %></p><% end %>
      <% if alert %><p class="alert"><%= alert %></p><% end %>

      <%= yield %>
    </main>
  </body>
</html>
