<% if user_signed_in? %>
  <%# ── Signed-in: the actual tudu app (this IS the storefront) ─────────── %>
  <%# Live DOMAIN activity summary — app-wide counts on tudu's own tables. %>
  <% if @activity %>
    <ul class="activity top">
      <li><div class="n"><%= @activity[:lists] %></div><div class="l">Lists</div></li>
      <li><div class="n"><%= @activity[:todos] %></div><div class="l">Todos</div></li>
      <li><div class="n"><%= @activity[:done] %></div><div class="l">Done</div></li>
      <li><div class="n"><%= @activity[:members] %></div><div class="l">Members</div></li>
    </ul>
  <% end %>

  <h2>Your lists</h2>

  <% if @lists.empty? %>
    <p>No lists yet. Create one below, or ask your assistant to.</p>
  <% else %>
    <ul>
      <% @lists.each do |l| %>
        <li>
          <%= link_to l.title, list_path(l) %>
          <span class="role">(<%= l.role %>)</span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h3>New list</h3>
  <%= form_with url: lists_path, method: :post do %>
    <%= text_field_tag :title, nil, placeholder: "List title", required: true, maxlength: List::TITLE_MAX_LENGTH %>
    <%= submit_tag "Create" %>
  <% end %>

<% else %>

  <%# 0. What an assistant can do here %>
  <section class="sec">
    <div class="sec-k">🔌 Built for AI assistants</div>
    <div class="tryit">
      <h2>Point your AI assistant here — it creates &amp; shares a todo list</h2>
      <p>tudu is a <strong>shared todo app that AI assistants can use directly</strong>. An assistant learns what tudu offers, signs itself up, creates a list, and <strong>shares it with another person</strong>. Tell your AI assistant:</p>
      <p class="say">“Add ‘buy milk’ to my shared list on tudu.demo.kiosk.tech, and invite my housemate's assistant.”</p>
      <p>It finds tudu, signs itself up, and works on your shared lists — you need no account and no app. There is <strong>no payment</strong> anywhere; tudu shows Kiosk at work for shared lists. <strong>Where does the shared list show up? In the housemate view below</strong> — a public, read-only page of the lists shared with the housemate.</p>
      <div class="linkbox">
        <strong>Move the work to your own account.</strong> An assistant can work with no account of yours behind it. Later you link it to your account, and its lists and memberships move to you. <%= link_to "Sign in", new_user_session_path %> or <%= link_to "create an account", new_user_registration_path %>, then open <a href="/kiosk/auth/assistants">Manage&nbsp;assistants</a> and create a link code. Give it to your assistant — it uses the code to link itself to you.
        <div class="cred">Demo login: <code>alice@example.com</code> &nbsp;/&nbsp; <code>tudu-demo-password</code></div>
      </div>
    </div>
  </section>

  <%# 1. The housemate view %>
  <% if @housemate_board %>
    <section class="sec">
      <div class="sec-k">👀 Housemate view — see the sharing land</div>
      <%= render "housemate_board" %>
      <p class="note">This is the seeded housemate's own view (also on its own page: <%= link_to "/shared", shared_path %>). When an assistant creates a list and shares it with this housemate, the list appears here.</p>
    </section>
  <% end %>

  <%# 2. About this demo %>
  <section class="sec">
    <div class="sec-k">About this demo</div>
    <div class="about">
      <p><strong>tudu</strong> is a todo app that several people share — the demo about <strong>sharing lists and membership</strong>. No money changes hands. Where philslist shows a public board on which only an owner edits a listing, tudu shows <strong>lists shared between members</strong>: each person sees only the lists they are a member of. It also shows <strong>assistants working together</strong> for different people, and <strong>linking an assistant's work to a person's account</strong>.</p>
      <div class="chips">
        <span class="chip">👥 Shared lists</span>
        <span class="chip">Members see only their lists</span>
        <span class="chip">Assistant↔assistant</span>
        <span class="chip">Link an assistant to your account</span>
        <span class="chip">No payment</span>
      </div>
      <div class="links">
        <a href="https://github.com/kiosk-hq/kiosk/tree/main/kiosk-demo-tudu">▶ Source on GitHub</a>
        <a href="https://kiosk.tech">What is Kiosk? →</a>
      </div>
    </div>
  </section>

  <%# 3. Live activity %>
  <% if @activity %>
    <section class="sec">
      <div class="sec-k">Live activity</div>
      <ul class="activity">
        <li><div class="n"><%= @activity[:lists] %></div><div class="l">Lists</div></li>
        <li><div class="n"><%= @activity[:todos] %></div><div class="l">Todos</div></li>
        <li><div class="n"><%= @activity[:done] %></div><div class="l">Done</div></li>
        <li><div class="n"><%= @activity[:members] %></div><div class="l">Members</div></li>
      </ul>
    </section>
  <% end %>

  <%# 4. The app as a human visitor sees it %>
  <div class="store">
    <div class="store-label">The app — what a human visitor sees</div>
    <div class="store-body">
      <h1>A shared todo app, for people and assistants.</h1>
      <p>Sign in to manage your lists, add todos, complete them, and invite others — the same lists your assistant sees.</p>
    </div>
  </div>

<% end %>
