# frozen_string_literal: true

require 'English'
require 'rspec/core/rake_task'
require 'base64'
require 'json'
require 'shellwords'

RSpec::Core::RakeTask.new(:spec)

task default: :spec

# Cross-implementation gate at a TOY size (proofsize 12 at edgebits 10, not
# production difficulty): the numpy solver (solve_cuckoo.py) runs on a fixed
# salt, Kiosk::Pow::Cuckoo.verify must accept its proof, and must reject the
# proof with one cycle edge changed.
#
# A proofsize-12 cycle needs a pair graph of girth 12 or less. At edgebits 10
# (girth about 9) such cycles exist; from edgebits 13 up they practically do not.
module SolveParity
  EDGEBITS  = 10
  PROOFSIZE = 12
  # Fixed salt, carried as base64.
  SALT_B64 = 'cGFyaXR5IQ=='
  # Safety wrapper: 512 MB cap, 30 s timeout, low priority. The solver also
  # refuses an oversized edgebits before it allocates.
  WRAPPER = 'KIOSK_POW_MAX_BYTES=536870912 timeout 30 nice -n 19 python3'
  LABEL = "TOY DEMO: edgebits=#{EDGEBITS}, proofsize=#{PROOFSIZE}".freeze

  module_function

  def run
    puts "Running numpy solver (#{LABEL}) …"
    started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    proof = solve
    elapsed = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - started).round(2)
    puts "  header_nonce=#{proof['header_nonce']}  cycle[0..2]=#{proof['cycle'][0..2].inspect}  (#{elapsed}s)"
    check_accepts(proof)
    check_rejects_tampered(proof)
    puts "solve_parity PASSED  (#{LABEL}, solve=#{elapsed}s)"
  end

  def solve
    solver = File.expand_path('solve_cuckoo.py', __dir__)
    abort "solve_cuckoo.py not found at #{solver}" unless File.exist?(solver)

    challenge = JSON.generate({ 'salt' => SALT_B64,
                                'params' => { 'edgebits' => EDGEBITS, 'proofsize' => PROOFSIZE, 'target' => nil } })
    raw = `#{WRAPPER} #{solver} #{Shellwords.shellescape(challenge)}`
    abort "Solver exited non-zero (exit #{$CHILD_STATUS.exitstatus})\nOutput: #{raw}" unless $CHILD_STATUS.success?
    JSON.parse(raw.strip)
  end

  def verify(header_nonce, cycle)
    Kiosk::Pow::Cuckoo.verify(salt: Base64.strict_decode64(SALT_B64),
                              params: Kiosk::Pow::Cuckoo.params(edgebits: EDGEBITS, proofsize: PROOFSIZE),
                              nonce: { header_nonce:, cycle: })
  end

  def check_accepts(proof)
    abort "FAIL: Ruby verifier REJECTED a valid solver proof!\n  proof=#{proof.inspect}" unless verify(proof['header_nonce'], proof['cycle'])
    puts '  (a) Ruby verifier ACCEPTS solver proof — OK'
  end

  # Moves the first edge by one and sorts again: the verifier requires ascending edges.
  def check_rejects_tampered(proof)
    tampered = proof['cycle'].dup
    tampered[0] += tampered[0].zero? ? 1 : -1
    abort 'FAIL: Ruby verifier ACCEPTED a tampered proof!' if verify(proof['header_nonce'], tampered.sort)
    puts '  (b) Ruby verifier REJECTS tampered proof    — OK'
  end
end

task :solve_parity do
  require_relative 'lib/kiosk/pow/cuckoo'
  SolveParity.run
end
