# frozen_string_literal: true

require 'rspec/core/rake_task'
require 'json'
require 'shellwords'
require 'tempfile'

RSpec::Core::RakeTask.new(:spec)

task default: :spec

PARITY_SALT = 'testsalt12345678' # 16 raw bytes

# The Python side of the digest check: the same inputs as `ruby_parity_hex`.
PARITY_PY_SCRIPT = <<~PY
  import argon2.low_level, sys
  salt   = b"testsalt12345678"
  secret = b"42"
  d = argon2.low_level.hash_secret_raw(
      secret=secret, salt=salt,
      time_cost=1, memory_cost=8192, parallelism=1,
      hash_len=32, type=argon2.low_level.Type.ID, version=19)
  sys.stdout.write(d.hex())
PY

# Proves that the Ruby provider-side `verify` and the shipped Python client
# solver (solve.py) compute byte-identical Argon2id digests. Run it after you
# change either implementation:
#
#   bundle exec rake parity
#   PYTHON=/path/to/python3 bundle exec rake parity
task :parity do
  require 'kiosk/pow'

  python = find_python_with_argon2
  unless python
    abort 'parity: no python3 with argon2-cffi found. ' \
          'Install it (`pip install argon2-cffi`) or set PYTHON=/path/to/python3.'
  end

  check_digest_parity(python)
  check_solver_parity(python)
  puts "\nAll parity checks passed."
end

# Fixed inputs with a small m, so the check is fast.
def check_digest_parity(python)
  params   = Kiosk::Pow.params(d: 6, m: 8_192, t: 1, p: 1)
  ruby_hex = Kiosk::Pow.digest(salt: PARITY_SALT, params:, nonce: '42').unpack1('H*')
  puts "Ruby   digest: #{ruby_hex}"

  python_hex = python_parity_hex(python)
  puts "Python digest: #{python_hex}"

  abort "\nDIGEST PARITY: FAIL\n  Ruby:   #{ruby_hex}\n  Python: #{python_hex}" unless ruby_hex == python_hex
  puts "\nDIGEST PARITY: OK — Ruby and Python produce byte-identical Argon2id digests."
end

def python_parity_hex(python)
  Tempfile.open(['kiosk_pow_parity', '.py'], binmode: false) do |f|
    f.write(PARITY_PY_SCRIPT)
    f.flush
    `#{python} #{f.path.shellescape}`.strip
  end
end

# End to end: Ruby verify accepts a nonce that solve.py found.
def check_solver_parity(python)
  puts "\nRunning solve.py end-to-end parity (d=8, m=8192, ~256 evals) ..."
  found_nonce = solve_py_nonce(python)
  puts "solve.py found nonce: #{found_nonce}"

  params = Kiosk::Pow.params(d: 8, m: 8_192, t: 1, p: 1)
  abort "E2E PARITY: FAIL — Ruby verify rejected nonce #{found_nonce.inspect}." unless Kiosk::Pow.verify(salt: PARITY_SALT, params:, nonce: found_nonce)

  puts 'E2E PARITY: OK — Ruby verify accepts the Python-produced nonce.'
end

def solve_py_nonce(python)
  solve_script   = File.join(__dir__, 'solve.py')
  challenge_json = JSON.generate(
    'salt' => [PARITY_SALT].pack('m0'),
    'params' => { 'm' => 8_192, 't' => 1, 'p' => 1, 'd' => 8 }
  )
  JSON.parse(`#{python} #{solve_script.shellescape} #{challenge_json.shellescape}`.strip).fetch('nonce')
end

def find_python_with_argon2
  candidates = [ENV.fetch('PYTHON', nil), '/opt/homebrew/bin/python3',
                'python3.14', 'python3.13', 'python3.12', 'python3'].compact
  candidates.find { |py| system("#{py} -c 'import argon2.low_level' 2>/dev/null") }
end
