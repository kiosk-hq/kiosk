require "rspec/core/rake_task"
require "json"
require "shellwords"
require "tempfile"

RSpec::Core::RakeTask.new(:spec)

task default: :spec

# ---------------------------------------------------------------------------
# parity — cross-implementation Argon2id digest check
#
# Proves that the Ruby provider-side `verify` and the shipped Python
# client solver (solve.py) compute byte-identical Argon2id digests.
# Run once after changing either implementation:
#
#   bundle exec rake parity
#   PYTHON=/path/to/python3 bundle exec rake parity
# ---------------------------------------------------------------------------
task :parity do
  require "kiosk/pow"

  python = find_python_with_argon2

  unless python
    abort "parity: no python3 with argon2-cffi found. " \
          "Install it (`pip install argon2-cffi`) or set PYTHON=/path/to/python3."
  end

  # Fixed inputs for the digest parity check (small m so CI is fast).
  salt      = "testsalt12345678"   # 16 raw bytes
  nonce_str = "42"
  params    = Kiosk::Pow.params(d: 6, m: 8_192, t: 1, p: 1)

  # -- Ruby digest ----------------------------------------------------------
  ruby_hex = Kiosk::Pow.digest(salt:, params:, nonce: nonce_str).unpack1("H*")
  puts "Ruby   digest: #{ruby_hex}"

  # -- Python digest (via temp script) -------------------------------------
  py_script = <<~PY
    import argon2.low_level, sys
    salt   = b"testsalt12345678"
    secret = b"42"
    d = argon2.low_level.hash_secret_raw(
        secret=secret, salt=salt,
        time_cost=1, memory_cost=8192, parallelism=1,
        hash_len=32, type=argon2.low_level.Type.ID, version=19)
    sys.stdout.write(d.hex())
  PY

  python_hex = Tempfile.open(["kiosk_pow_parity", ".py"], binmode: false) do |f|
    f.write(py_script)
    f.flush
    `#{python} #{f.path.shellescape}`.strip
  end
  puts "Python digest: #{python_hex}"

  if ruby_hex == python_hex
    puts "\nDIGEST PARITY: OK — Ruby and Python produce byte-identical Argon2id digests."
  else
    abort "\nDIGEST PARITY: FAIL\n  Ruby:   #{ruby_hex}\n  Python: #{python_hex}"
  end

  # -- End-to-end: solve.py nonce accepted by Ruby verify ------------------
  puts "\nRunning solve.py end-to-end parity (d=8, m=8192, ~256 evals) ..."
  solve_script = File.join(__dir__, "solve.py")

  challenge_json = JSON.generate(
    "salt"   => [salt].pack("m0"),
    "params" => { "m" => 8_192, "t" => 1, "p" => 1, "d" => 8 }
  )
  solve_out   = `#{python} #{solve_script.shellescape} #{challenge_json.shellescape}`.strip
  result      = JSON.parse(solve_out)
  found_nonce = result.fetch("nonce")

  puts "solve.py found nonce: #{found_nonce}"

  e2e_params = Kiosk::Pow.params(d: 8, m: 8_192, t: 1, p: 1)
  accepted   = Kiosk::Pow.verify(salt:, params: e2e_params, nonce: found_nonce)

  if accepted
    puts "E2E PARITY: OK — Ruby verify accepts the Python-produced nonce."
  else
    abort "E2E PARITY: FAIL — Ruby verify rejected nonce #{found_nonce.inspect}."
  end

  puts "\nAll parity checks passed."
end

# ---------------------------------------------------------------------------

def find_python_with_argon2
  candidates = [
    ENV.fetch("PYTHON", nil),
    "/opt/homebrew/bin/python3",
    "python3.14",
    "python3.13",
    "python3.12",
    "python3"
  ].compact

  candidates.find do |py|
    system("#{py} -c 'import argon2.low_level' 2>/dev/null")
  end
end
