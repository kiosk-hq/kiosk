source "https://rubygems.org"

gemspec

# Local-development overrides — sibling gems haven't shipped to RubyGems yet.
gem "kiosk-core",         path: "../kiosk-core"
gem "kiosk-test-support", path: "../kiosk-test-support"

# PoW-gate path deps — available in specs; NOT hard-required in lib code.
# The host that wires a reputation_policy will have these loaded transitively.
# kiosk-pow (argon2id) is the legacy backend; kiosk-pow-equihash is the default.
gem "kiosk-pow",          path: "../kiosk-pow"
gem "kiosk-pow-equihash", path: "../kiosk-pow-equihash"
gem "kiosk-reputation",   path: "../kiosk-reputation"

# Opt-in request-validation (validate_requests) path dep — available in specs;
# NOT a runtime dependency of the gem (lazily required in lib only when the flag
# is on). A host that enables validate_requests adds it to its own Gemfile.
gem "json_schemer"

# Durable-store contract specs (DeviceAuthorizationStores::ActiveRecord) —
# available in specs; NOT hard-required in lib code. A Rails host brings its
# own ActiveRecord + PG driver. The store spec SKIPS its ActiveRecord
# context when no local Postgres is reachable.
gem "activerecord", "~> 8.1"
gem "pg",           "~> 1.5"
