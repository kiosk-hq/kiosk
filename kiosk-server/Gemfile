source "https://rubygems.org"

gemspec

# Local-development overrides — sibling gems haven't shipped to RubyGems yet.
gem "kiosk-core",         path: "../kiosk-core"
gem "kiosk-test-support", path: "../kiosk-test-support"

# PoW-gate path deps — available in specs; NOT hard-required in lib code.
# The host that wires a reputation_policy will have these loaded transitively.
# kiosk-pow (argon2id) is the legacy backend; kiosk-pow-equihash is the default.
gem "kiosk-pow",          path: "../kiosk-pow"
gem "kiosk-pow-equihash", path: "../kiosk-pow-equihash"
gem "kiosk-reputation",   path: "../kiosk-reputation"

# `json_schemer` is a RUNTIME dependency of this gem, so `gemspec` above already
# brings it and this line is redundant — kept only so the development bundle
# names it. kiosk-server.gemspec says why it is one: every 0.4 verb's
# `input_schema` is validated before the handler sees an argument, behind no
# flag at all. A host does NOT add it to enable anything; it is still required
# lazily in lib so a checkout without it gets a ConfigurationError naming the
# gem rather than a LoadError at boot.
gem "json_schemer"

# THE CONFORMANCE TEST for the derived OpenAPI document (T-068 slice 4,
# T-071 = C). A THIRD-PARTY OpenAPI 3.1 implementation, so `open_api_spec.rb`
# proves the document with somebody else's parser rather than with our own
# eyes: it parses `/kiosk/openapi.json`, then validates real Kiosk requests and
# real Kiosk answers against it. Test-only, and it goes when the provisional
# renderer goes.
gem "openapi_first"

# ActiveRecord is a RUNTIME dependency of the gem (see the gemspec); only the
# database DRIVER is test-side here. The durable-store contract spec
# (DeviceAuthorizationStores::ActiveRecord) SKIPS its ActiveRecord context when
# no local Postgres is reachable, so the suite stays green on DB-less machines.
gem "pg", "~> 1.5"

# K-1384 -- json 3.0.0 (published 2026-09-07) dropped the POSITIONAL options
# argument from JSON.parse -- it is now JSON.parse(source, **opts), so
# JSON.parse(str, {}) raises ArgumentError (wrong number of arguments (given 2,
# expected 1)). activesupport 8.1.3.1 is the NEWEST release and still spells it
# positionally in ActiveSupport::JSON.decode, which the encrypted cookie jar and
# ActionDispatch's default JSON parameter parser both reach on every request.
# This bundle has no committed lockfile, so CI resolves it fresh and picks up
# json 3.0.0; without this line kiosk-server's suite is 19 examples red.
#
# REMOVAL CONDITION: rails/rails main already spells it JSON.parse(json,
# **options); no RELEASE carries that yet. The pin comes off when a released
# activesupport this repo can resolve carries the keyword-splat form, and
# bin/check-json-pin reads that line out of the resolved gem and turns RED the
# day it changes.
gem "json", "< 3.0"
