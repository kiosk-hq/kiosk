<%# «Link an assistant» page (link flow — Kiosk extension).
    Minimal on purpose — override by shipping
    app/views/kiosk/server/assistants/show.html.erb in the host app. %>
<% content_for :title, 'Linked assistants' %>
<main>
  <h1>Linked assistant accounts</h1>

  <% if @notice %><p role="status"><%= @notice %></p><% end %>
  <% if @error %><p role="alert"><%= @error %></p><% end %>

  <% if @link_code %>
    <section>
      <h2>Your link code</h2>
      <p>
        Paste this into your assistant's chat. It works once and expires in
        <%= @expires_in %> seconds — it is shown only now.
      </p>
      <p><code><%= @link_code %></code></p>
    </section>
  <% end %>

  <section>
    <h2>Link a new assistant</h2>
    <p>
      Get a link code and paste it into your assistant's chat. The assistant
      uses the code once, with its own key, and is then linked to your account.
    </p>
    <form action="<%= @page_path %>/link" method="post">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <button type="submit">Get a link code</button>
    </form>
  </section>

  <section>
    <h2>Currently linked</h2>
    <% if @assistants.empty? %>
      <p>No assistant accounts are linked yet.</p>
    <% else %>
      <ul>
        <% @assistants.each do |assistant| %>
          <li>
            <strong><%= assistant[:human_label].to_s.empty? ? "(unnamed)" : assistant[:human_label] %></strong>
            <code><%= assistant[:fingerprint] %></code>
            <% if assistant[:bound_at] %>— linked <%= assistant[:bound_at] %><% end %>
            <% if @payments %>
            <p>
              <% spent = assistant[:spent_cents].map { |currency, cents| Kiosk::Server::Money.format(cents, currency) } %>
              Spent: <%= spent.empty? ? "nothing" : spent.join(", ") %>
              <% if @spending_cap %>
              <%
                cap = assistant[:spending_cap_cents]
                cap_label = if cap.nil?
                              "no spending cap"
                            elsif cap.zero?
                              "no payments allowed"
                            else
                              "spending cap #{Kiosk::Server::Money.format(cap, assistant[:spending_cap_currency])} per payment"
                            end
              %>
              — <%= cap_label %>
              <% end %>
            </p>
            <% end %>
            <form action="<%= @page_path %>/update" method="post">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="hidden" name="agent_id" value="<%= assistant[:agent_id] %>">
              <label>Label
                <input type="text" name="human_label" value="<%= assistant[:human_label] %>">
              </label>
              <% if @spending_cap %>
              <label>Spending cap per payment (blank: no cap; 0: no payments)
                <input type="text" name="spending_cap" inputmode="decimal" value="<%= assistant[:spending_cap_cents] && Kiosk::Server::Money.amount(assistant[:spending_cap_cents], assistant[:spending_cap_currency]) %>">
              </label>
              <label>Cap currency (a three-letter code such as EUR; the assistant cannot pay in another currency)
                <input type="text" name="spending_cap_currency" maxlength="3" value="<%= assistant[:spending_cap_currency]&.upcase %>">
              </label>
              <% end %>
              <button type="submit">Save</button>
            </form>
            <form action="<%= @page_path %>/unlink" method="post">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <input type="hidden" name="agent_id" value="<%= assistant[:agent_id] %>">
              <button type="submit">Unlink</button>
            </form>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
