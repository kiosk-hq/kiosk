# frozen_string_literal: true

# Kiosk configuration. Every option: https://kiosk.tech and the kiosk-server README.

Kiosk.configure do |c|
  # Your user model class name, resolved at request time.
  c.user_model     = "<%= options[:user_table].classify %>"

  # Type of users.id: :uuid (default), :bigint, :integer or :text.
  c.user_id_type   = :<%= options[:user_id_type] %>

  # Column on `users` that holds the principal id. Default :id.
  c.user_id_column = :id

  # coerce-then-validate on the per-verb wire is UNCONDITIONAL: arguments are
  # always checked against the verb's `input_schema` (§8.1). These two flags add checks.
  # A malformed `Kiosk-PoW` header gets a 400 naming the expected shape, not an endless 402.
  c.validate_requests = true

  # Validates every answer against the verb's `output_schema`. Off in production,
  # where a descriptor typo would become a 500 for a caller.
  c.validate_responses = !Rails.env.production?

  # GUC namespace for SET LOCAL (and RLS policies). Default "app".
  # c.guc_namespace = "<%= options[:guc_namespace] %>"

  # Postgres schema for Kiosk helper functions and tables.
  # c.schema = "<%= options[:schema] %>"

  # Opt-in Postgres RLS: add `gem "kiosk-rls"` and create these database roles yourself.
  # c.app_role        = "app_role"      # runtime role with NOBYPASSRLS
  # c.system_role     = "system_role"   # privileged role; owns the tables
  # c.enforce_db_role = true            # SET LOCAL ROLE app_role per request

  # The exact origin assistants dial (scheme + host, no trailing slash); it must
  # match `kiosk.issuer` in /.well-known/kiosk.json, or every proof is rejected.
  # c.issuer = "https://<your-host>"

  # Further origins this deployment serves, each its own operator.
  # c.additional_origins = ["https://<another-host>"]

  # Role vocabulary; set together with `registration_role`. Your `user_idp` must
  # resolve a role for every human who can approve a binding (§6.3).
  # c.roles = %i[customer]

  # The default role for self-registered assistants and role-less bindings; your least-privileged one.
  # c.registration_role = :customer

  # Owner block surfaced in /.well-known/kiosk.json.
  # c.owner = { name: "Your Company", support: "support@example.com" }

  # Optional: an agent IdP of your own (subclass Kiosk::AgentIdentityProviders::Base; agent ids must be UUIDs).
  # c.agent_idp = MyExternalAgentIdp.new

  # Optional: a user IdP binding your signed-in humans, e.g. `gem "kiosk-user-idp-devise"`.
  # c.user_idp = Kiosk::UserIdentityProviders::Devise.new

  # With more than one process, the auth challenge store must be shared.
  # c.auth_challenge_store = Kiosk::Server::AuthChallengeStores::ActiveRecord.new

  # Events are kept 24 hours for reconnecting subscribers. Production refuses
  # to boot with the in-process default while any handler declares a `topic`.
  c.event_store = Kiosk::Server::EventStores::ActiveRecord.new

  # Optional audit sink: one ActionEvent per action, arguments in full and unredacted.
  # c.audit_sink = ->(e) { Rails.logger.info(e.with_arg_types.to_h.to_json) }
end
