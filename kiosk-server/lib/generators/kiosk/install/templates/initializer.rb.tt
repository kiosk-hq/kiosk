# frozen_string_literal: true

# Kiosk configuration for this application.
#
# See https://kiosk.tech and the kiosk-server README for the full option
# surface. Defaults here reflect the values the install generator was
# invoked with — uncomment and adjust as needed.

Kiosk.configure do |c|
  # ─── Principal (user) wiring ─────────────────────────────────────────
  # Provider's user model class name as a String — resolved at request
  # time by kiosk-server, not eagerly, to avoid load-order issues.
  c.user_model     = "<%= options[:user_table].classify %>"

  # Type of users.id — :uuid (default), :bigint, :integer, or :text.
  c.user_id_type   = :<%= options[:user_id_type] %>

  # Column on `users` that holds the principal id. Default :id.
  c.user_id_column = :id

  # ─── Postgres surface ────────────────────────────────────────────────
  # GUC namespace used in SET LOCAL statements (and RLS policies, if you
  # opt in). Default "app" — change if your backend already uses app.*.
  # c.guc_namespace = "<%= options[:guc_namespace] %>"

  # Postgres schema for Kiosk helper functions and tables.
  # c.schema = "<%= options[:schema] %>"

  # ─── Opt-in: DB-level RLS defense-in-depth ───────────────────────────
  # Kiosk's isolation comes from the sanctioned query/run/pay surface with
  # app-layer authz. Postgres RLS is available as belt-and-suspenders:
  # add `gem "kiosk-rls"`, include Kiosk::RLS::DSL into your migrations,
  # and configure the DB roles (provider creates these — Kiosk does not).
  # c.app_role        = "app_role"      # runtime role with NOBYPASSRLS
  # c.system_role     = "system_role"   # privileged role; owns the tables
  # c.enforce_db_role = true            # SET LOCAL ROLE app_role per request

  # ─── Wire surface ────────────────────────────────────────────────────
  # Issuer URL — MUST match `kiosk.issuer` in /.well-known/kiosk.json AND
  # be the exact origin assistants dial (scheme + host, no trailing slash).
  # It is configured, not derived from the request Host, because it anchors
  # both the AP2 mandate `iss` and the `aud` origin-binding that Kiosk checks
  # by strict equality — derived from the request it would defend nothing.
  # Get it wrong and the app still boots, then rejects EVERY assistant with
  # "proof audience mismatch". One instance therefore serves exactly one
  # origin: point aliases at it with a redirect before any Kiosk verb.
  # c.issuer = "https://<your-host>"

  # Role vocabulary your authz (app-layer policies, and RLS if opted in)
  # branches on. Never include `:admin` — prefer job-titled roles like
  # `:support`, `:master`.
  # c.roles = %i[customer]

  # Role pinned to every self-registered agent (agents cannot choose their
  # own). OPTIONAL: when unset, self-registered agents get no role — assign
  # roles inside the `c.assistant_creation` hook instead if your app
  # branches on them. When set, must be one of `c.roles`.
  # c.registration_role = :customer

  # Owner block surfaced in /.well-known/kiosk.json.
  # c.owner = { name: "Your Company", support: "support@example.com" }

  # ─── Pluggable identity adapters ─────────────────────────────────────
  # Two DIFFERENT, both-OPTIONAL seams. You need NEITHER to start:
  #
  # AGENT-IdP (c.agent_idp) — verifies/mints AI-assistant credentials. Defaults
  # to the bundled kiosk-pop DefaultAgentIdp, used with ZERO config: it verifies
  # the tokens the register/login endpoints mint. Set it ONLY to front an
  # external agent-identity issuer by implementing
  # `Kiosk::AgentIdentityProviders::Base` — external agent-IdP adapters are a
  # planned seam; none ship yet.
  #   # c.agent_idp = MyExternalAgentIdp.new   # your Kiosk::AgentIdentityProviders::Base subclass
  #
  # USER-IdP (c.user_idp) — binds a real HUMAN account (and optionally its role)
  # from your EXISTING session auth, so a human can approve/manage assistant
  # links from your own frontend. The shipped worked example is
  # `kiosk-user-idp-devise` (add `gem "kiosk-user-idp-devise"`):
  #   # c.user_idp = Kiosk::UserIdentityProviders::Devise.new
end
