{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The index format of Agent Skills Discovery v0.2.0 (github.com/cloudflare/agent-skills-discovery-rfc, README, sections Index Format and Integrity and Verification), written as a schema: the $schema URI it names does not resolve.",
  "type": "object",
  "required": ["$schema", "skills"],
  "properties": {
    "$schema": { "const": "https://schemas.agentskills.io/discovery/0.2.0/schema.json" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description", "url", "digest"],
        "properties": {
          "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "type": { "enum": ["skill-md", "archive"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "url": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
